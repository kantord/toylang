expression: "format!(\"-- : {ty}\\n{lua}\")"
---
-- : Vec<Int>
local function tl_select(src, pred)
  local out = {}
  for i = 1, #src do
    if pred(src[i]) then out[#out + 1] = src[i] end
  end
  return out
end
local function tl_join(v, f)
  local parts = {}
  for i = 1, #v do parts[i] = f(v[i]) end
  return "[" .. table.concat(parts, ",") .. "]"
end
print(tl_join((function(t_0) return tl_select(t_0, function(t_1) return (t_1 >= 2) end) end)({1, 2, 3}), function(e0) return tostring(e0) end))
