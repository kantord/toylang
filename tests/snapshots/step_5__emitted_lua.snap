---
source: tests/step_5.rs
expression: "format!(\"-- input : {}\\n-- : {}\\n{}\", c.input.unwrap(), c.ty, c.lua)"
---
-- input : {users: Vec<{age: Int, name: Str}>}
-- : Vec<Str>
local function tl_select(src, pred)
  local out = {}
  for i = 1, #src do
    if pred(src[i]) then out[#out + 1] = src[i] end
  end
  return out
end
local function tl_field(v, k, depth)
  if depth == 0 then return v[k] end
  local out = {}
  for i = 1, #v do out[i] = tl_field(v[i], k, depth - 1) end
  return out
end
local function tl_quote(s)
  return '"' .. s:gsub('[%c"\\]', function(c)
    if c == '"' then return '\\"' end
    if c == '\\' then return '\\\\' end
    if c == '\n' then return '\\n' end
    if c == '\r' then return '\\r' end
    if c == '\t' then return '\\t' end
    return string.format('\\u%04x', c:byte())
  end) .. '"'
end
local function tl_show(v)
  local t = type(v)
  if t == "table" then
    if v[1] ~= nil or next(v) == nil then
      local parts = {}
      for i = 1, #v do parts[i] = tl_show(v[i]) end
      return "[" .. table.concat(parts, ",") .. "]"
    end
    local keys = {}
    for k in pairs(v) do keys[#keys + 1] = k end
    table.sort(keys)
    local parts = {}
    for i = 1, #keys do
      parts[i] = tl_quote(keys[i]) .. ":" .. tl_show(v[keys[i]])
    end
    return "{" .. table.concat(parts, ",") .. "}"
  elseif t == "string" then
    return tl_quote(v)
  end
  return tostring(v)
end
local v_adults
function v_adults(v_db)
  return (function(t_2) return tl_field(t_2, "name", 1) end)((function(t_0) return tl_select(t_0, function(t_1) return (t_1["age"] >= 18) end) end)(v_db["users"]))
end
print(tl_show(v_adults(t_input)))
