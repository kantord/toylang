#![allow(dead_code)]

fn tl_int(n: i32) -> i32 {
    n
}

#[derive(Clone, PartialEq)]
#[allow(non_camel_case_types)]
enum TlE_Box_Int {
    V_Wrap(i32),
    V_Empty,
}

fn main() {
    println!("{}", (match TlE_Box_Int::V_Wrap(tl_int(5)) { TlE_Box_Int::V_Wrap(n0) => ("{\"Wrap\":".to_string() + &(n0).to_string() + "}"), TlE_Box_Int::V_Empty => "\"Empty\"".to_string() }));
}
