pub enum Opt<T> { some(T), none }

pub enum Result<T, E> { ok(T), err(E) }

fn join_parts(v: Vec<Str>) -> Str =
    "" if length(v) == 0 else v[0]! + join_parts(tail(v)!)

pub fn join_lines(v: Vec<Str>) -> Str =
    "" if length(v) == 0 else
        v[0]! if length(v) == 1 else
        v[0]! + "\n" + join_lines(tail(v)!)

pub fn join(v: Vec<Str>) -> Str = join_parts(v)
