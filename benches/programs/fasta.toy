# CLBG fasta: generate DNA sequences. ONE repeats an ALU fragment; TWO and THREE draw from
# small literal alphabets by a weighted PRNG index. The PRNG is the classic linear
# congruential generator (IM=139968 IA=3877 IC=29573) and the weighted pick compares cumulative
# integer weights against the rng value scaled to the weight total, so no floats are needed.
# The base count `n` is threaded through the generators rather than re-read from stdin inside a
# function body, because the codegen reads `parse(stdin)` off the one top-level input value.
#
# Derived: Computer Language Benchmarks Game fasta task, BSD-3-Clause,
# https://benchmarksgame-team.pages.debian.net/benchmarksgame/ -- reimplemented from the task's
# plain description (repeat a fixed sequence, draw from the IUB ambiguity codes and a
# nucleotide frequency table), in integer arithmetic, not copied from any reference source.
fn next_rng(prev: Int) -> Int = (prev * 3877 + 29573) % 139968

fn pick(s: {r: Int, w: Vec<Int>, acc: Int, i: Int, total: Int}) -> Int =
    s
        | (s.acc + s.w[s.i]!) * 139968 > s.r * s.total -> s.i or
              pick({r: s.r, w: s.w, acc: s.acc + s.w[s.i]!, i: s.i + 1, total: s.total})

fn gen(s: {left: Int, col: Int, line: Str, lines: Vec<Str>, seed: Int, syms: Vec<Str>, w: Vec<Int>, total: Int, n: Int}) -> {lines: Vec<Str>, seed: Int, n: Int} =
    s
        | s.left == 0 -> {lines: s.lines + [s.line], seed: s.seed, n: s.n} or
              s.col == 60 -> gen({left: s.left, col: 0, line: "", lines: s.lines + [s.line], seed: s.seed, syms: s.syms, w: s.w, total: s.total, n: s.n}) or
              gen({left: s.left - 1, col: s.col + 1, line: s.line + s.syms[pick({r: s.seed, w: s.w, acc: 0, i: 0, total: s.total})]!, lines: s.lines, seed: next_rng(s.seed), syms: s.syms, w: s.w, total: s.total, n: s.n})

fn alu_sec(s: {left: Int, col: Int, line: Str, lines: Vec<Str>, k: Int, alu: Vec<Str>}) -> Vec<Str> =
    s
        | s.left == 0 -> s.lines + [s.line] or
              s.col == 60 -> alu_sec({left: s.left, col: 0, line: "", lines: s.lines + [s.line], k: s.k, alu: s.alu}) or
              alu_sec({left: s.left - 1, col: s.col + 1, line: s.line + s.alu[s.k]!, lines: s.lines, k: (s.k + 1) % length(s.alu), alu: s.alu})

fn after_two(t: {lines: Vec<Str>, seed: Int, n: Int}) -> Vec<Str> =
    t.lines +
        gen({left: 5 * t.n, col: 0, line: "", lines: [">THREE Homo sapiens frequency"], seed: t.seed, syms: ["a", "c", "g", "t"], w: [303, 198, 198, 301], total: 1000, n: t.n}).lines

join_lines(
    alu_sec(
        {
            left: 2 * parse(stdin),
            col: 0,
            line: "",
            lines: [">ONE Homo sapiens alu"],
