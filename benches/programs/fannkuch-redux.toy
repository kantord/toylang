# CLBG fannkuch-redux: for N, generate every permutation of [1..N], and for each one flip the
# leading block of length equal to its first element until that element becomes 1, counting
# flips. Track the maximum flip count over all permutations and a checksum, the sum of each
# permutation's flip count signed by its parity (even permutations positive, odd negative).
# `flips` is the flip loop itself; `invs` is inversion parity, which is what "permutation
# parity" means and what makes the sign order-independent instead of depending on the
# enumeration order. The checksum therefore differs from the CLBG site's index-based one (that
# one is a property of its factoradic enumeration order, which this recursive generation does
# not reproduce), but it verifies the same thing -- that all N! permutations were visited -- and
# the maximum flip count, the benchmark's real number, matches CLBG exactly.
#
# Permutations are built recursively: `perms` takes the first element out and inserts it at
# every position of each permutation of the rest. The enumeration is complete and deterministic,
# so the checksum is reproducible on every backend.
#
# Derived: Computer Language Benchmarks Game fannkuch-redux task, BSD-3-Clause,
# https://benchmarksgame-team.pages.debian.net/benchmarksgame/ -- reimplemented from the task's
# plain description (flip the leading block, count flips, take the max and a parity-signed sum),
# not copied from any reference source.
fn insert_each({x, p}: {x: Int, p: Vec<Int>}) -> Vec<Vec<Int>> =
    p
        | length(p) == 0 -> [[x]] or
              [[x] + p] + (insert_each({x: x, p: tail(p)!}) | map([p[0]!] + .))

fn build_perms({x, ps}: {x: Int, ps: Vec<Vec<Int>>}) -> Vec<Vec<Int>> =
    ps
        | length(ps) == 0 -> [] or
              insert_each({x: x, p: ps[0]!}) + build_perms({x: x, ps: tail(ps)!})

fn perms(v: Vec<Int>) -> Vec<Vec<Int>> =
    v | length(v) == 0 -> [[]] or build_perms({x: v[0]!, ps: perms(tail(v)!)})

fn flips(p: Vec<Int>) -> Int =
    p | p[0]! == 1 -> 0 or 1 + flips(reverse(p[:p[0]!]) + p[p[0]!:])

fn invs(p: Vec<Int>) -> Int =
    p
        | length(p) <= 1 -> 0 or
              (length(tail(p)! | select(. < p[0]!)) + invs(tail(p)!)) % 2

fn step({p, acc}: {p: Vec<Int>, acc: {checksum: Int, max: Int}}) -> {checksum: Int, max: Int} =
    let f = flips(p)
    {
        checksum: acc.checksum + (invs(p) == 0 | . -> f or 0 - f),
        max: f > acc.max | . -> f or acc.max
    }

fn fold({v, acc}: {v: Vec<Vec<Int>>, acc: {checksum: Int, max: Int}}) -> {checksum: Int, max: Int} =
    v
        | length(v) == 0 -> acc or
              fold({v: tail(v)!, acc: step({p: v[0]!, acc: acc})})

fn fk(n: Int) -> Str =
    let r = fold({v: perms(collect(range(n)) | map(. + 1)), acc: {checksum: 0, max: 0}})
    str(r.checksum) + "\nPfannkuchen(" + str(n) + ") = " + str(r.max)

fk(parse(stdin))
