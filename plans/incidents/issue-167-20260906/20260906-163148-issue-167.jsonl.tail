{"type":"tool_use","timestamp":1788705182946,"sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","part":{"type":"tool","tool":"read","callID":"call_1f1d637f826b40af930cde3a","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-167/src/check/mod.rs","offset":1276},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-167/src/check/mod.rs</path>\n<type>file</type>\n<content>\n1276:     ))\n1277: }\n1278: \n1279: /// A `map` call over the subject. `want_elem` is the element type the position expects of the\n1280: /// result, when it expects one whose cardinality matches the subject's; the body is checked\n1281: /// against it, which is what lets a mapper body hold `[]`, a variant-naming string, or the\n1282: /// other checked-only forms. With `None` the body synthesises, as it always has.\n1283: fn map_call(ctx: &Ctx, arg: &Expr, span: Span, want_elem: Option<&Type>) -> Result<Tir, Error> {\n1284:     let Some((subject, id)) = ctx.subject.clone() else {\n1285:         return Err(Error::new(\n1286:             span,\n1287:             \"`map` needs a subject, so it must follow `|`\",\n1288:         ));\n1289:     };\n1290:     let Some(elem) = mapper_elem(&subject) else {\n1291:         return Err(Error::new(\n1292:             span,\n1293:             format!(\"`map` needs a Vec or a stream, found {subject}\"),\n1294:         ));\n1295:     };\n1296:     let param = ctx.fresh();\n1297:     let inner = mapper_ctx(ctx, elem, param);\n1298:     let body = match want_elem {\n1299:         Some(want) => expect(&inner, arg, want)?,\n1300:         None => synth(&inner, arg)?,\n1301:     };\n1302:     // The elements of the result are stored, and a stream is not storable: this is the same\n1303:     // containment ban a Vec literal enforces, met here before the Vec or Stream of them could\n1304:     // exist.\n1305:     if body.ty.contains_stream() {\n1306:         return Err(Error::new(\n1307:             arg.span(),\n1308:             \"a `map` body cannot be a stream, which has nothing to store\".to_string(),\n1309:         ));\n1310:     }\n1311:     let out = match &subject {\n1312:         Type::Stream(_) => Type::Stream(Box::new(body.ty.clone())),\n1313:         _ => Type::Vec(Box::new(body.ty.clone())),\n1314:     };\n1315:     let source = Tir::new(subject, Kind::Local(id));\n1316:     Ok(Tir::new(\n1317:         out,\n1318:         Kind::Map {\n1319:             source: Box::new(source),\n1320:             param,\n1321:             body: Box::new(body),\n1322:         },\n1323:     ))\n1324: }\n1325: \n1326: /// `|` binds `.` in the right side to the value of the left. It is composition, not a map:\n1327: /// the operators that distribute over a Vec do so themselves. The pipe's value is the right\n1328: /// side's, so an expectation flows into the right side whole -- which is how one reaches the\n1329: /// subject-fed forms (`map`, `select`, a match chain), since they only exist after `|`.\n1330: fn pipe(ctx: &Ctx, lhs: &Expr, rhs: &Expr, want: Option<&Type>) -> Result<Expected, Error> {\n1331:     let value = synth(ctx, lhs)?;\n1332:     let local = ctx.fresh();\n1333:     let inner = ctx.with(Some((value.ty.clone(), local)));\n1334:     let body = match want {\n1335:         Some(want) => expect_inner(&inner, rhs, want)?,\n1336:         None => Expected::Synthesised(synth(&inner, rhs)?),\n1337:     };\n1338:     let (checked, body) = match body {\n1339:         Expected::Checked(tir) => (true, tir),\n1340:         Expected::Synthesised(tir) => (false, tir),\n1341:     };\n1342:     // A stream on the right of `|` must have flowed in from the left: a source read beside an\n1343:     // unrelated piped value is not one chain, and one chain from source to sink is the shape\n1344:     // the whole effect layer keeps.\n1345:     if matches!(body.ty, Type::Stream(_)) && !matches!(value.ty, Type::Stream(_)) {\n1346:         return Err(Error::new(\n1347:             rhs.span(),\n1348:             \"this stream does not flow in from the left of `|`; write the pipeline as \\\n1349:              one chain from its source\"\n1350:                 .to_string(),\n1351:         ));\n1352:     }\n1353:     // The same linearity a stream-typed parameter gets: `|` is the one construct that can\n1354:     // silently drop its left side, so a stream piped in must be consumed here.\n1355:     if matches!(value.ty, Type::Stream(_)) {\n1356:         check_linear(\n1357:             &body,\n1358:             &StreamBinding::Local(local),\n1359:             \"the stream piped in here\",\n1360:             rhs.span(),\n1361:         )?;\n1362:     }\n1363:     let tir = Tir::new(\n1364:         body.ty.clone(),\n1365:         Kind::Bind {\n1366:             local,\n1367:             value: Box::new(value),\n1368:             body: Box::new(body),\n1369:         },\n1370:     );\n1371:     Ok(if checked {\n1372:         Expected::Checked(tir)\n1373:     } else {\n1374:         Expected::Synthesised(tir)\n1375:     })\n1376: }\n1377: \n1378: /// `let <name> = <expr>` bindings stacked one per line, then the value expression that ends\n1379: /// the block (kantord/toylang#150): no `in` keyword to pair, just the sequence and the result.\n1380: /// The one place a `let` block appears is a function body, so this is reached only through\n1381: /// `check_defs`'s `expect_inner`, and the body's type is whatever the block's value expression is.\n1382: ///\n1383: /// Later bindings see earlier ones: each value is checked in the scope built so far, and the name\n1384: /// is bound after, so `let a = a` reads the older `a`, the way any shadowing works. Every\n1385: /// binding gets a fresh `LocalId` and lowers to the same `Kind::Bind` a pipe does, so all seven\n1386: /// backends already know how to run one.\n1387: fn let_bind(\n1388:     ctx: &Ctx,\n1389:     bindings: &[(String, Expr)],\n1390:     body: &Expr,\n1391:     want: Option<&Type>,\n1392: ) -> Result<Expected, Error> {\n1393:     let locals: Vec<LocalId> = bindings.iter().map(|_| ctx.fresh()).collect();\n1394:     let mut values: Vec<Tir> = Vec::new();\n1395:     let mut scope = ctx.scope.clone();\n1396:     for ((name, value), local) in bindings.iter().zip(&locals) {\n1397:         let inner = ctx.rebuild(scope.clone(), ctx.subject.clone());\n1398:         let value = synth(&inner, value)?;\n1399:         scope.push((name.clone(), value.ty.clone(), Some(*local)));\n1400:         values.push(value);\n1401:     }\n1402:     let body_ctx = ctx.rebuild(scope, ctx.subject.clone());\n1403:     let body = match want {\n1404:         Some(want) => expect_inner(&body_ctx, body, want)?,\n1405:         None => Expected::Synthesised(synth(&body_ctx, body)?),\n1406:     };\n1407:     let (checked, mut tir) = match body {\n1408:         Expected::Checked(tir) => (true, tir),\n1409:         Expected::Synthesised(tir) => (false, tir),\n1410:     };\n1411:     for (local, value) in locals.into_iter().zip(values).into_iter().rev() {\n1412:         let body_ty = tir.ty.clone();\n1413:         tir = Tir::new(\n1414:             body_ty,\n1415:             Kind::Bind {\n1416:                 local,\n1417:                 value: Box::new(value),\n1418:                 body: Box::new(tir),\n1419:             },\n1420:         );\n1421:     }\n1422:     Ok(if checked {\n1423:         Expected::Checked(tir)\n1424:     } else {\n1425:         Expected::Synthesised(tir)\n1426:     })\n1427: }\n1428: \n1429: /// The hybrid totality the match-arms decision fixed. A chain with variant patterns is\n1430: /// closed-world: the subject is a declared enum, and the arms are proved to cover every\n1431: /// variant (or end in a default); guards do not count toward that coverage. A pure guard\n1432: /// chain is open-world and may be honestly partial, yielding `Opt` -- except when the arm\n1433: /// bodies are themselves `Opt`-typed, refused below. `.` narrows per arm: to the payload in\n1434: /// a payload arm, to nothing in a unit arm, and it stays the subject in a guard or default\n1435: /// arm.\n1436: ///\n1437: /// `body_want` is what every arm's body must be -- for a partial chain, the expectation with\n1438: /// its Opt layer already peeled by the caller. With `None` the first arm's body decides, as\n1439: /// it always has.\n1440: /// The dead-arm rule, both ways a chain can already be finished: a default above matches\n1441: /// everything, and arms covering every variant leave nothing for a later arm to see. (The\n1442: /// second is also what lets every backend take a total chain's last arm without a test.)\n1443: fn check_reachable(\n1444:     ctx: &Ctx,\n1445:     subject_ty: &Type,\n1446:     covered: &[String],\n1447:     default_seen: bool,\n1448:     arm_span: Span,\n1449: ) -> Result<(), Error> {\n1450:     if default_seen {\n1451:         return Err(Error::new(\n1452:             arm_span,\n1453:             \"this arm can never match; the `any()` arm above it already matches everything\"\n1454:                 .to_string(),\n1455:         ));\n1456:     }\n1457:     if let Type::Enum { name, args, .. } = subject_ty\n1458:         && !covered.is_empty()\n1459:         && enum_variants(ctx, name, args)\n1460:             .iter()\n1461:             .all(|(n, _)| covered.contains(n))\n1462:     {\n1463:         return Err(Error::new(\n1464:             arm_span,\n1465:             format!(\n1466:                 \"this arm can never match; the arms above it already cover every variant of `{name}`\"\n1467:             ),\n1468:         ));\n1469:     }\n1470:     Ok(())\n1471: }\n1472: \n1473: /// The closed-world proof: every variant of the subject's enum is either covered by a pattern\n1474: /// arm or the chain ends in a default, which the caller has already ruled out.\n1475: fn check_coverage(\n1476:     ctx: &Ctx,\n1477:     subject_ty: &Type,\n1478:     covered: &[String],\n1479:     span: Span,\n1480: ) -> Result<(), Error> {\n1481:     let Type::Enum {\n1482:         name: enum_name,\n1483:         args,\n1484:         ..\n1485:     } = subject_ty\n1486:     else {\n1487:         unreachable!(\"a pattern arm was checked against an enum subject\")\n1488:     };\n1489:     let missing: Vec<String> = enum_variants(ctx, enum_name, args)\n1490:         .iter()\n1491:         .filter(|(n, _)| !covered.contains(n))\n1492:         .map(|(n, _)| format!(\"`{n}`\"))\n1493:         .collect();\n1494:     if missing.is_empty() {\n1495:         return Ok(());\n1496:     }\n1497:     Err(Error::new(\n1498:         span,\n1499:         format!(\n1500:             \"a match over `{enum_name}` must cover every variant or end in a default; missing {}\",\n1501:             missing.join(\" and \")\n1502:         ),\n1503:     ))\n1504: }\n1505: \n1506: /// One variant pattern against the subject: the variant must exist on the subject's enum, a\n1507: /// unit variant takes no field pattern, and a payload variant rebinds `.` to a fresh payload\n1508: /// local, with any destructured fields proved against the payload's record type. Returns the\n1509: /// payload local (`None` for a unit variant) and the context the arm's body checks in.\n1510: fn variant_arm<'a>(\n1511:     ctx: &'a Ctx,\n1512:     subject_ty: &Type,\n1513:     vname: &str,\n1514:     vspan: Span,\n1515:     fields: Option<&FieldsPattern>,\n1516: ) -> Result<(Option<LocalId>, Ctx<'a>), Error> {\n1517:     // Deliberately parameterized, not built: how `some`/`none` arms compose -- their\n1518:     // totality, and whether they flow through first-class matchers -- is what the pending\n1519:     // matcher-totality round decides (plans/opt-as-enum.md, \"Open points, owned elsewhere\").\n1520:     // Until it runs, `!` and the producers' own combinators are Opt's consumption surface.\n1521:     if subject_ty.as_opt().is_some() {\n1522:         return Err(Error::new(\n1523:             vspan,\n1524:             format!(\n1525:                 \"{subject_ty} cannot be matched by variant yet; how its arms compose is \\\n1526:                  still being decided, so insist with `!` or keep the value whole\"\n1527:             ),\n1528:         ));\n1529:     }\n1530:     let Type::Enum {\n1531:         name: enum_name,\n1532:         args,\n1533:         ..\n1534:     } = subject_ty\n1535:     else {\n1536:         return Err(Error::new(\n1537:             vspan,\n1538:             format!(\"a match needs an enum subject, found {subject_ty}\"),\n1539:         ));\n1540:     };\n1541:     let variants = enum_variants(ctx, enum_name, args);\n1542:     let Some((_, payload_ty)) = variants.iter().find(|(n, _)| n == vname) else {\n1543:         // A lowercase name is the constructor, which builds a value; a pattern names the matcher.\n1544:         if variants.iter().any(|(n, _)| is_constructor_of(n, vname)) {\n1545:             return Err(Error::new(\n1546:                 vspan,\n1547:                 format!(\n1548:                     \"`{vname}` is the constructor, not a matcher; a pattern names the matcher, \\\n1549:                      so write `{}`\",\n1550:                     matcher_of(vname)\n1551:                 ),\n1552:             ));\n1553:         }\n1554:         return Err(Error::new(\n1555:             vspan,\n1556:             format!(\"`{enum_name}` has no variant `{vname}`\"),\n1557:         ));\n1558:     };\n1559:     match payload_ty {\n1560:         None => {\n1561:             if let Some(f) = fields {\n1562:                 return Err(Error::new(\n1563:                     f.span,\n1564:                     format!(\n1565:                         \"`{vname}` is a unit variant of `{enum_name}` and has no payload to destructure\"\n1566:                     ),\n1567:                 ));\n1568:             }\n1569:             Ok((None, ctx.with(None)))\n1570:         }\n1571:         Some(pty) => {\n1572:             let pid = ctx.fresh();\n1573:             let mut arm_ctx = ctx.with(Some((pty.clone(), pid)));\n1574:             if let Some(f) = fields {\n1575:                 let Type::Record(pfields) = pty else {\n1576:                     return Err(Error::new(\n1577:                         f.span,\n1578:                         format!(\n1579:                             \"the payload of `{vname}` is {pty}, not a record, so there are no fields to destructure; the arm's `.` is the payload\"\n1580:                         ),\n1581:                     ));\n1582:                 };\n1583:                 for (i, (fname, fspan)) in f.names.iter().enumerate() {\n1584:                     if f.names[..i].iter().any(|(seen, _)| seen == fname) {\n1585:                         return Err(Error::new(\n1586:                             *fspan,\n1587:                             format!(\"`{fname}` is bound twice in this pattern\"),\n1588:                         ));\n1589:                     }\n1590:                     if !pfields.iter().any(|(n, _)| n == fname) {\n1591:                         return Err(Error::new(*fspan, format!(\"no field `{fname}` on {pty}\")));\n1592:                     }\n1593:                     arm_ctx.arm_fields.push((fname.clone(), pty.clone(), pid));\n1594:                 }\n1595:                 // Leaving fields out of a match against a closed type is a forgotten field\n1596:                 // until `..` says it was meant.\n1597:                 if !f.rest {\n1598:                     let missing: Vec<String> = pfields\n1599:                         .iter()\n1600:                         .filter(|(n, _)| !f.names.iter().any(|(m, _)| m == n))\n1601:                         .map(|(n, _)| format!(\"`{n}`\"))\n1602:                         .collect();\n1603:                     if !missing.is_empty() {\n1604:                         return Err(Error::new(\n1605:                             f.span,\n1606:                             format!(\n1607:                                 \"a `{vname}` pattern must name every payload field or end in `..`; missing {}\",\n1608:                                 missing.join(\" and \")\n1609:                             ),\n1610:                         ));\n1611:                     }\n1612:                 }\n1613:             }\n1614:             Ok((Some(pid), arm_ctx))\n1615:         }\n1616:     }\n1617: }\n1618: \n1619: fn match_chain(\n1620:     ctx: &Ctx,\n1621:     arms: &[MatchArm],\n1622:     span: Span,\n1623:     body_want: Option<&Type>,\n1624: ) -> Result<Tir, Error> {\n1625:     let Some((subject_ty, sid)) = ctx.subject.clone() else {\n1626:         return Err(Error::new(\n1627:             span,\n1628:             \"a match needs a subject, so it must follow `|`\".to_string(),\n1629:         ));\n1630:     };\n1631:     let mut covered: Vec<String> = Vec::new();\n1632:     let mut default_seen = false;\n1633:     let mut has_pattern_arm = false;\n1634:     let mut result: Option<Type> = body_want.cloned();\n1635:     let mut out = Vec::new();\n1636:     for arm in arms {\n1637:         check_reachable(ctx, &subject_ty, &covered, default_seen, arm.span)?;\n1638:         let (variant, guard, payload, arm_ctx, fields) = match &arm.pattern {\n1639:             Pattern::Default { .. } => {\n1640:                 default_seen = true;\n1641:                 // A default matched the whole subject, so `.` stays the enum value.\n1642:                 (None, None, None, ctx.with(ctx.subject.clone()), None)\n1643:             }\n1644:             // The guard is a Bool over the unrebound subject, so it is checked in the\n1645:             // enclosing context, and the body keeps `.` as the subject too.\n1646:             Pattern::Guard(g) => {\n1647:                 let cond = expect(ctx, g, &Type::Bool)?;\n1648:                 (None, Some(cond), None, ctx.with(ctx.subject.clone()), None)\n1649:             }\n1650:             Pattern::Variant {\n1651:                 name: vname,\n1652:                 span: vspan,\n1653:                 fields,\n1654:             } => {\n1655:                 has_pattern_arm = true;\n1656:                 covered.push(vname.clone());\n1657:                 let (payload, arm_ctx) =\n1658:                     variant_arm(ctx, &subject_ty, vname, *vspan, fields.as_ref())?;\n1659:                 (Some(vname.clone()), None, payload, arm_ctx, fields.as_ref())\n1660:             }\n1661:         };\n1662:         let body = match &result {\n1663:             None => {\n1664:                 let body = synth(&arm_ctx, &arm.body)?;\n1665:                 // The same rule a conditional has: which arm runs is decided at\n1666:                 // runtime, and a pipeline's shape must not be.\n1667:                 if body.ty.contains_stream() {\n1668:                     return Err(Error::new(\n1669:                         arm.body.span(),\n1670:                         \"a match cannot yield a stream; pass each arm to `collect` first\"\n1671:                             .to_string(),\n1672:                     ));\n1673:                 }\n1674:                 result = Some(body.ty.clone());\n1675:                 body\n1676:             }\n1677:             Some(t) => expect(&arm_ctx, &arm.body, t)?,\n1678:         };\n1679:         // A bound field the arm's body never reads is the same dead-code smell as an\n1680:         // unused parameter; the fix is the same one the grammar already offers, naming\n1681:         // only what is read and closing the rest with `..`.\n1682:         if let (Some(fields), Some(pid)) = (fields, payload) {\n1683:             for (fname, fspan) in &fields.names {\n1684:                 if !field_used(&body, pid, fname) {\n1685:                     let hint = if fields.rest {\n1686:                         \"remove it from the pattern\".to_string()\n1687:                     } else {\n1688:                         \"remove it from the pattern and close it with `..`\".to_string()\n1689:                     };\n1690:                     return Err(Error::new(\n1691:                         *fspan,\n1692:                         format!(\"`{fname}` is bound here but never used in the arm's body; {hint}\"),\n1693:                     ));\n1694:                 }\n1695:             }\n1696:         }\n1697:         out.push(tir::MatchArm {\n1698:             variant,\n1699:             guard,\n1700:             payload,\n1701:             body,\n1702:         });\n1703:     }\n1704:     // Closed-world half: a chain with variant patterns keeps exhaustiveness, and only\n1705:     // patterns count toward it -- a guard is a runtime Bool the checker cannot see\n1706:     // through.\n1707:     if has_pattern_arm && !default_seen {\n1708:         check_coverage(ctx, &subject_ty, &covered, span)?;\n1709:     }\n1710:     let result = result.expect(\"the parser produces at least one arm\");\n1711:     // Open-world half: a pure guard chain with no default may decline every arm, so its\n1712:     // result is `Opt` -- of whatever the arms yield, `Opt`-typed arms included. A declined\n1713:     // chain is `none` and a matched-but-absent arm is `some(none)`, two different values now\n1714:     // that absence is tagged (kantord/toylang#62); both still print `null`, which is\n1715:     // serialization's documented lossiness, not a conflation to refuse.\n1716:     let partial = !has_pattern_arm && !default_seen;\n1717:     let result = if partial { opt_of(ctx, result) } else { result };\n1718:     let subject = Tir::new(subject_ty.clone(), Kind::Local(sid));\n1719:     Ok(Tir::new(\n1720:         result,\n1721:         Kind::Match {\n1722:             subject: Box::new(subject),\n1723:             arms: out,\n1724:             partial,\n1725:         },\n1726:     ))\n1727: }\n1728: \n1729: /// `Msg(Ping -> \"ping\" or Quit -> \"quit\")` (gh:152): a `Match` over the subject `.`, with the\n1730: /// named enum asserted as the subject's type. The arms are the same `or`-chain a `Match`\n1731: /// carries; only the head differs. Resolution is delegated to `match_chain` once the subject is\n1732: /// confirmed to be the enum the name spells, which is what makes the whole call form something\n1733: /// the checker can reason about rather than a type name that happened to be called.\n1734: fn match_call(\n1735:     ctx: &Ctx,\n1736:     enum_name: &str,\n1737:     enum_span: Span,\n1738:     arms: &[MatchArm],\n1739:     span: Span,\n1740: ) -> Result<Tir, Error> {\n1741:     if !ctx.enums.contains_key(enum_name) {\n1742:         return Err(Error::new(enum_span, format!(\"unknown type `{enum_name}`\")));\n1743:     }\n1744:     let Some((subject_ty, _)) = ctx.subject.clone() else {\n1745:         return Err(Error::new(\n1746:             span,\n1747:             \"a match needs a subject, so it must follow `|`\".to_string(),\n1748:         ));\n1749:     };\n1750:     let Type::Enum { name, .. } = &subject_ty else {\n1751:         return Err(Error::new(\n1752:             enum_span,\n1753:             format!(\"`{enum_name}` names an enum, but the subject is {subject_ty}\"),\n1754:         ));\n1755:     };\n1756:     if name != enum_name {\n1757:         return Err(Error::new(\n1758:             enum_span,\n1759:             format!(\n1760:                 \"`{enum_name}` is not the subject's type, which is {subject_ty}\"\n1761:             ),\n1762:         ));\n1763:     }\n1764:     match_chain(ctx, arms, span, None)\n1765: }\n1766: \n1767: /// The body of `fn name = Msg(Ping -> ... or ...)` (gh:152): the implicit `.` parameter is the\n1768: /// named enum, the body is a match call over it, and the function's signature -- parameter type\n1769: /// and return both -- is whatever that resolves to. The parameter is bound as the subject and\n1770: /// arrives through a hidden name the body never sees (it reads the subject), so the call form's\n1771: /// `.` is real input flowing in, not a constant.\n1772: fn check_hoisted_def(ctx: &Ctx, def: &Def) -> Result<tir::Func, Error> {\n1773:     let Expr::MatchCall {\n1774:         enum_name,\n1775:         enum_span,\n1776:         arms,\n1777:         span,\n1778:     } = &def.body\n1779:     else {\n1780:         return Err(Error::new(\n1781:             def.span,\n1782:             format!(\n1783:                 \"`fn {} = ...` needs a match-call body that names the enum it matches, \\\n1784:                  such as `Msg(Ping -> \\\"ping\\\" or Quit -> \\\"quit\\\")`\",\n1785:                 def.name\n1786:             ),\n1787:         ));\n1788:     };\n1789:     let Some(enum_ty) = ctx.enums.get(enum_name.as_str()) else {\n1790:         return Err(Error::new(*enum_span, format!(\"unknown type `{enum_name}`\")));\n1791:     };\n1792:     let sid = ctx.fresh();\n1793:     let def_ctx = Ctx {\n1794:         sigs: ctx.sigs,\n1795:         enums: ctx.enums,\n1796:         variant_owners: ctx.variant_owners,\n1797:         scope: Vec::new(),\n1798:         arm_fields: Vec::new(),\n1799:         subject: Some((enum_ty.clone(), sid)),\n1800:         input: ctx.input,\n1801:         inputs: ctx.inputs,\n1802:         lines_used: ctx.lines_used,\n1803:         dsv: ctx.dsv,\n1804:         in_mapper: false,\n1805:         in_fn: Some(&def.name),\n1806:         visibility: ctx.visibility,\n1807:         file: ctx.file,\n1808:         next_local: ctx.next_local,\n1809:     };\n1810:     let body = match_call(&def_ctx, enum_name, *enum_span, arms, *span)?;\n1811:     let param_name = format!(\"__{}_param\", def.name);\n1812:     let body = Tir::new(\n1813:         body.ty.clone(),\n1814:         Kind::Bind {\n1815:             local: sid,\n1816:             value: Box::new(Tir::new(enum_ty.clone(), Kind::Var(param_name.clone()))),\n1817:             body: Box::new(body),\n1818:         },\n1819:     );\n1820:     Ok(tir::Func {\n1821:         name: def.name.clone(),\n1822:         param: Some(param_name),\n1823:         param_ty: Some(enum_ty.clone()),\n1824:         body,\n1825:     })\n1826: }\n1827: \n1828: /// Refine the provisional signatures of hoisted definitions (`fn name = expr`, gh:152) from\n1829: /// their bodies. `signatures` seeded each with the enum it matches as a stand-in return; no\n1830: /// call may rely on that, so this pass runs before any body is checked and replaces every one\n1831: /// with the body's actual type. `ctx` is a provisional context carrying those seed signatures.\n1832: fn infer_hoisted<'a>(\n1833:     ctx: &Ctx<'a>,\n1834:     defs: impl IntoIterator<Item = &'a Def>,\n1835: ) -> Result<HashMap<String, Sig>, Error> {\n1836:     let mut refined = HashMap::new();\n1837:     for def in defs {\n1838:         if !def.hoisted {\n1839:             continue;\n1840:         }\n1841:         let func = check_hoisted_def(ctx, def)?;\n1842:         refined.insert(\n1843:             def.name.clone(),\n1844:             Sig {\n1845:                 param: func.param_ty.clone(),\n1846:                 ret: func.body.ty.clone(),\n1847:             },\n1848:         );\n1849:     }\n1850:     Ok(refined)\n1851: }\n1852: \n1853: fn synth(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\n1854:     let tir = synth_inner(ctx, expr)?;\n1855:     // A sink is not a value, so it can exist only where `tail_pipe` or `sink_call` recognized a\n1856:     // sink position: the program's own body or a Sink-returning function's. Reaching `synth`\n1857:     // with a sink means it is nested where its output would be observed, which is the general\n1858:     // position rule.\n1859:     if tir.ty.contains_sink() {\n1860:         return Err(Error::new(\n1861:             expr.span(),\n1862:             \"a sink is not a value, so it is legal only as the program's outermost expression \\\n1863:              or a Sink-returning function's body\"\n1864:                 .to_string(),\n1865:         ));\n1866:     }\n1867:     Ok(tir)\n1868: }\n1869: \n1870: fn synth_inner(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\n1871:     match expr {\n1872:         Expr::Str { text, .. } => Ok(Tir::new(Type::Str, Kind::Str(text.clone()))),\n1873:         Expr::Stdin { span } => {\n1874:             if let Some(func) = ctx.in_fn {\n1875:                 return Err(source_in_fn(*span, \"stdin\", func));\n1876:             }\n1877:             if ctx.in_mapper {\n1878:                 return Err(Error::new(\n1879:                     *span,\n1880:                     \"`stdin` cannot be read inside a mapper body, which runs once per element\"\n1881:                         .to_string(),\n1882:                 ));\n1883:             }\n1884:             if ctx.lines_used.get() {\n1885:                 return Err(Error::new(\n1886:                     *span,\n1887:                     \"`stdin` has already been read; there is only one stdin\".to_string(),\n1888:                 ));\n1889:             }\n1890:             ctx.lines_used.set(true);\n1891:             Ok(Tir::new(Type::Stream(Box::new(Type::Str)), Kind::Lines))\n1892:         }\n1893:         // `dsv` reads the same raw lines `lines` does and splits each on the delimiter, so it\n1894:         // shares every rule: refused in function and mapper bodies, read at most once, and its\n1895:         // type is fixed (`Vec<Vec<Str>>`) rather than borrowed from a position. `csv`/`tsv`\n1896:         // are this same node with the delimiter already fixed by the parser.\n1897:         Expr::Dsv { delim, span } => {\n1898:             if let Some(func) = ctx.in_fn {\n1899:                 return Err(Error::new(\n1900:                     *span,\n1901:                     format!(\n1902:                         \"`dsv` cannot be read inside `fn {func}`; a source is legal only in \\\n1903:                          the program's own body, so take the value through a parameter\"\n1904:                     ),\n1905:                 ));\n1906:             }\n1907:             if ctx.in_mapper {\n1908:                 return Err(Error::new(\n1909:                     *span,\n1910:                     \"`dsv` cannot be read inside a mapper body, which runs once per element\"\n1911:                         .to_string(),\n1912:                 ));\n1913:             }\n1914:             // Every backend's split on an empty separator is its own undefined behaviour (Rust\n1915:             // panics, Python raises, jq matches nothing), so the empty delimiter is refused\n1916:             // rather than left to disagree.\n1917:             if delim.is_empty() {\n1918:                 return Err(Error::new(\n1919:                     *span,\n1920:                     \"`dsv`'s delimiter cannot be empty\".to_string(),\n1921:                 ));\n1922:             }\n1923:             if ctx.dsv.borrow().is_some() {\n1924:                 return Err(Error::new(\n1925:                     *span,\n1926:                     \"`dsv` has already been read; there is only one stdin\".to_string(),\n1927:                 ));\n1928:             }\n1929:             *ctx.dsv.borrow_mut() = Some(delim.clone());\n1930:             let field = Type::Vec(Box::new(Type::Str));\n1931:             Ok(Tir::new(\n1932:                 Type::Vec(Box::new(field)),\n1933:                 Kind::Dsv {\n1934:                     delim: delim.clone(),\n1935:                 },\n1936:             ))\n1937:         }\n1938:         Expr::Int { value, span } => {\n1939:             // The literal is the one place a value could enter without meeting the 32-bit rule,\n1940:             // and four backends agreed on the wrong answer only because each held it in its own\n1941:             // wider representation until an operator wrapped it. Go refuses to compile such a\n1942:             // constant at all, which is what made the hole visible. A wider literal is not\n1943:             // guessed to be Int64 -- `expect_inner` resolves one only where an Int64 is\n1944:             // already expected, the same rule `[]` follows.\n1945:             if *value > i32::MAX as i64 {\n1946:                 return Err(Error::new(\n1947:                     *span,\n1948:                     format!(\n1949:                         \"integer `{value}` does not fit in Int, which is 32 bits; only a \\\n1950:                          position that expects Int64 can hold it\"\n1951:                     ),\n1952:                 ));\n1953:             }\n1954:             Ok(Tir::new(Type::Int, Kind::Int(*value)))\n1955:         }\n1956: \n1957:         // A float literal is exactly the binary64 it spells (ADR 0007): there is no width to\n1958:         // resolve and no range to check, so a position has nothing to contribute, unlike Int.\n1959:         Expr::Float { value, span } => {\n1960:             let _ = span;\n1961:             Ok(Tir::new(Type::Float, Kind::Float(*value)))\n1962:         }\n1963: \n1964:         Expr::Subject { span } => match &ctx.subject {\n1965:             Some((ty, id)) => Ok(Tir::new(ty.clone(), Kind::Local(*id))),\n1966:             None => Err(Error::new(*span, \"`.` is not bound here\")),\n1967:         },\n1968: \n1969:         // Innermost binding first: a pattern binding shadows a parameter, and a parameter\n1970:         // shadows a variant, the way any binding shadows a constant.\n1971:         Expr::Var { name, span } => {\n1972:             if let Some((_, payload_ty, pid)) =\n1973:                 ctx.arm_fields.iter().rev().find(|(n, _, _)| n == name)\n1974:             {\n1975:                 let fty = payload_ty\n1976:                     .field(name)\n1977:                     .expect(\"the field existed when the pattern was checked\")\n1978:                     .clone();\n1979:                 let base = Tir::new(payload_ty.clone(), Kind::Local(*pid));\n1980:                 return Ok(Tir::new(\n1981:                     fty,\n1982:                     Kind::Field {\n1983:                         base: Box::new(base),\n1984:                         name: name.clone(),\n1985:                     },\n1986:                 ));\n1987:             }\n1988:             if let Some((_, t, local)) = ctx.scope.iter().rev().find(|(n, _, _)| n == name) {\n1989:                 return match local {\n1990:                     // A `let`-bound name reads the local it was bound to, not a `Var`: the\n1991:                     // backends' `Bind` only ever binds locals, so a bare name reference would dangle.\n1992:                     Some(id) => Ok(Tir::new(t.clone(), Kind::Local(*id))),\n1993:                     None => Ok(Tir::new(t.clone(), Kind::Var(name.clone()))),\n1994:                 };\n1995:             }\n1996:             if let Some(owners) = ctx.variant_owners.get(name) {\n1997:                 let enum_ty = sole_owner(ctx, name, owners, *span)?.clone();\n1998:                 return construct(ctx, &enum_ty, name, *span, None, None, false);\n1999:             }\n2000:             // A function is not a value, but \"`f` is not defined\" for a defined function is a\n2001:             // lie. This is where `f -1` lands: `-` cannot start a bare argument, so the parse\n2002:             // is subtraction and `f` arrives here alone.\n2003:             if ctx.sigs.contains_key(name) || BUILTIN_NAMES.contains(&name.as_str()) {\n2004:                 return Err(Error::new(\n2005:                     *span,\n2006:                     format!(\"`{name}` is a function, not a value; write `{name}(...)` to call it\"),\n2007:                 ));\n2008:             }\n2009:             Err(Error::new(*span, format!(\"`{name}` is not defined\")))\n2010:         }\n2011: \n2012:         Expr::RecordLit { fields, .. } => {\n2013:             let mut built: Vec<(String, Tir)> = Vec::new();\n2014:             for (name, name_span, value) in fields {\n2015:                 if built.iter().any(|(seen, _)| seen == name) {\n2016:                     return Err(Error::new(\n2017:                         *name_span,\n2018:                         format!(\"field `{name}` is given twice\"),\n2019:                     ));\n2020:                 }\n2021:                 let field = synth(ctx, value)?;\n2022:                 // A stream can never enter a record: a record's fields can be printed, copied,\n2023:                 // and read back out by name, none of which make sense for a single-use stream,\n2024:                 // and no path exists for a stream-typed field to leave one again once inside.\n2025:                 if field.ty.contains_stream() {\n2026:                     return Err(Error::new(\n2027:                         value.span(),\n2028:                         format!(\"`{name}` cannot hold a stream, which has nothing to store\"),\n2029:                     ));\n2030:                 }\n2031:                 built.push((name.clone(), field));\n2032:             }\n2033:             // Declaration order, kept as written: the type's field list and this literal's\n2034:             // fields stay index-for-index aligned, which is what the columnar backends key on.\n2035:             let ty = Type::Record(\n2036:                 built\n2037:                     .iter()\n2038:                     .map(|(n, t)| (n.clone(), t.ty.clone()))\n2039:                     .collect(),\n2040:             );\n2041:             Ok(Tir::new(ty, Kind::RecordLit { fields: built }))\n2042:         }\n2043: \n2044:         Expr::VecLit { items, span } => {\n2045:             let Some(first) = items.first() else {\n2046:                 // Nothing says what an empty literal contains, and there is no expected type to\n2047:                 // supply it. Guessing here is what the annotation rule exists to avoid.\n2048:                 return Err(Error::new(*span, \"cannot tell what `[]` contains\"));\n2049:             };\n2050:             let head = synth(ctx, first)?;\n2051:             let elem = head.ty.clone();\n2052:             // Same reasoning as a record field: nothing can get a stream back out of a Vec\n2053:             // once it is in one, and a Vec of them makes no sense when there is only ever one\n2054:             // real stdin to begin with.\n2055:             if elem.contains_stream() {\n2056:                 return Err(Error::new(\n2057:                     first.span(),\n2058:                     \"a Vec cannot hold a stream, which has nothing to store\".to_string(),\n2059:                 ));\n2060:             }\n2061:             let mut out = vec![head];\n2062:             for item in &items[1..] {\n2063:                 out.push(expect(ctx, item, &elem)?);\n2064:             }\n2065:             Ok(Tir::new(Type::Vec(Box::new(elem)), Kind::VecLit(out)))\n2066:         }\n2067: \n2068:         Expr::Pipe { lhs, rhs, .. } => match pipe(ctx, lhs, rhs, None)? {\n2069:             Expected::Checked(tir) | Expected::Synthesised(tir) => Ok(tir),\n2070:         },\n2071: \n2072:         // A `|>` node only ever appears as a program's or a Sink-returning function's body,\n2073:         // which `check_program_body` and `check_defs` handle before `synth` is reached. A `Sink`\n2074:         // result here is refused by `synth`'s wrapper with the general position rule, so this\n2075:         // arm exists for totality and is only reachable through a shape the parser cannot make.\n2076:         Expr::TailPipe { .. } => tail_pipe(ctx, expr),\n2077: \n2078:         Expr::Field { .. } | Expr::Index { .. } | Expr::Slice { .. } | Expr::Unwrap { .. } => {\n2079:             let Access { tir, stream, .. } = access(ctx, expr)?;\n2080:             // Projection over a stream is a mapper, and it is normalized to one here: the chain\n2081:             // is rebased onto a fresh per-element param, so neither the backends nor fusion\n2082:             // ever see a Field, Index, or Unwrap whose base is stream-typed.\n2083:             if stream {\n2084:                 let param = ctx.fresh();\n2085:                 let Rebased { body, source } = rebase(tir, param);\n2086:                 return Ok(Tir::new(\n2087:                     Type::Stream(Box::new(body.ty.clone())),\n2088:                     Kind::Map {\n2089:                         source: Box::new(source),\n2090:                         param,\n2091:                         body: Box::new(body),\n2092:                     },\n2093:                 ));\n2094:             }\n2095:             Ok(tir)\n2096:         }\n2097: \n2098:         // `v[]` with nothing after it is the identity: \"keep every entry\" is what a Vec (or\n2099:         // stream) already is, with no field/index/unwrap left to distribute across it.\n2100:         Expr::Project { .. } => {\n2101:             let access = access(ctx, expr)?;\n2102:             Ok(access.tir)\n2103:         }\n2104: \n2105:         // `parse(stdin)` reads one value, so its first checked use fixes the type for the whole\n2106:         // program -- and a later use in a position that expects nothing can borrow what the\n2107:         // first use fixed. With no use typed yet, nothing says what it contains, and guessing\n2108:         // is what the annotation rule avoids. `parse(s)` on an ordinary string cannot\n2109:         // synthesise either: its result type comes only from the position it is checked in.\n2110:         Expr::Call {\n2111:             func,\n2112:             func_span,\n2113:             arg,\n2114:             span,\n2115:         } => call(ctx, func, *func_span, arg, *span),\n2116: \n2117:         Expr::Match { arms, span } => match_chain(ctx, arms, *span, None),\n2118: \n2119:         // A type name used as a match call (gh:152): sugar for a `Match` over `.`, resolved by\n2120:         // `match_call` against the enum the name spells, then down to the same `match_chain`\n2121:         // the ordinary `Match` runs.\n2122:         Expr::MatchCall {\n2123:             enum_name,\n2124:             enum_span,\n2125:             arms,\n2126:             span,\n2127:         } => match_call(ctx, enum_name, *enum_span, arms, *span),\n2128: \n2129:         Expr::Variant {\n2130:             enum_name,\n2131:             enum_span,\n2132:             variant,\n2133:             variant_span,\n2134:             payload,\n2135:             ..\n2136:         } => {\n2137:             let Some(enum_ty) = ctx.enums.get(enum_name) else {\n2138:                 return Err(Error::new(\n2139:                     *enum_span,\n2140:                     format!(\"`{enum_name}` is not an enum\"),\n2141:                 ));\n2142:             };\n2143:             construct(\n2144:                 ctx,\n2145:                 &enum_ty.clone(),\n2146:                 variant,\n2147:                 *variant_span,\n2148:                 payload.as_deref(),\n2149:                 None,\n2150:                 false,\n2151:             )\n2152:         }\n2153: \n2154:         Expr::Neg { base, span } => {\n2155:             // A minus directly on a literal is part of the literal, so the most negative Int can\n2156:             // be written even though its magnitude is one past the most positive. This is the\n2157:             // rule Rust uses, and it is why `-` was not folded into the lexer: `a -1` has to\n2158:             // stay `a - 1`.\n2159:             if let Expr::Int { value, span: lit } = base.as_ref() {\n2160:                 if *value > -(i32::MIN as i64) {\n2161:                     return Err(Error::new(\n2162:                         *lit,\n2163:                         format!(\n2164:                             \"integer `-{value}` does not fit in Int, which is 32 bits; only a \\\n2165:                              position that expects Int64 can hold it\"\n2166:                         ),\n2167:                     ));\n2168:                 }\n2169:                 return Ok(Tir::new(Type::Int, Kind::Int(-value)));\n2170:             }\n2171:             if let Expr::Float { value, .. } = base.as_ref() {\n2172:                 return Ok(Tir::new(Type::Float, Kind::Float(-value)));\n2173:             }\n2174:             // Synthesise first, so `-x` works at whichever integer width `x` already has; a\n2175:             // form that can only be checked (`-input` fixing input to Int) falls back to the\n2176:             // Int expectation this arm always applied.\n2177:             let inner = match synth(ctx, base) {\n2178:                 Ok(inner) if matches!(inner.ty, Type::Int | Type::Int64 | Type::Float) => inner,\n2179:                 Ok(inner) => {\n2180:                     return Err(Error::new(\n2181:                         base.span(),\n2182:                         format!(\"expected Int, found {}\", inner.ty),\n2183:                     ));\n2184:                 }\n2185:                 Err(_) => expect(ctx, base, &Type::Int)?,\n2186:             };\n2187:             let width = inner.ty.clone();\n2188:             // A Float's zero has to be `Kind::Float(0.0)`, not `Kind::Int(0)` typed as Float:\n2189:             // every backend but JS keeps Int and Float in different representations (an i64 and\n2190:             // an LLVM double are not interchangeable bits the way JS's untyped numbers let this\n2191:             // slide), so a mismatched Kind here compiles on JS by accident and is a real bug on\n2192:             // any backend that tells the two apart (kantord/toylang#149, found building the\n2193:             // Native backend's Float support).\n2194:             let zero_kind = if width == Type::Float {\n2195:                 Kind::Float(0.0)\n2196:             } else {\n2197:                 Kind::Int(0)\n2198:             };\n2199:             let zero = Tir::new(width.clone(), zero_kind);\n2200:             let _ = span;\n2201:             Ok(Tir::new(\n2202:                 width,\n2203:                 Kind::Arith {\n2204:                     op: BinOp::Sub,\n2205:                     lhs: Box::new(zero),\n2206:                     rhs: Box::new(inner),\n2207:                 },\n2208:             ))\n2209:         }\n2210: \n2211:         Expr::Binary { op, lhs, rhs, .. } => binary(ctx, *op, lhs, rhs),\n2212: \n2213:         // The connectives are the one place a subexpression may go unevaluated: `and` runs its\n2214:         // right side only when the left is true, `or` only when it is false. Nothing here has\n2215:         // to say so -- every backend emits its own short-circuiting operator -- but it is why\n2216:         // `x != 0 and 10 / x > 1` is a program and not a division by zero.\n2217:         Expr::Logic { op, lhs, rhs, .. } => {\n2218:             let lhs = expect(ctx, lhs, &Type::Bool)?;\n2219:             let rhs = expect(ctx, rhs, &Type::Bool)?;\n2220:             Ok(Tir::new(\n2221:                 Type::Bool,\n2222:                 Kind::Logic {\n2223:                     op: *op,\n2224:                     lhs: Box::new(lhs),\n2225:                     rhs: Box::new(rhs),\n2226:                 },\n2227:             ))\n2228:         }\n2229: \n2230:         Expr::Not { base, .. } => {\n2231:             let base = expect(ctx, base, &Type::Bool)?;\n2232:             Ok(Tir::new(Type::Bool, Kind::Not(Box::new(base))))\n2233:         }\n2234: \n2235:         // A `let` block is only reachable as a function body, which is always checked against an\n2236:         // expected return type, so `expect_inner` owns it. `synth` has no want to hand the block's\n2237:         // value, so this arm is unreachable in practice but must exist for the match to be total.\n2238:         Expr::Let { bindings, body, .. } => match let_bind(ctx, bindings, body, None)? {\n2239:             Expected::Checked(_) => unreachable!(\"synth has no want, so nothing is Checked\"),\n2240:             Expected::Synthesised(tir) => Ok(tir),\n2241:         },\n2242:     }\n2243: }\n2244: \n2245: /// `synth`'s `Expr::Call` arm, pulled out on its own: a call is one of `select`/`map` (special\n2246: /// forms rebinding `.`), a fixed sink or polymorphic builtin, or an ordinary user function or\n2247: /// payload-constructor lookup, each with its own argument shape to check.\n2248: fn call(\n2249:     ctx: &Ctx,\n2250:     func: &str,\n2251:     func_span: Span,\n2252:     arg: &Option<Box<Expr>>,\n2253:     span: Span,\n2254: ) -> Result<Tir, Error> {\n2255:     // `parse` is resolved by its position, so `synth` owns only the two shapes that need\n2256:     // no expectation: `parse(stdin)` borrowing the type an earlier checked use fixed, and\n2257:     // every other parse refusing outright (its result type comes only from a position).\n2258:     if func == \"parse\" {\n2259:         let arg = need_arg(arg, func, span)?;\n2260:         if matches!(arg, Expr::Stdin { .. }) {\n2261:             return match ctx.input.borrow().as_ref() {\n2262:                 Some(ty) => Ok(Tir::new(ty.clone(), Kind::Input)),\n2263:                 None => Err(Error::new(\n2264:                     arg.span(),\n2265:                     \"cannot tell what `parse(stdin)` contains\",\n2266:                 )),\n2267:             };\n2268:         }\n2269:         return Err(Error::new(\n2270:             func_span,\n2271:             \"cannot tell what `parse` produces; its result type comes from the position it is \\\n2272:              checked in\"\n2273:                 .to_string(),\n2274:         ));\n2275:     }\n2276:     // `select` and `map` are not special syntax, only special names: they are ordinary calls\n2277:     // whose argument is checked with `.` rebound to the subject's element type instead of\n2278:     // evaluated in the enclosing scope, which no ordinary function needs and is why they cannot\n2279:     // be defined as one (see `signatures`).\n2280:     if func == \"select\" {\n2281:         return select_call(ctx, need_arg(arg, func, span)?, span);\n2282:     }\n2283:     // The one way to produce a new element value. `select` removes elements and a field access\n2284:     // reads a field; neither can turn a Vec<Int> into a Vec<Str>.\n2285:     if func == \"map\" {\n2286:         return map_call(ctx, need_arg(arg, func, span)?, span, None);\n2287:     }\n2288:     // `sort_by` and `max_by` order or reduce by a scalar projection, so they are subject-fed\n2289:     // like `map`/`select`: the projection's `.` is rebound to the subject's element type. Blocking\n2290:     // (ordering and maximum both need the whole Vec), so unlike `map` they take a Vec only, never\n2291:     // a stream.\n2292:     if func == \"sort_by\" {\n2293:         return sort_by_call(ctx, need_arg(arg, func, span)?, span);\n2294:     }\n2295:     if func == \"max_by\" {\n2296:         return max_by_call(ctx, need_arg(arg, func, span)?, span);\n2297:     }\n2298:     // The one sink builtin: a regular call now, typed `Sink`, and so subject to the same\n2299:     // general position rule every sink is -- `synth`'s wrapper refuses a `Sink` result except\n2300:     // where `sink_call` or the tail-pipeline `|>` (`tail_pipe`) born it. The old hand-checked\n2301:     // `jsonlines` position in `check_program_body` retired in favor of that rule.\n2302:     if func == \"jsonlines\" {\n2303:         return jsonlines_call(ctx, arg, span);\n2304:     }\n2305:     // `length`, `tail`, and `flatten` are polymorphic over the element type, the same reason\n2306:     // `jsonlines` is checked here rather than through `builtin()`'s fixed table.\n2307:     if func == \"length\" {\n2308:         return length_call(ctx, need_arg(arg, func, span)?);\n2309:     }\n2310:     // `None` on an empty Vec, the same way `Index` turns reaching past what's there into `Opt`\n2311:     // rather than a runtime failure.\n2312:     if func == \"tail\" {\n2313:         return tail_call(ctx, need_arg(arg, func, span)?);\n2314:     }\n2315:     // Flattens a Vec<Vec<T>> into a Vec<T>, the way jq's `add` flattens a list of arrays.\n2316:     // Joining a fixed, known count of Vecs is `+` (kantord/toylang#97); this is for when the\n2317:     // outer Vec's length is not known at the call site.\n2318:     if func == \"flatten\" {\n2319:         return flatten_call(ctx, need_arg(arg, func, span)?);\n2320:     }\n2321:     // The one exit a stream has: `Stream<T> -> Vec<T>`, polymorphic over the element type like\n2322:     // `length` and the others above, so the argument is synthesised first.\n2323:     if func == \"collect\" {\n2324:         return collect(ctx, need_arg(arg, func, span)?, None);\n2325:     }\n2326:     // Polymorphic over which record, the same reason `length` is checked here: the return type\n2327:     // (`Vec<Str>`) is fixed, but the argument's shape is not.\n2328:     if func == \"fields\" {\n2329:         return fields_call(ctx, need_arg(arg, func, span)?);\n2330:     }\n2331:     // Blocking, one Vec in and one Vec out with no Stream instance (kantord/toylang#86, Q20 in\n2332:     // draft.md), so both are checked here rather than through `select`'s subject-context\n2333:     // mechanism.\n2334:     if func == \"sort\" {\n2335:         return sort_call(ctx, need_arg(arg, func, span)?);\n2336:     }\n2337:     if func == \"reverse\" {\n2338:         return reverse_call(ctx, need_arg(arg, func, span)?);\n2339:     }\n2340:     // The two reductions (kantord/toylang#140): `sum` folds `+` at the element width, `max`\n2341:     // returns `Opt` because an empty Vec has no maximum. Both are checked here rather than\n2342:     // through `builtin()`'s fixed table because the return type is the element type's, which\n2343:     // no fixed signature can express.\n2344:     if func == \"sum\" {\n2345:         return sum_call(ctx, need_arg(arg, func, span)?);\n2346:     }\n2347:     if func == \"max\" {\n2348:         return max_call(ctx, need_arg(arg, func, span)?);\n2349:     }\n2350:     // The three search cuts (draft.md#query-is-search): `first` takes any element type\n2351:     // the way `tail` does, `any` and `all` each take a Vec of Bool. All three are checked here\n2352:     // rather than through `builtin()`'s fixed table: their return types are the element type's\n2353:     // (or a fixed Bool), which no fixed signature can express.\n2354:     if func == \"first\" {\n2355:         return first_call(ctx, need_arg(arg, func, span)?);\n2356:     }\n2357:     if func == \"any\" {\n2358:         return any_call(ctx, need_arg(arg, func, span)?);\n2359:     }\n2360:     if func == \"all\" {\n2361:         return all_call(ctx, need_arg(arg, func, span)?);\n2362:     }\n2363:     if let Some((which, sig)) = builtin(func) {\n2364:         let param_ty = sig\n2365:             .param\n2366:             .as_ref()\n2367:             .expect(\"every builtin in the fixed table is unary\");\n2368:         let arg = expect(ctx, need_arg(arg, func, span)?, param_ty)?;\n2369:         return Ok(Tir::new(\n2370:             sig.ret,\n2371:             Kind::Builtin {\n2372:                 which,\n2373:                 arg: Box::new(arg),\n2374:             },\n2375:         ));\n2376:     }\n2377:     let Some(sig) = ctx.sigs.get(func) else {\n2378:         // A payload constructor is ordinary application (the Q34 path), so `circle{r: 1}` lands\n2379:         // here; it resolves as a variant only after the function namespace declines.\n2380:         if let Some(owners) = ctx.variant_owners.get(func) {\n2381:             let enum_ty = sole_owner(ctx, func, owners, func_span)?.clone();\n2382:             return construct(ctx, &enum_ty, func, func_span, arg.as_deref(), None, false);\n2383:         }\n2384:         return Err(Error::new(func_span, format!(\"`{func}` is not a function\")));\n2385:     };\n2386:     // A non-`pub` definition is a helper for its own file: it may be called from where it was\n2387:     // defined, and nowhere else. `file` is the caller's file, so a `Prelude`-origin private\n2388:     // helper is refused from the program's file while remaining legal inside prelude.toy -- the\n2389:     // same privacy a `pub` prelude function already kept from calling a private helper, now\n2390:     // stated as a per-call-site rule rather than by dropping the helper (gh:166).\n2391:     if let Some((origin, is_pub)) = ctx.visibility.get(func)\n2392:         && !is_pub\n2393:         && *origin != ctx.file\n2394:     {\n2395:         return Err(Error::new(\n2396:             func_span,\n2397:             format!(\"`{func}` is not `pub`, so it can only be called from its own file\"),\n2398:         ));\n2399:     }\n2400:     let arg = call_arg(ctx, func, span, &sig.param, arg)?;\n2401:     Ok(Tir::new(\n2402:         sig.ret.clone(),\n2403:         Kind::Call {\n2404:             func: func.to_string(),\n2405:             arg,\n2406:         },\n2407:     ))\n2408: }\n2409: \n2410: /// A user function's argument against its (optionally nullary) signature: the four arity/type\n2411: /// combinations a call and a signature can be in relative to each other.\n2412: fn call_arg(\n2413:     ctx: &Ctx,\n2414:     func: &str,\n2415:     span: Span,\n2416:     param_ty: &Option<Type>,\n2417:     arg: &Option<Box<Expr>>,\n2418: ) -> Result<Option<Box<Tir>>, Error> {\n2419:     match (param_ty, arg) {\n2420:         (Some(param_ty), Some(arg)) => Ok(Some(Box::new(expect(ctx, arg, param_ty)?))),\n2421:         (None, None) => Ok(None),\n2422:         (Some(param_ty), None) => Err(Error::new(\n2423:             span,\n2424:             format!(\"`{func}` needs an argument of {param_ty}, but was called with none\"),\n2425:         )),\n2426:         (None, Some(arg)) => Err(Error::new(\n2427:             arg.span(),\n2428:             format!(\"`{func}` takes no argument\"),\n2429:         )),\n2430:     }\n2431: }\n2432: \n2433: /// Cardinality-polymorphic: the same subject-context mechanism types `select` over a Vec and\n2434: /// over a Stream, with the element drawn from either's parameter. Stream in, stream out.\n2435: fn select_call(ctx: &Ctx, arg: &Expr, span: Span) -> Result<Tir, Error> {\n2436:     let Some((subject, id)) = ctx.subject.clone() else {\n2437:         return Err(Error::new(\n2438:             span,\n2439:             \"`select` needs a subject, so it must follow `|`\",\n2440:         ));\n2441:     };\n2442:     let Some(elem) = mapper_elem(&subject) else {\n2443:         return Err(Error::new(\n2444:             span,\n2445:             format!(\"`select` needs a Vec or a stream, found {subject}\"),\n2446:         ));\n2447:     };\n2448:     let param = ctx.fresh();\n2449:     let inner = mapper_ctx(ctx, elem, param);\n2450:     let pred = expect(&inner, arg, &Type::Bool)?;\n2451:     let source = Tir::new(subject.clone(), Kind::Local(id));\n2452:     Ok(Tir::new(\n2453:         subject,\n2454:         Kind::Select {\n2455:             source: Box::new(source),\n2456:             param,\n2457:             pred: Box::new(pred),\n2458:         },\n2459:     ))\n2460: }\n2461: \n2462: /// `jsonlines(x)`, the one sink builtin, typed `Sink`. A sink is not a value, so a direct call\n2463: /// survives only where `sink_call` recognized the sink position (the program's body or a\n2464: /// `Sink`-returning function's); anywhere else `synth` reaches the general rule and refuses\n2465: /// the `Sink` result. The argument is a Vec or a Stream of elements with a wire form; Char has\n2466: /// none.\n2467: fn jsonlines_call(ctx: &Ctx, arg: &Option<Box<Expr>>, span: Span) -> Result<Tir, Error> {\n2468:     let Some(arg) = arg else {\n2469:         return Err(Error::new(\n2470:             span,\n2471:             \"`jsonlines` needs a Vec or a stream, but was called with no argument\".to_string(),\n2472:         ));\n2473:     };\n2474:     let arg_span = arg.span();\n2475:     let arg = synth(ctx, arg)?;\n2476:     jsonlines_arg(arg, arg_span)\n2477: }\n2478: \n2479: /// The `jsonlines` sink's argument rules, applied to a value already synthesised: a Vec or a\n2480: /// Stream of elements with a wire form. Shared by the direct call and the `|>` tail-pipeline\n2481: /// (`x |> jsonlines`), which differ only in where the argument came from.\n2482: fn jsonlines_arg(arg: Tir, span: Span) -> Result<Tir, Error> {\n2483:     if !matches!(arg.ty, Type::Vec(_) | Type::Stream(_)) {\n2484:         return Err(Error::new(\n2485:             span,\n2486:             format!(\"`jsonlines` needs a Vec or a stream, found {}\", arg.ty),\n2487:         ));\n2488:     }\n2489:     if arg.ty.contains_char() {\n\n(Output capped at 50 KB. Showing lines 1276-2489. Use offset=2490 to continue.)\n</content>","metadata":{"preview":"    ))\n}\n\n/// A `map` call over the subject. `want_elem` is the element type the position expects of the\n/// result, when it expects one whose cardinality matches the subject's; the body is checked\n/// against it, which is what lets a mapper body hold `[]`, a variant-naming string, or the\n/// other checked-only forms. With `None` the body synthesises, as it always has.\nfn map_call(ctx: &Ctx, arg: &Expr, span: Span, want_elem: Option<&Type>) -> Result<Tir, Error> {\n    let Some((subject, id)) = ctx.subject.clone() else {\n        return Err(Error::new(\n            span,\n            \"`map` needs a subject, so it must follow `|`\",\n        ));\n    };\n    let Some(elem) = mapper_elem(&subject) else {\n        return Err(Error::new(\n            span,\n            format!(\"`map` needs a Vec or a stream, found {subject}\"),\n        ));\n    };","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-167/src/check/mod.rs","text":"    ))\n}\n\n/// A `map` call over the subject. `want_elem` is the element type the position expects of the\n/// result, when it expects one whose cardinality matches the subject's; the body is checked\n/// against it, which is what lets a mapper body hold `[]`, a variant-naming string, or the\n/// other checked-only forms. With `None` the body synthesises, as it always has.\nfn map_call(ctx: &Ctx, arg: &Expr, span: Span, want_elem: Option<&Type>) -> Result<Tir, Error> {\n    let Some((subject, id)) = ctx.subject.clone() else {\n        return Err(Error::new(\n            span,\n            \"`map` needs a subject, so it must follow `|`\",\n        ));\n    };\n    let Some(elem) = mapper_elem(&subject) else {\n        return Err(Error::new(\n            span,\n            format!(\"`map` needs a Vec or a stream, found {subject}\"),\n        ));\n    };\n    let param = ctx.fresh();\n    let inner = mapper_ctx(ctx, elem, param);\n    let body = match want_elem {\n        Some(want) => expect(&inner, arg, want)?,\n        None => synth(&inner, arg)?,\n    };\n    // The elements of the result are stored, and a stream is not storable: this is the same\n    // containment ban a Vec literal enforces, met here before the Vec or Stream of them could\n    // exist.\n    if body.ty.contains_stream() {\n        return Err(Error::new(\n            arg.span(),\n            \"a `map` body cannot be a stream, which has nothing to store\".to_string(),\n        ));\n    }\n    let out = match &subject {\n        Type::Stream(_) => Type::Stream(Box::new(body.ty.clone())),\n        _ => Type::Vec(Box::new(body.ty.clone())),\n    };\n    let source = Tir::new(subject, Kind::Local(id));\n    Ok(Tir::new(\n        out,\n        Kind::Map {\n            source: Box::new(source),\n            param,\n            body: Box::new(body),\n        },\n    ))\n}\n\n/// `|` binds `.` in the right side to the value of the left. It is composition, not a map:\n/// the operators that distribute over a Vec do so themselves. The pipe's value is the right\n/// side's, so an expectation flows into the right side whole -- which is how one reaches the\n/// subject-fed forms (`map`, `select`, a match chain), since they only exist after `|`.\nfn pipe(ctx: &Ctx, lhs: &Expr, rhs: &Expr, want: Option<&Type>) -> Result<Expected, Error> {\n    let value = synth(ctx, lhs)?;\n    let local = ctx.fresh();\n    let inner = ctx.with(Some((value.ty.clone(), local)));\n    let body = match want {\n        Some(want) => expect_inner(&inner, rhs, want)?,\n        None => Expected::Synthesised(synth(&inner, rhs)?),\n    };\n    let (checked, body) = match body {\n        Expected::Checked(tir) => (true, tir),\n        Expected::Synthesised(tir) => (false, tir),\n    };\n    // A stream on the right of `|` must have flowed in from the left: a source read beside an\n    // unrelated piped value is not one chain, and one chain from source to sink is the shape\n    // the whole effect layer keeps.\n    if matches!(body.ty, Type::Stream(_)) && !matches!(value.ty, Type::Stream(_)) {\n        return Err(Error::new(\n            rhs.span(),\n            \"this stream does not flow in from the left of `|`; write the pipeline as \\\n             one chain from its source\"\n                .to_string(),\n        ));\n    }\n    // The same linearity a stream-typed parameter gets: `|` is the one construct that can\n    // silently drop its left side, so a stream piped in must be consumed here.\n    if matches!(value.ty, Type::Stream(_)) {\n        check_linear(\n            &body,\n            &StreamBinding::Local(local),\n            \"the stream piped in here\",\n            rhs.span(),\n        )?;\n    }\n    let tir = Tir::new(\n        body.ty.clone(),\n        Kind::Bind {\n            local,\n            value: Box::new(value),\n            body: Box::new(body),\n        },\n    );\n    Ok(if checked {\n        Expected::Checked(tir)\n    } else {\n        Expected::Synthesised(tir)\n    })\n}\n\n/// `let <name> = <expr>` bindings stacked one per line, then the value expression that ends\n/// the block (kantord/toylang#150): no `in` keyword to pair, just the sequence and the result.\n/// The one place a `let` block appears is a function body, so this is reached only through\n/// `check_defs`'s `expect_inner`, and the body's type is whatever the block's value expression is.\n///\n/// Later bindings see earlier ones: each value is checked in the scope built so far, and the name\n/// is bound after, so `let a = a` reads the older `a`, the way any shadowing works. Every\n/// binding gets a fresh `LocalId` and lowers to the same `Kind::Bind` a pipe does, so all seven\n/// backends already know how to run one.\nfn let_bind(\n    ctx: &Ctx,\n    bindings: &[(String, Expr)],\n    body: &Expr,\n    want: Option<&Type>,\n) -> Result<Expected, Error> {\n    let locals: Vec<LocalId> = bindings.iter().map(|_| ctx.fresh()).collect();\n    let mut values: Vec<Tir> = Vec::new();\n    let mut scope = ctx.scope.clone();\n    for ((name, value), local) in bindings.iter().zip(&locals) {\n        let inner = ctx.rebuild(scope.clone(), ctx.subject.clone());\n        let value = synth(&inner, value)?;\n        scope.push((name.clone(), value.ty.clone(), Some(*local)));\n        values.push(value);\n    }\n    let body_ctx = ctx.rebuild(scope, ctx.subject.clone());\n    let body = match want {\n        Some(want) => expect_inner(&body_ctx, body, want)?,\n        None => Expected::Synthesised(synth(&body_ctx, body)?),\n    };\n    let (checked, mut tir) = match body {\n        Expected::Checked(tir) => (true, tir),\n        Expected::Synthesised(tir) => (false, tir),\n    };\n    for (local, value) in locals.into_iter().zip(values).into_iter().rev() {\n        let body_ty = tir.ty.clone();\n        tir = Tir::new(\n            body_ty,\n            Kind::Bind {\n                local,\n                value: Box::new(value),\n                body: Box::new(tir),\n            },\n        );\n    }\n    Ok(if checked {\n        Expected::Checked(tir)\n    } else {\n        Expected::Synthesised(tir)\n    })\n}\n\n/// The hybrid totality the match-arms decision fixed. A chain with variant patterns is\n/// closed-world: the subject is a declared enum, and the arms are proved to cover every\n/// variant (or end in a default); guards do not count toward that coverage. A pure guard\n/// chain is open-world and may be honestly partial, yielding `Opt` -- except when the arm\n/// bodies are themselves `Opt`-typed, refused below. `.` narrows per arm: to the payload in\n/// a payload arm, to nothing in a unit arm, and it stays the subject in a guard or default\n/// arm.\n///\n/// `body_want` is what every arm's body must be -- for a partial chain, the expectation with\n/// its Opt layer already peeled by the caller. With `None` the first arm's body decides, as\n/// it always has.\n/// The dead-arm rule, both ways a chain can already be finished: a default above matches\n/// everything, and arms covering every variant leave nothing for a later arm to see. (The\n/// second is also what lets every backend take a total chain's last arm without a test.)\nfn check_reachable(\n    ctx: &Ctx,\n    subject_ty: &Type,\n    covered: &[String],\n    default_seen: bool,\n    arm_span: Span,\n) -> Result<(), Error> {\n    if default_seen {\n        return Err(Error::new(\n            arm_span,\n            \"this arm can never match; the `any()` arm above it already matches everything\"\n                .to_string(),\n        ));\n    }\n    if let Type::Enum { name, args, .. } = subject_ty\n        && !covered.is_empty()\n        && enum_variants(ctx, name, args)\n            .iter()\n            .all(|(n, _)| covered.contains(n))\n    {\n        return Err(Error::new(\n            arm_span,\n            format!(\n                \"this arm can never match; the arms above it already cover every variant of `{name}`\"\n            ),\n        ));\n    }\n    Ok(())\n}\n\n/// The closed-world proof: every variant of the subject's enum is either covered by a pattern\n/// arm or the chain ends in a default, which the caller has already ruled out.\nfn check_coverage(\n    ctx: &Ctx,\n    subject_ty: &Type,\n    covered: &[String],\n    span: Span,\n) -> Result<(), Error> {\n    let Type::Enum {\n        name: enum_name,\n        args,\n        ..\n    } = subject_ty\n    else {\n        unreachable!(\"a pattern arm was checked against an enum subject\")\n    };\n    let missing: Vec<String> = enum_variants(ctx, enum_name, args)\n        .iter()\n        .filter(|(n, _)| !covered.contains(n))\n        .map(|(n, _)| format!(\"`{n}`\"))\n        .collect();\n    if missing.is_empty() {\n        return Ok(());\n    }\n    Err(Error::new(\n        span,\n        format!(\n            \"a match over `{enum_name}` must cover every variant or end in a default; missing {}\",\n            missing.join(\" and \")\n        ),\n    ))\n}\n\n/// One variant pattern against the subject: the variant must exist on the subject's enum, a\n/// unit variant takes no field pattern, and a payload variant rebinds `.` to a fresh payload\n/// local, with any destructured fields proved against the payload's record type. Returns the\n/// payload local (`None` for a unit variant) and the context the arm's body checks in.\nfn variant_arm<'a>(\n    ctx: &'a Ctx,\n    subject_ty: &Type,\n    vname: &str,\n    vspan: Span,\n    fields: Option<&FieldsPattern>,\n) -> Result<(Option<LocalId>, Ctx<'a>), Error> {\n    // Deliberately parameterized, not built: how `some`/`none` arms compose -- their\n    // totality, and whether they flow through first-class matchers -- is what the pending\n    // matcher-totality round decides (plans/opt-as-enum.md, \"Open points, owned elsewhere\").\n    // Until it runs, `!` and the producers' own combinators are Opt's consumption surface.\n    if subject_ty.as_opt().is_some() {\n        return Err(Error::new(\n            vspan,\n            format!(\n                \"{subject_ty} cannot be matched by variant yet; how its arms compose is \\\n                 still being decided, so insist with `!` or keep the value whole\"\n            ),\n        ));\n    }\n    let Type::Enum {\n        name: enum_name,\n        args,\n        ..\n    } = subject_ty\n    else {\n        return Err(Error::new(\n            vspan,\n            format!(\"a match needs an enum subject, found {subject_ty}\"),\n        ));\n    };\n    let variants = enum_variants(ctx, enum_name, args);\n    let Some((_, payload_ty)) = variants.iter().find(|(n, _)| n == vname) else {\n        // A lowercase name is the constructor, which builds a value; a pattern names the matcher.\n        if variants.iter().any(|(n, _)| is_constructor_of(n, vname)) {\n            return Err(Error::new(\n                vspan,\n                format!(\n                    \"`{vname}` is the constructor, not a matcher; a pattern names the matcher, \\\n                     so write `{}`\",\n                    matcher_of(vname)\n                ),\n            ));\n        }\n        return Err(Error::new(\n            vspan,\n            format!(\"`{enum_name}` has no variant `{vname}`\"),\n        ));\n    };\n    match payload_ty {\n        None => {\n            if let Some(f) = fields {\n                return Err(Error::new(\n                    f.span,\n                    format!(\n                        \"`{vname}` is a unit variant of `{enum_name}` and has no payload to destructure\"\n                    ),\n                ));\n            }\n            Ok((None, ctx.with(None)))\n        }\n        Some(pty) => {\n            let pid = ctx.fresh();\n            let mut arm_ctx = ctx.with(Some((pty.clone(), pid)));\n            if let Some(f) = fields {\n                let Type::Record(pfields) = pty else {\n                    return Err(Error::new(\n                        f.span,\n                        format!(\n                            \"the payload of `{vname}` is {pty}, not a record, so there are no fields to destructure; the arm's `.` is the payload\"\n                        ),\n                    ));\n                };\n                for (i, (fname, fspan)) in f.names.iter().enumerate() {\n                    if f.names[..i].iter().any(|(seen, _)| seen == fname) {\n                        return Err(Error::new(\n                            *fspan,\n                            format!(\"`{fname}` is bound twice in this pattern\"),\n                        ));\n                    }\n                    if !pfields.iter().any(|(n, _)| n == fname) {\n                        return Err(Error::new(*fspan, format!(\"no field `{fname}` on {pty}\")));\n                    }\n                    arm_ctx.arm_fields.push((fname.clone(), pty.clone(), pid));\n                }\n                // Leaving fields out of a match against a closed type is a forgotten field\n                // until `..` says it was meant.\n                if !f.rest {\n                    let missing: Vec<String> = pfields\n                        .iter()\n                        .filter(|(n, _)| !f.names.iter().any(|(m, _)| m == n))\n                        .map(|(n, _)| format!(\"`{n}`\"))\n                        .collect();\n                    if !missing.is_empty() {\n                        return Err(Error::new(\n                            f.span,\n                            format!(\n                                \"a `{vname}` pattern must name every payload field or end in `..`; missing {}\",\n                                missing.join(\" and \")\n                            ),\n                        ));\n                    }\n                }\n            }\n            Ok((Some(pid), arm_ctx))\n        }\n    }\n}\n\nfn match_chain(\n    ctx: &Ctx,\n    arms: &[MatchArm],\n    span: Span,\n    body_want: Option<&Type>,\n) -> Result<Tir, Error> {\n    let Some((subject_ty, sid)) = ctx.subject.clone() else {\n        return Err(Error::new(\n            span,\n            \"a match needs a subject, so it must follow `|`\".to_string(),\n        ));\n    };\n    let mut covered: Vec<String> = Vec::new();\n    let mut default_seen = false;\n    let mut has_pattern_arm = false;\n    let mut result: Option<Type> = body_want.cloned();\n    let mut out = Vec::new();\n    for arm in arms {\n        check_reachable(ctx, &subject_ty, &covered, default_seen, arm.span)?;\n        let (variant, guard, payload, arm_ctx, fields) = match &arm.pattern {\n            Pattern::Default { .. } => {\n                default_seen = true;\n                // A default matched the whole subject, so `.` stays the enum value.\n                (None, None, None, ctx.with(ctx.subject.clone()), None)\n            }\n            // The guard is a Bool over the unrebound subject, so it is checked in the\n            // enclosing context, and the body keeps `.` as the subject too.\n            Pattern::Guard(g) => {\n                let cond = expect(ctx, g, &Type::Bool)?;\n                (None, Some(cond), None, ctx.with(ctx.subject.clone()), None)\n            }\n            Pattern::Variant {\n                name: vname,\n                span: vspan,\n                fields,\n            } => {\n                has_pattern_arm = true;\n                covered.push(vname.clone());\n                let (payload, arm_ctx) =\n                    variant_arm(ctx, &subject_ty, vname, *vspan, fields.as_ref())?;\n                (Some(vname.clone()), None, payload, arm_ctx, fields.as_ref())\n            }\n        };\n        let body = match &result {\n            None => {\n                let body = synth(&arm_ctx, &arm.body)?;\n                // The same rule a conditional has: which arm runs is decided at\n                // runtime, and a pipeline's shape must not be.\n                if body.ty.contains_stream() {\n                    return Err(Error::new(\n                        arm.body.span(),\n                        \"a match cannot yield a stream; pass each arm to `collect` first\"\n                            .to_string(),\n                    ));\n                }\n                result = Some(body.ty.clone());\n                body\n            }\n            Some(t) => expect(&arm_ctx, &arm.body, t)?,\n        };\n        // A bound field the arm's body never reads is the same dead-code smell as an\n        // unused parameter; the fix is the same one the grammar already offers, naming\n        // only what is read and closing the rest with `..`.\n        if let (Some(fields), Some(pid)) = (fields, payload) {\n            for (fname, fspan) in &fields.names {\n                if !field_used(&body, pid, fname) {\n                    let hint = if fields.rest {\n                        \"remove it from the pattern\".to_string()\n                    } else {\n                        \"remove it from the pattern and close it with `..`\".to_string()\n                    };\n                    return Err(Error::new(\n                        *fspan,\n                        format!(\"`{fname}` is bound here but never used in the arm's body; {hint}\"),\n                    ));\n                }\n            }\n        }\n        out.push(tir::MatchArm {\n            variant,\n            guard,\n            payload,\n            body,\n        });\n    }\n    // Closed-world half: a chain with variant patterns keeps exhaustiveness, and only\n    // patterns count toward it -- a guard is a runtime Bool the checker cannot see\n    // through.\n    if has_pattern_arm && !default_seen {\n        check_coverage(ctx, &subject_ty, &covered, span)?;\n    }\n    let result = result.expect(\"the parser produces at least one arm\");\n    // Open-world half: a pure guard chain with no default may decline every arm, so its\n    // result is `Opt` -- of whatever the arms yield, `Opt`-typed arms included. A declined\n    // chain is `none` and a matched-but-absent arm is `some(none)`, two different values now\n    // that absence is tagged (kantord/toylang#62); both still print `null`, which is\n    // serialization's documented lossiness, not a conflation to refuse.\n    let partial = !has_pattern_arm && !default_seen;\n    let result = if partial { opt_of(ctx, result) } else { result };\n    let subject = Tir::new(subject_ty.clone(), Kind::Local(sid));\n    Ok(Tir::new(\n        result,\n        Kind::Match {\n            subject: Box::new(subject),\n            arms: out,\n            partial,\n        },\n    ))\n}\n\n/// `Msg(Ping -> \"ping\" or Quit -> \"quit\")` (gh:152): a `Match` over the subject `.`, with the\n/// named enum asserted as the subject's type. The arms are the same `or`-chain a `Match`\n/// carries; only the head differs. Resolution is delegated to `match_chain` once the subject is\n/// confirmed to be the enum the name spells, which is what makes the whole call form something\n/// the checker can reason about rather than a type name that happened to be called.\nfn match_call(\n    ctx: &Ctx,\n    enum_name: &str,\n    enum_span: Span,\n    arms: &[MatchArm],\n    span: Span,\n) -> Result<Tir, Error> {\n    if !ctx.enums.contains_key(enum_name) {\n        return Err(Error::new(enum_span, format!(\"unknown type `{enum_name}`\")));\n    }\n    let Some((subject_ty, _)) = ctx.subject.clone() else {\n        return Err(Error::new(\n            span,\n            \"a match needs a subject, so it must follow `|`\".to_string(),\n        ));\n    };\n    let Type::Enum { name, .. } = &subject_ty else {\n        return Err(Error::new(\n            enum_span,\n            format!(\"`{enum_name}` names an enum, but the subject is {subject_ty}\"),\n        ));\n    };\n    if name != enum_name {\n        return Err(Error::new(\n            enum_span,\n            format!(\n                \"`{enum_name}` is not the subject's type, which is {subject_ty}\"\n            ),\n        ));\n    }\n    match_chain(ctx, arms, span, None)\n}\n\n/// The body of `fn name = Msg(Ping -> ... or ...)` (gh:152): the implicit `.` parameter is the\n/// named enum, the body is a match call over it, and the function's signature -- parameter type\n/// and return both -- is whatever that resolves to. The parameter is bound as the subject and\n/// arrives through a hidden name the body never sees (it reads the subject), so the call form's\n/// `.` is real input flowing in, not a constant.\nfn check_hoisted_def(ctx: &Ctx, def: &Def) -> Result<tir::Func, Error> {\n    let Expr::MatchCall {\n        enum_name,\n        enum_span,\n        arms,\n        span,\n    } = &def.body\n    else {\n        return Err(Error::new(\n            def.span,\n            format!(\n                \"`fn {} = ...` needs a match-call body that names the enum it matches, \\\n                 such as `Msg(Ping -> \\\"ping\\\" or Quit -> \\\"quit\\\")`\",\n                def.name\n            ),\n        ));\n    };\n    let Some(enum_ty) = ctx.enums.get(enum_name.as_str()) else {\n        return Err(Error::new(*enum_span, format!(\"unknown type `{enum_name}`\")));\n    };\n    let sid = ctx.fresh();\n    let def_ctx = Ctx {\n        sigs: ctx.sigs,\n        enums: ctx.enums,\n        variant_owners: ctx.variant_owners,\n        scope: Vec::new(),\n        arm_fields: Vec::new(),\n        subject: Some((enum_ty.clone(), sid)),\n        input: ctx.input,\n        inputs: ctx.inputs,\n        lines_used: ctx.lines_used,\n        dsv: ctx.dsv,\n        in_mapper: false,\n        in_fn: Some(&def.name),\n        visibility: ctx.visibility,\n        file: ctx.file,\n        next_local: ctx.next_local,\n    };\n    let body = match_call(&def_ctx, enum_name, *enum_span, arms, *span)?;\n    let param_name = format!(\"__{}_param\", def.name);\n    let body = Tir::new(\n        body.ty.clone(),\n        Kind::Bind {\n            local: sid,\n            value: Box::new(Tir::new(enum_ty.clone(), Kind::Var(param_name.clone()))),\n            body: Box::new(body),\n        },\n    );\n    Ok(tir::Func {\n        name: def.name.clone(),\n        param: Some(param_name),\n        param_ty: Some(enum_ty.clone()),\n        body,\n    })\n}\n\n/// Refine the provisional signatures of hoisted definitions (`fn name = expr`, gh:152) from\n/// their bodies. `signatures` seeded each with the enum it matches as a stand-in return; no\n/// call may rely on that, so this pass runs before any body is checked and replaces every one\n/// with the body's actual type. `ctx` is a provisional context carrying those seed signatures.\nfn infer_hoisted<'a>(\n    ctx: &Ctx<'a>,\n    defs: impl IntoIterator<Item = &'a Def>,\n) -> Result<HashMap<String, Sig>, Error> {\n    let mut refined = HashMap::new();\n    for def in defs {\n        if !def.hoisted {\n            continue;\n        }\n        let func = check_hoisted_def(ctx, def)?;\n        refined.insert(\n            def.name.clone(),\n            Sig {\n                param: func.param_ty.clone(),\n                ret: func.body.ty.clone(),\n            },\n        );\n    }\n    Ok(refined)\n}\n\nfn synth(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\n    let tir = synth_inner(ctx, expr)?;\n    // A sink is not a value, so it can exist only where `tail_pipe` or `sink_call` recognized a\n    // sink position: the program's own body or a Sink-returning function's. Reaching `synth`\n    // with a sink means it is nested where its output would be observed, which is the general\n    // position rule.\n    if tir.ty.contains_sink() {\n        return Err(Error::new(\n            expr.span(),\n            \"a sink is not a value, so it is legal only as the program's outermost expression \\\n             or a Sink-returning function's body\"\n                .to_string(),\n        ));\n    }\n    Ok(tir)\n}\n\nfn synth_inner(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\n    match expr {\n        Expr::Str { text, .. } => Ok(Tir::new(Type::Str, Kind::Str(text.clone()))),\n        Expr::Stdin { span } => {\n            if let Some(func) = ctx.in_fn {\n                return Err(source_in_fn(*span, \"stdin\", func));\n            }\n            if ctx.in_mapper {\n                return Err(Error::new(\n                    *span,\n                    \"`stdin` cannot be read inside a mapper body, which runs once per element\"\n                        .to_string(),\n                ));\n            }\n            if ctx.lines_used.get() {\n                return Err(Error::new(\n                    *span,\n                    \"`stdin` has already been read; there is only one stdin\".to_string(),\n                ));\n            }\n            ctx.lines_used.set(true);\n            Ok(Tir::new(Type::Stream(Box::new(Type::Str)), Kind::Lines))\n        }\n        // `dsv` reads the same raw lines `lines` does and splits each on the delimiter, so it\n        // shares every rule: refused in function and mapper bodies, read at most once, and its\n        // type is fixed (`Vec<Vec<Str>>`) rather than borrowed from a position. `csv`/`tsv`\n        // are this same node with the delimiter already fixed by the parser.\n        Expr::Dsv { delim, span } => {\n            if let Some(func) = ctx.in_fn {\n                return Err(Error::new(\n                    *span,\n                    format!(\n                        \"`dsv` cannot be read inside `fn {func}`; a source is legal only in \\\n                         the program's own body, so take the value through a parameter\"\n                    ),\n                ));\n            }\n            if ctx.in_mapper {\n                return Err(Error::new(\n                    *span,\n                    \"`dsv` cannot be read inside a mapper body, which runs once per element\"\n                        .to_string(),\n                ));\n            }\n            // Every backend's split on an empty separator is its own undefined behaviour (Rust\n            // panics, Python raises, jq matches nothing), so the empty delimiter is refused\n            // rather than left to disagree.\n            if delim.is_empty() {\n                return Err(Error::new(\n                    *span,\n                    \"`dsv`'s delimiter cannot be empty\".to_string(),\n                ));\n            }\n            if ctx.dsv.borrow().is_some() {\n                return Err(Error::new(\n                    *span,\n                    \"`dsv` has already been read; there is only one stdin\".to_string(),\n                ));\n            }\n            *ctx.dsv.borrow_mut() = Some(delim.clone());\n            let field = Type::Vec(Box::new(Type::Str));\n            Ok(Tir::new(\n                Type::Vec(Box::new(field)),\n                Kind::Dsv {\n                    delim: delim.clone(),\n                },\n            ))\n        }\n        Expr::Int { value, span } => {\n            // The literal is the one place a value could enter without meeting the 32-bit rule,\n            // and four backends agreed on the wrong answer only because each held it in its own\n            // wider representation until an operator wrapped it. Go refuses to compile such a\n            // constant at all, which is what made the hole visible. A wider literal is not\n            // guessed to be Int64 -- `expect_inner` resolves one only where an Int64 is\n            // already expected, the same rule `[]` follows.\n            if *value > i32::MAX as i64 {\n                return Err(Error::new(\n                    *span,\n                    format!(\n                        \"integer `{value}` does not fit in Int, which is 32 bits; only a \\\n                         position that expects Int64 can hold it\"\n                    ),\n                ));\n            }\n            Ok(Tir::new(Type::Int, Kind::Int(*value)))\n        }\n\n        // A float literal is exactly the binary64 it spells (ADR 0007): there is no width to\n        // resolve and no range to check, so a position has nothing to contribute, unlike Int.\n        Expr::Float { value, span } => {\n            let _ = span;\n            Ok(Tir::new(Type::Float, Kind::Float(*value)))\n        }\n\n        Expr::Subject { span } => match &ctx.subject {\n            Some((ty, id)) => Ok(Tir::new(ty.clone(), Kind::Local(*id))),\n            None => Err(Error::new(*span, \"`.` is not bound here\")),\n        },\n\n        // Innermost binding first: a pattern binding shadows a parameter, and a parameter\n        // shadows a variant, the way any binding shadows a constant.\n        Expr::Var { name, span } => {\n            if let Some((_, payload_ty, pid)) =\n                ctx.arm_fields.iter().rev().find(|(n, _, _)| n == name)\n            {\n                let fty = payload_ty\n                    .field(name)\n                    .expect(\"the field existed when the pattern was checked\")\n                    .clone();\n                let base = Tir::new(payload_ty.clone(), Kind::Local(*pid));\n                return Ok(Tir::new(\n                    fty,\n                    Kind::Field {\n                        base: Box::new(base),\n                        name: name.clone(),\n                    },\n                ));\n            }\n            if let Some((_, t, local)) = ctx.scope.iter().rev().find(|(n, _, _)| n == name) {\n                return match local {\n                    // A `let`-bound name reads the local it was bound to, not a `Var`: the\n                    // backends' `Bind` only ever binds locals, so a bare name reference would dangle.\n                    Some(id) => Ok(Tir::new(t.clone(), Kind::Local(*id))),\n                    None => Ok(Tir::new(t.clone(), Kind::Var(name.clone()))),\n                };\n            }\n            if let Some(owners) = ctx.variant_owners.get(name) {\n                let enum_ty = sole_owner(ctx, name, owners, *span)?.clone();\n                return construct(ctx, &enum_ty, name, *span, None, None, false);\n            }\n            // A function is not a value, but \"`f` is not defined\" for a defined function is a\n            // lie. This is where `f -1` lands: `-` cannot start a bare argument, so the parse\n            // is subtraction and `f` arrives here alone.\n            if ctx.sigs.contains_key(name) || BUILTIN_NAMES.contains(&name.as_str()) {\n                return Err(Error::new(\n                    *span,\n                    format!(\"`{name}` is a function, not a value; write `{name}(...)` to call it\"),\n                ));\n            }\n            Err(Error::new(*span, format!(\"`{name}` is not defined\")))\n        }\n\n        Expr::RecordLit { fields, .. } => {\n            let mut built: Vec<(String, Tir)> = Vec::new();\n            for (name, name_span, value) in fields {\n                if built.iter().any(|(seen, _)| seen == name) {\n                    return Err(Error::new(\n                        *name_span,\n                        format!(\"field `{name}` is given twice\"),\n                    ));\n                }\n                let field = synth(ctx, value)?;\n                // A stream can never enter a record: a record's fields can be printed, copied,\n                // and read back out by name, none of which make sense for a single-use stream,\n                // and no path exists for a stream-typed field to leave one again once inside.\n                if field.ty.contains_stream() {\n                    return Err(Error::new(\n                        value.span(),\n                        format!(\"`{name}` cannot hold a stream, which has nothing to store\"),\n                    ));\n                }\n                built.push((name.clone(), field));\n            }\n            // Declaration order, kept as written: the type's field list and this literal's\n            // fields stay index-for-index aligned, which is what the columnar backends key on.\n            let ty = Type::Record(\n                built\n                    .iter()\n                    .map(|(n, t)| (n.clone(), t.ty.clone()))\n                    .collect(),\n            );\n            Ok(Tir::new(ty, Kind::RecordLit { fields: built }))\n        }\n\n        Expr::VecLit { items, span } => {\n            let Some(first) = items.first() else {\n                // Nothing says what an empty literal contains, and there is no expected type to\n                // supply it. Guessing here is what the annotation rule exists to avoid.\n                return Err(Error::new(*span, \"cannot tell what `[]` contains\"));\n            };\n            let head = synth(ctx, first)?;\n            let elem = head.ty.clone();\n            // Same reasoning as a record field: nothing can get a stream back out of a Vec\n            // once it is in one, and a Vec of them makes no sense when there is only ever one\n            // real stdin to begin with.\n            if elem.contains_stream() {\n                return Err(Error::new(\n                    first.span(),\n                    \"a Vec cannot hold a stream, which has nothing to store\".to_string(),\n                ));\n            }\n            let mut out = vec![head];\n            for item in &items[1..] {\n                out.push(expect(ctx, item, &elem)?);\n            }\n            Ok(Tir::new(Type::Vec(Box::new(elem)), Kind::VecLit(out)))\n        }\n\n        Expr::Pipe { lhs, rhs, .. } => match pipe(ctx, lhs, rhs, None)? {\n            Expected::Checked(tir) | Expected::Synthesised(tir) => Ok(tir),\n        },\n\n        // A `|>` node only ever appears as a program's or a Sink-returning function's body,\n        // which `check_program_body` and `check_defs` handle before `synth` is reached. A `Sink`\n        // result here is refused by `synth`'s wrapper with the general position rule, so this\n        // arm exists for totality and is only reachable through a shape the parser cannot make.\n        Expr::TailPipe { .. } => tail_pipe(ctx, expr),\n\n        Expr::Field { .. } | Expr::Index { .. } | Expr::Slice { .. } | Expr::Unwrap { .. } => {\n            let Access { tir, stream, .. } = access(ctx, expr)?;\n            // Projection over a stream is a mapper, and it is normalized to one here: the chain\n            // is rebased onto a fresh per-element param, so neither the backends nor fusion\n            // ever see a Field, Index, or Unwrap whose base is stream-typed.\n            if stream {\n                let param = ctx.fresh();\n                let Rebased { body, source } = rebase(tir, param);\n                return Ok(Tir::new(\n                    Type::Stream(Box::new(body.ty.clone())),\n                    Kind::Map {\n                        source: Box::new(source),\n                        param,\n                        body: Box::new(body),\n                    },\n                ));\n            }\n            Ok(tir)\n        }\n\n        // `v[]` with nothing after it is the identity: \"keep every entry\" is what a Vec (or\n        // stream) already is, with no field/index/unwrap left to distribute across it.\n        Expr::Project { .. } => {\n            let access = access(ctx, expr)?;\n            Ok(access.tir)\n        }\n\n        // `parse(stdin)` reads one value, so its first checked use fixes the type for the whole\n        // program -- and a later use in a position that expects nothing can borrow what the\n        // first use fixed. With no use typed yet, nothing says what it contains, and guessing\n        // is what the annotation rule avoids. `parse(s)` on an ordinary string cannot\n        // synthesise either: its result type comes only from the position it is checked in.\n        Expr::Call {\n            func,\n            func_span,\n            arg,\n            span,\n        } => call(ctx, func, *func_span, arg, *span),\n\n        Expr::Match { arms, span } => match_chain(ctx, arms, *span, None),\n\n        // A type name used as a match call (gh:152): sugar for a `Match` over `.`, resolved by\n        // `match_call` against the enum the name spells, then down to the same `match_chain`\n        // the ordinary `Match` runs.\n        Expr::MatchCall {\n            enum_name,\n            enum_span,\n            arms,\n            span,\n        } => match_call(ctx, enum_name, *enum_span, arms, *span),\n\n        Expr::Variant {\n            enum_name,\n            enum_span,\n            variant,\n            variant_span,\n            payload,\n            ..\n        } => {\n            let Some(enum_ty) = ctx.enums.get(enum_name) else {\n                return Err(Error::new(\n                    *enum_span,\n                    format!(\"`{enum_name}` is not an enum\"),\n                ));\n            };\n            construct(\n                ctx,\n                &enum_ty.clone(),\n                variant,\n                *variant_span,\n                payload.as_deref(),\n                None,\n                false,\n            )\n        }\n\n        Expr::Neg { base, span } => {\n            // A minus directly on a literal is part of the literal, so the most negative Int can\n            // be written even though its magnitude is one past the most positive. This is the\n            // rule Rust uses, and it is why `-` was not folded into the lexer: `a -1` has to\n            // stay `a - 1`.\n            if let Expr::Int { value, span: lit } = base.as_ref() {\n                if *value > -(i32::MIN as i64) {\n                    return Err(Error::new(\n                        *lit,\n                        format!(\n                            \"integer `-{value}` does not fit in Int, which is 32 bits; only a \\\n                             position that expects Int64 can hold it\"\n                        ),\n                    ));\n                }\n                return Ok(Tir::new(Type::Int, Kind::Int(-value)));\n            }\n            if let Expr::Float { value, .. } = base.as_ref() {\n                return Ok(Tir::new(Type::Float, Kind::Float(-value)));\n            }\n            // Synthesise first, so `-x` works at whichever integer width `x` already has; a\n            // form that can only be checked (`-input` fixing input to Int) falls back to the\n            // Int expectation this arm always applied.\n            let inner = match synth(ctx, base) {\n                Ok(inner) if matches!(inner.ty, Type::Int | Type::Int64 | Type::Float) => inner,\n                Ok(inner) => {\n                    return Err(Error::new(\n                        base.span(),\n                        format!(\"expected Int, found {}\", inner.ty),\n                    ));\n                }\n                Err(_) => expect(ctx, base, &Type::Int)?,\n            };\n            let width = inner.ty.clone();\n            // A Float's zero has to be `Kind::Float(0.0)`, not `Kind::Int(0)` typed as Float:\n            // every backend but JS keeps Int and Float in different representations (an i64 and\n            // an LLVM double are not interchangeable bits the way JS's untyped numbers let this\n            // slide), so a mismatched Kind here compiles on JS by accident and is a real bug on\n            // any backend that tells the two apart (kantord/toylang#149, found building the\n            // Native backend's Float support).\n            let zero_kind = if width == Type::Float {\n                Kind::Float(0.0)\n            } else {\n                Kind::Int(0)\n            };\n            let zero = Tir::new(width.clone(), zero_kind);\n            let _ = span;\n            Ok(Tir::new(\n                width,\n                Kind::Arith {\n                    op: BinOp::Sub,\n                    lhs: Box::new(zero),\n                    rhs: Box::new(inner),\n                },\n            ))\n        }\n\n        Expr::Binary { op, lhs, rhs, .. } => binary(ctx, *op, lhs, rhs),\n\n        // The connectives are the one place a subexpression may go unevaluated: `and` runs its\n        // right side only when the left is true, `or` only when it is false. Nothing here has\n        // to say so -- every backend emits its own short-circuiting operator -- but it is why\n        // `x != 0 and 10 / x > 1` is a program and not a division by zero.\n        Expr::Logic { op, lhs, rhs, .. } => {\n            let lhs = expect(ctx, lhs, &Type::Bool)?;\n            let rhs = expect(ctx, rhs, &Type::Bool)?;\n            Ok(Tir::new(\n                Type::Bool,\n                Kind::Logic {\n                    op: *op,\n                    lhs: Box::new(lhs),\n                    rhs: Box::new(rhs),\n                },\n            ))\n        }\n\n        Expr::Not { base, .. } => {\n            let base = expect(ctx, base, &Type::Bool)?;\n            Ok(Tir::new(Type::Bool, Kind::Not(Box::new(base))))\n        }\n\n        // A `let` block is only reachable as a function body, which is always checked against an\n        // expected return type, so `expect_inner` owns it. `synth` has no want to hand the block's\n        // value, so this arm is unreachable in practice but must exist for the match to be total.\n        Expr::Let { bindings, body, .. } => match let_bind(ctx, bindings, body, None)? {\n            Expected::Checked(_) => unreachable!(\"synth has no want, so nothing is Checked\"),\n            Expected::Synthesised(tir) => Ok(tir),\n        },\n    }\n}\n\n/// `synth`'s `Expr::Call` arm, pulled out on its own: a call is one of `select`/`map` (special\n/// forms rebinding `.`), a fixed sink or polymorphic builtin, or an ordinary user function or\n/// payload-constructor lookup, each with its own argument shape to check.\nfn call(\n    ctx: &Ctx,\n    func: &str,\n    func_span: Span,\n    arg: &Option<Box<Expr>>,\n    span: Span,\n) -> Result<Tir, Error> {\n    // `parse` is resolved by its position, so `synth` owns only the two shapes that need\n    // no expectation: `parse(stdin)` borrowing the type an earlier checked use fixed, and\n    // every other parse refusing outright (its result type comes only from a position).\n    if func == \"parse\" {\n        let arg = need_arg(arg, func, span)?;\n        if matches!(arg, Expr::Stdin { .. }) {\n            return match ctx.input.borrow().as_ref() {\n                Some(ty) => Ok(Tir::new(ty.clone(), Kind::Input)),\n                None => Err(Error::new(\n                    arg.span(),\n                    \"cannot tell what `parse(stdin)` contains\",\n                )),\n            };\n        }\n        return Err(Error::new(\n            func_span,\n            \"cannot tell what `parse` produces; its result type comes from the position it is \\\n             checked in\"\n                .to_string(),\n        ));\n    }\n    // `select` and `map` are not special syntax, only special names: they are ordinary calls\n    // whose argument is checked with `.` rebound to the subject's element type instead of\n    // evaluated in the enclosing scope, which no ordinary function needs and is why they cannot\n    // be defined as one (see `signatures`).\n    if func == \"select\" {\n        return select_call(ctx, need_arg(arg, func, span)?, span);\n    }\n    // The one way to produce a new element value. `select` removes elements and a field access\n    // reads a field; neither can turn a Vec<Int> into a Vec<Str>.\n    if func == \"map\" {\n        return map_call(ctx, need_arg(arg, func, span)?, span, None);\n    }\n    // `sort_by` and `max_by` order or reduce by a scalar projection, so they are subject-fed\n    // like `map`/`select`: the projection's `.` is rebound to the subject's element type. Blocking\n    // (ordering and maximum both need the whole Vec), so unlike `map` they take a Vec only, never\n    // a stream.\n    if func == \"sort_by\" {\n        return sort_by_call(ctx, need_arg(arg, func, span)?, span);\n    }\n    if func == \"max_by\" {\n        return max_by_call(ctx, need_arg(arg, func, span)?, span);\n    }\n    // The one sink builtin: a regular call now, typed `Sink`, and so subject to the same\n    // general position rule every sink is -- `synth`'s wrapper refuses a `Sink` result except\n    // where `sink_call` or the tail-pipeline `|>` (`tail_pipe`) born it. The old hand-checked\n    // `jsonlines` position in `check_program_body` retired in favor of that rule.\n    if func == \"jsonlines\" {\n        return jsonlines_call(ctx, arg, span);\n    }\n    // `length`, `tail`, and `flatten` are polymorphic over the element type, the same reason\n    // `jsonlines` is checked here rather than through `builtin()`'s fixed table.\n    if func == \"length\" {\n        return length_call(ctx, need_arg(arg, func, span)?);\n    }\n    // `None` on an empty Vec, the same way `Index` turns reaching past what's there into `Opt`\n    // rather than a runtime failure.\n    if func == \"tail\" {\n        return tail_call(ctx, need_arg(arg, func, span)?);\n    }\n    // Flattens a Vec<Vec<T>> into a Vec<T>, the way jq's `add` flattens a list of arrays.\n    // Joining a fixed, known count of Vecs is `+` (kantord/toylang#97); this is for when the\n    // outer Vec's length is not known at the call site.\n    if func == \"flatten\" {\n        return flatten_call(ctx, need_arg(arg, func, span)?);\n    }\n    // The one exit a stream has: `Stream<T> -> Vec<T>`, polymorphic over the element type like\n    // `length` and the others above, so the argument is synthesised first.\n    if func == \"collect\" {\n        return collect(ctx, need_arg(arg, func, span)?, None);\n    }\n    // Polymorphic over which record, the same reason `length` is checked here: the return type\n    // (`Vec<Str>`) is fixed, but the argument's shape is not.\n    if func == \"fields\" {\n        return fields_call(ctx, need_arg(arg, func, span)?);\n    }\n    // Blocking, one Vec in and one Vec out with no Stream instance (kantord/toylang#86, Q20 in\n    // draft.md), so both are checked here rather than through `select`'s subject-context\n    // mechanism.\n    if func == \"sort\" {\n        return sort_call(ctx, need_arg(arg, func, span)?);\n    }\n    if func == \"reverse\" {\n        return reverse_call(ctx, need_arg(arg, func, span)?);\n    }\n    // The two reductions (kantord/toylang#140): `sum` folds `+` at the element width, `max`\n    // returns `Opt` because an empty Vec has no maximum. Both are checked here rather than\n    // through `builtin()`'s fixed table because the return type is the element type's, which\n    // no fixed signature can express.\n    if func == \"sum\" {\n        return sum_call(ctx, need_arg(arg, func, span)?);\n    }\n    if func == \"max\" {\n        return max_call(ctx, need_arg(arg, func, span)?);\n    }\n    // The three search cuts (draft.md#query-is-search): `first` takes any element type\n    // the way `tail` does, `any` and `all` each take a Vec of Bool. All three are checked here\n    // rather than through `builtin()`'s fixed table: their return types are the element type's\n    // (or a fixed Bool), which no fixed signature can express.\n    if func == \"first\" {\n        return first_call(ctx, need_arg(arg, func, span)?);\n    }\n    if func == \"any\" {\n        return any_call(ctx, need_arg(arg, func, span)?);\n    }\n    if func == \"all\" {\n        return all_call(ctx, need_arg(arg, func, span)?);\n    }\n    if let Some((which, sig)) = builtin(func) {\n        let param_ty = sig\n            .param\n            .as_ref()\n            .expect(\"every builtin in the fixed table is unary\");\n        let arg = expect(ctx, need_arg(arg, func, span)?, param_ty)?;\n        return Ok(Tir::new(\n            sig.ret,\n            Kind::Builtin {\n                which,\n                arg: Box::new(arg),\n            },\n        ));\n    }\n    let Some(sig) = ctx.sigs.get(func) else {\n        // A payload constructor is ordinary application (the Q34 path), so `circle{r: 1}` lands\n        // here; it resolves as a variant only after the function namespace declines.\n        if let Some(owners) = ctx.variant_owners.get(func) {\n            let enum_ty = sole_owner(ctx, func, owners, func_span)?.clone();\n            return construct(ctx, &enum_ty, func, func_span, arg.as_deref(), None, false);\n        }\n        return Err(Error::new(func_span, format!(\"`{func}` is not a function\")));\n    };\n    // A non-`pub` definition is a helper for its own file: it may be called from where it was\n    // defined, and nowhere else. `file` is the caller's file, so a `Prelude`-origin private\n    // helper is refused from the program's file while remaining legal inside prelude.toy -- the\n    // same privacy a `pub` prelude function already kept from calling a private helper, now\n    // stated as a per-call-site rule rather than by dropping the helper (gh:166).\n    if let Some((origin, is_pub)) = ctx.visibility.get(func)\n        && !is_pub\n        && *origin != ctx.file\n    {\n        return Err(Error::new(\n            func_span,\n            format!(\"`{func}` is not `pub`, so it can only be called from its own file\"),\n        ));\n    }\n    let arg = call_arg(ctx, func, span, &sig.param, arg)?;\n    Ok(Tir::new(\n        sig.ret.clone(),\n        Kind::Call {\n            func: func.to_string(),\n            arg,\n        },\n    ))\n}\n\n/// A user function's argument against its (optionally nullary) signature: the four arity/type\n/// combinations a call and a signature can be in relative to each other.\nfn call_arg(\n    ctx: &Ctx,\n    func: &str,\n    span: Span,\n    param_ty: &Option<Type>,\n    arg: &Option<Box<Expr>>,\n) -> Result<Option<Box<Tir>>, Error> {\n    match (param_ty, arg) {\n        (Some(param_ty), Some(arg)) => Ok(Some(Box::new(expect(ctx, arg, param_ty)?))),\n        (None, None) => Ok(None),\n        (Some(param_ty), None) => Err(Error::new(\n            span,\n            format!(\"`{func}` needs an argument of {param_ty}, but was called with none\"),\n        )),\n        (None, Some(arg)) => Err(Error::new(\n            arg.span(),\n            format!(\"`{func}` takes no argument\"),\n        )),\n    }\n}\n\n/// Cardinality-polymorphic: the same subject-context mechanism types `select` over a Vec and\n/// over a Stream, with the element drawn from either's parameter. Stream in, stream out.\nfn select_call(ctx: &Ctx, arg: &Expr, span: Span) -> Result<Tir, Error> {\n    let Some((subject, id)) = ctx.subject.clone() else {\n        return Err(Error::new(\n            span,\n            \"`select` needs a subject, so it must follow `|`\",\n        ));\n    };\n    let Some(elem) = mapper_elem(&subject) else {\n        return Err(Error::new(\n            span,\n            format!(\"`select` needs a Vec or a stream, found {subject}\"),\n        ));\n    };\n    let param = ctx.fresh();\n    let inner = mapper_ctx(ctx, elem, param);\n    let pred = expect(&inner, arg, &Type::Bool)?;\n    let source = Tir::new(subject.clone(), Kind::Local(id));\n    Ok(Tir::new(\n        subject,\n        Kind::Select {\n            source: Box::new(source),\n            param,\n            pred: Box::new(pred),\n        },\n    ))\n}\n\n/// `jsonlines(x)`, the one sink builtin, typed `Sink`. A sink is not a value, so a direct call\n/// survives only where `sink_call` recognized the sink position (the program's body or a\n/// `Sink`-returning function's); anywhere else `synth` reaches the general rule and refuses\n/// the `Sink` result. The argument is a Vec or a Stream of elements with a wire form; Char has\n/// none.\nfn jsonlines_call(ctx: &Ctx, arg: &Option<Box<Expr>>, span: Span) -> Result<Tir, Error> {\n    let Some(arg) = arg else {\n        return Err(Error::new(\n            span,\n            \"`jsonlines` needs a Vec or a stream, but was called with no argument\".to_string(),\n        ));\n    };\n    let arg_span = arg.span();\n    let arg = synth(ctx, arg)?;\n    jsonlines_arg(arg, arg_span)\n}\n\n/// The `jsonlines` sink's argument rules, applied to a value already synthesised: a Vec or a\n/// Stream of elements with a wire form. Shared by the direct call and the `|>` tail-pipeline\n/// (`x |> jsonlines`), which differ only in where the argument came from.\nfn jsonlines_arg(arg: Tir, span: Span) -> Result<Tir, Error> {\n    if !matches!(arg.ty, Type::Vec(_) | Type::Stream(_)) {\n        return Err(Error::new(\n            span,\n            format!(\"`jsonlines` needs a Vec or a stream, found {}\", arg.ty),\n        ));\n    }\n    if arg.ty.contains_char() {","lineStart":1276,"lineEnd":2489,"totalLines":2490,"truncated":true}},"title":"src/check/mod.rs","time":{"start":1788705182928,"end":1788705182940}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"This is a large file. Let me continue reading to understand `synth`, `call`, `expect_inner`, and the visibility check for calls.","format":"unknown","index":0}]}},"id":"prt_0772314c9001MGhej7IJvKDX5g","sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","messageID":"msg_07722bec0001stH2ghBZAP3sse"}}
