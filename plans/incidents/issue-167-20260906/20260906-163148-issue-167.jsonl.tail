{"type":"tool_use","timestamp":1788705387665,"sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","part":{"type":"tool","tool":"bash","callID":"call_ade22ad0fdcd420c90e19980","state":{"status":"completed","input":{"command":"rg -n \"fn expect|fn expect_inner|fn conform|Expected\" src/check/mod.rs | head -30"},"output":"456:                Expected::Checked(body) => body,\n457:                Expected::Synthesised(body) => conform(&def_ctx, body, &sig.ret),\n1330:fn pipe(ctx: &Ctx, lhs: &Expr, rhs: &Expr, want: Option<&Type>) -> Result<Expected, Error> {\n1336:        None => Expected::Synthesised(synth(&inner, rhs)?),\n1339:        Expected::Checked(tir) => (true, tir),\n1340:        Expected::Synthesised(tir) => (false, tir),\n1372:        Expected::Checked(tir)\n1374:        Expected::Synthesised(tir)\n1392:) -> Result<Expected, Error> {\n1405:        None => Expected::Synthesised(synth(&body_ctx, body)?),\n1408:        Expected::Checked(tir) => (true, tir),\n1409:        Expected::Synthesised(tir) => (false, tir),\n1423:        Expected::Checked(tir)\n1425:        Expected::Synthesised(tir)\n2069:            Expected::Checked(tir) | Expected::Synthesised(tir) => Ok(tir),\n2239:            Expected::Checked(_) => unreachable!(\"synth has no want, so nothing is Checked\"),\n2240:            Expected::Synthesised(tir) => Ok(tir),\n3076:fn expect_int_width(ctx: &Ctx, rhs: &Expr, width: &Type, op: BinOp) -> Result<Tir, Error> {\n3239:enum Expected {\n3246:fn expect(ctx: &Ctx, expr: &Expr, want: &Type) -> Result<Tir, Error> {\n3248:        Expected::Checked(tir) => Ok(tir),\n3249:        Expected::Synthesised(found) => {\n3264:fn conform(ctx: &Ctx, found: Tir, want: &Type) -> Tir {\n3694:fn expect_inner(ctx: &Ctx, expr: &Expr, want: &Type) -> Result<Expected, Error> {\n3707:        return parse_call(ctx, arg, *span, want).map(Expected::Checked);\n3711:        return inputs_read(ctx, span, want).map(Expected::Checked);\n3720:        return collect(ctx, arg, Some(elem)).map(Expe