         Type::Param(p) => Some((p.clone(), a.clone())),\n444:             _ => None,\n445:         })\n446:         .collect();\n447:     variants\n448:         .iter()\n449:         .map(|(n, p)| (n.clone(), p.as_ref().map(|t| substitute(t, &bindings))))\n450:         .collect()\n451: }\n452: \n453: /// `variants_of` for an enum type in hand.\n454: pub fn variants(enums: &Enums, ty: &Type) -> Vec<(String, Option<Type>)> {\n455:     let Type::Enum { name, args, .. } = ty else {\n456:         unreachable!(\"only an enum has variants\")\n457:     };\n458:     variants_of(enums, name, args)\n459: }\n460: \n461: /// Whether a value of this enum type can hold another of the same type, however deep.\n462: ///\n463: /// Always through a `Vec`, since that is the only self-reference the checker allows, but not\n464: /// always directly: the path can run through a record field or a second enum. What it decides\n465: /// is whether a backend may expand this type inline -- a printer, a parser, a declaration\n466: /// written by walking the payloads -- or has to emit a named function it can call back into.\n467: /// Expanding a recursive one inline does not terminate.\n468: pub fn is_recursive(enums: &Enums, ty: &Type) -> bool {\n469:     fn reaches(enums: &Enums, from: &Type, target: &Type, seen: &mut Vec<Type>) -> bool {\n470:         match from {\n471:             Type::Vec(e) | Type::Stream(e) => reaches(enums, e, target, seen),\n472:             Type::Record(fields) => fields.iter().any(|(_, t)| reaches(enums, t, target, seen)),\n473:             Type::Enum { name, args, .. } => {\n474:                 if from == target {\n475:                     return true;\n476:                 }\n477:                 if seen.contains(from) {\n478:                     return false;\n479:                 }\n480:                 seen.push(from.clone());\n481:                 args.iter().any(|a| reaches(enums, a, target, seen))\n482:                     || variants_of(enums, name, args)\n483:                         .iter()\n484:                         .any(|(_, p)| p.as_ref().is_some_and(|p| reaches(enums, p, target, seen)))\n\n(Showing lines 405-484 of 496. Use offset=485 to continue.)\n</content>","metadata":{"preview":"        Type::Enum {\n            name,\n            args,\n            variants,\n        } => Type::Enum {\n            name: name.clone(),\n            args: args.iter().map(|a| substitute(a, map)).collect(),\n            variants: variants\n                .iter()\n                .map(|(n, p)| (n.clone(), p.as_ref().map(|p| substitute(p, map))))\n                .collect(),\n        },\n        Type::Str | Type::Int | Type::Int64 | Type::Float | Type::Bool | Type::Char | Type::Sink => {\n            t.clone()\n        }\n    }\n}\n\n/// `name`'s variant list at `args`, re-derived from the registry rather than trusted from\n/// whichever `Type::Enum` a caller happened to be holding. One layer deep: a payload that is","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-167/src/ty.rs","text":"        Type::Enum {\n            name,\n            args,\n            variants,\n        } => Type::Enum {\n            name: name.clone(),\n            args: args.iter().map(|a| substitute(a, map)).collect(),\n            variants: variants\n                .iter()\n                .map(|(n, p)| (n.clone(), p.as_ref().map(|p| substitute(p, map))))\n                .collect(),\n        },\n        Type::Str | Type::Int | Type::Int64 | Type::Float | Type::Bool | Type::Char | Type::Sink => {\n            t.clone()\n        }\n    }\n}\n\n/// `name`'s variant list at `args`, re-derived from the registry rather than trusted from\n/// whichever `Type::Enum` a caller happened to be holding. One layer deep: a payload that is\n/// itself the same enum comes back carrying the placeholder in turn, so asking again is what\n/// descends, and nothing tries to build a list that has no bottom.\npub fn variants_of(enums: &Enums, name: &str, args: &[Type]) -> Vec<(String, Option<Type>)> {\n    let Type::Enum {\n        args: template_args,\n        variants,\n        ..\n    } = &enums[name]\n    else {\n        unreachable!(\"the registry holds enum types\")\n    };\n    if template_args.is_empty() {\n        return variants.clone();\n    }\n    let bindings: HashMap<String, Type> = template_args\n        .iter()\n        .zip(args)\n        .filter_map(|(p, a)| match p {\n            Type::Param(p) => Some((p.clone(), a.clone())),\n            _ => None,\n        })\n        .collect();\n    variants\n        .iter()\n        .map(|(n, p)| (n.clone(), p.as_ref().map(|t| substitute(t, &bindings))))\n        .collect()\n}\n\n/// `variants_of` for an enum type in hand.\npub fn variants(enums: &Enums, ty: &Type) -> Vec<(String, Option<Type>)> {\n    let Type::Enum { name, args, .. } = ty else {\n        unreachable!(\"only an enum has variants\")\n    };\n    variants_of(enums, name, args)\n}\n\n/// Whether a value of this enum type can hold another of the same type, however deep.\n///\n/// Always through a `Vec`, since that is the only self-reference the checker allows, but not\n/// always directly: the path can run through a record field or a second enum. What it decides\n/// is whether a backend may expand this type inline -- a printer, a parser, a declaration\n/// written by walking the payloads -- or has to emit a named function it can call back into.\n/// Expanding a recursive one inline does not terminate.\npub fn is_recursive(enums: &Enums, ty: &Type) -> bool {\n    fn reaches(enums: &Enums, from: &Type, target: &Type, seen: &mut Vec<Type>) -> bool {\n        match from {\n            Type::Vec(e) | Type::Stream(e) => reaches(enums, e, target, seen),\n            Type::Record(fields) => fields.iter().any(|(_, t)| reaches(enums, t, target, seen)),\n            Type::Enum { name, args, .. } => {\n                if from == target {\n                    return true;\n                }\n                if seen.contains(from) {\n                    return false;\n                }\n                seen.push(from.clone());\n                args.iter().any(|a| reaches(enums, a, target, seen))\n                    || variants_of(enums, name, args)\n                        .iter()\n                        .any(|(_, p)| p.as_ref().is_some_and(|p| reaches(enums, p, target, seen)))","lineStart":405,"lineEnd":484,"totalLines":496,"truncated":true}},"title":"src/ty.rs","time":{"start":1788705456874,"end":1788705456883}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Good — Origin is only compared with `==` (in call's visibility check: `*origin != ctx.file`). No exhaustive matches. So adding `Origin::Module` is trivial.\n\nNow, a question: `parse::def()` sets `origin: Origin::Program` for defs parsed from a program file. For module files parsed via `parse_module`, defs also get `Origin::Program` (same `def()` helper!... wait, parse_module calls `p.def(...)` too, so origin: Program. build.rs/prelude::module() then overrides to Prelude. For submodules, I'll override to Module (or whatever the module's origin is) before check_module. Good.\n\nSo `check_module` signature: currently `check_module(module: &Module) -> Result<Vec<tir::Func>, Error>`. I'll change to something like:\n\n```rust\npub fn check_module(module: &Module) -> Result<Vec<tir::Func>, Error> { ... }\n```\n\nBut build.rs calls `check::check_module(&module)`. If I change the signature, build.rs must update. Also, `check_module` needs the modules cache/base/next_local for recursion. For the prelude, no recursion possible (prelude has no `@(`), so build.rs can pass a fresh cache.\n\nLet me design a `ModuleCtx` struct to avoid parameter soup:\n\n```rust\n/// The per-compile module-dispatch state, shared across the program and every loaded module. /// A module is loaded, checked, and cached the first time a `@(path)` reaches it; its\n/// functions and enums ride along so the program emits them.\nstruct Modules {\n    cache: HashMap<PathBuf, ModuleEntry>,\n    funcs: Vec<tir::Func>,\n    enums: Vec<(String, Type)>,\n}\n\nstruct ModuleEntry {\n    /// The renamed entry function the dispatch lowers to a call of.\n    func: String,\n    sig: Sig,\n}\n```\n\nAnd `Ctx` gets `modules: &'a RefCell<Modules>` and `base: Option<PathBuf>`? Hmm, base per file. `Ctx.base_dir: Option<&'a Path>`? Lifetimes... PathBuf clone per ctx is simplest: `base_dir: Option<PathBuf>`. But Ctx is rebuilt frequently (with/rebuild) — cloning a PathBuf each time is cheap enough. Hmm, but `Ctx::with` and `rebuild` create many copies... PathBuf clone per rebuild is fine (small.\n\nActually wait — there's another consideration. The `Modules` struct needs `&RefCell<Modules>` in Ctx. But Ctx::rebuild/with copy all fields... `&RefCell<Modules>` is Copy. Good.\n\n\n\nNow `check_module` signature. Let me make it:\n\n```rust\npub fn check_module(module: &crate::ast::Module, base_dir: Option<&Path>, modules: &RefCell<Modules>, next_local: &Cell<LocalId>, origin: Origin) -> Result<Vec<tir::Func>, Error>\n```\n\nThat's 5 params — the fn-params-excessive-bools style concern... but it's a private-ish helper (pub for build.rs...). Hmm, build.rs needs it pub. 5 params is meh. Alternatively a struct:\n\n```rust\npub struct ModuleInput<'a> { pub base_dir: Option<PathBuf>, pub modules: &'a RefCell<Modules>, ... }\n```\n\nOverkill. Let me just have `check_module(module, origin, base_dir, modules, next_local)`. Actually, let me look at how build.rs calls it once. Fine.\n\n I'll go with explicit params.\n\n but order: (module, origin, base_dir, modules, next_local). Hmm. Actually, since `Modules` and `next_local` are \"per compile\" state that check() owns, I'll define `check_module(module: &Module, ctx: &Ctx)`? No — Ctx has all fields (sigs, enums, etc.) built for the program... can't reuse. \n\nHmm, actually — could I implement module checking WITHOUT a separate check_module signature change, by... let me think. What if, instead of calling check_module, I build a fresh Ctx in the module-loading code (reusing the same fields as check_module but with base_dir + modules + next_local + origin)? That's duplicating check_module's body. Better to parameterize check_module.\n\n\n\nLet me write check_module:\n\n```rust\npub fn check_module(\n    module: &crate::ast::Module,\n    origin: Origin,\n    base_dir: Option<PathBuf>,\n    modules: &RefCell<Modules>,\n    next_local: &Cell<LocalId>,\n) -> Result<Vec<tir::Func>, Error> {\n    // ... existing body, but:\n    // - ctx.file: origin\n    // - ctx.base_dir: base_dir\n    // - ctx.modules: modules\n    // - ctx.next_local: next_local (instead of a fresh Cell)\n}\n```\n\nWait, but there's a problem with `next_local` sharing: check_module checks the module's defs, allocating locals. If locals must be globally unique... Let me check whether LocalIds need global uniqueness. In check::check, `next_local` is shared across all program defs AND the body. Are module funcs' locals colliding with program funcs' locals a problem? Each `tir::Func` body is emitted independently; LocalId references are scoped to a body (Binds introduce + reference within the same body. Cross-func LocalId collision is fine (two funcs can both use Local(0). Let me verify by looking at how backends emit Kind::Local — is it scoped per func? Emit_lua etc. emit each func as a Lua function with its own locals. LocalId is used as a name suffix in emitted code, e.g. `x0`. Two funcs both having x0 is fine. So a fresh next_local per module would be fine too! Then I don't even need to share next_local. check_module can keep its own fresh Cell as today. \n\nHmm wait, but actually there's `prune_unreachable` and fusion operating per func... LocalIds scoped per Func. Yes. So no sharing needed. \n\nSo check_module keeps its own `next_local = Cell::new(0)`. Only needs (module, origin, base_dir, modules).\n\n\n\nNow the modules cache design: when `resolve_module` loads a module, it needs:\n- read file from `ctx.base_dir.join(path)`,\n- parse_module,\n- set defs' origins to `Origin::Module`... wait — each module's origin should be `Origin::Module` (all modules share the variant; fine since checked separately).\n- prefix def names (`__module_{n}_`),\n- find `handle` (pub fn handle; error if missing/non-pub),\n- `check::check_module(&module, Origin::Module, module_dir, modules)` → funcs,\n- insert funcs into `modules.funcs`,\n- insert module enums into `modules.enums`,\n- cache entry (func: prefixed handle name, sig: handle sig).\n\nWait, the handle's sig: `check_module` computes sigs internally. I need the handle sig after. The Func for handle has `param_ty` and body.ty → sig. Or I can compute from `func.param_ty` and `func.body.ty`. The Func returned by check_module for handle: `name, param, param_ty, body`. So sig = `Sig { param: func.param_ty.clone(), ret: func.body.ty.clone() }`. Good.\n\nBut careful: `handle` could be hoisted (`fn handle = ...`)? `check_module` handles hoisted defs too. Then func.param_ty is Some(enum), body.ty the ret. Works.\n\n\n\nNow — a subtle issue with the prefix: `check_module` checks defs' bodies,where a def calls another def by its (prefixed) name? NO — defs' bodies reference names AS WRITTEN (e.g., `handle` calls `helper`). `sigs` is keyed by the names as parsed. If I rename defs (mutate `def.name` to `__module_0_helper`) BEFORE check_module, then `sigs` keys are the prefixed names, and a call to `helper` in the body won't resolve! So renaming before checking breaks internal calls!\n\nSo renaming must happen AFTER checking. But the `tir::Func.name` returned by check_module is the original name. I rename the Funcs' names after: `func.name = format!(\"{prefix}{}\", func.name)`. And the call site funcs (the dispatch lowering to `Kind::Call { func: <prefixed> }`) use the renamed entry name. Internal calls (already emitted as `Kind::Call { func: \"helper\" }` within the module's funcs bodies!) would then reference the UNPREFIXED \"helper\", which no func is named anymore! Broken!\n\nSo I must ALSO rename the `Kind::Call { func }` nodes inside the module's funcs bodies to the prefixed name. That means walking each emitted func's Tir and rewriting Call funcs for names that are in the module's sigs. That's a post-processing pass.\n\nAlternatively, rename defs BEFORE checking AND rewrite call sites in the AST bodies to prefixed names before checking. That's also a pass (walk each def body Expr, rewrite Call func strings for names in the module's def names). Hmm.\n\n\n\nCleanest: after check_module returns funcs, walk each func's Tir and replace `Kind::Call { func: n }` where `n` is one of the module's original def names with the prefixed name. Since every call to a same-module function by original name needs the prefix. This is a simple recursive rewrite over Tir.\n\n\n\nAlternatively — even simpler: give each module its own `sigs` with prefixed names from the start by... no, as noted the bodies reference unprefixed names.\n\n\n\nOK, the rewrite-after pass it is:\n\n```rust\nfn prefix_funcs(funcs: Vec<tir::Func>, prefix: &str) -> Vec<tir::Func> {\n    for f in &mut funcs {\n        f.name = format!(\"{prefix}{}\", f.name);\n        rename_calls(&mut f.body, prefix);\n    }\n    funcs\n}\n\nfn rename_calls(t: &mut Tir, prefix: &str) {\n    if let Kind::Call { func, .. } = &mut t.kind {\n        *func = format!(\"{prefix}{func}\");\n    }\n    // recurse into children\n    ...\n}\n```\n\nBut wait — a call to a BUILTIN (like `str`, `map`, `length`) has `Kind::Call`? No — builtins emit `Kind::Builtin`; ordinary user-function calls emit `Kind::Call`. In the module's funcs, `Kind::Call` nodes only refer to user functions (defined in the same module... or the program's functions?? Can a module call the program's functions? No — modules are standalone files; their bodies resolve only against their own sigs (which contain only their own defs... plus builtins. So every `Kind::Call` in a module func body references a same-module def. So renaming all Call funcs with the prefix is correct. \n\nHmm wait, is that fully true? `check_module` builds `sigs` from `module.defs` only. Calls resolve through `call()`: builtins first (Kind::Builtin), then `ctx.sigs.get(func)` → Kind::Call. So yes, Kind::Call funcs in module bodies are only module-internal names. Prefix them all. Good.\n\n\n\nNow — enums. Module enums: `module.enums` (with `is_pub`... check_module uses ALL enums? It builds enum_map from module.enums (all, including non-pub? Let me check: check_module: `enums: enum_map(&module.enums)?`. `module.enums` — parse_module collects all enums (pub and not. But prelude::module() filters to pub enums. For submodules, I should include... hmm, which enums? The module's defs' bodies reference enums by name — they resolve against ALL the module's enums (parse_module returns all. And the program's `program.enums` registry needs the enums that appear in emitted types (so backends can print. `ty::variants` looks up by name in program.enums. If a non-pub enum appears in a pub handle's sig... should that be allowed? Scope-wise: include all module enums in program.enums (simple, matches how types carry variants. Actually wait — do we even NEED module enums in program.enums at all? The backends use program.enums via `ty::variants(&program.enums, ty)`. Let me check what `ty::variants` does:","format":"unknown","index":0}]}},"id":"prt_0772742e5001BgXT6sPpa1viLi","sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","messageID":"msg_07726c961001XAo36O4qmSQfL2"}}
