{"type":"tool_use","timestamp":1788705226643,"sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","part":{"type":"tool","tool":"read","callID":"call_5d927dc8a3f84353860313da","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-167/tests/support/mod.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-167/tests/support/mod.rs</path>\n<type>file</type>\n<content>\n1: //! Loading the corpus.\n2: //!\n3: //! One case per file. A program, the input it reads, the output it must produce and whatever\n4: //! else it asks for are one thing, and were three files that only a shared stem tied together:\n5: //! a program whose `.out` was missing was a panic at load, and a `.in.json` whose stem was\n6: //! misspelt was silently a program that reads no input.\n7: //!\n8: //! Read by both the agreement harness and the native backend's tracker, which were two copies\n9: //! of the same directory walk.\n10: \n11: #![allow(dead_code)]\n12: \n13: use std::path::{Path, PathBuf};\n14: \n15: use serde::Deserialize;\n16: \n17: /// The file as written. `deny_unknown_fields` is the point of the struct: a misspelt key would\n18: /// otherwise be a case that quietly asks for nothing extra, which looks exactly like a case that\n19: /// passes.\n20: #[derive(Deserialize)]\n21: #[serde(deny_unknown_fields)]\n22: struct Fields {\n23:     program: String,\n24:     #[serde(default)]\n25:     input: Option<String>,\n26:     #[serde(default)]\n27:     output: Option<String>,\n28:     /// Set when the program compiles but every backend has to refuse to run it. What each says\n29:     /// while refusing is its own business, so only the refusal is compared.\n30:     #[serde(default)]\n31:     refuses: bool,\n32:     /// Backends whose emitted code is snapshotted for this program, for cases where what the\n33:     /// program prints is not the whole claim. Empty for most cases: running on every backend and\n34:     /// agreeing is the ordinary bar, and a snapshot on top of it is the exception.\n35:     #[serde(default)]\n36:     snapshot: Vec<String>,\n37:     /// The AST shapes this program exercises, in `toylang::tags` terms. Generated by\n38:     /// `tests/tag_corpus.rs` on every run, not hand-authored, so it is read here only to keep\n39:     /// `deny_unknown_fields` from rejecting it -- the fresh value always comes from `toylang::tags`.\n40:     #[serde(default)]\n41:     node_types: Vec<String>,\n42: }\n43: \n44: /// What every backend has to do with the program. A case says exactly one of these, because a\n45: /// case that says both, or neither, is one nobody wrote down the point of.\n46: pub enum Expect {\n47:     /// Every backend prints this, and they have to agree.\n48:     Output(String),\n49:     /// Every backend refuses to run it.\n50:     Refusal,\n51: }\n52: \n53: pub struct Case {\n54:     pub name: String,\n55:     pub program: String,\n56:     pub input: Option<String>,\n57:     pub expect: Expect,\n58:     pub snapshot: Vec<toylang::Backend>,\n59: }\n60: \n61: /// Runs `program` on every backend and reports how the run fell short of `expect`, one line per\n62: /// failure, empty when every backend did what the case asked. The corpus harness and the docs\n63: /// harness both feed programs through this: a docs fragment is a corpus case defined in prose,\n64: /// so what \"agrees\" means must be one definition, not two.\n65: pub fn agreement_failures(\n66:     name: &str,\n67:     program: &str,\n68:     input: Option<&str>,\n69:     expect: &Expect,\n70: ) -> Vec<String> {\n71:     let mut failures = Vec::new();\n72: \n73:     if let Expect::Refusal = expect {\n74:         for backend in toylang::Backend::ALL {\n75:             if let Ok(out) = toylang::run_on(program, input, backend) {\n76:                 failures.push(format!(\n77:                     \"RAN     {name}: {} produced {out:?} instead of refusing\",\n78:                     backend.name()\n79:                 ));\n80:             }\n81:         }\n82:         return failures;\n83:     }\n84:     let Expect::Output(want) = expect else {\n85:         unreachable!(\"refusal handled above\")\n86:     };\n87: \n88:     let mut outputs: Vec<(&str, String)> = Vec::new();\n89:     for backend in toylang::Backend::ALL {\n90:         // A backend that cannot run is reported, never skipped. A report saying every backend\n91:         // agreed when only one of them ran is worse than no report.\n92:         match toylang::run_on(program, input, backend) {\n93:             Ok(out) => outputs.push((backend.name(), out)),\n94:             Err(e) => failures.push(format!(\n95:                 \"BROKEN  {name}: {} could not run: {e}\",\n96:                 backend.name()\n97:             )),\n98:         }\n99:     }\n100: \n101:     if outputs.len() < toylang::Backend::ALL.len() {\n102:         return failures;\n103:     }\n104: \n105:     // Disagreement first, and reported on its own. Which backend matches the expectation is not\n106:     // the point: the language is underspecified either way.\n107:     let (_, first) = &outputs[0];\n108:     if outputs.iter().any(|(_, out)| out != first) {\n109:         let shown: Vec<String> = outputs.iter().map(|(n, o)| format!(\"{n}={o:?}\")).collect();\n110:         failures.push(format!(\"DISAGREE {name}: {}\", shown.join(\" \")));\n111:         return failures;\n112:     }\n113: \n114:     if first != want {\n115:         failures.push(format!(\n116:             \"WRONG   {name}: expected {want:?}, every backend gave {first:?}\"\n117:         ));\n118:     }\n119:     failures\n120: }\n121: \n122: pub fn dir() -> PathBuf {\n123:     Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"tests/corpus\")\n124: }\n125: \n126: pub fn cases() -> Vec<Case> {\n127:     let dir = dir();\n128:     let mut paths: Vec<PathBuf> = std::fs::read_dir(&dir)\n129:         .unwrap_or_else(|e| panic!(\"cannot read {}: {e}\", dir.display()))\n130:         .map(|e| e.expect(\"readable entry\").path())\n131:         .filter(|p| p.extension().is_some_and(|e| e == \"yaml\"))\n132:         .collect();\n133:     paths.sort();\n134: \n135:     paths\n136:         .into_iter()\n137:         .map(|path| {\n138:             let name = path\n139:                 .file_stem()\n140:                 .expect(\"has a stem\")\n141:                 .to_string_lossy()\n142:                 .into_owned();\n143:             let text = std::fs::read_to_string(&path).expect(\"readable case\");\n144:             let fields: Fields =\n145:                 serde_norway::from_str(&text).unwrap_or_else(|e| panic!(\"{name}: {e}\"));\n146:             let snapshot = fields\n147:                 .snapshot\n148:                 .iter()\n149:                 .map(|n| {\n150:                     toylang::Backend::from_name(n)\n151:                         .unwrap_or_else(|| panic!(\"{name}: `{n}` is not a backend\"))\n152:                 })\n153:                 .collect();\n154:             let expect = match (fields.output, fields.refuses) {\n155:                 (Some(output), false) => Expect::Output(output),\n156:                 (None, true) => Expect::Refusal,\n157:                 (Some(_), true) => panic!(\"{name}: has both `output` and `refuses`\"),\n158:                 (None, false) => panic!(\"{name}: has neither `output` nor `refuses`\"),\n159:             };\n160:             Case {\n161:                 name,\n162:                 program: fields.program,\n163:                 input: fields.input,\n164:                 expect,\n165:                 snapshot,\n166:             }\n167:         })\n168:         .collect()\n169: }\n\n(End of file - total 169 lines)\n</content>","metadata":{"preview":"//! Loading the corpus.\n//!\n//! One case per file. A program, the input it reads, the output it must produce and whatever\n//! else it asks for are one thing, and were three files that only a shared stem tied together:\n//! a program whose `.out` was missing was a panic at load, and a `.in.json` whose stem was\n//! misspelt was silently a program that reads no input.\n//!\n//! Read by both the agreement harness and the native backend's tracker, which were two copies\n//! of the same directory walk.\n\n#![allow(dead_code)]\n\nuse std::path::{Path, PathBuf};\n\nuse serde::Deserialize;\n\n/// The file as written. `deny_unknown_fields` is the point of the struct: a misspelt key would\n/// otherwise be a case that quietly asks for nothing extra, which looks exactly like a case that\n/// passes.\n#[derive(Deserialize)]","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-167/tests/support/mod.rs","text":"//! Loading the corpus.\n//!\n//! One case per file. A program, the input it reads, the output it must produce and whatever\n//! else it asks for are one thing, and were three files that only a shared stem tied together:\n//! a program whose `.out` was missing was a panic at load, and a `.in.json` whose stem was\n//! misspelt was silently a program that reads no input.\n//!\n//! Read by both the agreement harness and the native backend's tracker, which were two copies\n//! of the same directory walk.\n\n#![allow(dead_code)]\n\nuse std::path::{Path, PathBuf};\n\nuse serde::Deserialize;\n\n/// The file as written. `deny_unknown_fields` is the point of the struct: a misspelt key would\n/// otherwise be a case that quietly asks for nothing extra, which looks exactly like a case that\n/// passes.\n#[derive(Deserialize)]\n#[serde(deny_unknown_fields)]\nstruct Fields {\n    program: String,\n    #[serde(default)]\n    input: Option<String>,\n    #[serde(default)]\n    output: Option<String>,\n    /// Set when the program compiles but every backend has to refuse to run it. What each says\n    /// while refusing is its own business, so only the refusal is compared.\n    #[serde(default)]\n    refuses: bool,\n    /// Backends whose emitted code is snapshotted for this program, for cases where what the\n    /// program prints is not the whole claim. Empty for most cases: running on every backend and\n    /// agreeing is the ordinary bar, and a snapshot on top of it is the exception.\n    #[serde(default)]\n    snapshot: Vec<String>,\n    /// The AST shapes this program exercises, in `toylang::tags` terms. Generated by\n    /// `tests/tag_corpus.rs` on every run, not hand-authored, so it is read here only to keep\n    /// `deny_unknown_fields` from rejecting it -- the fresh value always comes from `toylang::tags`.\n    #[serde(default)]\n    node_types: Vec<String>,\n}\n\n/// What every backend has to do with the program. A case says exactly one of these, because a\n/// case that says both, or neither, is one nobody wrote down the point of.\npub enum Expect {\n    /// Every backend prints this, and they have to agree.\n    Output(String),\n    /// Every backend refuses to run it.\n    Refusal,\n}\n\npub struct Case {\n    pub name: String,\n    pub program: String,\n    pub input: Option<String>,\n    pub expect: Expect,\n    pub snapshot: Vec<toylang::Backend>,\n}\n\n/// Runs `program` on every backend and reports how the run fell short of `expect`, one line per\n/// failure, empty when every backend did what the case asked. The corpus harness and the docs\n/// harness both feed programs through this: a docs fragment is a corpus case defined in prose,\n/// so what \"agrees\" means must be one definition, not two.\npub fn agreement_failures(\n    name: &str,\n    program: &str,\n    input: Option<&str>,\n    expect: &Expect,\n) -> Vec<String> {\n    let mut failures = Vec::new();\n\n    if let Expect::Refusal = expect {\n        for backend in toylang::Backend::ALL {\n            if let Ok(out) = toylang::run_on(program, input, backend) {\n                failures.push(format!(\n                    \"RAN     {name}: {} produced {out:?} instead of refusing\",\n                    backend.name()\n                ));\n            }\n        }\n        return failures;\n    }\n    let Expect::Output(want) = expect else {\n        unreachable!(\"refusal handled above\")\n    };\n\n    let mut outputs: Vec<(&str, String)> = Vec::new();\n    for backend in toylang::Backend::ALL {\n        // A backend that cannot run is reported, never skipped. A report saying every backend\n        // agreed when only one of them ran is worse than no report.\n        match toylang::run_on(program, input, backend) {\n            Ok(out) => outputs.push((backend.name(), out)),\n            Err(e) => failures.push(format!(\n                \"BROKEN  {name}: {} could not run: {e}\",\n                backend.name()\n            )),\n        }\n    }\n\n    if outputs.len() < toylang::Backend::ALL.len() {\n        return failures;\n    }\n\n    // Disagreement first, and reported on its own. Which backend matches the expectation is not\n    // the point: the language is underspecified either way.\n    let (_, first) = &outputs[0];\n    if outputs.iter().any(|(_, out)| out != first) {\n        let shown: Vec<String> = outputs.iter().map(|(n, o)| format!(\"{n}={o:?}\")).collect();\n        failures.push(format!(\"DISAGREE {name}: {}\", shown.join(\" \")));\n        return failures;\n    }\n\n    if first != want {\n        failures.push(format!(\n            \"WRONG   {name}: expected {want:?}, every backend gave {first:?}\"\n        ));\n    }\n    failures\n}\n\npub fn dir() -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"tests/corpus\")\n}\n\npub fn cases() -> Vec<Case> {\n    let dir = dir();\n    let mut paths: Vec<PathBuf> = std::fs::read_dir(&dir)\n        .unwrap_or_else(|e| panic!(\"cannot read {}: {e}\", dir.display()))\n        .map(|e| e.expect(\"readable entry\").path())\n        .filter(|p| p.extension().is_some_and(|e| e == \"yaml\"))\n        .collect();\n    paths.sort();\n\n    paths\n        .into_iter()\n        .map(|path| {\n            let name = path\n                .file_stem()\n                .expect(\"has a stem\")\n                .to_string_lossy()\n                .into_owned();\n            let text = std::fs::read_to_string(&path).expect(\"readable case\");\n            let fields: Fields =\n                serde_norway::from_str(&text).unwrap_or_else(|e| panic!(\"{name}: {e}\"));\n            let snapshot = fields\n                .snapshot\n                .iter()\n                .map(|n| {\n                    toylang::Backend::from_name(n)\n                        .unwrap_or_else(|| panic!(\"{name}: `{n}` is not a backend\"))\n                })\n                .collect();\n            let expect = match (fields.output, fields.refuses) {\n                (Some(output), false) => Expect::Output(output),\n                (None, true) => Expect::Refusal,\n                (Some(_), true) => panic!(\"{name}: has both `output` and `refuses`\"),\n                (None, false) => panic!(\"{name}: has neither `output` nor `refuses`\"),\n            };\n            Case {\n                name,\n                program: fields.program,\n                input: fields.input,\n                expect,\n                snapshot,\n            }\n        })\n        .collect()\n}","lineStart":1,"lineEnd":169,"totalLines":169,"truncated":false}},"title":"tests/support/mod.rs","time":{"start":1788705226630,"end":1788705226638}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_07723bf83001wMGtEicTJR1l3K","sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","messageID":"msg_07723bb14001MKmpnbsbmX0Cva"}}
