s/streams.rs:229:        assert!(toylang::compile(\"collect stdin\").is_ok());\ntests/streaming.rs:138:    let program = toylang::compile(program).expect(\"compiles\");\ntests/streaming.rs:148:    let program = toylang::compile(program).expect(\"compiles\");\ntests/streaming.rs:168:    let program = toylang::compile(program).expect(\"compiles\");\ntests/streaming.rs:199:    let program = toylang::compile(program).expect(\"compiles\");\ntests/step_dsv.rs:5:    toylang::compile(src).map(|_| ()).unwrap_err().to_string()\n","metadata":{"output":"tests/variant_casing.rs:7:    toylang::compile(src).map(|_| ()).unwrap_err().to_string()\ntests/variant_casing.rs:42:    assert_eq!(toylang::run(src).unwrap(), \"{\\\"a\\\":0,\\\"b\\\":9}\\n\");\ntests/unwrap.rs:13:    let wrapped = toylang::run_on(r#\"[\"ada\", \"bo\"][0]\"#, None, Backend::Lua).unwrap();\ntests/unwrap.rs:14:    let unwrapped = toylang::run_on(r#\"[\"ada\", \"bo\"][0]!\"#, None, Backend::Lua).unwrap();\ntests/unwrap.rs:22:    let err = toylang::compile(\"fn str(x: Int) -> Str = x\\nstr(1)\")\ntests/unwrap.rs:32:        toylang::compile(r#\"str(\"a\")\"#)\ntests/unwrap.rs:43:        toylang::compile(r#\"1 + \"a\"\"#)\ntests/unwrap.rs:56:        toylang::compile(r#\"\"a\" if 1 else \"b\"\"#)\ntests/unwrap.rs:68:        toylang::compile(r#\"\"a\" if 1 == 1 else 2\"#)\ntests/unwrap.rs:82:        toylang::compile(\"str(9999999999)\")\ntests/unwrap.rs:93:    assert!(toylang::compile(\"str(-2147483648)\").is_ok());\ntests/unwrap.rs:95:        toylang::compile(\"str(-2147483649)\")\ntests/unwrap.rs:108:    let err = toylang::run_on(src, Some(r#\"{\"t\": 9999999999}\"#), Backend::Lua)\ntests/unwrap.rs:115:        let ok = toylang::run_on(src, Some(r#\"{\"t\": 2147483647}\"#), backend);\ntests/unwrap.rs:129:        toylang::compile(\"{a: 1, a: 2}\")\ntests/unwrap.rs:141:        toylang::compile(\"fn User(c: {n: Str}) -> Str = c.n\\n\\nUser {n: \\\"a\\\"}\")\ntests/unwrap.rs:154:        toylang::compile(\"[1, 2][0]!=1\")\