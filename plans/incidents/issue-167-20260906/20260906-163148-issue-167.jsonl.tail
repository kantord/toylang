{"type":"tool_use","timestamp":1788705333067,"sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","part":{"type":"tool","tool":"read","callID":"call_3978dd28bfda4344878f1554","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-167/build.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-167/build.rs</path>\n<type>file</type>\n<content>\n1: //! Regenerates prelude.toy's checked form on every build (kantord/toylang#73), so `prelude::checked`\n2: //! can hand back its functions as already-typed `tir::Func` values instead of the library parsing\n3: //! and type-checking prelude.toy itself on every compile. Reuses the library's own parser and\n4: //! checker rather than duplicating their logic: `ast`, `error`, `ty`, `tir`, `parse`, and `check`\n5: //! below are the same source files `src/lib.rs` compiles, pulled in as this script's own modules\n6: //! because a build script cannot depend on the crate it is building. None of them touch a backend,\n7: //! `main.rs`, or anything else outside this closed set, so there is nothing else to pull in.\n8: //!\n9: //! What comes out is not those checked values themselves (this process ends when the script\n10: //! does) but Rust source text that reconstructs them: a `ToRust` impl per type below renders each\n11: //! one as the literal expression that builds it, so `prelude::checked` gets back a plain\n12: //! `Vec<tir::Func>`, no parsing, deserialization, or unsafe transmute involved.\n13: //!\n14: //! A `Kind` field that is `Box<Tir>` in `tir.rs` still passes as plain `&Tir` to the helpers\n15: //! below (deref coercion) -- `boxed()` re-adds the `Box::new(...)` explicitly, at the one call\n16: //! site that field needs it, rather than a helper declaring `&Box<Tir>` to get it automatically.\n17: \n18: #[path = \"src/ast.rs\"]\n19: mod ast;\n20: #[path = \"src/check/mod.rs\"]\n21: mod check;\n22: #[path = \"src/error.rs\"]\n23: mod error;\n24: #[path = \"src/parse.rs\"]\n25: mod parse;\n26: #[path = \"src/tir.rs\"]\n27: mod tir;\n28: #[path = \"src/ty.rs\"]\n29: mod ty;\n30: \n31: /// `check::mod`'s `check` function (unused here -- this script only calls `check::check_module`)\n32: /// calls `crate::prelude::checked()`, so that name has to resolve for the file to compile at\n33: /// all. The real `src/prelude.rs` can't fill in for it: its own `checked()` is generated from\n34: /// the very file this script is producing. An empty stand-in is enough, since `check` never\n35: /// actually runs in this binary.\n36: mod prelude {\n37:     pub fn checked() -> Vec<crate::tir::Func> {\n38:         Vec::new()\n39:     }\n40: }\n41: \n42: trait ToRust {\n43:     /// The Rust expression that builds a value equal to this one.\n44:     fn to_rust(&self) -> String;\n45: }\n46: \n47: impl ToRust for String {\n48:     fn to_rust(&self) -> String {\n49:         format!(\"{self:?}.to_string()\")\n50:     }\n51: }\n52: \n53: impl ToRust for str {\n54:     fn to_rust(&self) -> String {\n55:         format!(\"{self:?}\")\n56:     }\n57: }\n58: \n59: impl ToRust for bool {\n60:     fn to_rust(&self) -> String {\n61:         self.to_string()\n62:     }\n63: }\n64: \n65: impl ToRust for i64 {\n66:     fn to_rust(&self) -> String {\n67:         format!(\"{self}i64\")\n68:     }\n69: }\n70: \n71: impl ToRust for f64 {\n72:     fn to_rust(&self) -> String {\n73:         format!(\"{self}f64\")\n74:     }\n75: }\n76: \n77: impl ToRust for u32 {\n78:     fn to_rust(&self) -> String {\n79:         format!(\"{self}u32\")\n80:     }\n81: }\n82: \n83: impl ToRust for usize {\n84:     fn to_rust(&self) -> String {\n85:         format!(\"{self}usize\")\n86:     }\n87: }\n88: \n89: impl<T: ToRust> ToRust for Option<T> {\n90:     fn to_rust(&self) -> String {\n91:         match self {\n92:             Some(v) => format!(\"Some({})\", v.to_rust()),\n93:             None => \"None\".to_string(),\n94:         }\n95:     }\n96: }\n97: \n98: impl<T: ToRust> ToRust for Box<T> {\n99:     fn to_rust(&self) -> String {\n100:         format!(\"Box::new({})\", (**self).to_rust())\n101:     }\n102: }\n103: \n104: impl<T: ToRust> ToRust for [T] {\n105:     fn to_rust(&self) -> String {\n106:         let items: Vec<String> = self.iter().map(ToRust::to_rust).collect();\n107:         format!(\"vec![{}]\", items.join(\", \"))\n108:     }\n109: }\n110: \n111: impl<A: ToRust, B: ToRust> ToRust for (A, B) {\n112:     fn to_rust(&self) -> String {\n113:         format!(\"({}, {})\", self.0.to_rust(), self.1.to_rust())\n114:     }\n115: }\n116: \n117: impl ToRust for ast::BinOp {\n118:     fn to_rust(&self) -> String {\n119:         let variant = match self {\n120:             ast::BinOp::Add => \"Add\",\n121:             ast::BinOp::Sub => \"Sub\",\n122:             ast::BinOp::Mul => \"Mul\",\n123:             ast::BinOp::Div => \"Div\",\n124:             ast::BinOp::Rem => \"Rem\",\n125:             ast::BinOp::Eq => \"Eq\",\n126:             ast::BinOp::Ne => \"Ne\",\n127:             ast::BinOp::Lt => \"Lt\",\n128:             ast::BinOp::Le => \"Le\",\n129:             ast::BinOp::Gt => \"Gt\",\n130:             ast::BinOp::Ge => \"Ge\",\n131:         };\n132:         format!(\"crate::ast::BinOp::{variant}\")\n133:     }\n134: }\n135: \n136: impl ToRust for ast::LogicOp {\n137:     fn to_rust(&self) -> String {\n138:         let variant = match self {\n139:             ast::LogicOp::And => \"And\",\n140:             ast::LogicOp::Or => \"Or\",\n141:         };\n142:         format!(\"crate::ast::LogicOp::{variant}\")\n143:     }\n144: }\n145: \n146: impl ToRust for ty::Type {\n147:     fn to_rust(&self) -> String {\n148:         match self {\n149:             ty::Type::Str => \"crate::ty::Type::Str\".to_string(),\n150:             ty::Type::Int => \"crate::ty::Type::Int\".to_string(),\n151:             ty::Type::Int64 => \"crate::ty::Type::Int64\".to_string(),\n152:             ty::Type::Float => \"crate::ty::Type::Float\".to_string(),\n153:             ty::Type::Bool => \"crate::ty::Type::Bool\".to_string(),\n154:             ty::Type::Char => \"crate::ty::Type::Char\".to_string(),\n155:             ty::Type::Vec(elem) => format!(\"crate::ty::Type::Vec({})\", elem.to_rust()),\n156:             ty::Type::Stream(elem) => format!(\"crate::ty::Type::Stream({})\", elem.to_rust()),\n157:             ty::Type::Sink => \"crate::ty::Type::Sink\".to_string(),\n158:             ty::Type::Record(fields) => {\n159:                 format!(\"crate::ty::Type::Record({})\", fields.to_rust())\n160:             }\n161:             ty::Type::Enum {\n162:                 name,\n163:                 args,\n164:                 variants,\n165:             } => format!(\n166:                 \"crate::ty::Type::Enum {{ name: {}, args: {}, variants: {} }}\",\n167:                 name.to_rust(),\n168:                 args.to_rust(),\n169:                 variants.to_rust(),\n170:             ),\n171:             ty::Type::Param(name) => format!(\"crate::ty::Type::Param({})\", name.to_rust()),\n172:         }\n173:     }\n174: }\n175: \n176: impl ToRust for tir::Builtin {\n177:     fn to_rust(&self) -> String {\n178:         let variant = match self {\n179:             tir::Builtin::IntToStr => \"IntToStr\",\n180:             tir::Builtin::IntToI64 => \"IntToI64\",\n181:             tir::Builtin::Range => \"Range\",\n182:             tir::Builtin::Collect => \"Collect\",\n183:             tir::Builtin::JsonLines => \"JsonLines\",\n184:             tir::Builtin::Length => \"Length\",\n185:             tir::Builtin::Flatten => \"Flatten\",\n186:             tir::Builtin::Tail => \"Tail\",\n187:             tir::Builtin::Fields => \"Fields\",\n188:             tir::Builtin::Chars => \"Chars\",\n189:             tir::Builtin::Sort => \"Sort\",\n190:             tir::Builtin::Reverse => \"Reverse\",\n191:             tir::Builtin::Sum => \"Sum\",\n192:             tir::Builtin::Max => \"Max\",\n193:             tir::Builtin::Parse => \"Parse\",\n194:             tir::Builtin::First => \"First\",\n195:             tir::Builtin::Any => \"Any\",\n196:             tir::Builtin::All => \"All\",\n197:         };\n198:         format!(\"crate::tir::Builtin::{variant}\")\n199:     }\n200: }\n201: \n202: impl ToRust for tir::Tir {\n203:     fn to_rust(&self) -> String {\n204:         format!(\n205:             \"crate::tir::Tir::new({}, {})\",\n206:             self.ty.to_rust(),\n207:             self.kind.to_rust()\n208:         )\n209:     }\n210: }\n211: \n212: impl ToRust for tir::MatchArm {\n213:     fn to_rust(&self) -> String {\n214:         format!(\n215:             \"crate::tir::MatchArm {{ variant: {}, guard: {}, payload: {}, body: {} }}\",\n216:             self.variant.to_rust(),\n217:             self.guard.to_rust(),\n218:             self.payload.to_rust(),\n219:             self.body.to_rust(),\n220:         )\n221:     }\n222: }\n223: \n224: /// `crate::tir::Kind::{name} { k1: v1, k2: v2, ... }`, the shape shared by every struct-like\n225: /// `Kind` variant. One small function per variant below builds its own field list and calls\n226: /// this, which is what keeps the dispatching match in `Kind::to_rust` to one line per variant --\n227: /// laid out as a table, not a 100-line function apiece.\n228: fn variant(name: &str, fields: &[(&str, String)]) -> String {\n229:     let rendered: Vec<String> = fields.iter().map(|(k, v)| format!(\"{k}: {v}\")).collect();\n230:     format!(\"crate::tir::Kind::{name} {{ {} }}\", rendered.join(\", \"))\n231: }\n232: \n233: /// `tir.rs` stores a `Tir` child as `Box<Tir>`; this is the `Box::new(...)` that reconstructs\n234: /// it, called explicitly at each field that needs it rather than a helper below taking `&Box<Tir>`\n235: /// to get the wrapping automatically -- a plain `&Tir` parameter is what a `Box<Tir>` field\n236: /// coerces to at the call site regardless, so declaring the box type would buy nothing.\n237: fn boxed(t: &tir::Tir) -> String {\n238:     format!(\"Box::new({})\", t.to_rust())\n239: }\n240: \n241: fn record_lit(fields: &[(String, tir::Tir)]) -> String {\n242:     variant(\"RecordLit\", &[(\"fields\", fields.to_rust())])\n243: }\n244: fn enum_lit(variant_name: &String, payload: &Option<Box<tir::Tir>>) -> String {\n245:     variant(\n246:         \"EnumLit\",\n247:         &[\n248:             (\"variant\", variant_name.to_rust()),\n249:             (\"payload\", payload.to_rust()),\n250:         ],\n251:     )\n252: }\n253: fn opt_map(source: &tir::Tir, param: &tir::LocalId, body: &tir::Tir) -> String {\n254:     variant(\n255:         \"OptMap\",\n256:         &[\n257:             (\"source\", boxed(source)),\n258:             (\"param\", param.to_rust()),\n259:             (\"body\", boxed(body)),\n260:         ],\n261:     )\n262: }\n263: fn call(func: &String, arg: &Option<Box<tir::Tir>>) -> String {\n264:     variant(\"Call\", &[(\"func\", func.to_rust()), (\"arg\", arg.to_rust())])\n265: }\n266: fn arith(op: &ast::BinOp, lhs: &tir::Tir, rhs: &tir::Tir) -> String {\n267:     variant(\n268:         \"Arith\",\n269:         &[\n270:             (\"op\", op.to_rust()),\n271:             (\"lhs\", boxed(lhs)),\n272:             (\"rhs\", boxed(rhs)),\n273:         ],\n274:     )\n275: }\n276: fn compare(op: &ast::BinOp, lhs: &tir::Tir, rhs: &tir::Tir) -> String {\n277:     variant(\n278:         \"Compare\",\n279:         &[\n280:             (\"op\", op.to_rust()),\n281:             (\"lhs\", boxed(lhs)),\n282:             (\"rhs\", boxed(rhs)),\n283:         ],\n284:     )\n285: }\n286: fn logic(op: &ast::LogicOp, lhs: &tir::Tir, rhs: &tir::Tir) -> String {\n287:     variant(\n288:         \"Logic\",\n289:         &[\n290:             (\"op\", op.to_rust()),\n291:             (\"lhs\", boxed(lhs)),\n292:             (\"rhs\", boxed(rhs)),\n293:         ],\n294:     )\n295: }\n296: fn bind(local: &tir::LocalId, value: &tir::Tir, body: &tir::Tir) -> String {\n297:     variant(\n298:         \"Bind\",\n299:         &[\n300:             (\"local\", local.to_rust()),\n301:             (\"value\", boxed(value)),\n302:             (\"body\", boxed(body)),\n303:         ],\n304:     )\n305: }\n306: fn map(source: &tir::Tir, param: &tir::LocalId, body: &tir::Tir) -> String {\n307:     variant(\n308:         \"Map\",\n309:         &[\n310:             (\"source\", boxed(source)),\n311:             (\"param\", param.to_rust()),\n312:             (\"body\", boxed(body)),\n313:         ],\n314:     )\n315: }\n316: fn select(source: &tir::Tir, param: &tir::LocalId, pred: &tir::Tir) -> String {\n317:     variant(\n318:         \"Select\",\n319:         &[\n320:             (\"source\", boxed(source)),\n321:             (\"param\", param.to_rust()),\n322:             (\"pred\", boxed(pred)),\n323:         ],\n324:     )\n325: }\n326: fn sort_by(source: &tir::Tir, param: &tir::LocalId, body: &tir::Tir) -> String {\n327:     variant(\n328:         \"SortBy\",\n329:         &[\n330:             (\"source\", boxed(source)),\n331:             (\"param\", param.to_rust()),\n332:             (\"body\", boxed(body)),\n333:         ],\n334:     )\n335: }\n336: fn max_by(source: &tir::Tir, param: &tir::LocalId, body: &tir::Tir) -> String {\n337:     variant(\n338:         \"MaxBy\",\n339:         &[\n340:             (\"source\", boxed(source)),\n341:             (\"param\", param.to_rust()),\n342:             (\"body\", boxed(body)),\n343:         ],\n344:     )\n345: }\n346: fn field(base: &tir::Tir, name: &String) -> String {\n347:     variant(\"Field\", &[(\"base\", boxed(base)), (\"name\", name.to_rust())])\n348: }\n349: fn builtin(which: &tir::Builtin, arg: &tir::Tir) -> String {\n350:     variant(\n351:         \"Builtin\",\n352:         &[(\"which\", which.to_rust()), (\"arg\", boxed(arg))],\n353:     )\n354: }\n355: fn index(base: &tir::Tir, index: &tir::Tir, depth: &usize, elem_is_record: &bool) -> String {\n356:     variant(\n357:         \"Index\",\n358:         &[\n359:             (\"base\", boxed(base)),\n360:             (\"index\", boxed(index)),\n361:             (\"depth\", depth.to_rust()),\n362:             (\"elem_is_record\", elem_is_record.to_rust()),\n363:         ],\n364:     )\n365: }\n366: fn slice(\n367:     base: &tir::Tir,\n368:     start: &Option<Box<tir::Tir>>,\n369:     end: &Option<Box<tir::Tir>>,\n370:     depth: &usize,\n371: ) -> String {\n372:     variant(\n373:         \"Slice\",\n374:         &[\n375:             (\"base\", boxed(base)),\n376:             (\"start\", start.to_rust()),\n377:             (\"end\", end.to_rust()),\n378:             (\"depth\", depth.to_rust()),\n379:         ],\n380:     )\n381: }\n382: fn match_(subject: &tir::Tir, arms: &[tir::MatchArm], partial: &bool) -> String {\n383:     variant(\n384:         \"Match\",\n385:         &[\n386:             (\"subject\", boxed(subject)),\n387:             (\"arms\", arms.to_rust()),\n388:             (\"partial\", partial.to_rust()),\n389:         ],\n390:     )\n391: }\n392: \n393: /// Exhaustive on purpose: a `Kind` variant this does not know renders nothing rather than\n394: /// something wrong, and a match with no wildcard arm is what turns that into a build error the\n395: /// moment the checker can produce it, naming exactly the arm to add (kantord/toylang#73's\n396: /// \"independent of its growth\").\n397: impl ToRust for tir::Kind {\n398:     fn to_rust(&self) -> String {\n399:         use tir::Kind::*;\n400:         match self {\n401:             Str(s) => format!(\"crate::tir::Kind::Str({})\", s.to_rust()),\n402:             Int(n) => format!(\"crate::tir::Kind::Int({})\", n.to_rust()),\n403:             Float(n) => format!(\"crate::tir::Kind::Float({})\", n.to_rust()),\n404:             VecLit(items) => format!(\"crate::tir::Kind::VecLit({})\", items.to_rust()),\n405:             RecordLit { fields } => record_lit(fields),\n406:             EnumLit { variant, payload } => enum_lit(variant, payload),\n407:             OptMap {\n408:                 source,\n409:                 param,\n410:                 body,\n411:             } => opt_map(source, param, body),\n412:             Var(name) => format!(\"crate::tir::Kind::Var({})\", name.to_rust()),\n413:             Local(id) => format!(\"crate::tir::Kind::Local({})\", id.to_rust()),\n414:             Input => \"crate::tir::Kind::Input\".to_string(),\n415:             Inputs => \"crate::tir::Kind::Inputs\".to_string(),\n416:             Lines => \"crate::tir::Kind::Lines\".to_string(),\n417:             Dsv { delim } => format!(\"crate::tir::Kind::Dsv {{ delim: {} }}\", delim.to_rust()),\n418:             Call { func, arg } => call(func, arg),\n419:             Concat(a, b) => format!(\"crate::tir::Kind::Concat({}, {})\", a.to_rust(), b.to_rust()),\n420:             Arith { op, lhs, rhs } => arith(op, lhs, rhs),\n421:             Compare { op, lhs, rhs } => compare(op, lhs, rhs),\n422:             Logic { op, lhs, rhs } => logic(op, lhs, rhs),\n423:             Not(base) => format!(\"crate::tir::Kind::Not({})\", boxed(base)),\n424:             Bind { local, value, body } => bind(local, value, body),\n425:             Map {\n426:                 source,\n427:                 param,\n428:                 body,\n429:             } => map(source, param, body),\n430:             Select {\n431:                 source,\n432:                 param,\n433:                 pred,\n434:             } => select(source, param, pred),\n435:             SortBy {\n436:                 source,\n437:                 param,\n438:                 body,\n439:             } => sort_by(source, param, body),\n440:             MaxBy {\n441:                 source,\n442:                 param,\n443:                 body,\n444:             } => max_by(source, param, body),\n445:             Field { base, name } => field(base, name),\n446:             Builtin { which, arg } => builtin(which, arg),\n447:             Unwrap { base } => variant(\"Unwrap\", &[(\"base\", base.to_rust())]),\n448:             Index {\n449:                 base,\n450:                 index: i,\n451:                 depth,\n452:                 elem_is_record,\n453:             } => index(base, i, depth, elem_is_record),\n454:             Slice {\n455:                 base,\n456:                 start,\n457:                 end,\n458:                 depth,\n459:             } => slice(base, start, end, depth),\n460:             Match {\n461:                 subject,\n462:                 arms,\n463:                 partial,\n464:             } => match_(subject, arms, partial),\n465:         }\n466:     }\n467: }\n468: \n469: impl ToRust for tir::Func {\n470:     fn to_rust(&self) -> String {\n471:         format!(\n472:             \"crate::tir::Func {{ name: {}, param: {}, param_ty: {}, body: {} }}\",\n473:             self.name.to_rust(),\n474:             self.param.to_rust(),\n475:             self.param_ty.to_rust(),\n476:             self.body.to_rust(),\n477:         )\n478:     }\n479: }\n480: \n481: fn main() {\n482:     println!(\"cargo::rerun-if-changed=prelude.toy\");\n483:     for src in [\n484:         \"src/ast.rs\",\n485:         \"src/error.rs\",\n486:         \"src/parse.rs\",\n487:         \"src/tir.rs\",\n488:         \"src/ty.rs\",\n489:         \"src/check/mod.rs\",\n490:         \"src/check/types.rs\",\n491:         \"src/check/linearity.rs\",\n492:     ] {\n493:         println!(\"cargo::rerun-if-changed={src}\");\n494:     }\n495: \n496:     let src = std::fs::read_to_string(\"prelude.toy\").expect(\"prelude.toy is readable\");\n497:     let mut module = parse::parse_module(&src).expect(\"prelude.toy is valid toylang\");\n498:     // Mark prelude origin the way `prelude::module()` does, so a `pub` function may call a\n499:     // private helper without tripping the checker's cross-file visibility rule. Private\n500:     // definitions are checked here too, not just `pub` ones, so a broken helper is caught at\n501:     // build time rather than whenever a `pub` function first reaches it.\n502:     for def in &mut module.defs {\n503:         def.origin = ast::Origin::Prelude;\n504:     }\n505:     let module = ast::Module {\n506:         defs: module.defs,\n507:         enums: module.enums.into_iter().filter(|e| e.is_pub).collect(),\n508:     };\n509:     let funcs = check::check_module(&module).expect(\"prelude.toy checks\");\n510: \n511:     let generated = format!(\n512:         \"/// Every `fn` in prelude.toy, already checked, `pub` and private alike. Generated by \\\n513:          build.rs from prelude.toy -- edit that, not this.\\n\\\n514:          pub fn checked() -> Vec<crate::tir::Func> {{\\n    {}\\n}}\\n\",\n515:         funcs.to_rust(),\n516:     );\n517:     let out_dir = std::env::var(\"OUT_DIR\").expect(\"cargo sets OUT_DIR for a build script\");\n518:     std::fs::write(\n519:         std::path::Path::new(&out_dir).join(\"prelude_checked.rs\"),\n520:         generated,\n521:     )\n522:     .expect(\"can write the generated prelude source\");\n523: }\n\n(End of file - total 523 lines)\n</content>","metadata":{"preview":"//! Regenerates prelude.toy's checked form on every build (kantord/toylang#73), so `prelude::checked`\n//! can hand back its functions as already-typed `tir::Func` values instead of the library parsing\n//! and type-checking prelude.toy itself on every compile. Reuses the library's own parser and\n//! checker rather than duplicating their logic: `ast`, `error`, `ty`, `tir`, `parse`, and `check`\n//! below are the same source files `src/lib.rs` compiles, pulled in as this script's own modules\n//! because a build script cannot depend on the crate it is building. None of them touch a backend,\n//! `main.rs`, or anything else outside this closed set, so there is nothing else to pull in.\n//!\n//! What comes out is not those checked values themselves (this process ends when the script\n//! does) but Rust source text that reconstructs them: a `ToRust` impl per type below renders each\n//! one as the literal expression that builds it, so `prelude::checked` gets back a plain\n//! `Vec<tir::Func>`, no parsing, deserialization, or unsafe transmute involved.\n//!\n//! A `Kind` field that is `Box<Tir>` in `tir.rs` still passes as plain `&Tir` to the helpers\n//! below (deref coercion) -- `boxed()` re-adds the `Box::new(...)` explicitly, at the one call\n//! site that field needs it, rather than a helper declaring `&Box<Tir>` to get it automatically.\n\n#[path = \"src/ast.rs\"]\nmod ast;\n#[path = \"src/check/mod.rs\"]","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-167/build.rs","text":"//! Regenerates prelude.toy's checked form on every build (kantord/toylang#73), so `prelude::checked`\n//! can hand back its functions as already-typed `tir::Func` values instead of the library parsing\n//! and type-checking prelude.toy itself on every compile. Reuses the library's own parser and\n//! checker rather than duplicating their logic: `ast`, `error`, `ty`, `tir`, `parse`, and `check`\n//! below are the same source files `src/lib.rs` compiles, pulled in as this script's own modules\n//! because a build script cannot depend on the crate it is building. None of them touch a backend,\n//! `main.rs`, or anything else outside this closed set, so there is nothing else to pull in.\n//!\n//! What comes out is not those checked values themselves (this process ends when the script\n//! does) but Rust source text that reconstructs them: a `ToRust` impl per type below renders each\n//! one as the literal expression that builds it, so `prelude::checked` gets back a plain\n//! `Vec<tir::Func>`, no parsing, deserialization, or unsafe transmute involved.\n//!\n//! A `Kind` field that is `Box<Tir>` in `tir.rs` still passes as plain `&Tir` to the helpers\n//! below (deref coercion) -- `boxed()` re-adds the `Box::new(...)` explicitly, at the one call\n//! site that field needs it, rather than a helper declaring `&Box<Tir>` to get it automatically.\n\n#[path = \"src/ast.rs\"]\nmod ast;\n#[path = \"src/check/mod.rs\"]\nmod check;\n#[path = \"src/error.rs\"]\nmod error;\n#[path = \"src/parse.rs\"]\nmod parse;\n#[path = \"src/tir.rs\"]\nmod tir;\n#[path = \"src/ty.rs\"]\nmod ty;\n\n/// `check::mod`'s `check` function (unused here -- this script only calls `check::check_module`)\n/// calls `crate::prelude::checked()`, so that name has to resolve for the file to compile at\n/// all. The real `src/prelude.rs` can't fill in for it: its own `checked()` is generated from\n/// the very file this script is producing. An empty stand-in is enough, since `check` never\n/// actually runs in this binary.\nmod prelude {\n    pub fn checked() -> Vec<crate::tir::Func> {\n        Vec::new()\n    }\n}\n\ntrait ToRust {\n    /// The Rust expression that builds a value equal to this one.\n    fn to_rust(&self) -> String;\n}\n\nimpl ToRust for String {\n    fn to_rust(&self) -> String {\n        format!(\"{self:?}.to_string()\")\n    }\n}\n\nimpl ToRust for str {\n    fn to_rust(&self) -> String {\n        format!(\"{self:?}\")\n    }\n}\n\nimpl ToRust for bool {\n    fn to_rust(&self) -> String {\n        self.to_string()\n    }\n}\n\nimpl ToRust for i64 {\n    fn to_rust(&self) -> String {\n        format!(\"{self}i64\")\n    }\n}\n\nimpl ToRust for f64 {\n    fn to_rust(&self) -> String {\n        format!(\"{self}f64\")\n    }\n}\n\nimpl ToRust for u32 {\n    fn to_rust(&self) -> String {\n        format!(\"{self}u32\")\n    }\n}\n\nimpl ToRust for usize {\n    fn to_rust(&self) -> String {\n        format!(\"{self}usize\")\n    }\n}\n\nimpl<T: ToRust> ToRust for Option<T> {\n    fn to_rust(&self) -> String {\n        match self {\n            Some(v) => format!(\"Some({})\", v.to_rust()),\n            None => \"None\".to_string(),\n        }\n    }\n}\n\nimpl<T: ToRust> ToRust for Box<T> {\n    fn to_rust(&self) -> String {\n        format!(\"Box::new({})\", (**self).to_rust())\n    }\n}\n\nimpl<T: ToRust> ToRust for [T] {\n    fn to_rust(&self) -> String {\n        let items: Vec<String> = self.iter().map(ToRust::to_rust).collect();\n        format!(\"vec![{}]\", items.join(\", \"))\n    }\n}\n\nimpl<A: ToRust, B: ToRust> ToRust for (A, B) {\n    fn to_rust(&self) -> String {\n        format!(\"({}, {})\", self.0.to_rust(), self.1.to_rust())\n    }\n}\n\nimpl ToRust for ast::BinOp {\n    fn to_rust(&self) -> String {\n        let variant = match self {\n            ast::BinOp::Add => \"Add\",\n            ast::BinOp::Sub => \"Sub\",\n            ast::BinOp::Mul => \"Mul\",\n            ast::BinOp::Div => \"Div\",\n            ast::BinOp::Rem => \"Rem\",\n            ast::BinOp::Eq => \"Eq\",\n            ast::BinOp::Ne => \"Ne\",\n            ast::BinOp::Lt => \"Lt\",\n            ast::BinOp::Le => \"Le\",\n            ast::BinOp::Gt => \"Gt\",\n            ast::BinOp::Ge => \"Ge\",\n        };\n        format!(\"crate::ast::BinOp::{variant}\")\n    }\n}\n\nimpl ToRust for ast::LogicOp {\n    fn to_rust(&self) -> String {\n        let variant = match self {\n            ast::LogicOp::And => \"And\",\n            ast::LogicOp::Or => \"Or\",\n        };\n        format!(\"crate::ast::LogicOp::{variant}\")\n    }\n}\n\nimpl ToRust for ty::Type {\n    fn to_rust(&self) -> String {\n        match self {\n            ty::Type::Str => \"crate::ty::Type::Str\".to_string(),\n            ty::Type::Int => \"crate::ty::Type::Int\".to_string(),\n            ty::Type::Int64 => \"crate::ty::Type::Int64\".to_string(),\n            ty::Type::Float => \"crate::ty::Type::Float\".to_string(),\n            ty::Type::Bool => \"crate::ty::Type::Bool\".to_string(),\n            ty::Type::Char => \"crate::ty::Type::Char\".to_string(),\n            ty::Type::Vec(elem) => format!(\"crate::ty::Type::Vec({})\", elem.to_rust()),\n            ty::Type::Stream(elem) => format!(\"crate::ty::Type::Stream({})\", elem.to_rust()),\n            ty::Type::Sink => \"crate::ty::Type::Sink\".to_string(),\n            ty::Type::Record(fields) => {\n                format!(\"crate::ty::Type::Record({})\", fields.to_rust())\n            }\n            ty::Type::Enum {\n                name,\n                args,\n                variants,\n            } => format!(\n                \"crate::ty::Type::Enum {{ name: {}, args: {}, variants: {} }}\",\n                name.to_rust(),\n                args.to_rust(),\n                variants.to_rust(),\n            ),\n            ty::Type::Param(name) => format!(\"crate::ty::Type::Param({})\", name.to_rust()),\n        }\n    }\n}\n\nimpl ToRust for tir::Builtin {\n    fn to_rust(&self) -> String {\n        let variant = match self {\n            tir::Builtin::IntToStr => \"IntToStr\",\n            tir::Builtin::IntToI64 => \"IntToI64\",\n            tir::Builtin::Range => \"Range\",\n            tir::Builtin::Collect => \"Collect\",\n            tir::Builtin::JsonLines => \"JsonLines\",\n            tir::Builtin::Length => \"Length\",\n            tir::Builtin::Flatten => \"Flatten\",\n            tir::Builtin::Tail => \"Tail\",\n            tir::Builtin::Fields => \"Fields\",\n            tir::Builtin::Chars => \"Chars\",\n            tir::Builtin::Sort => \"Sort\",\n            tir::Builtin::Reverse => \"Reverse\",\n            tir::Builtin::Sum => \"Sum\",\n            tir::Builtin::Max => \"Max\",\n            tir::Builtin::Parse => \"Parse\",\n            tir::Builtin::First => \"First\",\n            tir::Builtin::Any => \"Any\",\n            tir::Builtin::All => \"All\",\n        };\n        format!(\"crate::tir::Builtin::{variant}\")\n    }\n}\n\nimpl ToRust for tir::Tir {\n    fn to_rust(&self) -> String {\n        format!(\n            \"crate::tir::Tir::new({}, {})\",\n            self.ty.to_rust(),\n            self.kind.to_rust()\n        )\n    }\n}\n\nimpl ToRust for tir::MatchArm {\n    fn to_rust(&self) -> String {\n        format!(\n            \"crate::tir::MatchArm {{ variant: {}, guard: {}, payload: {}, body: {} }}\",\n            self.variant.to_rust(),\n            self.guard.to_rust(),\n            self.payload.to_rust(),\n            self.body.to_rust(),\n        )\n    }\n}\n\n/// `crate::tir::Kind::{name} { k1: v1, k2: v2, ... }`, the shape shared by every struct-like\n/// `Kind` variant. One small function per variant below builds its own field list and calls\n/// this, which is what keeps the dispatching match in `Kind::to_rust` to one line per variant --\n/// laid out as a table, not a 100-line function apiece.\nfn variant(name: &str, fields: &[(&str, String)]) -> String {\n    let rendered: Vec<String> = fields.iter().map(|(k, v)| format!(\"{k}: {v}\")).collect();\n    format!(\"crate::tir::Kind::{name} {{ {} }}\", rendered.join(\", \"))\n}\n\n/// `tir.rs` stores a `Tir` child as `Box<Tir>`; this is the `Box::new(...)` that reconstructs\n/// it, called explicitly at each field that needs it rather than a helper below taking `&Box<Tir>`\n/// to get the wrapping automatically -- a plain `&Tir` parameter is what a `Box<Tir>` field\n/// coerces to at the call site regardless, so declaring the box type would buy nothing.\nfn boxed(t: &tir::Tir) -> String {\n    format!(\"Box::new({})\", t.to_rust())\n}\n\nfn record_lit(fields: &[(String, tir::Tir)]) -> String {\n    variant(\"RecordLit\", &[(\"fields\", fields.to_rust())])\n}\nfn enum_lit(variant_name: &String, payload: &Option<Box<tir::Tir>>) -> String {\n    variant(\n        \"EnumLit\",\n        &[\n            (\"variant\", variant_name.to_rust()),\n            (\"payload\", payload.to_rust()),\n        ],\n    )\n}\nfn opt_map(source: &tir::Tir, param: &tir::LocalId, body: &tir::Tir) -> String {\n    variant(\n        \"OptMap\",\n        &[\n            (\"source\", boxed(source)),\n            (\"param\", param.to_rust()),\n            (\"body\", boxed(body)),\n        ],\n    )\n}\nfn call(func: &String, arg: &Option<Box<tir::Tir>>) -> String {\n    variant(\"Call\", &[(\"func\", func.to_rust()), (\"arg\", arg.to_rust())])\n}\nfn arith(op: &ast::BinOp, lhs: &tir::Tir, rhs: &tir::Tir) -> String {\n    variant(\n        \"Arith\",\n        &[\n            (\"op\", op.to_rust()),\n            (\"lhs\", boxed(lhs)),\n            (\"rhs\", boxed(rhs)),\n        ],\n    )\n}\nfn compare(op: &ast::BinOp, lhs: &tir::Tir, rhs: &tir::Tir) -> String {\n    variant(\n        \"Compare\",\n        &[\n            (\"op\", op.to_rust()),\n            (\"lhs\", boxed(lhs)),\n            (\"rhs\", boxed(rhs)),\n        ],\n    )\n}\nfn logic(op: &ast::LogicOp, lhs: &tir::Tir, rhs: &tir::Tir) -> String {\n    variant(\n        \"Logic\",\n        &[\n            (\"op\", op.to_rust()),\n            (\"lhs\", boxed(lhs)),\n            (\"rhs\", boxed(rhs)),\n        ],\n    )\n}\nfn bind(local: &tir::LocalId, value: &tir::Tir, body: &tir::Tir) -> String {\n    variant(\n        \"Bind\",\n        &[\n            (\"local\", local.to_rust()),\n            (\"value\", boxed(value)),\n            (\"body\", boxed(body)),\n        ],\n    )\n}\nfn map(source: &tir::Tir, param: &tir::LocalId, body: &tir::Tir) -> String {\n    variant(\n        \"Map\",\n        &[\n            (\"source\", boxed(source)),\n            (\"param\", param.to_rust()),\n            (\"body\", boxed(body)),\n        ],\n    )\n}\nfn select(source: &tir::Tir, param: &tir::LocalId, pred: &tir::Tir) -> String {\n    variant(\n        \"Select\",\n        &[\n            (\"source\", boxed(source)),\n            (\"param\", param.to_rust()),\n            (\"pred\", boxed(pred)),\n        ],\n    )\n}\nfn sort_by(source: &tir::Tir, param: &tir::LocalId, body: &tir::Tir) -> String {\n    variant(\n        \"SortBy\",\n        &[\n            (\"source\", boxed(source)),\n            (\"param\", param.to_rust()),\n            (\"body\", boxed(body)),\n        ],\n    )\n}\nfn max_by(source: &tir::Tir, param: &tir::LocalId, body: &tir::Tir) -> String {\n    variant(\n        \"MaxBy\",\n        &[\n            (\"source\", boxed(source)),\n            (\"param\", param.to_rust()),\n            (\"body\", boxed(body)),\n        ],\n    )\n}\nfn field(base: &tir::Tir, name: &String) -> String {\n    variant(\"Field\", &[(\"base\", boxed(base)), (\"name\", name.to_rust())])\n}\nfn builtin(which: &tir::Builtin, arg: &tir::Tir) -> String {\n    variant(\n        \"Builtin\",\n        &[(\"which\", which.to_rust()), (\"arg\", boxed(arg))],\n    )\n}\nfn index(base: &tir::Tir, index: &tir::Tir, depth: &usize, elem_is_record: &bool) -> String {\n    variant(\n        \"Index\",\n        &[\n            (\"base\", boxed(base)),\n            (\"index\", boxed(index)),\n            (\"depth\", depth.to_rust()),\n            (\"elem_is_record\", elem_is_record.to_rust()),\n        ],\n    )\n}\nfn slice(\n    base: &tir::Tir,\n    start: &Option<Box<tir::Tir>>,\n    end: &Option<Box<tir::Tir>>,\n    depth: &usize,\n) -> String {\n    variant(\n        \"Slice\",\n        &[\n            (\"base\", boxed(base)),\n            (\"start\", start.to_rust()),\n            (\"end\", end.to_rust()),\n            (\"depth\", depth.to_rust()),\n        ],\n    )\n}\nfn match_(subject: &tir::Tir, arms: &[tir::MatchArm], partial: &bool) -> String {\n    variant(\n        \"Match\",\n        &[\n            (\"subject\", boxed(subject)),\n            (\"arms\", arms.to_rust()),\n            (\"partial\", partial.to_rust()),\n        ],\n    )\n}\n\n/// Exhaustive on purpose: a `Kind` variant this does not know renders nothing rather than\n/// something wrong, and a match with no wildcard arm is what turns that into a build error the\n/// moment the checker can produce it, naming exactly the arm to add (kantord/toylang#73's\n/// \"independent of its growth\").\nimpl ToRust for tir::Kind {\n    fn to_rust(&self) -> String {\n        use tir::Kind::*;\n        match self {\n            Str(s) => format!(\"crate::tir::Kind::Str({})\", s.to_rust()),\n            Int(n) => format!(\"crate::tir::Kind::Int({})\", n.to_rust()),\n            Float(n) => format!(\"crate::tir::Kind::Float({})\", n.to_rust()),\n            VecLit(items) => format!(\"crate::tir::Kind::VecLit({})\", items.to_rust()),\n            RecordLit { fields } => record_lit(fields),\n            EnumLit { variant, payload } => enum_lit(variant, payload),\n            OptMap {\n                source,\n                param,\n                body,\n            } => opt_map(source, param, body),\n            Var(name) => format!(\"crate::tir::Kind::Var({})\", name.to_rust()),\n            Local(id) => format!(\"crate::tir::Kind::Local({})\", id.to_rust()),\n            Input => \"crate::tir::Kind::Input\".to_string(),\n            Inputs => \"crate::tir::Kind::Inputs\".to_string(),\n            Lines => \"crate::tir::Kind::Lines\".to_string(),\n            Dsv { delim } => format!(\"crate::tir::Kind::Dsv {{ delim: {} }}\", delim.to_rust()),\n            Call { func, arg } => call(func, arg),\n            Concat(a, b) => format!(\"crate::tir::Kind::Concat({}, {})\", a.to_rust(), b.to_rust()),\n            Arith { op, lhs, rhs } => arith(op, lhs, rhs),\n            Compare { op, lhs, rhs } => compare(op, lhs, rhs),\n            Logic { op, lhs, rhs } => logic(op, lhs, rhs),\n            Not(base) => format!(\"crate::tir::Kind::Not({})\", boxed(base)),\n            Bind { local, value, body } => bind(local, value, body),\n            Map {\n                source,\n                param,\n                body,\n            } => map(source, param, body),\n            Select {\n                source,\n                param,\n                pred,\n            } => select(source, param, pred),\n            SortBy {\n                source,\n                param,\n                body,\n            } => sort_by(source, param, body),\n            MaxBy {\n                source,\n                param,\n                body,\n            } => max_by(source, param, body),\n            Field { base, name } => field(base, name),\n            Builtin { which, arg } => builtin(which, arg),\n            Unwrap { base } => variant(\"Unwrap\", &[(\"base\", base.to_rust())]),\n            Index {\n                base,\n                index: i,\n                depth,\n                elem_is_record,\n            } => index(base, i, depth, elem_is_record),\n            Slice {\n                base,\n                start,\n                end,\n                depth,\n            } => slice(base, start, end, depth),\n            Match {\n                subject,\n                arms,\n                partial,\n            } => match_(subject, arms, partial),\n        }\n    }\n}\n\nimpl ToRust for tir::Func {\n    fn to_rust(&self) -> String {\n        format!(\n            \"crate::tir::Func {{ name: {}, param: {}, param_ty: {}, body: {} }}\",\n            self.name.to_rust(),\n            self.param.to_rust(),\n            self.param_ty.to_rust(),\n            self.body.to_rust(),\n        )\n    }\n}\n\nfn main() {\n    println!(\"cargo::rerun-if-changed=prelude.toy\");\n    for src in [\n        \"src/ast.rs\",\n        \"src/error.rs\",\n        \"src/parse.rs\",\n        \"src/tir.rs\",\n        \"src/ty.rs\",\n        \"src/check/mod.rs\",\n        \"src/check/types.rs\",\n        \"src/check/linearity.rs\",\n    ] {\n        println!(\"cargo::rerun-if-changed={src}\");\n    }\n\n    let src = std::fs::read_to_string(\"prelude.toy\").expect(\"prelude.toy is readable\");\n    let mut module = parse::parse_module(&src).expect(\"prelude.toy is valid toylang\");\n    // Mark prelude origin the way `prelude::module()` does, so a `pub` function may call a\n    // private helper without tripping the checker's cross-file visibility rule. Private\n    // definitions are checked here too, not just `pub` ones, so a broken helper is caught at\n    // build time rather than whenever a `pub` function first reaches it.\n    for def in &mut module.defs {\n        def.origin = ast::Origin::Prelude;\n    }\n    let module = ast::Module {\n        defs: module.defs,\n        enums: module.enums.into_iter().filter(|e| e.is_pub).collect(),\n    };\n    let funcs = check::check_module(&module).expect(\"prelude.toy checks\");\n\n    let generated = format!(\n        \"/// Every `fn` in prelude.toy, already checked, `pub` and private alike. Generated by \\\n         build.rs from prelude.toy -- edit that, not this.\\n\\\n         pub fn checked() -> Vec<crate::tir::Func> {{\\n    {}\\n}}\\n\",\n        funcs.to_rust(),\n    );\n    let out_dir = std::env::var(\"OUT_DIR\").expect(\"cargo sets OUT_DIR for a build script\");\n    std::fs::write(\n        std::path::Path::new(&out_dir).join(\"prelude_checked.rs\"),\n        generated,\n    )\n    .expect(\"can write the generated prelude source\");\n}","lineStart":1,"lineEnd":523,"totalLines":523,"truncated":false}},"title":"build.rs","time":{"start":1788705333047,"end":1788705333063}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me look at how build.rs works, and the prelude_checked mechanism, to understand how check_module is invoked. Also let me check the `ty.rs` `Sig` struct and how `signatures()` works.","format":"unknown","index":0}]}},"id":"prt_077255f35001FYz5plIR8rqsbK","sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","messageID":"msg_077255718001j6c7xlJtBCvpwS"}}
{"type":"tool_use","timestamp":1788705333070,"sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","part":{"type":"tool","tool":"bash","callID":"call_f9a50aeb4d154c1f871c60de","state":{"status":"completed","input":{"command":"rg -n \"pub struct Sig|fn signatures|fn check_module|pub fn checked\" src/check/types.rs src/check/mod.rs src/prelude.rs build.rs"},"output":"build.rs:37:    pub fn checked() -> Vec<crate::tir::Func> {\nbuild.rs:514:         pub fn checked() -> Vec<crate::tir::Func> {{\\n    {}\\n}}\\n\",\nsrc/check/mod.rs:518:pub fn check_module(module: &crate::ast::Module) -> Result<Vec<tir::Func>, Error> {\nsrc/check/types.rs:268:pub(super) fn signatures(defs: &[Def], env: &TypeEnv) -> Result<HashMap<String, Sig>, Error> {\n","metadata":{"output":"build.rs:37:    pub fn checked() -> Vec<crate::tir::Func> {\nbuild.rs:514:         pub fn checked() -> Vec<crate::tir::Func> {{\\n    {}\\n}}\\n\",\nsrc/check/mod.rs:518:pub fn check_module(module: &crate::ast::Module) -> Result<Vec<tir::Func>, Error> {\nsrc/check/types.rs:268:pub(super) fn signatures(defs: &[Def], env: &TypeEnv) -> Result<HashMap<String, Sig>, Error> {\n","exit":0,"truncated":false},"title":"rg -n \"pub struct Sig|fn signatures|fn check_module|pub fn checked\" src/check/types.rs src/check/mod.rs src/prelude.rs build.rs","time":{"start":1788705333067,"end":1788705333069}},"id":"prt_077255f39001jlca2fi7tL6e41","sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","messageID":"msg_077255718001j6c7xlJtBCvpwS"}}
