{"type":"step_finish","timestamp":1788705126954,"sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","part":{"id":"prt_077223a13001U8tFrOCQl95khs","reason":"tool-calls","snapshot":"307d242a582f94e0a9fe102c3e65441553e7eb4b","messageID":"msg_077223315001sUBpbDYoW78dRv","sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","type":"step-finish","tokens":{"total":24163,"input":925,"output":138,"reasoning":60,"cache":{"write":0,"read":23040}},"cost":0.00029633142}}
{"type":"step_start","timestamp":1788705127819,"sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","part":{"id":"prt_077223d83001zPXlQHs2nEc1LK","messageID":"msg_077223a46001EBRCWRulQSjO78","sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","snapshot":"307d242a582f94e0a9fe102c3e65441553e7eb4b","type":"step-start"}}
{"type":"text","timestamp":1788705129651,"sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","part":{"id":"prt_077223e4c001aCnBm8uwkKBRiA","messageID":"msg_077223a46001EBRCWRulQSjO78","sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","type":"text","text":"\n\n","time":{"start":1788705128012,"end":1788705129643}}}
{"type":"tool_use","timestamp":1788705129681,"sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","part":{"type":"tool","tool":"read","callID":"call_a5cd6d40725d4e42be3ad268","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-167/src/prelude.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-167/src/prelude.rs</path>\n<type>file</type>\n<content>\n1: //! The rudimentary beginning of a module system: one file, `prelude.toy`, whose `pub`\n2: //! definitions are always available to every program. There is no import statement yet -- a\n3: //! program does not name what it wants, it just gets all of it -- and no way for a program's own\n4: //! file to be imported by another. What already exists: `pub fn` marks a definition as part of\n5: //! that always-available set; a non-`pub` one is kept and can serve as a private helper, callable\n6: //! only from within this file (the checker enforces that, by origin, at each call site).\n7: //!\n8: //! `join_lines` used to be a `tir::Builtin`, needing its own codegen in all six backends. Written as\n9: //! ordinary toylang source instead, it is checked and compiled exactly the way a program's own\n10: //! functions are, so getting it right once in the checker is getting it right everywhere.\n11: //!\n12: //! Every `pub` definition is always merged in, whether the program uses it or not; what keeps an\n13: //! unused one from cluttering output and `tags::node_types` is `check::check`'s reachability\n14: //! pass, which prunes any function -- prelude or the program's own -- that the program's body\n15: //! never calls, directly or transitively.\n16: \n17: use crate::ast::{Module, Origin};\n18: \n19: const PRELUDE_SRC: &str = include_str!(\"../prelude.toy\");\n20: \n21: // Defines `checked()`, constructing prelude.toy's already-checked `pub` functions directly\n22: // rather than parsing or type-checking anything: build.rs runs that once, against this same\n23: // source, and writes the result here as plain Rust (kantord/toylang#73).\n24: include!(concat!(env!(\"OUT_DIR\"), \"/prelude_checked.rs\"));\n25: \n26: /// Every declaration in `prelude.toy`, `pub` and private alike. A private one stays in so it can\n27: /// serve as a helper for a `pub` one; the checker refuses any call to it from the program's file.\n28: pub fn module() -> Module {\n29:     let mut module = crate::parse::parse_module(PRELUDE_SRC).expect(\"prelude.toy is valid toylang\");\n30:     for def in &mut module.defs {\n31:         def.origin = Origin::Prelude;\n32:     }\n33:     Module {\n34:         defs: module.defs,\n35:         enums: module.enums.into_iter().filter(|e| e.is_pub).collect(),\n36:     }\n37: }\n38: \n39: /// Prepends the prelude's declarations to `file`, so a program can call any of them. Prepended\n40: /// rather than appended, so a program that redefines the same name is the one flagged as the\n41: /// duplicate -- its span is the one worth showing.\n42: pub fn inject(file: &mut crate::ast::File) {\n43:     let mut module = module();\n44:     module.defs.append(&mut file.defs);\n45:     file.defs = module.defs;\n46:     module.enums.append(&mut file.enums);\n47:     file.enums = module.enums;\n48: }\n\n(End of file - total 48 lines)\n</content>","metadata":{"preview":"//! The rudimentary beginning of a module system: one file, `prelude.toy`, whose `pub`\n//! definitions are always available to every program. There is no import statement yet -- a\n//! program does not name what it wants, it just gets all of it -- and no way for a program's own\n//! file to be imported by another. What already exists: `pub fn` marks a definition as part of\n//! that always-available set; a non-`pub` one is kept and can serve as a private helper, callable\n//! only from within this file (the checker enforces that, by origin, at each call site).\n//!\n//! `join_lines` used to be a `tir::Builtin`, needing its own codegen in all six backends. Written as\n//! ordinary toylang source instead, it is checked and compiled exactly the way a program's own\n//! functions are, so getting it right once in the checker is getting it right everywhere.\n//!\n//! Every `pub` definition is always merged in, whether the program uses it or not; what keeps an\n//! unused one from cluttering output and `tags::node_types` is `check::check`'s reachability\n//! pass, which prunes any function -- prelude or the program's own -- that the program's body\n//! never calls, directly or transitively.\n\nuse crate::ast::{Module, Origin};\n\nconst PRELUDE_SRC: &str = include_str!(\"../prelude.toy\");\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-167/src/prelude.rs","text":"//! The rudimentary beginning of a module system: one file, `prelude.toy`, whose `pub`\n//! definitions are always available to every program. There is no import statement yet -- a\n//! program does not name what it wants, it just gets all of it -- and no way for a program's own\n//! file to be imported by another. What already exists: `pub fn` marks a definition as part of\n//! that always-available set; a non-`pub` one is kept and can serve as a private helper, callable\n//! only from within this file (the checker enforces that, by origin, at each call site).\n//!\n//! `join_lines` used to be a `tir::Builtin`, needing its own codegen in all six backends. Written as\n//! ordinary toylang source instead, it is checked and compiled exactly the way a program's own\n//! functions are, so getting it right once in the checker is getting it right everywhere.\n//!\n//! Every `pub` definition is always merged in, whether the program uses it or not; what keeps an\n//! unused one from cluttering output and `tags::node_types` is `check::check`'s reachability\n//! pass, which prunes any function -- prelude or the program's own -- that the program's body\n//! never calls, directly or transitively.\n\nuse crate::ast::{Module, Origin};\n\nconst PRELUDE_SRC: &str = include_str!(\"../prelude.toy\");\n\n// Defines `checked()`, constructing prelude.toy's already-checked `pub` functions directly\n// rather than parsing or type-checking anything: build.rs runs that once, against this same\n// source, and writes the result here as plain Rust (kantord/toylang#73).\ninclude!(concat!(env!(\"OUT_DIR\"), \"/prelude_checked.rs\"));\n\n/// Every declaration in `prelude.toy`, `pub` and private alike. A private one stays in so it can\n/// serve as a helper for a `pub` one; the checker refuses any call to it from the program's file.\npub fn module() -> Module {\n    let mut module = crate::parse::parse_module(PRELUDE_SRC).expect(\"prelude.toy is valid toylang\");\n    for def in &mut module.defs {\n        def.origin = Origin::Prelude;\n    }\n    Module {\n        defs: module.defs,\n        enums: module.enums.into_iter().filter(|e| e.is_pub).collect(),\n    }\n}\n\n/// Prepends the prelude's declarations to `file`, so a program can call any of them. Prepended\n/// rather than appended, so a program that redefines the same name is the one flagged as the\n/// duplicate -- its span is the one worth showing.\npub fn inject(file: &mut crate::ast::File) {\n    let mut module = module();\n    module.defs.append(&mut file.defs);\n    file.defs = module.defs;\n    module.enums.append(&mut file.enums);\n    file.enums = module.enums;\n}","lineStart":1,"lineEnd":48,"totalLines":48,"truncated":false}},"title":"src/prelude.rs","time":{"start":1788705129620,"end":1788705129659}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Let me look at the prelude.rs and ast.rs Origin, and the checker to understand the visibility tracking. Let me read the relevant files.","format":"unknown","index":0}]}},"id":"prt_07722448a0015FSodKUr84MnHd","sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","messageID":"msg_077223a46001EBRCWRulQSjO78"}}
{"type":"tool_use","timestamp":1788705129681,"sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","part":{"type":"tool","tool":"read","callID":"call_bddb23955d964b789e58a524","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-167/src/ast.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-167/src/ast.rs</path>\n<type>file</type>\n<content>\n1: #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n2: pub struct Span {\n3:     pub start: usize,\n4:     pub end: usize,\n5: }\n6: \n7: impl Span {\n8:     pub fn new(start: usize, end: usize) -> Self {\n9:         Span { start, end }\n10:     }\n11: \n12:     pub fn to(self, other: Span) -> Span {\n13:         Span::new(self.start, other.end)\n14:     }\n15: }\n16: \n17: #[derive(Debug, Clone, Copy, PartialEq)]\n18: pub enum BinOp {\n19:     Add,\n20:     Sub,\n21:     Mul,\n22:     Div,\n23:     Rem,\n24:     Eq,\n25:     Ne,\n26:     Lt,\n27:     Le,\n28:     Gt,\n29:     Ge,\n30: }\n31: \n32: impl BinOp {\n33:     pub fn is_comparison(self) -> bool {\n34:         matches!(\n35:             self,\n36:             BinOp::Eq | BinOp::Ne | BinOp::Lt | BinOp::Le | BinOp::Gt | BinOp::Ge\n37:         )\n38:     }\n39: \n40:     /// True for the operators that only ever mean arithmetic. `+` is missing because it also\n41:     /// concatenates, which is the one place an operator's meaning depends on its operands.\n42:     pub fn is_arithmetic(self) -> bool {\n43:         matches!(self, BinOp::Sub | BinOp::Mul | BinOp::Div | BinOp::Rem)\n44:     }\n45: }\n46: \n47: impl std::fmt::Display for BinOp {\n48:     fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n49:         let s = match self {\n50:             BinOp::Add => \"+\",\n51:             BinOp::Sub => \"-\",\n52:             BinOp::Mul => \"*\",\n53:             BinOp::Div => \"/\",\n54:             BinOp::Rem => \"%\",\n55:             BinOp::Eq => \"==\",\n56:             BinOp::Ne => \"!=\",\n57:             BinOp::Lt => \"<\",\n58:             BinOp::Le => \"<=\",\n59:             BinOp::Gt => \">\",\n60:             BinOp::Ge => \">=\",\n61:         };\n62:         write!(f, \"{s}\")\n63:     }\n64: }\n65: \n66: /// The two Bool connectives. Kept out of `BinOp` because they share none of its rules: their\n67: /// operands are Bool rather than a matched pair of anything, and they are the only operators\n68: /// that may leave their right side unevaluated.\n69: #[derive(Debug, Clone, Copy, PartialEq)]\n70: pub enum LogicOp {\n71:     And,\n72:     Or,\n73: }\n74: \n75: impl std::fmt::Display for LogicOp {\n76:     fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n77:         let s = match self {\n78:             LogicOp::And => \"and\",\n79:             LogicOp::Or => \"or\",\n80:         };\n81:         write!(f, \"{s}\")\n82:     }\n83: }\n84: \n85: /// A type as written in source, before it is resolved to a `Type`.\n86: #[derive(Debug)]\n87: pub enum TypeExpr {\n88:     Named {\n89:         name: String,\n90:         /// `Pair<Int>`: the arguments a declared generic enum is applied to. Empty for a\n91:         /// plain name. `Vec`/`Stream` keep their own variants below.\n92:         args: Vec<TypeExpr>,\n93:         span: Span,\n94:     },\n95:     Vec {\n96:         elem: Box<TypeExpr>,\n97:         span: Span,\n98:     },\n99:     /// `Stream<T>`, legal only as the whole of a parameter or return annotation: a stream is\n100:     /// not a value, so the checker refuses it anywhere a type would describe something stored.\n101:     Stream {\n102:         elem: Box<TypeExpr>,\n103:         span: Span,\n104:     },\n105:     Record {\n106:         fields: Vec<(String, TypeExpr)>,\n107:         span: Span,\n108:     },\n109: }\n110: \n111: impl TypeExpr {\n112:     pub fn span(&self) -> Span {\n113:         match self {\n114:             TypeExpr::Named { span, .. }\n115:             | TypeExpr::Vec { span, .. }\n116:             | TypeExpr::Stream { span, .. }\n117:             | TypeExpr::Record { span, .. } => *span,\n118:         }\n119:     }\n120: }\n121: \n122: /// What a parameter's left side binds: either one name or a record destructured the way a match\n123: /// arm's brace pattern destructures one. The type annotation stays fully explicit either way.\n124: #[derive(Debug)]\n125: pub enum ParamShape {\n126:     /// `name` in `fn f(name: T) -> R`.\n127:     Name(String, Span),\n128:     /// `{a, b, ..}` in `fn f({a, b}: T) -> R`, binding each named field of the record `T`.\n129:     Fields(FieldsPattern),\n130: }\n131: \n132: impl ParamShape {\n133:     pub fn span(&self) -> Span {\n134:         match self {\n135:             ParamShape::Name(_, span) => *span,\n136:             ParamShape::Fields(f) => f.span,\n137:         }\n138:     }\n139: }\n140: \n141: #[derive(Debug)]\n142: pub struct Param {\n143:     pub shape: ParamShape,\n144:     pub ty: TypeExpr,\n145:     pub span: Span,\n146: }\n147: \n148: /// Which source file a definition came from. Only two exist today: the program's own file and\n149: /// the single prelude module. A non-`pub` definition is callable only from its own file, so\n150: /// this is what the checker keys visibility on at each call site (gh:166).\n151: #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n152: pub enum Origin {\n153:     /// The program's own file.\n154:     Program,\n155:     /// The prelude module, `prelude.toy`.\n156:     Prelude,\n157: }\n158: \n159: #[derive(Debug)]\n160: pub struct Def {\n161:     pub name: String,\n162:     /// `None` for a nullary function (`fn name() -> T = body`).\n163:     pub param: Option<Param>,\n164:     /// `None` for a hoisted definition (`fn name = body`, gh:152): no return type is written, so\n165:     /// the signature -- parameter and return both -- is inferred from the body. A hoisted\n166:     /// function's parameter is the implicit `.` the body matches against, and its type comes from\n167:     /// what the body matches; the return type is what the body synthesises.\n168:     pub ret: Option<TypeExpr>,\n169:     pub body: Expr,\n170:     pub span: Span,\n171:     /// Whether a module's prelude includes this definition when compiling a program. Meaningless\n172:     /// outside a module today, since nothing yet imports from a program file.\n173:     pub is_pub: bool,\n174:     /// The file this definition was written in. A program's own definitions get `Program` from\n175:     /// the parser; the prelude's get `Prelude` from `prelude::module`.\n176:     pub origin: Origin,\n177:     /// `fn name = body` (gh:152): no parameter list, no return annotation. `param` and `ret` are\n178:     /// both `None`, and the checker infers the signature from the body. The first slice accepts\n179:     /// only a match-call body (`Msg(Ping -> ...)`), which fixes the parameter type to the named\n180:     /// enum and the return type to the arms' common type.\n181:     pub hoisted: bool,\n182: }\n183: \n184: /// `enum Shape { point, circle{r: Int} }`. The first declaration that creates a type identity\n185: /// rather than abbreviating one: the name is what exhaustiveness will be proved against.\n186: #[derive(Debug)]\n187: pub struct EnumDecl {\n188:     pub name: String,\n189:     /// Type parameters, in declaration order: `enum Opt<T> { ... }`. Capitalized names,\n190:     /// bound only inside this declaration's payloads.\n191:     pub params: Vec<(String, Span)>,\n192:     pub variants: Vec<Variant>,\n193:     pub span: Span,\n194:     /// Same meaning as `Def::is_pub`: whether a module exports this declaration.\n195:     pub is_pub: bool,\n196: }\n197: \n198: /// One alternative of an enum. Variant names are data (they appear as JSON keys and strings),\n199: /// so they are exempt from the capital-means-type casing rule, like record fields.\n200: #[derive(Debug)]\n201: pub struct Variant {\n202:     pub name: String,\n203:     pub span: Span,\n204:     /// `None` for a unit variant. Any single type, spelled the way a call spells its argument:\n205:     /// a record type directly in braces (`circle{r: Int}`), any type in parens (`celsius(Int)`).\n206:     pub payload: Option<TypeExpr>,\n207: }\n208: \n209: /// `trait Name { fn sig(param: Type) -> Type }`:a named collection of method signatures,\n210: /// with no bodies. The receiver type is spelled `Self` in a signature, and binds to whatever\n211: /// concrete type an `impl` block targets. Parsed only for now: checking and dispatch are later\n212: /// slices.\n213: #[derive(Debug)]\n214: pub struct TraitDecl {\n215:     pub name: String,\n216:     /// The method signatures, in declaration order.\n217:     pub methods: Vec<TraitMethodSig>,\n218:     pub span: Span,\n219:     /// Same meaning as `Def::is_pub`: whether a module exports this declaration.\n220:     pub is_pub: bool,\n221: }\n222: \n223: /// One method signature of a trait declaration:the same `fn name(param: Type) -> Type`\n224: /// spine a function uses, minus the body an `impl` provides.\n225: #[derive(Debug)]\n226: pub struct TraitMethodSig {\n227:     pub name: String,\n228:     /// `None` for a nullary method (`fn name() -> T`).\n229:     pub param: Option<Param>,\n230:     pub ret: TypeExpr,\n231:     pub span: Span,\n232: }\n233: \n234: /// `impl Trait for Type { fn sig(param: Type) -> Type = body }`: concrete bodies for one\n235: /// trait's methods, one block per (trait, type) pair. Parsed only for now:the checker does\n236: /// not use this yet.\n237: #[derive(Debug)]\n238: pub struct ImplDecl {\n239:     pub trait_name: String,\n240:     /// The concrete type the trait's `Self` substitutes to.\n241:     pub ty: TypeExpr,\n242:     /// The method bodies, each against the trait's signature of the same name.\n243:     pub methods: Vec<ImplMethod>,\n244:     pub span: Span,\n245: }\n246: /// One method of an impl block:the same spine a trait signature has, plus the body that makes\n247: /// it a definition.\n248: \n249: #[derive(Debug)]\n250: pub struct ImplMethod {\n251:     pub name: String,\n252:     pub param: Option<Param>,\n253:     pub ret: TypeExpr,\n254:     pub body: Expr,\n255:     pub span: Span,\n256: }\n257: \n258: /// Zero or more definitions followed by the expression that is the program.\n259: #[derive(Debug)]\n260: pub struct File {\n261:     /// `type Db = {users: Vec<User>}`. An abbreviation and nothing more: the name and what it\n262:     /// stands for are one type, so nothing distinguishes them once resolved.\n263:     pub aliases: Vec<Alias>,\n264:     pub enums: Vec<EnumDecl>,\n265:     /// `trait Name { ... }`:a named collection of method signatures. Parsed only for now.\n266:     pub traits: Vec<TraitDecl>,\n267:     /// `impl Trait for Type { ... }`: concrete bodies for one trait's methods. Parsed only for now.\n268:     pub impls: Vec<ImplDecl>,\n269:     pub defs: Vec<Def>,\n270:     pub body: Expr,\n271: }\n272: \n273: /// What a module file holds: declarations only, no trailing expression.\n274: #[derive(Debug)]\n275: pub struct Module {\n276:     pub defs: Vec<Def>,\n277:     pub enums: Vec<EnumDecl>,\n278: }\n279: \n280: #[derive(Debug)]\n281: pub struct Alias {\n282:     pub name: String,\n283:     pub ty: TypeExpr,\n284:     pub span: Span,\n285: }\n286: \n287: #[derive(Debug)]\n288: pub enum Expr {\n289:     Str {\n290:         text: String,\n291:         span: Span,\n292:     },\n293:     Int {\n294:         value: i64,\n295:         span: Span,\n296:     },\n297:     /// A decimal-point literal (ADR 0007): an IEEE 754 binary64 double, the same\n298:     /// representation every JavaScript engine carries. The dot is what makes a number a Float,\n299:     /// and there is no alternative width or decimal type to guess at.\n300:     Float {\n301:         value: f64,\n302:         span: Span,\n303:     },\n304:     VecLit {\n305:         items: Vec<Expr>,\n306:         span: Span,\n307:     },\n308:     /// `{name: expr, age: expr}`. A record literal, the inverse of a projection. Each field\n309:     /// keeps its own span so a repeated one can be pointed at rather than described.\n310:     RecordLit {\n311:         fields: Vec<(String, Span, Expr)>,\n312:         span: Span,\n313:     },\n314:     /// `.`, the value the enclosing pipeline or filter is currently working on.\n315:     Subject {\n316:         span: Span,\n317:     },\n318:     Var {\n319:         name: String,\n320:         span: Span,\n321:     },\n322:     Call {\n323:         func: String,\n324:         func_span: Span,\n325:         /// `None` for a nullary call (`name()`).\n326:         arg: Option<Box<Expr>>,\n327:         span: Span,\n328:     },\n329:     /// `base[]`. A spec that keeps a dimension.\n330:     Project {\n331:         base: Box<Expr>,\n332:         span: Span,\n333:     },\n334:     /// `base[i]`. A spec that collapses a dimension, so the entry may not be there.\n335:     Index {\n336:         base: Box<Expr>,\n337:         index: Box<Expr>,\n338:         span: Span,\n339:     },\n340:     /// `base[lo:hi]`, bounds optional. A spec that narrows a dimension by position, jq's\n341:     /// `.[2:5]`; out-of-range bounds clamp to the valid range rather than answering `Opt` the\n342:     /// way a collapsing index does (kantord/toylang#143).\n343:     Slice {\n344:         base: Box<Expr>,\n345:         start: Option<Box<Expr>>,\n346:         end: Option<Box<Expr>>,\n347:         span: Span,\n348:     },\n349:     /// `base!`. Insist the value is there, and stop the program if it is not.\n350:     Unwrap {\n351:         base: Box<Expr>,\n352:         span: Span,\n353:     },\n354:     /// `-base`.\n355:     Neg {\n356:         base: Box<Expr>,\n357:         span: Span,\n358:     },\n359:     /// `not base`. Looser than every comparison, so `not a == b` negates the comparison, and\n360:     /// tighter than `and`/`or`, so `not a and b` negates only `a`.\n361:     Not {\n362:         base: Box<Expr>,\n363:         span: Span,\n364:     },\n365:     /// `base.name`. Distributes over a Vec rather than needing a map.\n366:     Field {\n367:         base: Box<Expr>,\n368:         name: String,\n369:         span: Span,\n370:     },\n371:     /// The raw lines of stdin, born `Stream<Str>`. The checker rejects a second read rather\n372:     /// than accepting a second stream, since there is only ever one real stdin. Lowered to\n373:     /// `tir::Kind::Lines`; the old `lines` keyword is this same node respelled.\n374:     Stdin {\n375:         span: Span,\n376:     },\n377:     /// Stdin read as raw lines, each split on a delimiter, born `Vec<Vec<Str>>`: the\n378:     /// parameterized DSV source. `csv` and `tsv` are the same node with the delimiter fixed.\n379:     Dsv {\n380:         delim: String,\n381:         span: Span,\n382:     },\n383:     /// An `or` chain of match arms over the subject `.`: `point -> 0 or circle{r} -> r * r`.\n384:     /// The subject is not part of the node; a match reads `.` the way `select` does, so it\n385:     /// appears as a pipe stage.\n386:     Match {\n387:         arms: Vec<MatchArm>,\n388:         span: Span,\n389:     },\n390:     /// `Msg(Ping -> \"pong\" or Quit -> \"bye\")`: a type name used as a match call (gh:152). The\n391:     /// parens hold the same `or`-separated arms a `Match` carries, over the subject `.`; the\n392:     /// enum name is the assertion that the subject is one of this enum's values, and the\n393:     /// checker resolves each variant against it. Sugar for a `Match` whose subject is `.`, kept\n394:     /// as its own node so the surface spelling survives formatting.\n395:     MatchCall {\n396:         enum_name: String,\n397:         enum_span: Span,\n398:         arms: Vec<MatchArm>,\n399:         span: Span,\n400:     },\n401:     /// `Shape.circle` or `Shape.circle{r: 1}`: a variant constructor spelled through its enum.\n402:     /// Only the qualified form needs its own node; a bare `circle{r: 1}` is an ordinary `Call`\n403:     /// and a bare `active` an ordinary `Var`, resolved through the enum registry by the checker.\n404:     Variant {\n405:         enum_name: String,\n406:         enum_span: Span,\n407:         variant: String,\n408:         variant_span: Span,\n409:         payload: Option<Box<Expr>>,\n410:         span: Span,\n411:     },\n412:     /// `lhs | rhs`, which binds `.` in `rhs` to the value of `lhs`.\n413:     Pipe {\n414:         lhs: Box<Expr>,\n415:         rhs: Box<Expr>,\n416:         span: Span,\n417:     },\n418:     /// `lhs |> callee`, the tail-pipeline marker: the one way a sink call is written, `callee`\n419:     /// applied to `lhs`. Only a Sink-typed callee is legal here, and the production is parsed\n420:     /// only at a program's outermost position, so this node never appears nested.\n421:     TailPipe {\n422:         lhs: Box<Expr>,\n423:         callee: String,\n424:         callee_span: Span,\n425:         span: Span,\n426:     },\n427:     Binary {\n428:         op: BinOp,\n429:         lhs: Box<Expr>,\n430:         rhs: Box<Expr>,\n431:         span: Span,\n432:     },\n433:     /// `lhs and rhs`, `lhs or rhs`. A separate node from `Binary` for the same reason `LogicOp`\n434:     /// is a separate enum: nothing about how these are typed or evaluated follows `Binary`'s\n435:     /// rules.\n436:     Logic {\n437:         op: LogicOp,\n438:         lhs: Box<Expr>,\n439:         rhs: Box<Expr>,\n440:         span: Span,\n441:     },\n442:     /// `let <name> = <expr>` on its own line, repeated, then the expression that ends the block\n443:     /// -- the local-binding form the ruling on #87 picked over `let ... in`: no keyword to pair,\n444:     /// just a sequence of bindings followed by a result. Only reachable as a function body.\n445:     Let {\n446:         bindings: Vec<(String, Expr)>,\n447:         body: Box<Expr>,\n448:         span: Span,\n449:     },\n450: }\n451: \n452: #[derive(Debug)]\n453: pub struct MatchArm {\n454:     pub pattern: Pattern,\n455:     pub body: Expr,\n456:     pub span: Span,\n457: }\n458: \n459: #[derive(Debug)]\n460: pub enum Pattern {\n461:     /// A variant name, optionally destructuring its payload's fields. Bare names inside the\n462:     /// braces bind fresh, and `rest` is the `..` marker that permits naming only some of them.\n463:     Variant {\n464:         name: String,\n465:         span: Span,\n466:         fields: Option<FieldsPattern>,\n467:     },\n468:     /// A Bool guard: the arm matches when the expression is true. `.` inside it (and inside\n469:     /// the arm's body) is still the chain's subject, unlike a variant arm, which rebinds it.\n470:     Guard(Expr),\n471:     /// The default arm: `any()`, or the bare trailing expression the parser desugars into one\n472:     /// (its body doubles as its span). Matches whatever is left.\n473:     Default { span: Span },\n474: }\n475: \n476: impl Pattern {\n477:     pub fn span(&self) -> Span {\n478:         match self {\n479:             Pattern::Variant { span, .. } | Pattern::Default { span } => *span,\n480:             Pattern::Guard(e) => e.span(),\n481:         }\n482:     }\n483: }\n484: \n485: #[derive(Debug)]\n486: pub struct FieldsPattern {\n487:     pub names: Vec<(String, Span)>,\n488:     pub rest: bool,\n489:     pub span: Span,\n490: }\n491: \n492: impl Expr {\n493:     pub fn span(&self) -> Span {\n494:         match self {\n495:             Expr::Str { span, .. }\n496:             | Expr::Int { span, .. }\n497:             | Expr::Float { span, .. }\n498:             | Expr::VecLit { span, .. }\n499:             | Expr::Subject { span }\n500:             | Expr::Var { span, .. }\n501:             | Expr::Call { span, .. }\n502:             | Expr::Project { span, .. }\n503:             | Expr::Index { span, .. }\n504:             | Expr::Slice { span, .. }\n505:             | Expr::Unwrap { span, .. }\n506:             | Expr::RecordLit { span, .. }\n507:             | Expr::Neg { span, .. }\n508:             | Expr::Not { span, .. }\n509:             | Expr::Field { span, .. }\n510:             | Expr::Stdin { span }\n511:             | Expr::Dsv { span, .. }\n512:             | Expr::Variant { span, .. }\n513:             | Expr::Match { span, .. }\n514:             | Expr::MatchCall { span, .. }\n515:             | Expr::Pipe { span, .. }\n516:             | Expr::TailPipe { span, .. }\n517:             | Expr::Binary { span, .. }\n518:             | Expr::Logic { span, .. }\n519:             | Expr::Let { span, .. } => *span,\n520:         }\n521:     }\n522: }\n\n(End of file - total 522 lines)\n</content>","metadata":{"preview":"#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\npub struct Span {\n    pub start: usize,\n    pub end: usize,\n}\n\nimpl Span {\n    pub fn new(start: usize, end: usize) -> Self {\n        Span { start, end }\n    }\n\n    pub fn to(self, other: Span) -> Span {\n        Span::new(self.start, other.end)\n    }\n}\n\n#[derive(Debug, Clone, Copy, PartialEq)]\npub enum BinOp {\n    Add,\n    Sub,","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-167/src/ast.rs","text":"#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\npub struct Span {\n    pub start: usize,\n    pub end: usize,\n}\n\nimpl Span {\n    pub fn new(start: usize, end: usize) -> Self {\n        Span { start, end }\n    }\n\n    pub fn to(self, other: Span) -> Span {\n        Span::new(self.start, other.end)\n    }\n}\n\n#[derive(Debug, Clone, Copy, PartialEq)]\npub enum BinOp {\n    Add,\n    Sub,\n    Mul,\n    Div,\n    Rem,\n    Eq,\n    Ne,\n    Lt,\n    Le,\n    Gt,\n    Ge,\n}\n\nimpl BinOp {\n    pub fn is_comparison(self) -> bool {\n        matches!(\n            self,\n            BinOp::Eq | BinOp::Ne | BinOp::Lt | BinOp::Le | BinOp::Gt | BinOp::Ge\n        )\n    }\n\n    /// True for the operators that only ever mean arithmetic. `+` is missing because it also\n    /// concatenates, which is the one place an operator's meaning depends on its operands.\n    pub fn is_arithmetic(self) -> bool {\n        matches!(self, BinOp::Sub | BinOp::Mul | BinOp::Div | BinOp::Rem)\n    }\n}\n\nimpl std::fmt::Display for BinOp {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        let s = match self {\n            BinOp::Add => \"+\",\n            BinOp::Sub => \"-\",\n            BinOp::Mul => \"*\",\n            BinOp::Div => \"/\",\n            BinOp::Rem => \"%\",\n            BinOp::Eq => \"==\",\n            BinOp::Ne => \"!=\",\n            BinOp::Lt => \"<\",\n            BinOp::Le => \"<=\",\n            BinOp::Gt => \">\",\n            BinOp::Ge => \">=\",\n        };\n        write!(f, \"{s}\")\n    }\n}\n\n/// The two Bool connectives. Kept out of `BinOp` because they share none of its rules: their\n/// operands are Bool rather than a matched pair of anything, and they are the only operators\n/// that may leave their right side unevaluated.\n#[derive(Debug, Clone, Copy, PartialEq)]\npub enum LogicOp {\n    And,\n    Or,\n}\n\nimpl std::fmt::Display for LogicOp {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        let s = match self {\n            LogicOp::And => \"and\",\n            LogicOp::Or => \"or\",\n        };\n        write!(f, \"{s}\")\n    }\n}\n\n/// A type as written in source, before it is resolved to a `Type`.\n#[derive(Debug)]\npub enum TypeExpr {\n    Named {\n        name: String,\n        /// `Pair<Int>`: the arguments a declared generic enum is applied to. Empty for a\n        /// plain name. `Vec`/`Stream` keep their own variants below.\n        args: Vec<TypeExpr>,\n        span: Span,\n    },\n    Vec {\n        elem: Box<TypeExpr>,\n        span: Span,\n    },\n    /// `Stream<T>`, legal only as the whole of a parameter or return annotation: a stream is\n    /// not a value, so the checker refuses it anywhere a type would describe something stored.\n    Stream {\n        elem: Box<TypeExpr>,\n        span: Span,\n    },\n    Record {\n        fields: Vec<(String, TypeExpr)>,\n        span: Span,\n    },\n}\n\nimpl TypeExpr {\n    pub fn span(&self) -> Span {\n        match self {\n            TypeExpr::Named { span, .. }\n            | TypeExpr::Vec { span, .. }\n            | TypeExpr::Stream { span, .. }\n            | TypeExpr::Record { span, .. } => *span,\n        }\n    }\n}\n\n/// What a parameter's left side binds: either one name or a record destructured the way a match\n/// arm's brace pattern destructures one. The type annotation stays fully explicit either way.\n#[derive(Debug)]\npub enum ParamShape {\n    /// `name` in `fn f(name: T) -> R`.\n    Name(String, Span),\n    /// `{a, b, ..}` in `fn f({a, b}: T) -> R`, binding each named field of the record `T`.\n    Fields(FieldsPattern),\n}\n\nimpl ParamShape {\n    pub fn span(&self) -> Span {\n        match self {\n            ParamShape::Name(_, span) => *span,\n            ParamShape::Fields(f) => f.span,\n        }\n    }\n}\n\n#[derive(Debug)]\npub struct Param {\n    pub shape: ParamShape,\n    pub ty: TypeExpr,\n    pub span: Span,\n}\n\n/// Which source file a definition came from. Only two exist today: the program's own file and\n/// the single prelude module. A non-`pub` definition is callable only from its own file, so\n/// this is what the checker keys visibility on at each call site (gh:166).\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\npub enum Origin {\n    /// The program's own file.\n    Program,\n    /// The prelude module, `prelude.toy`.\n    Prelude,\n}\n\n#[derive(Debug)]\npub struct Def {\n    pub name: String,\n    /// `None` for a nullary function (`fn name() -> T = body`).\n    pub param: Option<Param>,\n    /// `None` for a hoisted definition (`fn name = body`, gh:152): no return type is written, so\n    /// the signature -- parameter and return both -- is inferred from the body. A hoisted\n    /// function's parameter is the implicit `.` the body matches against, and its type comes from\n    /// what the body matches; the return type is what the body synthesises.\n    pub ret: Option<TypeExpr>,\n    pub body: Expr,\n    pub span: Span,\n    /// Whether a module's prelude includes this definition when compiling a program. Meaningless\n    /// outside a module today, since nothing yet imports from a program file.\n    pub is_pub: bool,\n    /// The file this definition was written in. A program's own definitions get `Program` from\n    /// the parser; the prelude's get `Prelude` from `prelude::module`.\n    pub origin: Origin,\n    /// `fn name = body` (gh:152): no parameter list, no return annotation. `param` and `ret` are\n    /// both `None`, and the checker infers the signature from the body. The first slice accepts\n    /// only a match-call body (`Msg(Ping -> ...)`), which fixes the parameter type to the named\n    /// enum and the return type to the arms' common type.\n    pub hoisted: bool,\n}\n\n/// `enum Shape { point, circle{r: Int} }`. The first declaration that creates a type identity\n/// rather than abbreviating one: the name is what exhaustiveness will be proved against.\n#[derive(Debug)]\npub struct EnumDecl {\n    pub name: String,\n    /// Type parameters, in declaration order: `enum Opt<T> { ... }`. Capitalized names,\n    /// bound only inside this declaration's payloads.\n    pub params: Vec<(String, Span)>,\n    pub variants: Vec<Variant>,\n    pub span: Span,\n    /// Same meaning as `Def::is_pub`: whether a module exports this declaration.\n    pub is_pub: bool,\n}\n\n/// One alternative of an enum. Variant names are data (they appear as JSON keys and strings),\n/// so they are exempt from the capital-means-type casing rule, like record fields.\n#[derive(Debug)]\npub struct Variant {\n    pub name: String,\n    pub span: Span,\n    /// `None` for a unit variant. Any single type, spelled the way a call spells its argument:\n    /// a record type directly in braces (`circle{r: Int}`), any type in parens (`celsius(Int)`).\n    pub payload: Option<TypeExpr>,\n}\n\n/// `trait Name { fn sig(param: Type) -> Type }`:a named collection of method signatures,\n/// with no bodies. The receiver type is spelled `Self` in a signature, and binds to whatever\n/// concrete type an `impl` block targets. Parsed only for now: checking and dispatch are later\n/// slices.\n#[derive(Debug)]\npub struct TraitDecl {\n    pub name: String,\n    /// The method signatures, in declaration order.\n    pub methods: Vec<TraitMethodSig>,\n    pub span: Span,\n    /// Same meaning as `Def::is_pub`: whether a module exports this declaration.\n    pub is_pub: bool,\n}\n\n/// One method signature of a trait declaration:the same `fn name(param: Type) -> Type`\n/// spine a function uses, minus the body an `impl` provides.\n#[derive(Debug)]\npub struct TraitMethodSig {\n    pub name: String,\n    /// `None` for a nullary method (`fn name() -> T`).\n    pub param: Option<Param>,\n    pub ret: TypeExpr,\n    pub span: Span,\n}\n\n/// `impl Trait for Type { fn sig(param: Type) -> Type = body }`: concrete bodies for one\n/// trait's methods, one block per (trait, type) pair. Parsed only for now:the checker does\n/// not use this yet.\n#[derive(Debug)]\npub struct ImplDecl {\n    pub trait_name: String,\n    /// The concrete type the trait's `Self` substitutes to.\n    pub ty: TypeExpr,\n    /// The method bodies, each against the trait's signature of the same name.\n    pub methods: Vec<ImplMethod>,\n    pub span: Span,\n}\n/// One method of an impl block:the same spine a trait signature has, plus the body that makes\n/// it a definition.\n\n#[derive(Debug)]\npub struct ImplMethod {\n    pub name: String,\n    pub param: Option<Param>,\n    pub ret: TypeExpr,\n    pub body: Expr,\n    pub span: Span,\n}\n\n/// Zero or more definitions followed by the expression that is the program.\n#[derive(Debug)]\npub struct File {\n    /// `type Db = {users: Vec<User>}`. An abbreviation and nothing more: the name and what it\n    /// stands for are one type, so nothing distinguishes them once resolved.\n    pub aliases: Vec<Alias>,\n    pub enums: Vec<EnumDecl>,\n    /// `trait Name { ... }`:a named collection of method signatures. Parsed only for now.\n    pub traits: Vec<TraitDecl>,\n    /// `impl Trait for Type { ... }`: concrete bodies for one trait's methods. Parsed only for now.\n    pub impls: Vec<ImplDecl>,\n    pub defs: Vec<Def>,\n    pub body: Expr,\n}\n\n/// What a module file holds: declarations only, no trailing expression.\n#[derive(Debug)]\npub struct Module {\n    pub defs: Vec<Def>,\n    pub enums: Vec<EnumDecl>,\n}\n\n#[derive(Debug)]\npub struct Alias {\n    pub name: String,\n    pub ty: TypeExpr,\n    pub span: Span,\n}\n\n#[derive(Debug)]\npub enum Expr {\n    Str {\n        text: String,\n        span: Span,\n    },\n    Int {\n        value: i64,\n        span: Span,\n    },\n    /// A decimal-point literal (ADR 0007): an IEEE 754 binary64 double, the same\n    /// representation every JavaScript engine carries. The dot is what makes a number a Float,\n    /// and there is no alternative width or decimal type to guess at.\n    Float {\n        value: f64,\n        span: Span,\n    },\n    VecLit {\n        items: Vec<Expr>,\n        span: Span,\n    },\n    /// `{name: expr, age: expr}`. A record literal, the inverse of a projection. Each field\n    /// keeps its own span so a repeated one can be pointed at rather than described.\n    RecordLit {\n        fields: Vec<(String, Span, Expr)>,\n        span: Span,\n    },\n    /// `.`, the value the enclosing pipeline or filter is currently working on.\n    Subject {\n        span: Span,\n    },\n    Var {\n        name: String,\n        span: Span,\n    },\n    Call {\n        func: String,\n        func_span: Span,\n        /// `None` for a nullary call (`name()`).\n        arg: Option<Box<Expr>>,\n        span: Span,\n    },\n    /// `base[]`. A spec that keeps a dimension.\n    Project {\n        base: Box<Expr>,\n        span: Span,\n    },\n    /// `base[i]`. A spec that collapses a dimension, so the entry may not be there.\n    Index {\n        base: Box<Expr>,\n        index: Box<Expr>,\n        span: Span,\n    },\n    /// `base[lo:hi]`, bounds optional. A spec that narrows a dimension by position, jq's\n    /// `.[2:5]`; out-of-range bounds clamp to the valid range rather than answering `Opt` the\n    /// way a collapsing index does (kantord/toylang#143).\n    Slice {\n        base: Box<Expr>,\n        start: Option<Box<Expr>>,\n        end: Option<Box<Expr>>,\n        span: Span,\n    },\n    /// `base!`. Insist the value is there, and stop the program if it is not.\n    Unwrap {\n        base: Box<Expr>,\n        span: Span,\n    },\n    /// `-base`.\n    Neg {\n        base: Box<Expr>,\n        span: Span,\n    },\n    /// `not base`. Looser than every comparison, so `not a == b` negates the comparison, and\n    /// tighter than `and`/`or`, so `not a and b` negates only `a`.\n    Not {\n        base: Box<Expr>,\n        span: Span,\n    },\n    /// `base.name`. Distributes over a Vec rather than needing a map.\n    Field {\n        base: Box<Expr>,\n        name: String,\n        span: Span,\n    },\n    /// The raw lines of stdin, born `Stream<Str>`. The checker rejects a second read rather\n    /// than accepting a second stream, since there is only ever one real stdin. Lowered to\n    /// `tir::Kind::Lines`; the old `lines` keyword is this same node respelled.\n    Stdin {\n        span: Span,\n    },\n    /// Stdin read as raw lines, each split on a delimiter, born `Vec<Vec<Str>>`: the\n    /// parameterized DSV source. `csv` and `tsv` are the same node with the delimiter fixed.\n    Dsv {\n        delim: String,\n        span: Span,\n    },\n    /// An `or` chain of match arms over the subject `.`: `point -> 0 or circle{r} -> r * r`.\n    /// The subject is not part of the node; a match reads `.` the way `select` does, so it\n    /// appears as a pipe stage.\n    Match {\n        arms: Vec<MatchArm>,\n        span: Span,\n    },\n    /// `Msg(Ping -> \"pong\" or Quit -> \"bye\")`: a type name used as a match call (gh:152). The\n    /// parens hold the same `or`-separated arms a `Match` carries, over the subject `.`; the\n    /// enum name is the assertion that the subject is one of this enum's values, and the\n    /// checker resolves each variant against it. Sugar for a `Match` whose subject is `.`, kept\n    /// as its own node so the surface spelling survives formatting.\n    MatchCall {\n        enum_name: String,\n        enum_span: Span,\n        arms: Vec<MatchArm>,\n        span: Span,\n    },\n    /// `Shape.circle` or `Shape.circle{r: 1}`: a variant constructor spelled through its enum.\n    /// Only the qualified form needs its own node; a bare `circle{r: 1}` is an ordinary `Call`\n    /// and a bare `active` an ordinary `Var`, resolved through the enum registry by the checker.\n    Variant {\n        enum_name: String,\n        enum_span: Span,\n        variant: String,\n        variant_span: Span,\n        payload: Option<Box<Expr>>,\n        span: Span,\n    },\n    /// `lhs | rhs`, which binds `.` in `rhs` to the value of `lhs`.\n    Pipe {\n        lhs: Box<Expr>,\n        rhs: Box<Expr>,\n        span: Span,\n    },\n    /// `lhs |> callee`, the tail-pipeline marker: the one way a sink call is written, `callee`\n    /// applied to `lhs`. Only a Sink-typed callee is legal here, and the production is parsed\n    /// only at a program's outermost position, so this node never appears nested.\n    TailPipe {\n        lhs: Box<Expr>,\n        callee: String,\n        callee_span: Span,\n        span: Span,\n    },\n    Binary {\n        op: BinOp,\n        lhs: Box<Expr>,\n        rhs: Box<Expr>,\n        span: Span,\n    },\n    /// `lhs and rhs`, `lhs or rhs`. A separate node from `Binary` for the same reason `LogicOp`\n    /// is a separate enum: nothing about how these are typed or evaluated follows `Binary`'s\n    /// rules.\n    Logic {\n        op: LogicOp,\n        lhs: Box<Expr>,\n        rhs: Box<Expr>,\n        span: Span,\n    },\n    /// `let <name> = <expr>` on its own line, repeated, then the expression that ends the block\n    /// -- the local-binding form the ruling on #87 picked over `let ... in`: no keyword to pair,\n    /// just a sequence of bindings followed by a result. Only reachable as a function body.\n    Let {\n        bindings: Vec<(String, Expr)>,\n        body: Box<Expr>,\n        span: Span,\n    },\n}\n\n#[derive(Debug)]\npub struct MatchArm {\n    pub pattern: Pattern,\n    pub body: Expr,\n    pub span: Span,\n}\n\n#[derive(Debug)]\npub enum Pattern {\n    /// A variant name, optionally destructuring its payload's fields. Bare names inside the\n    /// braces bind fresh, and `rest` is the `..` marker that permits naming only some of them.\n    Variant {\n        name: String,\n        span: Span,\n        fields: Option<FieldsPattern>,\n    },\n    /// A Bool guard: the arm matches when the expression is true. `.` inside it (and inside\n    /// the arm's body) is still the chain's subject, unlike a variant arm, which rebinds it.\n    Guard(Expr),\n    /// The default arm: `any()`, or the bare trailing expression the parser desugars into one\n    /// (its body doubles as its span). Matches whatever is left.\n    Default { span: Span },\n}\n\nimpl Pattern {\n    pub fn span(&self) -> Span {\n        match self {\n            Pattern::Variant { span, .. } | Pattern::Default { span } => *span,\n            Pattern::Guard(e) => e.span(),\n        }\n    }\n}\n\n#[derive(Debug)]\npub struct FieldsPattern {\n    pub names: Vec<(String, Span)>,\n    pub rest: bool,\n    pub span: Span,\n}\n\nimpl Expr {\n    pub fn span(&self) -> Span {\n        match self {\n            Expr::Str { span, .. }\n            | Expr::Int { span, .. }\n            | Expr::Float { span, .. }\n            | Expr::VecLit { span, .. }\n            | Expr::Subject { span }\n            | Expr::Var { span, .. }\n            | Expr::Call { span, .. }\n            | Expr::Project { span, .. }\n            | Expr::Index { span, .. }\n            | Expr::Slice { span, .. }\n            | Expr::Unwrap { span, .. }\n            | Expr::RecordLit { span, .. }\n            | Expr::Neg { span, .. }\n            | Expr::Not { span, .. }\n            | Expr::Field { span, .. }\n            | Expr::Stdin { span }\n            | Expr::Dsv { span, .. }\n            | Expr::Variant { span, .. }\n            | Expr::Match { span, .. }\n            | Expr::MatchCall { span, .. }\n            | Expr::Pipe { span, .. }\n            | Expr::TailPipe { span, .. }\n            | Expr::Binary { span, .. }\n            | Expr::Logic { span, .. }\n            | Expr::Let { span, .. } => *span,\n        }\n    }\n}","lineStart":1,"lineEnd":522,"totalLines":522,"truncated":false}},"title":"src/ast.rs","time":{"start":1788705129639,"end":1788705129670}},"id":"prt_07722449e001nIPBSbx53NOL1V","sessionID":"ses_f88de0697ffeJyEgaxJWCC7F93","messageID":"msg_077223a46001EBRCWRulQSjO78"}}
