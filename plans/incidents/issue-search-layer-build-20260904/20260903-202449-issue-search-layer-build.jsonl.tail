the dict value, so `arg` runs as the\n // lambda's ignored argument -- the same shape `Bind` uses -- purely for whatever\n // else it does.\n Builtin::Fields => {\n","filediff":{"file":"/home/kantord/.local/share/toylang-lanes/issue-search-layer-build/src/emit_py.rs","patch":"Index: /home/kantord/.local/share/toylang-lanes/issue-search-layer-build/src/emit_py.rs\n===================================================================\n--- /home/kantord/.local/share/toylang-lanes/issue-search-layer-build/src/emit_py.rs\n+++ /home/kantord/.local/share/toylang-lanes/issue-search-layer-build/src/emit_py.rs\n@@ -506,8 +506,14 @@\n         format!(\"tl_sum64({})\", expr(enums, arg))\n     }\n }\n Builtin::Max => format!(\"tl_max({})\", expr(enums, arg)),\n+// The cut operator (gh:142): `first` commits to the first answer, and `any`/`all`\n+// reduce a `Vec<Bool>` to one Bool with Python's own short-circuiting builtins, which\n+// share the empty-is-false / empty-is-true vacuity the model gives them.\n+Builtin::First => format!(\"tl_first({})\", expr(enums, arg)),\n+Builtin::Any => format!(\"any({})\", expr(enums, arg)),\n+Builtin::All => format!(\"all({})\", expr(enums, arg)),\n // The names come from the checked type, not the dict value, so `arg` runs as the\n // lambda's ignored argument -- the same shape `Bind` uses -- purely for whatever\n // else it does.\n Builtin::Fields => {\n","additions":6,"deletions":0},"truncated":false},"title":"src/emit_py.rs","time":{"start":1788460461150,"end":1788460461153}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_0688ce6a3001Z2BWYOuf5A2YvE","sessionID":"ses_f977bc931ffe9OHrIOJvOWQPwa","messageID":"msg_0688cdd29001SotOdmSGENxpWk"}}
