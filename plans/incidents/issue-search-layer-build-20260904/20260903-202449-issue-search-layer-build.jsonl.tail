ule.add_function(\n+        \"tl_vec_all\",\n+        i64t.fn_type(&[ptr.into()], false),\n+        None,\n+    ),\n };\n \n Emitter {\n     ctx,\n","additions":19,"deletions":0},"truncated":false},"title":"src/emit_llvm.rs","time":{"start":1788460625904,"end":1788460625906}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_0688f68ff001NuYufT7RRc1JnB","sessionID":"ses_f977bc931ffe9OHrIOJvOWQPwa","messageID":"msg_0688f6183001F13BCr5u2NlQ7n"}}
