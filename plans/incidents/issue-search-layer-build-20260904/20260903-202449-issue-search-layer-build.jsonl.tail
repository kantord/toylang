{"type":"tool_use","timestamp":1788460341357,"sessionID":"ses_f977bc931ffe9OHrIOJvOWQPwa","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-b7dd9cb9dbdbb69d","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-search-layer-build/src/emit_lua.rs","limit":55,"offset":700},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-search-layer-build/src/emit_lua.rs</path>\n<type>file</type>\n<content>\n700:                 walk(lhs, used);\n701:                 walk(rhs, used);\n702:             }\n703:             Kind::Bind { value, body, .. } => {\n704:                 walk(value, used);\n705:                 walk(body, used);\n706:             }\n707:             Kind::Map { source, body, .. } => {\n708:                 used.map = true;\n709:                 walk(source, used);\n710:                 walk(body, used);\n711:             }\n712:             Kind::OptMap { source, body, .. } => {\n713:                 walk(source, used);\n714:                 walk(body, used);\n715:             }\n716:             Kind::Select { source, pred, .. } => {\n717:                 used.select = true;\n718:                 walk(source, used);\n719:                 walk(pred, used);\n720:             }\n721:             Kind::Field { base, .. } => {\n722:                 // Depth zero is a plain index and needs no helper.\n723:                 used.field |= tir::vec_depth(&base.ty) > 0;\n724:                 walk(base, used);\n725:             }\n726:             Kind::Builtin { which, arg } => {\n727:                 builtin_helpers(*which, &arg.ty, used);\n728:                 walk(arg, used);\n729:             }\n730:             Kind::Arith { op, lhs, rhs } => {\n731:                 if t.ty == Type::Int64 {\n732:                     used.arith64 |= matches!(op, BinOp::Div | BinOp::Rem);\n733:                 } else {\n734:                     used.arith = true;\n735:                 }\n736:                 walk(lhs, used);\n737:                 walk(rhs, used);\n738:             }\n739:             Kind::Not(base) => walk(base, used),\n740:             Kind::Unwrap { base } => {\n741:                 used.unwrap = true;\n742:                 walk(base, used);\n743:             }\n744:             Kind::Index { base, index, .. } => {\n745:                 used.index = true;\n746:                 walk(base, used);\n747:                 walk(index, used);\n748:             }\n749:             Kind::Slice { base, start, end, .. } => {\n750:                 used.slice = true;\n751:                 walk(base, used);\n752:                 if let Some(s) = start {\n753:                     walk(s, used);\n754:                 }\n\n(Showing lines 700-754 of 1083. Use offset=755 to continue.)\n</content>","metadata":{"preview":"                walk(lhs, used);\n                walk(rhs, used);\n            }\n            Kind::Bind { value, body, .. } => {\n                walk(value, used);\n                walk(body, used);\n            }\n            Kind::Map { source, body, .. } => {\n                used.map = true;\n                walk(source, used);\n                walk(body, used);\n            }\n            Kind::OptMap { source, body, .. } => {\n                walk(source, used);\n                walk(body, used);\n            }\n            Kind::Select { source, pred, .. } => {\n                used.select = true;\n                walk(source, used);\n                walk(pred, used);","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-search-layer-build/src/emit_lua.rs","text":"                walk(lhs, used);\n                walk(rhs, used);\n            }\n            Kind::Bind { value, body, .. } => {\n                walk(value, used);\n                walk(body, used);\n            }\n            Kind::Map { source, body, .. } => {\n                used.map = true;\n                walk(source, used);\n                walk(body, used);\n            }\n            Kind::OptMap { source, body, .. } => {\n                walk(source, used);\n                walk(body, used);\n            }\n            Kind::Select { source, pred, .. } => {\n                used.select = true;\n                walk(source, used);\n                walk(pred, used);\n            }\n            Kind::Field { base, .. } => {\n                // Depth zero is a plain index and needs no helper.\n                used.field |= tir::vec_depth(&base.ty) > 0;\n                walk(base, used);\n            }\n            Kind::Builtin { which, arg } => {\n                builtin_helpers(*which, &arg.ty, used);\n                walk(arg, used);\n            }\n            Kind::Arith { op, lhs, rhs } => {\n                if t.ty == Type::Int64 {\n                    used.arith64 |= matches!(op, BinOp::Div | BinOp::Rem);\n                } else {\n                    used.arith = true;\n                }\n                walk(lhs, used);\n                walk(rhs, used);\n            }\n            Kind::Not(base) => walk(base, used),\n            Kind::Unwrap { base } => {\n                used.unwrap = true;\n                walk(base, used);\n            }\n            Kind::Index { base, index, .. } => {\n                used.index = true;\n                walk(base, used);\n                walk(index, used);\n            }\n            Kind::Slice { base, start, end, .. } => {\n                used.slice = true;\n                walk(base, used);\n                if let Some(s) = start {\n                    walk(s, used);\n                }","lineStart":700,"lineEnd":754,"totalLines":1083,"truncated":true}},"title":"src/emit_lua.rs","time":{"start":1788460341345,"end":1788460341355}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now I have a complete understanding. Let me set up my plan and start implementing. Let me set up the todo list and look at the `Backend` enum / `lib.rs` to understand how backends are listed and the `run_on` function. Let me look at lib.rs.\n\nActually, I have enough. Let me plan the implementation:\n\n## Plan\n\n### Semantics\n- `first(v: Vec<T>) -> Opt<T>`: the first element, `none` if empty. Cut operator.\n- `any(v: Vec<Bool>) -> Bool`: true if any element is true. Empty -> false.\n- `all(v: Vec<Bool>) -> Bool`: true if all elements are true. Empty -> true (vacuous).\n\n### Changes\n\n1. **`src/tir.rs`** — Add `Builtin::First`, `Builtin::Any`, `Builtin::All` to the `Builtin` enum.\n\n2. **`src/check/mod.rs`** —\n   - Add `first`, `any`, `all` to `BUILTIN_NAMES` (change count from 16 to 19).\n   - Add `first_call`, `any_call`, `all_call` functions.\n   - Add dispatch in `call()`: `if func == \"first\"`, `if func == \"any\"`, `if func == \"all\"`.\n\n3. **`src/tags.rs`** — Add `Builtin::First => \"first\"`, `Builtin::Any => \"any\"`, `Builtin::All => \"all\"` to `builtin_tag`.\n\n4. **`src/emit_js.rs`** —\n   - Add `FIRST_HELPER` (`tl_first`), and inline `any`/`all` with `.some`/`.every`.\n   - Add `first: bool` to `Helpers`, set in `walk`, and add to dispatch.\n   - Add `Builtin::First`/`Any`/`All` arms in `expr`.\n\n5. **`src/emit_jq.rs`** — Add arms in the builtin match.\n\n6. **`src/emit_py.rs`** — Add `FIRST_HELPER` (`tl_first`), inline `any`/`all` with `any(...)`/`all(...)` (Python builtins). Add to dispatch.\n\n7. **`src/emit_lua.rs`** — Add `FIRST_HELPER` (`tl_first`), and `tl_any`/`tl_all` helpers (Lua has no builtin any/all on tables). Add `first`/`any`/`all` to `Helpers`, `builtin_helpers`, dispatch, and `expr`.\n\n8. **`src/emit_rs.rs`** — Add `FIRST_HELPER` (`tl_first`), inline `any`/`all` with `.iter().any(...)`/`.iter().all(...)` or helpers. Add to dispatch.\n\n9. **`src/emit_go.rs`** — Add `FIRST_HELPER` (`tlFirst`), `ANY_HELPER`/`ALL_HELPER` (`tlAny`/`tlAll`). Add to dispatch + imports.\n\n10. **`src/emit_llvm.rs`** — Add `vec_first`, `vec_any`, `vec_all` to `Runtime` struct, declare them in `new`, add arms in the builtin match. Add C functions to `runtime/toylang.c`.\n\n11. **`src/emit_toylang.rs`** — No change needed (calls render generically).\n\n12. **Corpus tests** — Add `first_*.yaml`, `any_*.yaml`, `all_*.yaml` cases. `tag_corpus.rs` regenerates `node_types` automatically.\n\n13. **Docs** — Add `docs/reference/builtins/first.md`, `any.md`, `all.md` (required by `every_builtin_has_a_reference_page`).\n\nLet me start. First let me check lib.rs for the Backend enum and run_on to make sure I understand the backend list, and check `emit_jq.rs`'s `used`/`Helpers` (jq may not have a Helpers struct since it's pure expression emission). Let me check the jq emitter structure briefly and the lua Helpers / go used tracking.\n\nActually, the jq emitter: let me check if it has a Helpers struct or just emits inline. From the grep earlier, the jq builtin match is in `expr` and there's a `used` mention at line 396. Let me check the jq emitter's helper tracking. Actually the jq emitter seems to emit everything inline as pure jq expressions (no helper functions needed since jq has all the primitives). So `first`/`any`/`all` are just inline jq expressions. Good - no helper tracking needed for jq.\n\nLet me verify by checking if jq has any helper dispatch. From the earlier read, the jq `expr` function directly emits. Let me confirm jq has no helpers struct.\n\nLet me check the go emitter's `used` tracking struct and how `Sum`/`Max` are tracked (I saw `Builtin::Sum | Builtin::Max => {}` in the walk -- meaning they don't need to set any `used` flag because the helper inclusion is text-based via `uses(\"tlMax(\")`). Right, the go emitter uses textual `uses(...)` scanning. So I just need to add the helper consts and the `uses(...)` dispatch entries. And the `Builtin::First | Any | All => {}` to the walk's no-tracking arm.\n\nNow let me also double check: the lua emitter's walk and `builtin_helpers`. I saw `builtin_helpers` sets `used.sum`, `used.max`, etc. For `first`/`any`/`all` I'll add `used.first`, `used.any`, `used.all` and set them in `builtin_helpers`. And add helper consts + dispatch + `Helpers` fields.\n\nLet me now also check how the lua emitter's `used_helpers` walk calls `builtin_helpers` -- I saw it at line 644. Let me check where `builtin_helpers` is called from within `used_helpers`'s walk. Let me grep.\n\nActually, let me just start implementing and refer back as needed. Let me begin with the TIR and checker (the core), then the emitters, then tests.\n\nLet me first look at the lua `used_helpers` walk to see where `builtin_helpers` is invoked, and the lua `Helpers` walk for `Builtin`. Let me read lines 675-730 of emit_lua.rs.","format":"unknown","index":0}]}},"id":"prt_0688b1571001MDKKPG0oWNdPkU","sessionID":"ses_f977bc931ffe9OHrIOJvOWQPwa","messageID":"msg_06889e4aa001PN9H5BeRI2B1WN"}}
{"type":"tool_use","timestamp":1788460341585,"sessionID":"ses_f977bc931ffe9OHrIOJvOWQPwa","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-92aa89444740fa3d","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-search-layer-build/src/lib.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-search-layer-build/src/lib.rs</path>\n<type>file</type>\n<content>\n1: pub mod ast;\n2: pub mod check;\n3: pub mod emit_go;\n4: pub mod emit_jq;\n5: pub mod emit_js;\n6: pub mod emit_llvm;\n7: pub mod emit_lua;\n8: pub mod emit_py;\n9: pub mod emit_rs;\n10: pub mod emit_toylang;\n11: pub mod error;\n12: pub mod float;\n13: pub mod fmt_tree;\n14: pub mod input;\n15: pub mod offload;\n16: pub mod parse;\n17: pub mod prelude;\n18: pub mod tags;\n19: pub mod tir;\n20: pub mod ty;\n21: \n22: use std::cell::RefCell;\n23: use std::io::{BufRead, Write};\n24: use std::rc::Rc;\n25: \n26: use anyhow::{Context, Result};\n27: use error::Error;\n28: use tir::Program;\n29: \n30: #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n31: pub enum Backend {\n32:     Lua,\n33:     Js,\n34:     Native,\n35:     Jq,\n36:     Go,\n37:     Py,\n38:     Rust,\n39: }\n40: \n41: impl Backend {\n42:     /// The backends that must agree on every corpus program. Native and Rust each joined once\n43:     /// they could compile the whole language; until then they were kept out rather than allowed\n44:     /// to turn the harness permanently red, tracked by tests/backend_llvm.rs and\n45:     /// tests/backend_rust.rs respectively.\n46:     pub const ALL: [Backend; 7] = [\n47:         Backend::Lua,\n48:         Backend::Js,\n49:         Backend::Native,\n50:         Backend::Jq,\n51:         Backend::Go,\n52:         Backend::Py,\n53:         Backend::Rust,\n54:     ];\n55: \n56:     /// The spelling used on the command line and in a corpus case's `snapshot` list.\n57:     pub fn from_name(name: &str) -> Option<Backend> {\n58:         Backend::ALL.into_iter().find(|b| b.name() == name)\n59:     }\n60: \n61:     pub fn name(self) -> &'static str {\n62:         match self {\n63:             Backend::Lua => \"lua\",\n64:             Backend::Js => \"js\",\n65:             Backend::Native => \"native\",\n66:             Backend::Jq => \"jq\",\n67:             Backend::Go => \"go\",\n68:             Backend::Py => \"py\",\n69:             Backend::Rust => \"rust\",\n70:         }\n71:     }\n72: \n73:     pub fn emit(self, program: &Program) -> Result<String, String> {\n74:         match self {\n75:             Backend::Lua => Ok(emit_lua::emit(program)),\n76:             Backend::Js => Ok(emit_js::emit(program)),\n77:             Backend::Native => emit_llvm::to_ir(program),\n78:             Backend::Jq => emit_jq::emit(program),\n79:             Backend::Go => Ok(emit_go::emit(program)),\n80:             Backend::Py => Ok(emit_py::emit(program)),\n81:             Backend::Rust => Ok(emit_rs::emit(program)),\n82:         }\n83:     }\n84: }\n85: \n86: pub fn compile(src: &str) -> Result<Program, Error> {\n87:     let mut file = parse::parse(src)?;\n88:     prelude::inject(&mut file);\n89:     check::check(&file)\n90: }\n91: \n92: /// Parses `src` and re-renders it in the canonical toylang style, without checking or injecting\n93: /// the prelude -- a formatter has to work on a program that does not type-check, and it must\n94: /// never print the prelude definitions `compile` splices in for its own purposes.\n95: pub fn fmt(src: &str) -> Result<String, Error> {\n96:     emit_toylang::format_source(src)\n97: }\n98: \n99: pub fn run(src: &str) -> Result<String> {\n100:     run_on(src, None, Backend::Lua)\n101: }\n102: \n103: pub fn run_with_input(src: &str, stdin: Option<&str>) -> Result<String> {\n104:     run_on(src, stdin, Backend::Lua)\n105: }\n106: \n107: /// Whether the generated code for `program` reads `inputs` for itself, one record at a time,\n108: /// rather than needing the whole thing parsed and handed over up front. A type question now,\n109: /// not a shape guess: exactly the programs `tir::fusion` reads from `inputs` -- every backend\n110: /// has a fused loop to emit. An aggregate like `length(collect(inputs))` still has no way to\n111: /// stream no matter which backend runs it. Public so `main.rs` can decide, before it has read\n112: /// anything, whether to drain real stdin itself or hand it to `run_on` untouched.\n113: pub fn streams_inputs(program: &tir::Program) -> bool {\n114:     matches!(\n115:         tir::fusion(program),\n116:         Some(f) if matches!(f.source, tir::Source::Inputs)\n117:     )\n118: }\n119: \n120: /// Compile and run, capturing what the program printed -- except when `stdin` is `None` and\n121: /// `streams_inputs` says the backend reads `inputs` for itself, in which case the real stdin and\n122: /// stdout are connected straight through (`Feed::Live`) and there is nothing left to capture.\n123: /// Capturing otherwise keeps the tests to one call: it also means output is held in memory, which\n124: /// is fine for every program whose result has statically known length, and is exactly the case\n125: /// `Feed::Live` exists for on the ones that no longer do.\n126: pub fn run_on(src: &str, stdin: Option<&str>, backend: Backend) -> Result<String> {\n127:     let program = compile(src)?;\n128: \n129:     // `stdin.is_none()` is the same convention `uses_lines` already uses below: nothing was\n130:     // supplied, which only happens on the real command line, never from a test fixture. Only\n131:     // then is there real live stdin worth handing straight to a subprocess backend rather than\n132:     // something already sitting in memory to validate up front.\n133:     let live_inputs = stdin.is_none() && streams_inputs(&program);\n134:     // Lua is the one backend with no subprocess of its own: `run_lua` itself decides how\n135:     // `inputs` reaches the running chunk, by injecting either a pre-populated global or a\n136:     // per-call function, and the emitted source commits to one of those two shapes purely from\n137:     // `tir::fusion`, independent of whether a fixture or the real command line supplied the\n138:     // bytes. So unlike `live_inputs` above, this also has to hold for a fixture-fed test, or\n139:     // the host would inject the global while the fused source calls the function.\n140:     let lua_fused = matches!(backend, Backend::Lua) && streams_inputs(&program);\n141: \n142:     // The input is checked against the declared type once, here, rather than by each backend.\n143:     // What a backend receives has already been parsed, so no backend re-decides what is valid.\n144:     let value = match (&program.input, stdin) {\n145:         (Some(ty), Some(text)) => {\n146:             let value: serde_json::Value = serde_json::from_str(text)?;\n147:             input::validate(&program.enums, &value, ty, \"input\").map_err(anyhow::Error::msg)?;\n148:             Some(value)\n149:         }\n150:         (Some(ty), None) => anyhow::bail!(\"this program reads input, of type {ty}\"),\n151:         (None, _) => None,\n152:     };\n153: \n154:     // `inputs` is eager like `input`, not incremental like `lines`, so it normally goes through\n155:     // the same validate-then-re-serialize step: every backend receives canonical bytes, one\n156:     // compact JSON value per line, rather than whatever formatting the original text happened to\n157:     // use. `live_inputs` and `lua_fused` are the exceptions -- nothing is precomputed for them,\n158:     // because the whole point of a fused loop is not reading the whole stream before the first\n159:     // record is handled. Validation still happens record-by-record on the host: `run_lua`'s\n160:     // `next_input` function does it for the Lua backend it is embedded in, and `Feed::LiveInputs`\n161:     // below does it for every other, subprocess-based backend, since generated code cannot be\n162:     // trusted to reimplement `input::validate` correctly in six different target languages.\n163:     let inputs_values = if live_inputs || lua_fused {\n164:         None\n165:     } else {\n166:         match (&program.inputs, stdin) {\n167:             (Some(elem_ty), Some(text)) => {\n168:                 let mut values = Vec::new();\n169:                 for line in text.lines().filter(|l| !l.trim().is_empty()) {\n170:                     let value: serde_json::Value = serde_json::from_str(line)?;\n171:                     input::validate(&program.enums, &value, elem_ty, \"inputs\")\n172:                         .map_err(anyhow::Error::msg)?;\n173:                     values.push(value);\n174:                 }\n175:                 Some(values)\n176:             }\n177:             (Some(elem_ty), None) => {\n178:                 anyhow::bail!(\"this program reads inputs, of type Vec<{elem_ty}>\");\n179:             }\n180:             (None, _) => None,\n181:         }\n182:     };\n183: \n184:     // What a backend's stdin should be connected to. `input` always has known bytes: the\n185:     // re-serialized, already-validated value. `lines` has known bytes only when a caller (a\n186:     // corpus fixture, most often) supplied them directly -- and when it does, they are piped in\n187:     // verbatim rather than pre-split, so a backend's own splitting genuinely runs against them\n188:     // rather than being bypassed by the test that is supposed to exercise it. Only when nothing\n189:     // was supplied, which is the real command-line case, does `lines` connect the real stdin\n190:     // straight through, with no Rust-side buffering in between -- the one thing that would make\n191:     // its streaming indistinguishable from having read everything first. A live, fused `inputs`\n192:     // program has no type to lean on the way `lines` does (raw text is always valid `Str`), so it\n193:     // cannot connect the real stdin straight through: `Feed::LiveInputs` reads and validates one\n194:     // record at a time itself and forwards only what passes, real streaming with no read-it-all-\n195:     // first buffering, but through Rust rather than direct fd inheritance. The Lua backend is the\n196:     // one exception -- it validates through its own `next_input` function instead, direct from\n197:     // `Feed::Live`, since it runs embedded rather than as a subprocess with a pipe to mediate.\n198:     // A fused Lua program run against a fixture is not live, but still needs the raw bytes\n199:     // verbatim rather than the eager re-serialized form, since `run_lua`'s injected function does\n200:     // its own splitting the same way `lines` always has.\n201:     let feed = if program.uses_lines || program.dsv.is_some() {\n202:         match stdin {\n203:             Some(text) => Feed::Text(text.to_string()),\n204:             None => Feed::Live,\n205:         }\n206:     } else if live_inputs {\n207:         live_inputs_feed(&program, backend)\n208:     } else if lua_fused {\n209:         Feed::Text(stdin.map(str::to_string).unwrap_or_default())\n210:     } else if let Some(values) = &inputs_values {\n211:         Feed::Text(\n212:             values\n213:                 .iter()\n214:                 .map(|v| v.to_string())\n215:                 .collect::<Vec<_>>()\n216:                 .join(\"\\n\"),\n217:         )\n218:     } else {\n219:         Feed::Text(value.as_ref().map(|v| v.to_string()).unwrap_or_default())\n220:     };\n221: \n222:     match backend {\n223:         Backend::Lua => run_lua(\n224:             &emit_lua::emit(&program),\n225:             &program.enums,\n226:             value.as_ref(),\n227:             inputs_values.as_ref(),\n228:             program.inputs.as_ref(),\n229:             &feed,\n230:         ),\n231:         Backend::Js => run_node(&emit_js::emit(&program), &feed),\n232:         Backend::Jq => run_jq(\n233:             &emit_jq::emit(&program).map_err(anyhow::Error::msg)?,\n234:             JqInvocation {\n235:                 has_value: value.is_some(),\n236:                 raw: matches!(program.body.ty, ty::Type::Str | ty::Type::Sink),\n237:                 uses_lines: program.uses_lines || program.dsv.is_some(),\n238:             },\n239:             &feed,\n240:         ),\n241:         Backend::Go => run_go(&emit_go::emit(&program), &feed),\n242:         Backend::Py => run_py(&emit_py::emit(&program), &feed),\n243:         Backend::Native => {\n244:             let dir = tempfile::tempdir()?;\n245:             let exe = dir.path().join(\"program\");\n246:             link(&program, &exe)?;\n247:             run_binary(&exe, &feed)\n248:         }\n249:         Backend::Rust => {\n250:             let dir = tempfile::tempdir()?;\n251:             let exe = dir.path().join(\"program\");\n252:             link_rust(&emit_rs::emit(&program), &exe)?;\n253:             run_binary(&exe, &feed)\n254:         }\n255:     }\n256: }\n257: \n258: /// The feed for a live, fused `inputs` program: real stdin, but validated. Lua is the exception,\n259: /// since `run_lua`'s own `next_input` function validates directly off `Feed::Live` rather than\n260: /// needing `Feed::LiveInputs` to mediate a pipe it has no subprocess to write into.\n261: fn live_inputs_feed(program: &Program, backend: Backend) -> Feed {\n262:     if matches!(backend, Backend::Lua) {\n263:         Feed::Live\n264:     } else {\n265:         Feed::LiveInputs(\n266:             program\n267:                 .inputs\n268:                 .clone()\n269:                 .expect(\"live_inputs implies an inputs type\"),\n270:             program.enums.clone(),\n271:         )\n272:     }\n273: }\n274: \n275: /// What a subprocess backend's stdin is connected to.\n276: enum Feed {\n277:     /// Known bytes, written through a pipe: `input`'s re-serialized value, a `lines` program's\n278:     /// fixture text verbatim, or nothing for a program that reads no stdin at all.\n279:     Text(String),\n280:     /// The real process stdin, inherited rather than piped. Reachable only for a `lines`\n281:     /// program run with no fixture supplied.\n282:     Live,\n283:     /// The real process stdin, read and validated one record at a time against the element type,\n284:     /// then forwarded through a pipe -- real streaming, but mediated by the host rather than\n285:     /// inherited directly, which is what lets `input::validate` see every record before a\n286:     /// subprocess backend's own, untrusted parse of it does. Reachable only for a live, fused\n287:     /// `inputs` program on a backend other than Lua (see `write_to`).\n288:     LiveInputs(ty::Type, ty::Enums),\n289: }\n290: \n291: impl Feed {\n292:     fn stdio(&self) -> std::process::Stdio {\n293:         match self {\n294:             Feed::Text(_) | Feed::LiveInputs(..) => std::process::Stdio::piped(),\n295:             Feed::Live => std::process::Stdio::inherit(),\n296:         }\n297:     }\n298: \n299:     fn write_to(&self, child: &mut std::process::Child) -> Result<()> {\n300:         match self {\n301:             Feed::Text(text) => {\n302:                 child\n303:                     .stdin\n304:                     .take()\n305:                     .expect(\"piped\")\n306:                     .write_all(text.as_bytes())?;\n307:             }\n308:             Feed::Live => {}\n309:             Feed::LiveInputs(elem_ty, enums) => {\n310:                 let mut stdin = child.stdin.take().expect(\"piped\");\n311:                 for line in std::io::stdin().lock().lines() {\n312:                     let line = line?;\n313:                     if line.trim().is_empty() {\n314:                         continue;\n315:                     }\n316:                     let value: serde_json::Value = serde_json::from_str(&line)?;\n317:                     if let Err(msg) = input::validate(enums, &value, elem_ty, \"inputs\") {\n318:                         // Close the pipe so the child sees EOF and can finish printing whatever\n319:                         // it already validly received, then wait for it before reporting the\n320:                         // refusal -- otherwise this leaves an unreaped child behind.\n321:                         drop(stdin);\n322:                         child.wait()?;\n323:                         return Err(anyhow::Error::msg(msg));\n324:                     }\n325:                     writeln!(stdin, \"{line}\")?;\n326:                 }\n327:             }\n328:         }\n329:         Ok(())\n330:     }\n331: }\n332: \n333: /// Compile to a native executable at `out`.\n334: ///\n335: /// LLVM produces an object file, which is not a program, so this shells out to `cc` for the\n336: /// link. That is a toolchain requirement the Lua backend does not have, since mlua vendors its\n337: /// interpreter.\n338: pub fn link(program: &Program, out: &std::path::Path) -> Result<()> {\n339:     let dir = tempfile::tempdir()?;\n340:     let object = dir.path().join(\"program.o\");\n341:     emit_llvm::compile_to_object(program, &object).map_err(anyhow::Error::msg)?;\n342: \n343:     // The runtime is compiled alongside rather than shipped as a library, which keeps the build\n344:     // to one `cc` call and means there is nothing to install.\n345:     let runtime = dir.path().join(\"toylang.c\");\n346:     std::fs::write(&runtime, emit_llvm::RUNTIME_C)?;\n347: \n348:     let status = std::process::Command::new(\"cc\")\n349:         .arg(&object)\n350:         .arg(&runtime)\n351:         .arg(\"-o\")\n352:         .arg(out)\n353:         .status()\n354:         .context(\"could not run `cc`\")?;\n355:     if !status.success() {\n356:         anyhow::bail!(\"cc failed to link: {status}\");\n357:     }\n358:     Ok(())\n359: }\n360: \n361: /// Compile Rust source to an executable at `out`. One `rustc` call on one self-contained file,\n362: /// no external crate and no Cargo project, the same reason `link` above is one `cc` call: the\n363: /// generated source depends on nothing this compiler did not already assume was installed.\n364: /// Public for the same reason as `link`: `tests/backend_rust.rs` calls it directly, separately\n365: /// from running the result, so a genuine codegen gap (`rustc` rejects the source) is told apart\n366: /// from a legitimate runtime refusal (`rustc` succeeds, the binary exits non-zero).\n367: pub fn link_rust(source: &str, out: &std::path::Path) -> Result<()> {\n368:     let dir = tempfile::tempdir()?;\n369:     let src = dir.path().join(\"program.rs\");\n370:     std::fs::write(&src, source)?;\n371: \n372:     let result = std::process::Command::new(\"rustc\")\n373:         .arg(\"--edition\")\n374:         .arg(\"2021\")\n375:         .arg(&src)\n376:         .arg(\"-o\")\n377:         .arg(out)\n378:         .output()\n379:         .context(\"could not run `rustc`\")?;\n380:     if !result.status.success() {\n381:         anyhow::bail!(\n382:             \"rustc failed to compile: {}\",\n383:             String::from_utf8_lossy(&result.stderr)\n384:         );\n385:     }\n386:     Ok(())\n387: }\n388: \n389: /// Runs `cmd` (already given whatever args the caller needs) connected to `feed`, and returns\n390: /// what it printed.\n391: ///\n392: /// When `feed` is `Feed::Live` or `Feed::LiveInputs` there is no test harness reading the result\n393: /// back: stdout and stderr are inherited straight through to the real terminal or pipe instead of\n394: /// being captured, which is what lets a program that streams actually show output as it produces\n395: /// it rather than all at once when it exits. `Ok(String::new())` reflects that nothing is left to\n396: /// hand back -- it already went to the real stdout directly. `feed.write_to` reports a validation\n397: /// refusal for `Feed::LiveInputs` as an `Err` before this function's own `child.wait()` runs, so\n398: /// that path never reaches here at all.\n399: fn run_subprocess(mut cmd: std::process::Command, label: &str, feed: &Feed) -> Result<String> {\n400:     let live = matches!(feed, Feed::Live | Feed::LiveInputs(..));\n401:     let mut child = cmd\n402:         .stdin(feed.stdio())\n403:         .stdout(if live {\n404:             std::process::Stdio::inherit()\n405:         } else {\n406:             std::process::Stdio::piped()\n407:         })\n408:         .stderr(if live {\n409:             std::process::Stdio::inherit()\n410:         } else {\n411:             std::process::Stdio::piped()\n412:         })\n413:         .spawn()\n414:         .with_context(|| format!(\"could not run `{label}`\"))?;\n415: \n416:     feed.write_to(&mut child)?;\n417: \n418:     if live {\n419:         let status = child.wait()?;\n420:         if !status.success() {\n421:             anyhow::bail!(\"{label} failed\");\n422:         }\n423:         return Ok(String::new());\n424:     }\n425: \n426:     let out = child.wait_with_output()?;\n427:     if !out.status.success() {\n428:         anyhow::bail!(\"{label} failed: {}\", String::from_utf8_lossy(&out.stderr));\n429:     }\n430:     Ok(String::from_utf8(out.stdout)?)\n431: }\n432: \n433: fn run_binary(exe: &std::path::Path, feed: &Feed) -> Result<String> {\n434:     run_subprocess(\n435:         std::process::Command::new(exe),\n436:         \"the compiled program\",\n437:         feed,\n438:     )\n439: }\n440: \n441: /// jq puts stdin in `.`, so a program that reads no input runs with `-n` rather than waiting on\n442: /// a terminal. `has_value` rather than the `Feed` itself, since a `lines` program run live\n443: /// (`Feed::Live`) still has real stdin coming and must not get `-n` on that account.\n444: /// The three facts about a program that shape a jq invocation's flags. Each is derived from\n445: /// the compiled program, not a caller identity -- the fn-params-excessive-bools finding on the\n446: /// old three-bool signature was escalated, and the settled answer was this struct: the facts\n447: /// travel under their names.\n448: struct JqInvocation {\n449:     has_value: bool,\n450:     raw: bool,\n451:     uses_lines: bool,\n452: }\n453: \n454: fn run_jq(source: &str, inv: JqInvocation, feed: &Feed) -> Result<String> {\n455:     let JqInvocation {\n456:         has_value,\n457:         raw,\n458:         uses_lines,\n459:     } = inv;\n460:     let mut cmd = std::process::Command::new(\"jq\");\n461:     // jq's stdout is fully buffered rather than line-buffered whenever it is not a terminal, the\n462:     // same as any other libc stdio program, so a filter over `inputs` piped into another process\n463:     // would otherwise sit on every result until the run ends. `run_subprocess` only inherits\n464:     // stdout instead of capturing it for a live run, so this is still what makes that case show a\n465:     // result as soon as jq produces one rather than at exit.\n466:     cmd.arg(\"--unbuffered\");\n467:     cmd.arg(\"-c\");\n468:     // `-r` decides from the runtime value, so it would print a present Opt<Str> raw and an\n469:     // absent one as the word null. The rule here is the type's, as on every other backend.\n470:     if raw {\n471:         cmd.arg(\"-r\");\n472:     }\n473:     if !has_value && !uses_lines {\n474:         cmd.arg(\"-n\");\n475:     }\n476:     // Raw-input mode, needed for `[ inputs ]` to read lines rather than JSON, and forced by the\n477:     // checker to be the only way `lines` is used in this invocation: mixing it with `input` was\n478:     // rejected there, because `-R` changes what the whole invocation means, not just one call.\n479:     // `-n` here is not \"no input coming\"; it is what raw-input mode needs regardless, since\n480:     // `[ inputs ]` reads for itself rather than through the implicit `.` a normal run would use.\n481:     if uses_lines {\n482:         cmd.arg(\"-R\").arg(\"-n\");\n483:     }\n484:     cmd.arg(source);\n485:     run_subprocess(cmd, \"jq\", feed)\n486: }\n487: \n488: fn run_lua(\n489:     source: &str,\n490:     enums: &ty::Enums,\n491:     value: Option<&serde_json::Value>,\n492:     inputs_values: Option<&Vec<serde_json::Value>>,\n493:     inputs_elem_ty: Option<&ty::Type>,\n494:     feed: &Feed,\n495: ) -> Result<String> {\n496:     let lua = mlua::Lua::new();\n497:     if let Some(value) = value {\n498:         lua.globals()\n499:             .set(emit_lua::INPUT, input::to_lua(&lua, value)?)?;\n500:     }\n501:     if let Some(values) = inputs_values {\n502:         let array = serde_json::Value::Array(values.clone());\n503:         lua.globals()\n504:             .set(emit_lua::INPUTS, input::to_lua(&lua, &array)?)?;\n505:     } else if let Some(elem_ty) = inputs_elem_ty {\n506:         // `inputs_values` is `None` here for one of two reasons: the program does not read\n507:         // `inputs` at all (then `inputs_elem_ty` is also `None`, and neither branch runs), or\n508:         // `run_on` recognized this as a fused program and skipped precomputing the whole Vec on\n509:         // purpose (`live_inputs` or `lua_fused` there). mlua is embedded in this same process, so\n510:         // there is no separate JSON parser to write in Lua source the way Rust's own is -- the\n511:         // generated source just calls this function for the next already-validated, already-\n512:         // converted record. Reading from `feed` rather than always the real stdin is what keeps\n513:         // this correct for a fixture-tested fused program too: `feed` is `Feed::Text` there, the\n514:         // same raw bytes a subprocess backend would have been piped.\n515:         let elem_ty = elem_ty.clone();\n516:         let enums = enums.clone();\n517:         let reader: RefCell<Box<dyn std::io::BufRead>> = RefCell::new(match feed {\n518:             Feed::Live => Box::new(std::io::BufReader::new(std::io::stdin())),\n519:             Feed::Text(text) => Box::new(std::io::Cursor::new(text.clone().into_bytes())),\n520:             // `run_on` never builds this feed for the Lua backend: `live_inputs` there stays\n521:             // `Feed::Live`, since this function's own reader validates each record itself.\n522:             Feed::LiveInputs(..) => unreachable!(\"run_on keeps the Lua backend on Feed::Live\"),\n523:         });\n524:         let next_input = lua.create_function(move |lua, ()| {\n525:             use std::io::BufRead;\n526:             loop {\n527:                 let mut line = String::new();\n528:                 let n = reader\n529:                     .borrow_mut()\n530:                     .read_line(&mut line)\n531:                     .map_err(mlua::Error::external)?;\n532:                 if n == 0 {\n533:                     return Ok(mlua::Value::Nil);\n534:                 }\n535:                 let line = line.strip_suffix('\\n').unwrap_or(&line);\n536:                 if line.trim().is_empty() {\n537:                     continue;\n538:                 }\n539:                 let value: serde_json::Value =\n540:                     serde_json::from_str(line).map_err(mlua::Error::external)?;\n541:                 input::validate(&enums, &value, &elem_ty, \"inputs\")\n542:                     .map_err(mlua::Error::RuntimeError)?;\n543:                 return input::to_lua(lua, &value);\n544:             }\n545:         })?;\n546:         lua.globals().set(emit_lua::NEXT_INPUT, next_input)?;\n547:     }\n548:     // mlua is embedded in this same process, so `io.lines()` in the emitted source reads the\n549:     // real stdin directly -- verified against a live pipe, and exactly what a `lines` program\n550:     // run for real should do. A fixture is different: cargo test runs many tests concurrently\n551:     // in one process, so redirecting the process's own fd 0 would race with all of them, and is\n552:     // not done. Instead the fixture is written to a file of its own and `io.lines` is pointed at\n553:     // it, which keeps Lua's own real line-splitting in the loop rather than reimplementing it in\n554:     // Rust and only testing that reimplementation.\n555:     let _fixture_dir;\n556:     if let Feed::Text(text) = feed {\n557:         let dir = tempfile::tempdir()?;\n558:         let path = dir.path().join(\"stdin.txt\");\n559:         std::fs::write(&path, text)?;\n560:         let path = path\n561:             .to_str()\n562:             .expect(\"a temp path is valid UTF-8\")\n563:             .to_string();\n564:         let io: mlua::Table = lua.globals().get(\"io\")?;\n565:         let real_lines: mlua::Function = io.get(\"lines\")?;\n566:         let fixture =\n567:             lua.create_function(move |_, ()| real_lines.call::<mlua::Value>(path.clone()))?;\n568:         io.set(\"lines\", fixture)?;\n569:         _fixture_dir = Some(dir);\n570:     }\n571: \n572:     // A live run has no test harness reading the result back, the same distinction\n573:     // `run_subprocess` makes for the OS-process backends: `print` writes straight to the real\n574:     // stdout and flushes per call instead of buffering into a string only handed back once the\n575:     // whole chunk finishes.\n576:     let live = matches!(feed, Feed::Live);\n577:     let captured = Rc::new(RefCell::new(String::new()));\n578:     let sink = Rc::clone(&captured);\n579:     let print = lua.create_function(move |_, s: String| {\n580:         if live {\n581:             let mut stdout = std::io::stdout();\n582:             writeln!(stdout, \"{s}\").map_err(mlua::Error::external)?;\n583:             stdout.flush().map_err(mlua::Error::external)?;\n584:         } else {\n585:             sink.borrow_mut().push_str(&s);\n586:             sink.borrow_mut().push('\\n');\n587:         }\n588:         Ok(())\n589:     })?;\n590:     lua.globals().set(\"print\", print)?;\n591: \n592:     lua.load(source).exec()?;\n593: \n594:     if live {\n595:         return Ok(String::new());\n596:     }\n597:     let out = captured.borrow().clone();\n598:     Ok(out)\n599: }\n600: \n601: /// Runs through `python3`. Like `node`, this is an interpreter that has to be on the machine\n602: /// rather than one vendored into the build.\n603: fn run_py(source: &str, feed: &Feed) -> Result<String> {\n604:     let dir = tempfile::tempdir()?;\n605:     let path = dir.path().join(\"program.py\");\n606:     std::fs::write(&path, source)?;\n607: \n608:     let mut cmd = std::process::Command::new(\"python3\");\n609:     cmd.arg(&path);\n610:     run_subprocess(cmd, \"python3\", feed)\n611: }\n612: \n613: /// Runs through `go run`, which compiles and executes in one step. Go has no interpreter, so\n614: /// this is the second backend that needs a real toolchain; like `node` and `cc`, a missing one\n615: /// is an error rather than a skipped backend.\n616: fn run_go(source: &str, feed: &Feed) -> Result<String> {\n617:     let dir = tempfile::tempdir()?;\n618:     let path = dir.path().join(\"main.go\");\n619:     std::fs::write(&path, source)?;\n620: \n621:     let mut cmd = std::process::Command::new(\"go\");\n622:     cmd.arg(\"run\").arg(&path);\n623:     run_subprocess(cmd, \"go\", feed)\n624: }\n625: \n626: /// Runs through `node`, which must be present. A missing toolchain is an error rather than a\n627: /// quietly skipped backend: a report that says two backends agreed when only one ran is worse\n628: /// than no report.\n629: fn run_node(source: &str, feed: &Feed) -> Result<String> {\n630:     let dir = tempfile::tempdir()?;\n631:     let path = dir.path().join(\"program.js\");\n632:     std::fs::write(&path, source)?;\n633: \n634:     let mut cmd = std::process::Command::new(\"node\");\n635:     cmd.arg(&path);\n636:     run_subprocess(cmd, \"node\", feed)\n637: }\n638: \n639: impl std::error::Error for Error {}\n\n(End of file - total 639 lines)\n</content>","metadata":{"preview":"pub mod ast;\npub mod check;\npub mod emit_go;\npub mod emit_jq;\npub mod emit_js;\npub mod emit_llvm;\npub mod emit_lua;\npub mod emit_py;\npub mod emit_rs;\npub mod emit_toylang;\npub mod error;\npub mod float;\npub mod fmt_tree;\npub mod input;\npub mod offload;\npub mod parse;\npub mod prelude;\npub mod tags;\npub mod tir;\npub mod ty;","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-search-layer-build/src/lib.rs","text":"pub mod ast;\npub mod check;\npub mod emit_go;\npub mod emit_jq;\npub mod emit_js;\npub mod emit_llvm;\npub mod emit_lua;\npub mod emit_py;\npub mod emit_rs;\npub mod emit_toylang;\npub mod error;\npub mod float;\npub mod fmt_tree;\npub mod input;\npub mod offload;\npub mod parse;\npub mod prelude;\npub mod tags;\npub mod tir;\npub mod ty;\n\nuse std::cell::RefCell;\nuse std::io::{BufRead, Write};\nuse std::rc::Rc;\n\nuse anyhow::{Context, Result};\nuse error::Error;\nuse tir::Program;\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum Backend {\n    Lua,\n    Js,\n    Native,\n    Jq,\n    Go,\n    Py,\n    Rust,\n}\n\nimpl Backend {\n    /// The backends that must agree on every corpus program. Native and Rust each joined once\n    /// they could compile the whole language; until then they were kept out rather than allowed\n    /// to turn the harness permanently red, tracked by tests/backend_llvm.rs and\n    /// tests/backend_rust.rs respectively.\n    pub const ALL: [Backend; 7] = [\n        Backend::Lua,\n        Backend::Js,\n        Backend::Native,\n        Backend::Jq,\n        Backend::Go,\n        Backend::Py,\n        Backend::Rust,\n    ];\n\n    /// The spelling used on the command line and in a corpus case's `snapshot` list.\n    pub fn from_name(name: &str) -> Option<Backend> {\n        Backend::ALL.into_iter().find(|b| b.name() == name)\n    }\n\n    pub fn name(self) -> &'static str {\n        match self {\n            Backend::Lua => \"lua\",\n            Backend::Js => \"js\",\n            Backend::Native => \"native\",\n            Backend::Jq => \"jq\",\n            Backend::Go => \"go\",\n            Backend::Py => \"py\",\n            Backend::Rust => \"rust\",\n        }\n    }\n\n    pub fn emit(self, program: &Program) -> Result<String, String> {\n        match self {\n            Backend::Lua => Ok(emit_lua::emit(program)),\n            Backend::Js => Ok(emit_js::emit(program)),\n            Backend::Native => emit_llvm::to_ir(program),\n            Backend::Jq => emit_jq::emit(program),\n            Backend::Go => Ok(emit_go::emit(program)),\n            Backend::Py => Ok(emit_py::emit(program)),\n            Backend::Rust => Ok(emit_rs::emit(program)),\n        }\n    }\n}\n\npub fn compile(src: &str) -> Result<Program, Error> {\n    let mut file = parse::parse(src)?;\n    prelude::inject(&mut file);\n    check::check(&file)\n}\n\n/// Parses `src` and re-renders it in the canonical toylang style, without checking or injecting\n/// the prelude -- a formatter has to work on a program that does not type-check, and it must\n/// never print the prelude definitions `compile` splices in for its own purposes.\npub fn fmt(src: &str) -> Result<String, Error> {\n    emit_toylang::format_source(src)\n}\n\npub fn run(src: &str) -> Result<String> {\n    run_on(src, None, Backend::Lua)\n}\n\npub fn run_with_input(src: &str, stdin: Option<&str>) -> Result<String> {\n    run_on(src, stdin, Backend::Lua)\n}\n\n/// Whether the generated code for `program` reads `inputs` for itself, one record at a time,\n/// rather than needing the whole thing parsed and handed over up front. A type question now,\n/// not a shape guess: exactly the programs `tir::fusion` reads from `inputs` -- every backend\n/// has a fused loop to emit. An aggregate like `length(collect(inputs))` still has no way to\n/// stream no matter which backend runs it. Public so `main.rs` can decide, before it has read\n/// anything, whether to drain real stdin itself or hand it to `run_on` untouched.\npub fn streams_inputs(program: &tir::Program) -> bool {\n    matches!(\n        tir::fusion(program),\n        Some(f) if matches!(f.source, tir::Source::Inputs)\n    )\n}\n\n/// Compile and run, capturing what the program printed -- except when `stdin` is `None` and\n/// `streams_inputs` says the backend reads `inputs` for itself, in which case the real stdin and\n/// stdout are connected straight through (`Feed::Live`) and there is nothing left to capture.\n/// Capturing otherwise keeps the tests to one call: it also means output is held in memory, which\n/// is fine for every program whose result has statically known length, and is exactly the case\n/// `Feed::Live` exists for on the ones that no longer do.\npub fn run_on(src: &str, stdin: Option<&str>, backend: Backend) -> Result<String> {\n    let program = compile(src)?;\n\n    // `stdin.is_none()` is the same convention `uses_lines` already uses below: nothing was\n    // supplied, which only happens on the real command line, never from a test fixture. Only\n    // then is there real live stdin worth handing straight to a subprocess backend rather than\n    // something already sitting in memory to validate up front.\n    let live_inputs = stdin.is_none() && streams_inputs(&program);\n    // Lua is the one backend with no subprocess of its own: `run_lua` itself decides how\n    // `inputs` reaches the running chunk, by injecting either a pre-populated global or a\n    // per-call function, and the emitted source commits to one of those two shapes purely from\n    // `tir::fusion`, independent of whether a fixture or the real command line supplied the\n    // bytes. So unlike `live_inputs` above, this also has to hold for a fixture-fed test, or\n    // the host would inject the global while the fused source calls the function.\n    let lua_fused = matches!(backend, Backend::Lua) && streams_inputs(&program);\n\n    // The input is checked against the declared type once, here, rather than by each backend.\n    // What a backend receives has already been parsed, so no backend re-decides what is valid.\n    let value = match (&program.input, stdin) {\n        (Some(ty), Some(text)) => {\n            let value: serde_json::Value = serde_json::from_str(text)?;\n            input::validate(&program.enums, &value, ty, \"input\").map_err(anyhow::Error::msg)?;\n            Some(value)\n        }\n        (Some(ty), None) => anyhow::bail!(\"this program reads input, of type {ty}\"),\n        (None, _) => None,\n    };\n\n    // `inputs` is eager like `input`, not incremental like `lines`, so it normally goes through\n    // the same validate-then-re-serialize step: every backend receives canonical bytes, one\n    // compact JSON value per line, rather than whatever formatting the original text happened to\n    // use. `live_inputs` and `lua_fused` are the exceptions -- nothing is precomputed for them,\n    // because the whole point of a fused loop is not reading the whole stream before the first\n    // record is handled. Validation still happens record-by-record on the host: `run_lua`'s\n    // `next_input` function does it for the Lua backend it is embedded in, and `Feed::LiveInputs`\n    // below does it for every other, subprocess-based backend, since generated code cannot be\n    // trusted to reimplement `input::validate` correctly in six different target languages.\n    let inputs_values = if live_inputs || lua_fused {\n        None\n    } else {\n        match (&program.inputs, stdin) {\n            (Some(elem_ty), Some(text)) => {\n                let mut values = Vec::new();\n                for line in text.lines().filter(|l| !l.trim().is_empty()) {\n                    let value: serde_json::Value = serde_json::from_str(line)?;\n                    input::validate(&program.enums, &value, elem_ty, \"inputs\")\n                        .map_err(anyhow::Error::msg)?;\n                    values.push(value);\n                }\n                Some(values)\n            }\n            (Some(elem_ty), None) => {\n                anyhow::bail!(\"this program reads inputs, of type Vec<{elem_ty}>\");\n            }\n            (None, _) => None,\n        }\n    };\n\n    // What a backend's stdin should be connected to. `input` always has known bytes: the\n    // re-serialized, already-validated value. `lines` has known bytes only when a caller (a\n    // corpus fixture, most often) supplied them directly -- and when it does, they are piped in\n    // verbatim rather than pre-split, so a backend's own splitting genuinely runs against them\n    // rather than being bypassed by the test that is supposed to exercise it. Only when nothing\n    // was supplied, which is the real command-line case, does `lines` connect the real stdin\n    // straight through, with no Rust-side buffering in between -- the one thing that would make\n    // its streaming indistinguishable from having read everything first. A live, fused `inputs`\n    // program has no type to lean on the way `lines` does (raw text is always valid `Str`), so it\n    // cannot connect the real stdin straight through: `Feed::LiveInputs` reads and validates one\n    // record at a time itself and forwards only what passes, real streaming with no read-it-all-\n    // first buffering, but through Rust rather than direct fd inheritance. The Lua backend is the\n    // one exception -- it validates through its own `next_input` function instead, direct from\n    // `Feed::Live`, since it runs embedded rather than as a subprocess with a pipe to mediate.\n    // A fused Lua program run against a fixture is not live, but still needs the raw bytes\n    // verbatim rather than the eager re-serialized form, since `run_lua`'s injected function does\n    // its own splitting the same way `lines` always has.\n    let feed = if program.uses_lines || program.dsv.is_some() {\n        match stdin {\n            Some(text) => Feed::Text(text.to_string()),\n            None => Feed::Live,\n        }\n    } else if live_inputs {\n        live_inputs_feed(&program, backend)\n    } else if lua_fused {\n        Feed::Text(stdin.map(str::to_string).unwrap_or_default())\n    } else if let Some(values) = &inputs_values {\n        Feed::Text(\n            values\n                .iter()\n                .map(|v| v.to_string())\n                .collect::<Vec<_>>()\n                .join(\"\\n\"),\n        )\n    } else {\n        Feed::Text(value.as_ref().map(|v| v.to_string()).unwrap_or_default())\n    };\n\n    match backend {\n        Backend::Lua => run_lua(\n            &emit_lua::emit(&program),\n            &program.enums,\n            value.as_ref(),\n            inputs_values.as_ref(),\n            program.inputs.as_ref(),\n            &feed,\n        ),\n        Backend::Js => run_node(&emit_js::emit(&program), &feed),\n        Backend::Jq => run_jq(\n            &emit_jq::emit(&program).map_err(anyhow::Error::msg)?,\n            JqInvocation {\n                has_value: value.is_some(),\n                raw: matches!(program.body.ty, ty::Type::Str | ty::Type::Sink),\n                uses_lines: program.uses_lines || program.dsv.is_some(),\n            },\n            &feed,\n        ),\n        Backend::Go => run_go(&emit_go::emit(&program), &feed),\n        Backend::Py => run_py(&emit_py::emit(&program), &feed),\n        Backend::Native => {\n            let dir = tempfile::tempdir()?;\n            let exe = dir.path().join(\"program\");\n            link(&program, &exe)?;\n            run_binary(&exe, &feed)\n        }\n        Backend::Rust => {\n            let dir = tempfile::tempdir()?;\n            let exe = dir.path().join(\"program\");\n            link_rust(&emit_rs::emit(&program), &exe)?;\n            run_binary(&exe, &feed)\n        }\n    }\n}\n\n/// The feed for a live, fused `inputs` program: real stdin, but validated. Lua is the exception,\n/// since `run_lua`'s own `next_input` function validates directly off `Feed::Live` rather than\n/// needing `Feed::LiveInputs` to mediate a pipe it has no subprocess to write into.\nfn live_inputs_feed(program: &Program, backend: Backend) -> Feed {\n    if matches!(backend, Backend::Lua) {\n        Feed::Live\n    } else {\n        Feed::LiveInputs(\n            program\n                .inputs\n                .clone()\n                .expect(\"live_inputs implies an inputs type\"),\n            program.enums.clone(),\n        )\n    }\n}\n\n/// What a subprocess backend's stdin is connected to.\nenum Feed {\n    /// Known bytes, written through a pipe: `input`'s re-serialized value, a `lines` program's\n    /// fixture text verbatim, or nothing for a program that reads no stdin at all.\n    Text(String),\n    /// The real process stdin, inherited rather than piped. Reachable only for a `lines`\n    /// program run with no fixture supplied.\n    Live,\n    /// The real process stdin, read and validated one record at a time against the element type,\n    /// then forwarded through a pipe -- real streaming, but mediated by the host rather than\n    /// inherited directly, which is what lets `input::validate` see every record before a\n    /// subprocess backend's own, untrusted parse of it does. Reachable only for a live, fused\n    /// `inputs` program on a backend other than Lua (see `write_to`).\n    LiveInputs(ty::Type, ty::Enums),\n}\n\nimpl Feed {\n    fn stdio(&self) -> std::process::Stdio {\n        match self {\n            Feed::Text(_) | Feed::LiveInputs(..) => std::process::Stdio::piped(),\n            Feed::Live => std::process::Stdio::inherit(),\n        }\n    }\n\n    fn write_to(&self, child: &mut std::process::Child) -> Result<()> {\n        match self {\n            Feed::Text(text) => {\n                child\n                    .stdin\n                    .take()\n                    .expect(\"piped\")\n                    .write_all(text.as_bytes())?;\n            }\n            Feed::Live => {}\n            Feed::LiveInputs(elem_ty, enums) => {\n                let mut stdin = child.stdin.take().expect(\"piped\");\n                for line in std::io::stdin().lock().lines() {\n                    let line = line?;\n                    if line.trim().is_empty() {\n                        continue;\n                    }\n                    let value: serde_json::Value = serde_json::from_str(&line)?;\n                    if let Err(msg) = input::validate(enums, &value, elem_ty, \"inputs\") {\n                        // Close the pipe so the child sees EOF and can finish printing whatever\n                        // it already validly received, then wait for it before reporting the\n                        // refusal -- otherwise this leaves an unreaped child behind.\n                        drop(stdin);\n                        child.wait()?;\n                        return Err(anyhow::Error::msg(msg));\n                    }\n                    writeln!(stdin, \"{line}\")?;\n                }\n            }\n        }\n        Ok(())\n    }\n}\n\n/// Compile to a native executable at `out`.\n///\n/// LLVM produces an object file, which is not a program, so this shells out to `cc` for the\n/// link. That is a toolchain requirement the Lua backend does not have, since mlua vendors its\n/// interpreter.\npub fn link(program: &Program, out: &std::path::Path) -> Result<()> {\n    let dir = tempfile::tempdir()?;\n    let object = dir.path().join(\"program.o\");\n    emit_llvm::compile_to_object(program, &object).map_err(anyhow::Error::msg)?;\n\n    // The runtime is compiled alongside rather than shipped as a library, which keeps the build\n    // to one `cc` call and means there is nothing to install.\n    let runtime = dir.path().join(\"toylang.c\");\n    std::fs::write(&runtime, emit_llvm::RUNTIME_C)?;\n\n    let status = std::process::Command::new(\"cc\")\n        .arg(&object)\n        .arg(&runtime)\n        .arg(\"-o\")\n        .arg(out)\n        .status()\n        .context(\"could not run `cc`\")?;\n    if !status.success() {\n        anyhow::bail!(\"cc failed to link: {status}\");\n    }\n    Ok(())\n}\n\n/// Compile Rust source to an executable at `out`. One `rustc` call on one self-contained file,\n/// no external crate and no Cargo project, the same reason `link` above is one `cc` call: the\n/// generated source depends on nothing this compiler did not already assume was installed.\n/// Public for the same reason as `link`: `tests/backend_rust.rs` calls it directly, separately\n/// from running the result, so a genuine codegen gap (`rustc` rejects the source) is told apart\n/// from a legitimate runtime refusal (`rustc` succeeds, the binary exits non-zero).\npub fn link_rust(source: &str, out: &std::path::Path) -> Result<()> {\n    let dir = tempfile::tempdir()?;\n    let src = dir.path().join(\"program.rs\");\n    std::fs::write(&src, source)?;\n\n    let result = std::process::Command::new(\"rustc\")\n        .arg(\"--edition\")\n        .arg(\"2021\")\n        .arg(&src)\n        .arg(\"-o\")\n        .arg(out)\n        .output()\n        .context(\"could not run `rustc`\")?;\n    if !result.status.success() {\n        anyhow::bail!(\n            \"rustc failed to compile: {}\",\n            String::from_utf8_lossy(&result.stderr)\n        );\n    }\n    Ok(())\n}\n\n/// Runs `cmd` (already given whatever args the caller needs) connected to `feed`, and returns\n/// what it printed.\n///\n/// When `feed` is `Feed::Live` or `Feed::LiveInputs` there is no test harness reading the result\n/// back: stdout and stderr are inherited straight through to the real terminal or pipe instead of\n/// being captured, which is what lets a program that streams actually show output as it produces\n/// it rather than all at once when it exits. `Ok(String::new())` reflects that nothing is left to\n/// hand back -- it already went to the real stdout directly. `feed.write_to` reports a validation\n/// refusal for `Feed::LiveInputs` as an `Err` before this function's own `child.wait()` runs, so\n/// that path never reaches here at all.\nfn run_subprocess(mut cmd: std::process::Command, label: &str, feed: &Feed) -> Result<String> {\n    let live = matches!(feed, Feed::Live | Feed::LiveInputs(..));\n    let mut child = cmd\n        .stdin(feed.stdio())\n        .stdout(if live {\n            std::process::Stdio::inherit()\n        } else {\n            std::process::Stdio::piped()\n        })\n        .stderr(if live {\n            std::process::Stdio::inherit()\n        } else {\n            std::process::Stdio::piped()\n        })\n        .spawn()\n        .with_context(|| format!(\"could not run `{label}`\"))?;\n\n    feed.write_to(&mut child)?;\n\n    if live {\n        let status = child.wait()?;\n        if !status.success() {\n            anyhow::bail!(\"{label} failed\");\n        }\n        return Ok(String::new());\n    }\n\n    let out = child.wait_with_output()?;\n    if !out.status.success() {\n        anyhow::bail!(\"{label} failed: {}\", String::from_utf8_lossy(&out.stderr));\n    }\n    Ok(String::from_utf8(out.stdout)?)\n}\n\nfn run_binary(exe: &std::path::Path, feed: &Feed) -> Result<String> {\n    run_subprocess(\n        std::process::Command::new(exe),\n        \"the compiled program\",\n        feed,\n    )\n}\n\n/// jq puts stdin in `.`, so a program that reads no input runs with `-n` rather than waiting on\n/// a terminal. `has_value` rather than the `Feed` itself, since a `lines` program run live\n/// (`Feed::Live`) still has real stdin coming and must not get `-n` on that account.\n/// The three facts about a program that shape a jq invocation's flags. Each is derived from\n/// the compiled program, not a caller identity -- the fn-params-excessive-bools finding on the\n/// old three-bool signature was escalated, and the settled answer was this struct: the facts\n/// travel under their names.\nstruct JqInvocation {\n    has_value: bool,\n    raw: bool,\n    uses_lines: bool,\n}\n\nfn run_jq(source: &str, inv: JqInvocation, feed: &Feed) -> Result<String> {\n    let JqInvocation {\n        has_value,\n        raw,\n        uses_lines,\n    } = inv;\n    let mut cmd = std::process::Command::new(\"jq\");\n    // jq's stdout is fully buffered rather than line-buffered whenever it is not a terminal, the\n    // same as any other libc stdio program, so a filter over `inputs` piped into another process\n    // would otherwise sit on every result until the run ends. `run_subprocess` only inherits\n    // stdout instead of capturing it for a live run, so this is still what makes that case show a\n    // result as soon as jq produces one rather than at exit.\n    cmd.arg(\"--unbuffered\");\n    cmd.arg(\"-c\");\n    // `-r` decides from the runtime value, so it would print a present Opt<Str> raw and an\n    // absent one as the word null. The rule here is the type's, as on every other backend.\n    if raw {\n        cmd.arg(\"-r\");\n    }\n    if !has_value && !uses_lines {\n        cmd.arg(\"-n\");\n    }\n    // Raw-input mode, needed for `[ inputs ]` to read lines rather than JSON, and forced by the\n    // checker to be the only way `lines` is used in this invocation: mixing it with `input` was\n    // rejected there, because `-R` changes what the whole invocation means, not just one call.\n    // `-n` here is not \"no input coming\"; it is what raw-input mode needs regardless, since\n    // `[ inputs ]` reads for itself rather than through the implicit `.` a normal run would use.\n    if uses_lines {\n        cmd.arg(\"-R\").arg(\"-n\");\n    }\n    cmd.arg(source);\n    run_subprocess(cmd, \"jq\", feed)\n}\n\nfn run_lua(\n    source: &str,\n    enums: &ty::Enums,\n    value: Option<&serde_json::Value>,\n    inputs_values: Option<&Vec<serde_json::Value>>,\n    inputs_elem_ty: Option<&ty::Type>,\n    feed: &Feed,\n) -> Result<String> {\n    let lua = mlua::Lua::new();\n    if let Some(value) = value {\n        lua.globals()\n            .set(emit_lua::INPUT, input::to_lua(&lua, value)?)?;\n    }\n    if let Some(values) = inputs_values {\n        let array = serde_json::Value::Array(values.clone());\n        lua.globals()\n            .set(emit_lua::INPUTS, input::to_lua(&lua, &array)?)?;\n    } else if let Some(elem_ty) = inputs_elem_ty {\n        // `inputs_values` is `None` here for one of two reasons: the program does not read\n        // `inputs` at all (then `inputs_elem_ty` is also `None`, and neither branch runs), or\n        // `run_on` recognized this as a fused program and skipped precomputing the whole Vec on\n        // purpose (`live_inputs` or `lua_fused` there). mlua is embedded in this same process, so\n        // there is no separate JSON parser to write in Lua source the way Rust's own is -- the\n        // generated source just calls this function for the next already-validated, already-\n        // converted record. Reading from `feed` rather than always the real stdin is what keeps\n        // this correct for a fixture-tested fused program too: `feed` is `Feed::Text` there, the\n        // same raw bytes a subprocess backend would have been piped.\n        let elem_ty = elem_ty.clone();\n        let enums = enums.clone();\n        let reader: RefCell<Box<dyn std::io::BufRead>> = RefCell::new(match feed {\n            Feed::Live => Box::new(std::io::BufReader::new(std::io::stdin())),\n            Feed::Text(text) => Box::new(std::io::Cursor::new(text.clone().into_bytes())),\n            // `run_on` never builds this feed for the Lua backend: `live_inputs` there stays\n            // `Feed::Live`, since this function's own reader validates each record itself.\n            Feed::LiveInputs(..) => unreachable!(\"run_on keeps the Lua backend on Feed::Live\"),\n        });\n        let next_input = lua.create_function(move |lua, ()| {\n            use std::io::BufRead;\n            loop {\n                let mut line = String::new();\n                let n = reader\n                    .borrow_mut()\n                    .read_line(&mut line)\n                    .map_err(mlua::Error::external)?;\n                if n == 0 {\n                    return Ok(mlua::Value::Nil);\n                }\n                let line = line.strip_suffix('\\n').unwrap_or(&line);\n                if line.trim().is_empty() {\n                    continue;\n                }\n                let value: serde_json::Value =\n                    serde_json::from_str(line).map_err(mlua::Error::external)?;\n                input::validate(&enums, &value, &elem_ty, \"inputs\")\n                    .map_err(mlua::Error::RuntimeError)?;\n                return input::to_lua(lua, &value);\n            }\n        })?;\n        lua.globals().set(emit_lua::NEXT_INPUT, next_input)?;\n    }\n    // mlua is embedded in this same process, so `io.lines()` in the emitted source reads the\n    // real stdin directly -- verified against a live pipe, and exactly what a `lines` program\n    // run for real should do. A fixture is different: cargo test runs many tests concurrently\n    // in one process, so redirecting the process's own fd 0 would race with all of them, and is\n    // not done. Instead the fixture is written to a file of its own and `io.lines` is pointed at\n    // it, which keeps Lua's own real line-splitting in the loop rather than reimplementing it in\n    // Rust and only testing that reimplementation.\n    let _fixture_dir;\n    if let Feed::Text(text) = feed {\n        let dir = tempfile::tempdir()?;\n        let path = dir.path().join(\"stdin.txt\");\n        std::fs::write(&path, text)?;\n        let path = path\n            .to_str()\n            .expect(\"a temp path is valid UTF-8\")\n            .to_string();\n        let io: mlua::Table = lua.globals().get(\"io\")?;\n        let real_lines: mlua::Function = io.get(\"lines\")?;\n        let fixture =\n            lua.create_function(move |_, ()| real_lines.call::<mlua::Value>(path.clone()))?;\n        io.set(\"lines\", fixture)?;\n        _fixture_dir = Some(dir);\n    }\n\n    // A live run has no test harness reading the result back, the same distinction\n    // `run_subprocess` makes for the OS-process backends: `print` writes straight to the real\n    // stdout and flushes per call instead of buffering into a string only handed back once the\n    // whole chunk finishes.\n    let live = matches!(feed, Feed::Live);\n    let captured = Rc::new(RefCell::new(String::new()));\n    let sink = Rc::clone(&captured);\n    let print = lua.create_function(move |_, s: String| {\n        if live {\n            let mut stdout = std::io::stdout();\n            writeln!(stdout, \"{s}\").map_err(mlua::Error::external)?;\n            stdout.flush().map_err(mlua::Error::external)?;\n        } else {\n            sink.borrow_mut().push_str(&s);\n            sink.borrow_mut().push('\\n');\n        }\n        Ok(())\n    })?;\n    lua.globals().set(\"print\", print)?;\n\n    lua.load(source).exec()?;\n\n    if live {\n        return Ok(String::new());\n    }\n    let out = captured.borrow().clone();\n    Ok(out)\n}\n\n/// Runs through `python3`. Like `node`, this is an interpreter that has to be on the machine\n/// rather than one vendored into the build.\nfn run_py(source: &str, feed: &Feed) -> Result<String> {\n    let dir = tempfile::tempdir()?;\n    let path = dir.path().join(\"program.py\");\n    std::fs::write(&path, source)?;\n\n    let mut cmd = std::process::Command::new(\"python3\");\n    cmd.arg(&path);\n    run_subprocess(cmd, \"python3\", feed)\n}\n\n/// Runs through `go run`, which compiles and executes in one step. Go has no interpreter, so\n/// this is the second backend that needs a real toolchain; like `node` and `cc`, a missing one\n/// is an error rather than a skipped backend.\nfn run_go(source: &str, feed: &Feed) -> Result<String> {\n    let dir = tempfile::tempdir()?;\n    let path = dir.path().join(\"main.go\");\n    std::fs::write(&path, source)?;\n\n    let mut cmd = std::process::Command::new(\"go\");\n    cmd.arg(\"run\").arg(&path);\n    run_subprocess(cmd, \"go\", feed)\n}\n\n/// Runs through `node`, which must be present. A missing toolchain is an error rather than a\n/// quietly skipped backend: a report that says two backends agreed when only one ran is worse\n/// than no report.\nfn run_node(source: &str, feed: &Feed) -> Result<String> {\n    let dir = tempfile::tempdir()?;\n    let path = dir.path().join(\"program.js\");\n    std::fs::write(&path, source)?;\n\n    let mut cmd = std::process::Command::new(\"node\");\n    cmd.arg(&path);\n    run_subprocess(cmd, \"node\", feed)\n}\n\nimpl std::error::Error for Error {}","lineStart":1,"lineEnd":639,"totalLines":639,"truncated":false}},"title":"src/lib.rs","time":{"start":1788460341563,"end":1788460341577}},"id":"prt_0688b1875001gJwrFcjEbhCqXG","sessionID":"ses_f977bc931ffe9OHrIOJvOWQPwa","messageID":"msg_06889e4aa001PN9H5BeRI2B1WN"}}
