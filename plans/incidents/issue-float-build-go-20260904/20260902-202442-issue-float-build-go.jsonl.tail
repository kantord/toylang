              return \"\\\"{}\\\"\".to_string();\n1348:                 }\n1349:                 // The type's field list is declaration order, so this prints as declared.\n1350:                 // Field names are identifiers, so the JSON key needs no escaping and is one\n1351:                 // literal.\n1352:                 let parts: Vec<String> = fields\n1353:                     .iter()\n1354:                     .map(|(name, fty)| {\n1355:                         let read = format!(\"({value}).F{name}\");\n1356:                         let key = go_string(&format!(\"\\\"{name}\\\":\"));\n1357:                         format!(\"{key} + {}\", self.show(fty, &read, depth + 1))\n1358:                     })\n1359:                     .collect();\n1360:                 format!(\"(\\\"{{\\\" + {} + \\\"}}\\\")\", parts.join(\" + \\\",\\\" + \"))\n1361:             }\n1362:         }\n1363:     }\n1364: \n1365:     /// A named printer for every recursive enum the program prints. The call in `show` is what a\n1366:     /// nested occurrence renders as, so the recursion in the type becomes recursion in the\n1367:     /// emitted function rather than in this compiler (kantord/toylang#94).\n1368:     fn printers(&self, program: &Program) -> String {\n1369:         let mut out = String::new();\n1370:         for ty in tir::printed_recursive_enums(program) {\n1371:             out.push_str(&format!(\n1372:                 \"func {}(v {}) string {{\\n\\treturn {}\\n}}\\n\\n\",\n1373:                 show_fn(&ty),\n1374:                 self.go_type(&ty),\n1375:                 self.show_enum(&ty, \"v\", 0)\n1376:             ));\n1377:         }\n1378:         out\n1379:     }\n1380: \n1381:     /// The printer for one enum, inline. The tag says which of the two JSON shapes (ADR 0009)\n1382:     /// this value is: a unit variant renders as its quoted name, a payload variant as the\n1383:     /// single-key wrapper. The last variant needs no test, since the type says nothi