i = 0; i < v.length; i++) acc = (acc + v[i]) | 0;\n+  return acc;\n+}\n+function tl_sum64(v) {\n+  let acc = 0n;\n+  for (let i = 0; i < v.length; i++) acc = BigInt.asIntN(64, acc + v[i]);\n+  return acc;\n+}\n+\";\n+\n+// `>` orders Number and BigInt alike, so one maximum serves both widths.\n+const MAX_HELPER: &str = \"\\\n+function tl_max(v) {\n+  if (v.length === 0) return \\\"none\\\";\n+  let m = v[0];\n+  for (let i = 1; i < v.length; i++) if (v[i] > m) m = v[i];\n+  return { some: m };\n+}\n+\";\n+\n pub fn emit(program: &Program) -> String {\n     let enums = &program.enums;\n     let mut out = String::new();\n \n","additions":26,"deletions":0},"truncated":false},"title":"src/emit_js.rs","time":{"start":1788119718149,"end":1788119718150}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_0543d871b0018LjZ6cJnzodKDK","sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","messageID":"msg_0543d7fcc001MXOTkHcyFBbf78"}}
