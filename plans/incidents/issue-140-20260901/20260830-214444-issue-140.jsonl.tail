ontains_key(&def.name) {\n            return Err(Error::new(\n                def.span,\n                format!(\"`{}` is defined twice\", def.name),\n            ));\n        }\n        let sig = Sig {\n            param: match &def.param {\n                Some(param) => Some(resolve(&param.ty, env, &mut Vec::new())?),\n                None => None,\n            },\n            ret: resolve(&def.ret, env, &mut Vec::new())?,\n        };\n        // A stream is born only at a source, so a function cannot conjure one: a stream result","lineStart":190,"lineEnd":229,"totalLines":459,"truncated":true}},"title":"src/check/types.rs","time":{"start":1788120295977,"end":1788120295984}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_054466952001cxdvgNJ5nv6wDz","sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","messageID":"msg_054465c69001538XdeubwJlp5Y"}}
