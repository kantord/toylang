{"type":"tool_use","timestamp":1788120338970,"sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-a6fa42700ad5f2eb","state":{"status":"completed","input":{"content":"# The result keeps the element width: `sum` of a Vec<Int64> is an Int64, and the small values\n# here stay within jq's 2^53 exactness so every backend agrees.\nprogram: |\n  fn wide(x: Int) -> Int64 = i64(x)\n\n  sum([wide(3), wide(1), wide(2)])\n\noutput: |\n  6\n\nnode_types: [application, builtin.i64, builtin.sum, int, var, vec-literal]\n","filePath":"/home/kantord/.local/share/toylang-lanes/issue-140/tests/corpus/sum_int64s.yaml"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/kantord/.local/share/toylang-lanes/issue-140/tests/corpus/sum_int64s.yaml","exists":false,"truncated":false},"title":"tests/corpus/sum_int64s.yaml","time":{"start":1788120338962,"end":1788120338968}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_054470c69001Wjvt39To3JbTqw","sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","messageID":"msg_05446fe3f001TRzVF0I1sEkKID"}}
{"type":"step_finish","timestamp":1788120338992,"sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","part":{"id":"prt_05447122c001362W0zUkiJ6hdP","reason":"tool-calls","snapshot":"f1bcef074377ed3275bed135ce2656bdcb0871c1","messageID":"msg_05446fe3f001TRzVF0I1sEkKID","sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","type":"step-finish","tokens":{"total":196367,"input":331,"output":196,"reasoning":0,"cache":{"write":0,"read":195840}},"cost":0.003190235}}
{"type":"step_start","timestamp":1788120341947,"sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","part":{"id":"prt_054471db8001i1ew8JkZxbvWns","messageID":"msg_054471254001k5hjMxv4d0uzN5","sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","snapshot":"f1bcef074377ed3275bed135ce2656bdcb0871c1","type":"step-start"}}
{"type":"tool_use","timestamp":1788120345643,"sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-ae718d6f49db9efd","state":{"status":"completed","input":{"content":"# The empty Vec has a 0 sum rather than an Opt -- no absence to represent, so `sum` is total\n# where `max` is not. The empty Vec<Int> comes from a declared return type, since a bare `[]`\n# literal cannot be typed.\nprogram: |\n  fn nothing() -> Vec<Int> = []\n\n  sum(nothing())\n\noutput: |\n  0\n\nnode_types: [application, builtin.sum, vec-literal]\n","filePath":"/home/kantord/.local/share/toylang-lanes/issue-140/tests/corpus/sum_empty.yaml"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/kantord/.local/share/toylang-lanes/issue-140/tests/corpus/sum_empty.yaml","exists":false,"truncated":false},"title":"tests/corpus/sum_empty.yaml","time":{"start":1788120345637,"end":1788120345641}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_054471dba001QhBqvZPL9hNxhc","sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","messageID":"msg_054471254001k5hjMxv4d0uzN5"}}
{"type":"step_finish","timestamp":1788120345658,"sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","part":{"id":"prt_054472c38001HDW1lDdoGGBIk8","reason":"tool-calls","snapshot":"721c24bae52e1a00ba252359de1ca5bc4b02d3c2","messageID":"msg_054471254001k5hjMxv4d0uzN5","sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","type":"step-finish","tokens":{"total":196565,"input":286,"output":183,"reasoning":0,"cache":{"write":0,"read":196096}},"cost":0.003189066}}
{"type":"step_start","timestamp":1788120368001,"sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","part":{"id":"prt_05447837b001XyWJgqhgJ3JEPL","messageID":"msg_054472c4b001bsUvx6Rf4UPCzv","sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","snapshot":"721c24bae52e1a00ba252359de1ca5bc4b02d3c2","type":"step-start"}}
{"type":"tool_use","timestamp":1788120372904,"sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","part":{"type":"tool","tool":"write","callID":"chatcmpl-tool-941b7badb0e78105","state":{"status":"completed","input":{"content":"# A sum that leaves the 32-bit width wraps per addition, the way `+` does: `2147483647 + 1`\n# is `-2147483648`, not 2147483648. Every backend has to agree on the wrapped answer, which is\n# the case a fold that widened first would fail.\nprogram: |\n  sum([2147483647, 1])\n\noutput: |\n  -2147483648\n\nnode_types: [builtin.sum, int, vec-literal]\n","filePath":"/home/kantord/.local/share/toylang-lanes/issue-140/tests/corpus/sum_wrap.yaml"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/home/kantord/.local/share/toylang-lanes/issue-140/tests/corpus/sum_wrap.yaml","exists":false,"truncated":false},"title":"tests/corpus/sum_wrap.yaml","time":{"start":1788120372900,"end":1788120372902}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05447837e001UplLE8g0hLs5oU","sessionID":"ses_fabcc0d67ffe81ceFkgf1oLPKJ","messageID":"msg_054472c4b001bsUvx6Rf4UPCzv"}}
