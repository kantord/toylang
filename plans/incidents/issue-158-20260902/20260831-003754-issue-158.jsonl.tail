{"type":"tool_use","timestamp":1788130598808,"sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-9124d207a316e9a4","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-158/tests/docs.rs","limit":40,"offset":170},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-158/tests/docs.rs</path>\n<type>file</type>\n<content>\n170:                 backend.name()\n171:             ));\n172:         }\n173:     }\n174:     failures\n175: }\n176: \n177: /// The reference is complete for everything implemented, checkably: a builtin without a page\n178: /// fails here, the same way a corpus case without fresh tags fails tag_corpus.\n179: #[test]\n180: fn every_builtin_has_a_reference_page() {\n181:     let missing: Vec<&str> = toylang::check::BUILTIN_NAMES\n182:         .into_iter()\n183:         .filter(|name| {\n184:             !docs_dir()\n185:                 .join(\"reference/builtins\")\n186:                 .join(format!(\"{name}.md\"))\n187:                 .is_file()\n188:         })\n189:         .collect();\n190:     assert!(\n191:         missing.is_empty(),\n192:         \"builtins without a reference page under docs/reference/builtins/: {}\",\n193:         missing.join(\", \")\n194:     );\n195: }\n196: \n197: fn repo_root() -> PathBuf {\n198:     Path::new(env!(\"CARGO_MANIFEST_DIR\")).to_path_buf()\n199: }\n200: \n201: fn docs_dir() -> PathBuf {\n202:     repo_root().join(\"docs\")\n203: }\n204: \n205: /// Every markdown page under `docs/`, as (path relative to the repo, content), sorted so\n206: /// failures come out in a stable order.\n207: fn pages() -> Vec<(String, String)> {\n208:     let mut paths = Vec::new();\n209:     walk(&docs_dir(), &mut paths);\n\n(Showing lines 170-209 of 328. Use offset=210 to continue.)\n</content>","metadata":{"preview":"                backend.name()\n            ));\n        }\n    }\n    failures\n}\n\n/// The reference is complete for everything implemented, checkably: a builtin without a page\n/// fails here, the same way a corpus case without fresh tags fails tag_corpus.\n#[test]\nfn every_builtin_has_a_reference_page() {\n    let missing: Vec<&str> = toylang::check::BUILTIN_NAMES\n        .into_iter()\n        .filter(|name| {\n            !docs_dir()\n                .join(\"reference/builtins\")\n                .join(format!(\"{name}.md\"))\n                .is_file()\n        })\n        .collect();","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-158/tests/docs.rs","text":"                backend.name()\n            ));\n        }\n    }\n    failures\n}\n\n/// The reference is complete for everything implemented, checkably: a builtin without a page\n/// fails here, the same way a corpus case without fresh tags fails tag_corpus.\n#[test]\nfn every_builtin_has_a_reference_page() {\n    let missing: Vec<&str> = toylang::check::BUILTIN_NAMES\n        .into_iter()\n        .filter(|name| {\n            !docs_dir()\n                .join(\"reference/builtins\")\n                .join(format!(\"{name}.md\"))\n                .is_file()\n        })\n        .collect();\n    assert!(\n        missing.is_empty(),\n        \"builtins without a reference page under docs/reference/builtins/: {}\",\n        missing.join(\", \")\n    );\n}\n\nfn repo_root() -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\")).to_path_buf()\n}\n\nfn docs_dir() -> PathBuf {\n    repo_root().join(\"docs\")\n}\n\n/// Every markdown page under `docs/`, as (path relative to the repo, content), sorted so\n/// failures come out in a stable order.\nfn pages() -> Vec<(String, String)> {\n    let mut paths = Vec::new();\n    walk(&docs_dir(), &mut paths);","lineStart":170,"lineEnd":209,"totalLines":328,"truncated":true}},"title":"tests/docs.rs","time":{"start":1788130598800,"end":1788130598807}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Baseline is green: 311 tests passed. Now let me read the remaining files I need:\n1. tests/docs.rs builtin page requirement (lines 177-195)\n2. jsonlines.md reference page (to model pipe_through.md)\n3. The linearity module\n4. How BUILTIN_NAMES guards redefinition\n5. tests/corpus.rs node_types mechanism (tag_corpus.rs)\n6. One corpus yaml for format\n7. check/types.rs signatures (to see if builtin names are excluded from fn definitions)\n\nLet me batch reads.","format":"unknown","index":0}]}},"id":"prt_054e39dd1001OQYM7kxTvKipZH","sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","messageID":"msg_054e38186001iv4fpGA5F7bq6I"}}
{"type":"tool_use","timestamp":1788130599910,"sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-8d0d1054224b52b8","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-158/docs/reference/builtins/jsonlines.md"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-158/docs/reference/builtins/jsonlines.md</path>\n<type>file</type>\n<content>\n1: # jsonlines\n2: \n3: `jsonlines(v)`: prints each entry as JSON on its own line, instead of wrapping the whole\n4: thing in `[...]`. Named for the format (jsonlines.org, also called NDJSON). It takes a\n5: `Vec<T>` or a `Stream<T>`, and it is a sink: legal only as the program's outermost\n6: expression, writing as it goes, with no result type, since nothing remains that could\n7: observe one.\n8: \n9: ```toylang\n10: jsonlines([\"ada\", \"bo\", \"cy\"])\n11: ```\n12: \n13: ```output\n14: \"ada\"\n15: \"bo\"\n16: \"cy\"\n17: ```\n18: \n19: Each entry is rendered as JSON, which is why the strings above are quoted where a top-level\n20: `Str` result would print raw.\n21: \n22: Over a stream, `jsonlines` is what makes a program incremental end to end: a\n23: read-one, transform-one, write-one loop that prints each line before the next is read,\n24: rather than holding stdin in memory. The corpus case pins the value; `tests/streaming.rs` is\n25: what proves output arrives before stdin closes.\n26: \n27: ```case\n28: jsonlines_of_inputs\n29: ```\n30: \n31: Because a sink has no result, `jsonlines` cannot appear inside a larger expression:\n32: \n33: ```toylang\n34: length(jsonlines([1, 2]))\n35: ```\n36: \n37: ```error\n38: `jsonlines` is a sink, legal only as the program's outermost expression (at byte 7)\n39: ```\n\n(End of file - total 39 lines)\n</content>","metadata":{"preview":"# jsonlines\n\n`jsonlines(v)`: prints each entry as JSON on its own line, instead of wrapping the whole\nthing in `[...]`. Named for the format (jsonlines.org, also called NDJSON). It takes a\n`Vec<T>` or a `Stream<T>`, and it is a sink: legal only as the program's outermost\nexpression, writing as it goes, with no result type, since nothing remains that could\nobserve one.\n\n```toylang\njsonlines([\"ada\", \"bo\", \"cy\"])\n```\n\n```output\n\"ada\"\n\"bo\"\n\"cy\"\n```\n\nEach entry is rendered as JSON, which is why the strings above are quoted where a top-level\n`Str` result would print raw.","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-158/docs/reference/builtins/jsonlines.md","text":"# jsonlines\n\n`jsonlines(v)`: prints each entry as JSON on its own line, instead of wrapping the whole\nthing in `[...]`. Named for the format (jsonlines.org, also called NDJSON). It takes a\n`Vec<T>` or a `Stream<T>`, and it is a sink: legal only as the program's outermost\nexpression, writing as it goes, with no result type, since nothing remains that could\nobserve one.\n\n```toylang\njsonlines([\"ada\", \"bo\", \"cy\"])\n```\n\n```output\n\"ada\"\n\"bo\"\n\"cy\"\n```\n\nEach entry is rendered as JSON, which is why the strings above are quoted where a top-level\n`Str` result would print raw.\n\nOver a stream, `jsonlines` is what makes a program incremental end to end: a\nread-one, transform-one, write-one loop that prints each line before the next is read,\nrather than holding stdin in memory. The corpus case pins the value; `tests/streaming.rs` is\nwhat proves output arrives before stdin closes.\n\n```case\njsonlines_of_inputs\n```\n\nBecause a sink has no result, `jsonlines` cannot appear inside a larger expression:\n\n```toylang\nlength(jsonlines([1, 2]))\n```\n\n```error\n`jsonlines` is a sink, legal only as the program's outermost expression (at byte 7)\n```","lineStart":1,"lineEnd":39,"totalLines":39,"truncated":false}},"title":"docs/reference/builtins/jsonlines.md","time":{"start":1788130599905,"end":1788130599909}},"id":"prt_054e39f92001jwKbVMZ56Pj4su","sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","messageID":"msg_054e38186001iv4fpGA5F7bq6I"}}
{"type":"text","timestamp":1788130599953,"sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","part":{"id":"prt_054e39cbe001J6jpyj4BPW7UGd","messageID":"msg_054e38186001iv4fpGA5F7bq6I","sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","type":"text","text":"Baseline green (311 passed). Let me read the remaining pieces I need for the checker and docs work.\n\n","time":{"start":1788130598078,"end":1788130599951}}}
{"type":"tool_use","timestamp":1788130599962,"sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-b801864be1c5c4fb","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-158/src/check/linearity.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-158/src/check/linearity.rs</path>\n<type>file</type>\n<content>\n1: //! Two passes that walk an already-built `Tir` and never touch `Expr` or type resolution: stream\n2: //! linearity (every stream-typed binding consumed exactly once) and dead-code pruning (which\n3: //! functions the program body can actually reach).\n4: \n5: use crate::ast::Span;\n6: use crate::error::Error;\n7: use crate::tir::{self, Kind, LocalId, Tir};\n8: \n9: /// What a linearity count is looking for: a stream-typed binding, named either by the source\n10: /// (a function parameter) or by the checker (the local a `|` binds `.` to).\n11: pub(super) enum StreamBinding<'a> {\n12:     Param(&'a str),\n13:     Local(LocalId),\n14: }\n15: \n16: /// What broke the exactly-once rule, when a plain count cannot say it.\n17: enum LinearViolation {\n18:     /// A conditional's or match's paths disagree on how often they consume the binding.\n19:     Branches { first: usize, second: usize },\n20:     /// The binding is consumed inside a mapper's body, which runs once per element -- one\n21:     /// spelled consumption, many runtime ones.\n22:     InMapper,\n23: }\n24: \n25: /// How many times `t` consumes `binding`, counted along one evaluation path: a conditional\n26: /// runs one branch, so its branches must agree with each other rather than being summed, and\n27: /// a match's arms likewise. A mapper's body runs once per element, so any consumption there\n28: /// is its own violation rather than a count.\n29: fn stream_uses(t: &Tir, binding: &StreamBinding) -> Result<usize, LinearViolation> {\n30:     let both = |a: &Tir, b: &Tir| Ok(stream_uses(a, binding)? + stream_uses(b, binding)?);\n31:     match &t.kind {\n32:         Kind::Var(name) => Ok(match binding {\n33:             StreamBinding::Param(p) => (p == name) as usize,\n34:             StreamBinding::Local(_) => 0,\n35:         }),\n36:         Kind::Local(id) => Ok(match binding {\n37:             StreamBinding::Local(l) => (l == id) as usize,\n38:             StreamBinding::Param(_) => 0,\n39:         }),\n40:         Kind::Str(_) | Kind::Int(_) | Kind::Input | Kind::Inputs | Kind::Lines => Ok(0),\n41:         Kind::VecLit(items) => items\n42:             .iter()\n43:             .try_fold(0, |n, i| Ok(n + stream_uses(i, binding)?)),\n44:         Kind::RecordLit { fields } => fields\n45:             .iter()\n46:             .try_fold(0, |n, (_, v)| Ok(n + stream_uses(v, binding)?)),\n47:         Kind::EnumLit { payload, .. } => payload\n48:             .as_deref()\n49:             .map_or(Ok(0), |p| stream_uses(p, binding)),\n50:         Kind::Call { arg, .. } => arg.as_deref().map_or(Ok(0), |a| stream_uses(a, binding)),\n51:         Kind::Builtin { arg, .. } => stream_uses(arg, binding),\n52:         Kind::Concat(l, r) => both(l, r),\n53:         Kind::Arith { lhs, rhs, .. } | Kind::Compare { lhs, rhs, .. } => both(lhs, rhs),\n54:         // Summed rather than reconciled the way a conditional's branches are: `and`/`or` may\n55:         // skip their right side, so a binding consumed on both sides is consumed once or twice\n56:         // depending on the left operand's value, and \"sometimes twice\" is exactly what the\n57:         // exactly-once rule refuses.\n58:         Kind::Logic { lhs, rhs, .. } => both(lhs, rhs),\n59:         Kind::Not(base) => stream_uses(base, binding),\n60:         Kind::Bind { value, body, .. } => both(value, body),\n61:         Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n62:             if stream_uses(body, binding)? > 0 {\n63:                 return Err(LinearViolation::InMapper);\n64:             }\n65:             stream_uses(source, binding)\n66:         }\n67:         Kind::Select { source, pred, .. } => {\n68:             if stream_uses(pred, binding)? > 0 {\n69:                 return Err(LinearViolation::InMapper);\n70:             }\n71:             stream_uses(source, binding)\n72:         }\n73:         Kind::Field { base, .. } | Kind::Unwrap { base } => stream_uses(base, binding),\n74:         Kind::Index { base, index, .. } => both(base, index),\n75:         Kind::Cond {\n76:             cond,\n77:             then,\n78:             otherwise,\n79:         } => {\n80:             let t = stream_uses(then, binding)?;\n81:             let o = stream_uses(otherwise, binding)?;\n82:             if t != o {\n83:                 return Err(LinearViolation::Branches {\n84:                     first: t,\n85:                     second: o,\n86:                 });\n87:             }\n88:             Ok(stream_uses(cond, binding)? + t)\n89:         }\n90:         Kind::Match {\n91:             subject,\n92:             arms,\n93:             partial,\n94:         } => {\n95:             // A path through the chain evaluates every guard up to its arm, then that arm's\n96:             // body; a partial chain has one more path, the fall-through, which evaluates every\n97:             // guard and no body. All of them must agree, exactly as a conditional's branches\n98:             // must.\n99:             let mut guards_so_far = 0;\n100:             let mut counts: Vec<usize> = Vec::new();\n101:             for a in arms {\n102:                 if let Some(g) = &a.guard {\n103:                     guards_so_far += stream_uses(g, binding)?;\n104:                 }\n105:                 counts.push(guards_so_far + stream_uses(&a.body, binding)?);\n106:             }\n107:             if *partial {\n108:                 counts.push(guards_so_far);\n109:             }\n110:             if let Some(w) = counts.windows(2).find(|w| w[0] != w[1]) {\n111:                 return Err(LinearViolation::Branches {\n112:                     first: w[0],\n113:                     second: w[1],\n114:                 });\n115:             }\n116:             Ok(stream_uses(subject, binding)? + counts.first().copied().unwrap_or(0))\n117:         }\n118:     }\n119: }\n120: \n121: /// The per-binding half of stream linearity: `binding`, already known to be stream-typed, must\n122: /// be consumed exactly once by `body`. Zero uses is an error too -- linear, not affine: a\n123: /// dropped stream is the Python silent-empty-generator mistake, and exactly-once can relax to\n124: /// at-most-once later without breaking a program, while the reverse tightening could not.\n125: pub(super) fn check_linear(\n126:     body: &Tir,\n127:     binding: &StreamBinding,\n128:     subject: &str,\n129:     span: Span,\n130: ) -> Result<(), Error> {\n131:     match stream_uses(body, binding) {\n132:         Err(LinearViolation::Branches { first, second }) => Err(Error::new(\n133:             span,\n134:             format!(\n135:                 \"{subject} must be consumed exactly once on every path, but one branch \\\n136:                  consumes it {first} times and another {second}\"\n137:             ),\n138:         )),\n139:         Err(LinearViolation::InMapper) => Err(Error::new(\n140:             span,\n141:             format!(\n142:                 \"{subject} must be consumed exactly once, but here it is consumed inside a \\\n143:                  mapper body, which runs once per element\"\n144:             ),\n145:         )),\n146:         Ok(1) => Ok(()),\n147:         Ok(0) => Err(Error::new(\n148:             span,\n149:             format!(\"{subject} must be consumed exactly once; it is never consumed\"),\n150:         )),\n151:         Ok(n) => Err(Error::new(\n152:             span,\n153:             format!(\"{subject} must be consumed exactly once, not {n} times\"),\n154:         )),\n155:     }\n156: }\n157: \n158: /// Whether any node in `t` satisfies `pred`, walking every child a Tir node can hold. The same\n159: /// shape as `stream_uses`, but a plain OR rather than a count: unused-binding checks only need\n160: /// to know whether a name was read at all, not how many times or along which path.\n161: fn any_node(t: &Tir, pred: &dyn Fn(&Tir) -> bool) -> bool {\n162:     if pred(t) {\n163:         return true;\n164:     }\n165:     match &t.kind {\n166:         Kind::Var(_)\n167:         | Kind::Local(_)\n168:         | Kind::Str(_)\n169:         | Kind::Int(_)\n170:         | Kind::Input\n171:         | Kind::Inputs\n172:         | Kind::Lines => false,\n173:         Kind::VecLit(items) => items.iter().any(|i| any_node(i, pred)),\n174:         Kind::RecordLit { fields } => fields.iter().any(|(_, v)| any_node(v, pred)),\n175:         Kind::EnumLit { payload, .. } => payload.as_deref().is_some_and(|p| any_node(p, pred)),\n176:         Kind::Call { arg, .. } => arg.as_deref().is_some_and(|a| any_node(a, pred)),\n177:         Kind::Builtin { arg, .. } => any_node(arg, pred),\n178:         Kind::Concat(l, r) => any_node(l, pred) || any_node(r, pred),\n179:         Kind::Not(base) => any_node(base, pred),\n180:         Kind::Arith { lhs, rhs, .. }\n181:         | Kind::Compare { lhs, rhs, .. }\n182:         | Kind::Logic { lhs, rhs, .. } => any_node(lhs, pred) || any_node(rhs, pred),\n183:         Kind::Bind { value, body, .. } => any_node(value, pred) || any_node(body, pred),\n184:         Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n185:             any_node(source, pred) || any_node(body, pred)\n186:         }\n187:         Kind::Select {\n188:             source, pred: p, ..\n189:         } => any_node(source, pred) || any_node(p, pred),\n190:         Kind::Field { base, .. } | Kind::Unwrap { base } => any_node(base, pred),\n191:         Kind::Index { base, index, .. } => any_node(base, pred) || any_node(index, pred),\n192:         Kind::Cond {\n193:             cond,\n194:             then,\n195:             otherwise,\n196:         } => any_node(cond, pred) || any_node(then, pred) || any_node(otherwise, pred),\n197:         Kind::Match { subject, arms, .. } => {\n198:             any_node(subject, pred)\n199:                 || arms.iter().any(|a| {\n200:                     a.guard.as_ref().is_some_and(|g| any_node(g, pred)) || any_node(&a.body, pred)\n201:                 })\n202:         }\n203:     }\n204: }\n205: \n206: /// Whether the function parameter `name` is read anywhere in its body. Go exempts parameters\n207: /// from its unused-binding rule; toylang does not, since a function here has exactly one, and\n208: /// declaring an input the body ignores is the same dead-code smell the rule exists for.\n209: pub(super) fn param_used(body: &Tir, name: &str) -> bool {\n210:     any_node(body, &|t| matches!(&t.kind, Kind::Var(n) if n == name))\n211: }\n212: \n213: /// Whether a match arm's destructured field `name`, bound off payload local `pid`, is read\n214: /// anywhere in the arm's body.\n215: pub(super) fn field_used(body: &Tir, pid: LocalId, name: &str) -> bool {\n216:     any_node(\n217:         body,\n218:         &|t| matches!(&t.kind, Kind::Field { base, name: n } if n == name && matches!(base.kind, Kind::Local(id) if id == pid)),\n219:     )\n220: }\n221: \n222: /// Every function the program's body can actually reach, directly or through calls a reached\n223: /// function itself makes. `pub fn`s from the prelude are always merged into `file.defs` before\n224: /// this runs, so a `pub` one the program never calls needs pruning here to keep it out of a\n225: /// backend's output and out of `tags::node_types` -- and an unused function the program wrote\n226: /// itself is pruned by the same pass, for the same reason.\n227: pub(super) fn prune_unreachable(funcs: Vec<tir::Func>, body: &Tir) -> Vec<tir::Func> {\n228:     let mut reached: std::collections::HashSet<String> = std::collections::HashSet::new();\n229:     let mut worklist: Vec<String> = Vec::new();\n230:     calls_in(body, &mut worklist);\n231:     while let Some(name) = worklist.pop() {\n232:         if reached.insert(name.clone())\n233:             && let Some(f) = funcs.iter().find(|f| f.name == name)\n234:         {\n235:             calls_in(&f.body, &mut worklist);\n236:         }\n237:     }\n238:     funcs\n239:         .into_iter()\n240:         .filter(|f| reached.contains(&f.name))\n241:         .collect()\n242: }\n243: \n244: /// Every function name a `Kind::Call` inside `t` names, collected recursively through every\n245: /// other kind of node.\n246: fn calls_in(t: &Tir, out: &mut Vec<String>) {\n247:     if let Kind::Call { func, arg } = &t.kind {\n248:         out.push(func.clone());\n249:         if let Some(arg) = arg {\n250:             calls_in(arg, out);\n251:         }\n252:         return;\n253:     }\n254:     match &t.kind {\n255:         Kind::Str(_)\n256:         | Kind::Int(_)\n257:         | Kind::Var(_)\n258:         | Kind::Local(_)\n259:         | Kind::Input\n260:         | Kind::Inputs\n261:         | Kind::Lines => {}\n262:         Kind::VecLit(items) => items.iter().for_each(|i| calls_in(i, out)),\n263:         Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| calls_in(v, out)),\n264:         Kind::EnumLit { payload, .. } => {\n265:             if let Some(p) = payload {\n266:                 calls_in(p, out);\n267:             }\n268:         }\n269:         Kind::Call { .. } => unreachable!(\"handled above\"),\n270:         Kind::Concat(l, r) => {\n271:             calls_in(l, out);\n272:             calls_in(r, out);\n273:         }\n274:         Kind::Not(base) => calls_in(base, out),\n275:         Kind::Arith { lhs, rhs, .. }\n276:         | Kind::Compare { lhs, rhs, .. }\n277:         | Kind::Logic { lhs, rhs, .. } => {\n278:             calls_in(lhs, out);\n279:             calls_in(rhs, out);\n280:         }\n281:         Kind::Cond {\n282:             cond,\n283:             then,\n284:             otherwise,\n285:         } => {\n286:             calls_in(cond, out);\n287:             calls_in(then, out);\n288:             calls_in(otherwise, out);\n289:         }\n290:         Kind::Bind { value, body, .. }\n291:         | Kind::Map {\n292:             source: value,\n293:             body,\n294:             ..\n295:         }\n296:         | Kind::OptMap {\n297:             source: value,\n298:             body,\n299:             ..\n300:         } => {\n301:             calls_in(value, out);\n302:             calls_in(body, out);\n303:         }\n304:         Kind::Select { source, pred, .. } => {\n305:             calls_in(source, out);\n306:             calls_in(pred, out);\n307:         }\n308:         Kind::Field { base, .. } | Kind::Unwrap { base } => calls_in(base, out),\n309:         Kind::Builtin { arg, .. } => calls_in(arg, out),\n310:         Kind::Index { base, index, .. } => {\n311:             calls_in(base, out);\n312:             calls_in(index, out);\n313:         }\n314:         Kind::Match { subject, arms, .. } => {\n315:             calls_in(subject, out);\n316:             for a in arms {\n317:                 if let Some(g) = &a.guard {\n318:                     calls_in(g, out);\n319:                 }\n320:                 calls_in(&a.body, out);\n321:             }\n322:         }\n323:     }\n324: }\n\n(End of file - total 324 lines)\n</content>","metadata":{"preview":"//! Two passes that walk an already-built `Tir` and never touch `Expr` or type resolution: stream\n//! linearity (every stream-typed binding consumed exactly once) and dead-code pruning (which\n//! functions the program body can actually reach).\n\nuse crate::ast::Span;\nuse crate::error::Error;\nuse crate::tir::{self, Kind, LocalId, Tir};\n\n/// What a linearity count is looking for: a stream-typed binding, named either by the source\n/// (a function parameter) or by the checker (the local a `|` binds `.` to).\npub(super) enum StreamBinding<'a> {\n    Param(&'a str),\n    Local(LocalId),\n}\n\n/// What broke the exactly-once rule, when a plain count cannot say it.\nenum LinearViolation {\n    /// A conditional's or match's paths disagree on how often they consume the binding.\n    Branches { first: usize, second: usize },\n    /// The binding is consumed inside a mapper's body, which runs once per element -- one","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-158/src/check/linearity.rs","text":"//! Two passes that walk an already-built `Tir` and never touch `Expr` or type resolution: stream\n//! linearity (every stream-typed binding consumed exactly once) and dead-code pruning (which\n//! functions the program body can actually reach).\n\nuse crate::ast::Span;\nuse crate::error::Error;\nuse crate::tir::{self, Kind, LocalId, Tir};\n\n/// What a linearity count is looking for: a stream-typed binding, named either by the source\n/// (a function parameter) or by the checker (the local a `|` binds `.` to).\npub(super) enum StreamBinding<'a> {\n    Param(&'a str),\n    Local(LocalId),\n}\n\n/// What broke the exactly-once rule, when a plain count cannot say it.\nenum LinearViolation {\n    /// A conditional's or match's paths disagree on how often they consume the binding.\n    Branches { first: usize, second: usize },\n    /// The binding is consumed inside a mapper's body, which runs once per element -- one\n    /// spelled consumption, many runtime ones.\n    InMapper,\n}\n\n/// How many times `t` consumes `binding`, counted along one evaluation path: a conditional\n/// runs one branch, so its branches must agree with each other rather than being summed, and\n/// a match's arms likewise. A mapper's body runs once per element, so any consumption there\n/// is its own violation rather than a count.\nfn stream_uses(t: &Tir, binding: &StreamBinding) -> Result<usize, LinearViolation> {\n    let both = |a: &Tir, b: &Tir| Ok(stream_uses(a, binding)? + stream_uses(b, binding)?);\n    match &t.kind {\n        Kind::Var(name) => Ok(match binding {\n            StreamBinding::Param(p) => (p == name) as usize,\n            StreamBinding::Local(_) => 0,\n        }),\n        Kind::Local(id) => Ok(match binding {\n            StreamBinding::Local(l) => (l == id) as usize,\n            StreamBinding::Param(_) => 0,\n        }),\n        Kind::Str(_) | Kind::Int(_) | Kind::Input | Kind::Inputs | Kind::Lines => Ok(0),\n        Kind::VecLit(items) => items\n            .iter()\n            .try_fold(0, |n, i| Ok(n + stream_uses(i, binding)?)),\n        Kind::RecordLit { fields } => fields\n            .iter()\n            .try_fold(0, |n, (_, v)| Ok(n + stream_uses(v, binding)?)),\n        Kind::EnumLit { payload, .. } => payload\n            .as_deref()\n            .map_or(Ok(0), |p| stream_uses(p, binding)),\n        Kind::Call { arg, .. } => arg.as_deref().map_or(Ok(0), |a| stream_uses(a, binding)),\n        Kind::Builtin { arg, .. } => stream_uses(arg, binding),\n        Kind::Concat(l, r) => both(l, r),\n        Kind::Arith { lhs, rhs, .. } | Kind::Compare { lhs, rhs, .. } => both(lhs, rhs),\n        // Summed rather than reconciled the way a conditional's branches are: `and`/`or` may\n        // skip their right side, so a binding consumed on both sides is consumed once or twice\n        // depending on the left operand's value, and \"sometimes twice\" is exactly what the\n        // exactly-once rule refuses.\n        Kind::Logic { lhs, rhs, .. } => both(lhs, rhs),\n        Kind::Not(base) => stream_uses(base, binding),\n        Kind::Bind { value, body, .. } => both(value, body),\n        Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n            if stream_uses(body, binding)? > 0 {\n                return Err(LinearViolation::InMapper);\n            }\n            stream_uses(source, binding)\n        }\n        Kind::Select { source, pred, .. } => {\n            if stream_uses(pred, binding)? > 0 {\n                return Err(LinearViolation::InMapper);\n            }\n            stream_uses(source, binding)\n        }\n        Kind::Field { base, .. } | Kind::Unwrap { base } => stream_uses(base, binding),\n        Kind::Index { base, index, .. } => both(base, index),\n        Kind::Cond {\n            cond,\n            then,\n            otherwise,\n        } => {\n            let t = stream_uses(then, binding)?;\n            let o = stream_uses(otherwise, binding)?;\n            if t != o {\n                return Err(LinearViolation::Branches {\n                    first: t,\n                    second: o,\n                });\n            }\n            Ok(stream_uses(cond, binding)? + t)\n        }\n        Kind::Match {\n            subject,\n            arms,\n            partial,\n        } => {\n            // A path through the chain evaluates every guard up to its arm, then that arm's\n            // body; a partial chain has one more path, the fall-through, which evaluates every\n            // guard and no body. All of them must agree, exactly as a conditional's branches\n            // must.\n            let mut guards_so_far = 0;\n            let mut counts: Vec<usize> = Vec::new();\n            for a in arms {\n                if let Some(g) = &a.guard {\n                    guards_so_far += stream_uses(g, binding)?;\n                }\n                counts.push(guards_so_far + stream_uses(&a.body, binding)?);\n            }\n            if *partial {\n                counts.push(guards_so_far);\n            }\n            if let Some(w) = counts.windows(2).find(|w| w[0] != w[1]) {\n                return Err(LinearViolation::Branches {\n                    first: w[0],\n                    second: w[1],\n                });\n            }\n            Ok(stream_uses(subject, binding)? + counts.first().copied().unwrap_or(0))\n        }\n    }\n}\n\n/// The per-binding half of stream linearity: `binding`, already known to be stream-typed, must\n/// be consumed exactly once by `body`. Zero uses is an error too -- linear, not affine: a\n/// dropped stream is the Python silent-empty-generator mistake, and exactly-once can relax to\n/// at-most-once later without breaking a program, while the reverse tightening could not.\npub(super) fn check_linear(\n    body: &Tir,\n    binding: &StreamBinding,\n    subject: &str,\n    span: Span,\n) -> Result<(), Error> {\n    match stream_uses(body, binding) {\n        Err(LinearViolation::Branches { first, second }) => Err(Error::new(\n            span,\n            format!(\n                \"{subject} must be consumed exactly once on every path, but one branch \\\n                 consumes it {first} times and another {second}\"\n            ),\n        )),\n        Err(LinearViolation::InMapper) => Err(Error::new(\n            span,\n            format!(\n                \"{subject} must be consumed exactly once, but here it is consumed inside a \\\n                 mapper body, which runs once per element\"\n            ),\n        )),\n        Ok(1) => Ok(()),\n        Ok(0) => Err(Error::new(\n            span,\n            format!(\"{subject} must be consumed exactly once; it is never consumed\"),\n        )),\n        Ok(n) => Err(Error::new(\n            span,\n            format!(\"{subject} must be consumed exactly once, not {n} times\"),\n        )),\n    }\n}\n\n/// Whether any node in `t` satisfies `pred`, walking every child a Tir node can hold. The same\n/// shape as `stream_uses`, but a plain OR rather than a count: unused-binding checks only need\n/// to know whether a name was read at all, not how many times or along which path.\nfn any_node(t: &Tir, pred: &dyn Fn(&Tir) -> bool) -> bool {\n    if pred(t) {\n        return true;\n    }\n    match &t.kind {\n        Kind::Var(_)\n        | Kind::Local(_)\n        | Kind::Str(_)\n        | Kind::Int(_)\n        | Kind::Input\n        | Kind::Inputs\n        | Kind::Lines => false,\n        Kind::VecLit(items) => items.iter().any(|i| any_node(i, pred)),\n        Kind::RecordLit { fields } => fields.iter().any(|(_, v)| any_node(v, pred)),\n        Kind::EnumLit { payload, .. } => payload.as_deref().is_some_and(|p| any_node(p, pred)),\n        Kind::Call { arg, .. } => arg.as_deref().is_some_and(|a| any_node(a, pred)),\n        Kind::Builtin { arg, .. } => any_node(arg, pred),\n        Kind::Concat(l, r) => any_node(l, pred) || any_node(r, pred),\n        Kind::Not(base) => any_node(base, pred),\n        Kind::Arith { lhs, rhs, .. }\n        | Kind::Compare { lhs, rhs, .. }\n        | Kind::Logic { lhs, rhs, .. } => any_node(lhs, pred) || any_node(rhs, pred),\n        Kind::Bind { value, body, .. } => any_node(value, pred) || any_node(body, pred),\n        Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n            any_node(source, pred) || any_node(body, pred)\n        }\n        Kind::Select {\n            source, pred: p, ..\n        } => any_node(source, pred) || any_node(p, pred),\n        Kind::Field { base, .. } | Kind::Unwrap { base } => any_node(base, pred),\n        Kind::Index { base, index, .. } => any_node(base, pred) || any_node(index, pred),\n        Kind::Cond {\n            cond,\n            then,\n            otherwise,\n        } => any_node(cond, pred) || any_node(then, pred) || any_node(otherwise, pred),\n        Kind::Match { subject, arms, .. } => {\n            any_node(subject, pred)\n                || arms.iter().any(|a| {\n                    a.guard.as_ref().is_some_and(|g| any_node(g, pred)) || any_node(&a.body, pred)\n                })\n        }\n    }\n}\n\n/// Whether the function parameter `name` is read anywhere in its body. Go exempts parameters\n/// from its unused-binding rule; toylang does not, since a function here has exactly one, and\n/// declaring an input the body ignores is the same dead-code smell the rule exists for.\npub(super) fn param_used(body: &Tir, name: &str) -> bool {\n    any_node(body, &|t| matches!(&t.kind, Kind::Var(n) if n == name))\n}\n\n/// Whether a match arm's destructured field `name`, bound off payload local `pid`, is read\n/// anywhere in the arm's body.\npub(super) fn field_used(body: &Tir, pid: LocalId, name: &str) -> bool {\n    any_node(\n        body,\n        &|t| matches!(&t.kind, Kind::Field { base, name: n } if n == name && matches!(base.kind, Kind::Local(id) if id == pid)),\n    )\n}\n\n/// Every function the program's body can actually reach, directly or through calls a reached\n/// function itself makes. `pub fn`s from the prelude are always merged into `file.defs` before\n/// this runs, so a `pub` one the program never calls needs pruning here to keep it out of a\n/// backend's output and out of `tags::node_types` -- and an unused function the program wrote\n/// itself is pruned by the same pass, for the same reason.\npub(super) fn prune_unreachable(funcs: Vec<tir::Func>, body: &Tir) -> Vec<tir::Func> {\n    let mut reached: std::collections::HashSet<String> = std::collections::HashSet::new();\n    let mut worklist: Vec<String> = Vec::new();\n    calls_in(body, &mut worklist);\n    while let Some(name) = worklist.pop() {\n        if reached.insert(name.clone())\n            && let Some(f) = funcs.iter().find(|f| f.name == name)\n        {\n            calls_in(&f.body, &mut worklist);\n        }\n    }\n    funcs\n        .into_iter()\n        .filter(|f| reached.contains(&f.name))\n        .collect()\n}\n\n/// Every function name a `Kind::Call` inside `t` names, collected recursively through every\n/// other kind of node.\nfn calls_in(t: &Tir, out: &mut Vec<String>) {\n    if let Kind::Call { func, arg } = &t.kind {\n        out.push(func.clone());\n        if let Some(arg) = arg {\n            calls_in(arg, out);\n        }\n        return;\n    }\n    match &t.kind {\n        Kind::Str(_)\n        | Kind::Int(_)\n        | Kind::Var(_)\n        | Kind::Local(_)\n        | Kind::Input\n        | Kind::Inputs\n        | Kind::Lines => {}\n        Kind::VecLit(items) => items.iter().for_each(|i| calls_in(i, out)),\n        Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| calls_in(v, out)),\n        Kind::EnumLit { payload, .. } => {\n            if let Some(p) = payload {\n                calls_in(p, out);\n            }\n        }\n        Kind::Call { .. } => unreachable!(\"handled above\"),\n        Kind::Concat(l, r) => {\n            calls_in(l, out);\n            calls_in(r, out);\n        }\n        Kind::Not(base) => calls_in(base, out),\n        Kind::Arith { lhs, rhs, .. }\n        | Kind::Compare { lhs, rhs, .. }\n        | Kind::Logic { lhs, rhs, .. } => {\n            calls_in(lhs, out);\n            calls_in(rhs, out);\n        }\n        Kind::Cond {\n            cond,\n            then,\n            otherwise,\n        } => {\n            calls_in(cond, out);\n            calls_in(then, out);\n            calls_in(otherwise, out);\n        }\n        Kind::Bind { value, body, .. }\n        | Kind::Map {\n            source: value,\n            body,\n            ..\n        }\n        | Kind::OptMap {\n            source: value,\n            body,\n            ..\n        } => {\n            calls_in(value, out);\n            calls_in(body, out);\n        }\n        Kind::Select { source, pred, .. } => {\n            calls_in(source, out);\n            calls_in(pred, out);\n        }\n        Kind::Field { base, .. } | Kind::Unwrap { base } => calls_in(base, out),\n        Kind::Builtin { arg, .. } => calls_in(arg, out),\n        Kind::Index { base, index, .. } => {\n            calls_in(base, out);\n            calls_in(index, out);\n        }\n        Kind::Match { subject, arms, .. } => {\n            calls_in(subject, out);\n            for a in arms {\n                if let Some(g) = &a.guard {\n                    calls_in(g, out);\n                }\n                calls_in(&a.body, out);\n            }\n        }\n    }\n}","lineStart":1,"lineEnd":324,"totalLines":324,"truncated":false}},"title":"src/check/linearity.rs","time":{"start":1788130599947,"end":1788130599956}},"id":"prt_054e3a3e2001wPPHRFRleN2vLB","sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","messageID":"msg_054e38186001iv4fpGA5F7bq6I"}}
