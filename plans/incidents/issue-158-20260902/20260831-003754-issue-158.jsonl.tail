{"type":"step_start","timestamp":1788129604321,"sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","part":{"id":"prt_054d472d8001Iow0BNEvRRGYdA","messageID":"msg_054d46b60001rbhO6MUuSBn11X","sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","snapshot":"5a1012ab7eb7388a8de2a55a732be7fdbf823735","type":"step-start"}}
{"type":"tool_use","timestamp":1788129606750,"sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-b828d09f9dbaa48a","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-158/src/tir.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-158/src/tir.rs</path>\n<type>file</type>\n<content>\n1: //! The typed IR the backends consume.\n2: //!\n3: //! Every node carries the type it was checked at, so a backend never has to ask what a value is\n4: //! at runtime and never has to look a type up in a table beside the tree. A static target cannot\n5: //! work from anything less: it has to know that an add is an integer add before it can emit one.\n6: //!\n7: //! Names are deliberately *not* mangled here. Which identifiers are reserved is a property of\n8: //! the target, not of toylang, so each backend renders these as it needs to.\n9: \n10: use crate::ast::{BinOp, LogicOp};\n11: use crate::ty::{Enums, Type};\n12: \n13: pub struct Tir {\n14:     pub ty: Type,\n15:     pub kind: Kind,\n16: }\n17: \n18: impl Tir {\n19:     pub fn new(ty: Type, kind: Kind) -> Tir {\n20:         Tir { ty, kind }\n21:     }\n22: }\n23: \n24: /// A binding the source cannot name, introduced for `|` and for `select`'s parameter.\n25: pub type LocalId = u32;\n26: \n27: pub enum Kind {\n28:     Str(String),\n29:     Int(i64),\n30:     VecLit(Vec<Tir>),\n31:     /// A record literal, its fields in declaration order so a field's position here matches\n32:     /// its position in the type. That is what lets a backend address one by index rather than\n33:     /// searching for it.\n34:     RecordLit {\n35:         fields: Vec<(String, Tir)>,\n36:     },\n37:     /// A constructed enum value. The node's type is the enum, so a backend finds the variant's\n38:     /// position (its tag, where one is needed) and its payload type by asking `ty::variants`\n39:     /// for that type's list rather than by carrying either here. `payload` is `None` for a unit\n40:     /// variant, which every backend renders as the bare variant-name string; a payload variant\n41:     /// is the single-key wrapper (ADR 0009).\n42:     EnumLit {\n43:         variant: String,\n44:         payload: Option<Box<Tir>>,\n45:     },\n46:     /// Rebuilds an Opt: present-preserving, absent-preserving. `body` runs with `param` bound\n47:     /// to the unwrapped payload only when `source` is present; an absent `source` passes\n48:     /// through untouched. Never surface syntax -- Opt has no general map or match a program can\n49:     /// reach (kantord/toylang#47's totality round owns that) -- this is only how the checker's\n50:     /// own reorder pass reaches inside an Opt payload (kantord/toylang#66): every other enum\n51:     /// reorders through `Match`/`EnumLit`, but Opt keeps a representation of its own in three\n52:     /// backends, so those two general nodes cannot reach it.\n53:     OptMap {\n54:         source: Box<Tir>,\n55:         param: LocalId,\n56:         body: Box<Tir>,\n57:     },\n58:     /// A name written in the source: today only a function parameter.\n59:     Var(String),\n60:     Local(LocalId),\n61:     /// The value read from stdin.\n62:     Input,\n63:     /// Every remaining JSON value on stdin, one per line, eagerly collected into a `Vec<T>`.\n64:     Inputs,\n65:     /// The stream of lines read from stdin, read incrementally by whatever consumes it.\n66:     Lines,\n67:     Call {\n68:         func: String,\n69:         /// `None` for a call to a nullary function.\n70:         arg: Option<Box<Tir>>,\n71:     },\n72:     Concat(Box<Tir>, Box<Tir>),\n73:     /// Wrapping integer arithmetic, at the width the node's own type names: 32 bits for `Int`,\n74:     /// 64 for `Int64` (kantord/toylang#83) -- both operands always share it, since nothing\n75:     /// converts implicitly. Division and remainder stop the program on a zero divisor, which\n76:     /// is the only way arithmetic can fail.\n77:     Arith {\n78:         op: BinOp,\n79:         lhs: Box<Tir>,\n80:         rhs: Box<Tir>,\n81:     },\n82:     /// The condition is exactly one Bool, which is what turns jq's run-both-branches behaviour\n83:     /// into a type error here.\n84:     Cond {\n85:         cond: Box<Tir>,\n86:         then: Box<Tir>,\n87:         otherwise: Box<Tir>,\n88:     },\n89:     Compare {\n90:         op: BinOp,\n91:         lhs: Box<Tir>,\n92:         rhs: Box<Tir>,\n93:     },\n94:     /// `and` / `or` over two Bools, short-circuiting: `rhs` is evaluated only when `lhs` leaves\n95:     /// the answer open. That is not a nicety here -- division and `!` can stop the program, so\n96:     /// whether the right side runs is observable -- which is why every backend emits its own\n97:     /// short-circuiting operator rather than two evaluated operands combined afterwards.\n98:     Logic {\n99:         op: LogicOp,\n100:         lhs: Box<Tir>,\n101:         rhs: Box<Tir>,\n102:     },\n103:     /// `not b`.\n104:     Not(Box<Tir>),\n105:     /// `let local = value in body`, which is what `|` becomes once `.` has a name.\n106:     Bind {\n107:         local: LocalId,\n108:         value: Box<Tir>,\n109:         body: Box<Tir>,\n110:     },\n111:     /// Every element replaced by `body`, with `param` bound to each. Same loop as Select, kept\n112:     /// separate because the result's element type is the body's rather than the source's.\n113:     Map {\n114:         source: Box<Tir>,\n115:         param: LocalId,\n116:         body: Box<Tir>,\n117:     },\n118:     Select {\n119:         source: Box<Tir>,\n120:         param: LocalId,\n121:         pred: Box<Tir>,\n122:     },\n123:     /// Read `name` off `base`. How many Vec layers to descend through is `base.ty`'s doing and\n124:     /// is not stored, so it cannot disagree with the type.\n125:     Field {\n126:         base: Box<Tir>,\n127:         name: String,\n128:     },\n129:     /// Collapse one dimension of `base` at `index`, `depth` layers down.\n130:     ///\n131:     /// Unlike a field access this has to store its depth. A field access leaves a record behind,\n132:     /// so the depth is every Vec layer of the base; an index leaves a Vec behind, so the layers\n133:     /// below the one being collapsed are indistinguishable from the ones above it.\n134:     /// A unary builtin. Unary like every other function, so it needs no special call form.\n135:     Builtin {\n136:         which: Builtin,\n137:         arg: Box<Tir>,\n138:     },\n139:     /// Insist an Opt is present, `depth` layers down. Like a field access and unlike an index,\n140:     /// the depth is every Vec layer of the base, because an Opt is not a dimension.\n141:     Unwrap {\n142:         base: Box<Tir>,\n143:     },\n144:     Index {\n145:         base: Box<Tir>,\n146:         index: Box<Tir>,\n147:         depth: usize,\n148:         /// Whether an entry is a record, which decides if collapsing has to gather columns.\n149:         elem_is_record: bool,\n150:     },\n151:     /// First-match-wins dispatch over the subject: variant arms test its shape, guard arms\n152:     /// evaluate a Bool of their own. The checker has already resolved every name a pattern\n153:     /// bound, so an arm is only a test, a payload local to bind, and a body.\n154:     ///\n155:     /// When the chain is total (`partial` is false) -- every variant covered, or a default at\n156:     /// the end -- a backend may take the last arm without a test. A partial chain has no such\n157:     /// arm: every test is emitted, and falling off the end produces the absent `Opt`, which is\n158:     /// why the node's type is then `Opt` of the arms' common body type.\n159:     Match {\n160:         subject: Box<Tir>,\n161:         arms: Vec<MatchArm>,\n162:         partial: bool,\n163:     },\n164: }\n165: \n166: pub struct MatchArm {\n167:     /// `Some` tests the subject for this variant. `None` with a `guard` is a guard arm; `None`\n168:     /// with no guard is the default arm, which the checker keeps last.\n169:     pub variant: Option<String>,\n170:     /// The Bool deciding a guard arm, already checked in the subject's scope.\n171:     pub guard: Option<Tir>,\n172:     /// The local the payload binds to in a payload-variant arm; `.` and destructured field\n173:     /// names in the body both read through it.\n174:     pub payload: Option<LocalId>,\n175:     pub body: Tir,\n176: }\n177: \n178: /// The functions the language provides. Each is unary, and so is every user function: something\n179: /// wanting two arguments takes a record, which is what a record literal is for in argument\n180: /// position.\n181: #[derive(Clone, Copy, PartialEq, Eq)]\n182: pub enum Builtin {\n183:     /// `str(n)`, rendering an Int the way the printer does but reachable from a program.\n184:     IntToStr,\n185:     /// `i64(n)`, `Int -> Int64`: the one bridge between the two integer types, explicit\n186:     /// because nothing widens implicitly (kantord/toylang#83). A no-op on every backend whose\n187:     /// runtime integers are already 64 bits wide; JS builds a BigInt, and Go and Rust spell\n188:     /// the cast.\n189:     IntToI64,\n190:     /// `range(n)`, the integers from zero up to but not including n. Zero-based, matching jq,\n191:     /// Python, and this language's own indices.\n192:     Range,\n193:     /// `collect(s)`, `Stream<T> -> Vec<T>`: the one place a stream stops being a stream. What\n194:     /// comes back is an ordinary value, exactly as sized as it needs to be, with no trace left\n195:     /// of how it arrived.\n196:     Collect,\n197:     /// `jsonlines(v)`, printing each element of a `Vec<T>` on its own line rather than wrapping\n198:     /// the whole thing in `[...]`. Named for the format (jsonlines.org, also called NDJSON):\n199:     /// one JSON value per line. Polymorphic over the element type, so it is not in the fixed\n200:     /// signature table `builtin()` reads from; `synth` checks it directly, the way `map` and\n201:     /// `select` are checked from their own arm rather than through a table.\n202:     JsonLines,\n203:     /// `length(v)`, a Vec's length. A dense Vec already tracks this at runtime, so reading it out\n204:     /// costs nothing -- there is no fold or scan hiding behind the name.\n205:     Length,\n206:     /// `flatten(vv)`, flattening a `Vec<Vec<T>>` into one `Vec<T>`, for the case where the\n207:     /// number of inner Vecs is not known at the call site. Joining a fixed, known count of Vecs\n208:     /// is `+` instead (kantord/toylang#97, the add-trait reading of Q2 in plans/questions.md); this\n209:     /// builtin used to be named `concat` and cover both cases before that split.\n210:     Flatten,\n211:     /// `tail(v)`, every element but the first, `None` when `v` is empty. Consistent with how\n212:     /// `Index` already turns \"reaching past what's there\" into `Opt` rather than a runtime\n213:     /// failure.\n214:     Tail,\n215:     /// `fields(r)`, a record's field names in declaration order (kantord/toylang#63, the\n216:     /// accessor #60's ratification promised once order left type identity). The names come from\n217:     /// `r`'s checked type, not its runtime value, so every backend can emit them as a literal;\n218:     /// `r` is still evaluated for whatever it would otherwise do, the same as any other argument.\n219:     Fields,\n220:     /// `chars(s)`, `Str -> Vec<Char>`: every Unicode scalar value in `s`, in order. Decoded by\n221:     /// codepoint on every backend, so a character outside the Basic Multilingual Plane is one\n222:     /// element here even on a target whose own strings need a surrogate pair to spell it\n223:     /// (kantord/toylang#75).\n224:     Chars,\n225:     /// `sort(v)`, `Vec<T> -> Vec<T>`: `v`'s elements in ascending order by the same total order\n226:     /// `<` already gives `T`. One value in, one value out with no lawful Stream instance\n227:     /// (kantord/toylang#86, Q20 in plans/questions.md), so it is checked as a Vec-only builtin the way\n228:     /// `length`/`tail`/`flatten` are rather than through `select`/`map`'s cardinality\n229:     /// polymorphism. Restricted to the element types ordering already typechecks on --\n230:     /// Int, Int64, Str, Char -- so every backend can reach for its native ordering.\n231:     Sort,\n232:     /// `reverse(v)`, `Vec<T> -> Vec<T>`: `v`'s elements in the opposite order. Blocking for the\n233:     /// same reason `sort` is (the whole Vec has to be there before the first output element\n234:     /// is), but unrestricted in element type, since reversing needs no comparison.\n235:     Reverse,\n236:     /// `sum(v)`, the reduction of `+` over `v`'s elements, at the element type's own width: a\n237:     /// `Vec<Int>` sums to `Int`, a `Vec<Int64>` to `Int64`, and an empty Vec sums to 0. Each\n238:     /// addition wraps the way the language's `+` does, so a sum that leaves the width is the\n239:     /// same number a hand-written fold would produce (kantord/toylang#140).\n240:     Sum,\n241:     /// `max(v)`, the greatest of `v`'s elements, `Opt<T>` because an empty Vec has no maximum\n242:     /// -- the same answer indexing gives to absence (kantord/toylang#140). Restricted to the\n243:     /// same two integer element types `sum` takes, so a backend can reach for its native\n244:     /// maximum.\n245:     Max,\n246: }\n247: \n248: pub struct Func {\n249:     pub name: String,\n250:     /// `None` for a nullary function.\n251:     pub param: Option<String>,\n252:     pub param_ty: Option<Type>,\n253:     pub body: Tir,\n254: }\n255: \n256: pub struct Program {\n257:     pub funcs: Vec<Func>,\n258:     pub body: Tir,\n259:     /// The type stdin must have, if the program reads it.\n260:     pub input: Option<Type>,\n261:     /// The element type each line of stdin parses as, if the program reads `inputs`.\n262:     pub inputs: Option<Type>,\n263:     /// Whether the program reads `lines`. A separate flag from `input`, since the two are\n264:     /// unrelated readers of the same real stdin and a program using `lines` alone still needs\n265:     /// it connected, even though `input` is `None`.\n266:     pub uses_lines: bool,\n267:     /// Every enum the program declared, the prelude's included. A backend has no checker `Ctx`\n268:     /// to hand, and the variant list on a `Type::Enum` is a placeholder wherever a recursive\n269:     /// enum's payload reaches back to itself, so this travels with the tree: it is what\n270:     /// `ty::variants` re-derives from (kantord/toylang#94).\n271:     pub enums: Enums,\n272: }\n273: \n274: /// The element type a backend iterates over. Under eager lowering a stream is materialized as\n275: /// the Vec of its entries, so a Stream's element counts exactly as a Vec's here; the checker's\n276: /// `Type::elem` deliberately does not agree, keeping the reducers Vec-only at the surface.\n277: pub fn runtime_elem(ty: &Type) -> Option<&Type> {\n278:     match ty {\n279:         Type::Vec(t) | Type::Stream(t) => Some(t),\n280:         _ => None,\n281:     }\n282: }\n283: \n284: /// How many dimension layers wrap a scalar -- `Vec`s, plus the outermost `Stream` when there\n285: /// is one. Field access distributes over each of them.\n286: pub fn vec_depth(ty: &Type) -> usize {\n287:     let mut depth = 0;\n288:     let mut inner = ty;\n289:     while let Some(elem) = runtime_elem(inner) {\n290:         depth += 1;\n291:         inner = elem;\n292:     }\n293:     depth\n294: }\n295: \n296: /// One `map`/`select` applied between reading a record and printing it, in source order (the\n297: /// stage nearest the source first).\n298: pub enum Stage<'a> {\n299:     Map { param: LocalId, body: &'a Tir },\n300:     Select { param: LocalId, pred: &'a Tir },\n301: }\n302: \n303: /// What a fused loop reads one entry at a time: parsed JSON values, or raw lines.\n304: #[derive(Clone, Copy, PartialEq, Eq)]\n305: pub enum Source {\n306:     Inputs,\n307:     Lines,\n308: }\n309: \n310: /// A stream-typed pipeline ending in `jsonlines`, compiled as a read-one/transform-one/\n311: /// write-one loop. Decided by the types, not by a structural guess: the old `recognize_fusion`\n312: /// pattern match retired when `Stream` entered the type grammar (plans/streams.md step 5), so\n313: /// whether a program streams is now exactly whether its types say so.\n314: pub struct Fusion<'a> {\n315:     pub source: Source,\n316:     pub stages: Vec<Stage<'a>>,\n317: }\n318: \n319: /// What a stream chain bottoms out at: a source, a function's own parameter, or the local a\n320: /// `|` bound.\n321: enum Base<'a> {\n322:     Inputs,\n323:     Lines,\n324:     Var(&'a String),\n325:     Local(LocalId),\n326: }\n327: \n328: /// Append the per-element stages of the stream-typed `t`, returning what its chain bottoms out\n329: /// at.\n330: ///\n331: /// Total, not a recognizer: the checker leaves exactly these kinds able to carry a Stream type\n332: /// (sources, bindings, mappers, calls -- a conditional or match yielding one is refused, and\n333: /// projection is normalized to a Map), so the `unreachable!` arms are compiler bugs, never\n334: /// program shapes. That is the invariant this step lands: a stream-typed program that failed\n335: /// to fuse would silently materialize stdin, which is the defect the feature exists to remove.\n336: fn flatten<'a>(t: &'a Tir, program: &'a Program, stages: &mut Vec<Stage<'a>>) -> Base<'a> {\n337:     match &t.kind {\n338:         Kind::Inputs => Base::Inputs,\n339:         Kind::Lines => Base::Lines,\n340:         Kind::Var(name) => Base::Var(name),\n341:         Kind::Local(id) => Base::Local(*id),\n342:         Kind::Bind { local, value, body } => {\n343:             let base = flatten(value, program, stages);\n344:             match flatten(body, program, stages) {\n345:                 Base::Local(id) if id == *local => base,\n346:                 _ => unreachable!(\"a piped stream is consumed by the pipe's own body\"),\n347:             }\n348:         }\n349:         Kind::Map {\n350:             source,\n351:             param,\n352:             body,\n353:         } => {\n354:             let base = flatten(source, program, stages);\n355:             stages.push(Stage::Map {\n356:                 param: *param,\n357:                 body,\n358:             });\n359:             base\n360:         }\n361:         Kind::Select {\n362:             source,\n363:             param,\n364:             pred,\n365:         } => {\n366:             let base = flatten(source, program, stages);\n367:             stages.push(Stage::Select {\n368:                 param: *param,\n369:                 pred,\n370:             });\n371:             base\n372:         }\n373:         // The argument's stages first, then the callee's body inlined: its chain bottoms at\n374:         // its own parameter (a stream-returning function must take a stream, and linearity\n375:         // makes the parameter the base of whatever it returns).\n376:         Kind::Call { func, arg } => {\n377:             let f = program\n378:                 .funcs\n379:                 .iter()\n380:                 .find(|f| &f.name == func)\n381:                 .expect(\"the checker resolved every call\");\n382:             // A stream-returning function must take a stream (see `signatures`), so a call\n383:             // reaching here -- one whose result is stream-typed -- always carries an argument.\n384:             let arg = arg\n385:                 .as_deref()\n386:                 .expect(\"a stream-returning function is never nullary\");\n387:             let base = flatten(arg, program, stages);\n388:             let param = f\n389:                 .param\n390:                 .as_deref()\n391:                 .expect(\"a stream-returning function is never nullary\");\n392:             match flatten(&f.body, program, stages) {\n393:                 Base::Var(name) if name == param => base,\n394:                 _ => unreachable!(\"a stream-returning function's chain bottoms at its parameter\"),\n395:             }\n396:         }\n397:         _ => unreachable!(\"the checker leaves no other kind stream-typed\"),\n398:     }\n399: }\n400: \n401: /// The type question `streams_inputs` used to answer by pattern match: a `jsonlines` program\n402: /// whose argument is stream-typed fuses, and one whose argument is a Vec (already collected)\n403: /// stays an ordinary value and runs eagerly, exactly as its types say.\n404: pub fn fusion(program: &Program) -> Option<Fusion<'_>> {\n405:     let Kind::Builtin {\n406:         which: Builtin::JsonLines,\n407:         arg,\n408:     } = &program.body.kind\n409:     else {\n410:         return None;\n411:     };\n412:     if !matches!(arg.ty, Type::Stream(_)) {\n413:         return None;\n414:     }\n415:     let mut stages = Vec::new();\n416:     let source = match flatten(arg, program, &mut stages) {\n417:         Base::Inputs => Source::Inputs,\n418:         Base::Lines => Source::Lines,\n419:         Base::Var(_) | Base::Local(_) => {\n420:             unreachable!(\"a program-level stream chain bottoms at its source\")\n421:         }\n422:     };\n423:     Some(Fusion { source, stages })\n424: }\n425: \n426: /// Every enum type the program prints that can hold another of its own type, deduplicated and\n427: /// in the order the walk meets them.\n428: ///\n429: /// A backend writes its printer by expanding a type inline, which is exactly what does not\n430: /// terminate on one of these. So each gets a named function the expansion can call back into\n431: /// instead, and this is the list of functions to write (kantord/toylang#94). Only what is\n432: /// printed: a program can hold a recursive value, match on it and print an Int, and a printer\n433: /// nobody calls is dead code that Go, at least, would then demand an import for.\n434: pub fn printed_recursive_enums(program: &Program) -> Vec<Type> {\n435:     let mut printed = vec![program.body.ty.clone()];\n436:     let mut collect_printed = |t: &Tir| {\n437:         if let Kind::Builtin {\n438:             which: Builtin::JsonLines,\n439:             arg,\n440:         } = &t.kind\n441:         {\n442:             printed.push(\n443:                 runtime_elem(&arg.ty)\n444:                     .expect(\"jsonlines takes a Vec or a stream\")\n445:                     .clone(),\n446:             );\n447:         }\n448:     };\n449:     for f in &program.funcs {\n450:         each_node(&f.body, &mut collect_printed);\n451:     }\n452:     each_node(&program.body, &mut collect_printed);\n453: \n454:     let mut found = Vec::new();\n455:     let mut seen = Vec::new();\n456:     for ty in &printed {\n457:         reachable_enums(&program.enums, ty, &mut seen, &mut found);\n458:     }\n459:     found.retain(|ty| crate::ty::is_recursive(&program.enums, ty));\n460:     found\n461: }\n462: \n463: /// Append every enum type nested anywhere in `ty` to `found`, descending through payloads read\n464: /// from the registry rather than off the type. `seen` is what stops a recursive one: its own\n465: /// payload leads back to a type already visited.\n466: fn reachable_enums(enums: &Enums, ty: &Type, seen: &mut Vec<Type>, found: &mut Vec<Type>) {\n467:     match ty {\n468:         Type::Vec(e) | Type::Stream(e) => reachable_enums(enums, e, seen, found),\n469:         Type::Record(fields) => {\n470:             for (_, f) in fields {\n471:                 reachable_enums(enums, f, seen, found);\n472:             }\n473:         }\n474:         Type::Enum { name, args, .. } => {\n475:             if seen.contains(ty) {\n476:                 return;\n477:             }\n478:             seen.push(ty.clone());\n479:             found.push(ty.clone());\n480:             for arg in args {\n481:                 reachable_enums(enums, arg, seen, found);\n482:             }\n483:             for (_, payload) in crate::ty::variants_of(enums, name, args) {\n484:                 if let Some(p) = payload {\n485:                     reachable_enums(enums, &p, seen, found);\n486:                 }\n487:             }\n488:         }\n489:         _ => {}\n490:     }\n491: }\n492: \n493: /// Every node in the tree, `t` itself included, in no particular order. The backends each walk\n494: /// the tree their own way, gathering what their own target needs; this is for the questions\n495: /// that are the same on every target.\n496: fn each_node(t: &Tir, f: &mut impl FnMut(&Tir)) {\n497:     f(t);\n498:     match &t.kind {\n499:         Kind::Str(_)\n500:         | Kind::Int(_)\n501:         | Kind::Var(_)\n502:         | Kind::Local(_)\n503:         | Kind::Input\n504:         | Kind::Inputs\n505:         | Kind::Lines => {}\n506:         Kind::VecLit(items) => items.iter().for_each(|i| each_node(i, f)),\n507:         Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| each_node(v, f)),\n508:         Kind::EnumLit { payload, .. } => {\n509:             if let Some(p) = payload {\n510:                 each_node(p, f);\n511:             }\n512:         }\n513:         Kind::Call { arg, .. } => {\n514:             if let Some(a) = arg {\n515:                 each_node(a, f);\n516:             }\n517:         }\n518:         Kind::Concat(l, r)\n519:         | Kind::Compare { lhs: l, rhs: r, .. }\n520:         | Kind::Logic { lhs: l, rhs: r, .. }\n521:         | Kind::Arith { lhs: l, rhs: r, .. } => {\n522:             each_node(l, f);\n523:             each_node(r, f);\n524:         }\n525:         Kind::Not(base) => each_node(base, f),\n526:         Kind::Cond {\n527:             cond,\n528:             then,\n529:             otherwise,\n530:         } => {\n531:             each_node(cond, f);\n532:             each_node(then, f);\n533:             each_node(otherwise, f);\n534:         }\n535:         Kind::Bind { value, body, .. } => {\n536:             each_node(value, f);\n537:             each_node(body, f);\n538:         }\n539:         Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n540:             each_node(source, f);\n541:             each_node(body, f);\n542:         }\n543:         Kind::Select { source, pred, .. } => {\n544:             each_node(source, f);\n545:             each_node(pred, f);\n546:         }\n547:         Kind::Field { base, .. } | Kind::Unwrap { base } => each_node(base, f),\n548:         Kind::Builtin { arg, .. } => each_node(arg, f),\n549:         Kind::Index { base, index, .. } => {\n550:             each_node(base, f);\n551:             each_node(index, f);\n552:         }\n553:         Kind::Match { subject, arms, .. } => {\n554:             each_node(subject, f);\n555:             for arm in arms {\n556:                 if let Some(g) = &arm.guard {\n557:                     each_node(g, f);\n558:                 }\n559:                 each_node(&arm.body, f);\n560:             }\n561:         }\n562:     }\n563: }\n564: \n565: /// Whether `t` makes a self-call to `name` in a tail position: a call whose result is the\n566: /// function's result, with nothing left to do after it. This is what lets the js and py\n567: /// emitters lower a self-tail-recursive function to a loop, the constant-stack contract\n568: /// (kantord/toylang#141).\n569: ///\n570: /// Only `Cond` branches, a total `Match`'s arm bodies, and a `Bind`'s body put their child in\n571: /// tail position; a partial `Match` wraps every arm body in `{some: ...}`, so nothing there is\n572: /// a tail call, and a call feeding an operator (`f(x) + 1`) is a genuine recursion the contract\n573: /// does not cover.\n574: pub fn has_tail_call(name: &str, t: &Tir) -> bool {\n575:     match &t.kind {\n576:         Kind::Call { func, .. } => func == name,\n577:         Kind::Cond { then, otherwise, .. } => {\n578:             has_tail_call(name, then) || has_tail_call(name, otherwise)\n579:         }\n580:         Kind::Bind { body, .. } => has_tail_call(name, body),\n581:         Kind::Match { arms, partial, .. } if !partial => {\n582:             arms.iter().any(|a| has_tail_call(name, &a.body))\n583:         }\n584:         _ => false,\n585:     }\n586: }\n\n(End of file - total 586 lines)\n</content>","metadata":{"preview":"//! The typed IR the backends consume.\n//!\n//! Every node carries the type it was checked at, so a backend never has to ask what a value is\n//! at runtime and never has to look a type up in a table beside the tree. A static target cannot\n//! work from anything less: it has to know that an add is an integer add before it can emit one.\n//!\n//! Names are deliberately *not* mangled here. Which identifiers are reserved is a property of\n//! the target, not of toylang, so each backend renders these as it needs to.\n\nuse crate::ast::{BinOp, LogicOp};\nuse crate::ty::{Enums, Type};\n\npub struct Tir {\n    pub ty: Type,\n    pub kind: Kind,\n}\n\nimpl Tir {\n    pub fn new(ty: Type, kind: Kind) -> Tir {\n        Tir { ty, kind }","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-158/src/tir.rs","text":"//! The typed IR the backends consume.\n//!\n//! Every node carries the type it was checked at, so a backend never has to ask what a value is\n//! at runtime and never has to look a type up in a table beside the tree. A static target cannot\n//! work from anything less: it has to know that an add is an integer add before it can emit one.\n//!\n//! Names are deliberately *not* mangled here. Which identifiers are reserved is a property of\n//! the target, not of toylang, so each backend renders these as it needs to.\n\nuse crate::ast::{BinOp, LogicOp};\nuse crate::ty::{Enums, Type};\n\npub struct Tir {\n    pub ty: Type,\n    pub kind: Kind,\n}\n\nimpl Tir {\n    pub fn new(ty: Type, kind: Kind) -> Tir {\n        Tir { ty, kind }\n    }\n}\n\n/// A binding the source cannot name, introduced for `|` and for `select`'s parameter.\npub type LocalId = u32;\n\npub enum Kind {\n    Str(String),\n    Int(i64),\n    VecLit(Vec<Tir>),\n    /// A record literal, its fields in declaration order so a field's position here matches\n    /// its position in the type. That is what lets a backend address one by index rather than\n    /// searching for it.\n    RecordLit {\n        fields: Vec<(String, Tir)>,\n    },\n    /// A constructed enum value. The node's type is the enum, so a backend finds the variant's\n    /// position (its tag, where one is needed) and its payload type by asking `ty::variants`\n    /// for that type's list rather than by carrying either here. `payload` is `None` for a unit\n    /// variant, which every backend renders as the bare variant-name string; a payload variant\n    /// is the single-key wrapper (ADR 0009).\n    EnumLit {\n        variant: String,\n        payload: Option<Box<Tir>>,\n    },\n    /// Rebuilds an Opt: present-preserving, absent-preserving. `body` runs with `param` bound\n    /// to the unwrapped payload only when `source` is present; an absent `source` passes\n    /// through untouched. Never surface syntax -- Opt has no general map or match a program can\n    /// reach (kantord/toylang#47's totality round owns that) -- this is only how the checker's\n    /// own reorder pass reaches inside an Opt payload (kantord/toylang#66): every other enum\n    /// reorders through `Match`/`EnumLit`, but Opt keeps a representation of its own in three\n    /// backends, so those two general nodes cannot reach it.\n    OptMap {\n        source: Box<Tir>,\n        param: LocalId,\n        body: Box<Tir>,\n    },\n    /// A name written in the source: today only a function parameter.\n    Var(String),\n    Local(LocalId),\n    /// The value read from stdin.\n    Input,\n    /// Every remaining JSON value on stdin, one per line, eagerly collected into a `Vec<T>`.\n    Inputs,\n    /// The stream of lines read from stdin, read incrementally by whatever consumes it.\n    Lines,\n    Call {\n        func: String,\n        /// `None` for a call to a nullary function.\n        arg: Option<Box<Tir>>,\n    },\n    Concat(Box<Tir>, Box<Tir>),\n    /// Wrapping integer arithmetic, at the width the node's own type names: 32 bits for `Int`,\n    /// 64 for `Int64` (kantord/toylang#83) -- both operands always share it, since nothing\n    /// converts implicitly. Division and remainder stop the program on a zero divisor, which\n    /// is the only way arithmetic can fail.\n    Arith {\n        op: BinOp,\n        lhs: Box<Tir>,\n        rhs: Box<Tir>,\n    },\n    /// The condition is exactly one Bool, which is what turns jq's run-both-branches behaviour\n    /// into a type error here.\n    Cond {\n        cond: Box<Tir>,\n        then: Box<Tir>,\n        otherwise: Box<Tir>,\n    },\n    Compare {\n        op: BinOp,\n        lhs: Box<Tir>,\n        rhs: Box<Tir>,\n    },\n    /// `and` / `or` over two Bools, short-circuiting: `rhs` is evaluated only when `lhs` leaves\n    /// the answer open. That is not a nicety here -- division and `!` can stop the program, so\n    /// whether the right side runs is observable -- which is why every backend emits its own\n    /// short-circuiting operator rather than two evaluated operands combined afterwards.\n    Logic {\n        op: LogicOp,\n        lhs: Box<Tir>,\n        rhs: Box<Tir>,\n    },\n    /// `not b`.\n    Not(Box<Tir>),\n    /// `let local = value in body`, which is what `|` becomes once `.` has a name.\n    Bind {\n        local: LocalId,\n        value: Box<Tir>,\n        body: Box<Tir>,\n    },\n    /// Every element replaced by `body`, with `param` bound to each. Same loop as Select, kept\n    /// separate because the result's element type is the body's rather than the source's.\n    Map {\n        source: Box<Tir>,\n        param: LocalId,\n        body: Box<Tir>,\n    },\n    Select {\n        source: Box<Tir>,\n        param: LocalId,\n        pred: Box<Tir>,\n    },\n    /// Read `name` off `base`. How many Vec layers to descend through is `base.ty`'s doing and\n    /// is not stored, so it cannot disagree with the type.\n    Field {\n        base: Box<Tir>,\n        name: String,\n    },\n    /// Collapse one dimension of `base` at `index`, `depth` layers down.\n    ///\n    /// Unlike a field access this has to store its depth. A field access leaves a record behind,\n    /// so the depth is every Vec layer of the base; an index leaves a Vec behind, so the layers\n    /// below the one being collapsed are indistinguishable from the ones above it.\n    /// A unary builtin. Unary like every other function, so it needs no special call form.\n    Builtin {\n        which: Builtin,\n        arg: Box<Tir>,\n    },\n    /// Insist an Opt is present, `depth` layers down. Like a field access and unlike an index,\n    /// the depth is every Vec layer of the base, because an Opt is not a dimension.\n    Unwrap {\n        base: Box<Tir>,\n    },\n    Index {\n        base: Box<Tir>,\n        index: Box<Tir>,\n        depth: usize,\n        /// Whether an entry is a record, which decides if collapsing has to gather columns.\n        elem_is_record: bool,\n    },\n    /// First-match-wins dispatch over the subject: variant arms test its shape, guard arms\n    /// evaluate a Bool of their own. The checker has already resolved every name a pattern\n    /// bound, so an arm is only a test, a payload local to bind, and a body.\n    ///\n    /// When the chain is total (`partial` is false) -- every variant covered, or a default at\n    /// the end -- a backend may take the last arm without a test. A partial chain has no such\n    /// arm: every test is emitted, and falling off the end produces the absent `Opt`, which is\n    /// why the node's type is then `Opt` of the arms' common body type.\n    Match {\n        subject: Box<Tir>,\n        arms: Vec<MatchArm>,\n        partial: bool,\n    },\n}\n\npub struct MatchArm {\n    /// `Some` tests the subject for this variant. `None` with a `guard` is a guard arm; `None`\n    /// with no guard is the default arm, which the checker keeps last.\n    pub variant: Option<String>,\n    /// The Bool deciding a guard arm, already checked in the subject's scope.\n    pub guard: Option<Tir>,\n    /// The local the payload binds to in a payload-variant arm; `.` and destructured field\n    /// names in the body both read through it.\n    pub payload: Option<LocalId>,\n    pub body: Tir,\n}\n\n/// The functions the language provides. Each is unary, and so is every user function: something\n/// wanting two arguments takes a record, which is what a record literal is for in argument\n/// position.\n#[derive(Clone, Copy, PartialEq, Eq)]\npub enum Builtin {\n    /// `str(n)`, rendering an Int the way the printer does but reachable from a program.\n    IntToStr,\n    /// `i64(n)`, `Int -> Int64`: the one bridge between the two integer types, explicit\n    /// because nothing widens implicitly (kantord/toylang#83). A no-op on every backend whose\n    /// runtime integers are already 64 bits wide; JS builds a BigInt, and Go and Rust spell\n    /// the cast.\n    IntToI64,\n    /// `range(n)`, the integers from zero up to but not including n. Zero-based, matching jq,\n    /// Python, and this language's own indices.\n    Range,\n    /// `collect(s)`, `Stream<T> -> Vec<T>`: the one place a stream stops being a stream. What\n    /// comes back is an ordinary value, exactly as sized as it needs to be, with no trace left\n    /// of how it arrived.\n    Collect,\n    /// `jsonlines(v)`, printing each element of a `Vec<T>` on its own line rather than wrapping\n    /// the whole thing in `[...]`. Named for the format (jsonlines.org, also called NDJSON):\n    /// one JSON value per line. Polymorphic over the element type, so it is not in the fixed\n    /// signature table `builtin()` reads from; `synth` checks it directly, the way `map` and\n    /// `select` are checked from their own arm rather than through a table.\n    JsonLines,\n    /// `length(v)`, a Vec's length. A dense Vec already tracks this at runtime, so reading it out\n    /// costs nothing -- there is no fold or scan hiding behind the name.\n    Length,\n    /// `flatten(vv)`, flattening a `Vec<Vec<T>>` into one `Vec<T>`, for the case where the\n    /// number of inner Vecs is not known at the call site. Joining a fixed, known count of Vecs\n    /// is `+` instead (kantord/toylang#97, the add-trait reading of Q2 in plans/questions.md); this\n    /// builtin used to be named `concat` and cover both cases before that split.\n    Flatten,\n    /// `tail(v)`, every element but the first, `None` when `v` is empty. Consistent with how\n    /// `Index` already turns \"reaching past what's there\" into `Opt` rather than a runtime\n    /// failure.\n    Tail,\n    /// `fields(r)`, a record's field names in declaration order (kantord/toylang#63, the\n    /// accessor #60's ratification promised once order left type identity). The names come from\n    /// `r`'s checked type, not its runtime value, so every backend can emit them as a literal;\n    /// `r` is still evaluated for whatever it would otherwise do, the same as any other argument.\n    Fields,\n    /// `chars(s)`, `Str -> Vec<Char>`: every Unicode scalar value in `s`, in order. Decoded by\n    /// codepoint on every backend, so a character outside the Basic Multilingual Plane is one\n    /// element here even on a target whose own strings need a surrogate pair to spell it\n    /// (kantord/toylang#75).\n    Chars,\n    /// `sort(v)`, `Vec<T> -> Vec<T>`: `v`'s elements in ascending order by the same total order\n    /// `<` already gives `T`. One value in, one value out with no lawful Stream instance\n    /// (kantord/toylang#86, Q20 in plans/questions.md), so it is checked as a Vec-only builtin the way\n    /// `length`/`tail`/`flatten` are rather than through `select`/`map`'s cardinality\n    /// polymorphism. Restricted to the element types ordering already typechecks on --\n    /// Int, Int64, Str, Char -- so every backend can reach for its native ordering.\n    Sort,\n    /// `reverse(v)`, `Vec<T> -> Vec<T>`: `v`'s elements in the opposite order. Blocking for the\n    /// same reason `sort` is (the whole Vec has to be there before the first output element\n    /// is), but unrestricted in element type, since reversing needs no comparison.\n    Reverse,\n    /// `sum(v)`, the reduction of `+` over `v`'s elements, at the element type's own width: a\n    /// `Vec<Int>` sums to `Int`, a `Vec<Int64>` to `Int64`, and an empty Vec sums to 0. Each\n    /// addition wraps the way the language's `+` does, so a sum that leaves the width is the\n    /// same number a hand-written fold would produce (kantord/toylang#140).\n    Sum,\n    /// `max(v)`, the greatest of `v`'s elements, `Opt<T>` because an empty Vec has no maximum\n    /// -- the same answer indexing gives to absence (kantord/toylang#140). Restricted to the\n    /// same two integer element types `sum` takes, so a backend can reach for its native\n    /// maximum.\n    Max,\n}\n\npub struct Func {\n    pub name: String,\n    /// `None` for a nullary function.\n    pub param: Option<String>,\n    pub param_ty: Option<Type>,\n    pub body: Tir,\n}\n\npub struct Program {\n    pub funcs: Vec<Func>,\n    pub body: Tir,\n    /// The type stdin must have, if the program reads it.\n    pub input: Option<Type>,\n    /// The element type each line of stdin parses as, if the program reads `inputs`.\n    pub inputs: Option<Type>,\n    /// Whether the program reads `lines`. A separate flag from `input`, since the two are\n    /// unrelated readers of the same real stdin and a program using `lines` alone still needs\n    /// it connected, even though `input` is `None`.\n    pub uses_lines: bool,\n    /// Every enum the program declared, the prelude's included. A backend has no checker `Ctx`\n    /// to hand, and the variant list on a `Type::Enum` is a placeholder wherever a recursive\n    /// enum's payload reaches back to itself, so this travels with the tree: it is what\n    /// `ty::variants` re-derives from (kantord/toylang#94).\n    pub enums: Enums,\n}\n\n/// The element type a backend iterates over. Under eager lowering a stream is materialized as\n/// the Vec of its entries, so a Stream's element counts exactly as a Vec's here; the checker's\n/// `Type::elem` deliberately does not agree, keeping the reducers Vec-only at the surface.\npub fn runtime_elem(ty: &Type) -> Option<&Type> {\n    match ty {\n        Type::Vec(t) | Type::Stream(t) => Some(t),\n        _ => None,\n    }\n}\n\n/// How many dimension layers wrap a scalar -- `Vec`s, plus the outermost `Stream` when there\n/// is one. Field access distributes over each of them.\npub fn vec_depth(ty: &Type) -> usize {\n    let mut depth = 0;\n    let mut inner = ty;\n    while let Some(elem) = runtime_elem(inner) {\n        depth += 1;\n        inner = elem;\n    }\n    depth\n}\n\n/// One `map`/`select` applied between reading a record and printing it, in source order (the\n/// stage nearest the source first).\npub enum Stage<'a> {\n    Map { param: LocalId, body: &'a Tir },\n    Select { param: LocalId, pred: &'a Tir },\n}\n\n/// What a fused loop reads one entry at a time: parsed JSON values, or raw lines.\n#[derive(Clone, Copy, PartialEq, Eq)]\npub enum Source {\n    Inputs,\n    Lines,\n}\n\n/// A stream-typed pipeline ending in `jsonlines`, compiled as a read-one/transform-one/\n/// write-one loop. Decided by the types, not by a structural guess: the old `recognize_fusion`\n/// pattern match retired when `Stream` entered the type grammar (plans/streams.md step 5), so\n/// whether a program streams is now exactly whether its types say so.\npub struct Fusion<'a> {\n    pub source: Source,\n    pub stages: Vec<Stage<'a>>,\n}\n\n/// What a stream chain bottoms out at: a source, a function's own parameter, or the local a\n/// `|` bound.\nenum Base<'a> {\n    Inputs,\n    Lines,\n    Var(&'a String),\n    Local(LocalId),\n}\n\n/// Append the per-element stages of the stream-typed `t`, returning what its chain bottoms out\n/// at.\n///\n/// Total, not a recognizer: the checker leaves exactly these kinds able to carry a Stream type\n/// (sources, bindings, mappers, calls -- a conditional or match yielding one is refused, and\n/// projection is normalized to a Map), so the `unreachable!` arms are compiler bugs, never\n/// program shapes. That is the invariant this step lands: a stream-typed program that failed\n/// to fuse would silently materialize stdin, which is the defect the feature exists to remove.\nfn flatten<'a>(t: &'a Tir, program: &'a Program, stages: &mut Vec<Stage<'a>>) -> Base<'a> {\n    match &t.kind {\n        Kind::Inputs => Base::Inputs,\n        Kind::Lines => Base::Lines,\n        Kind::Var(name) => Base::Var(name),\n        Kind::Local(id) => Base::Local(*id),\n        Kind::Bind { local, value, body } => {\n            let base = flatten(value, program, stages);\n            match flatten(body, program, stages) {\n                Base::Local(id) if id == *local => base,\n                _ => unreachable!(\"a piped stream is consumed by the pipe's own body\"),\n            }\n        }\n        Kind::Map {\n            source,\n            param,\n            body,\n        } => {\n            let base = flatten(source, program, stages);\n            stages.push(Stage::Map {\n                param: *param,\n                body,\n            });\n            base\n        }\n        Kind::Select {\n            source,\n            param,\n            pred,\n        } => {\n            let base = flatten(source, program, stages);\n            stages.push(Stage::Select {\n                param: *param,\n                pred,\n            });\n            base\n        }\n        // The argument's stages first, then the callee's body inlined: its chain bottoms at\n        // its own parameter (a stream-returning function must take a stream, and linearity\n        // makes the parameter the base of whatever it returns).\n        Kind::Call { func, arg } => {\n            let f = program\n                .funcs\n                .iter()\n                .find(|f| &f.name == func)\n                .expect(\"the checker resolved every call\");\n            // A stream-returning function must take a stream (see `signatures`), so a call\n            // reaching here -- one whose result is stream-typed -- always carries an argument.\n            let arg = arg\n                .as_deref()\n                .expect(\"a stream-returning function is never nullary\");\n            let base = flatten(arg, program, stages);\n            let param = f\n                .param\n                .as_deref()\n                .expect(\"a stream-returning function is never nullary\");\n            match flatten(&f.body, program, stages) {\n                Base::Var(name) if name == param => base,\n                _ => unreachable!(\"a stream-returning function's chain bottoms at its parameter\"),\n            }\n        }\n        _ => unreachable!(\"the checker leaves no other kind stream-typed\"),\n    }\n}\n\n/// The type question `streams_inputs` used to answer by pattern match: a `jsonlines` program\n/// whose argument is stream-typed fuses, and one whose argument is a Vec (already collected)\n/// stays an ordinary value and runs eagerly, exactly as its types say.\npub fn fusion(program: &Program) -> Option<Fusion<'_>> {\n    let Kind::Builtin {\n        which: Builtin::JsonLines,\n        arg,\n    } = &program.body.kind\n    else {\n        return None;\n    };\n    if !matches!(arg.ty, Type::Stream(_)) {\n        return None;\n    }\n    let mut stages = Vec::new();\n    let source = match flatten(arg, program, &mut stages) {\n        Base::Inputs => Source::Inputs,\n        Base::Lines => Source::Lines,\n        Base::Var(_) | Base::Local(_) => {\n            unreachable!(\"a program-level stream chain bottoms at its source\")\n        }\n    };\n    Some(Fusion { source, stages })\n}\n\n/// Every enum type the program prints that can hold another of its own type, deduplicated and\n/// in the order the walk meets them.\n///\n/// A backend writes its printer by expanding a type inline, which is exactly what does not\n/// terminate on one of these. So each gets a named function the expansion can call back into\n/// instead, and this is the list of functions to write (kantord/toylang#94). Only what is\n/// printed: a program can hold a recursive value, match on it and print an Int, and a printer\n/// nobody calls is dead code that Go, at least, would then demand an import for.\npub fn printed_recursive_enums(program: &Program) -> Vec<Type> {\n    let mut printed = vec![program.body.ty.clone()];\n    let mut collect_printed = |t: &Tir| {\n        if let Kind::Builtin {\n            which: Builtin::JsonLines,\n            arg,\n        } = &t.kind\n        {\n            printed.push(\n                runtime_elem(&arg.ty)\n                    .expect(\"jsonlines takes a Vec or a stream\")\n                    .clone(),\n            );\n        }\n    };\n    for f in &program.funcs {\n        each_node(&f.body, &mut collect_printed);\n    }\n    each_node(&program.body, &mut collect_printed);\n\n    let mut found = Vec::new();\n    let mut seen = Vec::new();\n    for ty in &printed {\n        reachable_enums(&program.enums, ty, &mut seen, &mut found);\n    }\n    found.retain(|ty| crate::ty::is_recursive(&program.enums, ty));\n    found\n}\n\n/// Append every enum type nested anywhere in `ty` to `found`, descending through payloads read\n/// from the registry rather than off the type. `seen` is what stops a recursive one: its own\n/// payload leads back to a type already visited.\nfn reachable_enums(enums: &Enums, ty: &Type, seen: &mut Vec<Type>, found: &mut Vec<Type>) {\n    match ty {\n        Type::Vec(e) | Type::Stream(e) => reachable_enums(enums, e, seen, found),\n        Type::Record(fields) => {\n            for (_, f) in fields {\n                reachable_enums(enums, f, seen, found);\n            }\n        }\n        Type::Enum { name, args, .. } => {\n            if seen.contains(ty) {\n                return;\n            }\n            seen.push(ty.clone());\n            found.push(ty.clone());\n            for arg in args {\n                reachable_enums(enums, arg, seen, found);\n            }\n            for (_, payload) in crate::ty::variants_of(enums, name, args) {\n                if let Some(p) = payload {\n                    reachable_enums(enums, &p, seen, found);\n                }\n            }\n        }\n        _ => {}\n    }\n}\n\n/// Every node in the tree, `t` itself included, in no particular order. The backends each walk\n/// the tree their own way, gathering what their own target needs; this is for the questions\n/// that are the same on every target.\nfn each_node(t: &Tir, f: &mut impl FnMut(&Tir)) {\n    f(t);\n    match &t.kind {\n        Kind::Str(_)\n        | Kind::Int(_)\n        | Kind::Var(_)\n        | Kind::Local(_)\n        | Kind::Input\n        | Kind::Inputs\n        | Kind::Lines => {}\n        Kind::VecLit(items) => items.iter().for_each(|i| each_node(i, f)),\n        Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| each_node(v, f)),\n        Kind::EnumLit { payload, .. } => {\n            if let Some(p) = payload {\n                each_node(p, f);\n            }\n        }\n        Kind::Call { arg, .. } => {\n            if let Some(a) = arg {\n                each_node(a, f);\n            }\n        }\n        Kind::Concat(l, r)\n        | Kind::Compare { lhs: l, rhs: r, .. }\n        | Kind::Logic { lhs: l, rhs: r, .. }\n        | Kind::Arith { lhs: l, rhs: r, .. } => {\n            each_node(l, f);\n            each_node(r, f);\n        }\n        Kind::Not(base) => each_node(base, f),\n        Kind::Cond {\n            cond,\n            then,\n            otherwise,\n        } => {\n            each_node(cond, f);\n            each_node(then, f);\n            each_node(otherwise, f);\n        }\n        Kind::Bind { value, body, .. } => {\n            each_node(value, f);\n            each_node(body, f);\n        }\n        Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n            each_node(source, f);\n            each_node(body, f);\n        }\n        Kind::Select { source, pred, .. } => {\n            each_node(source, f);\n            each_node(pred, f);\n        }\n        Kind::Field { base, .. } | Kind::Unwrap { base } => each_node(base, f),\n        Kind::Builtin { arg, .. } => each_node(arg, f),\n        Kind::Index { base, index, .. } => {\n            each_node(base, f);\n            each_node(index, f);\n        }\n        Kind::Match { subject, arms, .. } => {\n            each_node(subject, f);\n            for arm in arms {\n                if let Some(g) = &arm.guard {\n                    each_node(g, f);\n                }\n                each_node(&arm.body, f);\n            }\n        }\n    }\n}\n\n/// Whether `t` makes a self-call to `name` in a tail position: a call whose result is the\n/// function's result, with nothing left to do after it. This is what lets the js and py\n/// emitters lower a self-tail-recursive function to a loop, the constant-stack contract\n/// (kantord/toylang#141).\n///\n/// Only `Cond` branches, a total `Match`'s arm bodies, and a `Bind`'s body put their child in\n/// tail position; a partial `Match` wraps every arm body in `{some: ...}`, so nothing there is\n/// a tail call, and a call feeding an operator (`f(x) + 1`) is a genuine recursion the contract\n/// does not cover.\npub fn has_tail_call(name: &str, t: &Tir) -> bool {\n    match &t.kind {\n        Kind::Call { func, .. } => func == name,\n        Kind::Cond { then, otherwise, .. } => {\n            has_tail_call(name, then) || has_tail_call(name, otherwise)\n        }\n        Kind::Bind { body, .. } => has_tail_call(name, body),\n        Kind::Match { arms, partial, .. } if !partial => {\n            arms.iter().any(|a| has_tail_call(name, &a.body))\n        }\n        _ => false,\n    }\n}","lineStart":1,"lineEnd":586,"totalLines":586,"truncated":false}},"title":"src/tir.rs","time":{"start":1788129606740,"end":1788129606747}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me read the key files: tir.rs (Builtin enum, fusion, Program), check/mod.rs (checker, builtin signatures), prelude.rs, and one corpus yaml + tests/corpus.rs. Let me also understand emit structure. Let me read tir.rs first.","format":"unknown","index":0}]}},"id":"prt_054d47b3400144Pamd23vh4d1O","sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","messageID":"msg_054d46b60001rbhO6MUuSBn11X"}}
{"type":"step_finish","timestamp":1788129606817,"sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","part":{"id":"prt_054d47c99001oCL8YZj0Ioy5bi","reason":"tool-calls","snapshot":"5a1012ab7eb7388a8de2a55a732be7fdbf823735","messageID":"msg_054d46b60001rbhO6MUuSBn11X","sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","type":"step-finish","tokens":{"total":50665,"input":20844,"output":66,"reasoning":59,"cache":{"write":0,"read":29696}},"cost":0.001852496}}
{"type":"step_start","timestamp":1788129608775,"sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","part":{"id":"prt_054d48444001OGdT2QmDzCbMYH","messageID":"msg_054d47cbe001XVRt7SEWktLQPZ","sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","snapshot":"5a1012ab7eb7388a8de2a55a732be7fdbf823735","type":"step-start"}}
{"type":"tool_use","timestamp":1788129615909,"sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-a1ffbe8d840b5f1c","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-158/tests/corpus.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-158/tests/corpus.rs</path>\n<type>file</type>\n<content>\n1: //! The agreement harness.\n2: //!\n3: //! One corpus, every backend. This is the check a single-backend suite cannot express: two\n4: //! backends producing different answers is a failure in its own right, separate from either of\n5: //! them producing a wrong one. The step_*.rs suites keep their own job, which is pinning error\n6: //! messages and emitted code; this is about behaviour, and behaviour is what has to be identical\n7: //! across targets.\n8: \n9: mod support;\n10: \n11: use toylang::Backend;\n12: \n13: #[test]\n14: fn every_backend_agrees_and_is_right() {\n15:     let cases = support::cases();\n16:     assert!(\n17:         !cases.is_empty(),\n18:         \"the corpus is empty, so this test proves nothing\"\n19:     );\n20: \n21:     let mut failures = Vec::new();\n22: \n23:     for case in &cases {\n24:         failures.extend(support::agreement_failures(\n25:             &case.name,\n26:             &case.program,\n27:             case.input.as_deref(),\n28:             &case.expect,\n29:         ));\n30:     }\n31: \n32:     assert!(\n33:         failures.is_empty(),\n34:         \"{} of {} corpus programs failed across {} backends:\\n{}\",\n35:         failures.len(),\n36:         cases.len(),\n37:         Backend::ALL.len(),\n38:         failures.join(\"\\n\")\n39:     );\n40: }\n41: \n42: /// What a program prints is not always the whole claim. A case that asks for it gets the code a\n43: /// backend emitted pinned as well, which is how a property invisible in the output -- a name\n44: /// that has to be declared, a type that has to be spelled -- stays observed.\n45: #[test]\n46: fn emitted_code_matches_the_snapshot() {\n47:     let mut asked = 0;\n48:     for case in support::cases() {\n49:         let program =\n50:             toylang::compile(&case.program).unwrap_or_else(|e| panic!(\"{}: {e}\", case.name));\n51:         for backend in case.snapshot {\n52:             let emitted = backend.emit(&program).unwrap_or_else(|e| {\n53:                 panic!(\"{}: {} could not emit: {e}\", case.name, backend.name())\n54:             });\n55:             insta::assert_snapshot!(format!(\"{}__{}\", case.name, backend.name()), emitted);\n56:             asked += 1;\n57:         }\n58:     }\n59:     assert!(\n60:         asked > 0,\n61:         \"no case asks for a snapshot, so this test proves nothing\"\n62:     );\n63: }\n\n(End of file - total 63 lines)\n</content>","metadata":{"preview":"//! The agreement harness.\n//!\n//! One corpus, every backend. This is the check a single-backend suite cannot express: two\n//! backends producing different answers is a failure in its own right, separate from either of\n//! them producing a wrong one. The step_*.rs suites keep their own job, which is pinning error\n//! messages and emitted code; this is about behaviour, and behaviour is what has to be identical\n//! across targets.\n\nmod support;\n\nuse toylang::Backend;\n\n#[test]\nfn every_backend_agrees_and_is_right() {\n    let cases = support::cases();\n    assert!(\n        !cases.is_empty(),\n        \"the corpus is empty, so this test proves nothing\"\n    );\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-158/tests/corpus.rs","text":"//! The agreement harness.\n//!\n//! One corpus, every backend. This is the check a single-backend suite cannot express: two\n//! backends producing different answers is a failure in its own right, separate from either of\n//! them producing a wrong one. The step_*.rs suites keep their own job, which is pinning error\n//! messages and emitted code; this is about behaviour, and behaviour is what has to be identical\n//! across targets.\n\nmod support;\n\nuse toylang::Backend;\n\n#[test]\nfn every_backend_agrees_and_is_right() {\n    let cases = support::cases();\n    assert!(\n        !cases.is_empty(),\n        \"the corpus is empty, so this test proves nothing\"\n    );\n\n    let mut failures = Vec::new();\n\n    for case in &cases {\n        failures.extend(support::agreement_failures(\n            &case.name,\n            &case.program,\n            case.input.as_deref(),\n            &case.expect,\n        ));\n    }\n\n    assert!(\n        failures.is_empty(),\n        \"{} of {} corpus programs failed across {} backends:\\n{}\",\n        failures.len(),\n        cases.len(),\n        Backend::ALL.len(),\n        failures.join(\"\\n\")\n    );\n}\n\n/// What a program prints is not always the whole claim. A case that asks for it gets the code a\n/// backend emitted pinned as well, which is how a property invisible in the output -- a name\n/// that has to be declared, a type that has to be spelled -- stays observed.\n#[test]\nfn emitted_code_matches_the_snapshot() {\n    let mut asked = 0;\n    for case in support::cases() {\n        let program =\n            toylang::compile(&case.program).unwrap_or_else(|e| panic!(\"{}: {e}\", case.name));\n        for backend in case.snapshot {\n            let emitted = backend.emit(&program).unwrap_or_else(|e| {\n                panic!(\"{}: {} could not emit: {e}\", case.name, backend.name())\n            });\n            insta::assert_snapshot!(format!(\"{}__{}\", case.name, backend.name()), emitted);\n            asked += 1;\n        }\n    }\n    assert!(\n        asked > 0,\n        \"no case asks for a snapshot, so this test proves nothing\"\n    );\n}","lineStart":1,"lineEnd":63,"totalLines":63,"truncated":false}},"title":"tests/corpus.rs","time":{"start":1788129615890,"end":1788129615904}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now I understand the TIR structure. Builtins are unary. `pipe_through` takes two args: a program name (Str) and args (Vec<Str>). In toylang, \"something wanting two arguments takes a record\". So `pipe_through(\"grep\", [\"foo\"])` would be... hmm. Actually let me look at how `pipe_through(\"grep\", [\"foo\"])` is parsed. In the syntax, function application with multiple args?\n\nLet me look at the AST and parse. Actually, let me look at how the checker handles `map` and `select` (which take a function argument), and how calls with 2 arguments parse.\n\nLet me read the check/mod.rs to understand how builtins are typed, how calls are resolved, and the sink handling. Also read prelude.rs.\n\nActually wait. Let me reconsider the scope of this task. It's genuinely large:\n\n1. Design the `pipe_through` primitive\n2. Implement in checker\n3. Implement in all backends (7 of them!)\n4. Corpus tests\n\nAnd there's the fundamental problem: the corpus requires every case to run on every backend and agree on output. jq cannot run subprocesses. Actually wait — can it? jq has no way to spawn processes. But jq DOES have `@sh`, and there's `jq` itself... no, jq can't run subprocesses.\n\nHmm wait, but maybe the design is different. Let me reconsider. The issue says \"full streaming, e.g. lines | pipe_through(\"grep\", [...]) | collect\". What if the corpus tests are `refuses: true` cases for backends that can't do it? No — \"refuses: true means they all decline to run it\".\n\nLet me re-read the AGENTS.md corpus section: \"Every case runs on every backend. `output` means they all print it and agree; `refuses: true` means they all decline to run it.\"\n\nSo there's no per-backend distinction in the corpus. That's a hard constraint. So if `pipe_through` only works on some backends, the corpus case must be a `refuses` case (all refuse) OR... hmm.\n\nWait, but the brief says \"Cover all backends and add corpus tests.\" Let me look at tests/corpus.rs to see the actual mechanics. Maybe there IS per-backend behavior I'm not aware of. Let me read it.\n\nAlso I should check: maybe pipe_through on jq CAN be implemented via `@sh` and `input`... no, jq can't spawn.\n\nLet me look at the corpus harness and how refuses works.","format":"unknown","index":0}]}},"id":"prt_054d49e08001l0DawHbB4f75Ry","sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","messageID":"msg_054d47cbe001XVRt7SEWktLQPZ"}}
{"type":"step_finish","timestamp":1788129615925,"sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","part":{"id":"prt_054d4a031001xo2JWhKBgf4L4Z","reason":"tool-calls","snapshot":"5a1012ab7eb7388a8de2a55a732be7fdbf823735","messageID":"msg_054d47cbe001XVRt7SEWktLQPZ","sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","type":"step-finish","tokens":{"total":58788,"input":18476,"output":68,"reasoning":564,"cache":{"write":0,"read":39680}},"cost":0.00194958}}
{"type":"step_start","timestamp":1788129617775,"sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","part":{"id":"prt_054d4a7640011cRCFbQinuHrVh","messageID":"msg_054d4a03e001MuUZOrzvV4RSSb","sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","snapshot":"5a1012ab7eb7388a8de2a55a732be7fdbf823735","type":"step-start"}}
{"type":"tool_use","timestamp":1788129618118,"sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-ac2b805961a42455","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-158/tests/support/mod.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-158/tests/support/mod.rs</path>\n<type>file</type>\n<content>\n1: //! Loading the corpus.\n2: //!\n3: //! One case per file. A program, the input it reads, the output it must produce and whatever\n4: //! else it asks for are one thing, and were three files that only a shared stem tied together:\n5: //! a program whose `.out` was missing was a panic at load, and a `.in.json` whose stem was\n6: //! misspelt was silently a program that reads no input.\n7: //!\n8: //! Read by both the agreement harness and the native backend's tracker, which were two copies\n9: //! of the same directory walk.\n10: \n11: #![allow(dead_code)]\n12: \n13: use std::path::{Path, PathBuf};\n14: \n15: use serde::Deserialize;\n16: \n17: /// The file as written. `deny_unknown_fields` is the point of the struct: a misspelt key would\n18: /// otherwise be a case that quietly asks for nothing extra, which looks exactly like a case that\n19: /// passes.\n20: #[derive(Deserialize)]\n21: #[serde(deny_unknown_fields)]\n22: struct Fields {\n23:     program: String,\n24:     #[serde(default)]\n25:     input: Option<String>,\n26:     #[serde(default)]\n27:     output: Option<String>,\n28:     /// Set when the program compiles but every backend has to refuse to run it. What each says\n29:     /// while refusing is its own business, so only the refusal is compared.\n30:     #[serde(default)]\n31:     refuses: bool,\n32:     /// Backends whose emitted code is snapshotted for this program, for cases where what the\n33:     /// program prints is not the whole claim. Empty for most cases: running on every backend and\n34:     /// agreeing is the ordinary bar, and a snapshot on top of it is the exception.\n35:     #[serde(default)]\n36:     snapshot: Vec<String>,\n37:     /// The AST shapes this program exercises, in `toylang::tags` terms. Generated by\n38:     /// `tests/tag_corpus.rs` on every run, not hand-authored, so it is read here only to keep\n39:     /// `deny_unknown_fields` from rejecting it -- the fresh value always comes from `toylang::tags`.\n40:     #[serde(default)]\n41:     node_types: Vec<String>,\n42: }\n43: \n44: /// What every backend has to do with the program. A case says exactly one of these, because a\n45: /// case that says both, or neither, is one nobody wrote down the point of.\n46: pub enum Expect {\n47:     /// Every backend prints this, and they have to agree.\n48:     Output(String),\n49:     /// Every backend refuses to run it.\n50:     Refusal,\n51: }\n52: \n53: pub struct Case {\n54:     pub name: String,\n55:     pub program: String,\n56:     pub input: Option<String>,\n57:     pub expect: Expect,\n58:     pub snapshot: Vec<toylang::Backend>,\n59: }\n60: \n61: /// Runs `program` on every backend and reports how the run fell short of `expect`, one line per\n62: /// failure, empty when every backend did what the case asked. The corpus harness and the docs\n63: /// harness both feed programs through this: a docs fragment is a corpus case defined in prose,\n64: /// so what \"agrees\" means must be one definition, not two.\n65: pub fn agreement_failures(\n66:     name: &str,\n67:     program: &str,\n68:     input: Option<&str>,\n69:     expect: &Expect,\n70: ) -> Vec<String> {\n71:     let mut failures = Vec::new();\n72: \n73:     if let Expect::Refusal = expect {\n74:         for backend in toylang::Backend::ALL {\n75:             if let Ok(out) = toylang::run_on(program, input, backend) {\n76:                 failures.push(format!(\n77:                     \"RAN     {name}: {} produced {out:?} instead of refusing\",\n78:                     backend.name()\n79:                 ));\n80:             }\n81:         }\n82:         return failures;\n83:     }\n84:     let Expect::Output(want) = expect else {\n85:         unreachable!(\"refusal handled above\")\n86:     };\n87: \n88:     let mut outputs: Vec<(&str, String)> = Vec::new();\n89:     for backend in toylang::Backend::ALL {\n90:         // A backend that cannot run is reported, never skipped. A report saying every backend\n91:         // agreed when only one of them ran is worse than no report.\n92:         match toylang::run_on(program, input, backend) {\n93:             Ok(out) => outputs.push((backend.name(), out)),\n94:             Err(e) => failures.push(format!(\n95:                 \"BROKEN  {name}: {} could not run: {e}\",\n96:                 backend.name()\n97:             )),\n98:         }\n99:     }\n100: \n101:     if outputs.len() < toylang::Backend::ALL.len() {\n102:         return failures;\n103:     }\n104: \n105:     // Disagreement first, and reported on its own. Which backend matches the expectation is not\n106:     // the point: the language is underspecified either way.\n107:     let (_, first) = &outputs[0];\n108:     if outputs.iter().any(|(_, out)| out != first) {\n109:         let shown: Vec<String> = outputs.iter().map(|(n, o)| format!(\"{n}={o:?}\")).collect();\n110:         failures.push(format!(\"DISAGREE {name}: {}\", shown.join(\" \")));\n111:         return failures;\n112:     }\n113: \n114:     if first != want {\n115:         failures.push(format!(\n116:             \"WRONG   {name}: expected {want:?}, every backend gave {first:?}\"\n117:         ));\n118:     }\n119:     failures\n120: }\n121: \n122: pub fn dir() -> PathBuf {\n123:     Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"tests/corpus\")\n124: }\n125: \n126: pub fn cases() -> Vec<Case> {\n127:     let dir = dir();\n128:     let mut paths: Vec<PathBuf> = std::fs::read_dir(&dir)\n129:         .unwrap_or_else(|e| panic!(\"cannot read {}: {e}\", dir.display()))\n130:         .map(|e| e.expect(\"readable entry\").path())\n131:         .filter(|p| p.extension().is_some_and(|e| e == \"yaml\"))\n132:         .collect();\n133:     paths.sort();\n134: \n135:     paths\n136:         .into_iter()\n137:         .map(|path| {\n138:             let name = path\n139:                 .file_stem()\n140:                 .expect(\"has a stem\")\n141:                 .to_string_lossy()\n142:                 .into_owned();\n143:             let text = std::fs::read_to_string(&path).expect(\"readable case\");\n144:             let fields: Fields =\n145:                 serde_norway::from_str(&text).unwrap_or_else(|e| panic!(\"{name}: {e}\"));\n146:             let snapshot = fields\n147:                 .snapshot\n148:                 .iter()\n149:                 .map(|n| {\n150:                     toylang::Backend::from_name(n)\n151:                         .unwrap_or_else(|| panic!(\"{name}: `{n}` is not a backend\"))\n152:                 })\n153:                 .collect();\n154:             let expect = match (fields.output, fields.refuses) {\n155:                 (Some(output), false) => Expect::Output(output),\n156:                 (None, true) => Expect::Refusal,\n157:                 (Some(_), true) => panic!(\"{name}: has both `output` and `refuses`\"),\n158:                 (None, false) => panic!(\"{name}: has neither `output` nor `refuses`\"),\n159:             };\n160:             Case {\n161:                 name,\n162:                 program: fields.program,\n163:                 input: fields.input,\n164:                 expect,\n165:                 snapshot,\n166:             }\n167:         })\n168:         .collect()\n169: }\n\n(End of file - total 169 lines)\n</content>","metadata":{"preview":"//! Loading the corpus.\n//!\n//! One case per file. A program, the input it reads, the output it must produce and whatever\n//! else it asks for are one thing, and were three files that only a shared stem tied together:\n//! a program whose `.out` was missing was a panic at load, and a `.in.json` whose stem was\n//! misspelt was silently a program that reads no input.\n//!\n//! Read by both the agreement harness and the native backend's tracker, which were two copies\n//! of the same directory walk.\n\n#![allow(dead_code)]\n\nuse std::path::{Path, PathBuf};\n\nuse serde::Deserialize;\n\n/// The file as written. `deny_unknown_fields` is the point of the struct: a misspelt key would\n/// otherwise be a case that quietly asks for nothing extra, which looks exactly like a case that\n/// passes.\n#[derive(Deserialize)]","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-158/tests/support/mod.rs","text":"//! Loading the corpus.\n//!\n//! One case per file. A program, the input it reads, the output it must produce and whatever\n//! else it asks for are one thing, and were three files that only a shared stem tied together:\n//! a program whose `.out` was missing was a panic at load, and a `.in.json` whose stem was\n//! misspelt was silently a program that reads no input.\n//!\n//! Read by both the agreement harness and the native backend's tracker, which were two copies\n//! of the same directory walk.\n\n#![allow(dead_code)]\n\nuse std::path::{Path, PathBuf};\n\nuse serde::Deserialize;\n\n/// The file as written. `deny_unknown_fields` is the point of the struct: a misspelt key would\n/// otherwise be a case that quietly asks for nothing extra, which looks exactly like a case that\n/// passes.\n#[derive(Deserialize)]\n#[serde(deny_unknown_fields)]\nstruct Fields {\n    program: String,\n    #[serde(default)]\n    input: Option<String>,\n    #[serde(default)]\n    output: Option<String>,\n    /// Set when the program compiles but every backend has to refuse to run it. What each says\n    /// while refusing is its own business, so only the refusal is compared.\n    #[serde(default)]\n    refuses: bool,\n    /// Backends whose emitted code is snapshotted for this program, for cases where what the\n    /// program prints is not the whole claim. Empty for most cases: running on every backend and\n    /// agreeing is the ordinary bar, and a snapshot on top of it is the exception.\n    #[serde(default)]\n    snapshot: Vec<String>,\n    /// The AST shapes this program exercises, in `toylang::tags` terms. Generated by\n    /// `tests/tag_corpus.rs` on every run, not hand-authored, so it is read here only to keep\n    /// `deny_unknown_fields` from rejecting it -- the fresh value always comes from `toylang::tags`.\n    #[serde(default)]\n    node_types: Vec<String>,\n}\n\n/// What every backend has to do with the program. A case says exactly one of these, because a\n/// case that says both, or neither, is one nobody wrote down the point of.\npub enum Expect {\n    /// Every backend prints this, and they have to agree.\n    Output(String),\n    /// Every backend refuses to run it.\n    Refusal,\n}\n\npub struct Case {\n    pub name: String,\n    pub program: String,\n    pub input: Option<String>,\n    pub expect: Expect,\n    pub snapshot: Vec<toylang::Backend>,\n}\n\n/// Runs `program` on every backend and reports how the run fell short of `expect`, one line per\n/// failure, empty when every backend did what the case asked. The corpus harness and the docs\n/// harness both feed programs through this: a docs fragment is a corpus case defined in prose,\n/// so what \"agrees\" means must be one definition, not two.\npub fn agreement_failures(\n    name: &str,\n    program: &str,\n    input: Option<&str>,\n    expect: &Expect,\n) -> Vec<String> {\n    let mut failures = Vec::new();\n\n    if let Expect::Refusal = expect {\n        for backend in toylang::Backend::ALL {\n            if let Ok(out) = toylang::run_on(program, input, backend) {\n                failures.push(format!(\n                    \"RAN     {name}: {} produced {out:?} instead of refusing\",\n                    backend.name()\n                ));\n            }\n        }\n        return failures;\n    }\n    let Expect::Output(want) = expect else {\n        unreachable!(\"refusal handled above\")\n    };\n\n    let mut outputs: Vec<(&str, String)> = Vec::new();\n    for backend in toylang::Backend::ALL {\n        // A backend that cannot run is reported, never skipped. A report saying every backend\n        // agreed when only one of them ran is worse than no report.\n        match toylang::run_on(program, input, backend) {\n            Ok(out) => outputs.push((backend.name(), out)),\n            Err(e) => failures.push(format!(\n                \"BROKEN  {name}: {} could not run: {e}\",\n                backend.name()\n            )),\n        }\n    }\n\n    if outputs.len() < toylang::Backend::ALL.len() {\n        return failures;\n    }\n\n    // Disagreement first, and reported on its own. Which backend matches the expectation is not\n    // the point: the language is underspecified either way.\n    let (_, first) = &outputs[0];\n    if outputs.iter().any(|(_, out)| out != first) {\n        let shown: Vec<String> = outputs.iter().map(|(n, o)| format!(\"{n}={o:?}\")).collect();\n        failures.push(format!(\"DISAGREE {name}: {}\", shown.join(\" \")));\n        return failures;\n    }\n\n    if first != want {\n        failures.push(format!(\n            \"WRONG   {name}: expected {want:?}, every backend gave {first:?}\"\n        ));\n    }\n    failures\n}\n\npub fn dir() -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"tests/corpus\")\n}\n\npub fn cases() -> Vec<Case> {\n    let dir = dir();\n    let mut paths: Vec<PathBuf> = std::fs::read_dir(&dir)\n        .unwrap_or_else(|e| panic!(\"cannot read {}: {e}\", dir.display()))\n        .map(|e| e.expect(\"readable entry\").path())\n        .filter(|p| p.extension().is_some_and(|e| e == \"yaml\"))\n        .collect();\n    paths.sort();\n\n    paths\n        .into_iter()\n        .map(|path| {\n            let name = path\n                .file_stem()\n                .expect(\"has a stem\")\n                .to_string_lossy()\n                .into_owned();\n            let text = std::fs::read_to_string(&path).expect(\"readable case\");\n            let fields: Fields =\n                serde_norway::from_str(&text).unwrap_or_else(|e| panic!(\"{name}: {e}\"));\n            let snapshot = fields\n                .snapshot\n                .iter()\n                .map(|n| {\n                    toylang::Backend::from_name(n)\n                        .unwrap_or_else(|| panic!(\"{name}: `{n}` is not a backend\"))\n                })\n                .collect();\n            let expect = match (fields.output, fields.refuses) {\n                (Some(output), false) => Expect::Output(output),\n                (None, true) => Expect::Refusal,\n                (Some(_), true) => panic!(\"{name}: has both `output` and `refuses`\"),\n                (None, false) => panic!(\"{name}: has neither `output` nor `refuses`\"),\n            };\n            Case {\n                name,\n                program: fields.program,\n                input: fields.input,\n                expect,\n                snapshot,\n            }\n        })\n        .collect()\n}","lineStart":1,"lineEnd":169,"totalLines":169,"truncated":false}},"title":"tests/support/mod.rs","time":{"start":1788129618101,"end":1788129618115}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_054d4a76a001r46HpZay81uBMz","sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","messageID":"msg_054d4a03e001MuUZOrzvV4RSSb"}}
