{"type":"tool_use","timestamp":1788130097550,"sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-a94b344f9872ebdf","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-158/src/check/mod.rs","limit":140,"offset":340},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-158/src/check/mod.rs</path>\n<type>file</type>\n<content>\n340:             ),\n341:         ));\n342:     }\n343:     Ok(())\n344: }\n345: \n346: /// The program's own body, one call form special-cased ahead of `synth`: `jsonlines` is a sink,\n347: /// legal only here, as the outermost expression, taking a Vec or a Stream and having no result\n348: /// type at all, since nothing remains that could observe one. The Tir node still carries `Str`\n349: /// -- under eager lowering the emitted expression genuinely is the joined string every backend\n350: /// prints raw -- but no program can see that: `synth` refuses `jsonlines` everywhere else.\n351: fn check_program_body(ctx: &Ctx, body: &Expr) -> Result<Tir, Error> {\n352:     if let Expr::Call { func, arg, .. } = body\n353:         && func == \"jsonlines\"\n354:     {\n355:         let Some(arg) = arg else {\n356:             return Err(Error::new(\n357:                 body.span(),\n358:                 \"`jsonlines` needs a Vec or a stream, but was called with no argument\".to_string(),\n359:             ));\n360:         };\n361:         let arg_span = arg.span();\n362:         let arg = synth(ctx, arg)?;\n363:         if !matches!(arg.ty, Type::Vec(_) | Type::Stream(_)) {\n364:             return Err(Error::new(\n365:                 arg_span,\n366:                 format!(\"`jsonlines` needs a Vec or a stream, found {}\", arg.ty),\n367:             ));\n368:         }\n369:         if arg.ty.contains_char() {\n370:             return Err(Error::new(\n371:                 arg_span,\n372:                 format!(\n373:                     \"`jsonlines` cannot print {}; Char has no wire form to write\",\n374:                     arg.ty\n375:                 ),\n376:             ));\n377:         }\n378:         return Ok(Tir::new(\n379:             Type::Str,\n380:             Kind::Builtin {\n381:                 which: tir::Builtin::JsonLines,\n382:                 arg: Box::new(arg),\n383:             },\n384:         ));\n385:     }\n386:     synth(ctx, body)\n387: }\n388: \n389: /// Every function name the language itself provides, and therefore reserves. `str`, `range`,\n390: /// `chars`, and `i64` live in `builtin()`'s fixed table; `jsonlines`, `length`, `flatten`,\n391: /// `tail`, `collect`, `fields`, `sort`, `reverse`, `sum`, and `max` are polymorphic and checked\n392: /// from `synth`'s own arms; `select` and `map` rebind `.`. All sixteen are reserved the same\n393: /// way, and the docs harness (tests/docs.rs) reads this list to insist each one has a\n394: /// reference page.\n395: pub const BUILTIN_NAMES: [&str; 16] = [\n396:     \"chars\",\n397:     \"collect\",\n398:     \"length\",\n399:     \"fields\",\n400:     \"flatten\",\n401:     \"i64\",\n402:     \"jsonlines\",\n403:     \"map\",\n404:     \"max\",\n405:     \"range\",\n406:     \"reverse\",\n407:     \"select\",\n408:     \"sort\",\n409:     \"str\",\n410:     \"sum\",\n411:     \"tail\",\n412: ];\n413: \n414: /// Functions the language provides. Unary like every other function, so they need no special\n415: /// call syntax and are looked up before user definitions.\n416: fn builtin(name: &str) -> Option<(tir::Builtin, Sig)> {\n417:     let vec_of = |t: Type| Type::Vec(Box::new(t));\n418:     Some(match name {\n419:         \"str\" => (\n420:             tir::Builtin::IntToStr,\n421:             Sig {\n422:                 param: Some(Type::Int),\n423:                 ret: Type::Str,\n424:             },\n425:         ),\n426:         \"range\" => (\n427:             tir::Builtin::Range,\n428:             Sig {\n429:                 param: Some(Type::Int),\n430:                 ret: vec_of(Type::Int),\n431:             },\n432:         ),\n433:         \"chars\" => (\n434:             tir::Builtin::Chars,\n435:             Sig {\n436:                 param: Some(Type::Str),\n437:                 ret: vec_of(Type::Char),\n438:             },\n439:         ),\n440:         // The one bridge between the integer types (kantord/toylang#83). Its argument is an\n441:         // Int, so `i64(9000000000)` is refused like any other too-big Int literal: a wide\n442:         // value enters as a literal only where an Int64 is already expected.\n443:         \"i64\" => (\n444:             tir::Builtin::IntToI64,\n445:             Sig {\n446:                 param: Some(Type::Int),\n447:                 ret: Type::Int64,\n448:             },\n449:         ),\n450:         _ => return None,\n451:     })\n452: }\n453: \n454: /// A chain split by `rebase`: the rebased body, and the stream source it was split from.\n455: struct Rebased {\n456:     body: Tir,\n457:     source: Tir,\n458: }\n459: \n460: /// Split an access chain whose outermost dimension is a stream from its source, rebasing the\n461: /// chain on `param` as a map body: every node's type loses its Stream wrapper, and an Index's\n462: /// stored depth drops by one, since the layer it counted is now the loop.\n463: ///\n464: /// Only Field, Unwrap, and Index appear in a chain, and the source is never one of them: a\n465: /// stream-typed access chain is normalized to a Map right here, so one can never be the base of\n466: /// another.\n467: fn rebase(t: Tir, param: LocalId) -> Rebased {\n468:     fn peel(ty: Type) -> Type {\n469:         match ty {\n470:             Type::Stream(t) => *t,\n471:             other => unreachable!(\n472:                 \"every node inside the stream dimension is stream-typed, found {other}\"\n473:             ),\n474:         }\n475:     }\n476:     fn is_chain(t: &Tir) -> bool {\n477:         matches!(\n478:             t.kind,\n479:             Kind::Field { .. } | Kind::Unwrap { .. } | Kind::Index { .. }\n\n(Showing lines 340-479 of 2828. Use offset=480 to continue.)\n</content>","metadata":{"preview":"            ),\n        ));\n    }\n    Ok(())\n}\n\n/// The program's own body, one call form special-cased ahead of `synth`: `jsonlines` is a sink,\n/// legal only here, as the outermost expression, taking a Vec or a Stream and having no result\n/// type at all, since nothing remains that could observe one. The Tir node still carries `Str`\n/// -- under eager lowering the emitted expression genuinely is the joined string every backend\n/// prints raw -- but no program can see that: `synth` refuses `jsonlines` everywhere else.\nfn check_program_body(ctx: &Ctx, body: &Expr) -> Result<Tir, Error> {\n    if let Expr::Call { func, arg, .. } = body\n        && func == \"jsonlines\"\n    {\n        let Some(arg) = arg else {\n            return Err(Error::new(\n                body.span(),\n                \"`jsonlines` needs a Vec or a stream, but was called with no argument\".to_string(),\n            ));","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-158/src/check/mod.rs","text":"            ),\n        ));\n    }\n    Ok(())\n}\n\n/// The program's own body, one call form special-cased ahead of `synth`: `jsonlines` is a sink,\n/// legal only here, as the outermost expression, taking a Vec or a Stream and having no result\n/// type at all, since nothing remains that could observe one. The Tir node still carries `Str`\n/// -- under eager lowering the emitted expression genuinely is the joined string every backend\n/// prints raw -- but no program can see that: `synth` refuses `jsonlines` everywhere else.\nfn check_program_body(ctx: &Ctx, body: &Expr) -> Result<Tir, Error> {\n    if let Expr::Call { func, arg, .. } = body\n        && func == \"jsonlines\"\n    {\n        let Some(arg) = arg else {\n            return Err(Error::new(\n                body.span(),\n                \"`jsonlines` needs a Vec or a stream, but was called with no argument\".to_string(),\n            ));\n        };\n        let arg_span = arg.span();\n        let arg = synth(ctx, arg)?;\n        if !matches!(arg.ty, Type::Vec(_) | Type::Stream(_)) {\n            return Err(Error::new(\n                arg_span,\n                format!(\"`jsonlines` needs a Vec or a stream, found {}\", arg.ty),\n            ));\n        }\n        if arg.ty.contains_char() {\n            return Err(Error::new(\n                arg_span,\n                format!(\n                    \"`jsonlines` cannot print {}; Char has no wire form to write\",\n                    arg.ty\n                ),\n            ));\n        }\n        return Ok(Tir::new(\n            Type::Str,\n            Kind::Builtin {\n                which: tir::Builtin::JsonLines,\n                arg: Box::new(arg),\n            },\n        ));\n    }\n    synth(ctx, body)\n}\n\n/// Every function name the language itself provides, and therefore reserves. `str`, `range`,\n/// `chars`, and `i64` live in `builtin()`'s fixed table; `jsonlines`, `length`, `flatten`,\n/// `tail`, `collect`, `fields`, `sort`, `reverse`, `sum`, and `max` are polymorphic and checked\n/// from `synth`'s own arms; `select` and `map` rebind `.`. All sixteen are reserved the same\n/// way, and the docs harness (tests/docs.rs) reads this list to insist each one has a\n/// reference page.\npub const BUILTIN_NAMES: [&str; 16] = [\n    \"chars\",\n    \"collect\",\n    \"length\",\n    \"fields\",\n    \"flatten\",\n    \"i64\",\n    \"jsonlines\",\n    \"map\",\n    \"max\",\n    \"range\",\n    \"reverse\",\n    \"select\",\n    \"sort\",\n    \"str\",\n    \"sum\",\n    \"tail\",\n];\n\n/// Functions the language provides. Unary like every other function, so they need no special\n/// call syntax and are looked up before user definitions.\nfn builtin(name: &str) -> Option<(tir::Builtin, Sig)> {\n    let vec_of = |t: Type| Type::Vec(Box::new(t));\n    Some(match name {\n        \"str\" => (\n            tir::Builtin::IntToStr,\n            Sig {\n                param: Some(Type::Int),\n                ret: Type::Str,\n            },\n        ),\n        \"range\" => (\n            tir::Builtin::Range,\n            Sig {\n                param: Some(Type::Int),\n                ret: vec_of(Type::Int),\n            },\n        ),\n        \"chars\" => (\n            tir::Builtin::Chars,\n            Sig {\n                param: Some(Type::Str),\n                ret: vec_of(Type::Char),\n            },\n        ),\n        // The one bridge between the integer types (kantord/toylang#83). Its argument is an\n        // Int, so `i64(9000000000)` is refused like any other too-big Int literal: a wide\n        // value enters as a literal only where an Int64 is already expected.\n        \"i64\" => (\n            tir::Builtin::IntToI64,\n            Sig {\n                param: Some(Type::Int),\n                ret: Type::Int64,\n            },\n        ),\n        _ => return None,\n    })\n}\n\n/// A chain split by `rebase`: the rebased body, and the stream source it was split from.\nstruct Rebased {\n    body: Tir,\n    source: Tir,\n}\n\n/// Split an access chain whose outermost dimension is a stream from its source, rebasing the\n/// chain on `param` as a map body: every node's type loses its Stream wrapper, and an Index's\n/// stored depth drops by one, since the layer it counted is now the loop.\n///\n/// Only Field, Unwrap, and Index appear in a chain, and the source is never one of them: a\n/// stream-typed access chain is normalized to a Map right here, so one can never be the base of\n/// another.\nfn rebase(t: Tir, param: LocalId) -> Rebased {\n    fn peel(ty: Type) -> Type {\n        match ty {\n            Type::Stream(t) => *t,\n            other => unreachable!(\n                \"every node inside the stream dimension is stream-typed, found {other}\"\n            ),\n        }\n    }\n    fn is_chain(t: &Tir) -> bool {\n        matches!(\n            t.kind,\n            Kind::Field { .. } | Kind::Unwrap { .. } | Kind::Index { .. }","lineStart":340,"lineEnd":479,"totalLines":2828,"truncated":true}},"title":"src/check/mod.rs","time":{"start":1788130097540,"end":1788130097549}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_054dbf661001VPPn00FJlCPh0I","sessionID":"ses_fab2d85e2ffebDq1A7tlFaR4vv","messageID":"msg_054dbf0ec001Lhw4MNc30k2mMr"}}
