t, compare.ge, inputs, int, local, map-over, pipe, projection, selection.narrow, var]\n\n\n/home/kantord/.local/share/toylang-lanes/issue-158/tests/corpus/join_lines_one.yaml:\n  Line 1: # join_lines is prelude.toy source now, not a per-backend builtin -- pinned on two backends of\n\n  Line 12: node_types: [application, builtin.length, builtin.tail, compare.eq, concat, conditional, int, selection.collapse, str, unwrap, var, vec-literal]\n\n\n/home/kantord/.local/share/toylang-lanes/issue-158/tests/corpus/join_basic.yaml:\n  Line 10: node_types: [application, builtin.length, builtin.tail, compare.eq, concat, conditional, int, selection.collapse, str, unwrap, var, vec-literal]\n\n\n/home/kantord/.local/share/toylang-lanes/issue-158/tests/corpus/input_typed_by_first_use.yaml:\n  Line 15: node_types: [application, builtin.length, input, record-literal, var]\n\n\n/home/kantord/.local/share/toylang-lanes/issue-158/tests/corpus/int64_compare.yaml:\n  Line 10: node_types: [application, builtin.i64, compare.gt, conditional, int, int64, str]\n\n\n/home/kantord/.local/share/toylang-lanes/issue-158/tests/corpus/inputs_scalars.yaml:\n  Line 17: node_types: [application, builtin.collect, builtin.length, inputs, var]\n\n\n/home/kantord/.local/share/toylang-lanes/issue-158/tests/corpus/lines_preserve_crlf.yaml:\n  Line 12: node_types: [application, builtin.collect, builtin.length, builtin.tail, compare.eq, concat, conditional, int, lines, selection.collapse, str, unwrap, var]\n\n\n/home/kantord/.local/share/toylang-lanes/issue-158/tests/corpus/map_records.yaml:\n  Line 13: node_types: [application, builtin.str, concat, input, local, map-over, pipe, projection, str, var]\n\n\n/home/kantord/.local/share/toylang-lanes/issue-158/tests/corpus/jsonlines_enum_stream.yaml:\n  Line 11:   jsonlines render inputs\n\n  Line 23: node_types: [application, builtin.jsonlines, inputs, local, map-over, match, pipe, projection, str, var]\n\n\n/home/kantord/.local/share/toylang-lanes/issue-158/tests/c