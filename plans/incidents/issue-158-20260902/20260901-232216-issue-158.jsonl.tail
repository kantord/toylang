{"type":"tool_use","timestamp":1788297835856,"sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-b11d1e79b4306539","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-158/tests/streaming.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-158/tests/streaming.rs</path>\n<type>file</type>\n<content>\n1: //! Liveness probes for the fused read-one/transform-one/write-one loop (see `tir::fusion`).\n2: //!\n3: //! `tests/corpus.rs` cannot see this feature at all: a fused loop and an eager \"read all of\n4: //! stdin, then print everything\" implementation produce byte-identical output for any finite\n5: //! input, so output equality alone proves nothing about *when* it arrived. What is different is\n6: //! observable only while the program is still running, which is why this file talks to a live\n7: //! child process instead of waiting for one to exit the way `toylang::run_on` does.\n8: \n9: use std::io::{BufRead, BufReader, Write};\n10: use std::process::{Child, Command, Stdio};\n11: use std::sync::mpsc;\n12: use std::time::Duration;\n13: \n14: const PROGRAM: &str = r#\"\n15: fn adults(users: Stream<{name: Str, age: Int}>) -> Stream<{name: Str}> =\n16:     users | select(.age >= 18) | map {name: .name}\n17: \n18: jsonlines(adults(inputs))\n19: \"#;\n20: \n21: /// The probe that proves the shape guess actually retired: two stream-signature functions\n22: /// composed. The old `recognize_fusion` unwrapped exactly one call whose argument was `inputs`\n23: /// itself, so `names(keep(inputs))` fell back -- silently -- to materializing all of stdin.\n24: /// Type-driven fusion reads it like any other stream pipeline.\n25: const COMPOSED: &str = r#\"\n26: fn keep(users: Stream<{name: Str, age: Int}>) -> Stream<{name: Str, age: Int}> =\n27:     users | select(.age >= 18)\n28: \n29: fn names(users: Stream<{name: Str, age: Int}>) -> Stream<{name: Str}> =\n30:     users | map {name: .name}\n31: \n32: jsonlines(names(keep(inputs)))\n33: \"#;\n34: \n35: /// A `lines`-sourced pipeline ending in `jsonlines`: a shape the old recognizer never knew\n36: /// (it demanded an `inputs` base), fused now because the types say stream.\n37: const SHOUT: &str = r#\"\n38: fn shout(names: Stream<Str>) -> Stream<Str> =\n39:     names | map(. + \"!\")\n40: \n41: jsonlines(shout(lines))\n42: \"#;\n43: \n44: const RECORD_IN: &[u8] = b\"{\\\"name\\\": \\\"ada\\\", \\\"age\\\": 36}\\n\";\n45: const RECORD_OUT: &str = r#\"{\"name\":\"ada\"}\"#;\n46: \n47: /// Sends one record, then -- without ever sending EOF -- asserts its printed line arrives within\n48: /// a short timeout. An eager implementation is still blocked reading stdin to EOF at this point\n49: /// and never gets here, which is what a timeout here would mean; the fused implementations only\n50: /// need one record to produce one line.\n51: fn assert_streams_first_record(mut child: Child, send: &[u8], expect: &str) {\n52:     let mut stdin = child.stdin.take().expect(\"piped stdin\");\n53:     let mut stdout = BufReader::new(child.stdout.take().expect(\"piped stdout\"));\n54: \n55:     stdin.write_all(send).expect(\"write first record\");\n56:     stdin.flush().expect(\"flush first record\");\n57: \n58:     let (tx, rx) = mpsc::channel();\n59:     std::thread::spawn(move || {\n60:         let mut line = String::new();\n61:         let _ = stdout.read_line(&mut line);\n62:         let _ = tx.send(line);\n63:     });\n64:     let line = rx\n65:         .recv_timeout(Duration::from_secs(5))\n66:         .expect(\"no output arrived before stdin closed -- this is reading all of stdin first, not streaming\");\n67:     assert_eq!(line.trim_end(), expect);\n68: \n69:     // Cleanup only, not part of the proof: nothing here is read again, and the child would\n70:     // otherwise sit forever waiting for stdin to close.\n71:     let _ = child.kill();\n72:     let _ = child.wait();\n73: }\n74: \n75: fn piped(mut cmd: Command) -> Child {\n76:     cmd.stdin(Stdio::piped())\n77:         .stdout(Stdio::piped())\n78:         .stderr(Stdio::piped())\n79:         .spawn()\n80:         .expect(\"spawn the child\")\n81: }\n82: \n83: /// Drives the compiled `toylang` binary itself rather than calling an `emit_*` module directly:\n84: /// the boundary that decides live vs. captured, and -- for a fused `inputs` program -- whether a\n85: /// record gets validated before a backend ever sees it, is `run_on`'s own `feed` handling in\n86: /// `lib.rs`, reachable only through the CLI's real, unset stdin. Lua has no other way to reach\n87: /// that boundary at all, since it runs embedded via `mlua` rather than as a subprocess `run_on`\n88: /// spawns and pipes to like every other backend.\n89: fn spawn_cli(program: &str, backend: &str) -> Child {\n90:     let dir = tempfile::tempdir().expect(\"temp dir\");\n91:     let path = dir.path().join(\"program.toy\");\n92:     std::fs::write(&path, program).expect(\"write program\");\n93: \n94:     let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_toylang\"));\n95:     cmd.arg(\"run\").arg(&path).arg(backend);\n96:     // The dir must outlive the child's own read of the source, and the child outlives this\n97:     // function, so leak it for the test's short life rather than racing the cleanup.\n98:     std::mem::forget(dir);\n99:     piped(cmd)\n100: }\n101: \n102: fn spawn_lua(program: &str) -> Child {\n103:     spawn_cli(program, \"lua\")\n104: }\n105: \n106: fn spawn_native(program: &str) -> Child {\n107:     let program = toylang::compile(program).expect(\"compiles\");\n108:     let dir = tempfile::tempdir().expect(\"temp dir\");\n109:     let exe = dir.path().join(\"program\");\n110:     toylang::link(&program, &exe).expect(\"compiles and links\");\n111:     let cmd = Command::new(&exe);\n112:     std::mem::forget(dir);\n113:     piped(cmd)\n114: }\n115: \n116: fn spawn_rust(program: &str) -> Child {\n117:     let program = toylang::compile(program).expect(\"compiles\");\n118:     let source = toylang::emit_rs::emit(&program);\n119:     let dir = tempfile::tempdir().expect(\"temp dir\");\n120:     let exe = dir.path().join(\"program\");\n121:     toylang::link_rust(&source, &exe).expect(\"compiles with rustc\");\n122:     let cmd = Command::new(&exe);\n123:     std::mem::forget(dir);\n124:     piped(cmd)\n125: }\n126: \n127: /// The shape `spawn_go`, `spawn_py`, and `spawn_js` share: emit a backend's source to a temp\n128: /// file, then hand it to that backend's own interpreter. `args_before` is `go run`'s subcommand,\n129: /// which comes before the path; `python3` and `node` take the path as their only argument.\n130: fn spawn_interpreted(\n131:     program: &str,\n132:     emit: impl Fn(&toylang::tir::Program) -> String,\n133:     filename: &str,\n134:     interpreter: &str,\n135:     args_before: &[&str],\n136: ) -> Child {\n137:     let program = toylang::compile(program).expect(\"compiles\");\n138:     let source = emit(&program);\n139:     let dir = tempfile::tempdir().expect(\"temp dir\");\n140:     let path = dir.path().join(filename);\n141:     std::fs::write(&path, source).expect(\"write source\");\n142: \n143:     let mut cmd = Command::new(interpreter);\n144:     cmd.args(args_before).arg(&path);\n145:     std::mem::forget(dir);\n146:     piped(cmd)\n147: }\n148: \n149: fn spawn_go(program: &str) -> Child {\n150:     spawn_interpreted(program, toylang::emit_go::emit, \"main.go\", \"go\", &[\"run\"])\n151: }\n152: \n153: fn spawn_py(program: &str) -> Child {\n154:     spawn_interpreted(\n155:         program,\n156:         toylang::emit_py::emit,\n157:         \"program.py\",\n158:         \"python3\",\n159:         &[],\n160:     )\n161: }\n162: \n163: fn spawn_js(program: &str) -> Child {\n164:     spawn_interpreted(program, toylang::emit_js::emit, \"program.js\", \"node\", &[])\n165: }\n166: \n167: fn spawn_jq(program: &str) -> Child {\n168:     let program = toylang::compile(program).expect(\"compiles\");\n169:     let source = toylang::emit_jq::emit(&program).expect(\"compiles for jq\");\n170: \n171:     let mut cmd = Command::new(\"jq\");\n172:     cmd.arg(\"--unbuffered\").arg(\"-c\").arg(\"-n\").arg(\"-r\");\n173:     if program.uses_lines {\n174:         cmd.arg(\"-R\");\n175:     }\n176:     cmd.arg(&source);\n177:     piped(cmd)\n178: }\n179: \n180: #[test]\n181: fn lua_streams() {\n182:     assert_streams_first_record(spawn_lua(PROGRAM), RECORD_IN, RECORD_OUT);\n183: }\n184: \n185: #[test]\n186: fn native_streams() {\n187:     assert_streams_first_record(spawn_native(PROGRAM), RECORD_IN, RECORD_OUT);\n188: }\n189: \n190: #[test]\n191: fn rust_streams() {\n192:     assert_streams_first_record(spawn_rust(PROGRAM), RECORD_IN, RECORD_OUT);\n193: }\n194: \n195: #[test]\n196: fn go_streams() {\n197:     assert_streams_first_record(spawn_go(PROGRAM), RECORD_IN, RECORD_OUT);\n198: }\n199: \n200: #[test]\n201: fn py_streams() {\n202:     assert_streams_first_record(spawn_py(PROGRAM), RECORD_IN, RECORD_OUT);\n203: }\n204: \n205: #[test]\n206: fn js_streams() {\n207:     assert_streams_first_record(spawn_js(PROGRAM), RECORD_IN, RECORD_OUT);\n208: }\n209: \n210: #[test]\n211: fn jq_streams() {\n212:     assert_streams_first_record(spawn_jq(PROGRAM), RECORD_IN, RECORD_OUT);\n213: }\n214: \n215: #[test]\n216: fn lua_streams_composed_functions() {\n217:     assert_streams_first_record(spawn_lua(COMPOSED), RECORD_IN, RECORD_OUT);\n218: }\n219: \n220: #[test]\n221: fn native_streams_composed_functions() {\n222:     assert_streams_first_record(spawn_native(COMPOSED), RECORD_IN, RECORD_OUT);\n223: }\n224: \n225: #[test]\n226: fn rust_streams_composed_functions() {\n227:     assert_streams_first_record(spawn_rust(COMPOSED), RECORD_IN, RECORD_OUT);\n228: }\n229: \n230: #[test]\n231: fn go_streams_composed_functions() {\n232:     assert_streams_first_record(spawn_go(COMPOSED), RECORD_IN, RECORD_OUT);\n233: }\n234: \n235: #[test]\n236: fn py_streams_composed_functions() {\n237:     assert_streams_first_record(spawn_py(COMPOSED), RECORD_IN, RECORD_OUT);\n238: }\n239: \n240: #[test]\n241: fn js_streams_composed_functions() {\n242:     assert_streams_first_record(spawn_js(COMPOSED), RECORD_IN, RECORD_OUT);\n243: }\n244: \n245: #[test]\n246: fn jq_streams_composed_functions() {\n247:     assert_streams_first_record(spawn_jq(COMPOSED), RECORD_IN, RECORD_OUT);\n248: }\n249: \n250: /// One interpreted and one compiled backend for the `lines` source; the output equality of the\n251: /// shape on all seven is `jsonlines_of_lines.yaml`'s job.\n252: #[test]\n253: fn py_streams_lines() {\n254:     assert_streams_first_record(spawn_py(SHOUT), b\"ada\\n\", r#\"\"ada!\"\"#);\n255: }\n256: \n257: #[test]\n258: fn native_streams_lines() {\n259:     assert_streams_first_record(spawn_native(SHOUT), b\"ada\\n\", r#\"\"ada!\"\"#);\n260: }\n261: \n262: /// `tests/corpus/enum_inputs_reject.yaml` pins this program's real `run_on` behavior against a\n263: /// fixture, where validation is eager and happens before anything runs. A real command-line run\n264: /// has no such up-front check to lean on (issue #15): `render`'s emitted code just trusted\n265: /// `JSON.parse` to produce a valid `Msg`, so live and fixture runs disagreed on every backend but\n266: /// Lua, which validates through its own embedded host function rather than a subprocess's code at\n267: /// all. This is the same program and the same bad record, driven through the real CLI with real,\n268: /// unset stdin instead of `run_on`'s fixture path, to prove the two now agree.\n269: const REJECT: &str = r#\"\n270: enum Msg { ping, text{body: Str} }\n271: \n272: fn render(msgs: Stream<Msg>) -> Stream<Str> =\n273:     msgs | map(. | text -> .body or any() -> \"*ping*\")\n274: \n275: jsonlines(render(inputs))\n276: \"#;\n277: \n278: /// The valid record ahead of the bad one still streams before the refusal ends the run: a live\n279: /// refusal can only stop the records after the one it caught, not retroactively un-print ones\n280: /// that already passed validation and reached the backend.\n281: #[test]\n282: fn js_streams_a_valid_record_before_a_later_one_fails_live_validation() {\n283:     assert_streams_first_record(spawn_cli(REJECT, \"js\"), b\"\\\"ping\\\"\\n\", r#\"\"*ping*\"\"#);\n284: }\n285: \n286: fn assert_refuses_live(backend: &str) {\n287:     let mut child = spawn_cli(REJECT, backend);\n288:     child\n289:         .stdin\n290:         .take()\n291:         .expect(\"piped stdin\")\n292:         .write_all(b\"\\\"ping\\\"\\n\\\"burst\\\"\\n\")\n293:         .expect(\"write both records\");\n294:     let output = child.wait_with_output().expect(\"wait for exit\");\n295:     assert!(\n296:         !output.status.success(),\n297:         \"{backend} exited successfully on a record no variant of Msg names\"\n298:     );\n299:     let stderr = String::from_utf8_lossy(&output.stderr);\n300:     assert!(\n301:         stderr.contains(\"inputs: `burst` is not a variant of Msg\"),\n302:         \"{backend} stderr did not name the bad record: {stderr}\"\n303:     );\n304: }\n305: \n306: #[test]\n307: fn js_refuses_live_same_as_the_fixture() {\n308:     assert_refuses_live(\"js\");\n309: }\n310: \n311: #[test]\n312: fn go_refuses_live_same_as_the_fixture() {\n313:     assert_refuses_live(\"go\");\n314: }\n315: \n316: #[test]\n317: fn py_refuses_live_same_as_the_fixture() {\n318:     assert_refuses_live(\"py\");\n319: }\n\n(End of file - total 319 lines)\n</content>","metadata":{"preview":"//! Liveness probes for the fused read-one/transform-one/write-one loop (see `tir::fusion`).\n//!\n//! `tests/corpus.rs` cannot see this feature at all: a fused loop and an eager \"read all of\n//! stdin, then print everything\" implementation produce byte-identical output for any finite\n//! input, so output equality alone proves nothing about *when* it arrived. What is different is\n//! observable only while the program is still running, which is why this file talks to a live\n//! child process instead of waiting for one to exit the way `toylang::run_on` does.\n\nuse std::io::{BufRead, BufReader, Write};\nuse std::process::{Child, Command, Stdio};\nuse std::sync::mpsc;\nuse std::time::Duration;\n\nconst PROGRAM: &str = r#\"\nfn adults(users: Stream<{name: Str, age: Int}>) -> Stream<{name: Str}> =\n    users | select(.age >= 18) | map {name: .name}\n\njsonlines(adults(inputs))\n\"#;\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-158/tests/streaming.rs","text":"//! Liveness probes for the fused read-one/transform-one/write-one loop (see `tir::fusion`).\n//!\n//! `tests/corpus.rs` cannot see this feature at all: a fused loop and an eager \"read all of\n//! stdin, then print everything\" implementation produce byte-identical output for any finite\n//! input, so output equality alone proves nothing about *when* it arrived. What is different is\n//! observable only while the program is still running, which is why this file talks to a live\n//! child process instead of waiting for one to exit the way `toylang::run_on` does.\n\nuse std::io::{BufRead, BufReader, Write};\nuse std::process::{Child, Command, Stdio};\nuse std::sync::mpsc;\nuse std::time::Duration;\n\nconst PROGRAM: &str = r#\"\nfn adults(users: Stream<{name: Str, age: Int}>) -> Stream<{name: Str}> =\n    users | select(.age >= 18) | map {name: .name}\n\njsonlines(adults(inputs))\n\"#;\n\n/// The probe that proves the shape guess actually retired: two stream-signature functions\n/// composed. The old `recognize_fusion` unwrapped exactly one call whose argument was `inputs`\n/// itself, so `names(keep(inputs))` fell back -- silently -- to materializing all of stdin.\n/// Type-driven fusion reads it like any other stream pipeline.\nconst COMPOSED: &str = r#\"\nfn keep(users: Stream<{name: Str, age: Int}>) -> Stream<{name: Str, age: Int}> =\n    users | select(.age >= 18)\n\nfn names(users: Stream<{name: Str, age: Int}>) -> Stream<{name: Str}> =\n    users | map {name: .name}\n\njsonlines(names(keep(inputs)))\n\"#;\n\n/// A `lines`-sourced pipeline ending in `jsonlines`: a shape the old recognizer never knew\n/// (it demanded an `inputs` base), fused now because the types say stream.\nconst SHOUT: &str = r#\"\nfn shout(names: Stream<Str>) -> Stream<Str> =\n    names | map(. + \"!\")\n\njsonlines(shout(lines))\n\"#;\n\nconst RECORD_IN: &[u8] = b\"{\\\"name\\\": \\\"ada\\\", \\\"age\\\": 36}\\n\";\nconst RECORD_OUT: &str = r#\"{\"name\":\"ada\"}\"#;\n\n/// Sends one record, then -- without ever sending EOF -- asserts its printed line arrives within\n/// a short timeout. An eager implementation is still blocked reading stdin to EOF at this point\n/// and never gets here, which is what a timeout here would mean; the fused implementations only\n/// need one record to produce one line.\nfn assert_streams_first_record(mut child: Child, send: &[u8], expect: &str) {\n    let mut stdin = child.stdin.take().expect(\"piped stdin\");\n    let mut stdout = BufReader::new(child.stdout.take().expect(\"piped stdout\"));\n\n    stdin.write_all(send).expect(\"write first record\");\n    stdin.flush().expect(\"flush first record\");\n\n    let (tx, rx) = mpsc::channel();\n    std::thread::spawn(move || {\n        let mut line = String::new();\n        let _ = stdout.read_line(&mut line);\n        let _ = tx.send(line);\n    });\n    let line = rx\n        .recv_timeout(Duration::from_secs(5))\n        .expect(\"no output arrived before stdin closed -- this is reading all of stdin first, not streaming\");\n    assert_eq!(line.trim_end(), expect);\n\n    // Cleanup only, not part of the proof: nothing here is read again, and the child would\n    // otherwise sit forever waiting for stdin to close.\n    let _ = child.kill();\n    let _ = child.wait();\n}\n\nfn piped(mut cmd: Command) -> Child {\n    cmd.stdin(Stdio::piped())\n        .stdout(Stdio::piped())\n        .stderr(Stdio::piped())\n        .spawn()\n        .expect(\"spawn the child\")\n}\n\n/// Drives the compiled `toylang` binary itself rather than calling an `emit_*` module directly:\n/// the boundary that decides live vs. captured, and -- for a fused `inputs` program -- whether a\n/// record gets validated before a backend ever sees it, is `run_on`'s own `feed` handling in\n/// `lib.rs`, reachable only through the CLI's real, unset stdin. Lua has no other way to reach\n/// that boundary at all, since it runs embedded via `mlua` rather than as a subprocess `run_on`\n/// spawns and pipes to like every other backend.\nfn spawn_cli(program: &str, backend: &str) -> Child {\n    let dir = tempfile::tempdir().expect(\"temp dir\");\n    let path = dir.path().join(\"program.toy\");\n    std::fs::write(&path, program).expect(\"write program\");\n\n    let mut cmd = Command::new(env!(\"CARGO_BIN_EXE_toylang\"));\n    cmd.arg(\"run\").arg(&path).arg(backend);\n    // The dir must outlive the child's own read of the source, and the child outlives this\n    // function, so leak it for the test's short life rather than racing the cleanup.\n    std::mem::forget(dir);\n    piped(cmd)\n}\n\nfn spawn_lua(program: &str) -> Child {\n    spawn_cli(program, \"lua\")\n}\n\nfn spawn_native(program: &str) -> Child {\n    let program = toylang::compile(program).expect(\"compiles\");\n    let dir = tempfile::tempdir().expect(\"temp dir\");\n    let exe = dir.path().join(\"program\");\n    toylang::link(&program, &exe).expect(\"compiles and links\");\n    let cmd = Command::new(&exe);\n    std::mem::forget(dir);\n    piped(cmd)\n}\n\nfn spawn_rust(program: &str) -> Child {\n    let program = toylang::compile(program).expect(\"compiles\");\n    let source = toylang::emit_rs::emit(&program);\n    let dir = tempfile::tempdir().expect(\"temp dir\");\n    let exe = dir.path().join(\"program\");\n    toylang::link_rust(&source, &exe).expect(\"compiles with rustc\");\n    let cmd = Command::new(&exe);\n    std::mem::forget(dir);\n    piped(cmd)\n}\n\n/// The shape `spawn_go`, `spawn_py`, and `spawn_js` share: emit a backend's source to a temp\n/// file, then hand it to that backend's own interpreter. `args_before` is `go run`'s subcommand,\n/// which comes before the path; `python3` and `node` take the path as their only argument.\nfn spawn_interpreted(\n    program: &str,\n    emit: impl Fn(&toylang::tir::Program) -> String,\n    filename: &str,\n    interpreter: &str,\n    args_before: &[&str],\n) -> Child {\n    let program = toylang::compile(program).expect(\"compiles\");\n    let source = emit(&program);\n    let dir = tempfile::tempdir().expect(\"temp dir\");\n    let path = dir.path().join(filename);\n    std::fs::write(&path, source).expect(\"write source\");\n\n    let mut cmd = Command::new(interpreter);\n    cmd.args(args_before).arg(&path);\n    std::mem::forget(dir);\n    piped(cmd)\n}\n\nfn spawn_go(program: &str) -> Child {\n    spawn_interpreted(program, toylang::emit_go::emit, \"main.go\", \"go\", &[\"run\"])\n}\n\nfn spawn_py(program: &str) -> Child {\n    spawn_interpreted(\n        program,\n        toylang::emit_py::emit,\n        \"program.py\",\n        \"python3\",\n        &[],\n    )\n}\n\nfn spawn_js(program: &str) -> Child {\n    spawn_interpreted(program, toylang::emit_js::emit, \"program.js\", \"node\", &[])\n}\n\nfn spawn_jq(program: &str) -> Child {\n    let program = toylang::compile(program).expect(\"compiles\");\n    let source = toylang::emit_jq::emit(&program).expect(\"compiles for jq\");\n\n    let mut cmd = Command::new(\"jq\");\n    cmd.arg(\"--unbuffered\").arg(\"-c\").arg(\"-n\").arg(\"-r\");\n    if program.uses_lines {\n        cmd.arg(\"-R\");\n    }\n    cmd.arg(&source);\n    piped(cmd)\n}\n\n#[test]\nfn lua_streams() {\n    assert_streams_first_record(spawn_lua(PROGRAM), RECORD_IN, RECORD_OUT);\n}\n\n#[test]\nfn native_streams() {\n    assert_streams_first_record(spawn_native(PROGRAM), RECORD_IN, RECORD_OUT);\n}\n\n#[test]\nfn rust_streams() {\n    assert_streams_first_record(spawn_rust(PROGRAM), RECORD_IN, RECORD_OUT);\n}\n\n#[test]\nfn go_streams() {\n    assert_streams_first_record(spawn_go(PROGRAM), RECORD_IN, RECORD_OUT);\n}\n\n#[test]\nfn py_streams() {\n    assert_streams_first_record(spawn_py(PROGRAM), RECORD_IN, RECORD_OUT);\n}\n\n#[test]\nfn js_streams() {\n    assert_streams_first_record(spawn_js(PROGRAM), RECORD_IN, RECORD_OUT);\n}\n\n#[test]\nfn jq_streams() {\n    assert_streams_first_record(spawn_jq(PROGRAM), RECORD_IN, RECORD_OUT);\n}\n\n#[test]\nfn lua_streams_composed_functions() {\n    assert_streams_first_record(spawn_lua(COMPOSED), RECORD_IN, RECORD_OUT);\n}\n\n#[test]\nfn native_streams_composed_functions() {\n    assert_streams_first_record(spawn_native(COMPOSED), RECORD_IN, RECORD_OUT);\n}\n\n#[test]\nfn rust_streams_composed_functions() {\n    assert_streams_first_record(spawn_rust(COMPOSED), RECORD_IN, RECORD_OUT);\n}\n\n#[test]\nfn go_streams_composed_functions() {\n    assert_streams_first_record(spawn_go(COMPOSED), RECORD_IN, RECORD_OUT);\n}\n\n#[test]\nfn py_streams_composed_functions() {\n    assert_streams_first_record(spawn_py(COMPOSED), RECORD_IN, RECORD_OUT);\n}\n\n#[test]\nfn js_streams_composed_functions() {\n    assert_streams_first_record(spawn_js(COMPOSED), RECORD_IN, RECORD_OUT);\n}\n\n#[test]\nfn jq_streams_composed_functions() {\n    assert_streams_first_record(spawn_jq(COMPOSED), RECORD_IN, RECORD_OUT);\n}\n\n/// One interpreted and one compiled backend for the `lines` source; the output equality of the\n/// shape on all seven is `jsonlines_of_lines.yaml`'s job.\n#[test]\nfn py_streams_lines() {\n    assert_streams_first_record(spawn_py(SHOUT), b\"ada\\n\", r#\"\"ada!\"\"#);\n}\n\n#[test]\nfn native_streams_lines() {\n    assert_streams_first_record(spawn_native(SHOUT), b\"ada\\n\", r#\"\"ada!\"\"#);\n}\n\n/// `tests/corpus/enum_inputs_reject.yaml` pins this program's real `run_on` behavior against a\n/// fixture, where validation is eager and happens before anything runs. A real command-line run\n/// has no such up-front check to lean on (issue #15): `render`'s emitted code just trusted\n/// `JSON.parse` to produce a valid `Msg`, so live and fixture runs disagreed on every backend but\n/// Lua, which validates through its own embedded host function rather than a subprocess's code at\n/// all. This is the same program and the same bad record, driven through the real CLI with real,\n/// unset stdin instead of `run_on`'s fixture path, to prove the two now agree.\nconst REJECT: &str = r#\"\nenum Msg { ping, text{body: Str} }\n\nfn render(msgs: Stream<Msg>) -> Stream<Str> =\n    msgs | map(. | text -> .body or any() -> \"*ping*\")\n\njsonlines(render(inputs))\n\"#;\n\n/// The valid record ahead of the bad one still streams before the refusal ends the run: a live\n/// refusal can only stop the records after the one it caught, not retroactively un-print ones\n/// that already passed validation and reached the backend.\n#[test]\nfn js_streams_a_valid_record_before_a_later_one_fails_live_validation() {\n    assert_streams_first_record(spawn_cli(REJECT, \"js\"), b\"\\\"ping\\\"\\n\", r#\"\"*ping*\"\"#);\n}\n\nfn assert_refuses_live(backend: &str) {\n    let mut child = spawn_cli(REJECT, backend);\n    child\n        .stdin\n        .take()\n        .expect(\"piped stdin\")\n        .write_all(b\"\\\"ping\\\"\\n\\\"burst\\\"\\n\")\n        .expect(\"write both records\");\n    let output = child.wait_with_output().expect(\"wait for exit\");\n    assert!(\n        !output.status.success(),\n        \"{backend} exited successfully on a record no variant of Msg names\"\n    );\n    let stderr = String::from_utf8_lossy(&output.stderr);\n    assert!(\n        stderr.contains(\"inputs: `burst` is not a variant of Msg\"),\n        \"{backend} stderr did not name the bad record: {stderr}\"\n    );\n}\n\n#[test]\nfn js_refuses_live_same_as_the_fixture() {\n    assert_refuses_live(\"js\");\n}\n\n#[test]\nfn go_refuses_live_same_as_the_fixture() {\n    assert_refuses_live(\"go\");\n}\n\n#[test]\nfn py_refuses_live_same_as_the_fixture() {\n    assert_refuses_live(\"py\");\n}","lineStart":1,"lineEnd":319,"totalLines":319,"truncated":false}},"title":"tests/streaming.rs","time":{"start":1788297835846,"end":1788297835853}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now I understand the streaming model. The `jsonlines` fusion: the program body is `jsonlines(<stream chain>)`, and the backends fuse the read-one/transform-one/write-one loop.\n\nFor `pipe_through`, the shape is: `lines | pipe_through(\"grep\", [\"foo\"]) | collect`. Here `pipe_through` is a stream-to-stream transform. `collect` then turns the stream into a Vec, which is printed.\n\nThis is very different from jsonlines fusion. pipe_through needs to:\n1. Spawn a subprocess (`grep foo`)\n2. Feed the stream lines into the subprocess's stdin\n3. Read the subprocess's stdout line-by-line\n4. Emit those as the resulting stream\n5. collect reads them into a Vec\n\nThe tricky part is: streaming. In a fully streaming pipeline, `pipe_through` would consume input lines progressively and produce output lines progressively. But with the current eager lowering (streams materialized as Vec), and given the corpus `lines | pipe_through(...) | collect` — the whole thing can be done eagerly: read all lines, write them all to the subprocess stdin, close it, read all output lines.\n\nBut \"streaming\" is the point of the feature. However, at least for the corpus case, the important thing is that the output is correct. The \"streaming\" aspect... let me check what tests/streaming.rs tests - it says \"no output arrived before stdin closed -- this is reading all of stdin first, not streaming\". So there IS a test that verifies streaming behavior at the harness level.\n\nHmm, this is a big design question. Let me look at tests/streaming.rs fully to understand what streaming means in the harness.","format":"unknown","index":0}]}},"id":"prt_05edb7190001pFZpUJQh1gstqe","sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","messageID":"msg_05edb1fad0016qrm4mXunMnh3y"}}
{"type":"step_finish","timestamp":1788297835864,"sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","part":{"id":"prt_05edb75560015WySgzMgMIlb8G","reason":"tool-calls","snapshot":"5a1012ab7eb7388a8de2a55a732be7fdbf823735","messageID":"msg_05edb1fad0016qrm4mXunMnh3y","sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","type":"step-finish","tokens":{"total":41344,"input":33996,"output":68,"reasoning":368,"cache":{"write":0,"read":6912}},"cost":0.002398812}}
{"type":"step_start","timestamp":1788297838226,"sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","part":{"id":"prt_05edb7e89001HMvdOsKEwFrieB","messageID":"msg_05edb7569001odjxUe24eOyELP","sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","snapshot":"5a1012ab7eb7388a8de2a55a732be7fdbf823735","type":"step-start"}}
{"type":"tool_use","timestamp":1788297841746,"sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","part":{"type":"tool","tool":"read","callID":"call_5b033bc811ac446982e244ee","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-158/tests/corpus.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-158/tests/corpus.rs</path>\n<type>file</type>\n<content>\n1: //! The agreement harness.\n2: //!\n3: //! One corpus, every backend. This is the check a single-backend suite cannot express: two\n4: //! backends producing different answers is a failure in its own right, separate from either of\n5: //! them producing a wrong one. The step_*.rs suites keep their own job, which is pinning error\n6: //! messages and emitted code; this is about behaviour, and behaviour is what has to be identical\n7: //! across targets.\n8: \n9: mod support;\n10: \n11: use toylang::Backend;\n12: \n13: #[test]\n14: fn every_backend_agrees_and_is_right() {\n15:     let cases = support::cases();\n16:     assert!(\n17:         !cases.is_empty(),\n18:         \"the corpus is empty, so this test proves nothing\"\n19:     );\n20: \n21:     let mut failures = Vec::new();\n22: \n23:     for case in &cases {\n24:         failures.extend(support::agreement_failures(\n25:             &case.name,\n26:             &case.program,\n27:             case.input.as_deref(),\n28:             &case.expect,\n29:         ));\n30:     }\n31: \n32:     assert!(\n33:         failures.is_empty(),\n34:         \"{} of {} corpus programs failed across {} backends:\\n{}\",\n35:         failures.len(),\n36:         cases.len(),\n37:         Backend::ALL.len(),\n38:         failures.join(\"\\n\")\n39:     );\n40: }\n41: \n42: /// What a program prints is not always the whole claim. A case that asks for it gets the code a\n43: /// backend emitted pinned as well, which is how a property invisible in the output -- a name\n44: /// that has to be declared, a type that has to be spelled -- stays observed.\n45: #[test]\n46: fn emitted_code_matches_the_snapshot() {\n47:     let mut asked = 0;\n48:     for case in support::cases() {\n49:         let program =\n50:             toylang::compile(&case.program).unwrap_or_else(|e| panic!(\"{}: {e}\", case.name));\n51:         for backend in case.snapshot {\n52:             let emitted = backend.emit(&program).unwrap_or_else(|e| {\n53:                 panic!(\"{}: {} could not emit: {e}\", case.name, backend.name())\n54:             });\n55:             insta::assert_snapshot!(format!(\"{}__{}\", case.name, backend.name()), emitted);\n56:             asked += 1;\n57:         }\n58:     }\n59:     assert!(\n60:         asked > 0,\n61:         \"no case asks for a snapshot, so this test proves nothing\"\n62:     );\n63: }\n\n(End of file - total 63 lines)\n</content>","metadata":{"preview":"//! The agreement harness.\n//!\n//! One corpus, every backend. This is the check a single-backend suite cannot express: two\n//! backends producing different answers is a failure in its own right, separate from either of\n//! them producing a wrong one. The step_*.rs suites keep their own job, which is pinning error\n//! messages and emitted code; this is about behaviour, and behaviour is what has to be identical\n//! across targets.\n\nmod support;\n\nuse toylang::Backend;\n\n#[test]\nfn every_backend_agrees_and_is_right() {\n    let cases = support::cases();\n    assert!(\n        !cases.is_empty(),\n        \"the corpus is empty, so this test proves nothing\"\n    );\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-158/tests/corpus.rs","text":"//! The agreement harness.\n//!\n//! One corpus, every backend. This is the check a single-backend suite cannot express: two\n//! backends producing different answers is a failure in its own right, separate from either of\n//! them producing a wrong one. The step_*.rs suites keep their own job, which is pinning error\n//! messages and emitted code; this is about behaviour, and behaviour is what has to be identical\n//! across targets.\n\nmod support;\n\nuse toylang::Backend;\n\n#[test]\nfn every_backend_agrees_and_is_right() {\n    let cases = support::cases();\n    assert!(\n        !cases.is_empty(),\n        \"the corpus is empty, so this test proves nothing\"\n    );\n\n    let mut failures = Vec::new();\n\n    for case in &cases {\n        failures.extend(support::agreement_failures(\n            &case.name,\n            &case.program,\n            case.input.as_deref(),\n            &case.expect,\n        ));\n    }\n\n    assert!(\n        failures.is_empty(),\n        \"{} of {} corpus programs failed across {} backends:\\n{}\",\n        failures.len(),\n        cases.len(),\n        Backend::ALL.len(),\n        failures.join(\"\\n\")\n    );\n}\n\n/// What a program prints is not always the whole claim. A case that asks for it gets the code a\n/// backend emitted pinned as well, which is how a property invisible in the output -- a name\n/// that has to be declared, a type that has to be spelled -- stays observed.\n#[test]\nfn emitted_code_matches_the_snapshot() {\n    let mut asked = 0;\n    for case in support::cases() {\n        let program =\n            toylang::compile(&case.program).unwrap_or_else(|e| panic!(\"{}: {e}\", case.name));\n        for backend in case.snapshot {\n            let emitted = backend.emit(&program).unwrap_or_else(|e| {\n                panic!(\"{}: {} could not emit: {e}\", case.name, backend.name())\n            });\n            insta::assert_snapshot!(format!(\"{}__{}\", case.name, backend.name()), emitted);\n            asked += 1;\n        }\n    }\n    assert!(\n        asked > 0,\n        \"no case asks for a snapshot, so this test proves nothing\"\n    );\n}","lineStart":1,"lineEnd":63,"totalLines":63,"truncated":false}},"title":"tests/corpus.rs","time":{"start":1788297841742,"end":1788297841745}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"OK. So there are two test surfaces:\n1. tests/corpus/ - runs the compiled program end-to-end, output equality.\n2. tests/streaming.rs - liveness probes.\n\nThe task brief says: \"Add the corpus case FIRST (tests/corpus/, program/input/output per AGENTS.md), then implement parser/checker/backends until just check is green.\"\n\nSo the plan is to add a corpus case `pipe_through`, then implement the parser/checker/backends so it works.\n\nThe corpus case runs on every backend. That's the big task: implementing `pipe_through` in all 7 backends (go, jq, js, llvm, lua, py, rs).\n\nWait, jq - can it spawn a subprocess? jq has `input` and pipelines, but spawning subprocesses... jq doesn't have a subprocess primitive. Actually jq can use `$ENV` and system calls? No. jq is a pure filter. There's no way to spawn grep from jq.\n\nSo jq cannot implement pipe_through. But the corpus demands \"Every case runs on every backend.\"\n\nHmm. Let me reconsider. Maybe the corpus case for pipe_through uses `refuses: true`? But then all backends would refuse, and we couldn't test the actual behavior...\n\nActually wait. Let me look at how `refuses` works in the corpus harness. Maybe there's a per-backend mechanism... Let me read tests/corpus.rs.","format":"unknown","index":0}]}},"id":"prt_05edb8c4c001RfyeYmZFRYzWmh","sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","messageID":"msg_05edb7569001odjxUe24eOyELP"}}
{"type":"text","timestamp":1788297841781,"sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","part":{"id":"prt_05edb8b58001VVvLksDi4svlrT","messageID":"msg_05edb7569001odjxUe24eOyELP","sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","type":"text","text":"\n\n","time":{"start":1788297841496,"end":1788297841780}}}
{"type":"step_finish","timestamp":1788297841789,"sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","part":{"id":"prt_05edb8c7c001IIShoK6vTP02vB","reason":"tool-calls","snapshot":"5a1012ab7eb7388a8de2a55a732be7fdbf823735","messageID":"msg_05edb7569001odjxUe24eOyELP","sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","type":"step-finish","tokens":{"total":45632,"input":12220,"output":78,"reasoning":310,"cache":{"write":0,"read":33024}},"cost":0.001392524}}
{"type":"step_start","timestamp":1788297842962,"sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","part":{"id":"prt_05edb910f001YukDFdMRz736Zo","messageID":"msg_05edb8c850014Ug1wYi2FmFUBV","sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","snapshot":"5a1012ab7eb7388a8de2a55a732be7fdbf823735","type":"step-start"}}
{"type":"tool_use","timestamp":1788297843208,"sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","part":{"type":"tool","tool":"read","callID":"call_fe732f8d1f79484980d0cdda","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-158/tests/support/mod.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-158/tests/support/mod.rs</path>\n<type>file</type>\n<content>\n1: //! Loading the corpus.\n2: //!\n3: //! One case per file. A program, the input it reads, the output it must produce and whatever\n4: //! else it asks for are one thing, and were three files that only a shared stem tied together:\n5: //! a program whose `.out` was missing was a panic at load, and a `.in.json` whose stem was\n6: //! misspelt was silently a program that reads no input.\n7: //!\n8: //! Read by both the agreement harness and the native backend's tracker, which were two copies\n9: //! of the same directory walk.\n10: \n11: #![allow(dead_code)]\n12: \n13: use std::path::{Path, PathBuf};\n14: \n15: use serde::Deserialize;\n16: \n17: /// The file as written. `deny_unknown_fields` is the point of the struct: a misspelt key would\n18: /// otherwise be a case that quietly asks for nothing extra, which looks exactly like a case that\n19: /// passes.\n20: #[derive(Deserialize)]\n21: #[serde(deny_unknown_fields)]\n22: struct Fields {\n23:     program: String,\n24:     #[serde(default)]\n25:     input: Option<String>,\n26:     #[serde(default)]\n27:     output: Option<String>,\n28:     /// Set when the program compiles but every backend has to refuse to run it. What each says\n29:     /// while refusing is its own business, so only the refusal is compared.\n30:     #[serde(default)]\n31:     refuses: bool,\n32:     /// Backends whose emitted code is snapshotted for this program, for cases where what the\n33:     /// program prints is not the whole claim. Empty for most cases: running on every backend and\n34:     /// agreeing is the ordinary bar, and a snapshot on top of it is the exception.\n35:     #[serde(default)]\n36:     snapshot: Vec<String>,\n37:     /// The AST shapes this program exercises, in `toylang::tags` terms. Generated by\n38:     /// `tests/tag_corpus.rs` on every run, not hand-authored, so it is read here only to keep\n39:     /// `deny_unknown_fields` from rejecting it -- the fresh value always comes from `toylang::tags`.\n40:     #[serde(default)]\n41:     node_types: Vec<String>,\n42: }\n43: \n44: /// What every backend has to do with the program. A case says exactly one of these, because a\n45: /// case that says both, or neither, is one nobody wrote down the point of.\n46: pub enum Expect {\n47:     /// Every backend prints this, and they have to agree.\n48:     Output(String),\n49:     /// Every backend refuses to run it.\n50:     Refusal,\n51: }\n52: \n53: pub struct Case {\n54:     pub name: String,\n55:     pub program: String,\n56:     pub input: Option<String>,\n57:     pub expect: Expect,\n58:     pub snapshot: Vec<toylang::Backend>,\n59: }\n60: \n61: /// Runs `program` on every backend and reports how the run fell short of `expect`, one line per\n62: /// failure, empty when every backend did what the case asked. The corpus harness and the docs\n63: /// harness both feed programs through this: a docs fragment is a corpus case defined in prose,\n64: /// so what \"agrees\" means must be one definition, not two.\n65: pub fn agreement_failures(\n66:     name: &str,\n67:     program: &str,\n68:     input: Option<&str>,\n69:     expect: &Expect,\n70: ) -> Vec<String> {\n71:     let mut failures = Vec::new();\n72: \n73:     if let Expect::Refusal = expect {\n74:         for backend in toylang::Backend::ALL {\n75:             if let Ok(out) = toylang::run_on(program, input, backend) {\n76:                 failures.push(format!(\n77:                     \"RAN     {name}: {} produced {out:?} instead of refusing\",\n78:                     backend.name()\n79:                 ));\n80:             }\n81:         }\n82:         return failures;\n83:     }\n84:     let Expect::Output(want) = expect else {\n85:         unreachable!(\"refusal handled above\")\n86:     };\n87: \n88:     let mut outputs: Vec<(&str, String)> = Vec::new();\n89:     for backend in toylang::Backend::ALL {\n90:         // A backend that cannot run is reported, never skipped. A report saying every backend\n91:         // agreed when only one of them ran is worse than no report.\n92:         match toylang::run_on(program, input, backend) {\n93:             Ok(out) => outputs.push((backend.name(), out)),\n94:             Err(e) => failures.push(format!(\n95:                 \"BROKEN  {name}: {} could not run: {e}\",\n96:                 backend.name()\n97:             )),\n98:         }\n99:     }\n100: \n101:     if outputs.len() < toylang::Backend::ALL.len() {\n102:         return failures;\n103:     }\n104: \n105:     // Disagreement first, and reported on its own. Which backend matches the expectation is not\n106:     // the point: the language is underspecified either way.\n107:     let (_, first) = &outputs[0];\n108:     if outputs.iter().any(|(_, out)| out != first) {\n109:         let shown: Vec<String> = outputs.iter().map(|(n, o)| format!(\"{n}={o:?}\")).collect();\n110:         failures.push(format!(\"DISAGREE {name}: {}\", shown.join(\" \")));\n111:         return failures;\n112:     }\n113: \n114:     if first != want {\n115:         failures.push(format!(\n116:             \"WRONG   {name}: expected {want:?}, every backend gave {first:?}\"\n117:         ));\n118:     }\n119:     failures\n120: }\n121: \n122: pub fn dir() -> PathBuf {\n123:     Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"tests/corpus\")\n124: }\n125: \n126: pub fn cases() -> Vec<Case> {\n127:     let dir = dir();\n128:     let mut paths: Vec<PathBuf> = std::fs::read_dir(&dir)\n129:         .unwrap_or_else(|e| panic!(\"cannot read {}: {e}\", dir.display()))\n130:         .map(|e| e.expect(\"readable entry\").path())\n131:         .filter(|p| p.extension().is_some_and(|e| e == \"yaml\"))\n132:         .collect();\n133:     paths.sort();\n134: \n135:     paths\n136:         .into_iter()\n137:         .map(|path| {\n138:             let name = path\n139:                 .file_stem()\n140:                 .expect(\"has a stem\")\n141:                 .to_string_lossy()\n142:                 .into_owned();\n143:             let text = std::fs::read_to_string(&path).expect(\"readable case\");\n144:             let fields: Fields =\n145:                 serde_norway::from_str(&text).unwrap_or_else(|e| panic!(\"{name}: {e}\"));\n146:             let snapshot = fields\n147:                 .snapshot\n148:                 .iter()\n149:                 .map(|n| {\n150:                     toylang::Backend::from_name(n)\n151:                         .unwrap_or_else(|| panic!(\"{name}: `{n}` is not a backend\"))\n152:                 })\n153:                 .collect();\n154:             let expect = match (fields.output, fields.refuses) {\n155:                 (Some(output), false) => Expect::Output(output),\n156:                 (None, true) => Expect::Refusal,\n157:                 (Some(_), true) => panic!(\"{name}: has both `output` and `refuses`\"),\n158:                 (None, false) => panic!(\"{name}: has neither `output` nor `refuses`\"),\n159:             };\n160:             Case {\n161:                 name,\n162:                 program: fields.program,\n163:                 input: fields.input,\n164:                 expect,\n165:                 snapshot,\n166:             }\n167:         })\n168:         .collect()\n169: }\n\n(End of file - total 169 lines)\n</content>","metadata":{"preview":"//! Loading the corpus.\n//!\n//! One case per file. A program, the input it reads, the output it must produce and whatever\n//! else it asks for are one thing, and were three files that only a shared stem tied together:\n//! a program whose `.out` was missing was a panic at load, and a `.in.json` whose stem was\n//! misspelt was silently a program that reads no input.\n//!\n//! Read by both the agreement harness and the native backend's tracker, which were two copies\n//! of the same directory walk.\n\n#![allow(dead_code)]\n\nuse std::path::{Path, PathBuf};\n\nuse serde::Deserialize;\n\n/// The file as written. `deny_unknown_fields` is the point of the struct: a misspelt key would\n/// otherwise be a case that quietly asks for nothing extra, which looks exactly like a case that\n/// passes.\n#[derive(Deserialize)]","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-158/tests/support/mod.rs","text":"//! Loading the corpus.\n//!\n//! One case per file. A program, the input it reads, the output it must produce and whatever\n//! else it asks for are one thing, and were three files that only a shared stem tied together:\n//! a program whose `.out` was missing was a panic at load, and a `.in.json` whose stem was\n//! misspelt was silently a program that reads no input.\n//!\n//! Read by both the agreement harness and the native backend's tracker, which were two copies\n//! of the same directory walk.\n\n#![allow(dead_code)]\n\nuse std::path::{Path, PathBuf};\n\nuse serde::Deserialize;\n\n/// The file as written. `deny_unknown_fields` is the point of the struct: a misspelt key would\n/// otherwise be a case that quietly asks for nothing extra, which looks exactly like a case that\n/// passes.\n#[derive(Deserialize)]\n#[serde(deny_unknown_fields)]\nstruct Fields {\n    program: String,\n    #[serde(default)]\n    input: Option<String>,\n    #[serde(default)]\n    output: Option<String>,\n    /// Set when the program compiles but every backend has to refuse to run it. What each says\n    /// while refusing is its own business, so only the refusal is compared.\n    #[serde(default)]\n    refuses: bool,\n    /// Backends whose emitted code is snapshotted for this program, for cases where what the\n    /// program prints is not the whole claim. Empty for most cases: running on every backend and\n    /// agreeing is the ordinary bar, and a snapshot on top of it is the exception.\n    #[serde(default)]\n    snapshot: Vec<String>,\n    /// The AST shapes this program exercises, in `toylang::tags` terms. Generated by\n    /// `tests/tag_corpus.rs` on every run, not hand-authored, so it is read here only to keep\n    /// `deny_unknown_fields` from rejecting it -- the fresh value always comes from `toylang::tags`.\n    #[serde(default)]\n    node_types: Vec<String>,\n}\n\n/// What every backend has to do with the program. A case says exactly one of these, because a\n/// case that says both, or neither, is one nobody wrote down the point of.\npub enum Expect {\n    /// Every backend prints this, and they have to agree.\n    Output(String),\n    /// Every backend refuses to run it.\n    Refusal,\n}\n\npub struct Case {\n    pub name: String,\n    pub program: String,\n    pub input: Option<String>,\n    pub expect: Expect,\n    pub snapshot: Vec<toylang::Backend>,\n}\n\n/// Runs `program` on every backend and reports how the run fell short of `expect`, one line per\n/// failure, empty when every backend did what the case asked. The corpus harness and the docs\n/// harness both feed programs through this: a docs fragment is a corpus case defined in prose,\n/// so what \"agrees\" means must be one definition, not two.\npub fn agreement_failures(\n    name: &str,\n    program: &str,\n    input: Option<&str>,\n    expect: &Expect,\n) -> Vec<String> {\n    let mut failures = Vec::new();\n\n    if let Expect::Refusal = expect {\n        for backend in toylang::Backend::ALL {\n            if let Ok(out) = toylang::run_on(program, input, backend) {\n                failures.push(format!(\n                    \"RAN     {name}: {} produced {out:?} instead of refusing\",\n                    backend.name()\n                ));\n            }\n        }\n        return failures;\n    }\n    let Expect::Output(want) = expect else {\n        unreachable!(\"refusal handled above\")\n    };\n\n    let mut outputs: Vec<(&str, String)> = Vec::new();\n    for backend in toylang::Backend::ALL {\n        // A backend that cannot run is reported, never skipped. A report saying every backend\n        // agreed when only one of them ran is worse than no report.\n        match toylang::run_on(program, input, backend) {\n            Ok(out) => outputs.push((backend.name(), out)),\n            Err(e) => failures.push(format!(\n                \"BROKEN  {name}: {} could not run: {e}\",\n                backend.name()\n            )),\n        }\n    }\n\n    if outputs.len() < toylang::Backend::ALL.len() {\n        return failures;\n    }\n\n    // Disagreement first, and reported on its own. Which backend matches the expectation is not\n    // the point: the language is underspecified either way.\n    let (_, first) = &outputs[0];\n    if outputs.iter().any(|(_, out)| out != first) {\n        let shown: Vec<String> = outputs.iter().map(|(n, o)| format!(\"{n}={o:?}\")).collect();\n        failures.push(format!(\"DISAGREE {name}: {}\", shown.join(\" \")));\n        return failures;\n    }\n\n    if first != want {\n        failures.push(format!(\n            \"WRONG   {name}: expected {want:?}, every backend gave {first:?}\"\n        ));\n    }\n    failures\n}\n\npub fn dir() -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"tests/corpus\")\n}\n\npub fn cases() -> Vec<Case> {\n    let dir = dir();\n    let mut paths: Vec<PathBuf> = std::fs::read_dir(&dir)\n        .unwrap_or_else(|e| panic!(\"cannot read {}: {e}\", dir.display()))\n        .map(|e| e.expect(\"readable entry\").path())\n        .filter(|p| p.extension().is_some_and(|e| e == \"yaml\"))\n        .collect();\n    paths.sort();\n\n    paths\n        .into_iter()\n        .map(|path| {\n            let name = path\n                .file_stem()\n                .expect(\"has a stem\")\n                .to_string_lossy()\n                .into_owned();\n            let text = std::fs::read_to_string(&path).expect(\"readable case\");\n            let fields: Fields =\n                serde_norway::from_str(&text).unwrap_or_else(|e| panic!(\"{name}: {e}\"));\n            let snapshot = fields\n                .snapshot\n                .iter()\n                .map(|n| {\n                    toylang::Backend::from_name(n)\n                        .unwrap_or_else(|| panic!(\"{name}: `{n}` is not a backend\"))\n                })\n                .collect();\n            let expect = match (fields.output, fields.refuses) {\n                (Some(output), false) => Expect::Output(output),\n                (None, true) => Expect::Refusal,\n                (Some(_), true) => panic!(\"{name}: has both `output` and `refuses`\"),\n                (None, false) => panic!(\"{name}: has neither `output` nor `refuses`\"),\n            };\n            Case {\n                name,\n                program: fields.program,\n                input: fields.input,\n                expect,\n                snapshot,\n            }\n        })\n        .collect()\n}","lineStart":1,"lineEnd":169,"totalLines":169,"truncated":false}},"title":"tests/support/mod.rs","time":{"start":1788297843202,"end":1788297843205}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05edb9200001gYuH4JiLH4PhIN","sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","messageID":"msg_05edb8c850014Ug1wYi2FmFUBV"}}
