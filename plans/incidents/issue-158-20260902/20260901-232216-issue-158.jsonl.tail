{"type":"tool_use","timestamp":1788297760005,"sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","part":{"type":"tool","tool":"bash","callID":"chatcmpl-tool-93a498146a3f9bfd","state":{"status":"completed","input":{"command":"cat tests/corpus/jsonlines_of_lines.yaml; echo \"=====\"; cat tests/corpus/lines_stream_signature.yaml; echo \"=====\"; cat tests/corpus/join_lines_one.yaml"},"output":"# jsonlines over a lines-sourced pipeline: the elements are raw lines, so the sink prints each\n# as a JSON string. A shape the old recognizer never knew (it demanded an `inputs` base), fused\n# now that fusion reads types; tests/streaming.rs is what proves the fusion, output is what\n# this pins.\nprogram: |\n  fn shout(names: Stream<Str>) -> Stream<Str> =\n      names | map(. + \"!\")\n\n  jsonlines shout lines\n\ninput: |\n  ada\n  bo\n\noutput: |\n  \"ada!\"\n  \"bo!\"\n\nnode_types: [application, builtin.jsonlines, concat, lines, local, map-over, pipe, str, var]\n=====\n# A user-written stream-signature function, checked end to end: select, map, and projection\n# all accept the Stream subject and yield a Stream back, so the whole pipeline lives in the\n# effect layer until collect. Eagerly lowered on every backend for now -- output is what the\n# corpus can check; fusion is step 5's business.\nprogram: |\n  fn shout(names: Stream<Str>) -> Stream<Str> =\n      names | select(. != \"bo\") | map {who: . + \"!\"} | .[].who\n\n  join_lines collect shout lines\n\ninput: |\n  ada\n  bo\n  cy\n\noutput: |\n  ada!\n  cy!\n\nnode_types: [application, builtin.collect, builtin.length, builtin.tail, compare.eq, compare.ne, concat, conditional, int, lines, local, map-over, pipe, projection, record-literal, selection.collapse, selection.narrow, str, unwrap, var]\n=====\n# join_lines is prelude.toy source now, not a per-backend builtin -- pinned on two backends of\n# different shape (dynamic and statically typed) to show it compiles as an ordinary recursive\n# function call in both, not through special-cased codegen.\nprogram: |\n  join_lines([\"only\"])\n\noutput: |\n  only\n\nsnapshot: [js, go]\n\nnode_types: [application, builtin.length, builtin.tail, compare.eq, concat, conditional, int, selection.collapse, str, unwrap, var, vec-literal]\n","metadata":{"output":"# jsonlines over a lines-sourced pipeline: the elements are raw lines, so the sink prints each\n# as a JSON string. A shape the old recognizer never knew (it demanded an `inputs` base), fused\n# now that fusion reads types; tests/streaming.rs is what proves the fusion, output is what\n# this pins.\nprogram: |\n  fn shout(names: Stream<Str>) -> Stream<Str> =\n      names | map(. + \"!\")\n\n  jsonlines shout lines\n\ninput: |\n  ada\n  bo\n\noutput: |\n  \"ada!\"\n  \"bo!\"\n\nnode_types: [application, builtin.jsonlines, concat, lines, local, map-over, pipe, str, var]\n=====\n# A user-written stream-signature function, checked end to end: select, map, and projection\n# all accept the Stream subject and yield a Stream back, so the whole pipeline lives in the\n# effect layer until collect. Eagerly lowered on every backend for now -- output is what the\n# corpus can check; fusion is step 5's business.\nprogram: |\n  fn shout(names: Stream<Str>) -> Stream<Str> =\n      names | select(. != \"bo\") | map {who: . + \"!\"} | .[].who\n\n  join_lines collect shout lines\n\ninput: |\n  ada\n  bo\n  cy\n\noutput: |\n  ada!\n  cy!\n\nnode_types: [application, builtin.collect, builtin.length, builtin.tail, compare.eq, compare.ne, concat, conditional, int, lines, local, map-over, pipe, projection, record-literal, selection.collapse, selection.narrow, str, unwrap, var]\n=====\n# join_lines is prelude.toy source now, not a per-backend builtin -- pinned on two backends of\n# different shape (dynamic and statically typed) to show it compiles as an ordinary recursive\n# function call in both, not through special-cased codegen.\nprogram: |\n  join_lines([\"only\"])\n\noutput: |\n  only\n\nsnapshot: [js, go]\n\nnode_types: [application, builtin.length, builtin.tail, compare.eq, concat, conditional, int, selection.collapse, str, unwrap, var, vec-literal]\n","exit":0,"truncated":false},"title":"cat tests/corpus/jsonlines_of_lines.yaml; echo \"=====\"; cat tests/corpus/lines_stream_signature.yaml; echo \"=====\"; cat tests/corpus/join_lines_one.yaml","time":{"start":1788297759992,"end":1788297759999}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05eda49cf0011WVMYDAq9lwyyj","sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","messageID":"msg_05eda463a001fXFORLIX1I2IIU"}}
