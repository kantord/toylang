{"type":"tool_use","timestamp":1788297869387,"sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","part":{"type":"tool","tool":"bash","callID":"call_35d57d90053543858444fd41","state":{"status":"completed","input":{"command":"cat tests/corpus/div_by_zero.yaml; echo \"=====\"; cat tests/corpus/opt_unwrap_of_none_refuses.yaml; echo \"=====\"; cat tests/corpus/unpaired_surrogate_input.yaml"},"output":"# A zero divisor is the only way arithmetic can fail.\nprogram: |\n  str(1 / 0)\n\nrefuses: true\n\nnode_types: [arith.div, builtin.str, int]\n=====\n# The other half of opt_unwrap_peels_one_level.yaml: the outer level really is absent here,\n# so the same unwrap that survived some(none) stops the program on none. One value prints\n# null before the `!`, both print null without it -- the tag is the whole difference.\nprogram: |\n  fn shallow() -> Opt<Opt<Int>> = none\n\n  shallow()!\n\nrefuses: true\n\nnode_types: [application, unwrap, variant.unit]\n=====\n# A JSON string escape can name a lone surrogate (\\ud800 with no following low surrogate),\n# which is not a valid Unicode scalar value and so cannot become a Str at all: input is parsed\n# once, centrally, before any backend runs (see run_on in src/lib.rs), so every backend refuses\n# identically rather than six JSON parsers each deciding this on their own.\nprogram: |\n  fn tag(db: {tag: Str}) -> Str = db.tag\n\n  tag(input)\n\ninput: |\n  {\"tag\": \"\\ud800\"}\n\nrefuses: true\n\nnode_types: [application, input, projection, var]\n","metadata":{"output":"# A zero divisor is the only way arithmetic can fail.\nprogram: |\n  str(1 / 0)\n\nrefuses: true\n\nnode_types: [arith.div, builtin.str, int]\n=====\n# The other half of opt_unwrap_peels_one_level.yaml: the outer level really is absent here,\n# so the same unwrap that survived some(none) stops the program on none. One value prints\n# null before the `!`, both print null without it -- the tag is the whole difference.\nprogram: |\n  fn shallow() -> Opt<Opt<Int>> = none\n\n  shallow()!\n\nrefuses: true\n\nnode_types: [application, unwrap, variant.unit]\n=====\n# A JSON string escape can name a lone surrogate (\\ud800 with no following low surrogate),\n# which is not a valid Unicode scalar value and so cannot become a Str at all: input is parsed\n# once, centrally, before any backend runs (see run_on in src/lib.rs), so every backend refuses\n# identically rather than six JSON parsers each deciding this on their own.\nprogram: |\n  fn tag(db: {tag: Str}) -> Str = db.tag\n\n  tag(input)\n\ninput: |\n  {\"tag\": \"\\ud800\"}\n\nrefuses: true\n\nnode_types: [application, input, projection, var]\n","exit":0,"truncated":false},"title":"cat tests/corpus/div_by_zero.yaml; echo \"=====\"; cat tests/corpus/opt_unwrap_of_none_refuses.yaml; echo \"=====\"; cat tests/corpus/unpaired_surrogate_input.yaml","time":{"start":1788297869382,"end":1788297869385}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05edbf8380010Fp5fM3JILC1Az","sessionID":"ses_fa1260da9ffea7gMsosoWnpMXr","messageID":"msg_05edbf116001Q34revnpS1pWM5"}}
