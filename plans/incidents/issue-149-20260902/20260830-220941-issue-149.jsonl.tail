-kleene-patterns.md\n0009-enums-are-json-native-single-key-wrappers.md\n0010-int64-is-a-second-integer-type.md\n\ndocs/overview:\nvision.md\n---\nbenchmark-plan.md\nbenchmark-suite-spike.md\nbenchmark-tooling-spike.md\nboard-archive.yaml\nboard.yaml\nchecker-structure.md\ncrate-simplification.md\ndocs-site.md\ndraft-split.md\nemuto-survey.md\nenums.md\neuler-ergonomics.md\nlanguage-oddities.md\nlanguage-precedents.md\nmatcher-parser-spike.md\nmini-parser-spike.md\nopencode-rollout.md\nopt-as-enum.md\nprelude-inventory.md\nprototype_1_5.md\nprototype_1_5_step_1.md\nprototype_1_5_step_2.md\nprototype_1_5_step_3.md\nprototype_1_5_step_4.md\nprototype_1_5_step_5.md\nprototype_1_5_step_6.md\nprototype_1.md\nprototype_1_step_1.md\nprototype_1_step_2.md\nprototype_1_step_3.md\nprototype_1_step_4.md\nprototype_1_step_5.md\nquality-practices.md\nquestions.md\nstreams.md\nstring-type-spike.md\ntype-flow.md\nworker-pool.md\n","exit":0,"truncated":false},"title":"ls docs docs/adr docs/overview 2>/dev/null; echo ---; ls plans","time":{"start":1788120917299,"end":1788120917301}},"id":"prt_0544fe3180014IXEedcu5VpyW7","sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","messageID":"msg_0544d4118001XPSTPdAoQm2rgZ"}}
