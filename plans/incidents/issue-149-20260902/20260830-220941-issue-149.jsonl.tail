{"type":"tool_use","timestamp":1788120744085,"sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-94fddeb70ebc24b5","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-149/src/lib.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-149/src/lib.rs</path>\n<type>file</type>\n<content>\n1: pub mod ast;\n2: pub mod check;\n3: pub mod emit_go;\n4: pub mod emit_jq;\n5: pub mod emit_js;\n6: pub mod emit_llvm;\n7: pub mod emit_lua;\n8: pub mod emit_py;\n9: pub mod emit_rs;\n10: pub mod emit_toylang;\n11: pub mod error;\n12: pub mod fmt_tree;\n13: pub mod input;\n14: pub mod parse;\n15: pub mod prelude;\n16: pub mod tags;\n17: pub mod tir;\n18: pub mod ty;\n19: \n20: use std::cell::RefCell;\n21: use std::io::{BufRead, Write};\n22: use std::rc::Rc;\n23: \n24: use anyhow::{Context, Result};\n25: use error::Error;\n26: use tir::Program;\n27: \n28: #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n29: pub enum Backend {\n30:     Lua,\n31:     Js,\n32:     Native,\n33:     Jq,\n34:     Go,\n35:     Py,\n36:     Rust,\n37: }\n38: \n39: impl Backend {\n40:     /// The backends that must agree on every corpus program. Native and Rust each joined once\n41:     /// they could compile the whole language; until then they were kept out rather than allowed\n42:     /// to turn the harness permanently red, tracked by tests/backend_llvm.rs and\n43:     /// tests/backend_rust.rs respectively.\n44:     pub const ALL: [Backend; 7] = [\n45:         Backend::Lua,\n46:         Backend::Js,\n47:         Backend::Native,\n48:         Backend::Jq,\n49:         Backend::Go,\n50:         Backend::Py,\n51:         Backend::Rust,\n52:     ];\n53: \n54:     /// The spelling used on the command line and in a corpus case's `snapshot` list.\n55:     pub fn from_name(name: &str) -> Option<Backend> {\n56:         Backend::ALL.into_iter().find(|b| b.name() == name)\n57:     }\n58: \n59:     pub fn name(self) -> &'static str {\n60:         match self {\n61:             Backend::Lua => \"lua\",\n62:             Backend::Js => \"js\",\n63:             Backend::Native => \"native\",\n64:             Backend::Jq => \"jq\",\n65:             Backend::Go => \"go\",\n66:             Backend::Py => \"py\",\n67:             Backend::Rust => \"rust\",\n68:         }\n69:     }\n70: \n71:     pub fn emit(self, program: &Program) -> Result<String, String> {\n72:         match self {\n73:             Backend::Lua => Ok(emit_lua::emit(program)),\n74:             Backend::Js => Ok(emit_js::emit(program)),\n75:             Backend::Native => emit_llvm::to_ir(program),\n76:             Backend::Jq => emit_jq::emit(program),\n77:             Backend::Go => Ok(emit_go::emit(program)),\n78:             Backend::Py => Ok(emit_py::emit(program)),\n79:             Backend::Rust => Ok(emit_rs::emit(program)),\n80:         }\n81:     }\n82: }\n83: \n84: pub fn compile(src: &str) -> Result<Program, Error> {\n85:     let mut file = parse::parse(src)?;\n86:     prelude::inject(&mut file);\n87:     check::check(&file)\n88: }\n89: \n90: /// Parses `src` and re-renders it in the canonical toylang style, without checking or injecting\n91: /// the prelude -- a formatter has to work on a program that does not type-check, and it must\n92: /// never print the prelude definitions `compile` splices in for its own purposes.\n93: pub fn fmt(src: &str) -> Result<String, Error> {\n94:     emit_toylang::format_source(src)\n95: }\n96: \n97: pub fn run(src: &str) -> Result<String> {\n98:     run_on(src, None, Backend::Lua)\n99: }\n100: \n101: pub fn run_with_input(src: &str, stdin: Option<&str>) -> Result<String> {\n102:     run_on(src, stdin, Backend::Lua)\n103: }\n104: \n105: /// Whether the generated code for `program` reads `inputs` for itself, one record at a time,\n106: /// rather than needing the whole thing parsed and handed over up front. A type question now,\n107: /// not a shape guess: exactly the programs `tir::fusion` reads from `inputs` -- every backend\n108: /// has a fused loop to emit. An aggregate like `length(collect(inputs))` still has no way to\n109: /// stream no matter which backend runs it. Public so `main.rs` can decide, before it has read\n110: /// anything, whether to drain real stdin itself or hand it to `run_on` untouched.\n111: pub fn streams_inputs(program: &tir::Program) -> bool {\n112:     matches!(tir::fusion(program), Some(f) if f.source == tir::Source::Inputs)\n113: }\n114: \n115: /// Compile and run, capturing what the program printed -- except when `stdin` is `None` and\n116: /// `streams_inputs` says the backend reads `inputs` for itself, in which case the real stdin and\n117: /// stdout are connected straight through (`Feed::Live`) and there is nothing left to capture.\n118: /// Capturing otherwise keeps the tests to one call: it also means output is held in memory, which\n119: /// is fine for every program whose result has statically known length, and is exactly the case\n120: /// `Feed::Live` exists for on the ones that no longer do.\n121: pub fn run_on(src: &str, stdin: Option<&str>, backend: Backend) -> Result<String> {\n122:     let program = compile(src)?;\n123: \n124:     // `stdin.is_none()` is the same convention `uses_lines` already uses below: nothing was\n125:     // supplied, which only happens on the real command line, never from a test fixture. Only\n126:     // then is there real live stdin worth handing straight to a subprocess backend rather than\n127:     // something already sitting in memory to validate up front.\n128:     let live_inputs = stdin.is_none() && streams_inputs(&program);\n129:     // Lua is the one backend with no subprocess of its own: `run_lua` itself decides how\n130:     // `inputs` reaches the running chunk, by injecting either a pre-populated global or a\n131:     // per-call function, and the emitted source commits to one of those two shapes purely from\n132:     // `tir::fusion`, independent of whether a fixture or the real command line supplied the\n133:     // bytes. So unlike `live_inputs` above, this also has to hold for a fixture-fed test, or\n134:     // the host would inject the global while the fused source calls the function.\n135:     let lua_fused = matches!(backend, Backend::Lua) && streams_inputs(&program);\n136: \n137:     // The input is checked against the declared type once, here, rather than by each backend.\n138:     // What a backend receives has already been parsed, so no backend re-decides what is valid.\n139:     let value = match (&program.input, stdin) {\n140:         (Some(ty), Some(text)) => {\n141:             let value: serde_json::Value = serde_json::from_str(text)?;\n142:             input::validate(&program.enums, &value, ty, \"input\").map_err(anyhow::Error::msg)?;\n143:             Some(value)\n144:         }\n145:         (Some(ty), None) => anyhow::bail!(\"this program reads input, of type {ty}\"),\n146:         (None, _) => None,\n147:     };\n148: \n149:     // `inputs` is eager like `input`, not incremental like `lines`, so it normally goes through\n150:     // the same validate-then-re-serialize step: every backend receives canonical bytes, one\n151:     // compact JSON value per line, rather than whatever formatting the original text happened to\n152:     // use. `live_inputs` and `lua_fused` are the exceptions -- nothing is precomputed for them,\n153:     // because the whole point of a fused loop is not reading the whole stream before the first\n154:     // record is handled. Validation still happens record-by-record on the host: `run_lua`'s\n155:     // `next_input` function does it for the Lua backend it is embedded in, and `Feed::LiveInputs`\n156:     // below does it for every other, subprocess-based backend, since generated code cannot be\n157:     // trusted to reimplement `input::validate` correctly in six different target languages.\n158:     let inputs_values = if live_inputs || lua_fused {\n159:         None\n160:     } else {\n161:         match (&program.inputs, stdin) {\n162:             (Some(elem_ty), Some(text)) => {\n163:                 let mut values = Vec::new();\n164:                 for line in text.lines().filter(|l| !l.trim().is_empty()) {\n165:                     let value: serde_json::Value = serde_json::from_str(line)?;\n166:                     input::validate(&program.enums, &value, elem_ty, \"inputs\")\n167:                         .map_err(anyhow::Error::msg)?;\n168:                     values.push(value);\n169:                 }\n170:                 Some(values)\n171:             }\n172:             (Some(elem_ty), None) => {\n173:                 anyhow::bail!(\"this program reads inputs, of type Vec<{elem_ty}>\");\n174:             }\n175:             (None, _) => None,\n176:         }\n177:     };\n178: \n179:     // What a backend's stdin should be connected to. `input` always has known bytes: the\n180:     // re-serialized, already-validated value. `lines` has known bytes only when a caller (a\n181:     // corpus fixture, most often) supplied them directly -- and when it does, they are piped in\n182:     // verbatim rather than pre-split, so a backend's own splitting genuinely runs against them\n183:     // rather than being bypassed by the test that is supposed to exercise it. Only when nothing\n184:     // was supplied, which is the real command-line case, does `lines` connect the real stdin\n185:     // straight through, with no Rust-side buffering in between -- the one thing that would make\n186:     // its streaming indistinguishable from having read everything first. A live, fused `inputs`\n187:     // program has no type to lean on the way `lines` does (raw text is always valid `Str`), so it\n188:     // cannot connect the real stdin straight through: `Feed::LiveInputs` reads and validates one\n189:     // record at a time itself and forwards only what passes, real streaming with no read-it-all-\n190:     // first buffering, but through Rust rather than direct fd inheritance. The Lua backend is the\n191:     // one exception -- it validates through its own `next_input` function instead, direct from\n192:     // `Feed::Live`, since it runs embedded rather than as a subprocess with a pipe to mediate.\n193:     // A fused Lua program run against a fixture is not live, but still needs the raw bytes\n194:     // verbatim rather than the eager re-serialized form, since `run_lua`'s injected function does\n195:     // its own splitting the same way `lines` always has.\n196:     let feed = if program.uses_lines {\n197:         match stdin {\n198:             Some(text) => Feed::Text(text.to_string()),\n199:             None => Feed::Live,\n200:         }\n201:     } else if live_inputs {\n202:         live_inputs_feed(&program, backend)\n203:     } else if lua_fused {\n204:         Feed::Text(stdin.map(str::to_string).unwrap_or_default())\n205:     } else if let Some(values) = &inputs_values {\n206:         Feed::Text(\n207:             values\n208:                 .iter()\n209:                 .map(|v| v.to_string())\n210:                 .collect::<Vec<_>>()\n211:                 .join(\"\\n\"),\n212:         )\n213:     } else {\n214:         Feed::Text(value.as_ref().map(|v| v.to_string()).unwrap_or_default())\n215:     };\n216: \n217:     match backend {\n218:         Backend::Lua => run_lua(\n219:             &emit_lua::emit(&program),\n220:             &program.enums,\n221:             value.as_ref(),\n222:             inputs_values.as_ref(),\n223:             program.inputs.as_ref(),\n224:             &feed,\n225:         ),\n226:         Backend::Js => run_node(&emit_js::emit(&program), &feed),\n227:         Backend::Jq => run_jq(\n228:             &emit_jq::emit(&program).map_err(anyhow::Error::msg)?,\n229:             JqInvocation {\n230:                 has_value: value.is_some(),\n231:                 raw: program.body.ty == ty::Type::Str,\n232:                 uses_lines: program.uses_lines,\n233:             },\n234:             &feed,\n235:         ),\n236:         Backend::Go => run_go(&emit_go::emit(&program), &feed),\n237:         Backend::Py => run_py(&emit_py::emit(&program), &feed),\n238:         Backend::Native => {\n239:             let dir = tempfile::tempdir()?;\n240:             let exe = dir.path().join(\"program\");\n241:             link(&program, &exe)?;\n242:             run_binary(&exe, &feed)\n243:         }\n244:         Backend::Rust => {\n245:             let dir = tempfile::tempdir()?;\n246:             let exe = dir.path().join(\"program\");\n247:             link_rust(&emit_rs::emit(&program), &exe)?;\n248:             run_binary(&exe, &feed)\n249:         }\n250:     }\n251: }\n252: \n253: /// The feed for a live, fused `inputs` program: real stdin, but validated. Lua is the exception,\n254: /// since `run_lua`'s own `next_input` function validates directly off `Feed::Live` rather than\n255: /// needing `Feed::LiveInputs` to mediate a pipe it has no subprocess to write into.\n256: fn live_inputs_feed(program: &Program, backend: Backend) -> Feed {\n257:     if matches!(backend, Backend::Lua) {\n258:         Feed::Live\n259:     } else {\n260:         Feed::LiveInputs(\n261:             program\n262:                 .inputs\n263:                 .clone()\n264:                 .expect(\"live_inputs implies an inputs type\"),\n265:             program.enums.clone(),\n266:         )\n267:     }\n268: }\n269: \n270: /// What a subprocess backend's stdin is connected to.\n271: enum Feed {\n272:     /// Known bytes, written through a pipe: `input`'s re-serialized value, a `lines` program's\n273:     /// fixture text verbatim, or nothing for a program that reads no stdin at all.\n274:     Text(String),\n275:     /// The real process stdin, inherited rather than piped. Reachable only for a `lines`\n276:     /// program run with no fixture supplied.\n277:     Live,\n278:     /// The real process stdin, read and validated one record at a time against the element type,\n279:     /// then forwarded through a pipe -- real streaming, but mediated by the host rather than\n280:     /// inherited directly, which is what lets `input::validate` see every record before a\n281:     /// subprocess backend's own, untrusted parse of it does. Reachable only for a live, fused\n282:     /// `inputs` program on a backend other than Lua (see `write_to`).\n283:     LiveInputs(ty::Type, ty::Enums),\n284: }\n285: \n286: impl Feed {\n287:     fn stdio(&self) -> std::process::Stdio {\n288:         match self {\n289:             Feed::Text(_) | Feed::LiveInputs(..) => std::process::Stdio::piped(),\n290:             Feed::Live => std::process::Stdio::inherit(),\n291:         }\n292:     }\n293: \n294:     fn write_to(&self, child: &mut std::process::Child) -> Result<()> {\n295:         match self {\n296:             Feed::Text(text) => {\n297:                 child\n298:                     .stdin\n299:                     .take()\n300:                     .expect(\"piped\")\n301:                     .write_all(text.as_bytes())?;\n302:             }\n303:             Feed::Live => {}\n304:             Feed::LiveInputs(elem_ty, enums) => {\n305:                 let mut stdin = child.stdin.take().expect(\"piped\");\n306:                 for line in std::io::stdin().lock().lines() {\n307:                     let line = line?;\n308:                     if line.trim().is_empty() {\n309:                         continue;\n310:                     }\n311:                     let value: serde_json::Value = serde_json::from_str(&line)?;\n312:                     if let Err(msg) = input::validate(enums, &value, elem_ty, \"inputs\") {\n313:                         // Close the pipe so the child sees EOF and can finish printing whatever\n314:                         // it already validly received, then wait for it before reporting the\n315:                         // refusal -- otherwise this leaves an unreaped child behind.\n316:                         drop(stdin);\n317:                         child.wait()?;\n318:                         return Err(anyhow::Error::msg(msg));\n319:                     }\n320:                     writeln!(stdin, \"{line}\")?;\n321:                 }\n322:             }\n323:         }\n324:         Ok(())\n325:     }\n326: }\n327: \n328: /// Compile to a native executable at `out`.\n329: ///\n330: /// LLVM produces an object file, which is not a program, so this shells out to `cc` for the\n331: /// link. That is a toolchain requirement the Lua backend does not have, since mlua vendors its\n332: /// interpreter.\n333: pub fn link(program: &Program, out: &std::path::Path) -> Result<()> {\n334:     let dir = tempfile::tempdir()?;\n335:     let object = dir.path().join(\"program.o\");\n336:     emit_llvm::compile_to_object(program, &object).map_err(anyhow::Error::msg)?;\n337: \n338:     // The runtime is compiled alongside rather than shipped as a library, which keeps the build\n339:     // to one `cc` call and means there is nothing to install.\n340:     let runtime = dir.path().join(\"toylang.c\");\n341:     std::fs::write(&runtime, emit_llvm::RUNTIME_C)?;\n342: \n343:     let status = std::process::Command::new(\"cc\")\n344:         .arg(&object)\n345:         .arg(&runtime)\n346:         .arg(\"-o\")\n347:         .arg(out)\n348:         .status()\n349:         .context(\"could not run `cc`\")?;\n350:     if !status.success() {\n351:         anyhow::bail!(\"cc failed to link: {status}\");\n352:     }\n353:     Ok(())\n354: }\n355: \n356: /// Compile Rust source to an executable at `out`. One `rustc` call on one self-contained file,\n357: /// no external crate and no Cargo project, the same reason `link` above is one `cc` call: the\n358: /// generated source depends on nothing this compiler did not already assume was installed.\n359: /// Public for the same reason as `link`: `tests/backend_rust.rs` calls it directly, separately\n360: /// from running the result, so a genuine codegen gap (`rustc` rejects the source) is told apart\n361: /// from a legitimate runtime refusal (`rustc` succeeds, the binary exits non-zero).\n362: pub fn link_rust(source: &str, out: &std::path::Path) -> Result<()> {\n363:     let dir = tempfile::tempdir()?;\n364:     let src = dir.path().join(\"program.rs\");\n365:     std::fs::write(&src, source)?;\n366: \n367:     let result = std::process::Command::new(\"rustc\")\n368:         .arg(\"--edition\")\n369:         .arg(\"2021\")\n370:         .arg(&src)\n371:         .arg(\"-o\")\n372:         .arg(out)\n373:         .output()\n374:         .context(\"could not run `rustc`\")?;\n375:     if !result.status.success() {\n376:         anyhow::bail!(\n377:             \"rustc failed to compile: {}\",\n378:             String::from_utf8_lossy(&result.stderr)\n379:         );\n380:     }\n381:     Ok(())\n382: }\n383: \n384: /// Runs `cmd` (already given whatever args the caller needs) connected to `feed`, and returns\n385: /// what it printed.\n386: ///\n387: /// When `feed` is `Feed::Live` or `Feed::LiveInputs` there is no test harness reading the result\n388: /// back: stdout and stderr are inherited straight through to the real terminal or pipe instead of\n389: /// being captured, which is what lets a program that streams actually show output as it produces\n390: /// it rather than all at once when it exits. `Ok(String::new())` reflects that nothing is left to\n391: /// hand back -- it already went to the real stdout directly. `feed.write_to` reports a validation\n392: /// refusal for `Feed::LiveInputs` as an `Err` before this function's own `child.wait()` runs, so\n393: /// that path never reaches here at all.\n394: fn run_subprocess(mut cmd: std::process::Command, label: &str, feed: &Feed) -> Result<String> {\n395:     let live = matches!(feed, Feed::Live | Feed::LiveInputs(..));\n396:     let mut child = cmd\n397:         .stdin(feed.stdio())\n398:         .stdout(if live {\n399:             std::process::Stdio::inherit()\n400:         } else {\n401:             std::process::Stdio::piped()\n402:         })\n403:         .stderr(if live {\n404:             std::process::Stdio::inherit()\n405:         } else {\n406:             std::process::Stdio::piped()\n407:         })\n408:         .spawn()\n409:         .with_context(|| format!(\"could not run `{label}`\"))?;\n410: \n411:     feed.write_to(&mut child)?;\n412: \n413:     if live {\n414:         let status = child.wait()?;\n415:         if !status.success() {\n416:             anyhow::bail!(\"{label} failed\");\n417:         }\n418:         return Ok(String::new());\n419:     }\n420: \n421:     let out = child.wait_with_output()?;\n422:     if !out.status.success() {\n423:         anyhow::bail!(\"{label} failed: {}\", String::from_utf8_lossy(&out.stderr));\n424:     }\n425:     Ok(String::from_utf8(out.stdout)?)\n426: }\n427: \n428: fn run_binary(exe: &std::path::Path, feed: &Feed) -> Result<String> {\n429:     run_subprocess(\n430:         std::process::Command::new(exe),\n431:         \"the compiled program\",\n432:         feed,\n433:     )\n434: }\n435: \n436: /// jq puts stdin in `.`, so a program that reads no input runs with `-n` rather than waiting on\n437: /// a terminal. `has_value` rather than the `Feed` itself, since a `lines` program run live\n438: /// (`Feed::Live`) still has real stdin coming and must not get `-n` on that account.\n439: /// The three facts about a program that shape a jq invocation's flags. Each is derived from\n440: /// the compiled program, not a caller identity -- the fn-params-excessive-bools finding on the\n441: /// old three-bool signature was escalated, and the settled answer was this struct: the facts\n442: /// travel under their names.\n443: struct JqInvocation {\n444:     has_value: bool,\n445:     raw: bool,\n446:     uses_lines: bool,\n447: }\n448: \n449: fn run_jq(source: &str, inv: JqInvocation, feed: &Feed) -> Result<String> {\n450:     let JqInvocation {\n451:         has_value,\n452:         raw,\n453:         uses_lines,\n454:     } = inv;\n455:     let mut cmd = std::process::Command::new(\"jq\");\n456:     // jq's stdout is fully buffered rather than line-buffered whenever it is not a terminal, the\n457:     // same as any other libc stdio program, so a filter over `inputs` piped into another process\n458:     // would otherwise sit on every result until the run ends. `run_subprocess` only inherits\n459:     // stdout instead of capturing it for a live run, so this is still what makes that case show a\n460:     // result as soon as jq produces one rather than at exit.\n461:     cmd.arg(\"--unbuffered\");\n462:     cmd.arg(\"-c\");\n463:     // `-r` decides from the runtime value, so it would print a present Opt<Str> raw and an\n464:     // absent one as the word null. The rule here is the type's, as on every other backend.\n465:     if raw {\n466:         cmd.arg(\"-r\");\n467:     }\n468:     if !has_value && !uses_lines {\n469:         cmd.arg(\"-n\");\n470:     }\n471:     // Raw-input mode, needed for `[ inputs ]` to read lines rather than JSON, and forced by the\n472:     // checker to be the only way `lines` is used in this invocation: mixing it with `input` was\n473:     // rejected there, because `-R` changes what the whole invocation means, not just one call.\n474:     // `-n` here is not \"no input coming\"; it is what raw-input mode needs regardless, since\n475:     // `[ inputs ]` reads for itself rather than through the implicit `.` a normal run would use.\n476:     if uses_lines {\n477:         cmd.arg(\"-R\").arg(\"-n\");\n478:     }\n479:     cmd.arg(source);\n480:     run_subprocess(cmd, \"jq\", feed)\n481: }\n482: \n483: fn run_lua(\n484:     source: &str,\n485:     enums: &ty::Enums,\n486:     value: Option<&serde_json::Value>,\n487:     inputs_values: Option<&Vec<serde_json::Value>>,\n488:     inputs_elem_ty: Option<&ty::Type>,\n489:     feed: &Feed,\n490: ) -> Result<String> {\n491:     let lua = mlua::Lua::new();\n492:     if let Some(value) = value {\n493:         lua.globals()\n494:             .set(emit_lua::INPUT, input::to_lua(&lua, value)?)?;\n495:     }\n496:     if let Some(values) = inputs_values {\n497:         let array = serde_json::Value::Array(values.clone());\n498:         lua.globals()\n499:             .set(emit_lua::INPUTS, input::to_lua(&lua, &array)?)?;\n500:     } else if let Some(elem_ty) = inputs_elem_ty {\n501:         // `inputs_values` is `None` here for one of two reasons: the program does not read\n502:         // `inputs` at all (then `inputs_elem_ty` is also `None`, and neither branch runs), or\n503:         // `run_on` recognized this as a fused program and skipped precomputing the whole Vec on\n504:         // purpose (`live_inputs` or `lua_fused` there). mlua is embedded in this same process, so\n505:         // there is no separate JSON parser to write in Lua source the way Rust's own is -- the\n506:         // generated source just calls this function for the next already-validated, already-\n507:         // converted record. Reading from `feed` rather than always the real stdin is what keeps\n508:         // this correct for a fixture-tested fused program too: `feed` is `Feed::Text` there, the\n509:         // same raw bytes a subprocess backend would have been piped.\n510:         let elem_ty = elem_ty.clone();\n511:         let enums = enums.clone();\n512:         let reader: RefCell<Box<dyn std::io::BufRead>> = RefCell::new(match feed {\n513:             Feed::Live => Box::new(std::io::BufReader::new(std::io::stdin())),\n514:             Feed::Text(text) => Box::new(std::io::Cursor::new(text.clone().into_bytes())),\n515:             // `run_on` never builds this feed for the Lua backend: `live_inputs` there stays\n516:             // `Feed::Live`, since this function's own reader validates each record itself.\n517:             Feed::LiveInputs(..) => unreachable!(\"run_on keeps the Lua backend on Feed::Live\"),\n518:         });\n519:         let next_input = lua.create_function(move |lua, ()| {\n520:             use std::io::BufRead;\n521:             loop {\n522:                 let mut line = String::new();\n523:                 let n = reader\n524:                     .borrow_mut()\n525:                     .read_line(&mut line)\n526:                     .map_err(mlua::Error::external)?;\n527:                 if n == 0 {\n528:                     return Ok(mlua::Value::Nil);\n529:                 }\n530:                 let line = line.strip_suffix('\\n').unwrap_or(&line);\n531:                 if line.trim().is_empty() {\n532:                     continue;\n533:                 }\n534:                 let value: serde_json::Value =\n535:                     serde_json::from_str(line).map_err(mlua::Error::external)?;\n536:                 input::validate(&enums, &value, &elem_ty, \"inputs\")\n537:                     .map_err(mlua::Error::RuntimeError)?;\n538:                 return input::to_lua(lua, &value);\n539:             }\n540:         })?;\n541:         lua.globals().set(emit_lua::NEXT_INPUT, next_input)?;\n542:     }\n543:     // mlua is embedded in this same process, so `io.lines()` in the emitted source reads the\n544:     // real stdin directly -- verified against a live pipe, and exactly what a `lines` program\n545:     // run for real should do. A fixture is different: cargo test runs many tests concurrently\n546:     // in one process, so redirecting the process's own fd 0 would race with all of them, and is\n547:     // not done. Instead the fixture is written to a file of its own and `io.lines` is pointed at\n548:     // it, which keeps Lua's own real line-splitting in the loop rather than reimplementing it in\n549:     // Rust and only testing that reimplementation.\n550:     let _fixture_dir;\n551:     if let Feed::Text(text) = feed {\n552:         let dir = tempfile::tempdir()?;\n553:         let path = dir.path().join(\"stdin.txt\");\n554:         std::fs::write(&path, text)?;\n555:         let path = path\n556:             .to_str()\n557:             .expect(\"a temp path is valid UTF-8\")\n558:             .to_string();\n559:         let io: mlua::Table = lua.globals().get(\"io\")?;\n560:         let real_lines: mlua::Function = io.get(\"lines\")?;\n561:         let fixture =\n562:             lua.create_function(move |_, ()| real_lines.call::<mlua::Value>(path.clone()))?;\n563:         io.set(\"lines\", fixture)?;\n564:         _fixture_dir = Some(dir);\n565:     }\n566: \n567:     // A live run has no test harness reading the result back, the same distinction\n568:     // `run_subprocess` makes for the OS-process backends: `print` writes straight to the real\n569:     // stdout and flushes per call instead of buffering into a string only handed back once the\n570:     // whole chunk finishes.\n571:     let live = matches!(feed, Feed::Live);\n572:     let captured = Rc::new(RefCell::new(String::new()));\n573:     let sink = Rc::clone(&captured);\n574:     let print = lua.create_function(move |_, s: String| {\n575:         if live {\n576:             let mut stdout = std::io::stdout();\n577:             writeln!(stdout, \"{s}\").map_err(mlua::Error::external)?;\n578:             stdout.flush().map_err(mlua::Error::external)?;\n579:         } else {\n580:             sink.borrow_mut().push_str(&s);\n581:             sink.borrow_mut().push('\\n');\n582:         }\n583:         Ok(())\n584:     })?;\n585:     lua.globals().set(\"print\", print)?;\n586: \n587:     lua.load(source).exec()?;\n588: \n589:     if live {\n590:         return Ok(String::new());\n591:     }\n592:     let out = captured.borrow().clone();\n593:     Ok(out)\n594: }\n595: \n596: /// Runs through `python3`. Like `node`, this is an interpreter that has to be on the machine\n597: /// rather than one vendored into the build.\n598: fn run_py(source: &str, feed: &Feed) -> Result<String> {\n599:     let dir = tempfile::tempdir()?;\n600:     let path = dir.path().join(\"program.py\");\n601:     std::fs::write(&path, source)?;\n602: \n603:     let mut cmd = std::process::Command::new(\"python3\");\n604:     cmd.arg(&path);\n605:     run_subprocess(cmd, \"python3\", feed)\n606: }\n607: \n608: /// Runs through `go run`, which compiles and executes in one step. Go has no interpreter, so\n609: /// this is the second backend that needs a real toolchain; like `node` and `cc`, a missing one\n610: /// is an error rather than a skipped backend.\n611: fn run_go(source: &str, feed: &Feed) -> Result<String> {\n612:     let dir = tempfile::tempdir()?;\n613:     let path = dir.path().join(\"main.go\");\n614:     std::fs::write(&path, source)?;\n615: \n616:     let mut cmd = std::process::Command::new(\"go\");\n617:     cmd.arg(\"run\").arg(&path);\n618:     run_subprocess(cmd, \"go\", feed)\n619: }\n620: \n621: /// Runs through `node`, which must be present. A missing toolchain is an error rather than a\n622: /// quietly skipped backend: a report that says two backends agreed when only one ran is worse\n623: /// than no report.\n624: fn run_node(source: &str, feed: &Feed) -> Result<String> {\n625:     let dir = tempfile::tempdir()?;\n626:     let path = dir.path().join(\"program.js\");\n627:     std::fs::write(&path, source)?;\n628: \n629:     let mut cmd = std::process::Command::new(\"node\");\n630:     cmd.arg(&path);\n631:     run_subprocess(cmd, \"node\", feed)\n632: }\n633: \n634: impl std::error::Error for Error {}\n\n(End of file - total 634 lines)\n</content>","metadata":{"preview":"pub mod ast;\npub mod check;\npub mod emit_go;\npub mod emit_jq;\npub mod emit_js;\npub mod emit_llvm;\npub mod emit_lua;\npub mod emit_py;\npub mod emit_rs;\npub mod emit_toylang;\npub mod error;\npub mod fmt_tree;\npub mod input;\npub mod parse;\npub mod prelude;\npub mod tags;\npub mod tir;\npub mod ty;\n\nuse std::cell::RefCell;","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-149/src/lib.rs","text":"pub mod ast;\npub mod check;\npub mod emit_go;\npub mod emit_jq;\npub mod emit_js;\npub mod emit_llvm;\npub mod emit_lua;\npub mod emit_py;\npub mod emit_rs;\npub mod emit_toylang;\npub mod error;\npub mod fmt_tree;\npub mod input;\npub mod parse;\npub mod prelude;\npub mod tags;\npub mod tir;\npub mod ty;\n\nuse std::cell::RefCell;\nuse std::io::{BufRead, Write};\nuse std::rc::Rc;\n\nuse anyhow::{Context, Result};\nuse error::Error;\nuse tir::Program;\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum Backend {\n    Lua,\n    Js,\n    Native,\n    Jq,\n    Go,\n    Py,\n    Rust,\n}\n\nimpl Backend {\n    /// The backends that must agree on every corpus program. Native and Rust each joined once\n    /// they could compile the whole language; until then they were kept out rather than allowed\n    /// to turn the harness permanently red, tracked by tests/backend_llvm.rs and\n    /// tests/backend_rust.rs respectively.\n    pub const ALL: [Backend; 7] = [\n        Backend::Lua,\n        Backend::Js,\n        Backend::Native,\n        Backend::Jq,\n        Backend::Go,\n        Backend::Py,\n        Backend::Rust,\n    ];\n\n    /// The spelling used on the command line and in a corpus case's `snapshot` list.\n    pub fn from_name(name: &str) -> Option<Backend> {\n        Backend::ALL.into_iter().find(|b| b.name() == name)\n    }\n\n    pub fn name(self) -> &'static str {\n        match self {\n            Backend::Lua => \"lua\",\n            Backend::Js => \"js\",\n            Backend::Native => \"native\",\n            Backend::Jq => \"jq\",\n            Backend::Go => \"go\",\n            Backend::Py => \"py\",\n            Backend::Rust => \"rust\",\n        }\n    }\n\n    pub fn emit(self, program: &Program) -> Result<String, String> {\n        match self {\n            Backend::Lua => Ok(emit_lua::emit(program)),\n            Backend::Js => Ok(emit_js::emit(program)),\n            Backend::Native => emit_llvm::to_ir(program),\n            Backend::Jq => emit_jq::emit(program),\n            Backend::Go => Ok(emit_go::emit(program)),\n            Backend::Py => Ok(emit_py::emit(program)),\n            Backend::Rust => Ok(emit_rs::emit(program)),\n        }\n    }\n}\n\npub fn compile(src: &str) -> Result<Program, Error> {\n    let mut file = parse::parse(src)?;\n    prelude::inject(&mut file);\n    check::check(&file)\n}\n\n/// Parses `src` and re-renders it in the canonical toylang style, without checking or injecting\n/// the prelude -- a formatter has to work on a program that does not type-check, and it must\n/// never print the prelude definitions `compile` splices in for its own purposes.\npub fn fmt(src: &str) -> Result<String, Error> {\n    emit_toylang::format_source(src)\n}\n\npub fn run(src: &str) -> Result<String> {\n    run_on(src, None, Backend::Lua)\n}\n\npub fn run_with_input(src: &str, stdin: Option<&str>) -> Result<String> {\n    run_on(src, stdin, Backend::Lua)\n}\n\n/// Whether the generated code for `program` reads `inputs` for itself, one record at a time,\n/// rather than needing the whole thing parsed and handed over up front. A type question now,\n/// not a shape guess: exactly the programs `tir::fusion` reads from `inputs` -- every backend\n/// has a fused loop to emit. An aggregate like `length(collect(inputs))` still has no way to\n/// stream no matter which backend runs it. Public so `main.rs` can decide, before it has read\n/// anything, whether to drain real stdin itself or hand it to `run_on` untouched.\npub fn streams_inputs(program: &tir::Program) -> bool {\n    matches!(tir::fusion(program), Some(f) if f.source == tir::Source::Inputs)\n}\n\n/// Compile and run, capturing what the program printed -- except when `stdin` is `None` and\n/// `streams_inputs` says the backend reads `inputs` for itself, in which case the real stdin and\n/// stdout are connected straight through (`Feed::Live`) and there is nothing left to capture.\n/// Capturing otherwise keeps the tests to one call: it also means output is held in memory, which\n/// is fine for every program whose result has statically known length, and is exactly the case\n/// `Feed::Live` exists for on the ones that no longer do.\npub fn run_on(src: &str, stdin: Option<&str>, backend: Backend) -> Result<String> {\n    let program = compile(src)?;\n\n    // `stdin.is_none()` is the same convention `uses_lines` already uses below: nothing was\n    // supplied, which only happens on the real command line, never from a test fixture. Only\n    // then is there real live stdin worth handing straight to a subprocess backend rather than\n    // something already sitting in memory to validate up front.\n    let live_inputs = stdin.is_none() && streams_inputs(&program);\n    // Lua is the one backend with no subprocess of its own: `run_lua` itself decides how\n    // `inputs` reaches the running chunk, by injecting either a pre-populated global or a\n    // per-call function, and the emitted source commits to one of those two shapes purely from\n    // `tir::fusion`, independent of whether a fixture or the real command line supplied the\n    // bytes. So unlike `live_inputs` above, this also has to hold for a fixture-fed test, or\n    // the host would inject the global while the fused source calls the function.\n    let lua_fused = matches!(backend, Backend::Lua) && streams_inputs(&program);\n\n    // The input is checked against the declared type once, here, rather than by each backend.\n    // What a backend receives has already been parsed, so no backend re-decides what is valid.\n    let value = match (&program.input, stdin) {\n        (Some(ty), Some(text)) => {\n            let value: serde_json::Value = serde_json::from_str(text)?;\n            input::validate(&program.enums, &value, ty, \"input\").map_err(anyhow::Error::msg)?;\n            Some(value)\n        }\n        (Some(ty), None) => anyhow::bail!(\"this program reads input, of type {ty}\"),\n        (None, _) => None,\n    };\n\n    // `inputs` is eager like `input`, not incremental like `lines`, so it normally goes through\n    // the same validate-then-re-serialize step: every backend receives canonical bytes, one\n    // compact JSON value per line, rather than whatever formatting the original text happened to\n    // use. `live_inputs` and `lua_fused` are the exceptions -- nothing is precomputed for them,\n    // because the whole point of a fused loop is not reading the whole stream before the first\n    // record is handled. Validation still happens record-by-record on the host: `run_lua`'s\n    // `next_input` function does it for the Lua backend it is embedded in, and `Feed::LiveInputs`\n    // below does it for every other, subprocess-based backend, since generated code cannot be\n    // trusted to reimplement `input::validate` correctly in six different target languages.\n    let inputs_values = if live_inputs || lua_fused {\n        None\n    } else {\n        match (&program.inputs, stdin) {\n            (Some(elem_ty), Some(text)) => {\n                let mut values = Vec::new();\n                for line in text.lines().filter(|l| !l.trim().is_empty()) {\n                    let value: serde_json::Value = serde_json::from_str(line)?;\n                    input::validate(&program.enums, &value, elem_ty, \"inputs\")\n                        .map_err(anyhow::Error::msg)?;\n                    values.push(value);\n                }\n                Some(values)\n            }\n            (Some(elem_ty), None) => {\n                anyhow::bail!(\"this program reads inputs, of type Vec<{elem_ty}>\");\n            }\n            (None, _) => None,\n        }\n    };\n\n    // What a backend's stdin should be connected to. `input` always has known bytes: the\n    // re-serialized, already-validated value. `lines` has known bytes only when a caller (a\n    // corpus fixture, most often) supplied them directly -- and when it does, they are piped in\n    // verbatim rather than pre-split, so a backend's own splitting genuinely runs against them\n    // rather than being bypassed by the test that is supposed to exercise it. Only when nothing\n    // was supplied, which is the real command-line case, does `lines` connect the real stdin\n    // straight through, with no Rust-side buffering in between -- the one thing that would make\n    // its streaming indistinguishable from having read everything first. A live, fused `inputs`\n    // program has no type to lean on the way `lines` does (raw text is always valid `Str`), so it\n    // cannot connect the real stdin straight through: `Feed::LiveInputs` reads and validates one\n    // record at a time itself and forwards only what passes, real streaming with no read-it-all-\n    // first buffering, but through Rust rather than direct fd inheritance. The Lua backend is the\n    // one exception -- it validates through its own `next_input` function instead, direct from\n    // `Feed::Live`, since it runs embedded rather than as a subprocess with a pipe to mediate.\n    // A fused Lua program run against a fixture is not live, but still needs the raw bytes\n    // verbatim rather than the eager re-serialized form, since `run_lua`'s injected function does\n    // its own splitting the same way `lines` always has.\n    let feed = if program.uses_lines {\n        match stdin {\n            Some(text) => Feed::Text(text.to_string()),\n            None => Feed::Live,\n        }\n    } else if live_inputs {\n        live_inputs_feed(&program, backend)\n    } else if lua_fused {\n        Feed::Text(stdin.map(str::to_string).unwrap_or_default())\n    } else if let Some(values) = &inputs_values {\n        Feed::Text(\n            values\n                .iter()\n                .map(|v| v.to_string())\n                .collect::<Vec<_>>()\n                .join(\"\\n\"),\n        )\n    } else {\n        Feed::Text(value.as_ref().map(|v| v.to_string()).unwrap_or_default())\n    };\n\n    match backend {\n        Backend::Lua => run_lua(\n            &emit_lua::emit(&program),\n            &program.enums,\n            value.as_ref(),\n            inputs_values.as_ref(),\n            program.inputs.as_ref(),\n            &feed,\n        ),\n        Backend::Js => run_node(&emit_js::emit(&program), &feed),\n        Backend::Jq => run_jq(\n            &emit_jq::emit(&program).map_err(anyhow::Error::msg)?,\n            JqInvocation {\n                has_value: value.is_some(),\n                raw: program.body.ty == ty::Type::Str,\n                uses_lines: program.uses_lines,\n            },\n            &feed,\n        ),\n        Backend::Go => run_go(&emit_go::emit(&program), &feed),\n        Backend::Py => run_py(&emit_py::emit(&program), &feed),\n        Backend::Native => {\n            let dir = tempfile::tempdir()?;\n            let exe = dir.path().join(\"program\");\n            link(&program, &exe)?;\n            run_binary(&exe, &feed)\n        }\n        Backend::Rust => {\n            let dir = tempfile::tempdir()?;\n            let exe = dir.path().join(\"program\");\n            link_rust(&emit_rs::emit(&program), &exe)?;\n            run_binary(&exe, &feed)\n        }\n    }\n}\n\n/// The feed for a live, fused `inputs` program: real stdin, but validated. Lua is the exception,\n/// since `run_lua`'s own `next_input` function validates directly off `Feed::Live` rather than\n/// needing `Feed::LiveInputs` to mediate a pipe it has no subprocess to write into.\nfn live_inputs_feed(program: &Program, backend: Backend) -> Feed {\n    if matches!(backend, Backend::Lua) {\n        Feed::Live\n    } else {\n        Feed::LiveInputs(\n            program\n                .inputs\n                .clone()\n                .expect(\"live_inputs implies an inputs type\"),\n            program.enums.clone(),\n        )\n    }\n}\n\n/// What a subprocess backend's stdin is connected to.\nenum Feed {\n    /// Known bytes, written through a pipe: `input`'s re-serialized value, a `lines` program's\n    /// fixture text verbatim, or nothing for a program that reads no stdin at all.\n    Text(String),\n    /// The real process stdin, inherited rather than piped. Reachable only for a `lines`\n    /// program run with no fixture supplied.\n    Live,\n    /// The real process stdin, read and validated one record at a time against the element type,\n    /// then forwarded through a pipe -- real streaming, but mediated by the host rather than\n    /// inherited directly, which is what lets `input::validate` see every record before a\n    /// subprocess backend's own, untrusted parse of it does. Reachable only for a live, fused\n    /// `inputs` program on a backend other than Lua (see `write_to`).\n    LiveInputs(ty::Type, ty::Enums),\n}\n\nimpl Feed {\n    fn stdio(&self) -> std::process::Stdio {\n        match self {\n            Feed::Text(_) | Feed::LiveInputs(..) => std::process::Stdio::piped(),\n            Feed::Live => std::process::Stdio::inherit(),\n        }\n    }\n\n    fn write_to(&self, child: &mut std::process::Child) -> Result<()> {\n        match self {\n            Feed::Text(text) => {\n                child\n                    .stdin\n                    .take()\n                    .expect(\"piped\")\n                    .write_all(text.as_bytes())?;\n            }\n            Feed::Live => {}\n            Feed::LiveInputs(elem_ty, enums) => {\n                let mut stdin = child.stdin.take().expect(\"piped\");\n                for line in std::io::stdin().lock().lines() {\n                    let line = line?;\n                    if line.trim().is_empty() {\n                        continue;\n                    }\n                    let value: serde_json::Value = serde_json::from_str(&line)?;\n                    if let Err(msg) = input::validate(enums, &value, elem_ty, \"inputs\") {\n                        // Close the pipe so the child sees EOF and can finish printing whatever\n                        // it already validly received, then wait for it before reporting the\n                        // refusal -- otherwise this leaves an unreaped child behind.\n                        drop(stdin);\n                        child.wait()?;\n                        return Err(anyhow::Error::msg(msg));\n                    }\n                    writeln!(stdin, \"{line}\")?;\n                }\n            }\n        }\n        Ok(())\n    }\n}\n\n/// Compile to a native executable at `out`.\n///\n/// LLVM produces an object file, which is not a program, so this shells out to `cc` for the\n/// link. That is a toolchain requirement the Lua backend does not have, since mlua vendors its\n/// interpreter.\npub fn link(program: &Program, out: &std::path::Path) -> Result<()> {\n    let dir = tempfile::tempdir()?;\n    let object = dir.path().join(\"program.o\");\n    emit_llvm::compile_to_object(program, &object).map_err(anyhow::Error::msg)?;\n\n    // The runtime is compiled alongside rather than shipped as a library, which keeps the build\n    // to one `cc` call and means there is nothing to install.\n    let runtime = dir.path().join(\"toylang.c\");\n    std::fs::write(&runtime, emit_llvm::RUNTIME_C)?;\n\n    let status = std::process::Command::new(\"cc\")\n        .arg(&object)\n        .arg(&runtime)\n        .arg(\"-o\")\n        .arg(out)\n        .status()\n        .context(\"could not run `cc`\")?;\n    if !status.success() {\n        anyhow::bail!(\"cc failed to link: {status}\");\n    }\n    Ok(())\n}\n\n/// Compile Rust source to an executable at `out`. One `rustc` call on one self-contained file,\n/// no external crate and no Cargo project, the same reason `link` above is one `cc` call: the\n/// generated source depends on nothing this compiler did not already assume was installed.\n/// Public for the same reason as `link`: `tests/backend_rust.rs` calls it directly, separately\n/// from running the result, so a genuine codegen gap (`rustc` rejects the source) is told apart\n/// from a legitimate runtime refusal (`rustc` succeeds, the binary exits non-zero).\npub fn link_rust(source: &str, out: &std::path::Path) -> Result<()> {\n    let dir = tempfile::tempdir()?;\n    let src = dir.path().join(\"program.rs\");\n    std::fs::write(&src, source)?;\n\n    let result = std::process::Command::new(\"rustc\")\n        .arg(\"--edition\")\n        .arg(\"2021\")\n        .arg(&src)\n        .arg(\"-o\")\n        .arg(out)\n        .output()\n        .context(\"could not run `rustc`\")?;\n    if !result.status.success() {\n        anyhow::bail!(\n            \"rustc failed to compile: {}\",\n            String::from_utf8_lossy(&result.stderr)\n        );\n    }\n    Ok(())\n}\n\n/// Runs `cmd` (already given whatever args the caller needs) connected to `feed`, and returns\n/// what it printed.\n///\n/// When `feed` is `Feed::Live` or `Feed::LiveInputs` there is no test harness reading the result\n/// back: stdout and stderr are inherited straight through to the real terminal or pipe instead of\n/// being captured, which is what lets a program that streams actually show output as it produces\n/// it rather than all at once when it exits. `Ok(String::new())` reflects that nothing is left to\n/// hand back -- it already went to the real stdout directly. `feed.write_to` reports a validation\n/// refusal for `Feed::LiveInputs` as an `Err` before this function's own `child.wait()` runs, so\n/// that path never reaches here at all.\nfn run_subprocess(mut cmd: std::process::Command, label: &str, feed: &Feed) -> Result<String> {\n    let live = matches!(feed, Feed::Live | Feed::LiveInputs(..));\n    let mut child = cmd\n        .stdin(feed.stdio())\n        .stdout(if live {\n            std::process::Stdio::inherit()\n        } else {\n            std::process::Stdio::piped()\n        })\n        .stderr(if live {\n            std::process::Stdio::inherit()\n        } else {\n            std::process::Stdio::piped()\n        })\n        .spawn()\n        .with_context(|| format!(\"could not run `{label}`\"))?;\n\n    feed.write_to(&mut child)?;\n\n    if live {\n        let status = child.wait()?;\n        if !status.success() {\n            anyhow::bail!(\"{label} failed\");\n        }\n        return Ok(String::new());\n    }\n\n    let out = child.wait_with_output()?;\n    if !out.status.success() {\n        anyhow::bail!(\"{label} failed: {}\", String::from_utf8_lossy(&out.stderr));\n    }\n    Ok(String::from_utf8(out.stdout)?)\n}\n\nfn run_binary(exe: &std::path::Path, feed: &Feed) -> Result<String> {\n    run_subprocess(\n        std::process::Command::new(exe),\n        \"the compiled program\",\n        feed,\n    )\n}\n\n/// jq puts stdin in `.`, so a program that reads no input runs with `-n` rather than waiting on\n/// a terminal. `has_value` rather than the `Feed` itself, since a `lines` program run live\n/// (`Feed::Live`) still has real stdin coming and must not get `-n` on that account.\n/// The three facts about a program that shape a jq invocation's flags. Each is derived from\n/// the compiled program, not a caller identity -- the fn-params-excessive-bools finding on the\n/// old three-bool signature was escalated, and the settled answer was this struct: the facts\n/// travel under their names.\nstruct JqInvocation {\n    has_value: bool,\n    raw: bool,\n    uses_lines: bool,\n}\n\nfn run_jq(source: &str, inv: JqInvocation, feed: &Feed) -> Result<String> {\n    let JqInvocation {\n        has_value,\n        raw,\n        uses_lines,\n    } = inv;\n    let mut cmd = std::process::Command::new(\"jq\");\n    // jq's stdout is fully buffered rather than line-buffered whenever it is not a terminal, the\n    // same as any other libc stdio program, so a filter over `inputs` piped into another process\n    // would otherwise sit on every result until the run ends. `run_subprocess` only inherits\n    // stdout instead of capturing it for a live run, so this is still what makes that case show a\n    // result as soon as jq produces one rather than at exit.\n    cmd.arg(\"--unbuffered\");\n    cmd.arg(\"-c\");\n    // `-r` decides from the runtime value, so it would print a present Opt<Str> raw and an\n    // absent one as the word null. The rule here is the type's, as on every other backend.\n    if raw {\n        cmd.arg(\"-r\");\n    }\n    if !has_value && !uses_lines {\n        cmd.arg(\"-n\");\n    }\n    // Raw-input mode, needed for `[ inputs ]` to read lines rather than JSON, and forced by the\n    // checker to be the only way `lines` is used in this invocation: mixing it with `input` was\n    // rejected there, because `-R` changes what the whole invocation means, not just one call.\n    // `-n` here is not \"no input coming\"; it is what raw-input mode needs regardless, since\n    // `[ inputs ]` reads for itself rather than through the implicit `.` a normal run would use.\n    if uses_lines {\n        cmd.arg(\"-R\").arg(\"-n\");\n    }\n    cmd.arg(source);\n    run_subprocess(cmd, \"jq\", feed)\n}\n\nfn run_lua(\n    source: &str,\n    enums: &ty::Enums,\n    value: Option<&serde_json::Value>,\n    inputs_values: Option<&Vec<serde_json::Value>>,\n    inputs_elem_ty: Option<&ty::Type>,\n    feed: &Feed,\n) -> Result<String> {\n    let lua = mlua::Lua::new();\n    if let Some(value) = value {\n        lua.globals()\n            .set(emit_lua::INPUT, input::to_lua(&lua, value)?)?;\n    }\n    if let Some(values) = inputs_values {\n        let array = serde_json::Value::Array(values.clone());\n        lua.globals()\n            .set(emit_lua::INPUTS, input::to_lua(&lua, &array)?)?;\n    } else if let Some(elem_ty) = inputs_elem_ty {\n        // `inputs_values` is `None` here for one of two reasons: the program does not read\n        // `inputs` at all (then `inputs_elem_ty` is also `None`, and neither branch runs), or\n        // `run_on` recognized this as a fused program and skipped precomputing the whole Vec on\n        // purpose (`live_inputs` or `lua_fused` there). mlua is embedded in this same process, so\n        // there is no separate JSON parser to write in Lua source the way Rust's own is -- the\n        // generated source just calls this function for the next already-validated, already-\n        // converted record. Reading from `feed` rather than always the real stdin is what keeps\n        // this correct for a fixture-tested fused program too: `feed` is `Feed::Text` there, the\n        // same raw bytes a subprocess backend would have been piped.\n        let elem_ty = elem_ty.clone();\n        let enums = enums.clone();\n        let reader: RefCell<Box<dyn std::io::BufRead>> = RefCell::new(match feed {\n            Feed::Live => Box::new(std::io::BufReader::new(std::io::stdin())),\n            Feed::Text(text) => Box::new(std::io::Cursor::new(text.clone().into_bytes())),\n            // `run_on` never builds this feed for the Lua backend: `live_inputs` there stays\n            // `Feed::Live`, since this function's own reader validates each record itself.\n            Feed::LiveInputs(..) => unreachable!(\"run_on keeps the Lua backend on Feed::Live\"),\n        });\n        let next_input = lua.create_function(move |lua, ()| {\n            use std::io::BufRead;\n            loop {\n                let mut line = String::new();\n                let n = reader\n                    .borrow_mut()\n                    .read_line(&mut line)\n                    .map_err(mlua::Error::external)?;\n                if n == 0 {\n                    return Ok(mlua::Value::Nil);\n                }\n                let line = line.strip_suffix('\\n').unwrap_or(&line);\n                if line.trim().is_empty() {\n                    continue;\n                }\n                let value: serde_json::Value =\n                    serde_json::from_str(line).map_err(mlua::Error::external)?;\n                input::validate(&enums, &value, &elem_ty, \"inputs\")\n                    .map_err(mlua::Error::RuntimeError)?;\n                return input::to_lua(lua, &value);\n            }\n        })?;\n        lua.globals().set(emit_lua::NEXT_INPUT, next_input)?;\n    }\n    // mlua is embedded in this same process, so `io.lines()` in the emitted source reads the\n    // real stdin directly -- verified against a live pipe, and exactly what a `lines` program\n    // run for real should do. A fixture is different: cargo test runs many tests concurrently\n    // in one process, so redirecting the process's own fd 0 would race with all of them, and is\n    // not done. Instead the fixture is written to a file of its own and `io.lines` is pointed at\n    // it, which keeps Lua's own real line-splitting in the loop rather than reimplementing it in\n    // Rust and only testing that reimplementation.\n    let _fixture_dir;\n    if let Feed::Text(text) = feed {\n        let dir = tempfile::tempdir()?;\n        let path = dir.path().join(\"stdin.txt\");\n        std::fs::write(&path, text)?;\n        let path = path\n            .to_str()\n            .expect(\"a temp path is valid UTF-8\")\n            .to_string();\n        let io: mlua::Table = lua.globals().get(\"io\")?;\n        let real_lines: mlua::Function = io.get(\"lines\")?;\n        let fixture =\n            lua.create_function(move |_, ()| real_lines.call::<mlua::Value>(path.clone()))?;\n        io.set(\"lines\", fixture)?;\n        _fixture_dir = Some(dir);\n    }\n\n    // A live run has no test harness reading the result back, the same distinction\n    // `run_subprocess` makes for the OS-process backends: `print` writes straight to the real\n    // stdout and flushes per call instead of buffering into a string only handed back once the\n    // whole chunk finishes.\n    let live = matches!(feed, Feed::Live);\n    let captured = Rc::new(RefCell::new(String::new()));\n    let sink = Rc::clone(&captured);\n    let print = lua.create_function(move |_, s: String| {\n        if live {\n            let mut stdout = std::io::stdout();\n            writeln!(stdout, \"{s}\").map_err(mlua::Error::external)?;\n            stdout.flush().map_err(mlua::Error::external)?;\n        } else {\n            sink.borrow_mut().push_str(&s);\n            sink.borrow_mut().push('\\n');\n        }\n        Ok(())\n    })?;\n    lua.globals().set(\"print\", print)?;\n\n    lua.load(source).exec()?;\n\n    if live {\n        return Ok(String::new());\n    }\n    let out = captured.borrow().clone();\n    Ok(out)\n}\n\n/// Runs through `python3`. Like `node`, this is an interpreter that has to be on the machine\n/// rather than one vendored into the build.\nfn run_py(source: &str, feed: &Feed) -> Result<String> {\n    let dir = tempfile::tempdir()?;\n    let path = dir.path().join(\"program.py\");\n    std::fs::write(&path, source)?;\n\n    let mut cmd = std::process::Command::new(\"python3\");\n    cmd.arg(&path);\n    run_subprocess(cmd, \"python3\", feed)\n}\n\n/// Runs through `go run`, which compiles and executes in one step. Go has no interpreter, so\n/// this is the second backend that needs a real toolchain; like `node` and `cc`, a missing one\n/// is an error rather than a skipped backend.\nfn run_go(source: &str, feed: &Feed) -> Result<String> {\n    let dir = tempfile::tempdir()?;\n    let path = dir.path().join(\"main.go\");\n    std::fs::write(&path, source)?;\n\n    let mut cmd = std::process::Command::new(\"go\");\n    cmd.arg(\"run\").arg(&path);\n    run_subprocess(cmd, \"go\", feed)\n}\n\n/// Runs through `node`, which must be present. A missing toolchain is an error rather than a\n/// quietly skipped backend: a report that says two backends agreed when only one ran is worse\n/// than no report.\nfn run_node(source: &str, feed: &Feed) -> Result<String> {\n    let dir = tempfile::tempdir()?;\n    let path = dir.path().join(\"program.js\");\n    std::fs::write(&path, source)?;\n\n    let mut cmd = std::process::Command::new(\"node\");\n    cmd.arg(&path);\n    run_subprocess(cmd, \"node\", feed)\n}\n\nimpl std::error::Error for Error {}","lineStart":1,"lineEnd":634,"totalLines":634,"truncated":false}},"title":"src/lib.rs","time":{"start":1788120744076,"end":1788120744083}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_0544d3dd0001yT9kkilvuAWtel","sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","messageID":"msg_0544d320b001z3WRQ5KKGBpqhr"}}
