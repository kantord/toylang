{"type":"tool_use","timestamp":1788120926720,"sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","part":{"type":"tool","tool":"bash","callID":"chatcmpl-tool-b062c123717856fb","state":{"status":"completed","input":{"command":"rg -n \"float|Float|print\" plans/board.yaml | head -30"},"output":"19:#   soft:  SOFT blockers -- convenient order that saves effort or time (file-footprint\n172:- id: float-build\n173:  title: Implement Float (IEEE binary64 per ADR 0007) across the backends\n175:  needs: [q37-float-semantics]\n179:  title: Build the initial benchmark suite -- 8 non-float CLBG tasks, hyperfine harness per benchmark-plan.md, framed as a general cross-language competitiveness claim (gh:147 ruling); n-body/spectral-norm deferred to a second wave (gh:146 ruling)\n294:  title: Verify the Int/Float/equality sections against ADRs 0006/0007/0010 and the reference; move what's missing, delete (draft-split)\n","metadata":{"output":"19:#   soft:  SOFT blockers -- convenient order that saves effort or time (file-footprint\n172:- id: float-build\n173:  title: Implement Float (IEEE binary64 per ADR 0007) across the backends\n175:  needs: [q37-float-semantics]\n179:  title: Build the initial benchmark suite -- 8 non-float CLBG tasks, hyperfine harness per benchmark-plan.md, framed as a general cross-language competitiveness claim (gh:147 ruling); n-body/spectral-norm deferred to a second wave (gh:146 ruling)\n294:  title: Verify the Int/Float/equality sections against ADRs 0006/0007/0010 and the reference; move what's missing, delete (draft-split)\n","exit":0,"truncated":false},"title":"rg -n \"float|Float|print\" plans/board.yaml | head -30","time":{"start":1788120926717,"end":1788120926719}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Let me check the board.yaml for the float-build row, which might have more specific guidance on the printing decision. And let me look at how jq prints numbers and what tools each backend has. Let me also look at emit_jq.rs to understand the jq printing path.","format":"unknown","index":0}]}},"id":"prt_054500873001SB5ECEaJ74gd3e","sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","messageID":"msg_0544fe547001IvxWTTFEAaKz3v"}}
{"type":"tool_use","timestamp":1788120927069,"sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-973f12fadd994eed","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-149/src/emit_jq.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-149/src/emit_jq.rs</path>\n<type>file</type>\n<content>\n1: //! The jq backend.\n2: //!\n3: //! The other three targets are imperative and this one is not, so it is the only backend where\n4: //! the compiler has to say what it means in stream terms. That makes it a check on the\n5: //! relationship to jq rather than another way to run a program: everything the design diverges\n6: //! on has to be bridged here explicitly.\n7: //!\n8: //! Two mappings are worth naming. A dimension spec becomes `.[]` plus a reification, since\n9: //! keeping a dimension in a stream language means iterating and collecting. And `Opt` carries\n10: //! its enum's own runtime shape even here -- `{\"some\": v}` present, `\"none\"` absent -- tagged\n11: //! in memory like every backend now, with `null` appearing only when the printer flattens the\n12: //! tags away. One consequence is load-bearing: no in-memory value is ever JSON null, so jq's\n13: //! own null (an out-of-range `.[i]`) still unambiguously means \"was not there\".\n14: \n15: use crate::ast::BinOp;\n16: use crate::tir::{self, Builtin, Kind, LocalId, Program, Tir};\n17: use crate::ty::{self, Enums, Type};\n18: \n19: /// The binding stdin is read into. jq puts the input in `.`, which this backend needs for the\n20: /// subject, so it is bound away before the program starts.\n21: const INPUT: &str = \"$t_input\";\n22: const INPUTS: &str = \"$t_inputs\";\n23: \n24: /// jq has no integer type, so 32-bit wrapping is arithmetic on doubles. Addition and\n25: /// subtraction stay exact because the result never passes 2^33; multiplication does not, since\n26: /// the true product needs 62 bits, so it goes through 16-bit halves whose partial products each\n27: /// stay under 2^53. Verified against C and Math.imul, including -2147483648 * -1.\n28: const ARITH_HELPER: &str = r#\"def tl_i32: . as $r\n29:   | ((($r % 4294967296) + 4294967296) % 4294967296)\n30:   | if . >= 2147483648 then . - 4294967296 else . end;\n31: def tl_mul($a; $b):\n32:   ($a | tl_i32) as $x | ($b | tl_i32) as $y\n33:   | (if $x < 0 then $x + 4294967296 else $x end) as $ua\n34:   | (if $y < 0 then $y + 4294967296 else $y end) as $ub\n35:   | ($ua / 65536 | floor) as $ah | ($ua % 65536) as $al\n36:   | ($ub / 65536 | floor) as $bh | ($ub % 65536) as $bl\n37:   | (($al * $bl) + ((($ah * $bl) + ($al * $bh)) % 65536) * 65536) | tl_i32;\n38: def tl_div($a; $b):\n39:   if $b == 0 then error(\"toylang: divided by zero\")\n40:   else ($a / $b | trunc) | tl_i32 end;\n41: def tl_rem($a; $b):\n42:   if $b == 0 then error(\"toylang: divided by zero\") else ($a % $b) | tl_i32 end;\n43: \"#;\n44: \n45: /// Int64 arithmetic on doubles, exact only within +/-2^53 (kantord/toylang#83). That boundary\n46: /// is documented rather than papered over: 32-bit wrapping could be emulated exactly through\n47: /// 16-bit halves because every partial product fit a double, and no such split reassembles a\n48: /// 64-bit product or a mod-2^64 wrap from pieces a double can hold. So `+`, `-` and `*` are\n49: /// jq's own, `%` casts through C's 64-bit integers inside jq itself, and a program whose\n50: /// Int64 values stay within 2^53 -- every corpus case does -- agrees with the other six\n51: /// backends; one that leaves it diverges here, and docs/reference/types/int64.md says so.\n52: const ARITH64_HELPER: &str = r#\"def tl_div64($a; $b):\n53:   if $b == 0 then error(\"toylang: divided by zero\") else ($a / $b | trunc) end;\n54: def tl_rem64($a; $b):\n55:   if $b == 0 then error(\"toylang: divided by zero\") else ($a % $b) end;\n56: \"#;\n57: \n58: pub fn emit(program: &Program) -> Result<String, String> {\n59:     let enums = &program.enums;\n60:     let mut out = String::new();\n61:     let (arith, arith64) = uses_arith(program);\n62:     if arith {\n63:         out.push_str(ARITH_HELPER);\n64:     }\n65:     if arith64 {\n66:         out.push_str(ARITH64_HELPER);\n67:     }\n68: \n69:     out.push_str(&printers(program)?);\n70: \n71:     // jq resolves a `def` only against what is already defined, so definitions have to come out\n72:     // callee-first. The checker collects every signature before checking any body and therefore\n73:     // accepts a call to a function defined further down, which is a rule this target does not\n74:     // share. Lua needed forward declarations for the same reason; jq has no way to write one.\n75:     for f in ordered(program)? {\n76:         // A unary function's argument arrives as `.` and is bound before the body runs; a\n77:         // nullary one ignores `.` entirely, since it has nothing to bind.\n78:         out.push_str(&match &f.param {\n79:             Some(param) => format!(\n80:                 \"def {}: . as ${} | {};\\n\",\n81:                 user(&f.name),\n82:                 user(param),\n83:                 expr(enums, &f.body)\n84:             ),\n85:             None => format!(\"def {}: {};\\n\", user(&f.name), expr(enums, &f.body)),\n86:         });\n87:     }\n88: \n89:     if let Some(fusion) = tir::fusion(program) {\n90:         // jq's own `inputs` is already lazy; the eager path below only becomes eager by wrapping\n91:         // it in `[...]`. Skipping that wrapper and running the whole `map`/`select` chain as one\n92:         // filter over the `inputs` generator is what makes jq print each record as it arrives\n93:         // rather than after the last one, the same as running the equivalent `jq` program by\n94:         // hand would.\n95:         out.push_str(\"inputs\");\n96:         for stage in &fusion.stages {\n97:             match stage {\n98:                 tir::Stage::Map { param, body } => {\n99:                     out.push_str(&format!(\n100:                         \" | . as {} | {}\",\n101:                         local(*param),\n102:                         expr(enums, body)\n103:                     ));\n104:                 }\n105:                 tir::Stage::Select { param, pred } => {\n106:                     out.push_str(&format!(\n107:                         \" | . as {} | select({})\",\n108:                         local(*param),\n109:                         expr(enums, pred)\n110:                     ));\n111:                 }\n112:             }\n113:         }\n114:         let Kind::Builtin { arg, .. } = &program.body.kind else {\n115:             unreachable!(\"fusion only matches a jsonlines body\")\n116:         };\n117:         let elem = tir::runtime_elem(&arg.ty).expect(\"jsonlines's argument has an element\");\n118:         out.push_str(&format!(\" | ({} | tojson)\\n\", canonical(enums, elem, \".\")));\n119:         return Ok(out);\n120:     }\n121: \n122:     if program.input.is_some() {\n123:         out.push_str(&format!(\". as {INPUT} | \"));\n124:     }\n125:     // `-n` (added whenever the invocation has no value already in `.`, run_jq's job) is what\n126:     // makes `inputs` mean \"every value on stdin\" rather than \"every value after the first.\"\n127:     if program.inputs.is_some() {\n128:         out.push_str(&format!(\"[inputs] as {INPUTS} | \"));\n129:     }\n130:     // Records are rebuilt in the type's field order, because jq preserves insertion order and\n131:     // an object read from input carries whatever order the input had.\n132:     out.push_str(&canonical(\n133:         enums,\n134:         &program.body.ty,\n135:         &expr(enums, &program.body),\n136:     ));\n137:     out.push('\\n');\n138:     Ok(out)\n139: }\n140: \n141: /// Reconstruct a value with keys in the type's order, so the printed form matches the other\n142: /// backends rather than the input's key order.\n143: fn canonical(enums: &Enums, ty: &Type, value: &str) -> String {\n144:     match ty {\n145:         Type::Param(_) => unreachable!(\"params are substituted before emit\"),\n146:         // The checker refuses a program whose result contains a stream, since there is nothing to\n147:         // print: a stream has no value, only a promise that collect can redeem.\n148:         Type::Stream(_) => unreachable!(\"a stream cannot reach the printer\"),\n149:         Type::Char => unreachable!(\"Char cannot reach the printer, refused by the checker\"),\n150:         Type::Str | Type::Int | Type::Int64 | Type::Bool => value.to_string(),\n151:         Type::Vec(elem) => format!(\"[ {value}[] | {} ]\", canonical(enums, elem, \".\")),\n152:         Type::Enum { .. } if ty.as_opt().is_some() => {\n153:             let inner = ty.as_opt().expect(\"guarded\");\n154:             format!(\n155:                 \"({value} | if . == \\\"none\\\" then null else (.some | {}) end)\",\n156:                 canonical(enums, inner, \".\")\n157:             )\n158:         }\n159:         // A recursive enum is rebuilt by a filter of its own (`printers`), because expanding one\n160:         // here has no bottom: its payload leads back to the same type.\n161:         Type::Enum { .. } if ty::is_recursive(enums, ty) => {\n162:             format!(\"({value} | {})\", ty.show_fn())\n163:         }\n164:         Type::Enum { .. } => canonical_enum(enums, ty, value),\n165:         Type::Record(fields) => {\n166:             let parts: Vec<String> = fields\n167:                 .iter()\n168:                 .map(|(name, fty)| {\n169:                     format!(\n170:                         \"{}: {}\",\n171:                         jq_string(name),\n172:                         canonical(enums, fty, &field_of(\".\", name))\n173:                     )\n174:                 })\n175:                 .collect();\n176:             format!(\"({value} | {{{}}})\", parts.join(\", \"))\n177:         }\n178:     }\n179: }\n180: \n181: /// Every function name a `Kind::Call` inside `t` names, in the order encountered, duplicates and\n182: /// all -- `ordered` only ever asks whether a name is present, and a cycle's error message reads\n183: /// better walking a real call rather than a deduplicated set.\n184: fn callees(t: &Tir, out: &mut Vec<String>) {\n185:     match &t.kind {\n186:         Kind::Str(_)\n187:         | Kind::Int(_)\n188:         | Kind::Var(_)\n189:         | Kind::Local(_)\n190:         | Kind::Input\n191:         | Kind::Inputs\n192:         | Kind::Lines => {}\n193:         Kind::VecLit(items) => items.iter().for_each(|i| callees(i, out)),\n194:         Kind::RecordLit { fields } => {\n195:             fields.iter().for_each(|(_, v)| callees(v, out));\n196:         }\n197:         Kind::EnumLit { payload, .. } => {\n198:             if let Some(p) = payload {\n199:                 callees(p, out);\n200:             }\n201:         }\n202:         Kind::Call { func, arg } => {\n203:             out.push(func.clone());\n204:             if let Some(a) = arg {\n205:                 callees(a, out);\n206:             }\n207:         }\n208:         Kind::Concat(l, r)\n209:         | Kind::Compare { lhs: l, rhs: r, .. }\n210:         | Kind::Logic { lhs: l, rhs: r, .. } => {\n211:             callees(l, out);\n212:             callees(r, out);\n213:         }\n214:         Kind::Bind { value, body, .. } => {\n215:             callees(value, out);\n216:             callees(body, out);\n217:         }\n218:         Kind::Select { source, pred, .. } => {\n219:             callees(source, out);\n220:             callees(pred, out);\n221:         }\n222:         Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n223:             callees(source, out);\n224:             callees(body, out);\n225:         }\n226:         Kind::Builtin { arg, .. } => callees(arg, out),\n227:         Kind::Cond {\n228:             cond,\n229:             then,\n230:             otherwise,\n231:         } => {\n232:             callees(cond, out);\n233:             callees(then, out);\n234:             callees(otherwise, out);\n235:         }\n236:         Kind::Arith { lhs, rhs, .. } => {\n237:             callees(lhs, out);\n238:             callees(rhs, out);\n239:         }\n240:         Kind::Field { base, .. } | Kind::Unwrap { base } | Kind::Not(base) => callees(base, out),\n241:         Kind::Index { base, index, .. } => {\n242:             callees(base, out);\n243:             callees(index, out);\n244:         }\n245:         Kind::Match { subject, arms, .. } => {\n246:             callees(subject, out);\n247:             for a in arms {\n248:                 if let Some(g) = &a.guard {\n249:                     callees(g, out);\n250:                 }\n251:                 callees(&a.body, out);\n252:             }\n253:         }\n254:     }\n255: }\n256: \n257: /// Definitions in callee-before-caller order, or the cycle blocking one: jq's `def` sees only\n258: /// itself and whatever is already defined above it, with no forward declaration to bridge a\n259: /// real cycle between two or more named functions (kantord/toylang#79). Self-recursion never\n260: /// gets stuck here -- a function calling only itself is always immediately ready -- so reaching\n261: /// the stuck state below means the remaining functions have a genuine cycle among them.\n262: fn ordered(program: &Program) -> Result<Vec<&tir::Func>, String> {\n263:     topsort(\n264:         program.funcs.iter().collect(),\n265:         |f| f.name.clone(),\n266:         |f| {\n267:             let mut calls = Vec::new();\n268:             callees(&f.body, &mut calls);\n269:             calls\n270:         },\n271:         \"named functions\",\n272:     )\n273: }\n274: \n275: /// Callee-before-caller order over a list of named things, or the cycle blocking one. `name`\n276: /// yields each item's `def` name and `deps` the names it calls; `kind` names what `remaining`\n277: /// holds, for the refusal message alone. Both the named functions (`ordered`) and the\n278: /// recursive-enum printers (`printers`) go through here, because jq's `def` has the same reach on\n279: /// each: only itself and what is already defined above it, with no forward declaration\n280: /// (kantord/toylang#79, kantord/toylang#116).\n281: fn topsort<T>(\n282:     mut remaining: Vec<T>,\n283:     name: impl Fn(&T) -> String,\n284:     deps: impl Fn(&T) -> Vec<String>,\n285:     kind: &str,\n286: ) -> Result<Vec<T>, String> {\n287:     let mut done: Vec<T> = Vec::new();\n288:     let mut placed: Vec<String> = Vec::new();\n289:     while !remaining.is_empty() {\n290:         let ready: Vec<usize> = remaining\n291:             .iter()\n292:             .enumerate()\n293:             .filter(|(_, item)| {\n294:                 let n = name(item);\n295:                 deps(item).iter().all(|c| c == &n || placed.contains(c))\n296:             })\n297:             .map(|(i, _)| i)\n298:             .collect();\n299:         if ready.is_empty() {\n300:             return Err(cycle_message(&remaining, &name, &deps, kind));\n301:         }\n302:         for i in ready.into_iter().rev() {\n303:             let item = remaining.remove(i);\n304:             placed.push(name(&item));\n305:             done.push(item);\n306:         }\n307:     }\n308:     Ok(done)\n309: }\n310: \n311: /// A concrete cycle among `remaining`'s items, walked by following one unresolved call from\n312: /// each to the next: every item still in `remaining` has at least one such call (otherwise it\n313: /// would have been ready), so the walk is finite and must revisit a name. `kind` is `topsort`'s\n314: /// own, unchanged, naming `remaining`'s contents in the message.\n315: fn cycle_message<T>(\n316:     remaining: &[T],\n317:     name: &impl Fn(&T) -> String,\n318:     deps: &impl Fn(&T) -> Vec<String>,\n319:     kind: &str,\n320: ) -> String {\n321:     let names: Vec<String> = remaining.iter().map(name).collect();\n322:     let mut path: Vec<String> = Vec::new();\n323:     let mut current = name(&remaining[0]);\n324:     loop {\n325:         if let Some(at) = path.iter().position(|n| *n == current) {\n326:             let cycle = &path[at..];\n327:             let chain: Vec<String> = cycle.iter().map(|n| format!(\"`{n}`\")).collect();\n328:             return format!(\n329:                 \"jq cannot compile this: {} -> `{}` is a cycle between {kind}, and jq's `def` \\\n330:                  has no forward declaration -- only self-recursion and a call to something \\\n331:                  already defined above it are representable here\",\n332:                 chain.join(\" -> \"),\n333:                 cycle[0],\n334:             );\n335:         }\n336:         path.push(current.clone());\n337:         let item = remaining\n338:             .iter()\n339:             .find(|f| name(f) == current)\n340:             .expect(\"current is a name drawn from remaining\");\n341:         current = deps(item)\n342:             .into_iter()\n343:             .find(|c| c != &name(item) && names.contains(c))\n344:             .expect(\"a stuck item has at least one unresolved call within remaining\");\n345:     }\n346: }\n347: \n348: /// Whether the program does 32-bit arithmetic, 64-bit arithmetic, or both: the node's type\n349: /// says which width each `Arith` is, so the two helper blocks are included independently.\n350: fn uses_arith(program: &Program) -> (bool, bool) {\n351:     fn walk(t: &Tir, found: &mut (bool, bool)) {\n352:         match &t.kind {\n353:             Kind::Arith { lhs, rhs, .. } => {\n354:                 if t.ty == Type::Int64 {\n355:                     found.1 = true;\n356:                 } else {\n357:                     found.0 = true;\n358:                 }\n359:                 walk(lhs, found);\n360:                 walk(rhs, found);\n361:             }\n362:             Kind::Cond {\n363:                 cond,\n364:                 then,\n365:                 otherwise,\n366:             } => {\n367:                 walk(cond, found);\n368:                 walk(then, found);\n369:                 walk(otherwise, found);\n370:             }\n371:             Kind::Str(_)\n372:             | Kind::Int(_)\n373:             | Kind::Var(_)\n374:             | Kind::Local(_)\n375:             | Kind::Input\n376:             | Kind::Inputs\n377:             | Kind::Lines => {}\n378:             Kind::VecLit(items) => items.iter().for_each(|i| walk(i, found)),\n379:             Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| walk(v, found)),\n380:             Kind::EnumLit { payload, .. } => {\n381:                 if let Some(p) = payload {\n382:                     walk(p, found);\n383:                 }\n384:             }\n385:             Kind::Call { arg, .. } => {\n386:                 if let Some(a) = arg {\n387:                     walk(a, found);\n388:                 }\n389:             }\n390:             Kind::Builtin { arg, .. } => walk(arg, found),\n391:             Kind::Concat(l, r)\n392:             | Kind::Compare { lhs: l, rhs: r, .. }\n393:             | Kind::Logic { lhs: l, rhs: r, .. } => {\n394:                 walk(l, found);\n395:                 walk(r, found);\n396:             }\n397:             Kind::Bind { value, body, .. }\n398:             | Kind::Map {\n399:                 source: value,\n400:                 body,\n401:                 ..\n402:             }\n403:             | Kind::OptMap {\n404:                 source: value,\n405:                 body,\n406:                 ..\n407:             } => {\n408:                 walk(value, found);\n409:                 walk(body, found);\n410:             }\n411:             Kind::Select { source, pred, .. } => {\n412:                 walk(source, found);\n413:                 walk(pred, found);\n414:             }\n415:             Kind::Field { base, .. } | Kind::Unwrap { base } | Kind::Not(base) => walk(base, found),\n416:             Kind::Index { base, index, .. } => {\n417:                 walk(base, found);\n418:                 walk(index, found);\n419:             }\n420:             Kind::Match { subject, arms, .. } => {\n421:                 walk(subject, found);\n422:                 for a in arms {\n423:                     if let Some(g) = &a.guard {\n424:                         walk(g, found);\n425:                     }\n426:                     walk(&a.body, found);\n427:                 }\n428:             }\n429:         }\n430:     }\n431:     let mut found = (false, false);\n432:     program.funcs.iter().for_each(|f| walk(&f.body, &mut found));\n433:     walk(&program.body, &mut found);\n434:     found\n435: }\n436: \n437: fn user(name: &str) -> String {\n438:     format!(\"v_{name}\")\n439: }\n440: \n441: fn local(id: LocalId) -> String {\n442:     format!(\"$t_{id}\")\n443: }\n444: \n445: fn field_of(base: &str, name: &str) -> String {\n446:     format!(\"{base}[{}]\", jq_string(name))\n447: }\n448: \n449: /// Apply `inner` one dimension down, `depth` times. Keeping a dimension in a stream language is\n450: /// iterate-and-collect, which is why every level costs a `[ .[] | ... ]`.\n451: fn distribute(inner: &str, depth: usize) -> String {\n452:     if depth == 0 {\n453:         inner.to_string()\n454:     } else {\n455:         format!(\"[ .[] | {} ]\", distribute(inner, depth - 1))\n456:     }\n457: }\n458: \n459: fn expr(enums: &Enums, t: &Tir) -> String {\n460:     match &t.kind {\n461:         Kind::Str(s) => jq_string(s),\n462:         Kind::Int(n) => n.to_string(),\n463:         Kind::Var(name) => format!(\"${}\", user(name)),\n464:         Kind::Local(id) => local(*id),\n465:         Kind::Input => INPUT.to_string(),\n466:         Kind::Inputs => INPUTS.to_string(),\n467:         // The stream, materialized eagerly: `[ inputs ]` in raw-input mode is every line of\n468:         // stdin as an array of strings. `-n -R` on the invocation is what makes this mode\n469:         // available; see the checker rule against mixing `input` and `lines` in one program.\n470:         Kind::Lines => \"[ inputs ]\".to_string(),\n471:         // Each value is parenthesised: everything in jq is a filter, so an unbracketed `|`\n472:         // or `,` inside one would be read as part of the object rather than as its value.\n473:         Kind::RecordLit { fields } => {\n474:             let parts: Vec<String> = fields\n475:                 .iter()\n476:                 .map(|(name, value)| format!(\"{}: ({})\", jq_string(name), expr(enums, value)))\n477:                 .collect();\n478:             format!(\"{{{}}}\", parts.join(\", \"))\n479:         }\n480: \n481:         // The value is its JSON shape, which jq spells directly.\n482:         Kind::EnumLit { variant, payload } => match payload {\n483:             None => jq_string(variant),\n484:             Some(p) => format!(\"{{{}: ({})}}\", jq_string(variant), expr(enums, p)),\n485:         },\n486: \n487:         Kind::VecLit(items) => {\n488:             let parts: Vec<String> = items.iter().map(|i| expr(enums, i)).collect();\n489:             format!(\"[{}]\", parts.join(\", \"))\n490:         }\n491:         // A nullary function ignores `.`, so its call is just its name, run against whatever\n492:         // is already flowing through the surrounding pipeline.\n493:         Kind::Call { func, arg } => match arg {\n494:             Some(arg) => format!(\"({} | {})\", expr(enums, arg), user(func)),\n495:             None => format!(\"({})\", user(func)),\n496:         },\n497:         // jq's own `+` already joins two arrays the way it joins two strings, so a Vec needs\n498:         // no different spelling here than Str does.\n499:         Kind::Concat(l, r) => format!(\"({} + {})\", expr(enums, l), expr(enums, r)),\n500:         Kind::Arith { op, lhs, rhs } => arith(&t.ty, *op, expr(enums, lhs), expr(enums, rhs)),\n501:         Kind::Cond {\n502:             cond,\n503:             then,\n504:             otherwise,\n505:         } => format!(\n506:             \"(if {} then {} else {} end)\",\n507:             expr(enums, cond),\n508:             expr(enums, then),\n509:             expr(enums, otherwise)\n510:         ),\n511:         Kind::Builtin { which, arg } => match which {\n512:             Builtin::IntToStr => format!(\"({} | tostring)\", expr(enums, arg)),\n513:             // jq has one number type at every width, so the bridge has nothing to do.\n514:             Builtin::IntToI64 => format!(\"({})\", expr(enums, arg)),\n515:             Builtin::Range => format!(\"[ range(0; {}) ]\", expr(enums, arg)),\n516:             // `explode` already decodes jq's UTF-8 string by codepoint, not by byte, so there\n517:             // is no decoding to get right here.\n518:             Builtin::Chars => format!(\"({} | explode)\", expr(enums, arg)),\n519:             // `canonical` reorders a record's keys but leaves the *value*, not text; `tojson`\n520:             // is what turns each element into the same compact JSON string `-c` would print for\n521:             // it, matching every other backend's per-element encoding.\n522:             Builtin::JsonLines => {\n523:                 let elem = tir::runtime_elem(&arg.ty).expect(\"checked to be a Vec or a stream\");\n524:                 format!(\n525:                     \"({} | [.[] | ({} | tojson)] | join(\\\"\\\\n\\\"))\",\n526:                     expr(enums, arg),\n527:                     canonical(enums, elem, \".\")\n528:                 )\n529:             }\n530:             // The source already materialized, so the exit has nothing left to do.\n531:             Builtin::Collect => expr(enums, arg),\n532:             Builtin::Length => format!(\"({} | length)\", expr(enums, arg)),\n533:             // jq's own `.[1:]` on an empty array is `[]`, not null; toylang's tail needs the\n534:             // tagged Opt shape instead, so both cases are spelled out rather than borrowed.\n535:             Builtin::Tail => {\n536:                 format!(\n537:                     \"({} | if length == 0 then \\\"none\\\" else {{some: .[1:]}} end)\",\n538:                     expr(enums, arg)\n539:                 )\n540:             }\n541:             // Not jq's own `add`, which is `null` on an empty list rather than `[]` -- a reduce\n542:             // starting from `[]` gives the right answer in both cases.\n543:             Builtin::Flatten => format!(\"({} | reduce .[] as $x ([]; . + $x))\", expr(enums, arg)),\n544:             // jq's own `sort`/`reverse` already are this, restricted the same way the checker\n545:             // restricts `sort` to Int, Int64, Str, and Char.\n546:             Builtin::Sort => format!(\"({} | sort)\", expr(enums, arg)),\n547:             Builtin::Reverse => format!(\"({} | reverse)\", expr(enums, arg)),\n548:             // The names come from the checked type, not the object value, so `arg` runs only to\n549:             // become the `.` a literal array then ignores -- the same discard the pipe already\n550:             // gives every other builtin here.\n551:             Builtin::Fields => {\n552:                 let Type::Record(fields) = &arg.ty else {\n553:                     unreachable!(\"checked to be a record\")\n554:                 };\n555:                 let names: Vec<String> = fields.iter().map(|(n, _)| jq_string(n)).collect();\n556:                 format!(\"({} | [{}])\", expr(enums, arg), names.join(\", \"))\n557:             }\n558:         },\n559:         Kind::Compare { op, lhs, rhs } => {\n560:             format!(\"({} {} {})\", expr(enums, lhs), jq_op(*op), expr(enums, rhs))\n561:         }\n562:         // jq spells them the same way toylang does, and short-circuits them the same way too.\n563:         Kind::Logic { op, lhs, rhs } => format!(\"({} {op} {})\", expr(enums, lhs), expr(enums, rhs)),\n564:         Kind::Not(base) => format!(\"({} | not)\", expr(enums, base)),\n565:         Kind::Bind {\n566:             local: id,\n567:             value,\n568:             body,\n569:         } => {\n570:             format!(\n571:                 \"({} as {} | {})\",\n572:                 expr(enums, value),\n573:                 local(*id),\n574:                 expr(enums, body)\n575:             )\n576:         }\n577:         // The one operator that is derived in jq and primitive here: `map(f)` is `[ .[] | f ]`\n578:         // there, and neither half of that exists in a language with no effect layer.\n579:         Kind::Map {\n580:             source,\n581:             param,\n582:             body,\n583:         } => format!(\n584:             \"[ {}[] | . as {} | {} ]\",\n585:             expr(enums, source),\n586:             local(*param),\n587:             expr(enums, body)\n588:         ),\n589:         Kind::Select {\n590:             source,\n591:             param,\n592:             pred,\n593:         } => format!(\n594:             \"[ {}[] | . as {} | select({}) ]\",\n595:             expr(enums, source),\n596:             local(*param),\n597:             expr(enums, pred)\n598:         ),\n599:         Kind::Field { base, name } => {\n600:             let depth = tir::vec_depth(&base.ty);\n601:             format!(\n602:                 \"({} | {})\",\n603:                 expr(enums, base),\n604:                 distribute(&field_of(\".\", name), depth)\n605:             )\n606:         }\n607:         Kind::Unwrap { base } => {\n608:             let check = format!(\n609:                 \"if . == \\\"none\\\" then error({}) else .some end\",\n610:                 jq_string(\"toylang: unwrapped a value that is not there\")\n611:             );\n612:             format!(\n613:                 \"({} | {})\",\n614:                 expr(enums, base),\n615:                 distribute(&check, tir::vec_depth(&base.ty))\n616:             )\n617:         }\n618:         // Opt's reorder pass (kantord/toylang#66): the same `== \"none\"`/`.some` shape the\n619:         // printer and Match already read, generalised to rebuild the object instead.\n620:         Kind::OptMap {\n621:             source,\n622:             param,\n623:             body,\n624:         } => format!(\n625:             \"({} | if . == \\\"none\\\" then \\\"none\\\" else (.some as {} | {{some: {}}}) end)\",\n626:             expr(enums, source),\n627:             local(*param),\n628:             expr(enums, body)\n629:         ),\n630:         // Out of range is null in jq, and no in-memory toylang value is ever null (the\n631:         // module comment above), so the null test is exactly the was-not-there test; what\n632:         // comes out is the tagged Opt either way.\n633:         Kind::Index {\n634:             base, index, depth, ..\n635:         } => {\n636:             let at = format!(\n637:                 \"(.[{}] as $e | if $e == null then \\\"none\\\" else {{some: $e}} end)\",\n638:                 expr(enums, index)\n639:             );\n640:             format!(\"({} | {})\", expr(enums, base), distribute(&at, *depth))\n641:         }\n642:         // Tests over the subject: equality for a unit variant, `type`-guarded `has` for a\n643:         // payload one, since `has` on a string is an error rather than false, and the guard's\n644:         // own Bool for a guard arm. A total chain's last arm is the `else`, the checker having\n645:         // proved nothing else can reach it; a partial chain tags every present arm and its\n646:         // `else` is the absent Opt.\n647:         Kind::Match {\n648:             subject,\n649:             arms,\n650:             partial,\n651:         } => {\n652:             let subj = expr(enums, subject);\n653:             let run = |arm: &tir::MatchArm| match arm.payload {\n654:                 Some(pid) => {\n655:                     let variant = arm\n656:                         .variant\n657:                         .as_ref()\n658:                         .expect(\"only a variant arm has a payload\");\n659:                     format!(\n660:                         \"({subj}[{}] as {} | {})\",\n661:                         jq_string(variant),\n662:                         local(pid),\n663:                         expr(enums, &arm.body)\n664:                     )\n665:                 }\n666:                 None => expr(enums, &arm.body),\n667:             };\n668:             let run = |arm: &tir::MatchArm| {\n669:                 if *partial {\n670:                     // A partial chain's yield is an Opt, so a present arm is tagged.\n671:                     format!(\"{{some: {}}}\", run(arm))\n672:                 } else {\n673:                     run(arm)\n674:                 }\n675:             };\n676:             if !*partial && arms.len() == 1 {\n677:                 return format!(\"({})\", run(&arms[0]));\n678:             }\n679:             let mut out = String::from(\"(\");\n680:             for (i, arm) in arms.iter().enumerate() {\n681:                 let test = match (&arm.variant, &arm.guard) {\n682:                     (Some(v), _) if arm.payload.is_some() => Some(format!(\n683:                         \"({subj} | type == \\\"object\\\" and has({}))\",\n684:                         jq_string(v)\n685:                     )),\n686:                     (Some(v), _) => Some(format!(\"{subj} == {}\", jq_string(v))),\n687:                     (None, Some(g)) => Some(expr(enums, g)),\n688:                     (None, None) => None,\n689:                 };\n690:                 match test {\n691:                     Some(test) if *partial || i + 1 < arms.len() => {\n692:                         let word = if i == 0 { \"if\" } else { \"elif\" };\n693:                         out.push_str(&format!(\"{word} {test} then {} \", run(arm)));\n694:                     }\n695:                     _ => out.push_str(&format!(\"else {} end\", run(arm))),\n696:                 }\n697:             }\n698:             if *partial {\n699:                 out.push_str(\"else \\\"none\\\" end\");\n700:             }\n701:             out.push(')');\n702:             out\n703:         }\n704:     }\n705: }\n706: \n707: /// One arithmetic expression at the width the node's type names. The 64-bit side stays in\n708: /// jq's doubles, exact within +/-2^53 and honestly not past it (the ARITH64_HELPER comment);\n709: /// nothing wraps there, since no double could carry the wrapped value back.\n710: fn arith(ty: &Type, op: BinOp, l: String, r: String) -> String {\n711:     if *ty == Type::Int64 {\n712:         match op {\n713:             BinOp::Div => format!(\"tl_div64({l}; {r})\"),\n714:             BinOp::Rem => format!(\"tl_rem64({l}; {r})\"),\n715:             BinOp::Mul => format!(\"({l} * {r})\"),\n716:             BinOp::Add => format!(\"({l} + {r})\"),\n717:             BinOp::Sub => format!(\"({l} - {r})\"),\n718:             other => unreachable!(\"{other} is not arithmetic\"),\n719:         }\n720:     } else {\n721:         match op {\n722:             BinOp::Div => format!(\"tl_div({l}; {r})\"),\n723:             BinOp::Rem => format!(\"tl_rem({l}; {r})\"),\n724:             BinOp::Mul => format!(\"tl_mul({l}; {r})\"),\n725:             BinOp::Add => format!(\"(({l} + {r}) | tl_i32)\"),\n726:             BinOp::Sub => format!(\"(({l} - {r}) | tl_i32)\"),\n727:             other => unreachable!(\"{other} is not arithmetic\"),\n728:         }\n729:     }\n730: }\n731: \n732: fn jq_op(op: BinOp) -> &'static str {\n733:     match op {\n734:         BinOp::Eq => \"==\",\n735:         BinOp::Ne => \"!=\",\n736:         BinOp::Lt => \"<\",\n737:         BinOp::Le => \"<=\",\n738:         BinOp::Gt => \">\",\n739:         BinOp::Ge => \">=\",\n740:         other => unreachable!(\"{other} is not a comparison\"),\n741:     }\n742: }\n743: \n744: /// One enum rebuilt in place. One type, two runtime shapes (ADR 0009): a unit variant is already\n745: /// canonical, being a bare string; a payload wrapper is rebuilt so the payload's own keys come\n746: /// out in the type's order, the same reason records are rebuilt.\n747: fn canonical_enum(enums: &Enums, ty: &Type, value: &str) -> String {\n748:     let variants = ty::variants(enums, ty);\n749:     let payloads: Vec<(&String, &Type)> = variants\n750:         .iter()\n751:         .filter_map(|(n, p)| p.as_ref().map(|p| (n, p)))\n752:         .collect();\n753:     if payloads.is_empty() {\n754:         return value.to_string();\n755:     }\n756:     let wrap = |vname: &String, pty: &Type| {\n757:         format!(\n758:             \"{{{}: {}}}\",\n759:             jq_string(vname),\n760:             canonical(enums, pty, &field_of(\".\", vname))\n761:         )\n762:     };\n763:     // The conditions cover everything but the last shape, which needs no test: the type\n764:     // says nothing else is left. A unit variant, if any exists, is the string shape.\n765:     let mut tests: Vec<String> = Vec::new();\n766:     if payloads.len() < variants.len() {\n767:         tests.push(\"if type == \\\"string\\\" then .\".to_string());\n768:     }\n769:     for (vname, pty) in &payloads[..payloads.len() - 1] {\n770:         let word = if tests.is_empty() { \"if\" } else { \"elif\" };\n771:         tests.push(format!(\n772:             \"{word} has({}) then {}\",\n773:             jq_string(vname),\n774:             wrap(vname, pty)\n775:         ));\n776:     }\n777:     let (last_name, last_ty) = payloads[payloads.len() - 1];\n778:     let last = wrap(last_name, last_ty);\n779:     if tests.is_empty() {\n780:         return format!(\"({value} | {last})\");\n781:     }\n782:     format!(\"({value} | {} else {last} end)\", tests.join(\" \"))\n783: }\n784: \n785: /// A named filter for every recursive enum the program prints, in callee-before-caller order.\n786: /// The call in `canonical` above is what a nested occurrence rebuilds through, so the recursion\n787: /// in the type becomes recursion in the emitted filter rather than in this compiler\n788: /// (kantord/toylang#94). jq's `def` has no forward declaration, so the same topsort `ordered`\n789: /// uses applies here: one printer can call another only when the callee is already defined above\n790: /// it. Two enums that reach each other through `Vec` typecheck legally, but their printers form a\n791: /// genuine cycle jq cannot take, so it is refused rather than emitting source that fails with\n792: /// jq's own raw error (kantord/toylang#116).\n793: fn printers(program: &Program) -> Result<String, String> {\n794:     let ordered = topsort(\n795:         tir::printed_recursive_enums(program),\n796:         |ty| ty.show_fn(),\n797:         |ty| printer_deps(&program.enums, ty),\n798:         \"recursive-enum printers\",\n799:     )?;\n800:     let mut out = String::new();\n801:     for ty in ordered {\n802:         out.push_str(&format!(\n803:             \"def {}: {};\\n\",\n804:             ty.show_fn(),\n805:             canonical_enum(&program.enums, &ty, \".\")\n806:         ));\n807:     }\n808:     Ok(out)\n809: }\n810: \n811: /// The `tl_show_*` names a printer for `ty` calls: every recursive enum nested inside it, `ty`\n812: /// itself excluded, since self-recursion is the one back-edge jq's `def` can express. `seen`\n813: /// stops a recursive type from being walked forever; the first time each enum is met it is\n814: /// recorded and its payloads descended, so every distinct reachable enum shows up exactly once.\n815: fn printer_deps(enums: &Enums, ty: &Type) -> Vec<String> {\n816:     fn collect(\n817:         enums: &Enums,\n818:         ty: &Type,\n819:         root: &Type,\n820:         seen: &mut Vec<Type>,\n821:         deps: &mut Vec<String>,\n822:     ) {\n823:         match ty {\n824:             Type::Vec(e) | Type::Stream(e) => collect(enums, e, root, seen, deps),\n825:             Type::Record(fields) => {\n826:                 for (_, f) in fields {\n827:                     collect(enums, f, root, seen, deps);\n828:                 }\n829:             }\n830:             Type::Enum { name, args, .. } => {\n831:                 if seen.contains(ty) {\n832:                     return;\n833:                 }\n834:                 seen.push(ty.clone());\n835:                 if ty != root && crate::ty::is_recursive(enums, ty) {\n836:                     deps.push(ty.show_fn());\n837:                 }\n838:                 for arg in args {\n839:                     collect(enums, arg, root, seen, deps);\n840:                 }\n841:                 for (_, payload) in ty::variants_of(enums, name, args) {\n842:                     if let Some(p) = payload {\n843:                         collect(enums, &p, root, seen, deps);\n844:                     }\n845:                 }\n846:             }\n847:             _ => {}\n848:         }\n849:     }\n850:     let mut deps = Vec::new();\n851:     collect(enums, ty, ty, &mut Vec::new(), &mut deps);\n852:     deps\n853: }\n854: \n855: fn jq_string(s: &str) -> String {\n856:     let mut out = String::with_capacity(s.len() + 2);\n857:     out.push('\"');\n858:     for c in s.chars() {\n859:         match c {\n860:             '\"' => out.push_str(\"\\\\\\\"\"),\n861:             '\\\\' => out.push_str(\"\\\\\\\\\"),\n862:             '\\n' => out.push_str(\"\\\\n\"),\n863:             '\\r' => out.push_str(\"\\\\r\"),\n864:             '\\t' => out.push_str(\"\\\\t\"),\n865:             c if (c as u32) < 0x20 || c == '\\u{7f}' => {\n866:                 out.push_str(&format!(\"\\\\u{:04x}\", c as u32));\n867:             }\n868:             c => out.push(c),\n869:         }\n870:     }\n871:     out.push('\"');\n872:     out\n873: }\n\n(End of file - total 873 lines)\n</content>","metadata":{"preview":"//! The jq backend.\n//!\n//! The other three targets are imperative and this one is not, so it is the only backend where\n//! the compiler has to say what it means in stream terms. That makes it a check on the\n//! relationship to jq rather than another way to run a program: everything the design diverges\n//! on has to be bridged here explicitly.\n//!\n//! Two mappings are worth naming. A dimension spec becomes `.[]` plus a reification, since\n//! keeping a dimension in a stream language means iterating and collecting. And `Opt` carries\n//! its enum's own runtime shape even here -- `{\"some\": v}` present, `\"none\"` absent -- tagged\n//! in memory like every backend now, with `null` appearing only when the printer flattens the\n//! tags away. One consequence is load-bearing: no in-memory value is ever JSON null, so jq's\n//! own null (an out-of-range `.[i]`) still unambiguously means \"was not there\".\n\nuse crate::ast::BinOp;\nuse crate::tir::{self, Builtin, Kind, LocalId, Program, Tir};\nuse crate::ty::{self, Enums, Type};\n\n/// The binding stdin is read into. jq puts the input in `.`, which this backend needs for the\n/// subject, so it is bound away before the program starts.","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-149/src/emit_jq.rs","text":"//! The jq backend.\n//!\n//! The other three targets are imperative and this one is not, so it is the only backend where\n//! the compiler has to say what it means in stream terms. That makes it a check on the\n//! relationship to jq rather than another way to run a program: everything the design diverges\n//! on has to be bridged here explicitly.\n//!\n//! Two mappings are worth naming. A dimension spec becomes `.[]` plus a reification, since\n//! keeping a dimension in a stream language means iterating and collecting. And `Opt` carries\n//! its enum's own runtime shape even here -- `{\"some\": v}` present, `\"none\"` absent -- tagged\n//! in memory like every backend now, with `null` appearing only when the printer flattens the\n//! tags away. One consequence is load-bearing: no in-memory value is ever JSON null, so jq's\n//! own null (an out-of-range `.[i]`) still unambiguously means \"was not there\".\n\nuse crate::ast::BinOp;\nuse crate::tir::{self, Builtin, Kind, LocalId, Program, Tir};\nuse crate::ty::{self, Enums, Type};\n\n/// The binding stdin is read into. jq puts the input in `.`, which this backend needs for the\n/// subject, so it is bound away before the program starts.\nconst INPUT: &str = \"$t_input\";\nconst INPUTS: &str = \"$t_inputs\";\n\n/// jq has no integer type, so 32-bit wrapping is arithmetic on doubles. Addition and\n/// subtraction stay exact because the result never passes 2^33; multiplication does not, since\n/// the true product needs 62 bits, so it goes through 16-bit halves whose partial products each\n/// stay under 2^53. Verified against C and Math.imul, including -2147483648 * -1.\nconst ARITH_HELPER: &str = r#\"def tl_i32: . as $r\n  | ((($r % 4294967296) + 4294967296) % 4294967296)\n  | if . >= 2147483648 then . - 4294967296 else . end;\ndef tl_mul($a; $b):\n  ($a | tl_i32) as $x | ($b | tl_i32) as $y\n  | (if $x < 0 then $x + 4294967296 else $x end) as $ua\n  | (if $y < 0 then $y + 4294967296 else $y end) as $ub\n  | ($ua / 65536 | floor) as $ah | ($ua % 65536) as $al\n  | ($ub / 65536 | floor) as $bh | ($ub % 65536) as $bl\n  | (($al * $bl) + ((($ah * $bl) + ($al * $bh)) % 65536) * 65536) | tl_i32;\ndef tl_div($a; $b):\n  if $b == 0 then error(\"toylang: divided by zero\")\n  else ($a / $b | trunc) | tl_i32 end;\ndef tl_rem($a; $b):\n  if $b == 0 then error(\"toylang: divided by zero\") else ($a % $b) | tl_i32 end;\n\"#;\n\n/// Int64 arithmetic on doubles, exact only within +/-2^53 (kantord/toylang#83). That boundary\n/// is documented rather than papered over: 32-bit wrapping could be emulated exactly through\n/// 16-bit halves because every partial product fit a double, and no such split reassembles a\n/// 64-bit product or a mod-2^64 wrap from pieces a double can hold. So `+`, `-` and `*` are\n/// jq's own, `%` casts through C's 64-bit integers inside jq itself, and a program whose\n/// Int64 values stay within 2^53 -- every corpus case does -- agrees with the other six\n/// backends; one that leaves it diverges here, and docs/reference/types/int64.md says so.\nconst ARITH64_HELPER: &str = r#\"def tl_div64($a; $b):\n  if $b == 0 then error(\"toylang: divided by zero\") else ($a / $b | trunc) end;\ndef tl_rem64($a; $b):\n  if $b == 0 then error(\"toylang: divided by zero\") else ($a % $b) end;\n\"#;\n\npub fn emit(program: &Program) -> Result<String, String> {\n    let enums = &program.enums;\n    let mut out = String::new();\n    let (arith, arith64) = uses_arith(program);\n    if arith {\n        out.push_str(ARITH_HELPER);\n    }\n    if arith64 {\n        out.push_str(ARITH64_HELPER);\n    }\n\n    out.push_str(&printers(program)?);\n\n    // jq resolves a `def` only against what is already defined, so definitions have to come out\n    // callee-first. The checker collects every signature before checking any body and therefore\n    // accepts a call to a function defined further down, which is a rule this target does not\n    // share. Lua needed forward declarations for the same reason; jq has no way to write one.\n    for f in ordered(program)? {\n        // A unary function's argument arrives as `.` and is bound before the body runs; a\n        // nullary one ignores `.` entirely, since it has nothing to bind.\n        out.push_str(&match &f.param {\n            Some(param) => format!(\n                \"def {}: . as ${} | {};\\n\",\n                user(&f.name),\n                user(param),\n                expr(enums, &f.body)\n            ),\n            None => format!(\"def {}: {};\\n\", user(&f.name), expr(enums, &f.body)),\n        });\n    }\n\n    if let Some(fusion) = tir::fusion(program) {\n        // jq's own `inputs` is already lazy; the eager path below only becomes eager by wrapping\n        // it in `[...]`. Skipping that wrapper and running the whole `map`/`select` chain as one\n        // filter over the `inputs` generator is what makes jq print each record as it arrives\n        // rather than after the last one, the same as running the equivalent `jq` program by\n        // hand would.\n        out.push_str(\"inputs\");\n        for stage in &fusion.stages {\n            match stage {\n                tir::Stage::Map { param, body } => {\n                    out.push_str(&format!(\n                        \" | . as {} | {}\",\n                        local(*param),\n                        expr(enums, body)\n                    ));\n                }\n                tir::Stage::Select { param, pred } => {\n                    out.push_str(&format!(\n                        \" | . as {} | select({})\",\n                        local(*param),\n                        expr(enums, pred)\n                    ));\n                }\n            }\n        }\n        let Kind::Builtin { arg, .. } = &program.body.kind else {\n            unreachable!(\"fusion only matches a jsonlines body\")\n        };\n        let elem = tir::runtime_elem(&arg.ty).expect(\"jsonlines's argument has an element\");\n        out.push_str(&format!(\" | ({} | tojson)\\n\", canonical(enums, elem, \".\")));\n        return Ok(out);\n    }\n\n    if program.input.is_some() {\n        out.push_str(&format!(\". as {INPUT} | \"));\n    }\n    // `-n` (added whenever the invocation has no value already in `.`, run_jq's job) is what\n    // makes `inputs` mean \"every value on stdin\" rather than \"every value after the first.\"\n    if program.inputs.is_some() {\n        out.push_str(&format!(\"[inputs] as {INPUTS} | \"));\n    }\n    // Records are rebuilt in the type's field order, because jq preserves insertion order and\n    // an object read from input carries whatever order the input had.\n    out.push_str(&canonical(\n        enums,\n        &program.body.ty,\n        &expr(enums, &program.body),\n    ));\n    out.push('\\n');\n    Ok(out)\n}\n\n/// Reconstruct a value with keys in the type's order, so the printed form matches the other\n/// backends rather than the input's key order.\nfn canonical(enums: &Enums, ty: &Type, value: &str) -> String {\n    match ty {\n        Type::Param(_) => unreachable!(\"params are substituted before emit\"),\n        // The checker refuses a program whose result contains a stream, since there is nothing to\n        // print: a stream has no value, only a promise that collect can redeem.\n        Type::Stream(_) => unreachable!(\"a stream cannot reach the printer\"),\n        Type::Char => unreachable!(\"Char cannot reach the printer, refused by the checker\"),\n        Type::Str | Type::Int | Type::Int64 | Type::Bool => value.to_string(),\n        Type::Vec(elem) => format!(\"[ {value}[] | {} ]\", canonical(enums, elem, \".\")),\n        Type::Enum { .. } if ty.as_opt().is_some() => {\n            let inner = ty.as_opt().expect(\"guarded\");\n            format!(\n                \"({value} | if . == \\\"none\\\" then null else (.some | {}) end)\",\n                canonical(enums, inner, \".\")\n            )\n        }\n        // A recursive enum is rebuilt by a filter of its own (`printers`), because expanding one\n        // here has no bottom: its payload leads back to the same type.\n        Type::Enum { .. } if ty::is_recursive(enums, ty) => {\n            format!(\"({value} | {})\", ty.show_fn())\n        }\n        Type::Enum { .. } => canonical_enum(enums, ty, value),\n        Type::Record(fields) => {\n            let parts: Vec<String> = fields\n                .iter()\n                .map(|(name, fty)| {\n                    format!(\n                        \"{}: {}\",\n                        jq_string(name),\n                        canonical(enums, fty, &field_of(\".\", name))\n                    )\n                })\n                .collect();\n            format!(\"({value} | {{{}}})\", parts.join(\", \"))\n        }\n    }\n}\n\n/// Every function name a `Kind::Call` inside `t` names, in the order encountered, duplicates and\n/// all -- `ordered` only ever asks whether a name is present, and a cycle's error message reads\n/// better walking a real call rather than a deduplicated set.\nfn callees(t: &Tir, out: &mut Vec<String>) {\n    match &t.kind {\n        Kind::Str(_)\n        | Kind::Int(_)\n        | Kind::Var(_)\n        | Kind::Local(_)\n        | Kind::Input\n        | Kind::Inputs\n        | Kind::Lines => {}\n        Kind::VecLit(items) => items.iter().for_each(|i| callees(i, out)),\n        Kind::RecordLit { fields } => {\n            fields.iter().for_each(|(_, v)| callees(v, out));\n        }\n        Kind::EnumLit { payload, .. } => {\n            if let Some(p) = payload {\n                callees(p, out);\n            }\n        }\n        Kind::Call { func, arg } => {\n            out.push(func.clone());\n            if let Some(a) = arg {\n                callees(a, out);\n            }\n        }\n        Kind::Concat(l, r)\n        | Kind::Compare { lhs: l, rhs: r, .. }\n        | Kind::Logic { lhs: l, rhs: r, .. } => {\n            callees(l, out);\n            callees(r, out);\n        }\n        Kind::Bind { value, body, .. } => {\n            callees(value, out);\n            callees(body, out);\n        }\n        Kind::Select { source, pred, .. } => {\n            callees(source, out);\n            callees(pred, out);\n        }\n        Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n            callees(source, out);\n            callees(body, out);\n        }\n        Kind::Builtin { arg, .. } => callees(arg, out),\n        Kind::Cond {\n            cond,\n            then,\n            otherwise,\n        } => {\n            callees(cond, out);\n            callees(then, out);\n            callees(otherwise, out);\n        }\n        Kind::Arith { lhs, rhs, .. } => {\n            callees(lhs, out);\n            callees(rhs, out);\n        }\n        Kind::Field { base, .. } | Kind::Unwrap { base } | Kind::Not(base) => callees(base, out),\n        Kind::Index { base, index, .. } => {\n            callees(base, out);\n            callees(index, out);\n        }\n        Kind::Match { subject, arms, .. } => {\n            callees(subject, out);\n            for a in arms {\n                if let Some(g) = &a.guard {\n                    callees(g, out);\n                }\n                callees(&a.body, out);\n            }\n        }\n    }\n}\n\n/// Definitions in callee-before-caller order, or the cycle blocking one: jq's `def` sees only\n/// itself and whatever is already defined above it, with no forward declaration to bridge a\n/// real cycle between two or more named functions (kantord/toylang#79). Self-recursion never\n/// gets stuck here -- a function calling only itself is always immediately ready -- so reaching\n/// the stuck state below means the remaining functions have a genuine cycle among them.\nfn ordered(program: &Program) -> Result<Vec<&tir::Func>, String> {\n    topsort(\n        program.funcs.iter().collect(),\n        |f| f.name.clone(),\n        |f| {\n            let mut calls = Vec::new();\n            callees(&f.body, &mut calls);\n            calls\n        },\n        \"named functions\",\n    )\n}\n\n/// Callee-before-caller order over a list of named things, or the cycle blocking one. `name`\n/// yields each item's `def` name and `deps` the names it calls; `kind` names what `remaining`\n/// holds, for the refusal message alone. Both the named functions (`ordered`) and the\n/// recursive-enum printers (`printers`) go through here, because jq's `def` has the same reach on\n/// each: only itself and what is already defined above it, with no forward declaration\n/// (kantord/toylang#79, kantord/toylang#116).\nfn topsort<T>(\n    mut remaining: Vec<T>,\n    name: impl Fn(&T) -> String,\n    deps: impl Fn(&T) -> Vec<String>,\n    kind: &str,\n) -> Result<Vec<T>, String> {\n    let mut done: Vec<T> = Vec::new();\n    let mut placed: Vec<String> = Vec::new();\n    while !remaining.is_empty() {\n        let ready: Vec<usize> = remaining\n            .iter()\n            .enumerate()\n            .filter(|(_, item)| {\n                let n = name(item);\n                deps(item).iter().all(|c| c == &n || placed.contains(c))\n            })\n            .map(|(i, _)| i)\n            .collect();\n        if ready.is_empty() {\n            return Err(cycle_message(&remaining, &name, &deps, kind));\n        }\n        for i in ready.into_iter().rev() {\n            let item = remaining.remove(i);\n            placed.push(name(&item));\n            done.push(item);\n        }\n    }\n    Ok(done)\n}\n\n/// A concrete cycle among `remaining`'s items, walked by following one unresolved call from\n/// each to the next: every item still in `remaining` has at least one such call (otherwise it\n/// would have been ready), so the walk is finite and must revisit a name. `kind` is `topsort`'s\n/// own, unchanged, naming `remaining`'s contents in the message.\nfn cycle_message<T>(\n    remaining: &[T],\n    name: &impl Fn(&T) -> String,\n    deps: &impl Fn(&T) -> Vec<String>,\n    kind: &str,\n) -> String {\n    let names: Vec<String> = remaining.iter().map(name).collect();\n    let mut path: Vec<String> = Vec::new();\n    let mut current = name(&remaining[0]);\n    loop {\n        if let Some(at) = path.iter().position(|n| *n == current) {\n            let cycle = &path[at..];\n            let chain: Vec<String> = cycle.iter().map(|n| format!(\"`{n}`\")).collect();\n            return format!(\n                \"jq cannot compile this: {} -> `{}` is a cycle between {kind}, and jq's `def` \\\n                 has no forward declaration -- only self-recursion and a call to something \\\n                 already defined above it are representable here\",\n                chain.join(\" -> \"),\n                cycle[0],\n            );\n        }\n        path.push(current.clone());\n        let item = remaining\n            .iter()\n            .find(|f| name(f) == current)\n            .expect(\"current is a name drawn from remaining\");\n        current = deps(item)\n            .into_iter()\n            .find(|c| c != &name(item) && names.contains(c))\n            .expect(\"a stuck item has at least one unresolved call within remaining\");\n    }\n}\n\n/// Whether the program does 32-bit arithmetic, 64-bit arithmetic, or both: the node's type\n/// says which width each `Arith` is, so the two helper blocks are included independently.\nfn uses_arith(program: &Program) -> (bool, bool) {\n    fn walk(t: &Tir, found: &mut (bool, bool)) {\n        match &t.kind {\n            Kind::Arith { lhs, rhs, .. } => {\n                if t.ty == Type::Int64 {\n                    found.1 = true;\n                } else {\n                    found.0 = true;\n                }\n                walk(lhs, found);\n                walk(rhs, found);\n            }\n            Kind::Cond {\n                cond,\n                then,\n                otherwise,\n            } => {\n                walk(cond, found);\n                walk(then, found);\n                walk(otherwise, found);\n            }\n            Kind::Str(_)\n            | Kind::Int(_)\n            | Kind::Var(_)\n            | Kind::Local(_)\n            | Kind::Input\n            | Kind::Inputs\n            | Kind::Lines => {}\n            Kind::VecLit(items) => items.iter().for_each(|i| walk(i, found)),\n            Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| walk(v, found)),\n            Kind::EnumLit { payload, .. } => {\n                if let Some(p) = payload {\n                    walk(p, found);\n                }\n            }\n            Kind::Call { arg, .. } => {\n                if let Some(a) = arg {\n                    walk(a, found);\n                }\n            }\n            Kind::Builtin { arg, .. } => walk(arg, found),\n            Kind::Concat(l, r)\n            | Kind::Compare { lhs: l, rhs: r, .. }\n            | Kind::Logic { lhs: l, rhs: r, .. } => {\n                walk(l, found);\n                walk(r, found);\n            }\n            Kind::Bind { value, body, .. }\n            | Kind::Map {\n                source: value,\n                body,\n                ..\n            }\n            | Kind::OptMap {\n                source: value,\n                body,\n                ..\n            } => {\n                walk(value, found);\n                walk(body, found);\n            }\n            Kind::Select { source, pred, .. } => {\n                walk(source, found);\n                walk(pred, found);\n            }\n            Kind::Field { base, .. } | Kind::Unwrap { base } | Kind::Not(base) => walk(base, found),\n            Kind::Index { base, index, .. } => {\n                walk(base, found);\n                walk(index, found);\n            }\n            Kind::Match { subject, arms, .. } => {\n                walk(subject, found);\n                for a in arms {\n                    if let Some(g) = &a.guard {\n                        walk(g, found);\n                    }\n                    walk(&a.body, found);\n                }\n            }\n        }\n    }\n    let mut found = (false, false);\n    program.funcs.iter().for_each(|f| walk(&f.body, &mut found));\n    walk(&program.body, &mut found);\n    found\n}\n\nfn user(name: &str) -> String {\n    format!(\"v_{name}\")\n}\n\nfn local(id: LocalId) -> String {\n    format!(\"$t_{id}\")\n}\n\nfn field_of(base: &str, name: &str) -> String {\n    format!(\"{base}[{}]\", jq_string(name))\n}\n\n/// Apply `inner` one dimension down, `depth` times. Keeping a dimension in a stream language is\n/// iterate-and-collect, which is why every level costs a `[ .[] | ... ]`.\nfn distribute(inner: &str, depth: usize) -> String {\n    if depth == 0 {\n        inner.to_string()\n    } else {\n        format!(\"[ .[] | {} ]\", distribute(inner, depth - 1))\n    }\n}\n\nfn expr(enums: &Enums, t: &Tir) -> String {\n    match &t.kind {\n        Kind::Str(s) => jq_string(s),\n        Kind::Int(n) => n.to_string(),\n        Kind::Var(name) => format!(\"${}\", user(name)),\n        Kind::Local(id) => local(*id),\n        Kind::Input => INPUT.to_string(),\n        Kind::Inputs => INPUTS.to_string(),\n        // The stream, materialized eagerly: `[ inputs ]` in raw-input mode is every line of\n        // stdin as an array of strings. `-n -R` on the invocation is what makes this mode\n        // available; see the checker rule against mixing `input` and `lines` in one program.\n        Kind::Lines => \"[ inputs ]\".to_string(),\n        // Each value is parenthesised: everything in jq is a filter, so an unbracketed `|`\n        // or `,` inside one would be read as part of the object rather than as its value.\n        Kind::RecordLit { fields } => {\n            let parts: Vec<String> = fields\n                .iter()\n                .map(|(name, value)| format!(\"{}: ({})\", jq_string(name), expr(enums, value)))\n                .collect();\n            format!(\"{{{}}}\", parts.join(\", \"))\n        }\n\n        // The value is its JSON shape, which jq spells directly.\n        Kind::EnumLit { variant, payload } => match payload {\n            None => jq_string(variant),\n            Some(p) => format!(\"{{{}: ({})}}\", jq_string(variant), expr(enums, p)),\n        },\n\n        Kind::VecLit(items) => {\n            let parts: Vec<String> = items.iter().map(|i| expr(enums, i)).collect();\n            format!(\"[{}]\", parts.join(\", \"))\n        }\n        // A nullary function ignores `.`, so its call is just its name, run against whatever\n        // is already flowing through the surrounding pipeline.\n        Kind::Call { func, arg } => match arg {\n            Some(arg) => format!(\"({} | {})\", expr(enums, arg), user(func)),\n            None => format!(\"({})\", user(func)),\n        },\n        // jq's own `+` already joins two arrays the way it joins two strings, so a Vec needs\n        // no different spelling here than Str does.\n        Kind::Concat(l, r) => format!(\"({} + {})\", expr(enums, l), expr(enums, r)),\n        Kind::Arith { op, lhs, rhs } => arith(&t.ty, *op, expr(enums, lhs), expr(enums, rhs)),\n        Kind::Cond {\n            cond,\n            then,\n            otherwise,\n        } => format!(\n            \"(if {} then {} else {} end)\",\n            expr(enums, cond),\n            expr(enums, then),\n            expr(enums, otherwise)\n        ),\n        Kind::Builtin { which, arg } => match which {\n            Builtin::IntToStr => format!(\"({} | tostring)\", expr(enums, arg)),\n            // jq has one number type at every width, so the bridge has nothing to do.\n            Builtin::IntToI64 => format!(\"({})\", expr(enums, arg)),\n            Builtin::Range => format!(\"[ range(0; {}) ]\", expr(enums, arg)),\n            // `explode` already decodes jq's UTF-8 string by codepoint, not by byte, so there\n            // is no decoding to get right here.\n            Builtin::Chars => format!(\"({} | explode)\", expr(enums, arg)),\n            // `canonical` reorders a record's keys but leaves the *value*, not text; `tojson`\n            // is what turns each element into the same compact JSON string `-c` would print for\n            // it, matching every other backend's per-element encoding.\n            Builtin::JsonLines => {\n                let elem = tir::runtime_elem(&arg.ty).expect(\"checked to be a Vec or a stream\");\n                format!(\n                    \"({} | [.[] | ({} | tojson)] | join(\\\"\\\\n\\\"))\",\n                    expr(enums, arg),\n                    canonical(enums, elem, \".\")\n                )\n            }\n            // The source already materialized, so the exit has nothing left to do.\n            Builtin::Collect => expr(enums, arg),\n            Builtin::Length => format!(\"({} | length)\", expr(enums, arg)),\n            // jq's own `.[1:]` on an empty array is `[]`, not null; toylang's tail needs the\n            // tagged Opt shape instead, so both cases are spelled out rather than borrowed.\n            Builtin::Tail => {\n                format!(\n                    \"({} | if length == 0 then \\\"none\\\" else {{some: .[1:]}} end)\",\n                    expr(enums, arg)\n                )\n            }\n            // Not jq's own `add`, which is `null` on an empty list rather than `[]` -- a reduce\n            // starting from `[]` gives the right answer in both cases.\n            Builtin::Flatten => format!(\"({} | reduce .[] as $x ([]; . + $x))\", expr(enums, arg)),\n            // jq's own `sort`/`reverse` already are this, restricted the same way the checker\n            // restricts `sort` to Int, Int64, Str, and Char.\n            Builtin::Sort => format!(\"({} | sort)\", expr(enums, arg)),\n            Builtin::Reverse => format!(\"({} | reverse)\", expr(enums, arg)),\n            // The names come from the checked type, not the object value, so `arg` runs only to\n            // become the `.` a literal array then ignores -- the same discard the pipe already\n            // gives every other builtin here.\n            Builtin::Fields => {\n                let Type::Record(fields) = &arg.ty else {\n                    unreachable!(\"checked to be a record\")\n                };\n                let names: Vec<String> = fields.iter().map(|(n, _)| jq_string(n)).collect();\n                format!(\"({} | [{}])\", expr(enums, arg), names.join(\", \"))\n            }\n        },\n        Kind::Compare { op, lhs, rhs } => {\n            format!(\"({} {} {})\", expr(enums, lhs), jq_op(*op), expr(enums, rhs))\n        }\n        // jq spells them the same way toylang does, and short-circuits them the same way too.\n        Kind::Logic { op, lhs, rhs } => format!(\"({} {op} {})\", expr(enums, lhs), expr(enums, rhs)),\n        Kind::Not(base) => format!(\"({} | not)\", expr(enums, base)),\n        Kind::Bind {\n            local: id,\n            value,\n            body,\n        } => {\n            format!(\n                \"({} as {} | {})\",\n                expr(enums, value),\n                local(*id),\n                expr(enums, body)\n            )\n        }\n        // The one operator that is derived in jq and primitive here: `map(f)` is `[ .[] | f ]`\n        // there, and neither half of that exists in a language with no effect layer.\n        Kind::Map {\n            source,\n            param,\n            body,\n        } => format!(\n            \"[ {}[] | . as {} | {} ]\",\n            expr(enums, source),\n            local(*param),\n            expr(enums, body)\n        ),\n        Kind::Select {\n            source,\n            param,\n            pred,\n        } => format!(\n            \"[ {}[] | . as {} | select({}) ]\",\n            expr(enums, source),\n            local(*param),\n            expr(enums, pred)\n        ),\n        Kind::Field { base, name } => {\n            let depth = tir::vec_depth(&base.ty);\n            format!(\n                \"({} | {})\",\n                expr(enums, base),\n                distribute(&field_of(\".\", name), depth)\n            )\n        }\n        Kind::Unwrap { base } => {\n            let check = format!(\n                \"if . == \\\"none\\\" then error({}) else .some end\",\n                jq_string(\"toylang: unwrapped a value that is not there\")\n            );\n            format!(\n                \"({} | {})\",\n                expr(enums, base),\n                distribute(&check, tir::vec_depth(&base.ty))\n            )\n        }\n        // Opt's reorder pass (kantord/toylang#66): the same `== \"none\"`/`.some` shape the\n        // printer and Match already read, generalised to rebuild the object instead.\n        Kind::OptMap {\n            source,\n            param,\n            body,\n        } => format!(\n            \"({} | if . == \\\"none\\\" then \\\"none\\\" else (.some as {} | {{some: {}}}) end)\",\n            expr(enums, source),\n            local(*param),\n            expr(enums, body)\n        ),\n        // Out of range is null in jq, and no in-memory toylang value is ever null (the\n        // module comment above), so the null test is exactly the was-not-there test; what\n        // comes out is the tagged Opt either way.\n        Kind::Index {\n            base, index, depth, ..\n        } => {\n            let at = format!(\n                \"(.[{}] as $e | if $e == null then \\\"none\\\" else {{some: $e}} end)\",\n                expr(enums, index)\n            );\n            format!(\"({} | {})\", expr(enums, base), distribute(&at, *depth))\n        }\n        // Tests over the subject: equality for a unit variant, `type`-guarded `has` for a\n        // payload one, since `has` on a string is an error rather than false, and the guard's\n        // own Bool for a guard arm. A total chain's last arm is the `else`, the checker having\n        // proved nothing else can reach it; a partial chain tags every present arm and its\n        // `else` is the absent Opt.\n        Kind::Match {\n            subject,\n            arms,\n            partial,\n        } => {\n            let subj = expr(enums, subject);\n            let run = |arm: &tir::MatchArm| match arm.payload {\n                Some(pid) => {\n                    let variant = arm\n                        .variant\n                        .as_ref()\n                        .expect(\"only a variant arm has a payload\");\n                    format!(\n                        \"({subj}[{}] as {} | {})\",\n                        jq_string(variant),\n                        local(pid),\n                        expr(enums, &arm.body)\n                    )\n                }\n                None => expr(enums, &arm.body),\n            };\n            let run = |arm: &tir::MatchArm| {\n                if *partial {\n                    // A partial chain's yield is an Opt, so a present arm is tagged.\n                    format!(\"{{some: {}}}\", run(arm))\n                } else {\n                    run(arm)\n                }\n            };\n            if !*partial && arms.len() == 1 {\n                return format!(\"({})\", run(&arms[0]));\n            }\n            let mut out = String::from(\"(\");\n            for (i, arm) in arms.iter().enumerate() {\n                let test = match (&arm.variant, &arm.guard) {\n                    (Some(v), _) if arm.payload.is_some() => Some(format!(\n                        \"({subj} | type == \\\"object\\\" and has({}))\",\n                        jq_string(v)\n                    )),\n                    (Some(v), _) => Some(format!(\"{subj} == {}\", jq_string(v))),\n                    (None, Some(g)) => Some(expr(enums, g)),\n                    (None, None) => None,\n                };\n                match test {\n                    Some(test) if *partial || i + 1 < arms.len() => {\n                        let word = if i == 0 { \"if\" } else { \"elif\" };\n                        out.push_str(&format!(\"{word} {test} then {} \", run(arm)));\n                    }\n                    _ => out.push_str(&format!(\"else {} end\", run(arm))),\n                }\n            }\n            if *partial {\n                out.push_str(\"else \\\"none\\\" end\");\n            }\n            out.push(')');\n            out\n        }\n    }\n}\n\n/// One arithmetic expression at the width the node's type names. The 64-bit side stays in\n/// jq's doubles, exact within +/-2^53 and honestly not past it (the ARITH64_HELPER comment);\n/// nothing wraps there, since no double could carry the wrapped value back.\nfn arith(ty: &Type, op: BinOp, l: String, r: String) -> String {\n    if *ty == Type::Int64 {\n        match op {\n            BinOp::Div => format!(\"tl_div64({l}; {r})\"),\n            BinOp::Rem => format!(\"tl_rem64({l}; {r})\"),\n            BinOp::Mul => format!(\"({l} * {r})\"),\n            BinOp::Add => format!(\"({l} + {r})\"),\n            BinOp::Sub => format!(\"({l} - {r})\"),\n            other => unreachable!(\"{other} is not arithmetic\"),\n        }\n    } else {\n        match op {\n            BinOp::Div => format!(\"tl_div({l}; {r})\"),\n            BinOp::Rem => format!(\"tl_rem({l}; {r})\"),\n            BinOp::Mul => format!(\"tl_mul({l}; {r})\"),\n            BinOp::Add => format!(\"(({l} + {r}) | tl_i32)\"),\n            BinOp::Sub => format!(\"(({l} - {r}) | tl_i32)\"),\n            other => unreachable!(\"{other} is not arithmetic\"),\n        }\n    }\n}\n\nfn jq_op(op: BinOp) -> &'static str {\n    match op {\n        BinOp::Eq => \"==\",\n        BinOp::Ne => \"!=\",\n        BinOp::Lt => \"<\",\n        BinOp::Le => \"<=\",\n        BinOp::Gt => \">\",\n        BinOp::Ge => \">=\",\n        other => unreachable!(\"{other} is not a comparison\"),\n    }\n}\n\n/// One enum rebuilt in place. One type, two runtime shapes (ADR 0009): a unit variant is already\n/// canonical, being a bare string; a payload wrapper is rebuilt so the payload's own keys come\n/// out in the type's order, the same reason records are rebuilt.\nfn canonical_enum(enums: &Enums, ty: &Type, value: &str) -> String {\n    let variants = ty::variants(enums, ty);\n    let payloads: Vec<(&String, &Type)> = variants\n        .iter()\n        .filter_map(|(n, p)| p.as_ref().map(|p| (n, p)))\n        .collect();\n    if payloads.is_empty() {\n        return value.to_string();\n    }\n    let wrap = |vname: &String, pty: &Type| {\n        format!(\n            \"{{{}: {}}}\",\n            jq_string(vname),\n            canonical(enums, pty, &field_of(\".\", vname))\n        )\n    };\n    // The conditions cover everything but the last shape, which needs no test: the type\n    // says nothing else is left. A unit variant, if any exists, is the string shape.\n    let mut tests: Vec<String> = Vec::new();\n    if payloads.len() < variants.len() {\n        tests.push(\"if type == \\\"string\\\" then .\".to_string());\n    }\n    for (vname, pty) in &payloads[..payloads.len() - 1] {\n        let word = if tests.is_empty() { \"if\" } else { \"elif\" };\n        tests.push(format!(\n            \"{word} has({}) then {}\",\n            jq_string(vname),\n            wrap(vname, pty)\n        ));\n    }\n    let (last_name, last_ty) = payloads[payloads.len() - 1];\n    let last = wrap(last_name, last_ty);\n    if tests.is_empty() {\n        return format!(\"({value} | {last})\");\n    }\n    format!(\"({value} | {} else {last} end)\", tests.join(\" \"))\n}\n\n/// A named filter for every recursive enum the program prints, in callee-before-caller order.\n/// The call in `canonical` above is what a nested occurrence rebuilds through, so the recursion\n/// in the type becomes recursion in the emitted filter rather than in this compiler\n/// (kantord/toylang#94). jq's `def` has no forward declaration, so the same topsort `ordered`\n/// uses applies here: one printer can call another only when the callee is already defined above\n/// it. Two enums that reach each other through `Vec` typecheck legally, but their printers form a\n/// genuine cycle jq cannot take, so it is refused rather than emitting source that fails with\n/// jq's own raw error (kantord/toylang#116).\nfn printers(program: &Program) -> Result<String, String> {\n    let ordered = topsort(\n        tir::printed_recursive_enums(program),\n        |ty| ty.show_fn(),\n        |ty| printer_deps(&program.enums, ty),\n        \"recursive-enum printers\",\n    )?;\n    let mut out = String::new();\n    for ty in ordered {\n        out.push_str(&format!(\n            \"def {}: {};\\n\",\n            ty.show_fn(),\n            canonical_enum(&program.enums, &ty, \".\")\n        ));\n    }\n    Ok(out)\n}\n\n/// The `tl_show_*` names a printer for `ty` calls: every recursive enum nested inside it, `ty`\n/// itself excluded, since self-recursion is the one back-edge jq's `def` can express. `seen`\n/// stops a recursive type from being walked forever; the first time each enum is met it is\n/// recorded and its payloads descended, so every distinct reachable enum shows up exactly once.\nfn printer_deps(enums: &Enums, ty: &Type) -> Vec<String> {\n    fn collect(\n        enums: &Enums,\n        ty: &Type,\n        root: &Type,\n        seen: &mut Vec<Type>,\n        deps: &mut Vec<String>,\n    ) {\n        match ty {\n            Type::Vec(e) | Type::Stream(e) => collect(enums, e, root, seen, deps),\n            Type::Record(fields) => {\n                for (_, f) in fields {\n                    collect(enums, f, root, seen, deps);\n                }\n            }\n            Type::Enum { name, args, .. } => {\n                if seen.contains(ty) {\n                    return;\n                }\n                seen.push(ty.clone());\n                if ty != root && crate::ty::is_recursive(enums, ty) {\n                    deps.push(ty.show_fn());\n                }\n                for arg in args {\n                    collect(enums, arg, root, seen, deps);\n                }\n                for (_, payload) in ty::variants_of(enums, name, args) {\n                    if let Some(p) = payload {\n                        collect(enums, &p, root, seen, deps);\n                    }\n                }\n            }\n            _ => {}\n        }\n    }\n    let mut deps = Vec::new();\n    collect(enums, ty, ty, &mut Vec::new(), &mut deps);\n    deps\n}\n\nfn jq_string(s: &str) -> String {\n    let mut out = String::with_capacity(s.len() + 2);\n    out.push('\"');\n    for c in s.chars() {\n        match c {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            c if (c as u32) < 0x20 || c == '\\u{7f}' => {\n                out.push_str(&format!(\"\\\\u{:04x}\", c as u32));\n            }\n            c => out.push(c),\n        }\n    }\n    out.push('\"');\n    out\n}","lineStart":1,"lineEnd":873,"totalLines":873,"truncated":false}},"title":"src/emit_jq.rs","time":{"start":1788120927052,"end":1788120927065}},"id":"prt_0545009f6001OpFORVuzIC2tss","sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","messageID":"msg_0544fe547001IvxWTTFEAaKz3v"}}
