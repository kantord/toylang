{"type":"tool_use","timestamp":1788120639785,"sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-b849c9d562d4559f","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-149/src/parse.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-149/src/parse.rs</path>\n<type>file</type>\n<content>\n1: use winnow::error::ParserError;\n2: use winnow::prelude::*;\n3: use winnow::stream::{LocatingSlice, Location, Stream};\n4: use winnow::token::take_while;\n5: \n6: use crate::ast::{\n7:     Alias, BinOp, Def, EnumDecl, Expr, FieldsPattern, File, LogicOp, MatchArm, Module, Param,\n8:     Pattern, Span, TypeExpr, Variant,\n9: };\n10: use crate::error::Error;\n11: use crate::ty;\n12: \n13: /// The stream this whole module parses over: a source string with byte-offset tracking built\n14: /// in, so every sub-parser gets `Span`s for free from `current_token_start` rather than threading\n15: /// position by hand.\n16: type Input<'i> = LocatingSlice<&'i str>;\n17: \n18: /// Lets every winnow combinator used below (`take_while`, and anything built on it) report\n19: /// failure as this crate's own `Error` directly -- there is no separate winnow error type to\n20: /// translate out of. `from_input` is winnow's fallback for a failure it synthesises itself\n21: /// rather than one this module constructs explicitly; nothing here is expected to hit it; the\n22: /// hand-written parsers below always build their own `Error` with a specific message instead.\n23: impl<'i> ParserError<Input<'i>> for Error {\n24:     type Inner = Error;\n25: \n26:     fn from_input(input: &Input<'i>) -> Error {\n27:         let at = input.current_token_start();\n28:         Error::new(Span::new(at, at), \"expected a token\".to_string())\n29:     }\n30: \n31:     fn into_inner(self) -> Result<Error, Error> {\n32:         Ok(self)\n33:     }\n34: }\n35: \n36: #[derive(Debug, Clone, PartialEq)]\n37: enum Tok {\n38:     Str(String),\n39:     Int(i64),\n40:     Ident(String),\n41:     Fn,\n42:     Pub,\n43:     Type,\n44:     Enum,\n45:     If,\n46:     Else,\n47:     Input,\n48:     Inputs,\n49:     Lines,\n50:     And,\n51:     Or,\n52:     Not,\n53:     Plus,\n54:     Minus,\n55:     Star,\n56:     Slash,\n57:     Percent,\n58:     Pipe,\n59:     Comma,\n60:     Dot,\n61:     Eq,\n62:     EqEq,\n63:     Ne,\n64:     Bang,\n65:     Lt,\n66:     Le,\n67:     Gt,\n68:     Ge,\n69:     LParen,\n70:     RParen,\n71:     LBracket,\n72:     RBracket,\n73:     LBrace,\n74:     RBrace,\n75:     Colon,\n76:     Arrow,\n77:     Eof,\n78: }\n79: \n80: impl std::fmt::Display for Tok {\n81:     fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n82:         let s = match self {\n83:             Tok::Str(_) => return write!(f, \"a string\"),\n84:             Tok::Int(n) => return write!(f, \"`{n}`\"),\n85:             Tok::Ident(name) => return write!(f, \"`{name}`\"),\n86:             Tok::Fn => \"`fn`\",\n87:             Tok::Pub => \"`pub`\",\n88:             Tok::Type => \"`type`\",\n89:             Tok::Enum => \"`enum`\",\n90:             Tok::If => \"`if`\",\n91:             Tok::Else => \"`else`\",\n92:             Tok::Input => \"`input`\",\n93:             Tok::Inputs => \"`inputs`\",\n94:             Tok::Lines => \"`lines`\",\n95:             Tok::And => \"`and`\",\n96:             Tok::Or => \"`or`\",\n97:             Tok::Not => \"`not`\",\n98:             Tok::Plus => \"`+`\",\n99:             Tok::Minus => \"`-`\",\n100:             Tok::Star => \"`*`\",\n101:             Tok::Slash => \"`/`\",\n102:             Tok::Percent => \"`%`\",\n103:             Tok::Pipe => \"`|`\",\n104:             Tok::Comma => \"`,`\",\n105:             Tok::Dot => \"`.`\",\n106:             Tok::Eq => \"`=`\",\n107:             Tok::EqEq => \"`==`\",\n108:             Tok::Ne => \"`!=`\",\n109:             Tok::Bang => \"`!`\",\n110:             Tok::Lt => \"`<`\",\n111:             Tok::Le => \"`<=`\",\n112:             Tok::Gt => \"`>`\",\n113:             Tok::Ge => \"`>=`\",\n114:             Tok::LParen => \"`(`\",\n115:             Tok::RParen => \"`)`\",\n116:             Tok::LBracket => \"`[`\",\n117:             Tok::RBracket => \"`]`\",\n118:             Tok::LBrace => \"`{`\",\n119:             Tok::RBrace => \"`}`\",\n120:             Tok::Colon => \"`:`\",\n121:             Tok::Arrow => \"`->`\",\n122:             Tok::Eof => \"end of program\",\n123:         };\n124:         write!(f, \"{s}\")\n125:     }\n126: }\n127: \n128: /// Zero or more ASCII spaces/tabs/newlines, then a `#`-to-newline comment if one follows,\n129: /// repeated: a run of trivia can mix any number of either in any order.\n130: fn skip_trivia(input: &mut Input) {\n131:     loop {\n132:         take_while::<_, _, Error>(0.., |c: char| c.is_ascii_whitespace())\n133:             .parse_next(input)\n134:             .expect(\"a lower bound of zero never fails\");\n135:         if input.peek_token() != Some('#') {\n136:             return;\n137:         }\n138:         input.next_token();\n139:         while !matches!(input.peek_token(), None | Some('\\n')) {\n140:             input.next_token();\n141:         }\n142:     }\n143: }\n144: \n145: /// Skips trivia, then reads exactly one token from the front of `input`. Called fresh for every\n146: /// `peek`/`peek2`/`advance` rather than once up front into a `Vec`, so a lexical error (a bad\n147: /// escape, an out-of-range integer) surfaces at the point parsing actually reaches it instead of\n148: /// always winning over a parse error earlier in the file the way a separate up-front pass would.\n149: fn read_tok<'i>(input: &mut Input<'i>) -> Result<(Tok, Span), Error> {\n150:     skip_trivia(input);\n151:     let start = input.current_token_start();\n152:     let Some(c) = input.peek_token() else {\n153:         return Ok((Tok::Eof, Span::new(start, start)));\n154:     };\n155: \n156:     let tok = match c {\n157:         '\"' => Tok::Str(read_string(input)?),\n158:         '0'..='9' => {\n159:             let digits = take_while::<_, _, Error>(1.., |c: char| c.is_ascii_digit())\n160:                 .parse_next(input)\n161:                 .expect(\"a digit was just confirmed to follow\");\n162:             let n = digits.parse::<i64>().map_err(|_| {\n163:                 Error::new(\n164:                     Span::new(start, input.current_token_start()),\n165:                     format!(\"integer `{digits}` is out of range\"),\n166:                 )\n167:             })?;\n168:             Tok::Int(n)\n169:         }\n170:         c if c.is_ascii_alphabetic() || c == '_' => {\n171:             let word =\n172:                 take_while::<_, _, Error>(1.., |c: char| c.is_ascii_alphanumeric() || c == '_')\n173:                     .parse_next(input)\n174:                     .expect(\"a letter or underscore was just confirmed to follow\");\n175:             match word {\n176:                 \"fn\" => Tok::Fn,\n177:                 \"pub\" => Tok::Pub,\n178:                 \"type\" => Tok::Type,\n179:                 \"enum\" => Tok::Enum,\n180:                 \"if\" => Tok::If,\n181:                 \"else\" => Tok::Else,\n182:                 \"input\" => Tok::Input,\n183:                 \"inputs\" => Tok::Inputs,\n184:                 \"lines\" => Tok::Lines,\n185:                 \"and\" => Tok::And,\n186:                 // Two operators sharing one spelling, told apart by position: the arm separator\n187:                 // at a chain's top level, Bool disjunction everywhere else. `Cursor::or_separates`\n188:                 // is which one is being read (kantord/toylang#96).\n189:                 \"or\" => Tok::Or,\n190:                 \"not\" => Tok::Not,\n191:                 name => Tok::Ident(name.to_string()),\n192:             }\n193:         }\n194:         // `-` is subtraction and negation now, so a digit after it is no longer a negative\n195:         // literal: `a -1` would otherwise not be `a - 1`.\n196:         '-' => {\n197:             input.next_token();\n198:             if input.peek_token() == Some('>') {\n199:                 input.next_token();\n200:                 Tok::Arrow\n201:             } else {\n202:                 Tok::Minus\n203:             }\n204:         }\n205:         '!' => {\n206:             input.next_token();\n207:             if input.peek_token() == Some('=') {\n208:                 input.next_token();\n209:                 Tok::Ne\n210:             } else {\n211:                 Tok::Bang\n212:             }\n213:         }\n214:         '=' | '<' | '>' => {\n215:             input.next_token();\n216:             if input.peek_token() == Some('=') {\n217:                 input.next_token();\n218:                 match c {\n219:                     '=' => Tok::EqEq,\n220:                     '<' => Tok::Le,\n221:                     _ => Tok::Ge,\n222:                 }\n223:             } else {\n224:                 match c {\n225:                     '=' => Tok::Eq,\n226:                     '<' => Tok::Lt,\n227:                     _ => Tok::Gt,\n228:                 }\n229:             }\n230:         }\n231:         '+' => single(input, Tok::Plus),\n232:         '*' => single(input, Tok::Star),\n233:         // `//` is not a token anymore: match arms compose with `or` now, so a second slash is\n234:         // just a `/` where no expression can start, which is the parse error migration needs.\n235:         '/' => single(input, Tok::Slash),\n236:         '%' => single(input, Tok::Percent),\n237:         '|' => single(input, Tok::Pipe),\n238:         ',' => single(input, Tok::Comma),\n239:         '.' => single(input, Tok::Dot),\n240:         '(' => single(input, Tok::LParen),\n241:         ')' => single(input, Tok::RParen),\n242:         '[' => single(input, Tok::LBracket),\n243:         ']' => single(input, Tok::RBracket),\n244:         '{' => single(input, Tok::LBrace),\n245:         '}' => single(input, Tok::RBrace),\n246:         ':' => single(input, Tok::Colon),\n247:         other => {\n248:             return Err(Error::new(\n249:                 Span::new(start, start + 1),\n250:                 format!(\"unexpected character `{other}`\"),\n251:             ));\n252:         }\n253:     };\n254:     Ok((tok, Span::new(start, input.current_token_start())))\n255: }\n256: \n257: fn single(input: &mut Input, tok: Tok) -> Tok {\n258:     input.next_token();\n259:     tok\n260: }\n261: \n262: /// Returns the unescaped contents of a string literal, having consumed through the closing\n263: /// quote. `input` is positioned on the opening `\"` on entry.\n264: fn read_string(input: &mut Input) -> Result<String, Error> {\n265:     let open = input.current_token_start();\n266:     input.next_token();\n267:     let mut text = String::new();\n268:     loop {\n269:         let pos = input.current_token_start();\n270:         match input.peek_token() {\n271:             None => return Err(Error::new(Span::new(open, pos), \"unterminated string\")),\n272:             Some('\"') => {\n273:                 input.next_token();\n274:                 return Ok(text);\n275:             }\n276:             // Escapes are JSON's set minus \\u, which waits for a real value model.\n277:             Some('\\\\') => {\n278:                 let backslash = pos;\n279:                 input.next_token();\n280:                 let Some(esc) = input.peek_token() else {\n281:                     return Err(Error::new(\n282:                         Span::new(backslash, backslash + 1),\n283:                         \"unterminated escape sequence\",\n284:                     ));\n285:                 };\n286:                 text.push(match esc {\n287:                     '\"' => '\"',\n288:                     '\\\\' => '\\\\',\n289:                     '/' => '/',\n290:                     'n' => '\\n',\n291:                     't' => '\\t',\n292:                     'r' => '\\r',\n293:                     other => {\n294:                         return Err(Error::new(\n295:                             Span::new(backslash, backslash + 2),\n296:                             format!(\"unknown escape sequence `\\\\{other}`\"),\n297:                         ));\n298:                     }\n299:                 });\n300:                 input.next_token();\n301:             }\n302:             Some(c) => {\n303:                 text.push(c);\n304:                 input.next_token();\n305:             }\n306:         }\n307:     }\n308: }\n309: \n310: /// Which node an infix token builds. `and` and `or` are `ast::LogicOp`, not `BinOp`, so the\n311: /// table has to name the kind as well as the binding power.\n312: enum Infix {\n313:     Bin(BinOp),\n314:     Logic(LogicOp),\n315: }\n316: \n317: /// Left and right binding power. Left below right makes the operator left-associative.\n318: ///\n319: /// `|` sits below comparison so that `a | select(. >= 2)` splits at the pipe, which is the\n320: /// ordering jq uses and the reason this table exists rather than a nest of functions.\n321: fn infix_power(tok: &Tok) -> Option<(Infix, u8, u8)> {\n322:     let (op, left, right) = match tok {\n323:         Tok::Or => (Infix::Logic(LogicOp::Or), OR_LEFT, OR_RIGHT),\n324:         Tok::And => (Infix::Logic(LogicOp::And), 6, 7),\n325:         Tok::EqEq => (Infix::Bin(BinOp::Eq), 8, 9),\n326:         Tok::Ne => (Infix::Bin(BinOp::Ne), 8, 9),\n327:         Tok::Lt => (Infix::Bin(BinOp::Lt), 8, 9),\n328:         Tok::Le => (Infix::Bin(BinOp::Le), 8, 9),\n329:         Tok::Gt => (Infix::Bin(BinOp::Gt), 8, 9),\n330:         Tok::Ge => (Infix::Bin(BinOp::Ge), 8, 9),\n331:         Tok::Plus => (Infix::Bin(BinOp::Add), 10, 11),\n332:         Tok::Minus => (Infix::Bin(BinOp::Sub), 10, 11),\n333:         Tok::Star => (Infix::Bin(BinOp::Mul), 12, 13),\n334:         Tok::Slash => (Infix::Bin(BinOp::Div), 12, 13),\n335:         Tok::Percent => (Infix::Bin(BinOp::Rem), 12, 13),\n336:         _ => return None,\n337:     };\n338:     Some((op, left, right))\n339: }\n340: \n341: const PIPE_LEFT: u8 = 1;\n342: const PIPE_RIGHT: u8 = 2;\n343: \n344: /// The conditional sits between `|` and the Bool connectives, so `a if c else b | f` groups as\n345: /// `(a if c else b) | f` and `x | a if c else b` groups as `x | (a if c else b)`. Python puts\n346: /// its ternary below `|` because there `|` is bitwise or; ours is the pipe, so the better\n347: /// grouping comes for free.\n348: const COND_POWER: u8 = 3;\n349: \n350: /// Bool `or`, the loosest operator a Bool expression is built from: `a == 1 or b == 2` is one\n351: /// disjunction of two comparisons. Its *other* reading, the match-arm separator, has no power\n352: /// at all -- it is not an operator there but the chain's own punctuation, and it binds looser\n353: /// than everything including the conditional, which is exactly why it cannot be one table entry\n354: /// with this (draft.md, the match-arms decision).\n355: const OR_LEFT: u8 = 4;\n356: const OR_RIGHT: u8 = 5;\n357: \n358: /// `not` sits directly below comparison, so `not a == b` negates the comparison rather than\n359: /// `a`, and above `and`, so `not a and b` negates only `a`. Python's ordering; the alternative,\n360: /// binding it as tight as unary `-`, makes every use of it against a comparison need parens.\n361: const NOT_POWER: u8 = 8;\n362: \n363: pub fn parse(src: &str) -> Result<File, Error> {\n364:     let mut p = Cursor {\n365:         input: LocatingSlice::new(src),\n366:         src,\n367:         declined_cross_line: None,\n368:         or_separates: false,\n369:     };\n370: \n371:     // Declarations in any order and any mix, since no kind can refer to another's position:\n372:     // aliases and enums are resolved before any signature is read.\n373:     let mut defs = Vec::new();\n374:     let mut aliases = Vec::new();\n375:     let mut enums = Vec::new();\n376:     loop {\n377:         let (tok, _) = p.peek()?;\n378:         match tok {\n379:             Tok::Pub => {\n380:                 p.advance()?;\n381:                 match p.peek()?.0 {\n382:                     Tok::Enum => enums.push(p.enum_decl(true)?),\n383:                     _ => defs.push(p.def(true)?),\n384:                 }\n385:             }\n386:             Tok::Fn => defs.push(p.def(false)?),\n387:             Tok::Type => aliases.push(p.alias()?),\n388:             Tok::Enum => enums.push(p.enum_decl(false)?),\n389:             _ => break,\n390:         }\n391:     }\n392: \n393:     let body = p.expr(0)?;\n394:     let (rest, rest_span) = p.peek()?;\n395:     if rest != Tok::Eof {\n396:         return Err(p.unexpected(rest_span, format!(\"expected end of program, found {rest}\")));\n397:     }\n398:     Ok(File {\n399:         aliases,\n400:         enums,\n401:         defs,\n402:         body,\n403:     })\n404: }\n405: \n406: /// A module is declarations only, with no trailing expression -- there is nothing here to run,\n407: /// only names for a program to import. `pub` marks which ones a program actually receives.\n408: pub fn parse_module(src: &str) -> Result<Module, Error> {\n409:     let mut p = Cursor {\n410:         input: LocatingSlice::new(src),\n411:         src,\n412:         declined_cross_line: None,\n413:         or_separates: false,\n414:     };\n415:     let mut defs = Vec::new();\n416:     let mut enums = Vec::new();\n417:     loop {\n418:         let (tok, span) = p.peek()?;\n419:         match tok {\n420:             Tok::Pub => {\n421:                 p.advance()?;\n422:                 match p.peek()?.0 {\n423:                     Tok::Enum => enums.push(p.enum_decl(true)?),\n424:                     _ => defs.push(p.def(true)?),\n425:                 }\n426:             }\n427:             Tok::Fn => defs.push(p.def(false)?),\n428:             Tok::Enum => enums.push(p.enum_decl(false)?),\n429:             Tok::Eof => break,\n430:             other => {\n431:                 return Err(Error::new(\n432:                     span,\n433:                     format!(\"expected `fn` or end of module, found {other}\"),\n434:                 ));\n435:             }\n436:         }\n437:     }\n438:     Ok(Module { defs, enums })\n439: }\n440: \n441: struct Cursor<'i> {\n442:     input: Input<'i>,\n443:     /// The full source, kept alongside the advancing `input` so the same-line rule can look at\n444:     /// the trivia between two tokens it already has spans for.\n445:     src: &'i str,\n446:     /// Where a call was declined because its argument started on a later line: the argument\n447:     /// token's start, and the callee's name. Declining is usually right -- a definition's body\n448:     /// and the program's body sit adjacent with nothing between them, and the line break is what\n449:     /// keeps one from swallowing the other -- but when the parse then fails at exactly the\n450:     /// declined token, the intended reading was probably the call, and the error can name the\n451:     /// parens spelling that works across lines.\n452:     declined_cross_line: Option<(usize, String)>,\n453:     /// Which of `or`'s two readings is in force here: the match-arm separator (true), or Bool\n454:     /// disjunction (false). True only inside an arm's body, where the separator has to win so\n455:     /// that `a -> b or c` is two arms; every fresh expression position below that -- a\n456:     /// parenthesized group, a call argument, an arm's own guard -- puts it back to false, since\n457:     /// nothing there is a chain's top level. This is the split kantord/toylang#96 set out to\n458:     /// prove clean, and the one place a token's meaning depends on where it is read.\n459:     or_separates: bool,\n460: }\n461: \n462: impl<'i> Cursor<'i> {\n463:     /// Reads the next token without consuming it. `Input` is `Copy` (a source `&str` plus an\n464:     /// offset), so looking ahead is just tokenizing a throwaway copy of the cursor.\n465:     fn peek(&self) -> Result<(Tok, Span), Error> {\n466:         let mut probe = self.input;\n467:         read_tok(&mut probe)\n468:     }\n469: \n470:     fn advance(&mut self) -> Result<(Tok, Span), Error> {\n471:         read_tok(&mut self.input)\n472:     }\n473: \n474:     fn eat(&mut self, want: Tok) -> Result<Span, Error> {\n475:         let (tok, span) = self.peek()?;\n476:         if tok != want {\n477:             return Err(self.unexpected(span, format!(\"expected {want}, found {tok}\")));\n478:         }\n479:         self.advance()?;\n480:         Ok(span)\n481:     }\n482: \n483:     /// An \"unexpected token\" error, extended with the parens spelling when the failing token is\n484:     /// one a call declined to take as a cross-line argument (see `declined_cross_line`): the\n485:     /// token had somewhere to go, and only the line break kept it from going there.\n486:     fn unexpected(&self, span: Span, msg: String) -> Error {\n487:         if let Some((at, callee)) = &self.declined_cross_line\n488:             && *at == span.start\n489:         {\n490:             return Error::new(\n491:                 span,\n492:                 format!(\n493:                     \"{msg}; an argument must start on the same line as its function -- \\\n494:                      write `{callee}(...)` to call across lines\"\n495:                 ),\n496:             );\n497:         }\n498:         Error::new(span, msg)\n499:     }\n500: \n501:     /// Whether nothing but spaces and tabs sits between two byte offsets. The same-line rule for\n502:     /// call arguments: an argument, bare or parenthesized, must start on the same line as its\n503:     /// function, which is what lets a definition's body end next to the program's body without\n504:     /// either reaching across the line break and swallowing the other.\n505:     fn same_line(&self, from: usize, to: usize) -> bool {\n506:         !self.src[from..to].contains('\\n')\n507:     }\n508: \n509:     /// The same-line rule applied at one call site: true when the argument starting at\n510:     /// `arg_span` is on `callee_span`'s line. A cross-line decline is recorded (see\n511:     /// `declined_cross_line`) so that if the parse then fails at that token, the error can say\n512:     /// why the call was not taken.\n513:     fn takes_argument(&mut self, callee: &str, callee_span: Span, arg_span: Span) -> bool {\n514:         if self.same_line(callee_span.end, arg_span.start) {\n515:             return true;\n516:         }\n517:         self.declined_cross_line = Some((arg_span.start, callee.to_string()));\n518:         false\n519:     }\n520: \n521:     /// Runs `f` with `or` reading as `separates` says, restoring the caller's reading after.\n522:     fn with_or<T>(\n523:         &mut self,\n524:         separates: bool,\n525:         f: impl FnOnce(&mut Self) -> Result<T, Error>,\n526:     ) -> Result<T, Error> {\n527:         let outer = std::mem::replace(&mut self.or_separates, separates);\n528:         let out = f(self);\n529:         self.or_separates = outer;\n530:         out\n531:     }\n532: \n533:     fn eat_ident(&mut self, what: &str) -> Result<(String, Span), Error> {\n534:         match self.advance()? {\n535:             (Tok::Ident(n), span) => Ok((n, span)),\n536:             (other, span) => Err(Error::new(span, format!(\"expected {what}, found {other}\"))),\n537:         }\n538:     }\n539: \n540:     /// `fn name(param: Type) -> Type = body` or `fn name() -> Type = body`.\n541:     ///\n542:     /// Both annotations are required by the grammar rather than by the checker, which is what\n543:     /// makes the message point at the missing annotation instead of at an inference failure.\n544:     fn def(&mut self, is_pub: bool) -> Result<Def, Error> {\n545:         let start = self.eat(Tok::Fn)?;\n546:         let (name, _) = self.eat_ident(\"a name\")?;\n547:         self.eat(Tok::LParen)?;\n548: \n549:         let (next, _) = self.peek()?;\n550:         let param = if next == Tok::RParen {\n551:             None\n552:         } else {\n553:             let (param_name, param_span) = self.eat_ident(\"a name\")?;\n554:             let (colon, _) = self.peek()?;\n555:             if colon != Tok::Colon {\n556:                 return Err(Error::new(\n557:                     param_span,\n558:                     format!(\"parameter `{param_name}` needs a type annotation\"),\n559:                 ));\n560:             }\n561:             self.advance()?;\n562:             let param_ty = self.type_expr()?;\n563:             Some(Param {\n564:                 span: param_span.to(param_ty.span()),\n565:                 name: param_name,\n566:                 ty: param_ty,\n567:             })\n568:         };\n569: \n570:         let close = self.eat(Tok::RParen)?;\n571:         let (arrow, _) = self.peek()?;\n572:         if arrow != Tok::Arrow {\n573:             return Err(Error::new(\n574:                 close,\n575:                 format!(\"function `{name}` needs a return type\"),\n576:             ));\n577:         }\n578:         self.advance()?;\n579:         let ret = self.type_expr()?;\n580: \n581:         self.eat(Tok::Eq)?;\n582:         let body = self.expr(0)?;\n583:         Ok(Def {\n584:             span: start.to(body.span()),\n585:             name,\n586:             param,\n587:             ret,\n588:             body,\n589:             is_pub,\n590:         })\n591:     }\n592: \n593:     /// `Str`, `Int`, `Bool`, `Vec<T>`, `Stream<T>`, or any declared name -- with\n594:     /// `<...>` arguments when the name is a generic enum's. The parser accepts arguments on\n595:     /// every name and lets resolution hold the arity, so `Pair` and `Str<Int>` fail with an\n596:     /// error that knows what `Pair` and `Str` are rather than a parse error that does not.\n597:     fn type_expr(&mut self) -> Result<TypeExpr, Error> {\n598:         let (tok, span) = self.advance()?;\n599:         if tok == Tok::LBrace {\n600:             return self.record_type(span);\n601:         }\n602:         let name = match tok {\n603:             Tok::Ident(n) => n,\n604:             other => return Err(Error::new(span, format!(\"expected a type, found {other}\"))),\n605:         };\n606:         if self.peek()?.0 != Tok::Lt {\n607:             return Ok(TypeExpr::Named {\n608:                 name,\n609:                 args: Vec::new(),\n610:                 span,\n611:             });\n612:         }\n613:         self.advance()?;\n614:         let mut args = Vec::new();\n615:         loop {\n616:             args.push(self.type_expr()?);\n617:             let (sep, _) = self.peek()?;\n618:             if sep != Tok::Comma {\n619:                 break;\n620:             }\n621:             self.advance()?;\n622:         }\n623:         let close = self.eat(Tok::Gt)?;\n624:         let span = span.to(close);\n625:         // The two built-in constructors keep their own nodes; their arity is the grammar's.\n626:         if ty::takes_type_arg(&name) {\n627:             if args.len() != 1 {\n628:                 return Err(Error::new(\n629:                     span,\n630:                     format!(\"`{name}` takes one type argument, found {}\", args.len()),\n631:                 ));\n632:             }\n633:             let elem = Box::new(args.remove(0));\n634:             return Ok(match name.as_str() {\n635:                 \"Vec\" => TypeExpr::Vec { elem, span },\n636:                 _ => TypeExpr::Stream { elem, span },\n637:             });\n638:         }\n639:         Ok(TypeExpr::Named { name, args, span })\n640:     }\n641: \n642:     /// A call's argument when it opens with `(` or `{`: a parenthesized expression, or a record\n643:     /// literal standing bare because `{` cannot start any other expression. The closing token\n644:     /// marks the argument's end unambiguously, which is what makes the parens form the\n645:     /// disambiguator wherever the bare form's own stopping rules would read a program\n646:     /// differently.\n647:     fn argument(&mut self) -> Result<(Expr, Span), Error> {\n648:         let (tok, span) = self.peek()?;\n649:         if tok == Tok::LBrace {\n650:             self.advance()?;\n651:             let lit = self.record_lit(span)?;\n652:             let lit_span = lit.span();\n653:             return Ok((lit, lit_span));\n654:         }\n655:         self.eat(Tok::LParen)?;\n656:         let inner = self.expr(0)?;\n657:         let close = self.eat(Tok::RParen)?;\n658:         Ok((inner, close))\n659:     }\n660: \n661:     /// `{name: expr, age: expr}`, the value form of the brace that `record_type` reads in type\n662:     /// position.\n663:     fn record_lit(&mut self, open: Span) -> Result<Expr, Error> {\n664:         let mut fields = Vec::new();\n665:         let (first, _) = self.peek()?;\n666:         if first != Tok::RBrace {\n667:             loop {\n668:                 let (name, name_span) = self.eat_ident(\"a field name\")?;\n669:                 self.eat(Tok::Colon)?;\n670:                 fields.push((name, name_span, self.expr(0)?));\n671:                 let (sep, _) = self.peek()?;\n672:                 if sep != Tok::Comma {\n673:                     break;\n674:                 }\n675:                 self.advance()?;\n676:             }\n677:         }\n678:         let close = self.eat(Tok::RBrace)?;\n679:         Ok(Expr::RecordLit {\n680:             fields,\n681:             span: open.to(close),\n682:         })\n683:     }\n684: \n685:     /// `enum Shape { point, circle{r: Int}, celsius(Int) }`, optionally with type\n686:     /// parameters: `enum Opt<T> { some(T), none }`.\n687:     ///\n688:     /// A variant is a name, optionally followed by its payload type. The payload rule is any\n689:     /// single type, spelled the way a call spells its argument: a record type directly in\n690:     /// braces, or any type in parens.\n691:     fn enum_decl(&mut self, is_pub: bool) -> Result<EnumDecl, Error> {\n692:         let start = self.eat(Tok::Enum)?;\n693:         let (name, _) = self.eat_ident(\"an enum name\")?;\n694:         let mut params = Vec::new();\n695:         if self.peek()?.0 == Tok::Lt {\n696:             self.advance()?;\n697:             loop {\n698:                 params.push(self.eat_ident(\"a type parameter\")?);\n699:                 let (sep, _) = self.peek()?;\n700:                 if sep != Tok::Comma {\n701:                     break;\n702:                 }\n703:                 self.advance()?;\n704:             }\n705:             self.eat(Tok::Gt)?;\n706:         }\n707:         self.eat(Tok::LBrace)?;\n708:         let mut variants = Vec::new();\n709:         let (first, _) = self.peek()?;\n710:         if first != Tok::RBrace {\n711:             loop {\n712:                 let (vname, vspan) = self.eat_ident(\"a variant name\")?;\n713:                 let payload = match self.peek()? {\n714:                     (Tok::LBrace, open) => {\n715:                         self.advance()?;\n716:                         Some(self.record_type(open)?)\n717:                     }\n718:                     (Tok::LParen, _) => {\n719:                         self.advance()?;\n720:                         let ty = self.type_expr()?;\n721:                         self.eat(Tok::RParen)?;\n722:                         Some(ty)\n723:                     }\n724:                     _ => None,\n725:                 };\n726:                 variants.push(Variant {\n727:                     name: vname,\n728:                     span: vspan,\n729:                     payload,\n730:                 });\n731:                 let (sep, _) = self.peek()?;\n732:                 if sep != Tok::Comma {\n733:                     break;\n734:                 }\n735:                 self.advance()?;\n736:             }\n737:         }\n738:         let close = self.eat(Tok::RBrace)?;\n739:         Ok(EnumDecl {\n740:             name,\n741:             params,\n742:             variants,\n743:             span: start.to(close),\n744:             is_pub,\n745:         })\n746:     }\n747: \n748:     /// `type Db = {users: Vec<User>}`\n749:     fn alias(&mut self) -> Result<Alias, Error> {\n750:         let start = self.eat(Tok::Type)?;\n751:         let (name, _) = self.eat_ident(\"a type name\")?;\n752:         self.eat(Tok::Eq)?;\n753:         let ty = self.type_expr()?;\n754:         let span = start.to(ty.span());\n755:         Ok(Alias { name, ty, span })\n756:     }\n757: \n758:     fn record_type(&mut self, open: Span) -> Result<TypeExpr, Error> {\n759:         let mut fields = Vec::new();\n760:         let (first, _) = self.peek()?;\n761:         if first != Tok::RBrace {\n762:             loop {\n763:                 let (fname, _) = self.eat_ident(\"a field name\")?;\n764:                 self.eat(Tok::Colon)?;\n765:                 fields.push((fname, self.type_expr()?));\n766:                 let (sep, _) = self.peek()?;\n767:                 if sep != Tok::Comma {\n768:                     break;\n769:                 }\n770:                 self.advance()?;\n771:             }\n772:         }\n773:         let close = self.eat(Tok::RBrace)?;\n774:         Ok(TypeExpr::Record {\n775:             fields,\n776:             span: open.to(close),\n777:         })\n778:     }\n779: \n780:     /// Whether the tokens ahead begin a match arm: `name ->`, `name{a, b} ->`, or `any() ->`.\n781:     /// The one place this has to look carefully is a brace: a record *pattern* holds bare names\n782:     /// (and `..`), so the first `:` proves the braces are a constructor's record literal\n783:     /// argument instead. A lexical error while probing is not an arm; the ordinary path will\n784:     /// surface it.\n785:     fn arm_starts_here(&self) -> bool {\n786:         let mut probe = self.input;\n787:         let mut next = || read_tok(&mut probe).map(|(t, _)| t);\n788:         let Ok(Tok::Ident(name)) = next() else {\n789:             return false;\n790:         };\n791:         match next() {\n792:             Ok(Tok::Arrow) => true,\n793:             Ok(Tok::LParen) if name == \"any\" => {\n794:                 matches!(next(), Ok(Tok::RParen)) && matches!(next(), Ok(Tok::Arrow))\n795:             }\n796:             Ok(Tok::LBrace) => {\n797:                 loop {\n798:                     match next() {\n799:                         Ok(Tok::Ident(_) | Tok::Comma | Tok::Dot) => continue,\n800:                         Ok(Tok::RBrace) => break,\n801:                         _ => return false,\n802:                     }\n803:                 }\n804:                 matches!(next(), Ok(Tok::Arrow))\n805:             }\n806:             _ => false,\n807:         }\n808:     }\n809: \n810:     /// `left -> body or left -> body or ...`, first match wins; `or` is the one arm composer.\n811:     /// A left side is a variant pattern (`circle{r}`), `any()`, or a Bool guard expression; the\n812:     /// chain's final element may instead be a bare expression, the default. The chain reads `.`\n813:     /// as its subject, so it usually sits to the right of a `|`; each body stops at `|` and\n814:     /// `or`, which is what lets the chain be one pipe stage.\n815:     ///\n816:     /// The two `or`s meet here and nowhere else. A body is read with the separator reading, so\n817:     /// it ends at the next `or`; an element's own left side is read with the disjunction one, so\n818:     /// `a -> 1 or b == 2 or c == 3 -> 4` is two arms whose second has a two-clause guard. What\n819:     /// makes that split decidable is that an element ending at a bare `or` could only ever have\n820:     /// been a bare default in a non-final position, which was already an error.\n821:     ///\n822:     /// `lead` is an expression `expr` had already read when the `->` after it revealed a chain;\n823:     /// the first element continues from it instead of parsing fresh.\n824:     fn match_expr(&mut self, lead: Option<Expr>) -> Result<Expr, Error> {\n825:         let mut arms = Vec::new();\n826:         let mut lead = lead;\n827:         loop {\n828:             let arm = match lead.take() {\n829:                 Some(e) => self.guard_or_default_arm(e)?,\n830:                 None if self.arm_starts_here() => {\n831:                     let pattern = self.pattern()?;\n832:                     self.eat(Tok::Arrow)?;\n833:                     let body = self.arm_body()?;\n834:                     let span = pattern.span().to(body.span());\n835:                     MatchArm {\n836:                         pattern,\n837:                         body,\n838:                         span,\n839:                     }\n840:                 }\n841:                 None => {\n842:                     let e = self.with_or(false, |p| p.operand(COND_POWER))?;\n843:                     self.guard_or_default_arm(e)?\n844:                 }\n845:             };\n846:             arms.push(arm);\n847:             let (sep, _) = self.peek()?;\n848:             if sep != Tok::Or {\n849:                 break;\n850:             }\n851:             self.advance()?;\n852:         }\n853:         let span = arms[0].span.to(arms[arms.len() - 1].span);\n854:         Ok(Expr::Match { arms, span })\n855:     }\n856: \n857:     /// An arm's right side: the one position where a bare `or` is the chain's separator rather\n858:     /// than disjunction, so a Bool `or` written here needs parens (draft.md, the match-arms\n859:     /// decision).\n860:     fn arm_body(&mut self) -> Result<Expr, Error> {\n861:         self.with_or(true, |p| p.expr(COND_POWER))\n862:     }\n863: \n864:     /// The element `left` opens: `left -> body` makes `left` a guard, and a bare `left` is the\n865:     /// default, desugared to a `Default` arm whose body is `left` itself.\n866:     fn guard_or_default_arm(&mut self, left: Expr) -> Result<MatchArm, Error> {\n867:         if self.peek()?.0 == Tok::Arrow {\n868:             self.advance()?;\n869:             let body = self.arm_body()?;\n870:             let span = left.span().to(body.span());\n871:             return Ok(MatchArm {\n872:                 pattern: Pattern::Guard(left),\n873:                 body,\n874:                 span,\n875:             });\n876:         }\n877:         let span = left.span();\n878:         Ok(MatchArm {\n879:             pattern: Pattern::Default { span },\n880:             body: left,\n881:             span,\n882:         })\n883:     }\n884: \n885:     fn pattern(&mut self) -> Result<Pattern, Error> {\n886:         let (name, span) = self.eat_ident(\"a pattern\")?;\n887:         let (next, brace_span) = self.peek()?;\n888:         if name == \"any\" && next == Tok::LParen {\n889:             self.advance()?;\n890:             let close = self.eat(Tok::RParen)?;\n891:             return Ok(Pattern::Default {\n892:                 span: span.to(close),\n893:             });\n894:         }\n895:         if next != Tok::LBrace {\n896:             return Ok(Pattern::Variant {\n897:                 name,\n898:                 span,\n899:                 fields: None,\n900:             });\n901:         }\n902:         self.advance()?;\n903:         let mut names = Vec::new();\n904:         let mut rest = false;\n905:         let (first, _) = self.peek()?;\n906:         if first != Tok::RBrace {\n907:             loop {\n908:                 // `..` is two Dot tokens, and it ends the list: naming a field after \"and the\n909:                 // rest\" would make the marker meaningless.\n910:                 if self.peek()?.0 == Tok::Dot {\n911:                     self.advance()?;\n912:                     self.eat(Tok::Dot)?;\n913:                     rest = true;\n914:                     break;\n915:                 }\n916:                 names.push(self.eat_ident(\"a field name\")?);\n917:                 let (sep, _) = self.peek()?;\n918:                 if sep != Tok::Comma {\n919:                     break;\n920:                 }\n921:                 self.advance()?;\n922:             }\n923:         }\n924:         let close = self.eat(Tok::RBrace)?;\n925:         let fields = FieldsPattern {\n926:             names,\n927:             rest,\n928:             span: brace_span.to(close),\n929:         };\n930:         Ok(Pattern::Variant {\n931:             name,\n932:             span: span.to(close),\n933:             fields: Some(fields),\n934:         })\n935:     }\n936: \n937:     /// Arm chains begin only where an expression begins fresh (a pipe stage, a delimited\n938:     /// position), and a fresh position is also where `or` goes back to reading as disjunction:\n939:     /// whatever chain the enclosing arm body belonged to, this expression is not part of it. An\n940:     /// arm body or a conditional branch enters at COND_POWER instead and leaves any `->` or\n941:     /// separator `or` it meets for the chain that owns it, rather than opening a nested chain\n942:     /// that would swallow the rest of the outer one.\n943:     fn expr(&mut self, min_power: u8) -> Result<Expr, Error> {\n944:         if min_power <= PIPE_RIGHT {\n945:             return self.with_or(false, |p| p.expr_at(min_power, true));\n946:         }\n947:         self.expr_at(min_power, false)\n948:     }\n949: \n950:     fn expr_at(&mut self, min_power: u8, fresh: bool) -> Result<Expr, Error> {\n951:         let mut lhs = if fresh && self.arm_starts_here() {\n952:             self.match_expr(None)?\n953:         } else {\n954:             let e = self.operand(min_power)?;\n955:             let (tok, _) = self.peek()?;\n956:             // No `Tok::Or` here: a fresh position reads `or` as disjunction, so `operand` has\n957:             // already taken any that were there, and an arm chain is revealed by the `->` that\n958:             // follows the whole disjunction (`a == 1 or b == 2 -> ...` is one guard).\n959:             if fresh && tok == Tok::Arrow {\n960:                 self.match_expr(Some(e))?\n961:             } else {\n962:                 e\n963:             }\n964:         };\n965: \n966:         // Right-associative, so `a if c else b if d else e` chains rightward without parens.\n967:         let (tok, _) = self.peek()?;\n968:         if tok == Tok::If && COND_POWER >= min_power {\n969:             self.advance()?;\n970:             // `else` closes the condition, so a bare `or` inside it can only be disjunction --\n971:             // even in an arm body, where the separator reading is otherwise in force.\n972:             let cond = self.with_or(false, |p| p.operand(COND_POWER + 1))?;\n973:             self.eat(Tok::Else)?;\n974:             let otherwise = self.expr(COND_POWER)?;\n975:             let span = lhs.span().to(otherwise.span());\n976:             lhs = Expr::Cond {\n977:                 then: Box::new(lhs),\n978:                 cond: Box::new(cond),\n979:                 otherwise: Box::new(otherwise),\n980:                 span,\n981:             };\n982:         }\n983: \n984:         loop {\n985:             let (tok, _) = self.peek()?;\n986:             if tok != Tok::Pipe || PIPE_LEFT < min_power {\n987:                 break;\n988:             }\n989:             self.advance()?;\n990:             let rhs = self.expr(PIPE_RIGHT)?;\n991:             let span = lhs.span().to(rhs.span());\n992:             lhs = Expr::Pipe {\n993:                 lhs: Box::new(lhs),\n994:                 rhs: Box::new(rhs),\n995:                 span,\n996:             };\n997:         }\n998: \n999:         Ok(lhs)\n1000:     }\n1001: \n1002:     fn operand(&mut self, min_power: u8) -> Result<Expr, Error> {\n1003:         let mut lhs = self.complement(min_power)?;\n1004: \n1005:         loop {\n1006:             let (tok, _) = self.peek()?;\n1007:             // Where `or` is the arm separator it is not an operator at all, so the table is not\n1008:             // even consulted: the chain the arm belongs to takes the token.\n1009:             if tok == Tok::Or && self.or_separates {\n1010:                 break;\n1011:             }\n1012:             let Some((op, left, right)) = infix_power(&tok) else {\n1013:                 break;\n1014:             };\n1015:             if left < min_power {\n1016:                 break;\n1017:             }\n1018:             self.advance()?;\n1019:             let rhs = self.operand(right)?;\n1020:             let span = lhs.span().to(rhs.span());\n1021:             lhs = match op {\n1022:                 Infix::Bin(op) => Expr::Binary {\n1023:                     op,\n1024:                     lhs: Box::new(lhs),\n1025:                     rhs: Box::new(rhs),\n1026:                     span,\n1027:                 },\n1028:                 Infix::Logic(op) => Expr::Logic {\n1029:                     op,\n1030:                     lhs: Box::new(lhs),\n1031:                     rhs: Box::new(rhs),\n1032:                     span,\n1033:                 },\n1034:             };\n1035:         }\n1036: \n1037:         Ok(lhs)\n1038:     }\n1039: \n1040:     /// `not`, which is prefix but not unary in `-`'s sense: it binds looser than every operator\n1041:     /// in the infix table above comparison, so it reads its own operand at its own power rather\n1042:     /// than taking whatever `unary` returns. A position that binds tighter than `not` (a\n1043:     /// comparison's right side, say) declines it, and parens are what reach in there.\n1044:     fn complement(&mut self, min_power: u8) -> Result<Expr, Error> {\n1045:         let (tok, span) = self.peek()?;\n1046:         if tok == Tok::Not && min_power <= NOT_POWER {\n1047:             self.advance()?;\n1048:             let base = self.operand(NOT_POWER)?;\n1049:             let full = span.to(base.span());\n1050:             return Ok(Expr::Not {\n1051:                 base: Box::new(base),\n1052:                 span: full,\n1053:             });\n1054:         }\n1055:         self.unary()\n1056:     }\n1057: \n1058:     /// Negation binds tighter than any infix operator and looser than any postfix one, so\n1059:     /// `-a.b` negates the field and `-a * b` negates only `a`.\n1060:     fn unary(&mut self) -> Result<Expr, Error> {\n1061:         let (tok, span) = self.peek()?;\n1062:         if tok == Tok::Minus {\n1063:             self.advance()?;\n1064:             let base = self.unary()?;\n1065:             let full = span.to(base.span());\n1066:             return Ok(Expr::Neg {\n1067:                 base: Box::new(base),\n1068:                 span: full,\n1069:             });\n1070:         }\n1071:         self.postfix()\n1072:     }\n1073: \n1074:     /// `[]` and `.name` bind tighter than any infix operator, so `a.b[] | c` projects `a.b`.\n1075:     fn postfix(&mut self) -> Result<Expr, Error> {\n1076:         let mut e = self.atom()?;\n1077:         loop {\n1078:             let (tok, _) = self.peek()?;\n1079:             match tok {\n1080:                 Tok::LBracket => {\n1081:                     self.advance()?;\n1082:                     let (next, _) = self.peek()?;\n1083:                     if next == Tok::RBracket {\n1084:                         let close = self.advance()?.1;\n1085:                         let span = e.span().to(close);\n1086:                         e = Expr::Project {\n1087:                             base: Box::new(e),\n1088:                             span,\n1089:                         };\n1090:                     } else {\n1091:                         let index = self.expr(0)?;\n1092:                         let close = self.eat(Tok::RBracket)?;\n1093:                         let span = e.span().to(close);\n1094:                         e = Expr::Index {\n1095:                             base: Box::new(e),\n1096:                             index: Box::new(index),\n1097:                             span,\n1098:                         };\n1099:                     }\n1100:                 }\n1101:                 Tok::Bang => {\n1102:                     let bang = self.advance()?.1;\n1103:                     let span = e.span().to(bang);\n1104:                     e = Expr::Unwrap {\n1105:                         base: Box::new(e),\n1106:                         span,\n1107:                     };\n1108:                 }\n1109:                 Tok::Dot => {\n1110:                     self.advance()?;\n1111:                     let (ft, fspan) = self.advance()?;\n1112:                     let Tok::Ident(name) = ft else {\n1113:                         return Err(Error::new(\n1114:                             fspan,\n1115:                             format!(\"expected a field name, found {ft}\"),\n1116:                         ));\n1117:                     };\n1118:                     let span = e.span().to(fspan);\n1119:                     e = Expr::Field {\n1120:                         base: Box::new(e),\n1121:                         name,\n1122:                         span,\n1123:                     };\n1124:                 }\n1125:                 _ => return Ok(e),\n1126:             }\n1127:         }\n1128:     }\n1129: \n1130:     /// What a name means once read: a qualified variant (`Shape.circle`), a call when an\n1131:     /// argument starts after it on the same line, or a plain variable reference.\n1132:     ///\n1133:     /// A name followed by an argument is a call; bare application is the default spelling and\n1134:     /// `f(x)` is `f` applied to the grouped atom `(x)`. The bare form asks two things of the\n1135:     /// call that the delimited forms do not: the callee must be lowercase (a capitalised bare\n1136:     /// call could never typecheck), and the argument's first token excludes `-` (already\n1137:     /// subtraction: `f -1` stays `f - 1`), `.` (projection binds tighter than bare application\n1138:     /// everywhere, so `p.b` is a field access even though `.b` alone could be an argument --\n1139:     /// issue #19), and `[` (indexing owns it for the same reason: `v[0]` indexes, so a Vec\n1140:     /// literal argument needs parens).\n1141:     fn ident_expr(&mut self, name: String, span: Span) -> Result<Expr, Error> {\n1142:         let (next, next_span) = self.peek()?;\n1143:         // `Shape.circle`: the casing rule makes uppercase-then-dot unambiguous, since a\n1144:         // capitalised name can never be a value for `.` to project a field out of.\n1145:         if next == Tok::Dot && name.chars().next().is_some_and(char::is_uppercase) {\n1146:             self.advance()?;\n1147:             let (variant, variant_span) = self.eat_ident(\"a variant name\")?;\n1148:             let (after, after_span) = self.peek()?;\n1149:             let (payload, end) = if (after == Tok::LParen || after == Tok::LBrace)\n1150:                 && self.takes_argument(&format!(\"{name}.{variant}\"), variant_span, after_span)\n1151:             {\n1152:                 let (arg, close) = self.argument()?;\n1153:                 (Some(Box::new(arg)), close)\n1154:             } else {\n1155:                 (None, variant_span)\n1156:             };\n1157:             return Ok(Expr::Variant {\n1158:                 enum_name: name,\n1159:                 enum_span: span,\n1160:                 variant,\n1161:                 variant_span,\n1162:                 payload,\n1163:                 span: span.to(end),\n1164:             });\n1165:         }\n1166:         let argument_starts = match next {\n1167:             Tok::LParen | Tok::LBrace => true,\n1168:             Tok::Str(_) | Tok::Int(_) | Tok::Input | Tok::Inputs | Tok::Lines | Tok::Ident(_) => {\n1169:                 bare_callee(&name)\n1170:             }\n1171:             _ => false,\n1172:         };\n1173:         if !argument_starts || !self.takes_argument(&name, span, next_span) {\n1174:             return Ok(Expr::Var { name, span });\n1175:         }\n1176:         // `name()` is a nullary call, the one place a call's argument is optional: the empty\n1177:         // parens are checked for before falling into the ordinary single-expression parse, so\n1178:         // every other argument form (parenthesized, record, or bare) still names exactly one.\n1179:         let (arg, close) = if next == Tok::LParen {\n1180:             self.advance()?;\n1181:             let (after, _) = self.peek()?;\n1182:             if after == Tok::RParen {\n1183:                 let close = self.advance()?.1;\n1184:                 (None, close)\n1185:             } else {\n1186:                 let inner = self.expr(0)?;\n1187:                 let close = self.eat(Tok::RParen)?;\n1188:                 (Some(inner), close)\n1189:             }\n1190:         } else if next == Tok::LBrace {\n1191:             let (lit, close) = self.argument()?;\n1192:             (Some(lit), close)\n1193:         } else {\n1194:             // A bare argument is a postfix chain, not an operand: an infix operator after it\n1195:             // belongs to the enclosing expression, so `f x + y` is `f(x) + y`. Chaining is\n1196:             // right-recursive through `atom` itself, making `f g x` read `f(g(x))` -- with no\n1197:             // first-class functions, the only reading that could ever typecheck.\n1198:             let arg = self.postfix()?;\n1199:             let end = arg.span();\n1200:             (Some(arg), end)\n1201:         };\n1202:         Ok(Expr::Call {\n1203:             func: name,\n1204:             func_span: span,\n1205:             arg: arg.map(Box::new),\n1206:             span: span.to(close),\n1207:         })\n1208:     }\n1209: \n1210:     fn atom(&mut self) -> Result<Expr, Error> {\n1211:         let (tok, span) = self.advance()?;\n1212:         match tok {\n1213:             Tok::Str(text) => Ok(Expr::Str { text, span }),\n1214:             Tok::Int(value) => Ok(Expr::Int { value, span }),\n1215:             Tok::Input => Ok(Expr::Input { span }),\n1216:             Tok::Inputs => Ok(Expr::Inputs { span }),\n1217:             Tok::Lines => Ok(Expr::Lines { span }),\n1218: \n1219:             // `.name` is field access on the subject, so the leading dot yields `.` and the\n1220:             // postfix loop above picks the field up.\n1221:             Tok::Dot => {\n1222:                 let (next, _) = self.peek()?;\n1223:                 if let Tok::Ident(name) = next {\n1224:                     let (_, fspan) = self.advance()?;\n1225:                     return Ok(Expr::Field {\n1226:                         base: Box::new(Expr::Subject { span }),\n1227:                         name,\n1228:                         span: span.to(fspan),\n1229:                     });\n1230:                 }\n1231:                 Ok(Expr::Subject { span })\n1232:             }\n1233: \n1234:             Tok::LBrace => self.record_lit(span),\n1235: \n1236:             Tok::LBracket => {\n1237:                 // `,` is a separator here, not an operator. It has no meaning outside a literal\n1238:                 // while everything stays in the value layer.\n1239:                 let mut items = Vec::new();\n1240:                 let (first, _) = self.peek()?;\n1241:                 if first != Tok::RBracket {\n1242:                     loop {\n1243:                         items.push(self.expr(0)?);\n1244:                         let (sep, _) = self.peek()?;\n1245:                         if sep != Tok::Comma {\n1246:                             break;\n1247:                         }\n1248:                         self.advance()?;\n1249:                     }\n1250:                 }\n1251:                 let close = self.eat(Tok::RBracket)?;\n1252:                 Ok(Expr::VecLit {\n1253:                     items,\n1254:                     span: span.to(close),\n1255:                 })\n1256:             }\n1257: \n1258:             Tok::Ident(name) => self.ident_expr(name, span),\n1259: \n1260:             Tok::LParen => {\n1261:                 let inner = self.expr(0)?;\n1262:                 self.eat(Tok::RParen)?;\n1263:                 Ok(inner)\n1264:             }\n1265: \n1266:             other => Err(Error::new(\n1267:                 span,\n1268:                 format!(\"expected an expression, found {other}\"),\n1269:             )),\n1270:         }\n1271:     }\n1272: }\n1273: \n1274: /// Whether `name` can take a bare (undelimited) argument. Only a lowercase name can: a\n1275: /// capitalised name is a type under the casing rule, so a capitalised bare call could never\n1276: /// typecheck. Constructors still apply with the delimited forms (`Circle{r: 1}`,\n1277: /// `Circle(...)`), which this does not gate.\n1278: fn bare_callee(name: &str) -> bool {\n1279:     !name.chars().next().is_some_and(char::is_uppercase)\n1280: }\n\n(End of file - total 1280 lines)\n</content>","metadata":{"preview":"use winnow::error::ParserError;\nuse winnow::prelude::*;\nuse winnow::stream::{LocatingSlice, Location, Stream};\nuse winnow::token::take_while;\n\nuse crate::ast::{\n    Alias, BinOp, Def, EnumDecl, Expr, FieldsPattern, File, LogicOp, MatchArm, Module, Param,\n    Pattern, Span, TypeExpr, Variant,\n};\nuse crate::error::Error;\nuse crate::ty;\n\n/// The stream this whole module parses over: a source string with byte-offset tracking built\n/// in, so every sub-parser gets `Span`s for free from `current_token_start` rather than threading\n/// position by hand.\ntype Input<'i> = LocatingSlice<&'i str>;\n\n/// Lets every winnow combinator used below (`take_while`, and anything built on it) report\n/// failure as this crate's own `Error` directly -- there is no separate winnow error type to\n/// translate out of. `from_input` is winnow's fallback for a failure it synthesises itself","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-149/src/parse.rs","text":"use winnow::error::ParserError;\nuse winnow::prelude::*;\nuse winnow::stream::{LocatingSlice, Location, Stream};\nuse winnow::token::take_while;\n\nuse crate::ast::{\n    Alias, BinOp, Def, EnumDecl, Expr, FieldsPattern, File, LogicOp, MatchArm, Module, Param,\n    Pattern, Span, TypeExpr, Variant,\n};\nuse crate::error::Error;\nuse crate::ty;\n\n/// The stream this whole module parses over: a source string with byte-offset tracking built\n/// in, so every sub-parser gets `Span`s for free from `current_token_start` rather than threading\n/// position by hand.\ntype Input<'i> = LocatingSlice<&'i str>;\n\n/// Lets every winnow combinator used below (`take_while`, and anything built on it) report\n/// failure as this crate's own `Error` directly -- there is no separate winnow error type to\n/// translate out of. `from_input` is winnow's fallback for a failure it synthesises itself\n/// rather than one this module constructs explicitly; nothing here is expected to hit it; the\n/// hand-written parsers below always build their own `Error` with a specific message instead.\nimpl<'i> ParserError<Input<'i>> for Error {\n    type Inner = Error;\n\n    fn from_input(input: &Input<'i>) -> Error {\n        let at = input.current_token_start();\n        Error::new(Span::new(at, at), \"expected a token\".to_string())\n    }\n\n    fn into_inner(self) -> Result<Error, Error> {\n        Ok(self)\n    }\n}\n\n#[derive(Debug, Clone, PartialEq)]\nenum Tok {\n    Str(String),\n    Int(i64),\n    Ident(String),\n    Fn,\n    Pub,\n    Type,\n    Enum,\n    If,\n    Else,\n    Input,\n    Inputs,\n    Lines,\n    And,\n    Or,\n    Not,\n    Plus,\n    Minus,\n    Star,\n    Slash,\n    Percent,\n    Pipe,\n    Comma,\n    Dot,\n    Eq,\n    EqEq,\n    Ne,\n    Bang,\n    Lt,\n    Le,\n    Gt,\n    Ge,\n    LParen,\n    RParen,\n    LBracket,\n    RBracket,\n    LBrace,\n    RBrace,\n    Colon,\n    Arrow,\n    Eof,\n}\n\nimpl std::fmt::Display for Tok {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        let s = match self {\n            Tok::Str(_) => return write!(f, \"a string\"),\n            Tok::Int(n) => return write!(f, \"`{n}`\"),\n            Tok::Ident(name) => return write!(f, \"`{name}`\"),\n            Tok::Fn => \"`fn`\",\n            Tok::Pub => \"`pub`\",\n            Tok::Type => \"`type`\",\n            Tok::Enum => \"`enum`\",\n            Tok::If => \"`if`\",\n            Tok::Else => \"`else`\",\n            Tok::Input => \"`input`\",\n            Tok::Inputs => \"`inputs`\",\n            Tok::Lines => \"`lines`\",\n            Tok::And => \"`and`\",\n            Tok::Or => \"`or`\",\n            Tok::Not => \"`not`\",\n            Tok::Plus => \"`+`\",\n            Tok::Minus => \"`-`\",\n            Tok::Star => \"`*`\",\n            Tok::Slash => \"`/`\",\n            Tok::Percent => \"`%`\",\n            Tok::Pipe => \"`|`\",\n            Tok::Comma => \"`,`\",\n            Tok::Dot => \"`.`\",\n            Tok::Eq => \"`=`\",\n            Tok::EqEq => \"`==`\",\n            Tok::Ne => \"`!=`\",\n            Tok::Bang => \"`!`\",\n            Tok::Lt => \"`<`\",\n            Tok::Le => \"`<=`\",\n            Tok::Gt => \"`>`\",\n            Tok::Ge => \"`>=`\",\n            Tok::LParen => \"`(`\",\n            Tok::RParen => \"`)`\",\n            Tok::LBracket => \"`[`\",\n            Tok::RBracket => \"`]`\",\n            Tok::LBrace => \"`{`\",\n            Tok::RBrace => \"`}`\",\n            Tok::Colon => \"`:`\",\n            Tok::Arrow => \"`->`\",\n            Tok::Eof => \"end of program\",\n        };\n        write!(f, \"{s}\")\n    }\n}\n\n/// Zero or more ASCII spaces/tabs/newlines, then a `#`-to-newline comment if one follows,\n/// repeated: a run of trivia can mix any number of either in any order.\nfn skip_trivia(input: &mut Input) {\n    loop {\n        take_while::<_, _, Error>(0.., |c: char| c.is_ascii_whitespace())\n            .parse_next(input)\n            .expect(\"a lower bound of zero never fails\");\n        if input.peek_token() != Some('#') {\n            return;\n        }\n        input.next_token();\n        while !matches!(input.peek_token(), None | Some('\\n')) {\n            input.next_token();\n        }\n    }\n}\n\n/// Skips trivia, then reads exactly one token from the front of `input`. Called fresh for every\n/// `peek`/`peek2`/`advance` rather than once up front into a `Vec`, so a lexical error (a bad\n/// escape, an out-of-range integer) surfaces at the point parsing actually reaches it instead of\n/// always winning over a parse error earlier in the file the way a separate up-front pass would.\nfn read_tok<'i>(input: &mut Input<'i>) -> Result<(Tok, Span), Error> {\n    skip_trivia(input);\n    let start = input.current_token_start();\n    let Some(c) = input.peek_token() else {\n        return Ok((Tok::Eof, Span::new(start, start)));\n    };\n\n    let tok = match c {\n        '\"' => Tok::Str(read_string(input)?),\n        '0'..='9' => {\n            let digits = take_while::<_, _, Error>(1.., |c: char| c.is_ascii_digit())\n                .parse_next(input)\n                .expect(\"a digit was just confirmed to follow\");\n            let n = digits.parse::<i64>().map_err(|_| {\n                Error::new(\n                    Span::new(start, input.current_token_start()),\n                    format!(\"integer `{digits}` is out of range\"),\n                )\n            })?;\n            Tok::Int(n)\n        }\n        c if c.is_ascii_alphabetic() || c == '_' => {\n            let word =\n                take_while::<_, _, Error>(1.., |c: char| c.is_ascii_alphanumeric() || c == '_')\n                    .parse_next(input)\n                    .expect(\"a letter or underscore was just confirmed to follow\");\n            match word {\n                \"fn\" => Tok::Fn,\n                \"pub\" => Tok::Pub,\n                \"type\" => Tok::Type,\n                \"enum\" => Tok::Enum,\n                \"if\" => Tok::If,\n                \"else\" => Tok::Else,\n                \"input\" => Tok::Input,\n                \"inputs\" => Tok::Inputs,\n                \"lines\" => Tok::Lines,\n                \"and\" => Tok::And,\n                // Two operators sharing one spelling, told apart by position: the arm separator\n                // at a chain's top level, Bool disjunction everywhere else. `Cursor::or_separates`\n                // is which one is being read (kantord/toylang#96).\n                \"or\" => Tok::Or,\n                \"not\" => Tok::Not,\n                name => Tok::Ident(name.to_string()),\n            }\n        }\n        // `-` is subtraction and negation now, so a digit after it is no longer a negative\n        // literal: `a -1` would otherwise not be `a - 1`.\n        '-' => {\n            input.next_token();\n            if input.peek_token() == Some('>') {\n                input.next_token();\n                Tok::Arrow\n            } else {\n                Tok::Minus\n            }\n        }\n        '!' => {\n            input.next_token();\n            if input.peek_token() == Some('=') {\n                input.next_token();\n                Tok::Ne\n            } else {\n                Tok::Bang\n            }\n        }\n        '=' | '<' | '>' => {\n            input.next_token();\n            if input.peek_token() == Some('=') {\n                input.next_token();\n                match c {\n                    '=' => Tok::EqEq,\n                    '<' => Tok::Le,\n                    _ => Tok::Ge,\n                }\n            } else {\n                match c {\n                    '=' => Tok::Eq,\n                    '<' => Tok::Lt,\n                    _ => Tok::Gt,\n                }\n            }\n        }\n        '+' => single(input, Tok::Plus),\n        '*' => single(input, Tok::Star),\n        // `//` is not a token anymore: match arms compose with `or` now, so a second slash is\n        // just a `/` where no expression can start, which is the parse error migration needs.\n        '/' => single(input, Tok::Slash),\n        '%' => single(input, Tok::Percent),\n        '|' => single(input, Tok::Pipe),\n        ',' => single(input, Tok::Comma),\n        '.' => single(input, Tok::Dot),\n        '(' => single(input, Tok::LParen),\n        ')' => single(input, Tok::RParen),\n        '[' => single(input, Tok::LBracket),\n        ']' => single(input, Tok::RBracket),\n        '{' => single(input, Tok::LBrace),\n        '}' => single(input, Tok::RBrace),\n        ':' => single(input, Tok::Colon),\n        other => {\n            return Err(Error::new(\n                Span::new(start, start + 1),\n                format!(\"unexpected character `{other}`\"),\n            ));\n        }\n    };\n    Ok((tok, Span::new(start, input.current_token_start())))\n}\n\nfn single(input: &mut Input, tok: Tok) -> Tok {\n    input.next_token();\n    tok\n}\n\n/// Returns the unescaped contents of a string literal, having consumed through the closing\n/// quote. `input` is positioned on the opening `\"` on entry.\nfn read_string(input: &mut Input) -> Result<String, Error> {\n    let open = input.current_token_start();\n    input.next_token();\n    let mut text = String::new();\n    loop {\n        let pos = input.current_token_start();\n        match input.peek_token() {\n            None => return Err(Error::new(Span::new(open, pos), \"unterminated string\")),\n            Some('\"') => {\n                input.next_token();\n                return Ok(text);\n            }\n            // Escapes are JSON's set minus \\u, which waits for a real value model.\n            Some('\\\\') => {\n                let backslash = pos;\n                input.next_token();\n                let Some(esc) = input.peek_token() else {\n                    return Err(Error::new(\n                        Span::new(backslash, backslash + 1),\n                        \"unterminated escape sequence\",\n                    ));\n                };\n                text.push(match esc {\n                    '\"' => '\"',\n                    '\\\\' => '\\\\',\n                    '/' => '/',\n                    'n' => '\\n',\n                    't' => '\\t',\n                    'r' => '\\r',\n                    other => {\n                        return Err(Error::new(\n                            Span::new(backslash, backslash + 2),\n                            format!(\"unknown escape sequence `\\\\{other}`\"),\n                        ));\n                    }\n                });\n                input.next_token();\n            }\n            Some(c) => {\n                text.push(c);\n                input.next_token();\n            }\n        }\n    }\n}\n\n/// Which node an infix token builds. `and` and `or` are `ast::LogicOp`, not `BinOp`, so the\n/// table has to name the kind as well as the binding power.\nenum Infix {\n    Bin(BinOp),\n    Logic(LogicOp),\n}\n\n/// Left and right binding power. Left below right makes the operator left-associative.\n///\n/// `|` sits below comparison so that `a | select(. >= 2)` splits at the pipe, which is the\n/// ordering jq uses and the reason this table exists rather than a nest of functions.\nfn infix_power(tok: &Tok) -> Option<(Infix, u8, u8)> {\n    let (op, left, right) = match tok {\n        Tok::Or => (Infix::Logic(LogicOp::Or), OR_LEFT, OR_RIGHT),\n        Tok::And => (Infix::Logic(LogicOp::And), 6, 7),\n        Tok::EqEq => (Infix::Bin(BinOp::Eq), 8, 9),\n        Tok::Ne => (Infix::Bin(BinOp::Ne), 8, 9),\n        Tok::Lt => (Infix::Bin(BinOp::Lt), 8, 9),\n        Tok::Le => (Infix::Bin(BinOp::Le), 8, 9),\n        Tok::Gt => (Infix::Bin(BinOp::Gt), 8, 9),\n        Tok::Ge => (Infix::Bin(BinOp::Ge), 8, 9),\n        Tok::Plus => (Infix::Bin(BinOp::Add), 10, 11),\n        Tok::Minus => (Infix::Bin(BinOp::Sub), 10, 11),\n        Tok::Star => (Infix::Bin(BinOp::Mul), 12, 13),\n        Tok::Slash => (Infix::Bin(BinOp::Div), 12, 13),\n        Tok::Percent => (Infix::Bin(BinOp::Rem), 12, 13),\n        _ => return None,\n    };\n    Some((op, left, right))\n}\n\nconst PIPE_LEFT: u8 = 1;\nconst PIPE_RIGHT: u8 = 2;\n\n/// The conditional sits between `|` and the Bool connectives, so `a if c else b | f` groups as\n/// `(a if c else b) | f` and `x | a if c else b` groups as `x | (a if c else b)`. Python puts\n/// its ternary below `|` because there `|` is bitwise or; ours is the pipe, so the better\n/// grouping comes for free.\nconst COND_POWER: u8 = 3;\n\n/// Bool `or`, the loosest operator a Bool expression is built from: `a == 1 or b == 2` is one\n/// disjunction of two comparisons. Its *other* reading, the match-arm separator, has no power\n/// at all -- it is not an operator there but the chain's own punctuation, and it binds looser\n/// than everything including the conditional, which is exactly why it cannot be one table entry\n/// with this (draft.md, the match-arms decision).\nconst OR_LEFT: u8 = 4;\nconst OR_RIGHT: u8 = 5;\n\n/// `not` sits directly below comparison, so `not a == b` negates the comparison rather than\n/// `a`, and above `and`, so `not a and b` negates only `a`. Python's ordering; the alternative,\n/// binding it as tight as unary `-`, makes every use of it against a comparison need parens.\nconst NOT_POWER: u8 = 8;\n\npub fn parse(src: &str) -> Result<File, Error> {\n    let mut p = Cursor {\n        input: LocatingSlice::new(src),\n        src,\n        declined_cross_line: None,\n        or_separates: false,\n    };\n\n    // Declarations in any order and any mix, since no kind can refer to another's position:\n    // aliases and enums are resolved before any signature is read.\n    let mut defs = Vec::new();\n    let mut aliases = Vec::new();\n    let mut enums = Vec::new();\n    loop {\n        let (tok, _) = p.peek()?;\n        match tok {\n            Tok::Pub => {\n                p.advance()?;\n                match p.peek()?.0 {\n                    Tok::Enum => enums.push(p.enum_decl(true)?),\n                    _ => defs.push(p.def(true)?),\n                }\n            }\n            Tok::Fn => defs.push(p.def(false)?),\n            Tok::Type => aliases.push(p.alias()?),\n            Tok::Enum => enums.push(p.enum_decl(false)?),\n            _ => break,\n        }\n    }\n\n    let body = p.expr(0)?;\n    let (rest, rest_span) = p.peek()?;\n    if rest != Tok::Eof {\n        return Err(p.unexpected(rest_span, format!(\"expected end of program, found {rest}\")));\n    }\n    Ok(File {\n        aliases,\n        enums,\n        defs,\n        body,\n    })\n}\n\n/// A module is declarations only, with no trailing expression -- there is nothing here to run,\n/// only names for a program to import. `pub` marks which ones a program actually receives.\npub fn parse_module(src: &str) -> Result<Module, Error> {\n    let mut p = Cursor {\n        input: LocatingSlice::new(src),\n        src,\n        declined_cross_line: None,\n        or_separates: false,\n    };\n    let mut defs = Vec::new();\n    let mut enums = Vec::new();\n    loop {\n        let (tok, span) = p.peek()?;\n        match tok {\n            Tok::Pub => {\n                p.advance()?;\n                match p.peek()?.0 {\n                    Tok::Enum => enums.push(p.enum_decl(true)?),\n                    _ => defs.push(p.def(true)?),\n                }\n            }\n            Tok::Fn => defs.push(p.def(false)?),\n            Tok::Enum => enums.push(p.enum_decl(false)?),\n            Tok::Eof => break,\n            other => {\n                return Err(Error::new(\n                    span,\n                    format!(\"expected `fn` or end of module, found {other}\"),\n                ));\n            }\n        }\n    }\n    Ok(Module { defs, enums })\n}\n\nstruct Cursor<'i> {\n    input: Input<'i>,\n    /// The full source, kept alongside the advancing `input` so the same-line rule can look at\n    /// the trivia between two tokens it already has spans for.\n    src: &'i str,\n    /// Where a call was declined because its argument started on a later line: the argument\n    /// token's start, and the callee's name. Declining is usually right -- a definition's body\n    /// and the program's body sit adjacent with nothing between them, and the line break is what\n    /// keeps one from swallowing the other -- but when the parse then fails at exactly the\n    /// declined token, the intended reading was probably the call, and the error can name the\n    /// parens spelling that works across lines.\n    declined_cross_line: Option<(usize, String)>,\n    /// Which of `or`'s two readings is in force here: the match-arm separator (true), or Bool\n    /// disjunction (false). True only inside an arm's body, where the separator has to win so\n    /// that `a -> b or c` is two arms; every fresh expression position below that -- a\n    /// parenthesized group, a call argument, an arm's own guard -- puts it back to false, since\n    /// nothing there is a chain's top level. This is the split kantord/toylang#96 set out to\n    /// prove clean, and the one place a token's meaning depends on where it is read.\n    or_separates: bool,\n}\n\nimpl<'i> Cursor<'i> {\n    /// Reads the next token without consuming it. `Input` is `Copy` (a source `&str` plus an\n    /// offset), so looking ahead is just tokenizing a throwaway copy of the cursor.\n    fn peek(&self) -> Result<(Tok, Span), Error> {\n        let mut probe = self.input;\n        read_tok(&mut probe)\n    }\n\n    fn advance(&mut self) -> Result<(Tok, Span), Error> {\n        read_tok(&mut self.input)\n    }\n\n    fn eat(&mut self, want: Tok) -> Result<Span, Error> {\n        let (tok, span) = self.peek()?;\n        if tok != want {\n            return Err(self.unexpected(span, format!(\"expected {want}, found {tok}\")));\n        }\n        self.advance()?;\n        Ok(span)\n    }\n\n    /// An \"unexpected token\" error, extended with the parens spelling when the failing token is\n    /// one a call declined to take as a cross-line argument (see `declined_cross_line`): the\n    /// token had somewhere to go, and only the line break kept it from going there.\n    fn unexpected(&self, span: Span, msg: String) -> Error {\n        if let Some((at, callee)) = &self.declined_cross_line\n            && *at == span.start\n        {\n            return Error::new(\n                span,\n                format!(\n                    \"{msg}; an argument must start on the same line as its function -- \\\n                     write `{callee}(...)` to call across lines\"\n                ),\n            );\n        }\n        Error::new(span, msg)\n    }\n\n    /// Whether nothing but spaces and tabs sits between two byte offsets. The same-line rule for\n    /// call arguments: an argument, bare or parenthesized, must start on the same line as its\n    /// function, which is what lets a definition's body end next to the program's body without\n    /// either reaching across the line break and swallowing the other.\n    fn same_line(&self, from: usize, to: usize) -> bool {\n        !self.src[from..to].contains('\\n')\n    }\n\n    /// The same-line rule applied at one call site: true when the argument starting at\n    /// `arg_span` is on `callee_span`'s line. A cross-line decline is recorded (see\n    /// `declined_cross_line`) so that if the parse then fails at that token, the error can say\n    /// why the call was not taken.\n    fn takes_argument(&mut self, callee: &str, callee_span: Span, arg_span: Span) -> bool {\n        if self.same_line(callee_span.end, arg_span.start) {\n            return true;\n        }\n        self.declined_cross_line = Some((arg_span.start, callee.to_string()));\n        false\n    }\n\n    /// Runs `f` with `or` reading as `separates` says, restoring the caller's reading after.\n    fn with_or<T>(\n        &mut self,\n        separates: bool,\n        f: impl FnOnce(&mut Self) -> Result<T, Error>,\n    ) -> Result<T, Error> {\n        let outer = std::mem::replace(&mut self.or_separates, separates);\n        let out = f(self);\n        self.or_separates = outer;\n        out\n    }\n\n    fn eat_ident(&mut self, what: &str) -> Result<(String, Span), Error> {\n        match self.advance()? {\n            (Tok::Ident(n), span) => Ok((n, span)),\n            (other, span) => Err(Error::new(span, format!(\"expected {what}, found {other}\"))),\n        }\n    }\n\n    /// `fn name(param: Type) -> Type = body` or `fn name() -> Type = body`.\n    ///\n    /// Both annotations are required by the grammar rather than by the checker, which is what\n    /// makes the message point at the missing annotation instead of at an inference failure.\n    fn def(&mut self, is_pub: bool) -> Result<Def, Error> {\n        let start = self.eat(Tok::Fn)?;\n        let (name, _) = self.eat_ident(\"a name\")?;\n        self.eat(Tok::LParen)?;\n\n        let (next, _) = self.peek()?;\n        let param = if next == Tok::RParen {\n            None\n        } else {\n            let (param_name, param_span) = self.eat_ident(\"a name\")?;\n            let (colon, _) = self.peek()?;\n            if colon != Tok::Colon {\n                return Err(Error::new(\n                    param_span,\n                    format!(\"parameter `{param_name}` needs a type annotation\"),\n                ));\n            }\n            self.advance()?;\n            let param_ty = self.type_expr()?;\n            Some(Param {\n                span: param_span.to(param_ty.span()),\n                name: param_name,\n                ty: param_ty,\n            })\n        };\n\n        let close = self.eat(Tok::RParen)?;\n        let (arrow, _) = self.peek()?;\n        if arrow != Tok::Arrow {\n            return Err(Error::new(\n                close,\n                format!(\"function `{name}` needs a return type\"),\n            ));\n        }\n        self.advance()?;\n        let ret = self.type_expr()?;\n\n        self.eat(Tok::Eq)?;\n        let body = self.expr(0)?;\n        Ok(Def {\n            span: start.to(body.span()),\n            name,\n            param,\n            ret,\n            body,\n            is_pub,\n        })\n    }\n\n    /// `Str`, `Int`, `Bool`, `Vec<T>`, `Stream<T>`, or any declared name -- with\n    /// `<...>` arguments when the name is a generic enum's. The parser accepts arguments on\n    /// every name and lets resolution hold the arity, so `Pair` and `Str<Int>` fail with an\n    /// error that knows what `Pair` and `Str` are rather than a parse error that does not.\n    fn type_expr(&mut self) -> Result<TypeExpr, Error> {\n        let (tok, span) = self.advance()?;\n        if tok == Tok::LBrace {\n            return self.record_type(span);\n        }\n        let name = match tok {\n            Tok::Ident(n) => n,\n            other => return Err(Error::new(span, format!(\"expected a type, found {other}\"))),\n        };\n        if self.peek()?.0 != Tok::Lt {\n            return Ok(TypeExpr::Named {\n                name,\n                args: Vec::new(),\n                span,\n            });\n        }\n        self.advance()?;\n        let mut args = Vec::new();\n        loop {\n            args.push(self.type_expr()?);\n            let (sep, _) = self.peek()?;\n            if sep != Tok::Comma {\n                break;\n            }\n            self.advance()?;\n        }\n        let close = self.eat(Tok::Gt)?;\n        let span = span.to(close);\n        // The two built-in constructors keep their own nodes; their arity is the grammar's.\n        if ty::takes_type_arg(&name) {\n            if args.len() != 1 {\n                return Err(Error::new(\n                    span,\n                    format!(\"`{name}` takes one type argument, found {}\", args.len()),\n                ));\n            }\n            let elem = Box::new(args.remove(0));\n            return Ok(match name.as_str() {\n                \"Vec\" => TypeExpr::Vec { elem, span },\n                _ => TypeExpr::Stream { elem, span },\n            });\n        }\n        Ok(TypeExpr::Named { name, args, span })\n    }\n\n    /// A call's argument when it opens with `(` or `{`: a parenthesized expression, or a record\n    /// literal standing bare because `{` cannot start any other expression. The closing token\n    /// marks the argument's end unambiguously, which is what makes the parens form the\n    /// disambiguator wherever the bare form's own stopping rules would read a program\n    /// differently.\n    fn argument(&mut self) -> Result<(Expr, Span), Error> {\n        let (tok, span) = self.peek()?;\n        if tok == Tok::LBrace {\n            self.advance()?;\n            let lit = self.record_lit(span)?;\n            let lit_span = lit.span();\n            return Ok((lit, lit_span));\n        }\n        self.eat(Tok::LParen)?;\n        let inner = self.expr(0)?;\n        let close = self.eat(Tok::RParen)?;\n        Ok((inner, close))\n    }\n\n    /// `{name: expr, age: expr}`, the value form of the brace that `record_type` reads in type\n    /// position.\n    fn record_lit(&mut self, open: Span) -> Result<Expr, Error> {\n        let mut fields = Vec::new();\n        let (first, _) = self.peek()?;\n        if first != Tok::RBrace {\n            loop {\n                let (name, name_span) = self.eat_ident(\"a field name\")?;\n                self.eat(Tok::Colon)?;\n                fields.push((name, name_span, self.expr(0)?));\n                let (sep, _) = self.peek()?;\n                if sep != Tok::Comma {\n                    break;\n                }\n                self.advance()?;\n            }\n        }\n        let close = self.eat(Tok::RBrace)?;\n        Ok(Expr::RecordLit {\n            fields,\n            span: open.to(close),\n        })\n    }\n\n    /// `enum Shape { point, circle{r: Int}, celsius(Int) }`, optionally with type\n    /// parameters: `enum Opt<T> { some(T), none }`.\n    ///\n    /// A variant is a name, optionally followed by its payload type. The payload rule is any\n    /// single type, spelled the way a call spells its argument: a record type directly in\n    /// braces, or any type in parens.\n    fn enum_decl(&mut self, is_pub: bool) -> Result<EnumDecl, Error> {\n        let start = self.eat(Tok::Enum)?;\n        let (name, _) = self.eat_ident(\"an enum name\")?;\n        let mut params = Vec::new();\n        if self.peek()?.0 == Tok::Lt {\n            self.advance()?;\n            loop {\n                params.push(self.eat_ident(\"a type parameter\")?);\n                let (sep, _) = self.peek()?;\n                if sep != Tok::Comma {\n                    break;\n                }\n                self.advance()?;\n            }\n            self.eat(Tok::Gt)?;\n        }\n        self.eat(Tok::LBrace)?;\n        let mut variants = Vec::new();\n        let (first, _) = self.peek()?;\n        if first != Tok::RBrace {\n            loop {\n                let (vname, vspan) = self.eat_ident(\"a variant name\")?;\n                let payload = match self.peek()? {\n                    (Tok::LBrace, open) => {\n                        self.advance()?;\n                        Some(self.record_type(open)?)\n                    }\n                    (Tok::LParen, _) => {\n                        self.advance()?;\n                        let ty = self.type_expr()?;\n                        self.eat(Tok::RParen)?;\n                        Some(ty)\n                    }\n                    _ => None,\n                };\n                variants.push(Variant {\n                    name: vname,\n                    span: vspan,\n                    payload,\n                });\n                let (sep, _) = self.peek()?;\n                if sep != Tok::Comma {\n                    break;\n                }\n                self.advance()?;\n            }\n        }\n        let close = self.eat(Tok::RBrace)?;\n        Ok(EnumDecl {\n            name,\n            params,\n            variants,\n            span: start.to(close),\n            is_pub,\n        })\n    }\n\n    /// `type Db = {users: Vec<User>}`\n    fn alias(&mut self) -> Result<Alias, Error> {\n        let start = self.eat(Tok::Type)?;\n        let (name, _) = self.eat_ident(\"a type name\")?;\n        self.eat(Tok::Eq)?;\n        let ty = self.type_expr()?;\n        let span = start.to(ty.span());\n        Ok(Alias { name, ty, span })\n    }\n\n    fn record_type(&mut self, open: Span) -> Result<TypeExpr, Error> {\n        let mut fields = Vec::new();\n        let (first, _) = self.peek()?;\n        if first != Tok::RBrace {\n            loop {\n                let (fname, _) = self.eat_ident(\"a field name\")?;\n                self.eat(Tok::Colon)?;\n                fields.push((fname, self.type_expr()?));\n                let (sep, _) = self.peek()?;\n                if sep != Tok::Comma {\n                    break;\n                }\n                self.advance()?;\n            }\n        }\n        let close = self.eat(Tok::RBrace)?;\n        Ok(TypeExpr::Record {\n            fields,\n            span: open.to(close),\n        })\n    }\n\n    /// Whether the tokens ahead begin a match arm: `name ->`, `name{a, b} ->`, or `any() ->`.\n    /// The one place this has to look carefully is a brace: a record *pattern* holds bare names\n    /// (and `..`), so the first `:` proves the braces are a constructor's record literal\n    /// argument instead. A lexical error while probing is not an arm; the ordinary path will\n    /// surface it.\n    fn arm_starts_here(&self) -> bool {\n        let mut probe = self.input;\n        let mut next = || read_tok(&mut probe).map(|(t, _)| t);\n        let Ok(Tok::Ident(name)) = next() else {\n            return false;\n        };\n        match next() {\n            Ok(Tok::Arrow) => true,\n            Ok(Tok::LParen) if name == \"any\" => {\n                matches!(next(), Ok(Tok::RParen)) && matches!(next(), Ok(Tok::Arrow))\n            }\n            Ok(Tok::LBrace) => {\n                loop {\n                    match next() {\n                        Ok(Tok::Ident(_) | Tok::Comma | Tok::Dot) => continue,\n                        Ok(Tok::RBrace) => break,\n                        _ => return false,\n                    }\n                }\n                matches!(next(), Ok(Tok::Arrow))\n            }\n            _ => false,\n        }\n    }\n\n    /// `left -> body or left -> body or ...`, first match wins; `or` is the one arm composer.\n    /// A left side is a variant pattern (`circle{r}`), `any()`, or a Bool guard expression; the\n    /// chain's final element may instead be a bare expression, the default. The chain reads `.`\n    /// as its subject, so it usually sits to the right of a `|`; each body stops at `|` and\n    /// `or`, which is what lets the chain be one pipe stage.\n    ///\n    /// The two `or`s meet here and nowhere else. A body is read with the separator reading, so\n    /// it ends at the next `or`; an element's own left side is read with the disjunction one, so\n    /// `a -> 1 or b == 2 or c == 3 -> 4` is two arms whose second has a two-clause guard. What\n    /// makes that split decidable is that an element ending at a bare `or` could only ever have\n    /// been a bare default in a non-final position, which was already an error.\n    ///\n    /// `lead` is an expression `expr` had already read when the `->` after it revealed a chain;\n    /// the first element continues from it instead of parsing fresh.\n    fn match_expr(&mut self, lead: Option<Expr>) -> Result<Expr, Error> {\n        let mut arms = Vec::new();\n        let mut lead = lead;\n        loop {\n            let arm = match lead.take() {\n                Some(e) => self.guard_or_default_arm(e)?,\n                None if self.arm_starts_here() => {\n                    let pattern = self.pattern()?;\n                    self.eat(Tok::Arrow)?;\n                    let body = self.arm_body()?;\n                    let span = pattern.span().to(body.span());\n                    MatchArm {\n                        pattern,\n                        body,\n                        span,\n                    }\n                }\n                None => {\n                    let e = self.with_or(false, |p| p.operand(COND_POWER))?;\n                    self.guard_or_default_arm(e)?\n                }\n            };\n            arms.push(arm);\n            let (sep, _) = self.peek()?;\n            if sep != Tok::Or {\n                break;\n            }\n            self.advance()?;\n        }\n        let span = arms[0].span.to(arms[arms.len() - 1].span);\n        Ok(Expr::Match { arms, span })\n    }\n\n    /// An arm's right side: the one position where a bare `or` is the chain's separator rather\n    /// than disjunction, so a Bool `or` written here needs parens (draft.md, the match-arms\n    /// decision).\n    fn arm_body(&mut self) -> Result<Expr, Error> {\n        self.with_or(true, |p| p.expr(COND_POWER))\n    }\n\n    /// The element `left` opens: `left -> body` makes `left` a guard, and a bare `left` is the\n    /// default, desugared to a `Default` arm whose body is `left` itself.\n    fn guard_or_default_arm(&mut self, left: Expr) -> Result<MatchArm, Error> {\n        if self.peek()?.0 == Tok::Arrow {\n            self.advance()?;\n            let body = self.arm_body()?;\n            let span = left.span().to(body.span());\n            return Ok(MatchArm {\n                pattern: Pattern::Guard(left),\n                body,\n                span,\n            });\n        }\n        let span = left.span();\n        Ok(MatchArm {\n            pattern: Pattern::Default { span },\n            body: left,\n            span,\n        })\n    }\n\n    fn pattern(&mut self) -> Result<Pattern, Error> {\n        let (name, span) = self.eat_ident(\"a pattern\")?;\n        let (next, brace_span) = self.peek()?;\n        if name == \"any\" && next == Tok::LParen {\n            self.advance()?;\n            let close = self.eat(Tok::RParen)?;\n            return Ok(Pattern::Default {\n                span: span.to(close),\n            });\n        }\n        if next != Tok::LBrace {\n            return Ok(Pattern::Variant {\n                name,\n                span,\n                fields: None,\n            });\n        }\n        self.advance()?;\n        let mut names = Vec::new();\n        let mut rest = false;\n        let (first, _) = self.peek()?;\n        if first != Tok::RBrace {\n            loop {\n                // `..` is two Dot tokens, and it ends the list: naming a field after \"and the\n                // rest\" would make the marker meaningless.\n                if self.peek()?.0 == Tok::Dot {\n                    self.advance()?;\n                    self.eat(Tok::Dot)?;\n                    rest = true;\n                    break;\n                }\n                names.push(self.eat_ident(\"a field name\")?);\n                let (sep, _) = self.peek()?;\n                if sep != Tok::Comma {\n                    break;\n                }\n                self.advance()?;\n            }\n        }\n        let close = self.eat(Tok::RBrace)?;\n        let fields = FieldsPattern {\n            names,\n            rest,\n            span: brace_span.to(close),\n        };\n        Ok(Pattern::Variant {\n            name,\n            span: span.to(close),\n            fields: Some(fields),\n        })\n    }\n\n    /// Arm chains begin only where an expression begins fresh (a pipe stage, a delimited\n    /// position), and a fresh position is also where `or` goes back to reading as disjunction:\n    /// whatever chain the enclosing arm body belonged to, this expression is not part of it. An\n    /// arm body or a conditional branch enters at COND_POWER instead and leaves any `->` or\n    /// separator `or` it meets for the chain that owns it, rather than opening a nested chain\n    /// that would swallow the rest of the outer one.\n    fn expr(&mut self, min_power: u8) -> Result<Expr, Error> {\n        if min_power <= PIPE_RIGHT {\n            return self.with_or(false, |p| p.expr_at(min_power, true));\n        }\n        self.expr_at(min_power, false)\n    }\n\n    fn expr_at(&mut self, min_power: u8, fresh: bool) -> Result<Expr, Error> {\n        let mut lhs = if fresh && self.arm_starts_here() {\n            self.match_expr(None)?\n        } else {\n            let e = self.operand(min_power)?;\n            let (tok, _) = self.peek()?;\n            // No `Tok::Or` here: a fresh position reads `or` as disjunction, so `operand` has\n            // already taken any that were there, and an arm chain is revealed by the `->` that\n            // follows the whole disjunction (`a == 1 or b == 2 -> ...` is one guard).\n            if fresh && tok == Tok::Arrow {\n                self.match_expr(Some(e))?\n            } else {\n                e\n            }\n        };\n\n        // Right-associative, so `a if c else b if d else e` chains rightward without parens.\n        let (tok, _) = self.peek()?;\n        if tok == Tok::If && COND_POWER >= min_power {\n            self.advance()?;\n            // `else` closes the condition, so a bare `or` inside it can only be disjunction --\n            // even in an arm body, where the separator reading is otherwise in force.\n            let cond = self.with_or(false, |p| p.operand(COND_POWER + 1))?;\n            self.eat(Tok::Else)?;\n            let otherwise = self.expr(COND_POWER)?;\n            let span = lhs.span().to(otherwise.span());\n            lhs = Expr::Cond {\n                then: Box::new(lhs),\n                cond: Box::new(cond),\n                otherwise: Box::new(otherwise),\n                span,\n            };\n        }\n\n        loop {\n            let (tok, _) = self.peek()?;\n            if tok != Tok::Pipe || PIPE_LEFT < min_power {\n                break;\n            }\n            self.advance()?;\n            let rhs = self.expr(PIPE_RIGHT)?;\n            let span = lhs.span().to(rhs.span());\n            lhs = Expr::Pipe {\n                lhs: Box::new(lhs),\n                rhs: Box::new(rhs),\n                span,\n            };\n        }\n\n        Ok(lhs)\n    }\n\n    fn operand(&mut self, min_power: u8) -> Result<Expr, Error> {\n        let mut lhs = self.complement(min_power)?;\n\n        loop {\n            let (tok, _) = self.peek()?;\n            // Where `or` is the arm separator it is not an operator at all, so the table is not\n            // even consulted: the chain the arm belongs to takes the token.\n            if tok == Tok::Or && self.or_separates {\n                break;\n            }\n            let Some((op, left, right)) = infix_power(&tok) else {\n                break;\n            };\n            if left < min_power {\n                break;\n            }\n            self.advance()?;\n            let rhs = self.operand(right)?;\n            let span = lhs.span().to(rhs.span());\n            lhs = match op {\n                Infix::Bin(op) => Expr::Binary {\n                    op,\n                    lhs: Box::new(lhs),\n                    rhs: Box::new(rhs),\n                    span,\n                },\n                Infix::Logic(op) => Expr::Logic {\n                    op,\n                    lhs: Box::new(lhs),\n                    rhs: Box::new(rhs),\n                    span,\n                },\n            };\n        }\n\n        Ok(lhs)\n    }\n\n    /// `not`, which is prefix but not unary in `-`'s sense: it binds looser than every operator\n    /// in the infix table above comparison, so it reads its own operand at its own power rather\n    /// than taking whatever `unary` returns. A position that binds tighter than `not` (a\n    /// comparison's right side, say) declines it, and parens are what reach in there.\n    fn complement(&mut self, min_power: u8) -> Result<Expr, Error> {\n        let (tok, span) = self.peek()?;\n        if tok == Tok::Not && min_power <= NOT_POWER {\n            self.advance()?;\n            let base = self.operand(NOT_POWER)?;\n            let full = span.to(base.span());\n            return Ok(Expr::Not {\n                base: Box::new(base),\n                span: full,\n            });\n        }\n        self.unary()\n    }\n\n    /// Negation binds tighter than any infix operator and looser than any postfix one, so\n    /// `-a.b` negates the field and `-a * b` negates only `a`.\n    fn unary(&mut self) -> Result<Expr, Error> {\n        let (tok, span) = self.peek()?;\n        if tok == Tok::Minus {\n            self.advance()?;\n            let base = self.unary()?;\n            let full = span.to(base.span());\n            return Ok(Expr::Neg {\n                base: Box::new(base),\n                span: full,\n            });\n        }\n        self.postfix()\n    }\n\n    /// `[]` and `.name` bind tighter than any infix operator, so `a.b[] | c` projects `a.b`.\n    fn postfix(&mut self) -> Result<Expr, Error> {\n        let mut e = self.atom()?;\n        loop {\n            let (tok, _) = self.peek()?;\n            match tok {\n                Tok::LBracket => {\n                    self.advance()?;\n                    let (next, _) = self.peek()?;\n                    if next == Tok::RBracket {\n                        let close = self.advance()?.1;\n                        let span = e.span().to(close);\n                        e = Expr::Project {\n                            base: Box::new(e),\n                            span,\n                        };\n                    } else {\n                        let index = self.expr(0)?;\n                        let close = self.eat(Tok::RBracket)?;\n                        let span = e.span().to(close);\n                        e = Expr::Index {\n                            base: Box::new(e),\n                            index: Box::new(index),\n                            span,\n                        };\n                    }\n                }\n                Tok::Bang => {\n                    let bang = self.advance()?.1;\n                    let span = e.span().to(bang);\n                    e = Expr::Unwrap {\n                        base: Box::new(e),\n                        span,\n                    };\n                }\n                Tok::Dot => {\n                    self.advance()?;\n                    let (ft, fspan) = self.advance()?;\n                    let Tok::Ident(name) = ft else {\n                        return Err(Error::new(\n                            fspan,\n                            format!(\"expected a field name, found {ft}\"),\n                        ));\n                    };\n                    let span = e.span().to(fspan);\n                    e = Expr::Field {\n                        base: Box::new(e),\n                        name,\n                        span,\n                    };\n                }\n                _ => return Ok(e),\n            }\n        }\n    }\n\n    /// What a name means once read: a qualified variant (`Shape.circle`), a call when an\n    /// argument starts after it on the same line, or a plain variable reference.\n    ///\n    /// A name followed by an argument is a call; bare application is the default spelling and\n    /// `f(x)` is `f` applied to the grouped atom `(x)`. The bare form asks two things of the\n    /// call that the delimited forms do not: the callee must be lowercase (a capitalised bare\n    /// call could never typecheck), and the argument's first token excludes `-` (already\n    /// subtraction: `f -1` stays `f - 1`), `.` (projection binds tighter than bare application\n    /// everywhere, so `p.b` is a field access even though `.b` alone could be an argument --\n    /// issue #19), and `[` (indexing owns it for the same reason: `v[0]` indexes, so a Vec\n    /// literal argument needs parens).\n    fn ident_expr(&mut self, name: String, span: Span) -> Result<Expr, Error> {\n        let (next, next_span) = self.peek()?;\n        // `Shape.circle`: the casing rule makes uppercase-then-dot unambiguous, since a\n        // capitalised name can never be a value for `.` to project a field out of.\n        if next == Tok::Dot && name.chars().next().is_some_and(char::is_uppercase) {\n            self.advance()?;\n            let (variant, variant_span) = self.eat_ident(\"a variant name\")?;\n            let (after, after_span) = self.peek()?;\n            let (payload, end) = if (after == Tok::LParen || after == Tok::LBrace)\n                && self.takes_argument(&format!(\"{name}.{variant}\"), variant_span, after_span)\n            {\n                let (arg, close) = self.argument()?;\n                (Some(Box::new(arg)), close)\n            } else {\n                (None, variant_span)\n            };\n            return Ok(Expr::Variant {\n                enum_name: name,\n                enum_span: span,\n                variant,\n                variant_span,\n                payload,\n                span: span.to(end),\n            });\n        }\n        let argument_starts = match next {\n            Tok::LParen | Tok::LBrace => true,\n            Tok::Str(_) | Tok::Int(_) | Tok::Input | Tok::Inputs | Tok::Lines | Tok::Ident(_) => {\n                bare_callee(&name)\n            }\n            _ => false,\n        };\n        if !argument_starts || !self.takes_argument(&name, span, next_span) {\n            return Ok(Expr::Var { name, span });\n        }\n        // `name()` is a nullary call, the one place a call's argument is optional: the empty\n        // parens are checked for before falling into the ordinary single-expression parse, so\n        // every other argument form (parenthesized, record, or bare) still names exactly one.\n        let (arg, close) = if next == Tok::LParen {\n            self.advance()?;\n            let (after, _) = self.peek()?;\n            if after == Tok::RParen {\n                let close = self.advance()?.1;\n                (None, close)\n            } else {\n                let inner = self.expr(0)?;\n                let close = self.eat(Tok::RParen)?;\n                (Some(inner), close)\n            }\n        } else if next == Tok::LBrace {\n            let (lit, close) = self.argument()?;\n            (Some(lit), close)\n        } else {\n            // A bare argument is a postfix chain, not an operand: an infix operator after it\n            // belongs to the enclosing expression, so `f x + y` is `f(x) + y`. Chaining is\n            // right-recursive through `atom` itself, making `f g x` read `f(g(x))` -- with no\n            // first-class functions, the only reading that could ever typecheck.\n            let arg = self.postfix()?;\n            let end = arg.span();\n            (Some(arg), end)\n        };\n        Ok(Expr::Call {\n            func: name,\n            func_span: span,\n            arg: arg.map(Box::new),\n            span: span.to(close),\n        })\n    }\n\n    fn atom(&mut self) -> Result<Expr, Error> {\n        let (tok, span) = self.advance()?;\n        match tok {\n            Tok::Str(text) => Ok(Expr::Str { text, span }),\n            Tok::Int(value) => Ok(Expr::Int { value, span }),\n            Tok::Input => Ok(Expr::Input { span }),\n            Tok::Inputs => Ok(Expr::Inputs { span }),\n            Tok::Lines => Ok(Expr::Lines { span }),\n\n            // `.name` is field access on the subject, so the leading dot yields `.` and the\n            // postfix loop above picks the field up.\n            Tok::Dot => {\n                let (next, _) = self.peek()?;\n                if let Tok::Ident(name) = next {\n                    let (_, fspan) = self.advance()?;\n                    return Ok(Expr::Field {\n                        base: Box::new(Expr::Subject { span }),\n                        name,\n                        span: span.to(fspan),\n                    });\n                }\n                Ok(Expr::Subject { span })\n            }\n\n            Tok::LBrace => self.record_lit(span),\n\n            Tok::LBracket => {\n                // `,` is a separator here, not an operator. It has no meaning outside a literal\n                // while everything stays in the value layer.\n                let mut items = Vec::new();\n                let (first, _) = self.peek()?;\n                if first != Tok::RBracket {\n                    loop {\n                        items.push(self.expr(0)?);\n                        let (sep, _) = self.peek()?;\n                        if sep != Tok::Comma {\n                            break;\n                        }\n                        self.advance()?;\n                    }\n                }\n                let close = self.eat(Tok::RBracket)?;\n                Ok(Expr::VecLit {\n                    items,\n                    span: span.to(close),\n                })\n            }\n\n            Tok::Ident(name) => self.ident_expr(name, span),\n\n            Tok::LParen => {\n                let inner = self.expr(0)?;\n                self.eat(Tok::RParen)?;\n                Ok(inner)\n            }\n\n            other => Err(Error::new(\n                span,\n                format!(\"expected an expression, found {other}\"),\n            )),\n        }\n    }\n}\n\n/// Whether `name` can take a bare (undelimited) argument. Only a lowercase name can: a\n/// capitalised name is a type under the casing rule, so a capitalised bare call could never\n/// typecheck. Constructors still apply with the delimited forms (`Circle{r: 1}`,\n/// `Circle(...)`), which this does not gate.\nfn bare_callee(name: &str) -> bool {\n    !name.chars().next().is_some_and(char::is_uppercase)\n}","lineStart":1,"lineEnd":1280,"totalLines":1280,"truncated":false}},"title":"src/parse.rs","time":{"start":1788120639772,"end":1788120639782}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now I understand the type system. Let me look at the parse.rs to understand how Int literals are parsed, then the TIR, checker, and emitters. Let me look at how `Int` literals flow.\n\nLet me look at parse.rs first.","format":"unknown","index":0}]}},"id":"prt_0544ba724001XSTpj5hC050HfM","sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","messageID":"msg_0544b9a74001NbLBMMbGoxOPsR"}}
{"type":"step_finish","timestamp":1788120639797,"sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","part":{"id":"prt_0544ba930001xDu142XXw2miV9","reason":"tool-calls","snapshot":"94b6040ffbb3d9f05c4638216dc44bf3958c7c09","messageID":"msg_0544b9a74001NbLBMMbGoxOPsR","sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","type":"step-finish","tokens":{"total":29084,"input":6437,"output":68,"reasoning":51,"cache":{"write":0,"read":22528}},"cost":0.000800273}}
{"type":"step_start","timestamp":1788120640731,"sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","part":{"id":"prt_0544bacd8001aw7sP0fYtHBFY7","messageID":"msg_0544ba93d001H7kelD2ihT1UNH","sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","snapshot":"94b6040ffbb3d9f05c4638216dc44bf3958c7c09","type":"step-start"}}
{"type":"tool_use","timestamp":1788120641675,"sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-a68307b221f521c5","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-149/src/tir.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-149/src/tir.rs</path>\n<type>file</type>\n<content>\n1: //! The typed IR the backends consume.\n2: //!\n3: //! Every node carries the type it was checked at, so a backend never has to ask what a value is\n4: //! at runtime and never has to look a type up in a table beside the tree. A static target cannot\n5: //! work from anything less: it has to know that an add is an integer add before it can emit one.\n6: //!\n7: //! Names are deliberately *not* mangled here. Which identifiers are reserved is a property of\n8: //! the target, not of toylang, so each backend renders these as it needs to.\n9: \n10: use crate::ast::{BinOp, LogicOp};\n11: use crate::ty::{Enums, Type};\n12: \n13: pub struct Tir {\n14:     pub ty: Type,\n15:     pub kind: Kind,\n16: }\n17: \n18: impl Tir {\n19:     pub fn new(ty: Type, kind: Kind) -> Tir {\n20:         Tir { ty, kind }\n21:     }\n22: }\n23: \n24: /// A binding the source cannot name, introduced for `|` and for `select`'s parameter.\n25: pub type LocalId = u32;\n26: \n27: pub enum Kind {\n28:     Str(String),\n29:     Int(i64),\n30:     VecLit(Vec<Tir>),\n31:     /// A record literal, its fields in declaration order so a field's position here matches\n32:     /// its position in the type. That is what lets a backend address one by index rather than\n33:     /// searching for it.\n34:     RecordLit {\n35:         fields: Vec<(String, Tir)>,\n36:     },\n37:     /// A constructed enum value. The node's type is the enum, so a backend finds the variant's\n38:     /// position (its tag, where one is needed) and its payload type by asking `ty::variants`\n39:     /// for that type's list rather than by carrying either here. `payload` is `None` for a unit\n40:     /// variant, which every backend renders as the bare variant-name string; a payload variant\n41:     /// is the single-key wrapper (ADR 0009).\n42:     EnumLit {\n43:         variant: String,\n44:         payload: Option<Box<Tir>>,\n45:     },\n46:     /// Rebuilds an Opt: present-preserving, absent-preserving. `body` runs with `param` bound\n47:     /// to the unwrapped payload only when `source` is present; an absent `source` passes\n48:     /// through untouched. Never surface syntax -- Opt has no general map or match a program can\n49:     /// reach (kantord/toylang#47's totality round owns that) -- this is only how the checker's\n50:     /// own reorder pass reaches inside an Opt payload (kantord/toylang#66): every other enum\n51:     /// reorders through `Match`/`EnumLit`, but Opt keeps a representation of its own in three\n52:     /// backends, so those two general nodes cannot reach it.\n53:     OptMap {\n54:         source: Box<Tir>,\n55:         param: LocalId,\n56:         body: Box<Tir>,\n57:     },\n58:     /// A name written in the source: today only a function parameter.\n59:     Var(String),\n60:     Local(LocalId),\n61:     /// The value read from stdin.\n62:     Input,\n63:     /// Every remaining JSON value on stdin, one per line, eagerly collected into a `Vec<T>`.\n64:     Inputs,\n65:     /// The stream of lines read from stdin, read incrementally by whatever consumes it.\n66:     Lines,\n67:     Call {\n68:         func: String,\n69:         /// `None` for a call to a nullary function.\n70:         arg: Option<Box<Tir>>,\n71:     },\n72:     Concat(Box<Tir>, Box<Tir>),\n73:     /// Wrapping integer arithmetic, at the width the node's own type names: 32 bits for `Int`,\n74:     /// 64 for `Int64` (kantord/toylang#83) -- both operands always share it, since nothing\n75:     /// converts implicitly. Division and remainder stop the program on a zero divisor, which\n76:     /// is the only way arithmetic can fail.\n77:     Arith {\n78:         op: BinOp,\n79:         lhs: Box<Tir>,\n80:         rhs: Box<Tir>,\n81:     },\n82:     /// The condition is exactly one Bool, which is what turns jq's run-both-branches behaviour\n83:     /// into a type error here.\n84:     Cond {\n85:         cond: Box<Tir>,\n86:         then: Box<Tir>,\n87:         otherwise: Box<Tir>,\n88:     },\n89:     Compare {\n90:         op: BinOp,\n91:         lhs: Box<Tir>,\n92:         rhs: Box<Tir>,\n93:     },\n94:     /// `and` / `or` over two Bools, short-circuiting: `rhs` is evaluated only when `lhs` leaves\n95:     /// the answer open. That is not a nicety here -- division and `!` can stop the program, so\n96:     /// whether the right side runs is observable -- which is why every backend emits its own\n97:     /// short-circuiting operator rather than two evaluated operands combined afterwards.\n98:     Logic {\n99:         op: LogicOp,\n100:         lhs: Box<Tir>,\n101:         rhs: Box<Tir>,\n102:     },\n103:     /// `not b`.\n104:     Not(Box<Tir>),\n105:     /// `let local = value in body`, which is what `|` becomes once `.` has a name.\n106:     Bind {\n107:         local: LocalId,\n108:         value: Box<Tir>,\n109:         body: Box<Tir>,\n110:     },\n111:     /// Every element replaced by `body`, with `param` bound to each. Same loop as Select, kept\n112:     /// separate because the result's element type is the body's rather than the source's.\n113:     Map {\n114:         source: Box<Tir>,\n115:         param: LocalId,\n116:         body: Box<Tir>,\n117:     },\n118:     Select {\n119:         source: Box<Tir>,\n120:         param: LocalId,\n121:         pred: Box<Tir>,\n122:     },\n123:     /// Read `name` off `base`. How many Vec layers to descend through is `base.ty`'s doing and\n124:     /// is not stored, so it cannot disagree with the type.\n125:     Field {\n126:         base: Box<Tir>,\n127:         name: String,\n128:     },\n129:     /// Collapse one dimension of `base` at `index`, `depth` layers down.\n130:     ///\n131:     /// Unlike a field access this has to store its depth. A field access leaves a record behind,\n132:     /// so the depth is every Vec layer of the base; an index leaves a Vec behind, so the layers\n133:     /// below the one being collapsed are indistinguishable from the ones above it.\n134:     /// A unary builtin. Unary like every other function, so it needs no special call form.\n135:     Builtin {\n136:         which: Builtin,\n137:         arg: Box<Tir>,\n138:     },\n139:     /// Insist an Opt is present, `depth` layers down. Like a field access and unlike an index,\n140:     /// the depth is every Vec layer of the base, because an Opt is not a dimension.\n141:     Unwrap {\n142:         base: Box<Tir>,\n143:     },\n144:     Index {\n145:         base: Box<Tir>,\n146:         index: Box<Tir>,\n147:         depth: usize,\n148:         /// Whether an entry is a record, which decides if collapsing has to gather columns.\n149:         elem_is_record: bool,\n150:     },\n151:     /// First-match-wins dispatch over the subject: variant arms test its shape, guard arms\n152:     /// evaluate a Bool of their own. The checker has already resolved every name a pattern\n153:     /// bound, so an arm is only a test, a payload local to bind, and a body.\n154:     ///\n155:     /// When the chain is total (`partial` is false) -- every variant covered, or a default at\n156:     /// the end -- a backend may take the last arm without a test. A partial chain has no such\n157:     /// arm: every test is emitted, and falling off the end produces the absent `Opt`, which is\n158:     /// why the node's type is then `Opt` of the arms' common body type.\n159:     Match {\n160:         subject: Box<Tir>,\n161:         arms: Vec<MatchArm>,\n162:         partial: bool,\n163:     },\n164: }\n165: \n166: pub struct MatchArm {\n167:     /// `Some` tests the subject for this variant. `None` with a `guard` is a guard arm; `None`\n168:     /// with no guard is the default arm, which the checker keeps last.\n169:     pub variant: Option<String>,\n170:     /// The Bool deciding a guard arm, already checked in the subject's scope.\n171:     pub guard: Option<Tir>,\n172:     /// The local the payload binds to in a payload-variant arm; `.` and destructured field\n173:     /// names in the body both read through it.\n174:     pub payload: Option<LocalId>,\n175:     pub body: Tir,\n176: }\n177: \n178: /// The functions the language provides. Each is unary, and so is every user function: something\n179: /// wanting two arguments takes a record, which is what a record literal is for in argument\n180: /// position.\n181: #[derive(Clone, Copy, PartialEq, Eq)]\n182: pub enum Builtin {\n183:     /// `str(n)`, rendering an Int the way the printer does but reachable from a program.\n184:     IntToStr,\n185:     /// `i64(n)`, `Int -> Int64`: the one bridge between the two integer types, explicit\n186:     /// because nothing widens implicitly (kantord/toylang#83). A no-op on every backend whose\n187:     /// runtime integers are already 64 bits wide; JS builds a BigInt, and Go and Rust spell\n188:     /// the cast.\n189:     IntToI64,\n190:     /// `range(n)`, the integers from zero up to but not including n. Zero-based, matching jq,\n191:     /// Python, and this language's own indices.\n192:     Range,\n193:     /// `collect(s)`, `Stream<T> -> Vec<T>`: the one place a stream stops being a stream. What\n194:     /// comes back is an ordinary value, exactly as sized as it needs to be, with no trace left\n195:     /// of how it arrived.\n196:     Collect,\n197:     /// `jsonlines(v)`, printing each element of a `Vec<T>` on its own line rather than wrapping\n198:     /// the whole thing in `[...]`. Named for the format (jsonlines.org, also called NDJSON):\n199:     /// one JSON value per line. Polymorphic over the element type, so it is not in the fixed\n200:     /// signature table `builtin()` reads from; `synth` checks it directly, the way `map` and\n201:     /// `select` are checked from their own arm rather than through a table.\n202:     JsonLines,\n203:     /// `length(v)`, a Vec's length. A dense Vec already tracks this at runtime, so reading it out\n204:     /// costs nothing -- there is no fold or scan hiding behind the name.\n205:     Length,\n206:     /// `flatten(vv)`, flattening a `Vec<Vec<T>>` into one `Vec<T>`, for the case where the\n207:     /// number of inner Vecs is not known at the call site. Joining a fixed, known count of Vecs\n208:     /// is `+` instead (kantord/toylang#97, the add-trait reading of Q2 in plans/questions.md); this\n209:     /// builtin used to be named `concat` and cover both cases before that split.\n210:     Flatten,\n211:     /// `tail(v)`, every element but the first, `None` when `v` is empty. Consistent with how\n212:     /// `Index` already turns \"reaching past what's there\" into `Opt` rather than a runtime\n213:     /// failure.\n214:     Tail,\n215:     /// `fields(r)`, a record's field names in declaration order (kantord/toylang#63, the\n216:     /// accessor #60's ratification promised once order left type identity). The names come from\n217:     /// `r`'s checked type, not its runtime value, so every backend can emit them as a literal;\n218:     /// `r` is still evaluated for whatever it would otherwise do, the same as any other argument.\n219:     Fields,\n220:     /// `chars(s)`, `Str -> Vec<Char>`: every Unicode scalar value in `s`, in order. Decoded by\n221:     /// codepoint on every backend, so a character outside the Basic Multilingual Plane is one\n222:     /// element here even on a target whose own strings need a surrogate pair to spell it\n223:     /// (kantord/toylang#75).\n224:     Chars,\n225:     /// `sort(v)`, `Vec<T> -> Vec<T>`: `v`'s elements in ascending order by the same total order\n226:     /// `<` already gives `T`. One value in, one value out with no lawful Stream instance\n227:     /// (kantord/toylang#86, Q20 in plans/questions.md), so it is checked as a Vec-only builtin the way\n228:     /// `length`/`tail`/`flatten` are rather than through `select`/`map`'s cardinality\n229:     /// polymorphism. Restricted to the element types ordering already typechecks on --\n230:     /// Int, Int64, Str, Char -- so every backend can reach for its native ordering.\n231:     Sort,\n232:     /// `reverse(v)`, `Vec<T> -> Vec<T>`: `v`'s elements in the opposite order. Blocking for the\n233:     /// same reason `sort` is (the whole Vec has to be there before the first output element\n234:     /// is), but unrestricted in element type, since reversing needs no comparison.\n235:     Reverse,\n236: }\n237: \n238: pub struct Func {\n239:     pub name: String,\n240:     /// `None` for a nullary function.\n241:     pub param: Option<String>,\n242:     pub param_ty: Option<Type>,\n243:     pub body: Tir,\n244: }\n245: \n246: pub struct Program {\n247:     pub funcs: Vec<Func>,\n248:     pub body: Tir,\n249:     /// The type stdin must have, if the program reads it.\n250:     pub input: Option<Type>,\n251:     /// The element type each line of stdin parses as, if the program reads `inputs`.\n252:     pub inputs: Option<Type>,\n253:     /// Whether the program reads `lines`. A separate flag from `input`, since the two are\n254:     /// unrelated readers of the same real stdin and a program using `lines` alone still needs\n255:     /// it connected, even though `input` is `None`.\n256:     pub uses_lines: bool,\n257:     /// Every enum the program declared, the prelude's included. A backend has no checker `Ctx`\n258:     /// to hand, and the variant list on a `Type::Enum` is a placeholder wherever a recursive\n259:     /// enum's payload reaches back to itself, so this travels with the tree: it is what\n260:     /// `ty::variants` re-derives from (kantord/toylang#94).\n261:     pub enums: Enums,\n262: }\n263: \n264: /// The element type a backend iterates over. Under eager lowering a stream is materialized as\n265: /// the Vec of its entries, so a Stream's element counts exactly as a Vec's here; the checker's\n266: /// `Type::elem` deliberately does not agree, keeping the reducers Vec-only at the surface.\n267: pub fn runtime_elem(ty: &Type) -> Option<&Type> {\n268:     match ty {\n269:         Type::Vec(t) | Type::Stream(t) => Some(t),\n270:         _ => None,\n271:     }\n272: }\n273: \n274: /// How many dimension layers wrap a scalar -- `Vec`s, plus the outermost `Stream` when there\n275: /// is one. Field access distributes over each of them.\n276: pub fn vec_depth(ty: &Type) -> usize {\n277:     let mut depth = 0;\n278:     let mut inner = ty;\n279:     while let Some(elem) = runtime_elem(inner) {\n280:         depth += 1;\n281:         inner = elem;\n282:     }\n283:     depth\n284: }\n285: \n286: /// One `map`/`select` applied between reading a record and printing it, in source order (the\n287: /// stage nearest the source first).\n288: pub enum Stage<'a> {\n289:     Map { param: LocalId, body: &'a Tir },\n290:     Select { param: LocalId, pred: &'a Tir },\n291: }\n292: \n293: /// What a fused loop reads one entry at a time: parsed JSON values, or raw lines.\n294: #[derive(Clone, Copy, PartialEq, Eq)]\n295: pub enum Source {\n296:     Inputs,\n297:     Lines,\n298: }\n299: \n300: /// A stream-typed pipeline ending in `jsonlines`, compiled as a read-one/transform-one/\n301: /// write-one loop. Decided by the types, not by a structural guess: the old `recognize_fusion`\n302: /// pattern match retired when `Stream` entered the type grammar (plans/streams.md step 5), so\n303: /// whether a program streams is now exactly whether its types say so.\n304: pub struct Fusion<'a> {\n305:     pub source: Source,\n306:     pub stages: Vec<Stage<'a>>,\n307: }\n308: \n309: /// What a stream chain bottoms out at: a source, a function's own parameter, or the local a\n310: /// `|` bound.\n311: enum Base<'a> {\n312:     Inputs,\n313:     Lines,\n314:     Var(&'a String),\n315:     Local(LocalId),\n316: }\n317: \n318: /// Append the per-element stages of the stream-typed `t`, returning what its chain bottoms out\n319: /// at.\n320: ///\n321: /// Total, not a recognizer: the checker leaves exactly these kinds able to carry a Stream type\n322: /// (sources, bindings, mappers, calls -- a conditional or match yielding one is refused, and\n323: /// projection is normalized to a Map), so the `unreachable!` arms are compiler bugs, never\n324: /// program shapes. That is the invariant this step lands: a stream-typed program that failed\n325: /// to fuse would silently materialize stdin, which is the defect the feature exists to remove.\n326: fn flatten<'a>(t: &'a Tir, program: &'a Program, stages: &mut Vec<Stage<'a>>) -> Base<'a> {\n327:     match &t.kind {\n328:         Kind::Inputs => Base::Inputs,\n329:         Kind::Lines => Base::Lines,\n330:         Kind::Var(name) => Base::Var(name),\n331:         Kind::Local(id) => Base::Local(*id),\n332:         Kind::Bind { local, value, body } => {\n333:             let base = flatten(value, program, stages);\n334:             match flatten(body, program, stages) {\n335:                 Base::Local(id) if id == *local => base,\n336:                 _ => unreachable!(\"a piped stream is consumed by the pipe's own body\"),\n337:             }\n338:         }\n339:         Kind::Map {\n340:             source,\n341:             param,\n342:             body,\n343:         } => {\n344:             let base = flatten(source, program, stages);\n345:             stages.push(Stage::Map {\n346:                 param: *param,\n347:                 body,\n348:             });\n349:             base\n350:         }\n351:         Kind::Select {\n352:             source,\n353:             param,\n354:             pred,\n355:         } => {\n356:             let base = flatten(source, program, stages);\n357:             stages.push(Stage::Select {\n358:                 param: *param,\n359:                 pred,\n360:             });\n361:             base\n362:         }\n363:         // The argument's stages first, then the callee's body inlined: its chain bottoms at\n364:         // its own parameter (a stream-returning function must take a stream, and linearity\n365:         // makes the parameter the base of whatever it returns).\n366:         Kind::Call { func, arg } => {\n367:             let f = program\n368:                 .funcs\n369:                 .iter()\n370:                 .find(|f| &f.name == func)\n371:                 .expect(\"the checker resolved every call\");\n372:             // A stream-returning function must take a stream (see `signatures`), so a call\n373:             // reaching here -- one whose result is stream-typed -- always carries an argument.\n374:             let arg = arg\n375:                 .as_deref()\n376:                 .expect(\"a stream-returning function is never nullary\");\n377:             let base = flatten(arg, program, stages);\n378:             let param = f\n379:                 .param\n380:                 .as_deref()\n381:                 .expect(\"a stream-returning function is never nullary\");\n382:             match flatten(&f.body, program, stages) {\n383:                 Base::Var(name) if name == param => base,\n384:                 _ => unreachable!(\"a stream-returning function's chain bottoms at its parameter\"),\n385:             }\n386:         }\n387:         _ => unreachable!(\"the checker leaves no other kind stream-typed\"),\n388:     }\n389: }\n390: \n391: /// The type question `streams_inputs` used to answer by pattern match: a `jsonlines` program\n392: /// whose argument is stream-typed fuses, and one whose argument is a Vec (already collected)\n393: /// stays an ordinary value and runs eagerly, exactly as its types say.\n394: pub fn fusion(program: &Program) -> Option<Fusion<'_>> {\n395:     let Kind::Builtin {\n396:         which: Builtin::JsonLines,\n397:         arg,\n398:     } = &program.body.kind\n399:     else {\n400:         return None;\n401:     };\n402:     if !matches!(arg.ty, Type::Stream(_)) {\n403:         return None;\n404:     }\n405:     let mut stages = Vec::new();\n406:     let source = match flatten(arg, program, &mut stages) {\n407:         Base::Inputs => Source::Inputs,\n408:         Base::Lines => Source::Lines,\n409:         Base::Var(_) | Base::Local(_) => {\n410:             unreachable!(\"a program-level stream chain bottoms at its source\")\n411:         }\n412:     };\n413:     Some(Fusion { source, stages })\n414: }\n415: \n416: /// Every enum type the program prints that can hold another of its own type, deduplicated and\n417: /// in the order the walk meets them.\n418: ///\n419: /// A backend writes its printer by expanding a type inline, which is exactly what does not\n420: /// terminate on one of these. So each gets a named function the expansion can call back into\n421: /// instead, and this is the list of functions to write (kantord/toylang#94). Only what is\n422: /// printed: a program can hold a recursive value, match on it and print an Int, and a printer\n423: /// nobody calls is dead code that Go, at least, would then demand an import for.\n424: pub fn printed_recursive_enums(program: &Program) -> Vec<Type> {\n425:     let mut printed = vec![program.body.ty.clone()];\n426:     let mut collect_printed = |t: &Tir| {\n427:         if let Kind::Builtin {\n428:             which: Builtin::JsonLines,\n429:             arg,\n430:         } = &t.kind\n431:         {\n432:             printed.push(\n433:                 runtime_elem(&arg.ty)\n434:                     .expect(\"jsonlines takes a Vec or a stream\")\n435:                     .clone(),\n436:             );\n437:         }\n438:     };\n439:     for f in &program.funcs {\n440:         each_node(&f.body, &mut collect_printed);\n441:     }\n442:     each_node(&program.body, &mut collect_printed);\n443: \n444:     let mut found = Vec::new();\n445:     let mut seen = Vec::new();\n446:     for ty in &printed {\n447:         reachable_enums(&program.enums, ty, &mut seen, &mut found);\n448:     }\n449:     found.retain(|ty| crate::ty::is_recursive(&program.enums, ty));\n450:     found\n451: }\n452: \n453: /// Append every enum type nested anywhere in `ty` to `found`, descending through payloads read\n454: /// from the registry rather than off the type. `seen` is what stops a recursive one: its own\n455: /// payload leads back to a type already visited.\n456: fn reachable_enums(enums: &Enums, ty: &Type, seen: &mut Vec<Type>, found: &mut Vec<Type>) {\n457:     match ty {\n458:         Type::Vec(e) | Type::Stream(e) => reachable_enums(enums, e, seen, found),\n459:         Type::Record(fields) => {\n460:             for (_, f) in fields {\n461:                 reachable_enums(enums, f, seen, found);\n462:             }\n463:         }\n464:         Type::Enum { name, args, .. } => {\n465:             if seen.contains(ty) {\n466:                 return;\n467:             }\n468:             seen.push(ty.clone());\n469:             found.push(ty.clone());\n470:             for arg in args {\n471:                 reachable_enums(enums, arg, seen, found);\n472:             }\n473:             for (_, payload) in crate::ty::variants_of(enums, name, args) {\n474:                 if let Some(p) = payload {\n475:                     reachable_enums(enums, &p, seen, found);\n476:                 }\n477:             }\n478:         }\n479:         _ => {}\n480:     }\n481: }\n482: \n483: /// Every node in the tree, `t` itself included, in no particular order. The backends each walk\n484: /// the tree their own way, gathering what their own target needs; this is for the questions\n485: /// that are the same on every target.\n486: fn each_node(t: &Tir, f: &mut impl FnMut(&Tir)) {\n487:     f(t);\n488:     match &t.kind {\n489:         Kind::Str(_)\n490:         | Kind::Int(_)\n491:         | Kind::Var(_)\n492:         | Kind::Local(_)\n493:         | Kind::Input\n494:         | Kind::Inputs\n495:         | Kind::Lines => {}\n496:         Kind::VecLit(items) => items.iter().for_each(|i| each_node(i, f)),\n497:         Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| each_node(v, f)),\n498:         Kind::EnumLit { payload, .. } => {\n499:             if let Some(p) = payload {\n500:                 each_node(p, f);\n501:             }\n502:         }\n503:         Kind::Call { arg, .. } => {\n504:             if let Some(a) = arg {\n505:                 each_node(a, f);\n506:             }\n507:         }\n508:         Kind::Concat(l, r)\n509:         | Kind::Compare { lhs: l, rhs: r, .. }\n510:         | Kind::Logic { lhs: l, rhs: r, .. }\n511:         | Kind::Arith { lhs: l, rhs: r, .. } => {\n512:             each_node(l, f);\n513:             each_node(r, f);\n514:         }\n515:         Kind::Not(base) => each_node(base, f),\n516:         Kind::Cond {\n517:             cond,\n518:             then,\n519:             otherwise,\n520:         } => {\n521:             each_node(cond, f);\n522:             each_node(then, f);\n523:             each_node(otherwise, f);\n524:         }\n525:         Kind::Bind { value, body, .. } => {\n526:             each_node(value, f);\n527:             each_node(body, f);\n528:         }\n529:         Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n530:             each_node(source, f);\n531:             each_node(body, f);\n532:         }\n533:         Kind::Select { source, pred, .. } => {\n534:             each_node(source, f);\n535:             each_node(pred, f);\n536:         }\n537:         Kind::Field { base, .. } | Kind::Unwrap { base } => each_node(base, f),\n538:         Kind::Builtin { arg, .. } => each_node(arg, f),\n539:         Kind::Index { base, index, .. } => {\n540:             each_node(base, f);\n541:             each_node(index, f);\n542:         }\n543:         Kind::Match { subject, arms, .. } => {\n544:             each_node(subject, f);\n545:             for arm in arms {\n546:                 if let Some(g) = &arm.guard {\n547:                     each_node(g, f);\n548:                 }\n549:                 each_node(&arm.body, f);\n550:             }\n551:         }\n552:     }\n553: }\n\n(End of file - total 553 lines)\n</content>","metadata":{"preview":"//! The typed IR the backends consume.\n//!\n//! Every node carries the type it was checked at, so a backend never has to ask what a value is\n//! at runtime and never has to look a type up in a table beside the tree. A static target cannot\n//! work from anything less: it has to know that an add is an integer add before it can emit one.\n//!\n//! Names are deliberately *not* mangled here. Which identifiers are reserved is a property of\n//! the target, not of toylang, so each backend renders these as it needs to.\n\nuse crate::ast::{BinOp, LogicOp};\nuse crate::ty::{Enums, Type};\n\npub struct Tir {\n    pub ty: Type,\n    pub kind: Kind,\n}\n\nimpl Tir {\n    pub fn new(ty: Type, kind: Kind) -> Tir {\n        Tir { ty, kind }","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-149/src/tir.rs","text":"//! The typed IR the backends consume.\n//!\n//! Every node carries the type it was checked at, so a backend never has to ask what a value is\n//! at runtime and never has to look a type up in a table beside the tree. A static target cannot\n//! work from anything less: it has to know that an add is an integer add before it can emit one.\n//!\n//! Names are deliberately *not* mangled here. Which identifiers are reserved is a property of\n//! the target, not of toylang, so each backend renders these as it needs to.\n\nuse crate::ast::{BinOp, LogicOp};\nuse crate::ty::{Enums, Type};\n\npub struct Tir {\n    pub ty: Type,\n    pub kind: Kind,\n}\n\nimpl Tir {\n    pub fn new(ty: Type, kind: Kind) -> Tir {\n        Tir { ty, kind }\n    }\n}\n\n/// A binding the source cannot name, introduced for `|` and for `select`'s parameter.\npub type LocalId = u32;\n\npub enum Kind {\n    Str(String),\n    Int(i64),\n    VecLit(Vec<Tir>),\n    /// A record literal, its fields in declaration order so a field's position here matches\n    /// its position in the type. That is what lets a backend address one by index rather than\n    /// searching for it.\n    RecordLit {\n        fields: Vec<(String, Tir)>,\n    },\n    /// A constructed enum value. The node's type is the enum, so a backend finds the variant's\n    /// position (its tag, where one is needed) and its payload type by asking `ty::variants`\n    /// for that type's list rather than by carrying either here. `payload` is `None` for a unit\n    /// variant, which every backend renders as the bare variant-name string; a payload variant\n    /// is the single-key wrapper (ADR 0009).\n    EnumLit {\n        variant: String,\n        payload: Option<Box<Tir>>,\n    },\n    /// Rebuilds an Opt: present-preserving, absent-preserving. `body` runs with `param` bound\n    /// to the unwrapped payload only when `source` is present; an absent `source` passes\n    /// through untouched. Never surface syntax -- Opt has no general map or match a program can\n    /// reach (kantord/toylang#47's totality round owns that) -- this is only how the checker's\n    /// own reorder pass reaches inside an Opt payload (kantord/toylang#66): every other enum\n    /// reorders through `Match`/`EnumLit`, but Opt keeps a representation of its own in three\n    /// backends, so those two general nodes cannot reach it.\n    OptMap {\n        source: Box<Tir>,\n        param: LocalId,\n        body: Box<Tir>,\n    },\n    /// A name written in the source: today only a function parameter.\n    Var(String),\n    Local(LocalId),\n    /// The value read from stdin.\n    Input,\n    /// Every remaining JSON value on stdin, one per line, eagerly collected into a `Vec<T>`.\n    Inputs,\n    /// The stream of lines read from stdin, read incrementally by whatever consumes it.\n    Lines,\n    Call {\n        func: String,\n        /// `None` for a call to a nullary function.\n        arg: Option<Box<Tir>>,\n    },\n    Concat(Box<Tir>, Box<Tir>),\n    /// Wrapping integer arithmetic, at the width the node's own type names: 32 bits for `Int`,\n    /// 64 for `Int64` (kantord/toylang#83) -- both operands always share it, since nothing\n    /// converts implicitly. Division and remainder stop the program on a zero divisor, which\n    /// is the only way arithmetic can fail.\n    Arith {\n        op: BinOp,\n        lhs: Box<Tir>,\n        rhs: Box<Tir>,\n    },\n    /// The condition is exactly one Bool, which is what turns jq's run-both-branches behaviour\n    /// into a type error here.\n    Cond {\n        cond: Box<Tir>,\n        then: Box<Tir>,\n        otherwise: Box<Tir>,\n    },\n    Compare {\n        op: BinOp,\n        lhs: Box<Tir>,\n        rhs: Box<Tir>,\n    },\n    /// `and` / `or` over two Bools, short-circuiting: `rhs` is evaluated only when `lhs` leaves\n    /// the answer open. That is not a nicety here -- division and `!` can stop the program, so\n    /// whether the right side runs is observable -- which is why every backend emits its own\n    /// short-circuiting operator rather than two evaluated operands combined afterwards.\n    Logic {\n        op: LogicOp,\n        lhs: Box<Tir>,\n        rhs: Box<Tir>,\n    },\n    /// `not b`.\n    Not(Box<Tir>),\n    /// `let local = value in body`, which is what `|` becomes once `.` has a name.\n    Bind {\n        local: LocalId,\n        value: Box<Tir>,\n        body: Box<Tir>,\n    },\n    /// Every element replaced by `body`, with `param` bound to each. Same loop as Select, kept\n    /// separate because the result's element type is the body's rather than the source's.\n    Map {\n        source: Box<Tir>,\n        param: LocalId,\n        body: Box<Tir>,\n    },\n    Select {\n        source: Box<Tir>,\n        param: LocalId,\n        pred: Box<Tir>,\n    },\n    /// Read `name` off `base`. How many Vec layers to descend through is `base.ty`'s doing and\n    /// is not stored, so it cannot disagree with the type.\n    Field {\n        base: Box<Tir>,\n        name: String,\n    },\n    /// Collapse one dimension of `base` at `index`, `depth` layers down.\n    ///\n    /// Unlike a field access this has to store its depth. A field access leaves a record behind,\n    /// so the depth is every Vec layer of the base; an index leaves a Vec behind, so the layers\n    /// below the one being collapsed are indistinguishable from the ones above it.\n    /// A unary builtin. Unary like every other function, so it needs no special call form.\n    Builtin {\n        which: Builtin,\n        arg: Box<Tir>,\n    },\n    /// Insist an Opt is present, `depth` layers down. Like a field access and unlike an index,\n    /// the depth is every Vec layer of the base, because an Opt is not a dimension.\n    Unwrap {\n        base: Box<Tir>,\n    },\n    Index {\n        base: Box<Tir>,\n        index: Box<Tir>,\n        depth: usize,\n        /// Whether an entry is a record, which decides if collapsing has to gather columns.\n        elem_is_record: bool,\n    },\n    /// First-match-wins dispatch over the subject: variant arms test its shape, guard arms\n    /// evaluate a Bool of their own. The checker has already resolved every name a pattern\n    /// bound, so an arm is only a test, a payload local to bind, and a body.\n    ///\n    /// When the chain is total (`partial` is false) -- every variant covered, or a default at\n    /// the end -- a backend may take the last arm without a test. A partial chain has no such\n    /// arm: every test is emitted, and falling off the end produces the absent `Opt`, which is\n    /// why the node's type is then `Opt` of the arms' common body type.\n    Match {\n        subject: Box<Tir>,\n        arms: Vec<MatchArm>,\n        partial: bool,\n    },\n}\n\npub struct MatchArm {\n    /// `Some` tests the subject for this variant. `None` with a `guard` is a guard arm; `None`\n    /// with no guard is the default arm, which the checker keeps last.\n    pub variant: Option<String>,\n    /// The Bool deciding a guard arm, already checked in the subject's scope.\n    pub guard: Option<Tir>,\n    /// The local the payload binds to in a payload-variant arm; `.` and destructured field\n    /// names in the body both read through it.\n    pub payload: Option<LocalId>,\n    pub body: Tir,\n}\n\n/// The functions the language provides. Each is unary, and so is every user function: something\n/// wanting two arguments takes a record, which is what a record literal is for in argument\n/// position.\n#[derive(Clone, Copy, PartialEq, Eq)]\npub enum Builtin {\n    /// `str(n)`, rendering an Int the way the printer does but reachable from a program.\n    IntToStr,\n    /// `i64(n)`, `Int -> Int64`: the one bridge between the two integer types, explicit\n    /// because nothing widens implicitly (kantord/toylang#83). A no-op on every backend whose\n    /// runtime integers are already 64 bits wide; JS builds a BigInt, and Go and Rust spell\n    /// the cast.\n    IntToI64,\n    /// `range(n)`, the integers from zero up to but not including n. Zero-based, matching jq,\n    /// Python, and this language's own indices.\n    Range,\n    /// `collect(s)`, `Stream<T> -> Vec<T>`: the one place a stream stops being a stream. What\n    /// comes back is an ordinary value, exactly as sized as it needs to be, with no trace left\n    /// of how it arrived.\n    Collect,\n    /// `jsonlines(v)`, printing each element of a `Vec<T>` on its own line rather than wrapping\n    /// the whole thing in `[...]`. Named for the format (jsonlines.org, also called NDJSON):\n    /// one JSON value per line. Polymorphic over the element type, so it is not in the fixed\n    /// signature table `builtin()` reads from; `synth` checks it directly, the way `map` and\n    /// `select` are checked from their own arm rather than through a table.\n    JsonLines,\n    /// `length(v)`, a Vec's length. A dense Vec already tracks this at runtime, so reading it out\n    /// costs nothing -- there is no fold or scan hiding behind the name.\n    Length,\n    /// `flatten(vv)`, flattening a `Vec<Vec<T>>` into one `Vec<T>`, for the case where the\n    /// number of inner Vecs is not known at the call site. Joining a fixed, known count of Vecs\n    /// is `+` instead (kantord/toylang#97, the add-trait reading of Q2 in plans/questions.md); this\n    /// builtin used to be named `concat` and cover both cases before that split.\n    Flatten,\n    /// `tail(v)`, every element but the first, `None` when `v` is empty. Consistent with how\n    /// `Index` already turns \"reaching past what's there\" into `Opt` rather than a runtime\n    /// failure.\n    Tail,\n    /// `fields(r)`, a record's field names in declaration order (kantord/toylang#63, the\n    /// accessor #60's ratification promised once order left type identity). The names come from\n    /// `r`'s checked type, not its runtime value, so every backend can emit them as a literal;\n    /// `r` is still evaluated for whatever it would otherwise do, the same as any other argument.\n    Fields,\n    /// `chars(s)`, `Str -> Vec<Char>`: every Unicode scalar value in `s`, in order. Decoded by\n    /// codepoint on every backend, so a character outside the Basic Multilingual Plane is one\n    /// element here even on a target whose own strings need a surrogate pair to spell it\n    /// (kantord/toylang#75).\n    Chars,\n    /// `sort(v)`, `Vec<T> -> Vec<T>`: `v`'s elements in ascending order by the same total order\n    /// `<` already gives `T`. One value in, one value out with no lawful Stream instance\n    /// (kantord/toylang#86, Q20 in plans/questions.md), so it is checked as a Vec-only builtin the way\n    /// `length`/`tail`/`flatten` are rather than through `select`/`map`'s cardinality\n    /// polymorphism. Restricted to the element types ordering already typechecks on --\n    /// Int, Int64, Str, Char -- so every backend can reach for its native ordering.\n    Sort,\n    /// `reverse(v)`, `Vec<T> -> Vec<T>`: `v`'s elements in the opposite order. Blocking for the\n    /// same reason `sort` is (the whole Vec has to be there before the first output element\n    /// is), but unrestricted in element type, since reversing needs no comparison.\n    Reverse,\n}\n\npub struct Func {\n    pub name: String,\n    /// `None` for a nullary function.\n    pub param: Option<String>,\n    pub param_ty: Option<Type>,\n    pub body: Tir,\n}\n\npub struct Program {\n    pub funcs: Vec<Func>,\n    pub body: Tir,\n    /// The type stdin must have, if the program reads it.\n    pub input: Option<Type>,\n    /// The element type each line of stdin parses as, if the program reads `inputs`.\n    pub inputs: Option<Type>,\n    /// Whether the program reads `lines`. A separate flag from `input`, since the two are\n    /// unrelated readers of the same real stdin and a program using `lines` alone still needs\n    /// it connected, even though `input` is `None`.\n    pub uses_lines: bool,\n    /// Every enum the program declared, the prelude's included. A backend has no checker `Ctx`\n    /// to hand, and the variant list on a `Type::Enum` is a placeholder wherever a recursive\n    /// enum's payload reaches back to itself, so this travels with the tree: it is what\n    /// `ty::variants` re-derives from (kantord/toylang#94).\n    pub enums: Enums,\n}\n\n/// The element type a backend iterates over. Under eager lowering a stream is materialized as\n/// the Vec of its entries, so a Stream's element counts exactly as a Vec's here; the checker's\n/// `Type::elem` deliberately does not agree, keeping the reducers Vec-only at the surface.\npub fn runtime_elem(ty: &Type) -> Option<&Type> {\n    match ty {\n        Type::Vec(t) | Type::Stream(t) => Some(t),\n        _ => None,\n    }\n}\n\n/// How many dimension layers wrap a scalar -- `Vec`s, plus the outermost `Stream` when there\n/// is one. Field access distributes over each of them.\npub fn vec_depth(ty: &Type) -> usize {\n    let mut depth = 0;\n    let mut inner = ty;\n    while let Some(elem) = runtime_elem(inner) {\n        depth += 1;\n        inner = elem;\n    }\n    depth\n}\n\n/// One `map`/`select` applied between reading a record and printing it, in source order (the\n/// stage nearest the source first).\npub enum Stage<'a> {\n    Map { param: LocalId, body: &'a Tir },\n    Select { param: LocalId, pred: &'a Tir },\n}\n\n/// What a fused loop reads one entry at a time: parsed JSON values, or raw lines.\n#[derive(Clone, Copy, PartialEq, Eq)]\npub enum Source {\n    Inputs,\n    Lines,\n}\n\n/// A stream-typed pipeline ending in `jsonlines`, compiled as a read-one/transform-one/\n/// write-one loop. Decided by the types, not by a structural guess: the old `recognize_fusion`\n/// pattern match retired when `Stream` entered the type grammar (plans/streams.md step 5), so\n/// whether a program streams is now exactly whether its types say so.\npub struct Fusion<'a> {\n    pub source: Source,\n    pub stages: Vec<Stage<'a>>,\n}\n\n/// What a stream chain bottoms out at: a source, a function's own parameter, or the local a\n/// `|` bound.\nenum Base<'a> {\n    Inputs,\n    Lines,\n    Var(&'a String),\n    Local(LocalId),\n}\n\n/// Append the per-element stages of the stream-typed `t`, returning what its chain bottoms out\n/// at.\n///\n/// Total, not a recognizer: the checker leaves exactly these kinds able to carry a Stream type\n/// (sources, bindings, mappers, calls -- a conditional or match yielding one is refused, and\n/// projection is normalized to a Map), so the `unreachable!` arms are compiler bugs, never\n/// program shapes. That is the invariant this step lands: a stream-typed program that failed\n/// to fuse would silently materialize stdin, which is the defect the feature exists to remove.\nfn flatten<'a>(t: &'a Tir, program: &'a Program, stages: &mut Vec<Stage<'a>>) -> Base<'a> {\n    match &t.kind {\n        Kind::Inputs => Base::Inputs,\n        Kind::Lines => Base::Lines,\n        Kind::Var(name) => Base::Var(name),\n        Kind::Local(id) => Base::Local(*id),\n        Kind::Bind { local, value, body } => {\n            let base = flatten(value, program, stages);\n            match flatten(body, program, stages) {\n                Base::Local(id) if id == *local => base,\n                _ => unreachable!(\"a piped stream is consumed by the pipe's own body\"),\n            }\n        }\n        Kind::Map {\n            source,\n            param,\n            body,\n        } => {\n            let base = flatten(source, program, stages);\n            stages.push(Stage::Map {\n                param: *param,\n                body,\n            });\n            base\n        }\n        Kind::Select {\n            source,\n            param,\n            pred,\n        } => {\n            let base = flatten(source, program, stages);\n            stages.push(Stage::Select {\n                param: *param,\n                pred,\n            });\n            base\n        }\n        // The argument's stages first, then the callee's body inlined: its chain bottoms at\n        // its own parameter (a stream-returning function must take a stream, and linearity\n        // makes the parameter the base of whatever it returns).\n        Kind::Call { func, arg } => {\n            let f = program\n                .funcs\n                .iter()\n                .find(|f| &f.name == func)\n                .expect(\"the checker resolved every call\");\n            // A stream-returning function must take a stream (see `signatures`), so a call\n            // reaching here -- one whose result is stream-typed -- always carries an argument.\n            let arg = arg\n                .as_deref()\n                .expect(\"a stream-returning function is never nullary\");\n            let base = flatten(arg, program, stages);\n            let param = f\n                .param\n                .as_deref()\n                .expect(\"a stream-returning function is never nullary\");\n            match flatten(&f.body, program, stages) {\n                Base::Var(name) if name == param => base,\n                _ => unreachable!(\"a stream-returning function's chain bottoms at its parameter\"),\n            }\n        }\n        _ => unreachable!(\"the checker leaves no other kind stream-typed\"),\n    }\n}\n\n/// The type question `streams_inputs` used to answer by pattern match: a `jsonlines` program\n/// whose argument is stream-typed fuses, and one whose argument is a Vec (already collected)\n/// stays an ordinary value and runs eagerly, exactly as its types say.\npub fn fusion(program: &Program) -> Option<Fusion<'_>> {\n    let Kind::Builtin {\n        which: Builtin::JsonLines,\n        arg,\n    } = &program.body.kind\n    else {\n        return None;\n    };\n    if !matches!(arg.ty, Type::Stream(_)) {\n        return None;\n    }\n    let mut stages = Vec::new();\n    let source = match flatten(arg, program, &mut stages) {\n        Base::Inputs => Source::Inputs,\n        Base::Lines => Source::Lines,\n        Base::Var(_) | Base::Local(_) => {\n            unreachable!(\"a program-level stream chain bottoms at its source\")\n        }\n    };\n    Some(Fusion { source, stages })\n}\n\n/// Every enum type the program prints that can hold another of its own type, deduplicated and\n/// in the order the walk meets them.\n///\n/// A backend writes its printer by expanding a type inline, which is exactly what does not\n/// terminate on one of these. So each gets a named function the expansion can call back into\n/// instead, and this is the list of functions to write (kantord/toylang#94). Only what is\n/// printed: a program can hold a recursive value, match on it and print an Int, and a printer\n/// nobody calls is dead code that Go, at least, would then demand an import for.\npub fn printed_recursive_enums(program: &Program) -> Vec<Type> {\n    let mut printed = vec![program.body.ty.clone()];\n    let mut collect_printed = |t: &Tir| {\n        if let Kind::Builtin {\n            which: Builtin::JsonLines,\n            arg,\n        } = &t.kind\n        {\n            printed.push(\n                runtime_elem(&arg.ty)\n                    .expect(\"jsonlines takes a Vec or a stream\")\n                    .clone(),\n            );\n        }\n    };\n    for f in &program.funcs {\n        each_node(&f.body, &mut collect_printed);\n    }\n    each_node(&program.body, &mut collect_printed);\n\n    let mut found = Vec::new();\n    let mut seen = Vec::new();\n    for ty in &printed {\n        reachable_enums(&program.enums, ty, &mut seen, &mut found);\n    }\n    found.retain(|ty| crate::ty::is_recursive(&program.enums, ty));\n    found\n}\n\n/// Append every enum type nested anywhere in `ty` to `found`, descending through payloads read\n/// from the registry rather than off the type. `seen` is what stops a recursive one: its own\n/// payload leads back to a type already visited.\nfn reachable_enums(enums: &Enums, ty: &Type, seen: &mut Vec<Type>, found: &mut Vec<Type>) {\n    match ty {\n        Type::Vec(e) | Type::Stream(e) => reachable_enums(enums, e, seen, found),\n        Type::Record(fields) => {\n            for (_, f) in fields {\n                reachable_enums(enums, f, seen, found);\n            }\n        }\n        Type::Enum { name, args, .. } => {\n            if seen.contains(ty) {\n                return;\n            }\n            seen.push(ty.clone());\n            found.push(ty.clone());\n            for arg in args {\n                reachable_enums(enums, arg, seen, found);\n            }\n            for (_, payload) in crate::ty::variants_of(enums, name, args) {\n                if let Some(p) = payload {\n                    reachable_enums(enums, &p, seen, found);\n                }\n            }\n        }\n        _ => {}\n    }\n}\n\n/// Every node in the tree, `t` itself included, in no particular order. The backends each walk\n/// the tree their own way, gathering what their own target needs; this is for the questions\n/// that are the same on every target.\nfn each_node(t: &Tir, f: &mut impl FnMut(&Tir)) {\n    f(t);\n    match &t.kind {\n        Kind::Str(_)\n        | Kind::Int(_)\n        | Kind::Var(_)\n        | Kind::Local(_)\n        | Kind::Input\n        | Kind::Inputs\n        | Kind::Lines => {}\n        Kind::VecLit(items) => items.iter().for_each(|i| each_node(i, f)),\n        Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| each_node(v, f)),\n        Kind::EnumLit { payload, .. } => {\n            if let Some(p) = payload {\n                each_node(p, f);\n            }\n        }\n        Kind::Call { arg, .. } => {\n            if let Some(a) = arg {\n                each_node(a, f);\n            }\n        }\n        Kind::Concat(l, r)\n        | Kind::Compare { lhs: l, rhs: r, .. }\n        | Kind::Logic { lhs: l, rhs: r, .. }\n        | Kind::Arith { lhs: l, rhs: r, .. } => {\n            each_node(l, f);\n            each_node(r, f);\n        }\n        Kind::Not(base) => each_node(base, f),\n        Kind::Cond {\n            cond,\n            then,\n            otherwise,\n        } => {\n            each_node(cond, f);\n            each_node(then, f);\n            each_node(otherwise, f);\n        }\n        Kind::Bind { value, body, .. } => {\n            each_node(value, f);\n            each_node(body, f);\n        }\n        Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n            each_node(source, f);\n            each_node(body, f);\n        }\n        Kind::Select { source, pred, .. } => {\n            each_node(source, f);\n            each_node(pred, f);\n        }\n        Kind::Field { base, .. } | Kind::Unwrap { base } => each_node(base, f),\n        Kind::Builtin { arg, .. } => each_node(arg, f),\n        Kind::Index { base, index, .. } => {\n            each_node(base, f);\n            each_node(index, f);\n        }\n        Kind::Match { subject, arms, .. } => {\n            each_node(subject, f);\n            for arm in arms {\n                if let Some(g) = &arm.guard {\n                    each_node(g, f);\n                }\n                each_node(&arm.body, f);\n            }\n        }\n    }\n}","lineStart":1,"lineEnd":553,"totalLines":553,"truncated":false}},"title":"src/tir.rs","time":{"start":1788120641667,"end":1788120641673}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now I understand the parsing. Float literals need to be parsed. Currently only `Tok::Int(i64)` and `Expr::Int`. Let me look at ast.rs, tir.rs, and the check/types.rs.","format":"unknown","index":0}]}},"id":"prt_0544baeb70011zuToVXLo3HDOk","sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","messageID":"msg_0544ba93d001H7kelD2ihT1UNH"}}
