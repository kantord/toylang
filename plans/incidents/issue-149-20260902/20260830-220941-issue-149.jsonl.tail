{"type":"step_start","timestamp":1788120711665,"sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","part":{"id":"prt_0544cc1ec0015U8T0IVxMrbORD","messageID":"msg_0544bcd58001EoHPuuUyxUXpQO","sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","snapshot":"94b6040ffbb3d9f05c4638216dc44bf3958c7c09","type":"step-start"}}
{"type":"tool_use","timestamp":1788120711965,"sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-8e1f29fb7b7719d8","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-149/src/check/mod.rs","offset":1308},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-149/src/check/mod.rs</path>\n<type>file</type>\n<content>\n1308:             {\n1309:                 let fty = payload_ty\n1310:                     .field(name)\n1311:                     .expect(\"the field existed when the pattern was checked\")\n1312:                     .clone();\n1313:                 let base = Tir::new(payload_ty.clone(), Kind::Local(*pid));\n1314:                 return Ok(Tir::new(\n1315:                     fty,\n1316:                     Kind::Field {\n1317:                         base: Box::new(base),\n1318:                         name: name.clone(),\n1319:                     },\n1320:                 ));\n1321:             }\n1322:             if let Some((_, t)) = ctx.scope.iter().find(|(n, _)| n == name) {\n1323:                 return Ok(Tir::new(t.clone(), Kind::Var(name.clone())));\n1324:             }\n1325:             if let Some(owners) = ctx.variant_owners.get(name) {\n1326:                 let enum_ty = sole_owner(ctx, name, owners, *span)?.clone();\n1327:                 return construct(ctx, &enum_ty, name, *span, None, None);\n1328:             }\n1329:             // A function is not a value, but \"`f` is not defined\" for a defined function is a\n1330:             // lie. This is where `f -1` lands: `-` cannot start a bare argument, so the parse\n1331:             // is subtraction and `f` arrives here alone.\n1332:             if ctx.sigs.contains_key(name) || BUILTIN_NAMES.contains(&name.as_str()) {\n1333:                 return Err(Error::new(\n1334:                     *span,\n1335:                     format!(\"`{name}` is a function, not a value; write `{name}(...)` to call it\"),\n1336:                 ));\n1337:             }\n1338:             Err(Error::new(*span, format!(\"`{name}` is not defined\")))\n1339:         }\n1340: \n1341:         Expr::RecordLit { fields, .. } => {\n1342:             let mut built: Vec<(String, Tir)> = Vec::new();\n1343:             for (name, name_span, value) in fields {\n1344:                 if built.iter().any(|(seen, _)| seen == name) {\n1345:                     return Err(Error::new(\n1346:                         *name_span,\n1347:                         format!(\"field `{name}` is given twice\"),\n1348:                     ));\n1349:                 }\n1350:                 let field = synth(ctx, value)?;\n1351:                 // A stream can never enter a record: a record's fields can be printed, copied,\n1352:                 // and read back out by name, none of which make sense for a single-use stream,\n1353:                 // and no path exists for a stream-typed field to leave one again once inside.\n1354:                 if field.ty.contains_stream() {\n1355:                     return Err(Error::new(\n1356:                         value.span(),\n1357:                         format!(\"`{name}` cannot hold a stream, which has nothing to store\"),\n1358:                     ));\n1359:                 }\n1360:                 built.push((name.clone(), field));\n1361:             }\n1362:             // Declaration order, kept as written: the type's field list and this literal's\n1363:             // fields stay index-for-index aligned, which is what the columnar backends key on.\n1364:             let ty = Type::Record(\n1365:                 built\n1366:                     .iter()\n1367:                     .map(|(n, t)| (n.clone(), t.ty.clone()))\n1368:                     .collect(),\n1369:             );\n1370:             Ok(Tir::new(ty, Kind::RecordLit { fields: built }))\n1371:         }\n1372: \n1373:         Expr::VecLit { items, span } => {\n1374:             let Some(first) = items.first() else {\n1375:                 // Nothing says what an empty literal contains, and there is no expected type to\n1376:                 // supply it. Guessing here is what the annotation rule exists to avoid.\n1377:                 return Err(Error::new(*span, \"cannot tell what `[]` contains\"));\n1378:             };\n1379:             let head = synth(ctx, first)?;\n1380:             let elem = head.ty.clone();\n1381:             // Same reasoning as a record field: nothing can get a stream back out of a Vec\n1382:             // once it is in one, and a Vec of them makes no sense when there is only ever one\n1383:             // real stdin to begin with.\n1384:             if elem.contains_stream() {\n1385:                 return Err(Error::new(\n1386:                     first.span(),\n1387:                     \"a Vec cannot hold a stream, which has nothing to store\".to_string(),\n1388:                 ));\n1389:             }\n1390:             let mut out = vec![head];\n1391:             for item in &items[1..] {\n1392:                 out.push(expect(ctx, item, &elem)?);\n1393:             }\n1394:             Ok(Tir::new(Type::Vec(Box::new(elem)), Kind::VecLit(out)))\n1395:         }\n1396: \n1397:         Expr::Pipe { lhs, rhs, .. } => match pipe(ctx, lhs, rhs, None)? {\n1398:             Expected::Checked(tir) | Expected::Synthesised(tir) => Ok(tir),\n1399:         },\n1400: \n1401:         Expr::Field { .. } | Expr::Index { .. } | Expr::Unwrap { .. } => {\n1402:             let Access { tir, stream, .. } = access(ctx, expr)?;\n1403:             // Projection over a stream is a mapper, and it is normalized to one here: the chain\n1404:             // is rebased onto a fresh per-element param, so neither the backends nor fusion\n1405:             // ever see a Field, Index, or Unwrap whose base is stream-typed.\n1406:             if stream {\n1407:                 let param = ctx.fresh();\n1408:                 let Rebased { body, source } = rebase(tir, param);\n1409:                 return Ok(Tir::new(\n1410:                     Type::Stream(Box::new(body.ty.clone())),\n1411:                     Kind::Map {\n1412:                         source: Box::new(source),\n1413:                         param,\n1414:                         body: Box::new(body),\n1415:                     },\n1416:                 ));\n1417:             }\n1418:             Ok(tir)\n1419:         }\n1420: \n1421:         // `v[]` with nothing after it is the identity: \"keep every entry\" is what a Vec (or\n1422:         // stream) already is, with no field/index/unwrap left to distribute across it.\n1423:         Expr::Project { .. } => {\n1424:             let access = access(ctx, expr)?;\n1425:             Ok(access.tir)\n1426:         }\n1427: \n1428:         // `input` names one value, so its first checked use fixes the type for the whole\n1429:         // program -- and a later use in a position that expects nothing can borrow what the\n1430:         // first use fixed. With no use typed yet, nothing says what it contains, and guessing\n1431:         // is what the annotation rule avoids.\n1432:         Expr::Input { span } => match ctx.input.borrow().as_ref() {\n1433:             Some(ty) => Ok(Tir::new(ty.clone(), Kind::Input)),\n1434:             None => Err(Error::new(*span, \"cannot tell what `input` contains\")),\n1435:         },\n1436:         Expr::Inputs { span } => match ctx.in_fn {\n1437:             Some(func) => Err(source_in_fn(*span, \"inputs\", func)),\n1438:             None => Err(Error::new(*span, \"cannot tell what `inputs` contains\")),\n1439:         },\n1440: \n1441:         Expr::Call {\n1442:             func,\n1443:             func_span,\n1444:             arg,\n1445:             span,\n1446:         } => call(ctx, func, *func_span, arg, *span),\n1447: \n1448:         Expr::Match { arms, span } => match_chain(ctx, arms, *span, None),\n1449: \n1450:         Expr::Variant {\n1451:             enum_name,\n1452:             enum_span,\n1453:             variant,\n1454:             variant_span,\n1455:             payload,\n1456:             ..\n1457:         } => {\n1458:             let Some(enum_ty) = ctx.enums.get(enum_name) else {\n1459:                 return Err(Error::new(\n1460:                     *enum_span,\n1461:                     format!(\"`{enum_name}` is not an enum\"),\n1462:                 ));\n1463:             };\n1464:             construct(\n1465:                 ctx,\n1466:                 &enum_ty.clone(),\n1467:                 variant,\n1468:                 *variant_span,\n1469:                 payload.as_deref(),\n1470:                 None,\n1471:             )\n1472:         }\n1473: \n1474:         Expr::Neg { base, span } => {\n1475:             // A minus directly on a literal is part of the literal, so the most negative Int can\n1476:             // be written even though its magnitude is one past the most positive. This is the\n1477:             // rule Rust uses, and it is why `-` was not folded into the lexer: `a -1` has to\n1478:             // stay `a - 1`.\n1479:             if let Expr::Int { value, span: lit } = base.as_ref() {\n1480:                 if *value > -(i32::MIN as i64) {\n1481:                     return Err(Error::new(\n1482:                         *lit,\n1483:                         format!(\n1484:                             \"integer `-{value}` does not fit in Int, which is 32 bits; only a \\\n1485:                              position that expects Int64 can hold it\"\n1486:                         ),\n1487:                     ));\n1488:                 }\n1489:                 return Ok(Tir::new(Type::Int, Kind::Int(-value)));\n1490:             }\n1491:             // Synthesise first, so `-x` works at whichever integer width `x` already has; a\n1492:             // form that can only be checked (`-input` fixing input to Int) falls back to the\n1493:             // Int expectation this arm always applied.\n1494:             let inner = match synth(ctx, base) {\n1495:                 Ok(inner) if matches!(inner.ty, Type::Int | Type::Int64) => inner,\n1496:                 Ok(inner) => {\n1497:                     return Err(Error::new(\n1498:                         base.span(),\n1499:                         format!(\"expected Int, found {}\", inner.ty),\n1500:                     ));\n1501:                 }\n1502:                 Err(_) => expect(ctx, base, &Type::Int)?,\n1503:             };\n1504:             let width = inner.ty.clone();\n1505:             let zero = Tir::new(width.clone(), Kind::Int(0));\n1506:             let _ = span;\n1507:             Ok(Tir::new(\n1508:                 width,\n1509:                 Kind::Arith {\n1510:                     op: BinOp::Sub,\n1511:                     lhs: Box::new(zero),\n1512:                     rhs: Box::new(inner),\n1513:                 },\n1514:             ))\n1515:         }\n1516: \n1517:         // The first construct that consumes a type rather than carrying one: the condition has\n1518:         // to be exactly one Bool, and both branches have to agree.\n1519:         Expr::Cond {\n1520:             then,\n1521:             cond,\n1522:             otherwise,\n1523:             ..\n1524:         } => {\n1525:             let cond = expect(ctx, cond, &Type::Bool)?;\n1526:             let then = synth(ctx, then)?;\n1527:             // A pipeline's shape must be knowable at compile time for fusion to emit its loop,\n1528:             // and a branch chosen at runtime is exactly what that excludes. Refusing is the\n1529:             // reversible direction; lifting it later breaks nothing.\n1530:             if then.ty.contains_stream() {\n1531:                 return Err(Error::new(\n1532:                     expr.span(),\n1533:                     \"a conditional cannot yield a stream; pass each branch to `collect` first\"\n1534:                         .to_string(),\n1535:                 ));\n1536:             }\n1537:             let otherwise = expect(ctx, otherwise, &then.ty)?;\n1538:             Ok(Tir::new(\n1539:                 then.ty.clone(),\n1540:                 Kind::Cond {\n1541:                     cond: Box::new(cond),\n1542:                     then: Box::new(then),\n1543:                     otherwise: Box::new(otherwise),\n1544:                 },\n1545:             ))\n1546:         }\n1547: \n1548:         Expr::Binary { op, lhs, rhs, .. } => binary(ctx, *op, lhs, rhs),\n1549: \n1550:         // The connectives are the one place a subexpression may go unevaluated: `and` runs its\n1551:         // right side only when the left is true, `or` only when it is false. Nothing here has\n1552:         // to say so -- every backend emits its own short-circuiting operator -- but it is why\n1553:         // `x != 0 and 10 / x > 1` is a program and not a division by zero.\n1554:         Expr::Logic { op, lhs, rhs, .. } => {\n1555:             let lhs = expect(ctx, lhs, &Type::Bool)?;\n1556:             let rhs = expect(ctx, rhs, &Type::Bool)?;\n1557:             Ok(Tir::new(\n1558:                 Type::Bool,\n1559:                 Kind::Logic {\n1560:                     op: *op,\n1561:                     lhs: Box::new(lhs),\n1562:                     rhs: Box::new(rhs),\n1563:                 },\n1564:             ))\n1565:         }\n1566: \n1567:         Expr::Not { base, .. } => {\n1568:             let base = expect(ctx, base, &Type::Bool)?;\n1569:             Ok(Tir::new(Type::Bool, Kind::Not(Box::new(base))))\n1570:         }\n1571:     }\n1572: }\n1573: \n1574: /// `synth`'s `Expr::Call` arm, pulled out on its own: a call is one of `select`/`map` (special\n1575: /// forms rebinding `.`), a fixed sink or polymorphic builtin, or an ordinary user function or\n1576: /// payload-constructor lookup, each with its own argument shape to check.\n1577: fn call(\n1578:     ctx: &Ctx,\n1579:     func: &str,\n1580:     func_span: Span,\n1581:     arg: &Option<Box<Expr>>,\n1582:     span: Span,\n1583: ) -> Result<Tir, Error> {\n1584:     // `select` and `map` are not special syntax, only special names: they are ordinary calls\n1585:     // whose argument is checked with `.` rebound to the subject's element type instead of\n1586:     // evaluated in the enclosing scope, which no ordinary function needs and is why they cannot\n1587:     // be defined as one (see `signatures`).\n1588:     if func == \"select\" {\n1589:         return select_call(ctx, need_arg(arg, func, span)?, span);\n1590:     }\n1591:     // The one way to produce a new element value. `select` removes elements and a field access\n1592:     // reads a field; neither can turn a Vec<Int> into a Vec<Str>.\n1593:     if func == \"map\" {\n1594:         return map_call(ctx, need_arg(arg, func, span)?, span, None);\n1595:     }\n1596:     // A sink, not a function: `check` handles the one legal position (the program's outermost\n1597:     // expression) before `synth` ever runs, so reaching it here means it is nested inside\n1598:     // something that would need its result -- and it has none. The old `Str` typing was a\n1599:     // placeholder asserting the opposite of what the fused loop does (a type claiming the whole\n1600:     // output exists as one value).\n1601:     if func == \"jsonlines\" {\n1602:         return Err(Error::new(\n1603:             span,\n1604:             \"`jsonlines` is a sink, legal only as the program's outermost expression\".to_string(),\n1605:         ));\n1606:     }\n1607:     // `length`, `tail`, and `flatten` are polymorphic over the element type, the same reason\n1608:     // `jsonlines` is checked here rather than through `builtin()`'s fixed table.\n1609:     if func == \"length\" {\n1610:         return length_call(ctx, need_arg(arg, func, span)?);\n1611:     }\n1612:     // `None` on an empty Vec, the same way `Index` turns reaching past what's there into `Opt`\n1613:     // rather than a runtime failure.\n1614:     if func == \"tail\" {\n1615:         return tail_call(ctx, need_arg(arg, func, span)?);\n1616:     }\n1617:     // Flattens a Vec<Vec<T>> into a Vec<T>, the way jq's `add` flattens a list of arrays.\n1618:     // Joining a fixed, known count of Vecs is `+` (kantord/toylang#97); this is for when the\n1619:     // outer Vec's length is not known at the call site.\n1620:     if func == \"flatten\" {\n1621:         return flatten_call(ctx, need_arg(arg, func, span)?);\n1622:     }\n1623:     // The one exit a stream has: `Stream<T> -> Vec<T>`, polymorphic over the element type like\n1624:     // `length` and the others above, so the argument is synthesised first.\n1625:     if func == \"collect\" {\n1626:         return collect(ctx, need_arg(arg, func, span)?, None);\n1627:     }\n1628:     // Polymorphic over which record, the same reason `length` is checked here: the return type\n1629:     // (`Vec<Str>`) is fixed, but the argument's shape is not.\n1630:     if func == \"fields\" {\n1631:         return fields_call(ctx, need_arg(arg, func, span)?);\n1632:     }\n1633:     // Blocking, one Vec in and one Vec out with no Stream instance (kantord/toylang#86, Q20 in\n1634:     // draft.md), so both are checked here rather than through `select`'s subject-context\n1635:     // mechanism.\n1636:     if func == \"sort\" {\n1637:         return sort_call(ctx, need_arg(arg, func, span)?);\n1638:     }\n1639:     if func == \"reverse\" {\n1640:         return reverse_call(ctx, need_arg(arg, func, span)?);\n1641:     }\n1642:     if let Some((which, sig)) = builtin(func) {\n1643:         let param_ty = sig\n1644:             .param\n1645:             .as_ref()\n1646:             .expect(\"every builtin in the fixed table is unary\");\n1647:         let arg = expect(ctx, need_arg(arg, func, span)?, param_ty)?;\n1648:         return Ok(Tir::new(\n1649:             sig.ret,\n1650:             Kind::Builtin {\n1651:                 which,\n1652:                 arg: Box::new(arg),\n1653:             },\n1654:         ));\n1655:     }\n1656:     let Some(sig) = ctx.sigs.get(func) else {\n1657:         // A payload constructor is ordinary application (the Q34 path), so `circle{r: 1}` lands\n1658:         // here; it resolves as a variant only after the function namespace declines.\n1659:         if let Some(owners) = ctx.variant_owners.get(func) {\n1660:             let enum_ty = sole_owner(ctx, func, owners, func_span)?.clone();\n1661:             return construct(ctx, &enum_ty, func, func_span, arg.as_deref(), None);\n1662:         }\n1663:         return Err(Error::new(func_span, format!(\"`{func}` is not a function\")));\n1664:     };\n1665:     let arg = call_arg(ctx, func, span, &sig.param, arg)?;\n1666:     Ok(Tir::new(\n1667:         sig.ret.clone(),\n1668:         Kind::Call {\n1669:             func: func.to_string(),\n1670:             arg,\n1671:         },\n1672:     ))\n1673: }\n1674: \n1675: /// A user function's argument against its (optionally nullary) signature: the four arity/type\n1676: /// combinations a call and a signature can be in relative to each other.\n1677: fn call_arg(\n1678:     ctx: &Ctx,\n1679:     func: &str,\n1680:     span: Span,\n1681:     param_ty: &Option<Type>,\n1682:     arg: &Option<Box<Expr>>,\n1683: ) -> Result<Option<Box<Tir>>, Error> {\n1684:     match (param_ty, arg) {\n1685:         (Some(param_ty), Some(arg)) => Ok(Some(Box::new(expect(ctx, arg, param_ty)?))),\n1686:         (None, None) => Ok(None),\n1687:         (Some(param_ty), None) => Err(Error::new(\n1688:             span,\n1689:             format!(\"`{func}` needs an argument of {param_ty}, but was called with none\"),\n1690:         )),\n1691:         (None, Some(arg)) => Err(Error::new(\n1692:             arg.span(),\n1693:             format!(\"`{func}` takes no argument\"),\n1694:         )),\n1695:     }\n1696: }\n1697: \n1698: /// Cardinality-polymorphic: the same subject-context mechanism types `select` over a Vec and\n1699: /// over a Stream, with the element drawn from either's parameter. Stream in, stream out.\n1700: fn select_call(ctx: &Ctx, arg: &Expr, span: Span) -> Result<Tir, Error> {\n1701:     let Some((subject, id)) = ctx.subject.clone() else {\n1702:         return Err(Error::new(\n1703:             span,\n1704:             \"`select` needs a subject, so it must follow `|`\",\n1705:         ));\n1706:     };\n1707:     let Some(elem) = mapper_elem(&subject) else {\n1708:         return Err(Error::new(\n1709:             span,\n1710:             format!(\"`select` needs a Vec or a stream, found {subject}\"),\n1711:         ));\n1712:     };\n1713:     let param = ctx.fresh();\n1714:     let inner = mapper_ctx(ctx, elem, param);\n1715:     let pred = expect(&inner, arg, &Type::Bool)?;\n1716:     let source = Tir::new(subject.clone(), Kind::Local(id));\n1717:     Ok(Tir::new(\n1718:         subject,\n1719:         Kind::Select {\n1720:             source: Box::new(source),\n1721:             param,\n1722:             pred: Box::new(pred),\n1723:         },\n1724:     ))\n1725: }\n1726: \n1727: fn length_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n1728:     let arg_span = arg.span();\n1729:     let arg = synth(ctx, arg)?;\n1730:     if arg.ty.elem().is_none() {\n1731:         return Err(Error::new(\n1732:             arg_span,\n1733:             format!(\"`length` needs a Vec, found {}\", arg.ty),\n1734:         ));\n1735:     }\n1736:     Ok(Tir::new(\n1737:         Type::Int,\n1738:         Kind::Builtin {\n1739:             which: tir::Builtin::Length,\n1740:             arg: Box::new(arg),\n1741:         },\n1742:     ))\n1743: }\n1744: \n1745: /// `fields(r)`, the declared names of `r`'s fields in the order its type carries them\n1746: /// (kantord/toylang#60: that order is metadata, not part of the type's identity, but it is\n1747: /// exactly the order this reads off). A record's field set is closed, so this needs no runtime\n1748: /// support once checked: every backend can bake the names in as a literal.\n1749: fn fields_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n1750:     let arg_span = arg.span();\n1751:     let arg = synth(ctx, arg)?;\n1752:     if !matches!(arg.ty, Type::Record(_)) {\n1753:         return Err(Error::new(\n1754:             arg_span,\n1755:             format!(\"`fields` needs a record, found {}\", arg.ty),\n1756:         ));\n1757:     }\n1758:     Ok(Tir::new(\n1759:         Type::Vec(Box::new(Type::Str)),\n1760:         Kind::Builtin {\n1761:             which: tir::Builtin::Fields,\n1762:             arg: Box::new(arg),\n1763:         },\n1764:     ))\n1765: }\n1766: \n1767: /// `None` on an empty Vec, the same way `Index` turns reaching past what's there into `Opt`\n1768: /// rather than a runtime failure.\n1769: fn tail_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n1770:     let arg_span = arg.span();\n1771:     let arg = synth(ctx, arg)?;\n1772:     let Some(elem) = arg.ty.elem().cloned() else {\n1773:         return Err(Error::new(\n1774:             arg_span,\n1775:             format!(\"`tail` needs a Vec, found {}\", arg.ty),\n1776:         ));\n1777:     };\n1778:     Ok(Tir::new(\n1779:         opt_of(ctx, Type::Vec(Box::new(elem))),\n1780:         Kind::Builtin {\n1781:             which: tir::Builtin::Tail,\n1782:             arg: Box::new(arg),\n1783:         },\n1784:     ))\n1785: }\n1786: \n1787: /// Flattens a Vec<Vec<T>> into a Vec<T>, the way jq's `add` flattens a list of arrays.\n1788: fn flatten_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n1789:     let arg_span = arg.span();\n1790:     let arg = synth(ctx, arg)?;\n1791:     let inner = arg.ty.elem().cloned();\n1792:     let Some(elem) = inner.as_ref().and_then(Type::elem).cloned() else {\n1793:         return Err(Error::new(\n1794:             arg_span,\n1795:             format!(\"`flatten` needs a Vec of Vecs, found {}\", arg.ty),\n1796:         ));\n1797:     };\n1798:     Ok(Tir::new(\n1799:         Type::Vec(Box::new(elem)),\n1800:         Kind::Builtin {\n1801:             which: tir::Builtin::Flatten,\n1802:             arg: Box::new(arg),\n1803:         },\n1804:     ))\n1805: }\n1806: \n1807: /// The element types ordering comparisons (`<`, `<=`, `>`, `>=`) already typecheck on --\n1808: /// documented on each of their own reference pages, and what `sort` restricts itself to rather\n1809: /// than reaching past what every backend can already order natively.\n1810: fn orderable(ty: &Type) -> bool {\n1811:     matches!(ty, Type::Int | Type::Int64 | Type::Str | Type::Char)\n1812: }\n1813: \n1814: /// `sort(v)`, ascending by the total order `<` already gives `v`'s element type\n1815: /// (kantord/toylang#86). Restricted to `orderable` element types rather than the same\n1816: /// `expect(ctx, rhs, &left.ty)` equality `binary`'s comparison branch accepts more broadly, so\n1817: /// this never asks a backend to order a Record or an Enum.\n1818: fn sort_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n1819:     let arg_span = arg.span();\n1820:     let arg = synth(ctx, arg)?;\n1821:     let Some(elem) = arg.ty.elem() else {\n1822:         return Err(Error::new(\n1823:             arg_span,\n1824:             format!(\"`sort` needs a Vec, found {}\", arg.ty),\n1825:         ));\n1826:     };\n1827:     if !orderable(elem) {\n1828:         return Err(Error::new(\n1829:             arg_span,\n1830:             format!(\n1831:                 \"`sort` needs a Vec of Int, Int64, Str, or Char, found {}\",\n1832:                 arg.ty\n1833:             ),\n1834:         ));\n1835:     }\n1836:     let ty = arg.ty.clone();\n1837:     Ok(Tir::new(\n1838:         ty,\n1839:         Kind::Builtin {\n1840:             which: tir::Builtin::Sort,\n1841:             arg: Box::new(arg),\n1842:         },\n1843:     ))\n1844: }\n1845: \n1846: /// `reverse(v)`, `v`'s elements in the opposite order. Unlike `sort`, no comparison is needed,\n1847: /// so every element type is accepted.\n1848: fn reverse_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n1849:     let arg_span = arg.span();\n1850:     let arg = synth(ctx, arg)?;\n1851:     if arg.ty.elem().is_none() {\n1852:         return Err(Error::new(\n1853:             arg_span,\n1854:             format!(\"`reverse` needs a Vec, found {}\", arg.ty),\n1855:         ));\n1856:     }\n1857:     let ty = arg.ty.clone();\n1858:     Ok(Tir::new(\n1859:         ty,\n1860:         Kind::Builtin {\n1861:             which: tir::Builtin::Reverse,\n1862:             arg: Box::new(arg),\n1863:         },\n1864:     ))\n1865: }\n1866: \n1867: /// Walk an access chain left to right, carrying what we are currently looking at and how many\n1868: /// dimensions we are inside.\n1869: ///\n1870: /// Every dimension needs a spec. `[]` enters one, so it strips a layer off what we are looking at\n1871: /// and adds one to the depth; a field access reads a field of it and leaves the depth alone.\n1872: /// The expression's type is what we are looking at, wrapped back up that many times.\n1873: ///\n1874: /// This is why `db.users.name` is an error and `db.users[].name` is not: the first never said\n1875: /// what happens to the dimension it reached through.\n1876: ///\n1877: /// A Stream is one more dimension `[]` can enter -- projection is a mapper -- and since the\n1878: /// grammar keeps a stream strictly outermost, the walk only has to remember one bit: whether\n1879: /// the first-stripped layer was a Stream (`stream_outer`), so wrapping back up restores a\n1880: /// Stream there and a Vec everywhere below.\n1881: struct Access {\n1882:     tir: Tir,\n1883:     /// What the chain currently evaluates to, one dimension down: a field access reads this, a\n1884:     /// further `[]` strips a layer off it.\n1885:     elem: Type,\n1886:     /// How many dimensions the chain is inside.\n1887:     depth: usize,\n1888:     /// Whether the first-stripped layer was a Stream rather than a Vec.\n1889:     stream: bool,\n1890: }\n1891: \n1892: impl Access {\n1893:     fn new(tir: Tir, elem: Type, depth: usize, stream: bool) -> Access {\n1894:         Access {\n1895:             tir,\n1896:             elem,\n1897:             depth,\n1898:             stream,\n1899:         }\n1900:     }\n1901: }\n1902: \n1903: fn access(ctx: &Ctx, expr: &Expr) -> Result<Access, Error> {\n1904:     /// `elem`, wrapped back up under every dimension the chain is inside.\n1905:     fn wrap(mut ty: Type, depth: usize, stream_outer: bool) -> Type {\n1906:         for i in 0..depth {\n1907:             ty = if stream_outer && i == depth - 1 {\n1908:                 Type::Stream(Box::new(ty))\n1909:             } else {\n1910:                 Type::Vec(Box::new(ty))\n1911:             };\n1912:         }\n1913:         ty\n1914:     }\n1915: \n1916:     match expr {\n1917:         Expr::Project { base, span } => {\n1918:             let b = access(ctx, base)?;\n1919:             if let Type::Stream(inner) = &b.elem {\n1920:                 return Ok(Access::new(b.tir, (**inner).clone(), b.depth + 1, true));\n1921:             }\n1922:             let Some(inner) = b.elem.elem().cloned() else {\n1923:                 return Err(Error::new(\n1924:                     *span,\n1925:                     format!(\"`[]` needs a dimension, found {}\", b.elem),\n1926:                 ));\n1927:             };\n1928:             Ok(Access::new(b.tir, inner, b.depth + 1, b.stream))\n1929:         }\n1930: \n1931:         // The absence stops being carried and starts being asserted.\n1932:         Expr::Unwrap { base, span } => {\n1933:             let b = access(ctx, base)?;\n1934:             let Some(inner) = b.elem.as_opt() else {\n1935:                 return Err(Error::new(\n1936:                     *span,\n1937:                     format!(\"`!` needs an Opt, found {}\", b.elem),\n1938:                 ));\n1939:             };\n1940:             let ty = wrap(inner.clone(), b.depth, b.stream);\n1941:             let tir = Tir::new(\n1942:                 ty,\n1943:                 Kind::Unwrap {\n1944:                     base: Box::new(b.tir),\n1945:                 },\n1946:             );\n1947:             Ok(Access::new(tir, inner.clone(), b.depth, b.stream))\n1948:         }\n1949: \n1950:         // Collapsing a dimension. The entry may not be there, so what comes out is `Opt`.\n1951:         Expr::Index { base, index, span } => {\n1952:             let b = access(ctx, base)?;\n1953:             let Some(inner) = b.elem.elem().cloned() else {\n1954:                 return Err(Error::new(\n1955:                     *span,\n1956:                     format!(\"`[i]` needs a dimension, found {}\", b.elem),\n1957:                 ));\n1958:             };\n1959:             let index_tir = expect(ctx, index, &Type::Int)?;\n1960:             let elem_is_record = matches!(inner, Type::Record(_));\n1961:             let out = opt_of(ctx, inner);\n1962:             let ty = wrap(out.clone(), b.depth, b.stream);\n1963:             let kind = Kind::Index {\n1964:                 base: Box::new(b.tir),\n1965:                 index: Box::new(index_tir),\n1966:                 depth: b.depth,\n1967:                 elem_is_record,\n1968:             };\n1969:             Ok(Access::new(Tir::new(ty, kind), out, b.depth, b.stream))\n1970:         }\n1971: \n1972:         Expr::Field { base, name, span } => {\n1973:             let b = access(ctx, base)?;\n1974:             if b.elem.elem().is_some() || matches!(b.elem, Type::Stream(_)) {\n1975:                 return Err(Error::new(\n1976:                     *span,\n1977:                     format!(\n1978:                         \"`.{name}` needs a record, found {}: give the dimension a spec with `[]`\",\n1979:                         b.elem\n1980:                     ),\n1981:                 ));\n1982:             }\n1983:             let Some(field) = b.elem.field(name).cloned() else {\n1984:                 return Err(Error::new(\n1985:                     *span,\n1986:                     format!(\"no field `{name}` on {}\", b.elem),\n1987:                 ));\n1988:             };\n1989:             let ty = wrap(field.clone(), b.depth, b.stream);\n1990:             let kind = Kind::Field {\n1991:                 base: Box::new(b.tir),\n1992:                 name: name.clone(),\n1993:             };\n1994:             Ok(Access::new(Tir::new(ty, kind), field, b.depth, b.stream))\n1995:         }\n1996: \n1997:         other => {\n1998:             let tir = synth(ctx, other)?;\n1999:             let ty = tir.ty.clone();\n2000:             Ok(Access::new(tir, ty, 0, false))\n2001:         }\n2002:     }\n2003: }\n2004: \n2005: /// A literal (or a minus on one, or a negation) met by an Int64 expectation: literals carry\n2006: /// no suffix, so the position is the only thing that can say which width one has\n2007: /// (kantord/toylang#83), the `[]` rule applied to numbers. A minus directly on a literal is\n2008: /// part of the literal, as for Int, so the whole written range short of\n2009: /// `-9223372036854775808` is reachable (the parser refuses `9223372036854775808` before the\n2010: /// minus could claim it, the same edge Rust's own i64 literals have). `None` for any other\n2011: /// form -- or any other `want` -- which falls through to `expect_inner`'s remaining arms.\n2012: fn int64_resolved(ctx: &Ctx, expr: &Expr, want: &Type) -> Option<Result<Tir, Error>> {\n2013:     if *want != Type::Int64 {\n2014:         return None;\n2015:     }\n2016:     match expr {\n2017:         Expr::Int { value, .. } => Some(Ok(Tir::new(Type::Int64, Kind::Int(*value)))),\n2018:         Expr::Neg { base, .. } => {\n2019:             if let Expr::Int { value, .. } = base.as_ref() {\n2020:                 return Some(Ok(Tir::new(Type::Int64, Kind::Int(-value))));\n2021:             }\n2022:             let inner = match expect(ctx, base, &Type::Int64) {\n2023:                 Ok(inner) => inner,\n2024:                 Err(e) => return Some(Err(e)),\n2025:             };\n2026:             let zero = Tir::new(Type::Int64, Kind::Int(0));\n2027:             Some(Ok(Tir::new(\n2028:                 Type::Int64,\n2029:                 Kind::Arith {\n2030:                     op: BinOp::Sub,\n2031:                     lhs: Box::new(zero),\n2032:                     rhs: Box::new(inner),\n2033:                 },\n2034:             )))\n2035:         }\n2036:         _ => None,\n2037:     }\n2038: }\n2039: \n2040: /// An arithmetic operand checked at the width the other side fixed, with the type mismatch\n2041: /// upgraded to name the bridge when the two integer types met: \"expected Int, found Int64\" is\n2042: /// true but leaves the reader to discover `i64` on their own. The re-synthesis in the error\n2043: /// path mirrors `stream_refusal`'s.\n2044: fn expect_int_width(ctx: &Ctx, rhs: &Expr, width: &Type, op: BinOp) -> Result<Tir, Error> {\n2045:     expect(ctx, rhs, width).map_err(|err| {\n2046:         let Ok(found) = synth(ctx, rhs) else {\n2047:             return err;\n2048:         };\n2049:         match (width, &found.ty) {\n2050:             (Type::Int, Type::Int64) => Error::new(\n2051:                 rhs.span(),\n2052:                 format!(\"`{op}` cannot mix Int and Int64; widen the Int side with `i64(...)`\"),\n2053:             ),\n2054:             (Type::Int64, Type::Int) => Error::new(\n2055:                 rhs.span(),\n2056:                 format!(\"`{op}` cannot mix Int64 and Int; widen the Int side with `i64(...)`\"),\n2057:             ),\n2058:             _ => err,\n2059:         }\n2060:     })\n2061: }\n2062: \n2063: fn binary(ctx: &Ctx, op: BinOp, lhs: &Expr, rhs: &Expr) -> Result<Tir, Error> {\n2064:     let left = synth(ctx, lhs)?;\n2065: \n2066:     // Q2 is open, so an operator over a Vec is rejected rather than being silently given\n2067:     // broadcast or zip semantics. Under C1 that restriction is ordinary typing: there is no\n2068:     // separate cardinality to check, because a Vec is just a type. `+` is the one exception:\n2069:     // it concatenates two Vecs of the same type now (kantord/toylang#97, the add-trait\n2070:     // reading), which settles that half of Q2 without deciding what any other operator means\n2071:     // over two Vecs.\n2072:     if left.ty.elem().is_some() && op != BinOp::Add {\n2073:         return Err(Error::new(\n2074:             lhs.span(),\n2075:             format!(\"`{op}` does not apply to {}\", left.ty),\n2076:         ));\n2077:     }\n2078: \n2079:     if op.is_comparison() {\n2080:         // A Vec one level down is the same open question a bare one is. `==` on a record whose\n2081:         // field is a Vec would have to answer whether that field compares as a whole value or\n2082:         // broadcasts, which is Q2, so structural equality stops at the first Vec rather than\n2083:         // settling it silently (kantord/toylang#95). The bare case is already gone above; this\n2084:         // catches the composite that carries one.\n2085:         if left.ty.contains_vec() {\n2086:             return Err(Error::new(\n2087:                 lhs.span(),\n2088:                 format!(\"`{op}` does not apply to {}\", left.ty),\n2089:             ));\n2090:         }\n2091: \n2092:         // Comparison never crosses the integer widths either: the sides must already agree,\n2093:         // and the mismatch names `i64` the same way arithmetic's does.\n2094:         if matches!(left.ty, Type::Int | Type::Int64) {\n2095:             let right = expect_int_width(ctx, rhs, &left.ty, op)?;\n2096:             return Ok(Tir::new(\n2097:                 Type::Bool,\n2098:                 Kind::Compare {\n2099:                     op,\n2100:                     lhs: Box::new(left),\n2101:                     rhs: Box::new(right),\n2102:                 },\n2103:             ));\n2104:         }\n2105:         let right = match expect(ctx, rhs, &left.ty) {\n2106:             Ok(right) => right,\n2107:             Err(err) => {\n2108:                 // Postfix `!` next to `!=` merges into one token: `x!=y` lexes as `!=`, not\n2109:                 // `x! == y`. Once the plain comparison has failed, Opt<T> against its own\n2110:                 // element is specific enough to name the likely cause instead of just the\n2111:                 // type mismatch.\n2112:                 if op == BinOp::Ne\n2113:                     && let Some(inner) = left.ty.as_opt().cloned()\n2114:                     && expect(ctx, rhs, &inner).is_ok()\n2115:                 {\n2116:                     return Err(Error::new(\n2117:                         rhs.span(),\n2118:                         format!(\n2119:                             \"expected {}, found {inner}: `!` and `=` read as one token \\\n2120:                              here (`!=`); did you mean `! ==`?\",\n2121:                             left.ty\n2122:                         ),\n2123:                     ));\n2124:                 }\n2125:                 return Err(err);\n2126:             }\n2127:         };\n2128:         return Ok(Tir::new(\n2129:             Type::Bool,\n2130:             Kind::Compare {\n2131:                 op,\n2132:                 lhs: Box::new(left),\n2133:                 rhs: Box::new(right),\n2134:             },\n2135:         ));\n2136:     }\n2137: \n2138:     if op.is_arithmetic() {\n2139:         if !matches!(left.ty, Type::Int | Type::Int64) {\n2140:             return Err(Error::new(\n2141:                 lhs.span(),\n2142:                 format!(\"expected Int or Int64, found {}\", left.ty),\n2143:             ));\n2144:         }\n2145:         // Both sides share the left's width: nothing widens implicitly (kantord/toylang#83),\n2146:         // so an Int meeting an Int64 is an error naming the bridge rather than a silent\n2147:         // promotion -- and a bare literal on the right resolves at whichever width the left\n2148:         // already has, since `expect_inner` types a literal by its position.\n2149:         let width = left.ty.clone();\n2150:         let right = expect_int_width(ctx, rhs, &width, op)?;\n2151:         return Ok(Tir::new(\n2152:             width,\n2153:             Kind::Arith {\n2154:                 op,\n2155:                 lhs: Box::new(left),\n2156:                 rhs: Box::new(right),\n2157:             },\n2158:         ));\n2159:     }\n2160: \n2161:     plus(ctx, lhs, left, rhs)\n2162: }\n2163: \n2164: /// `+` is the one operator whose meaning depends on its operands: addition on Int or Int64,\n2165: /// concatenation on Str, and concatenation on Vec (kantord/toylang#97, the add-trait reading)\n2166: /// when both sides are the same Vec type. Nothing is coerced, so all three still require both\n2167: /// sides to agree.\n2168: fn plus(ctx: &Ctx, lhs: &Expr, left: Tir, rhs: &Expr) -> Result<Tir, Error> {\n2169:     match &left.ty {\n2170:         Type::Int | Type::Int64 => {\n2171:             let width = left.ty.clone();\n2172:             let right = expect_int_width(ctx, rhs, &width, BinOp::Add)?;\n2173:             let kind = Kind::Arith {\n2174:                 op: BinOp::Add,\n2175:                 lhs: Box::new(left),\n2176:                 rhs: Box::new(right),\n2177:             };\n2178:             Ok(Tir::new(width, kind))\n2179:         }\n2180:         Type::Str => {\n2181:             let right = expect(ctx, rhs, &Type::Str)?;\n2182:             Ok(Tir::new(\n2183:                 Type::Str,\n2184:                 Kind::Concat(Box::new(left), Box::new(right)),\n2185:             ))\n2186:         }\n2187:         Type::Vec(_) => {\n2188:             let want = left.ty.clone();\n2189:             let right = expect(ctx, rhs, &want)?;\n2190:             Ok(Tir::new(\n2191:                 want,\n2192:                 Kind::Concat(Box::new(left), Box::new(right)),\n2193:             ))\n2194:         }\n2195:         other => Err(Error::new(\n2196:             lhs.span(),\n2197:             format!(\"`+` needs Int, Str, or Vec, found {other}\"),\n2198:         )),\n2199:     }\n2200: }\n2201: \n2202: /// How an expression met an expectation. `Checked` consumed it: the expected type flowed into\n2203: /// the form, and the result is `want`-typed by construction. `Synthesised` means the form\n2204: /// answers for itself, so the expectation resolved nothing and the caller still owns the\n2205: /// comparison -- which is what lets `check` blame a function's signature, by name, when a\n2206: /// body's synthesised type misses its annotation.\n2207: enum Expected {\n2208:     Checked(Tir),\n2209:     Synthesised(Tir),\n2210: }\n2211: \n2212: /// The checking direction: an expected type goes in, and the expression is verified against it\n2213: /// rather than asked what it is. Most forms answer both questions, but not all do.\n2214: fn expect(ctx: &Ctx, expr: &Expr, want: &Type) -> Result<Tir, Error> {\n2215:     match expect_inner(ctx, expr, want)? {\n2216:         Expected::Checked(tir) => Ok(tir),\n2217:         Expected::Synthesised(found) => {\n2218:             if &found.ty != want {\n2219:                 return Err(Error::new(\n2220:                     expr.span(),\n2221:                     format!(\"expected {want}, found {}\", found.ty),\n2222:                 ));\n2223:             }\n2224:             Ok(reorder_record(ctx, found, want))\n2225:         }\n2226:     }\n2227: }\n2228: \n2229: /// `found`, rebuilt to `want`'s field order when the two already agree (kantord/toylang#60) --\n2230: /// a no-op when they don't, leaving a real mismatch for the caller's own comparison to catch\n2231: /// and name.\n2232: fn conform(ctx: &Ctx, found: Tir, want: &Type) -> Tir {\n2233:     if &found.ty == want {\n2234:         reorder_record(ctx, found, want)\n2235:     } else {\n2236:         found\n2237:     }\n2238: }\n2239: \n2240: /// Whether `a` and `b` are not just the same type (kantord/toylang#60: a record's fields are a\n2241: /// set, not a sequence) but physically identical -- same fields, same order, all the way into\n2242: /// any field that is itself a record. Every non-nominal backend reads a record by name and does\n2243: /// not care; the native backend and the columnar Vec layout read it by position, off whichever\n2244: /// type a value is currently checked against, so a value crossing into a differently-ordered\n2245: /// but equal position needs rebuilding before those readers see it. This is what decides\n2246: /// whether that rebuild is needed.\n2247: ///\n2248: /// Also recurses into an enum's variant payloads (kantord/toylang#66): two instantiations of the\n2249: /// same generic enum are one `Type` (`Type::Enum`'s `PartialEq` compares `name` and `args`\n2250: /// only, and a generic argument's own order-insensitivity comes from `Type::Record`'s), so a\n2251: /// payload written in a different field order at each call site is exactly the same hazard a\n2252: /// bare record or a Vec element is. The variant list itself is never out of order -- it comes\n2253: /// from one declaration -- so zipping the two enums' variants positionally is safe, *except*\n2254: /// when one side's list is a recursive self-reference's placeholder (kantord/toylang#76): the\n2255: /// zip then runs zero pairs and this reports \"no reorder needed\" rather than crashing, which is\n2256: /// conservatively correct (nothing gets left mis-ordered that this function could have fixed)\n2257: /// though not necessarily complete (a reorder a full expansion would have found stays undone).\n2258: fn same_field_order(a: &Type, b: &Type) -> bool {\n2259:     match (a, b) {\n2260:         (Type::Record(x), Type::Record(y)) => {\n2261:             x.len() == y.len()\n2262:                 && x.iter()\n2263:                     .zip(y)\n2264:                     .all(|((n1, t1), (n2, t2))| n1 == n2 && same_field_order(t1, t2))\n2265:         }\n2266:         (Type::Vec(x), Type::Vec(y)) | (Type::Stream(x), Type::Stream(y)) => same_field_order(x, y),\n2267:         (Type::Enum { variants: vx, .. }, Type::Enum { variants: vy, .. }) => {\n2268:             vx.iter().zip(vy).all(|((_, px), (_, py))| match (px, py) {\n2269:                 (Some(tx), Some(ty)) => same_field_order(tx, ty),\n2270:                 _ => true,\n2271:             })\n2272:         }\n2273:         _ => true,\n2274:     }\n2275: }\n2276: \n2277: /// Rebuilds `found` -- already known equal to `want` -- so it is physically laid out in\n2278: /// `want`'s field order: a bound local read back out field by field into a fresh literal in\n2279: /// that order, recursing into any field that is itself a differently-ordered record. Also\n2280: /// recurses through a Vec or Stream wrapper, via a real `map` that rebuilds every element --\n2281: /// unlike the record case this is a runtime loop, not a free relabelling, since a Vec's\n2282: /// elements are not reachable one at a time the way a record's fields are (kantord/toylang#64).\n2283: ///\n2284: /// A general enum reorders through `Match`/`EnumLit`: every arm rebuilds its variant with a\n2285: /// freshly reordered payload, which every backend can already run since it is exactly how a\n2286: /// user-written match over that enum already compiles. Opt is the one enum this can't reach\n2287: /// (kantord/toylang#66) -- three backends keep Opt in a representation of their own (`Option<T>`,\n2288: /// `tlOpt[T]{ok,v}`, the null-or-boxed native encoding) rather than the general tagged shape, so\n2289: /// `Match`'s tag-indexed codegen does not apply to it. `OptMap` is the dedicated node every\n2290: /// backend already has the pieces to run: it is exactly the presence branch each one's unwrap\n2291: /// and printer already take, generalised to rebuild the payload instead of rendering it.\n2292: fn reorder_enum(ctx: &Ctx, found: Tir, want: &Type) -> Tir {\n2293:     if let Some(want_inner) = want.as_opt() {\n2294:         let found_inner = found\n2295:             .ty\n2296:             .as_opt()\n2297:             .expect(\"found.ty == want: both Opt\")\n2298:             .clone();\n2299:         let param = ctx.fresh();\n2300:         let body = reorder_record(ctx, Tir::new(found_inner, Kind::Local(param)), want_inner);\n2301:         return Tir::new(\n2302:             want.clone(),\n2303:             Kind::OptMap {\n2304:                 source: Box::new(found),\n2305:                 param,\n2306:                 body: Box::new(body),\n2307:             },\n2308:         );\n2309:     }\n2310:     let Type::Enum {\n2311:         variants: want_variants,\n2312:         ..\n2313:     } = want\n2314:     else {\n2315:         unreachable!(\"reorder_enum is only called with an enum want\")\n2316:     };\n2317:     let found_variants = match &found.ty {\n2318:         Type::Enum { variants, .. } => variants.clone(),\n2319:         _ => unreachable!(\"found.ty == want: both enums\"),\n2320:     };\n2321:     let arms = want_variants\n2322:         .iter()\n2323:         .zip(&found_variants)\n2324:         .map(|((vname, want_payload), (_, found_payload))| {\n2325:             let payload = match (want_payload, found_payload) {\n2326:                 (Some(want_p), Some(found_p)) => {\n2327:                     let pid = ctx.fresh();\n2328:                     let rebuilt =\n2329:                         reorder_record(ctx, Tir::new(found_p.clone(), Kind::Local(pid)), want_p);\n2330:                     (Some(pid), Some(Box::new(rebuilt)))\n2331:                 }\n2332:                 (None, None) => (None, None),\n2333:                 _ => unreachable!(\"found.ty == want: variant shapes line up\"),\n2334:             };\n2335:             tir::MatchArm {\n2336:                 variant: Some(vname.clone()),\n2337:                 guard: None,\n2338:                 payload: payload.0,\n2339:                 body: Tir::new(\n2340:                     want.clone(),\n2341:                     Kind::EnumLit {\n2342:                         variant: vname.clone(),\n2343:                         payload: payload.1,\n2344:                     },\n2345:                 ),\n2346:             }\n2347:         })\n2348:         .collect();\n2349:     Tir::new(\n2350:         want.clone(),\n2351:         Kind::Match {\n2352:             subject: Box::new(found),\n2353:             arms,\n2354:             partial: false,\n2355:         },\n2356:     )\n2357: }\n2358: fn reorder_record(ctx: &Ctx, found: Tir, want: &Type) -> Tir {\n2359:     if same_field_order(&found.ty, want) {\n2360:         return found;\n2361:     }\n2362:     match want {\n2363:         Type::Record(want_fields) => {\n2364:             // A bare local can supply its own fields directly without being bound again: a\n2365:             // Field read reaches through it (a struct-of-arrays cursor, when it is a Vec\n2366:             // element, or an ordinary bound value otherwise) without ever asking for the whole\n2367:             // local as a value, which is what a redundant rebind here would do -- and which\n2368:             // the native backend refuses for a cursor, since a map body's element local is\n2369:             // never materialised as one.\n2370:             if let Kind::Local(local) = found.kind {\n2371:                 return Tir::new(\n2372:                     want.clone(),\n2373:                     Kind::RecordLit {\n2374:                         fields: reorder_fields(ctx, local, &found.ty, want_fields),\n2375:                     },\n2376:                 );\n2377:             }\n2378:             let local = ctx.fresh();\n2379:             let found_ty = found.ty.clone();\n2380:             let fields = reorder_fields(ctx, local, &found_ty, want_fields);\n2381:             Tir::new(\n2382:                 want.clone(),\n2383:                 Kind::Bind {\n2384:                     local,\n2385:                     value: Box::new(found),\n2386:                     body: Box::new(Tir::new(want.clone(), Kind::RecordLit { fields })),\n2387:                 },\n2388:             )\n2389:         }\n2390:         Type::Vec(want_elem) | Type::Stream(want_elem) => {\n2391:             // `found.ty == want` already (the caller's own guard), so its wrapper is the same\n2392:             // kind as `want`'s and `runtime_elem` cannot miss.\n2393:             let elem_ty = tir::runtime_elem(&found.ty)\n2394:                 .expect(\"want is Vec/Stream and found.ty == want\")\n2395:                 .clone();\n2396:             let param = ctx.fresh();\n2397:             let body = reorder_record(ctx, Tir::new(elem_ty, Kind::Local(param)), want_elem);\n2398:             Tir::new(\n2399:                 want.clone(),\n2400:                 Kind::Map {\n2401:                     source: Box::new(found),\n2402:                     param,\n2403:                     body: Box::new(body),\n2404:                 },\n2405:             )\n2406:         }\n2407:         Type::Enum { .. } => reorder_enum(ctx, found, want),\n2408:         _ => found,\n2409:     }\n2410: }\n2411: \n2412: /// `want_fields`, each read off `local` (of type `local_ty`) in `want_fields`'s order, recursing\n2413: /// into any field that is itself a differently-ordered record.\n2414: fn reorder_fields(\n2415:     ctx: &Ctx,\n2416:     local: LocalId,\n2417:     local_ty: &Type,\n2418:     want_fields: &[(String, Type)],\n2419: ) -> Vec<(String, Tir)> {\n2420:     want_fields\n2421:         .iter()\n2422:         .map(|(name, field_ty)| {\n2423:             let access = Tir::new(\n2424:                 field_ty.clone(),\n2425:                 Kind::Field {\n2426:                     base: Box::new(Tir::new(local_ty.clone(), Kind::Local(local))),\n2427:                     name: name.clone(),\n2428:                 },\n2429:             );\n2430:             (name.clone(), reorder_record(ctx, access, field_ty))\n2431:         })\n2432:         .collect()\n2433: }\n2434: \n2435: /// `expect`, minus the final comparison. Each arm here is a form whose type can come from its\n2436: /// position rather than its contents; expectation only ever resolves what synthesis would have\n2437: /// refused -- a form that can synthesise falls through and is compared, never coerced.\n2438: /// `input` against the type its position wants: the first use fills the program-wide slot,\n2439: /// and every later use must agree with it. A signature can spell Stream now, so this position\n2440: /// can ask for one; `input` is a whole value already in hand, which is exactly what a stream\n2441: /// is not.\n2442: fn input_read(ctx: &Ctx, span: Span, want: &Type) -> Result<Tir, Error> {\n2443:     if want.contains_stream() {\n2444:         return Err(Error::new(\n2445:             span,\n2446:             format!(\"`input` is one value read from stdin, but {want} is wanted here\"),\n2447:         ));\n2448:     }\n2449:     // Absence has no ratified wire form: the tag is an in-memory fact, serialization emits\n2450:     // `null` for it going out, and whether `null` coming in reads as `none` is codec design\n2451:     // nobody has done. Refusing is the reversible direction.\n2452:     if want.contains_opt() {\n2453:         return Err(Error::new(\n2454:             span,\n2455:             format!(\"`input` cannot be read as {want}; absence has no wire form to read\"),\n2456:         ));\n2457:     }\n2458:     // A Char is never itself JSON; it only ever comes from decoding a Str already in hand\n2459:     // (`chars`), so there is nothing for a wire value to decode into.\n2460:     if want.contains_char() {\n2461:         return Err(Error::new(\n2462:             span,\n2463:             format!(\"`input` cannot be read as {want}; Char has no wire form to read\"),\n2464:         ));\n2465:     }\n2466:     // One-directional, unlike Char: an Int64 result prints fine, but reading one back is\n2467:     // codec design nobody has done -- JS parses JSON numbers into doubles and is off past\n2468:     // 2^53, and jq computes in them. Refusing is the reversible direction.\n2469:     if want.contains_int64() {\n2470:         return Err(Error::new(\n2471:             span,\n2472:             format!(\n2473:                 \"`input` cannot be read as {want}; how an Int64 crosses the wire is not decided yet\"\n2474:             ),\n2475:         ));\n2476:     }\n2477:     let mut slot = ctx.input.borrow_mut();\n2478:     match slot.as_ref() {\n2479:         None => *slot = Some(want.clone()),\n2480:         Some(prev) if prev != want => {\n2481:             return Err(Error::new(\n2482:                 span,\n2483:                 format!(\"`input` is used as {prev} here and as {want} elsewhere\"),\n2484:             ));\n2485:         }\n2486:         Some(_) => {}\n2487:     }\n2488:     Ok(Tir::new(want.clone(), Kind::Input))\n2489: }\n2490: \n2491: /// `inputs` against the type its position wants, which must be a Stream. The filled slot\n2492: /// doubles as the single-use flag: a second `inputs` would be a second stream claiming the\n2493: /// same real stdin, the same mistake a second `lines` is.\n2494: fn inputs_read(ctx: &Ctx, span: Span, want: &Type) -> Result<Tir, Error> {\n2495:     if let Some(func) = ctx.in_fn {\n2496:         return Err(source_in_fn(span, \"inputs\", func));\n2497:     }\n2498:     if ctx.in_mapper {\n2499:         return Err(Error::new(\n2500:             span,\n2501:             \"`inputs` cannot be read inside a mapper body, which runs once per element\".to_string(),\n2502:         ));\n2503:     }\n2504:     let Type::Stream(elem) = want else {\n2505:         return Err(Error::new(\n2506:             span,\n2507:             format!(\n2508:                 \"`inputs` is a stream, but {want} is wanted here; eager use is spelled \\\n2509:                  `collect(inputs)`\"\n2510:             ),\n2511:         ));\n2512:     };\n2513:     // The same no-wire-form-for-absence rule `input` states above.\n2514:     if elem.contains_opt() {\n2515:         return Err(Error::new(\n2516:             span,\n2517:             format!(\"`inputs` cannot be read as {want}; absence has no wire form to read\"),\n2518:         ));\n2519:     }\n2520:     if elem.contains_char() {\n2521:         return Err(Error::new(\n2522:             span,\n2523:             format!(\"`inputs` cannot be read as {want}; Char has no wire form to read\"),\n2524:         ));\n2525:     }\n2526:     if elem.contains_int64() {\n2527:         return Err(Error::new(\n2528:             span,\n2529:             format!(\n2530:                 \"`inputs` cannot be read as {want}; how an Int64 crosses the wire is not decided yet\"\n2531:             ),\n2532:         ));\n2533:     }\n2534:     let mut slot = ctx.inputs.borrow_mut();\n2535:     if slot.is_some() {\n2536:         return Err(Error::new(\n2537:             span,\n2538:             \"`inputs` has already been read; there is only one stdin\".to_string(),\n2539:         ));\n2540:     }\n2541:     *slot = Some((**elem).clone());\n2542:     Ok(Tir::new(want.clone(), Kind::Inputs))\n2543: }\n2544: \n2545: /// A constructor in a position that wants its enum takes the wanted instantiation: this is\n2546: /// how a generic enum's unit variant -- which alone says nothing about the arguments --\n2547: /// gets built at all (`fn f() -> Pair<Int> = empty`). A bare name only counts when nothing\n2548: /// closer claims it (an arm's field, a local); a call only when no function does. Anything\n2549: /// that is not the wanted enum's variant returns `None` and falls through to synthesis,\n2550: /// which owns the errors.\n2551: fn wanted_variant(ctx: &Ctx, expr: &Expr, want: &Type) -> Option<Result<Tir, Error>> {\n2552:     let Type::Enum { name, args, .. } = want else {\n2553:         return None;\n2554:     };\n2555:     let variants = enum_variants(ctx, name, args);\n2556:     let owns = |n: &str| variants.iter().any(|(vn, _)| vn == n);\n2557:     match expr {\n2558:         Expr::Var { name, span }\n2559:             if owns(name)\n2560:                 && !ctx.arm_fields.iter().any(|(n, ..)| n == name)\n2561:                 && !ctx.scope.iter().any(|(n, _)| n == name) =>\n2562:         {\n2563:             Some(construct(ctx, want, name, *span, None, None))\n2564:         }\n2565:         Expr::Call {\n2566:             func,\n2567:             func_span,\n2568:             arg,\n2569:             ..\n2570:         } if owns(func) && !ctx.sigs.contains_key(func) => {\n\n(Output capped at 50 KB. Showing lines 1308-2570. Use offset=2571 to continue.)\n</content>","metadata":{"preview":"            {\n                let fty = payload_ty\n                    .field(name)\n                    .expect(\"the field existed when the pattern was checked\")\n                    .clone();\n                let base = Tir::new(payload_ty.clone(), Kind::Local(*pid));\n                return Ok(Tir::new(\n                    fty,\n                    Kind::Field {\n                        base: Box::new(base),\n                        name: name.clone(),\n                    },\n                ));\n            }\n            if let Some((_, t)) = ctx.scope.iter().find(|(n, _)| n == name) {\n                return Ok(Tir::new(t.clone(), Kind::Var(name.clone())));\n            }\n            if let Some(owners) = ctx.variant_owners.get(name) {\n                let enum_ty = sole_owner(ctx, name, owners, *span)?.clone();\n                return construct(ctx, &enum_ty, name, *span, None, None);","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-149/src/check/mod.rs","text":"            {\n                let fty = payload_ty\n                    .field(name)\n                    .expect(\"the field existed when the pattern was checked\")\n                    .clone();\n                let base = Tir::new(payload_ty.clone(), Kind::Local(*pid));\n                return Ok(Tir::new(\n                    fty,\n                    Kind::Field {\n                        base: Box::new(base),\n                        name: name.clone(),\n                    },\n                ));\n            }\n            if let Some((_, t)) = ctx.scope.iter().find(|(n, _)| n == name) {\n                return Ok(Tir::new(t.clone(), Kind::Var(name.clone())));\n            }\n            if let Some(owners) = ctx.variant_owners.get(name) {\n                let enum_ty = sole_owner(ctx, name, owners, *span)?.clone();\n                return construct(ctx, &enum_ty, name, *span, None, None);\n            }\n            // A function is not a value, but \"`f` is not defined\" for a defined function is a\n            // lie. This is where `f -1` lands: `-` cannot start a bare argument, so the parse\n            // is subtraction and `f` arrives here alone.\n            if ctx.sigs.contains_key(name) || BUILTIN_NAMES.contains(&name.as_str()) {\n                return Err(Error::new(\n                    *span,\n                    format!(\"`{name}` is a function, not a value; write `{name}(...)` to call it\"),\n                ));\n            }\n            Err(Error::new(*span, format!(\"`{name}` is not defined\")))\n        }\n\n        Expr::RecordLit { fields, .. } => {\n            let mut built: Vec<(String, Tir)> = Vec::new();\n            for (name, name_span, value) in fields {\n                if built.iter().any(|(seen, _)| seen == name) {\n                    return Err(Error::new(\n                        *name_span,\n                        format!(\"field `{name}` is given twice\"),\n                    ));\n                }\n                let field = synth(ctx, value)?;\n                // A stream can never enter a record: a record's fields can be printed, copied,\n                // and read back out by name, none of which make sense for a single-use stream,\n                // and no path exists for a stream-typed field to leave one again once inside.\n                if field.ty.contains_stream() {\n                    return Err(Error::new(\n                        value.span(),\n                        format!(\"`{name}` cannot hold a stream, which has nothing to store\"),\n                    ));\n                }\n                built.push((name.clone(), field));\n            }\n            // Declaration order, kept as written: the type's field list and this literal's\n            // fields stay index-for-index aligned, which is what the columnar backends key on.\n            let ty = Type::Record(\n                built\n                    .iter()\n                    .map(|(n, t)| (n.clone(), t.ty.clone()))\n                    .collect(),\n            );\n            Ok(Tir::new(ty, Kind::RecordLit { fields: built }))\n        }\n\n        Expr::VecLit { items, span } => {\n            let Some(first) = items.first() else {\n                // Nothing says what an empty literal contains, and there is no expected type to\n                // supply it. Guessing here is what the annotation rule exists to avoid.\n                return Err(Error::new(*span, \"cannot tell what `[]` contains\"));\n            };\n            let head = synth(ctx, first)?;\n            let elem = head.ty.clone();\n            // Same reasoning as a record field: nothing can get a stream back out of a Vec\n            // once it is in one, and a Vec of them makes no sense when there is only ever one\n            // real stdin to begin with.\n            if elem.contains_stream() {\n                return Err(Error::new(\n                    first.span(),\n                    \"a Vec cannot hold a stream, which has nothing to store\".to_string(),\n                ));\n            }\n            let mut out = vec![head];\n            for item in &items[1..] {\n                out.push(expect(ctx, item, &elem)?);\n            }\n            Ok(Tir::new(Type::Vec(Box::new(elem)), Kind::VecLit(out)))\n        }\n\n        Expr::Pipe { lhs, rhs, .. } => match pipe(ctx, lhs, rhs, None)? {\n            Expected::Checked(tir) | Expected::Synthesised(tir) => Ok(tir),\n        },\n\n        Expr::Field { .. } | Expr::Index { .. } | Expr::Unwrap { .. } => {\n            let Access { tir, stream, .. } = access(ctx, expr)?;\n            // Projection over a stream is a mapper, and it is normalized to one here: the chain\n            // is rebased onto a fresh per-element param, so neither the backends nor fusion\n            // ever see a Field, Index, or Unwrap whose base is stream-typed.\n            if stream {\n                let param = ctx.fresh();\n                let Rebased { body, source } = rebase(tir, param);\n                return Ok(Tir::new(\n                    Type::Stream(Box::new(body.ty.clone())),\n                    Kind::Map {\n                        source: Box::new(source),\n                        param,\n                        body: Box::new(body),\n                    },\n                ));\n            }\n            Ok(tir)\n        }\n\n        // `v[]` with nothing after it is the identity: \"keep every entry\" is what a Vec (or\n        // stream) already is, with no field/index/unwrap left to distribute across it.\n        Expr::Project { .. } => {\n            let access = access(ctx, expr)?;\n            Ok(access.tir)\n        }\n\n        // `input` names one value, so its first checked use fixes the type for the whole\n        // program -- and a later use in a position that expects nothing can borrow what the\n        // first use fixed. With no use typed yet, nothing says what it contains, and guessing\n        // is what the annotation rule avoids.\n        Expr::Input { span } => match ctx.input.borrow().as_ref() {\n            Some(ty) => Ok(Tir::new(ty.clone(), Kind::Input)),\n            None => Err(Error::new(*span, \"cannot tell what `input` contains\")),\n        },\n        Expr::Inputs { span } => match ctx.in_fn {\n            Some(func) => Err(source_in_fn(*span, \"inputs\", func)),\n            None => Err(Error::new(*span, \"cannot tell what `inputs` contains\")),\n        },\n\n        Expr::Call {\n            func,\n            func_span,\n            arg,\n            span,\n        } => call(ctx, func, *func_span, arg, *span),\n\n        Expr::Match { arms, span } => match_chain(ctx, arms, *span, None),\n\n        Expr::Variant {\n            enum_name,\n            enum_span,\n            variant,\n            variant_span,\n            payload,\n            ..\n        } => {\n            let Some(enum_ty) = ctx.enums.get(enum_name) else {\n                return Err(Error::new(\n                    *enum_span,\n                    format!(\"`{enum_name}` is not an enum\"),\n                ));\n            };\n            construct(\n                ctx,\n                &enum_ty.clone(),\n                variant,\n                *variant_span,\n                payload.as_deref(),\n                None,\n            )\n        }\n\n        Expr::Neg { base, span } => {\n            // A minus directly on a literal is part of the literal, so the most negative Int can\n            // be written even though its magnitude is one past the most positive. This is the\n            // rule Rust uses, and it is why `-` was not folded into the lexer: `a -1` has to\n            // stay `a - 1`.\n            if let Expr::Int { value, span: lit } = base.as_ref() {\n                if *value > -(i32::MIN as i64) {\n                    return Err(Error::new(\n                        *lit,\n                        format!(\n                            \"integer `-{value}` does not fit in Int, which is 32 bits; only a \\\n                             position that expects Int64 can hold it\"\n                        ),\n                    ));\n                }\n                return Ok(Tir::new(Type::Int, Kind::Int(-value)));\n            }\n            // Synthesise first, so `-x` works at whichever integer width `x` already has; a\n            // form that can only be checked (`-input` fixing input to Int) falls back to the\n            // Int expectation this arm always applied.\n            let inner = match synth(ctx, base) {\n                Ok(inner) if matches!(inner.ty, Type::Int | Type::Int64) => inner,\n                Ok(inner) => {\n                    return Err(Error::new(\n                        base.span(),\n                        format!(\"expected Int, found {}\", inner.ty),\n                    ));\n                }\n                Err(_) => expect(ctx, base, &Type::Int)?,\n            };\n            let width = inner.ty.clone();\n            let zero = Tir::new(width.clone(), Kind::Int(0));\n            let _ = span;\n            Ok(Tir::new(\n                width,\n                Kind::Arith {\n                    op: BinOp::Sub,\n                    lhs: Box::new(zero),\n                    rhs: Box::new(inner),\n                },\n            ))\n        }\n\n        // The first construct that consumes a type rather than carrying one: the condition has\n        // to be exactly one Bool, and both branches have to agree.\n        Expr::Cond {\n            then,\n            cond,\n            otherwise,\n            ..\n        } => {\n            let cond = expect(ctx, cond, &Type::Bool)?;\n            let then = synth(ctx, then)?;\n            // A pipeline's shape must be knowable at compile time for fusion to emit its loop,\n            // and a branch chosen at runtime is exactly what that excludes. Refusing is the\n            // reversible direction; lifting it later breaks nothing.\n            if then.ty.contains_stream() {\n                return Err(Error::new(\n                    expr.span(),\n                    \"a conditional cannot yield a stream; pass each branch to `collect` first\"\n                        .to_string(),\n                ));\n            }\n            let otherwise = expect(ctx, otherwise, &then.ty)?;\n            Ok(Tir::new(\n                then.ty.clone(),\n                Kind::Cond {\n                    cond: Box::new(cond),\n                    then: Box::new(then),\n                    otherwise: Box::new(otherwise),\n                },\n            ))\n        }\n\n        Expr::Binary { op, lhs, rhs, .. } => binary(ctx, *op, lhs, rhs),\n\n        // The connectives are the one place a subexpression may go unevaluated: `and` runs its\n        // right side only when the left is true, `or` only when it is false. Nothing here has\n        // to say so -- every backend emits its own short-circuiting operator -- but it is why\n        // `x != 0 and 10 / x > 1` is a program and not a division by zero.\n        Expr::Logic { op, lhs, rhs, .. } => {\n            let lhs = expect(ctx, lhs, &Type::Bool)?;\n            let rhs = expect(ctx, rhs, &Type::Bool)?;\n            Ok(Tir::new(\n                Type::Bool,\n                Kind::Logic {\n                    op: *op,\n                    lhs: Box::new(lhs),\n                    rhs: Box::new(rhs),\n                },\n            ))\n        }\n\n        Expr::Not { base, .. } => {\n            let base = expect(ctx, base, &Type::Bool)?;\n            Ok(Tir::new(Type::Bool, Kind::Not(Box::new(base))))\n        }\n    }\n}\n\n/// `synth`'s `Expr::Call` arm, pulled out on its own: a call is one of `select`/`map` (special\n/// forms rebinding `.`), a fixed sink or polymorphic builtin, or an ordinary user function or\n/// payload-constructor lookup, each with its own argument shape to check.\nfn call(\n    ctx: &Ctx,\n    func: &str,\n    func_span: Span,\n    arg: &Option<Box<Expr>>,\n    span: Span,\n) -> Result<Tir, Error> {\n    // `select` and `map` are not special syntax, only special names: they are ordinary calls\n    // whose argument is checked with `.` rebound to the subject's element type instead of\n    // evaluated in the enclosing scope, which no ordinary function needs and is why they cannot\n    // be defined as one (see `signatures`).\n    if func == \"select\" {\n        return select_call(ctx, need_arg(arg, func, span)?, span);\n    }\n    // The one way to produce a new element value. `select` removes elements and a field access\n    // reads a field; neither can turn a Vec<Int> into a Vec<Str>.\n    if func == \"map\" {\n        return map_call(ctx, need_arg(arg, func, span)?, span, None);\n    }\n    // A sink, not a function: `check` handles the one legal position (the program's outermost\n    // expression) before `synth` ever runs, so reaching it here means it is nested inside\n    // something that would need its result -- and it has none. The old `Str` typing was a\n    // placeholder asserting the opposite of what the fused loop does (a type claiming the whole\n    // output exists as one value).\n    if func == \"jsonlines\" {\n        return Err(Error::new(\n            span,\n            \"`jsonlines` is a sink, legal only as the program's outermost expression\".to_string(),\n        ));\n    }\n    // `length`, `tail`, and `flatten` are polymorphic over the element type, the same reason\n    // `jsonlines` is checked here rather than through `builtin()`'s fixed table.\n    if func == \"length\" {\n        return length_call(ctx, need_arg(arg, func, span)?);\n    }\n    // `None` on an empty Vec, the same way `Index` turns reaching past what's there into `Opt`\n    // rather than a runtime failure.\n    if func == \"tail\" {\n        return tail_call(ctx, need_arg(arg, func, span)?);\n    }\n    // Flattens a Vec<Vec<T>> into a Vec<T>, the way jq's `add` flattens a list of arrays.\n    // Joining a fixed, known count of Vecs is `+` (kantord/toylang#97); this is for when the\n    // outer Vec's length is not known at the call site.\n    if func == \"flatten\" {\n        return flatten_call(ctx, need_arg(arg, func, span)?);\n    }\n    // The one exit a stream has: `Stream<T> -> Vec<T>`, polymorphic over the element type like\n    // `length` and the others above, so the argument is synthesised first.\n    if func == \"collect\" {\n        return collect(ctx, need_arg(arg, func, span)?, None);\n    }\n    // Polymorphic over which record, the same reason `length` is checked here: the return type\n    // (`Vec<Str>`) is fixed, but the argument's shape is not.\n    if func == \"fields\" {\n        return fields_call(ctx, need_arg(arg, func, span)?);\n    }\n    // Blocking, one Vec in and one Vec out with no Stream instance (kantord/toylang#86, Q20 in\n    // draft.md), so both are checked here rather than through `select`'s subject-context\n    // mechanism.\n    if func == \"sort\" {\n        return sort_call(ctx, need_arg(arg, func, span)?);\n    }\n    if func == \"reverse\" {\n        return reverse_call(ctx, need_arg(arg, func, span)?);\n    }\n    if let Some((which, sig)) = builtin(func) {\n        let param_ty = sig\n            .param\n            .as_ref()\n            .expect(\"every builtin in the fixed table is unary\");\n        let arg = expect(ctx, need_arg(arg, func, span)?, param_ty)?;\n        return Ok(Tir::new(\n            sig.ret,\n            Kind::Builtin {\n                which,\n                arg: Box::new(arg),\n            },\n        ));\n    }\n    let Some(sig) = ctx.sigs.get(func) else {\n        // A payload constructor is ordinary application (the Q34 path), so `circle{r: 1}` lands\n        // here; it resolves as a variant only after the function namespace declines.\n        if let Some(owners) = ctx.variant_owners.get(func) {\n            let enum_ty = sole_owner(ctx, func, owners, func_span)?.clone();\n            return construct(ctx, &enum_ty, func, func_span, arg.as_deref(), None);\n        }\n        return Err(Error::new(func_span, format!(\"`{func}` is not a function\")));\n    };\n    let arg = call_arg(ctx, func, span, &sig.param, arg)?;\n    Ok(Tir::new(\n        sig.ret.clone(),\n        Kind::Call {\n            func: func.to_string(),\n            arg,\n        },\n    ))\n}\n\n/// A user function's argument against its (optionally nullary) signature: the four arity/type\n/// combinations a call and a signature can be in relative to each other.\nfn call_arg(\n    ctx: &Ctx,\n    func: &str,\n    span: Span,\n    param_ty: &Option<Type>,\n    arg: &Option<Box<Expr>>,\n) -> Result<Option<Box<Tir>>, Error> {\n    match (param_ty, arg) {\n        (Some(param_ty), Some(arg)) => Ok(Some(Box::new(expect(ctx, arg, param_ty)?))),\n        (None, None) => Ok(None),\n        (Some(param_ty), None) => Err(Error::new(\n            span,\n            format!(\"`{func}` needs an argument of {param_ty}, but was called with none\"),\n        )),\n        (None, Some(arg)) => Err(Error::new(\n            arg.span(),\n            format!(\"`{func}` takes no argument\"),\n        )),\n    }\n}\n\n/// Cardinality-polymorphic: the same subject-context mechanism types `select` over a Vec and\n/// over a Stream, with the element drawn from either's parameter. Stream in, stream out.\nfn select_call(ctx: &Ctx, arg: &Expr, span: Span) -> Result<Tir, Error> {\n    let Some((subject, id)) = ctx.subject.clone() else {\n        return Err(Error::new(\n            span,\n            \"`select` needs a subject, so it must follow `|`\",\n        ));\n    };\n    let Some(elem) = mapper_elem(&subject) else {\n        return Err(Error::new(\n            span,\n            format!(\"`select` needs a Vec or a stream, found {subject}\"),\n        ));\n    };\n    let param = ctx.fresh();\n    let inner = mapper_ctx(ctx, elem, param);\n    let pred = expect(&inner, arg, &Type::Bool)?;\n    let source = Tir::new(subject.clone(), Kind::Local(id));\n    Ok(Tir::new(\n        subject,\n        Kind::Select {\n            source: Box::new(source),\n            param,\n            pred: Box::new(pred),\n        },\n    ))\n}\n\nfn length_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n    let arg_span = arg.span();\n    let arg = synth(ctx, arg)?;\n    if arg.ty.elem().is_none() {\n        return Err(Error::new(\n            arg_span,\n            format!(\"`length` needs a Vec, found {}\", arg.ty),\n        ));\n    }\n    Ok(Tir::new(\n        Type::Int,\n        Kind::Builtin {\n            which: tir::Builtin::Length,\n            arg: Box::new(arg),\n        },\n    ))\n}\n\n/// `fields(r)`, the declared names of `r`'s fields in the order its type carries them\n/// (kantord/toylang#60: that order is metadata, not part of the type's identity, but it is\n/// exactly the order this reads off). A record's field set is closed, so this needs no runtime\n/// support once checked: every backend can bake the names in as a literal.\nfn fields_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n    let arg_span = arg.span();\n    let arg = synth(ctx, arg)?;\n    if !matches!(arg.ty, Type::Record(_)) {\n        return Err(Error::new(\n            arg_span,\n            format!(\"`fields` needs a record, found {}\", arg.ty),\n        ));\n    }\n    Ok(Tir::new(\n        Type::Vec(Box::new(Type::Str)),\n        Kind::Builtin {\n            which: tir::Builtin::Fields,\n            arg: Box::new(arg),\n        },\n    ))\n}\n\n/// `None` on an empty Vec, the same way `Index` turns reaching past what's there into `Opt`\n/// rather than a runtime failure.\nfn tail_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n    let arg_span = arg.span();\n    let arg = synth(ctx, arg)?;\n    let Some(elem) = arg.ty.elem().cloned() else {\n        return Err(Error::new(\n            arg_span,\n            format!(\"`tail` needs a Vec, found {}\", arg.ty),\n        ));\n    };\n    Ok(Tir::new(\n        opt_of(ctx, Type::Vec(Box::new(elem))),\n        Kind::Builtin {\n            which: tir::Builtin::Tail,\n            arg: Box::new(arg),\n        },\n    ))\n}\n\n/// Flattens a Vec<Vec<T>> into a Vec<T>, the way jq's `add` flattens a list of arrays.\nfn flatten_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n    let arg_span = arg.span();\n    let arg = synth(ctx, arg)?;\n    let inner = arg.ty.elem().cloned();\n    let Some(elem) = inner.as_ref().and_then(Type::elem).cloned() else {\n        return Err(Error::new(\n            arg_span,\n            format!(\"`flatten` needs a Vec of Vecs, found {}\", arg.ty),\n        ));\n    };\n    Ok(Tir::new(\n        Type::Vec(Box::new(elem)),\n        Kind::Builtin {\n            which: tir::Builtin::Flatten,\n            arg: Box::new(arg),\n        },\n    ))\n}\n\n/// The element types ordering comparisons (`<`, `<=`, `>`, `>=`) already typecheck on --\n/// documented on each of their own reference pages, and what `sort` restricts itself to rather\n/// than reaching past what every backend can already order natively.\nfn orderable(ty: &Type) -> bool {\n    matches!(ty, Type::Int | Type::Int64 | Type::Str | Type::Char)\n}\n\n/// `sort(v)`, ascending by the total order `<` already gives `v`'s element type\n/// (kantord/toylang#86). Restricted to `orderable` element types rather than the same\n/// `expect(ctx, rhs, &left.ty)` equality `binary`'s comparison branch accepts more broadly, so\n/// this never asks a backend to order a Record or an Enum.\nfn sort_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n    let arg_span = arg.span();\n    let arg = synth(ctx, arg)?;\n    let Some(elem) = arg.ty.elem() else {\n        return Err(Error::new(\n            arg_span,\n            format!(\"`sort` needs a Vec, found {}\", arg.ty),\n        ));\n    };\n    if !orderable(elem) {\n        return Err(Error::new(\n            arg_span,\n            format!(\n                \"`sort` needs a Vec of Int, Int64, Str, or Char, found {}\",\n                arg.ty\n            ),\n        ));\n    }\n    let ty = arg.ty.clone();\n    Ok(Tir::new(\n        ty,\n        Kind::Builtin {\n            which: tir::Builtin::Sort,\n            arg: Box::new(arg),\n        },\n    ))\n}\n\n/// `reverse(v)`, `v`'s elements in the opposite order. Unlike `sort`, no comparison is needed,\n/// so every element type is accepted.\nfn reverse_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n    let arg_span = arg.span();\n    let arg = synth(ctx, arg)?;\n    if arg.ty.elem().is_none() {\n        return Err(Error::new(\n            arg_span,\n            format!(\"`reverse` needs a Vec, found {}\", arg.ty),\n        ));\n    }\n    let ty = arg.ty.clone();\n    Ok(Tir::new(\n        ty,\n        Kind::Builtin {\n            which: tir::Builtin::Reverse,\n            arg: Box::new(arg),\n        },\n    ))\n}\n\n/// Walk an access chain left to right, carrying what we are currently looking at and how many\n/// dimensions we are inside.\n///\n/// Every dimension needs a spec. `[]` enters one, so it strips a layer off what we are looking at\n/// and adds one to the depth; a field access reads a field of it and leaves the depth alone.\n/// The expression's type is what we are looking at, wrapped back up that many times.\n///\n/// This is why `db.users.name` is an error and `db.users[].name` is not: the first never said\n/// what happens to the dimension it reached through.\n///\n/// A Stream is one more dimension `[]` can enter -- projection is a mapper -- and since the\n/// grammar keeps a stream strictly outermost, the walk only has to remember one bit: whether\n/// the first-stripped layer was a Stream (`stream_outer`), so wrapping back up restores a\n/// Stream there and a Vec everywhere below.\nstruct Access {\n    tir: Tir,\n    /// What the chain currently evaluates to, one dimension down: a field access reads this, a\n    /// further `[]` strips a layer off it.\n    elem: Type,\n    /// How many dimensions the chain is inside.\n    depth: usize,\n    /// Whether the first-stripped layer was a Stream rather than a Vec.\n    stream: bool,\n}\n\nimpl Access {\n    fn new(tir: Tir, elem: Type, depth: usize, stream: bool) -> Access {\n        Access {\n            tir,\n            elem,\n            depth,\n            stream,\n        }\n    }\n}\n\nfn access(ctx: &Ctx, expr: &Expr) -> Result<Access, Error> {\n    /// `elem`, wrapped back up under every dimension the chain is inside.\n    fn wrap(mut ty: Type, depth: usize, stream_outer: bool) -> Type {\n        for i in 0..depth {\n            ty = if stream_outer && i == depth - 1 {\n                Type::Stream(Box::new(ty))\n            } else {\n                Type::Vec(Box::new(ty))\n            };\n        }\n        ty\n    }\n\n    match expr {\n        Expr::Project { base, span } => {\n            let b = access(ctx, base)?;\n            if let Type::Stream(inner) = &b.elem {\n                return Ok(Access::new(b.tir, (**inner).clone(), b.depth + 1, true));\n            }\n            let Some(inner) = b.elem.elem().cloned() else {\n                return Err(Error::new(\n                    *span,\n                    format!(\"`[]` needs a dimension, found {}\", b.elem),\n                ));\n            };\n            Ok(Access::new(b.tir, inner, b.depth + 1, b.stream))\n        }\n\n        // The absence stops being carried and starts being asserted.\n        Expr::Unwrap { base, span } => {\n            let b = access(ctx, base)?;\n            let Some(inner) = b.elem.as_opt() else {\n                return Err(Error::new(\n                    *span,\n                    format!(\"`!` needs an Opt, found {}\", b.elem),\n                ));\n            };\n            let ty = wrap(inner.clone(), b.depth, b.stream);\n            let tir = Tir::new(\n                ty,\n                Kind::Unwrap {\n                    base: Box::new(b.tir),\n                },\n            );\n            Ok(Access::new(tir, inner.clone(), b.depth, b.stream))\n        }\n\n        // Collapsing a dimension. The entry may not be there, so what comes out is `Opt`.\n        Expr::Index { base, index, span } => {\n            let b = access(ctx, base)?;\n            let Some(inner) = b.elem.elem().cloned() else {\n                return Err(Error::new(\n                    *span,\n                    format!(\"`[i]` needs a dimension, found {}\", b.elem),\n                ));\n            };\n            let index_tir = expect(ctx, index, &Type::Int)?;\n            let elem_is_record = matches!(inner, Type::Record(_));\n            let out = opt_of(ctx, inner);\n            let ty = wrap(out.clone(), b.depth, b.stream);\n            let kind = Kind::Index {\n                base: Box::new(b.tir),\n                index: Box::new(index_tir),\n                depth: b.depth,\n                elem_is_record,\n            };\n            Ok(Access::new(Tir::new(ty, kind), out, b.depth, b.stream))\n        }\n\n        Expr::Field { base, name, span } => {\n            let b = access(ctx, base)?;\n            if b.elem.elem().is_some() || matches!(b.elem, Type::Stream(_)) {\n                return Err(Error::new(\n                    *span,\n                    format!(\n                        \"`.{name}` needs a record, found {}: give the dimension a spec with `[]`\",\n                        b.elem\n                    ),\n                ));\n            }\n            let Some(field) = b.elem.field(name).cloned() else {\n                return Err(Error::new(\n                    *span,\n                    format!(\"no field `{name}` on {}\", b.elem),\n                ));\n            };\n            let ty = wrap(field.clone(), b.depth, b.stream);\n            let kind = Kind::Field {\n                base: Box::new(b.tir),\n                name: name.clone(),\n            };\n            Ok(Access::new(Tir::new(ty, kind), field, b.depth, b.stream))\n        }\n\n        other => {\n            let tir = synth(ctx, other)?;\n            let ty = tir.ty.clone();\n            Ok(Access::new(tir, ty, 0, false))\n        }\n    }\n}\n\n/// A literal (or a minus on one, or a negation) met by an Int64 expectation: literals carry\n/// no suffix, so the position is the only thing that can say which width one has\n/// (kantord/toylang#83), the `[]` rule applied to numbers. A minus directly on a literal is\n/// part of the literal, as for Int, so the whole written range short of\n/// `-9223372036854775808` is reachable (the parser refuses `9223372036854775808` before the\n/// minus could claim it, the same edge Rust's own i64 literals have). `None` for any other\n/// form -- or any other `want` -- which falls through to `expect_inner`'s remaining arms.\nfn int64_resolved(ctx: &Ctx, expr: &Expr, want: &Type) -> Option<Result<Tir, Error>> {\n    if *want != Type::Int64 {\n        return None;\n    }\n    match expr {\n        Expr::Int { value, .. } => Some(Ok(Tir::new(Type::Int64, Kind::Int(*value)))),\n        Expr::Neg { base, .. } => {\n            if let Expr::Int { value, .. } = base.as_ref() {\n                return Some(Ok(Tir::new(Type::Int64, Kind::Int(-value))));\n            }\n            let inner = match expect(ctx, base, &Type::Int64) {\n                Ok(inner) => inner,\n                Err(e) => return Some(Err(e)),\n            };\n            let zero = Tir::new(Type::Int64, Kind::Int(0));\n            Some(Ok(Tir::new(\n                Type::Int64,\n                Kind::Arith {\n                    op: BinOp::Sub,\n                    lhs: Box::new(zero),\n                    rhs: Box::new(inner),\n                },\n            )))\n        }\n        _ => None,\n    }\n}\n\n/// An arithmetic operand checked at the width the other side fixed, with the type mismatch\n/// upgraded to name the bridge when the two integer types met: \"expected Int, found Int64\" is\n/// true but leaves the reader to discover `i64` on their own. The re-synthesis in the error\n/// path mirrors `stream_refusal`'s.\nfn expect_int_width(ctx: &Ctx, rhs: &Expr, width: &Type, op: BinOp) -> Result<Tir, Error> {\n    expect(ctx, rhs, width).map_err(|err| {\n        let Ok(found) = synth(ctx, rhs) else {\n            return err;\n        };\n        match (width, &found.ty) {\n            (Type::Int, Type::Int64) => Error::new(\n                rhs.span(),\n                format!(\"`{op}` cannot mix Int and Int64; widen the Int side with `i64(...)`\"),\n            ),\n            (Type::Int64, Type::Int) => Error::new(\n                rhs.span(),\n                format!(\"`{op}` cannot mix Int64 and Int; widen the Int side with `i64(...)`\"),\n            ),\n            _ => err,\n        }\n    })\n}\n\nfn binary(ctx: &Ctx, op: BinOp, lhs: &Expr, rhs: &Expr) -> Result<Tir, Error> {\n    let left = synth(ctx, lhs)?;\n\n    // Q2 is open, so an operator over a Vec is rejected rather than being silently given\n    // broadcast or zip semantics. Under C1 that restriction is ordinary typing: there is no\n    // separate cardinality to check, because a Vec is just a type. `+` is the one exception:\n    // it concatenates two Vecs of the same type now (kantord/toylang#97, the add-trait\n    // reading), which settles that half of Q2 without deciding what any other operator means\n    // over two Vecs.\n    if left.ty.elem().is_some() && op != BinOp::Add {\n        return Err(Error::new(\n            lhs.span(),\n            format!(\"`{op}` does not apply to {}\", left.ty),\n        ));\n    }\n\n    if op.is_comparison() {\n        // A Vec one level down is the same open question a bare one is. `==` on a record whose\n        // field is a Vec would have to answer whether that field compares as a whole value or\n        // broadcasts, which is Q2, so structural equality stops at the first Vec rather than\n        // settling it silently (kantord/toylang#95). The bare case is already gone above; this\n        // catches the composite that carries one.\n        if left.ty.contains_vec() {\n            return Err(Error::new(\n                lhs.span(),\n                format!(\"`{op}` does not apply to {}\", left.ty),\n            ));\n        }\n\n        // Comparison never crosses the integer widths either: the sides must already agree,\n        // and the mismatch names `i64` the same way arithmetic's does.\n        if matches!(left.ty, Type::Int | Type::Int64) {\n            let right = expect_int_width(ctx, rhs, &left.ty, op)?;\n            return Ok(Tir::new(\n                Type::Bool,\n                Kind::Compare {\n                    op,\n                    lhs: Box::new(left),\n                    rhs: Box::new(right),\n                },\n            ));\n        }\n        let right = match expect(ctx, rhs, &left.ty) {\n            Ok(right) => right,\n            Err(err) => {\n                // Postfix `!` next to `!=` merges into one token: `x!=y` lexes as `!=`, not\n                // `x! == y`. Once the plain comparison has failed, Opt<T> against its own\n                // element is specific enough to name the likely cause instead of just the\n                // type mismatch.\n                if op == BinOp::Ne\n                    && let Some(inner) = left.ty.as_opt().cloned()\n                    && expect(ctx, rhs, &inner).is_ok()\n                {\n                    return Err(Error::new(\n                        rhs.span(),\n                        format!(\n                            \"expected {}, found {inner}: `!` and `=` read as one token \\\n                             here (`!=`); did you mean `! ==`?\",\n                            left.ty\n                        ),\n                    ));\n                }\n                return Err(err);\n            }\n        };\n        return Ok(Tir::new(\n            Type::Bool,\n            Kind::Compare {\n                op,\n                lhs: Box::new(left),\n                rhs: Box::new(right),\n            },\n        ));\n    }\n\n    if op.is_arithmetic() {\n        if !matches!(left.ty, Type::Int | Type::Int64) {\n            return Err(Error::new(\n                lhs.span(),\n                format!(\"expected Int or Int64, found {}\", left.ty),\n            ));\n        }\n        // Both sides share the left's width: nothing widens implicitly (kantord/toylang#83),\n        // so an Int meeting an Int64 is an error naming the bridge rather than a silent\n        // promotion -- and a bare literal on the right resolves at whichever width the left\n        // already has, since `expect_inner` types a literal by its position.\n        let width = left.ty.clone();\n        let right = expect_int_width(ctx, rhs, &width, op)?;\n        return Ok(Tir::new(\n            width,\n            Kind::Arith {\n                op,\n                lhs: Box::new(left),\n                rhs: Box::new(right),\n            },\n        ));\n    }\n\n    plus(ctx, lhs, left, rhs)\n}\n\n/// `+` is the one operator whose meaning depends on its operands: addition on Int or Int64,\n/// concatenation on Str, and concatenation on Vec (kantord/toylang#97, the add-trait reading)\n/// when both sides are the same Vec type. Nothing is coerced, so all three still require both\n/// sides to agree.\nfn plus(ctx: &Ctx, lhs: &Expr, left: Tir, rhs: &Expr) -> Result<Tir, Error> {\n    match &left.ty {\n        Type::Int | Type::Int64 => {\n            let width = left.ty.clone();\n            let right = expect_int_width(ctx, rhs, &width, BinOp::Add)?;\n            let kind = Kind::Arith {\n                op: BinOp::Add,\n                lhs: Box::new(left),\n                rhs: Box::new(right),\n            };\n            Ok(Tir::new(width, kind))\n        }\n        Type::Str => {\n            let right = expect(ctx, rhs, &Type::Str)?;\n            Ok(Tir::new(\n                Type::Str,\n                Kind::Concat(Box::new(left), Box::new(right)),\n            ))\n        }\n        Type::Vec(_) => {\n            let want = left.ty.clone();\n            let right = expect(ctx, rhs, &want)?;\n            Ok(Tir::new(\n                want,\n                Kind::Concat(Box::new(left), Box::new(right)),\n            ))\n        }\n        other => Err(Error::new(\n            lhs.span(),\n            format!(\"`+` needs Int, Str, or Vec, found {other}\"),\n        )),\n    }\n}\n\n/// How an expression met an expectation. `Checked` consumed it: the expected type flowed into\n/// the form, and the result is `want`-typed by construction. `Synthesised` means the form\n/// answers for itself, so the expectation resolved nothing and the caller still owns the\n/// comparison -- which is what lets `check` blame a function's signature, by name, when a\n/// body's synthesised type misses its annotation.\nenum Expected {\n    Checked(Tir),\n    Synthesised(Tir),\n}\n\n/// The checking direction: an expected type goes in, and the expression is verified against it\n/// rather than asked what it is. Most forms answer both questions, but not all do.\nfn expect(ctx: &Ctx, expr: &Expr, want: &Type) -> Result<Tir, Error> {\n    match expect_inner(ctx, expr, want)? {\n        Expected::Checked(tir) => Ok(tir),\n        Expected::Synthesised(found) => {\n            if &found.ty != want {\n                return Err(Error::new(\n                    expr.span(),\n                    format!(\"expected {want}, found {}\", found.ty),\n                ));\n            }\n            Ok(reorder_record(ctx, found, want))\n        }\n    }\n}\n\n/// `found`, rebuilt to `want`'s field order when the two already agree (kantord/toylang#60) --\n/// a no-op when they don't, leaving a real mismatch for the caller's own comparison to catch\n/// and name.\nfn conform(ctx: &Ctx, found: Tir, want: &Type) -> Tir {\n    if &found.ty == want {\n        reorder_record(ctx, found, want)\n    } else {\n        found\n    }\n}\n\n/// Whether `a` and `b` are not just the same type (kantord/toylang#60: a record's fields are a\n/// set, not a sequence) but physically identical -- same fields, same order, all the way into\n/// any field that is itself a record. Every non-nominal backend reads a record by name and does\n/// not care; the native backend and the columnar Vec layout read it by position, off whichever\n/// type a value is currently checked against, so a value crossing into a differently-ordered\n/// but equal position needs rebuilding before those readers see it. This is what decides\n/// whether that rebuild is needed.\n///\n/// Also recurses into an enum's variant payloads (kantord/toylang#66): two instantiations of the\n/// same generic enum are one `Type` (`Type::Enum`'s `PartialEq` compares `name` and `args`\n/// only, and a generic argument's own order-insensitivity comes from `Type::Record`'s), so a\n/// payload written in a different field order at each call site is exactly the same hazard a\n/// bare record or a Vec element is. The variant list itself is never out of order -- it comes\n/// from one declaration -- so zipping the two enums' variants positionally is safe, *except*\n/// when one side's list is a recursive self-reference's placeholder (kantord/toylang#76): the\n/// zip then runs zero pairs and this reports \"no reorder needed\" rather than crashing, which is\n/// conservatively correct (nothing gets left mis-ordered that this function could have fixed)\n/// though not necessarily complete (a reorder a full expansion would have found stays undone).\nfn same_field_order(a: &Type, b: &Type) -> bool {\n    match (a, b) {\n        (Type::Record(x), Type::Record(y)) => {\n            x.len() == y.len()\n                && x.iter()\n                    .zip(y)\n                    .all(|((n1, t1), (n2, t2))| n1 == n2 && same_field_order(t1, t2))\n        }\n        (Type::Vec(x), Type::Vec(y)) | (Type::Stream(x), Type::Stream(y)) => same_field_order(x, y),\n        (Type::Enum { variants: vx, .. }, Type::Enum { variants: vy, .. }) => {\n            vx.iter().zip(vy).all(|((_, px), (_, py))| match (px, py) {\n                (Some(tx), Some(ty)) => same_field_order(tx, ty),\n                _ => true,\n            })\n        }\n        _ => true,\n    }\n}\n\n/// Rebuilds `found` -- already known equal to `want` -- so it is physically laid out in\n/// `want`'s field order: a bound local read back out field by field into a fresh literal in\n/// that order, recursing into any field that is itself a differently-ordered record. Also\n/// recurses through a Vec or Stream wrapper, via a real `map` that rebuilds every element --\n/// unlike the record case this is a runtime loop, not a free relabelling, since a Vec's\n/// elements are not reachable one at a time the way a record's fields are (kantord/toylang#64).\n///\n/// A general enum reorders through `Match`/`EnumLit`: every arm rebuilds its variant with a\n/// freshly reordered payload, which every backend can already run since it is exactly how a\n/// user-written match over that enum already compiles. Opt is the one enum this can't reach\n/// (kantord/toylang#66) -- three backends keep Opt in a representation of their own (`Option<T>`,\n/// `tlOpt[T]{ok,v}`, the null-or-boxed native encoding) rather than the general tagged shape, so\n/// `Match`'s tag-indexed codegen does not apply to it. `OptMap` is the dedicated node every\n/// backend already has the pieces to run: it is exactly the presence branch each one's unwrap\n/// and printer already take, generalised to rebuild the payload instead of rendering it.\nfn reorder_enum(ctx: &Ctx, found: Tir, want: &Type) -> Tir {\n    if let Some(want_inner) = want.as_opt() {\n        let found_inner = found\n            .ty\n            .as_opt()\n            .expect(\"found.ty == want: both Opt\")\n            .clone();\n        let param = ctx.fresh();\n        let body = reorder_record(ctx, Tir::new(found_inner, Kind::Local(param)), want_inner);\n        return Tir::new(\n            want.clone(),\n            Kind::OptMap {\n                source: Box::new(found),\n                param,\n                body: Box::new(body),\n            },\n        );\n    }\n    let Type::Enum {\n        variants: want_variants,\n        ..\n    } = want\n    else {\n        unreachable!(\"reorder_enum is only called with an enum want\")\n    };\n    let found_variants = match &found.ty {\n        Type::Enum { variants, .. } => variants.clone(),\n        _ => unreachable!(\"found.ty == want: both enums\"),\n    };\n    let arms = want_variants\n        .iter()\n        .zip(&found_variants)\n        .map(|((vname, want_payload), (_, found_payload))| {\n            let payload = match (want_payload, found_payload) {\n                (Some(want_p), Some(found_p)) => {\n                    let pid = ctx.fresh();\n                    let rebuilt =\n                        reorder_record(ctx, Tir::new(found_p.clone(), Kind::Local(pid)), want_p);\n                    (Some(pid), Some(Box::new(rebuilt)))\n                }\n                (None, None) => (None, None),\n                _ => unreachable!(\"found.ty == want: variant shapes line up\"),\n            };\n            tir::MatchArm {\n                variant: Some(vname.clone()),\n                guard: None,\n                payload: payload.0,\n                body: Tir::new(\n                    want.clone(),\n                    Kind::EnumLit {\n                        variant: vname.clone(),\n                        payload: payload.1,\n                    },\n                ),\n            }\n        })\n        .collect();\n    Tir::new(\n        want.clone(),\n        Kind::Match {\n            subject: Box::new(found),\n            arms,\n            partial: false,\n        },\n    )\n}\nfn reorder_record(ctx: &Ctx, found: Tir, want: &Type) -> Tir {\n    if same_field_order(&found.ty, want) {\n        return found;\n    }\n    match want {\n        Type::Record(want_fields) => {\n            // A bare local can supply its own fields directly without being bound again: a\n            // Field read reaches through it (a struct-of-arrays cursor, when it is a Vec\n            // element, or an ordinary bound value otherwise) without ever asking for the whole\n            // local as a value, which is what a redundant rebind here would do -- and which\n            // the native backend refuses for a cursor, since a map body's element local is\n            // never materialised as one.\n            if let Kind::Local(local) = found.kind {\n                return Tir::new(\n                    want.clone(),\n                    Kind::RecordLit {\n                        fields: reorder_fields(ctx, local, &found.ty, want_fields),\n                    },\n                );\n            }\n            let local = ctx.fresh();\n            let found_ty = found.ty.clone();\n            let fields = reorder_fields(ctx, local, &found_ty, want_fields);\n            Tir::new(\n                want.clone(),\n                Kind::Bind {\n                    local,\n                    value: Box::new(found),\n                    body: Box::new(Tir::new(want.clone(), Kind::RecordLit { fields })),\n                },\n            )\n        }\n        Type::Vec(want_elem) | Type::Stream(want_elem) => {\n            // `found.ty == want` already (the caller's own guard), so its wrapper is the same\n            // kind as `want`'s and `runtime_elem` cannot miss.\n            let elem_ty = tir::runtime_elem(&found.ty)\n                .expect(\"want is Vec/Stream and found.ty == want\")\n                .clone();\n            let param = ctx.fresh();\n            let body = reorder_record(ctx, Tir::new(elem_ty, Kind::Local(param)), want_elem);\n            Tir::new(\n                want.clone(),\n                Kind::Map {\n                    source: Box::new(found),\n                    param,\n                    body: Box::new(body),\n                },\n            )\n        }\n        Type::Enum { .. } => reorder_enum(ctx, found, want),\n        _ => found,\n    }\n}\n\n/// `want_fields`, each read off `local` (of type `local_ty`) in `want_fields`'s order, recursing\n/// into any field that is itself a differently-ordered record.\nfn reorder_fields(\n    ctx: &Ctx,\n    local: LocalId,\n    local_ty: &Type,\n    want_fields: &[(String, Type)],\n) -> Vec<(String, Tir)> {\n    want_fields\n        .iter()\n        .map(|(name, field_ty)| {\n            let access = Tir::new(\n                field_ty.clone(),\n                Kind::Field {\n                    base: Box::new(Tir::new(local_ty.clone(), Kind::Local(local))),\n                    name: name.clone(),\n                },\n            );\n            (name.clone(), reorder_record(ctx, access, field_ty))\n        })\n        .collect()\n}\n\n/// `expect`, minus the final comparison. Each arm here is a form whose type can come from its\n/// position rather than its contents; expectation only ever resolves what synthesis would have\n/// refused -- a form that can synthesise falls through and is compared, never coerced.\n/// `input` against the type its position wants: the first use fills the program-wide slot,\n/// and every later use must agree with it. A signature can spell Stream now, so this position\n/// can ask for one; `input` is a whole value already in hand, which is exactly what a stream\n/// is not.\nfn input_read(ctx: &Ctx, span: Span, want: &Type) -> Result<Tir, Error> {\n    if want.contains_stream() {\n        return Err(Error::new(\n            span,\n            format!(\"`input` is one value read from stdin, but {want} is wanted here\"),\n        ));\n    }\n    // Absence has no ratified wire form: the tag is an in-memory fact, serialization emits\n    // `null` for it going out, and whether `null` coming in reads as `none` is codec design\n    // nobody has done. Refusing is the reversible direction.\n    if want.contains_opt() {\n        return Err(Error::new(\n            span,\n            format!(\"`input` cannot be read as {want}; absence has no wire form to read\"),\n        ));\n    }\n    // A Char is never itself JSON; it only ever comes from decoding a Str already in hand\n    // (`chars`), so there is nothing for a wire value to decode into.\n    if want.contains_char() {\n        return Err(Error::new(\n            span,\n            format!(\"`input` cannot be read as {want}; Char has no wire form to read\"),\n        ));\n    }\n    // One-directional, unlike Char: an Int64 result prints fine, but reading one back is\n    // codec design nobody has done -- JS parses JSON numbers into doubles and is off past\n    // 2^53, and jq computes in them. Refusing is the reversible direction.\n    if want.contains_int64() {\n        return Err(Error::new(\n            span,\n            format!(\n                \"`input` cannot be read as {want}; how an Int64 crosses the wire is not decided yet\"\n            ),\n        ));\n    }\n    let mut slot = ctx.input.borrow_mut();\n    match slot.as_ref() {\n        None => *slot = Some(want.clone()),\n        Some(prev) if prev != want => {\n            return Err(Error::new(\n                span,\n                format!(\"`input` is used as {prev} here and as {want} elsewhere\"),\n            ));\n        }\n        Some(_) => {}\n    }\n    Ok(Tir::new(want.clone(), Kind::Input))\n}\n\n/// `inputs` against the type its position wants, which must be a Stream. The filled slot\n/// doubles as the single-use flag: a second `inputs` would be a second stream claiming the\n/// same real stdin, the same mistake a second `lines` is.\nfn inputs_read(ctx: &Ctx, span: Span, want: &Type) -> Result<Tir, Error> {\n    if let Some(func) = ctx.in_fn {\n        return Err(source_in_fn(span, \"inputs\", func));\n    }\n    if ctx.in_mapper {\n        return Err(Error::new(\n            span,\n            \"`inputs` cannot be read inside a mapper body, which runs once per element\".to_string(),\n        ));\n    }\n    let Type::Stream(elem) = want else {\n        return Err(Error::new(\n            span,\n            format!(\n                \"`inputs` is a stream, but {want} is wanted here; eager use is spelled \\\n                 `collect(inputs)`\"\n            ),\n        ));\n    };\n    // The same no-wire-form-for-absence rule `input` states above.\n    if elem.contains_opt() {\n        return Err(Error::new(\n            span,\n            format!(\"`inputs` cannot be read as {want}; absence has no wire form to read\"),\n        ));\n    }\n    if elem.contains_char() {\n        return Err(Error::new(\n            span,\n            format!(\"`inputs` cannot be read as {want}; Char has no wire form to read\"),\n        ));\n    }\n    if elem.contains_int64() {\n        return Err(Error::new(\n            span,\n            format!(\n                \"`inputs` cannot be read as {want}; how an Int64 crosses the wire is not decided yet\"\n            ),\n        ));\n    }\n    let mut slot = ctx.inputs.borrow_mut();\n    if slot.is_some() {\n        return Err(Error::new(\n            span,\n            \"`inputs` has already been read; there is only one stdin\".to_string(),\n        ));\n    }\n    *slot = Some((**elem).clone());\n    Ok(Tir::new(want.clone(), Kind::Inputs))\n}\n\n/// A constructor in a position that wants its enum takes the wanted instantiation: this is\n/// how a generic enum's unit variant -- which alone says nothing about the arguments --\n/// gets built at all (`fn f() -> Pair<Int> = empty`). A bare name only counts when nothing\n/// closer claims it (an arm's field, a local); a call only when no function does. Anything\n/// that is not the wanted enum's variant returns `None` and falls through to synthesis,\n/// which owns the errors.\nfn wanted_variant(ctx: &Ctx, expr: &Expr, want: &Type) -> Option<Result<Tir, Error>> {\n    let Type::Enum { name, args, .. } = want else {\n        return None;\n    };\n    let variants = enum_variants(ctx, name, args);\n    let owns = |n: &str| variants.iter().any(|(vn, _)| vn == n);\n    match expr {\n        Expr::Var { name, span }\n            if owns(name)\n                && !ctx.arm_fields.iter().any(|(n, ..)| n == name)\n                && !ctx.scope.iter().any(|(n, _)| n == name) =>\n        {\n            Some(construct(ctx, want, name, *span, None, None))\n        }\n        Expr::Call {\n            func,\n            func_span,\n            arg,\n            ..\n        } if owns(func) && !ctx.sigs.contains_key(func) => {","lineStart":1308,"lineEnd":2570,"totalLines":2571,"truncated":true}},"title":"src/check/mod.rs","time":{"start":1788120711950,"end":1788120711961}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_0544cc1ef0010oU4UIYKURCXp5","sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","messageID":"msg_0544bcd58001EoHPuuUyxUXpQO"}}
