{"type":"tool_use","timestamp":1788120725233,"sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-a365c922668cbce0","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-149/src/emit_js.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-149/src/emit_js.rs</path>\n<type>file</type>\n<content>\n1: use crate::ast::{BinOp, LogicOp};\n2: use crate::tir::{self, Builtin, Kind, LocalId, Program, Tir};\n3: use crate::ty::{self, Enums, Type};\n4: \n5: /// The binding the input value is read into. Unspellable in source, since every source name is\n6: /// prefixed.\n7: const INPUT: &str = \"t_input\";\n8: const INPUTS: &str = \"t_inputs\";\n9: \n10: const SELECT_HELPER: &str = \"\\\n11: function tl_select(src, pred) {\n12:   const out = [];\n13:   for (let i = 0; i < src.length; i++) if (pred(src[i])) out.push(src[i]);\n14:   return out;\n15: }\n16: \";\n17: \n18: const FIELD_HELPER: &str = \"\\\n19: function tl_field(v, k, depth) {\n20:   if (depth === 0) return v[k];\n21:   const out = [];\n22:   for (let i = 0; i < v.length; i++) out[i] = tl_field(v[i], k, depth - 1);\n23:   return out;\n24: }\n25: \";\n26: \n27: const OPT_HELPER: &str = \"\\\n28: // An Opt is its enum's own runtime shape (ADR 0009): `{some: v}` present, \\\"none\\\" absent.\n29: // Tagged, so two levels of absence stay two values; only the printer flattens to null.\n30: function tl_at(v, i, depth) {\n31:   if (depth > 0) return v.map((e) => tl_at(e, i, depth - 1));\n32:   const n = v.length;\n33:   if (i < 0) i = n + i;\n34:   if (i < 0 || i >= n) return \\\"none\\\";\n35:   return { some: v[i] };\n36: }\n37: \";\n38: \n39: const TAIL_HELPER: &str = \"\\\n40: function tl_tail(v) {\n41:   if (v.length === 0) return \\\"none\\\";\n42:   return { some: v.slice(1) };\n43: }\n44: \";\n45: \n46: const UNWRAP_HELPER: &str = r#\"function tl_unwrap(v, depth) {\n47:   if (depth > 0) return v.map((e) => tl_unwrap(e, depth - 1));\n48:   if (v === \"none\") { throw new Error(\"toylang: unwrapped a value that is not there\"); }\n49:   return v.some;\n50: }\n51: \"#;\n52: \n53: const ARITH_HELPER: &str = r#\"// `|0` is ToInt32: it wraps to 32 bits and truncates toward zero, and V8 folds it away once it\n54: // knows the value is already a Smi.\n55: function tl_div(a, b) {\n56:   if (b === 0) { throw new Error(\"toylang: divided by zero\"); }\n57:   return (a / b) | 0;\n58: }\n59: function tl_rem(a, b) {\n60:   if (b === 0) { throw new Error(\"toylang: divided by zero\"); }\n61:   return (a % b) | 0;\n62: }\n63: \"#;\n64: \n65: // An Int64 is a BigInt (kantord/toylang#83): a double is off past 2^53, and BigInt's own `/`\n66: // and `%` already truncate with the dividend's sign. `BigInt.asIntN(64, ...)` is the wrap,\n67: // including `MIN / -1` back to `MIN`.\n68: const ARITH64_HELPER: &str = r#\"function tl_div64(a, b) {\n69:   if (b === 0n) { throw new Error(\"toylang: divided by zero\"); }\n70:   return BigInt.asIntN(64, a / b);\n71: }\n72: function tl_rem64(a, b) {\n73:   if (b === 0n) { throw new Error(\"toylang: divided by zero\"); }\n74:   return BigInt.asIntN(64, a % b);\n75: }\n76: \"#;\n77: \n78: const COLLECT_HELPER: &str = r#\"// Synchronous, because a toylang expression evaluates to completion and node has no\n79: // synchronous line reader built in. Reads in fixed chunks off the real fd rather than\n80: // `readFileSync(0)`, so a line is available to the rest of the program as soon as it arrives\n81: // rather than only once stdin closes.\n82: function tl_collect_lines() {\n83:   const fs = require(\"fs\");\n84:   const out = [];\n85:   let buf = \"\";\n86:   const chunk = Buffer.alloc(65536);\n87:   for (;;) {\n88:     const n = fs.readSync(0, chunk, 0, chunk.length, null);\n89:     if (n === 0) break;\n90:     buf += chunk.toString(\"utf8\", 0, n);\n91:     let i;\n92:     while ((i = buf.indexOf(\"\\n\")) !== -1) {\n93:       out.push(buf.slice(0, i));\n94:       buf = buf.slice(i + 1);\n95:     }\n96:   }\n97:   if (buf.length > 0) out.push(buf);\n98:   return out;\n99: }\n100: \"#;\n101: \n102: const JOIN_HELPER: &str = \"\\\n103: function tl_join(v, f) {\n104:   const parts = [];\n105:   for (let i = 0; i < v.length; i++) parts.push(f(v[i]));\n106:   return \\\"[\\\" + parts.join(\\\",\\\") + \\\"]\\\";\n107: }\n108: \";\n109: \n110: // JS string comparison compares UTF-16 code units, which disagrees with codepoint order on any\n111: // pair straddling a surrogate pair: a BMP character above U+DFFF (e.g. U+E000) sorts below an\n112: // astral character's lead surrogate even though its codepoint is smaller. Iterating with the\n113: // string iterator (rather than indexing) steps one codepoint at a time, surrogate pairs included.\n114: const STR_CMP_HELPER: &str = \"\\\n115: function tl_str_cmp(a, b) {\n116:   const ai = a[Symbol.iterator]();\n117:   const bi = b[Symbol.iterator]();\n118:   for (;;) {\n119:     const x = ai.next();\n120:     const y = bi.next();\n121:     if (x.done || y.done) return (x.done ? 0 : 1) - (y.done ? 0 : 1);\n122:     const cx = x.value.codePointAt(0);\n123:     const cy = y.value.codePointAt(0);\n124:     if (cx !== cy) return cx < cy ? -1 : 1;\n125:   }\n126: }\n127: \";\n128: \n129: // A record and a payload-carrying variant are both objects, and JS `===` on two objects is\n130: // identity, so `{a: 1} === {a: 1}` was false here and true on Python (kantord/toylang#68).\n131: // Structural equality is the ratified answer, so composites walk. Keyed rather than ordered:\n132: // two spellings of one record type may reach here with their keys in different orders.\n133: const EQ_HELPER: &str = \"\\\n134: function tl_eq(a, b) {\n135:   if (a === b) return true;\n136:   if (typeof a !== \\\"object\\\" || a === null || typeof b !== \\\"object\\\" || b === null) return false;\n137:   const keys = Object.keys(a);\n138:   if (keys.length !== Object.keys(b).length) return false;\n139:   return keys.every((k) => Object.hasOwn(b, k) && tl_eq(a[k], b[k]));\n140: }\n141: \";\n142: \n143: const JSONLINES_HELPER: &str = \"\\\n144: function tl_jsonlines(v, f) {\n145:   const parts = [];\n146:   for (let i = 0; i < v.length; i++) parts.push(f(v[i]));\n147:   return parts.join(\\\"\\\\n\\\");\n148: }\n149: \";\n150: \n151: // The string iterator steps one codepoint at a time, surrogate pairs included (the same\n152: // iterator STR_CMP_HELPER uses above), so there is no decoding to get right here.\n153: const CHARS_HELPER: &str = \"\\\n154: function tl_chars(s) {\n155:   return Array.from(s, (c) => c.codePointAt(0));\n156: }\n157: \";\n158: \n159: pub fn emit(program: &Program) -> String {\n160:     let enums = &program.enums;\n161:     let mut out = String::new();\n162: \n163:     let used = used_helpers(program);\n164:     let join = matches!(program.body.ty, Type::Vec(_))\n165:         || contains_vec(enums, &program.body.ty)\n166:         || used.jsonlines;\n167:     for (on, text) in [\n168:         (used.select, SELECT_HELPER),\n169:         (used.field, FIELD_HELPER),\n170:         (join, JOIN_HELPER),\n171:         (used.index, OPT_HELPER),\n172:         (used.tail, TAIL_HELPER),\n173:         (used.unwrap, UNWRAP_HELPER),\n174:         (used.arith, ARITH_HELPER),\n175:         (used.arith64, ARITH64_HELPER),\n176:         (used.collect, COLLECT_HELPER),\n177:         (used.jsonlines, JSONLINES_HELPER),\n178:         (used.str_cmp, STR_CMP_HELPER),\n179:         (used.chars, CHARS_HELPER),\n180:         (used.eq, EQ_HELPER),\n181:     ] {\n182:         if on {\n183:             out.push_str(text);\n184:         }\n185:     }\n186:     out.push_str(&printers(program));\n187: \n188:     // Function declarations hoist, so a call to one defined further down resolves without the\n189:     // forward declarations Lua needs. Each backend does what its own target does.\n190:     for f in &program.funcs {\n191:         out.push_str(&format!(\n192:             \"function {}({}) {{\\n  return {};\\n}}\\n\",\n193:             user(&f.name),\n194:             f.param.as_deref().map_or_else(String::new, user),\n195:             expr(enums, &f.body)\n196:         ));\n197:     }\n198: \n199:     if let Some(fusion) = tir::fusion(program) {\n200:         out.push_str(&fused_main(program, &fusion));\n201:         return out;\n202:     }\n203: \n204:     if program.input.is_some() {\n205:         out.push_str(&format!(\n206:             \"const {INPUT} = JSON.parse(require(\\\"fs\\\").readFileSync(0, \\\"utf8\\\"));\\n\"\n207:         ));\n208:     }\n209:     if program.inputs.is_some() {\n210:         out.push_str(&format!(\n211:             \"const {INPUTS} = require(\\\"fs\\\").readFileSync(0, \\\"utf8\\\").split(\\\"\\\\n\\\").filter((l) => l.length > 0).map((l) => JSON.parse(l));\\n\"\n212:         ));\n213:     }\n214: \n215:     let body = expr(enums, &program.body);\n216:     // A top-level Str prints raw, the way jq's -r does; anything else prints as JSON.\n217:     if program.body.ty == Type::Str {\n218:         out.push_str(&format!(\"console.log({body});\\n\"));\n219:     } else {\n220:         out.push_str(&format!(\n221:             \"console.log({});\\n\",\n222:             show(enums, &program.body.ty, &body, 0)\n223:         ));\n224:     }\n225:     out\n226: }\n227: \n228: /// A stream-typed `jsonlines` program, compiled as a loop reading one line at a time off the\n229: /// real fd rather than `readFileSync(0)`'s read-everything-first.\n230: ///\n231: /// `process.stdout.write` is synchronous to a file or TTY on POSIX but asynchronous to a pipe --\n232: /// queued rather than issued immediately -- and the very next thing this loop does is a\n233: /// *synchronous* read that blocks the whole event loop, which risks stopping a queued write from\n234: /// ever reaching the pipe before the process blocks again. `tests/streaming.rs`'s `js_streams`\n235: /// checks this directly against a live pipe rather than assuming either way.\n236: fn fused_main(program: &Program, fusion: &tir::Fusion) -> String {\n237:     let enums = &program.enums;\n238:     let mut out = String::new();\n239:     out.push_str(\"let tl_stdin_buf = \\\"\\\";\\n\");\n240:     out.push_str(\"let tl_stdin_eof = false;\\n\");\n241:     out.push_str(\"function tl_read_line() {\\n\");\n242:     out.push_str(\"  const fs = require(\\\"fs\\\");\\n\");\n243:     out.push_str(\"  for (;;) {\\n\");\n244:     out.push_str(\"    const i = tl_stdin_buf.indexOf(\\\"\\\\n\\\");\\n\");\n245:     out.push_str(\"    if (i !== -1) {\\n\");\n246:     out.push_str(\"      const line = tl_stdin_buf.slice(0, i);\\n\");\n247:     out.push_str(\"      tl_stdin_buf = tl_stdin_buf.slice(i + 1);\\n\");\n248:     out.push_str(\"      return line;\\n\");\n249:     out.push_str(\"    }\\n\");\n250:     out.push_str(\"    if (tl_stdin_eof) {\\n\");\n251:     out.push_str(\"      if (tl_stdin_buf.length === 0) return null;\\n\");\n252:     out.push_str(\"      const line = tl_stdin_buf;\\n\");\n253:     out.push_str(\"      tl_stdin_buf = \\\"\\\";\\n\");\n254:     out.push_str(\"      return line;\\n\");\n255:     out.push_str(\"    }\\n\");\n256:     out.push_str(\"    const chunk = Buffer.alloc(65536);\\n\");\n257:     out.push_str(\"    const n = fs.readSync(0, chunk, 0, chunk.length, null);\\n\");\n258:     out.push_str(\"    if (n === 0) { tl_stdin_eof = true; continue; }\\n\");\n259:     out.push_str(\"    tl_stdin_buf += chunk.toString(\\\"utf8\\\", 0, n);\\n\");\n260:     out.push_str(\"  }\\n\");\n261:     out.push_str(\"}\\n\");\n262: \n263:     out.push_str(\"for (;;) {\\n\");\n264:     out.push_str(\"  const t_line_raw = tl_read_line();\\n\");\n265:     out.push_str(\"  if (t_line_raw === null) break;\\n\");\n266:     let (mut current, mut current_ty) = match fusion.source {\n267:         tir::Source::Inputs => {\n268:             out.push_str(\"  if (t_line_raw.length === 0) continue;\\n\");\n269:             out.push_str(\"  const t_line = JSON.parse(t_line_raw);\\n\");\n270:             let elem = program\n271:                 .inputs\n272:                 .as_ref()\n273:                 .expect(\"an inputs source recorded its element\");\n274:             (\"t_line\".to_string(), elem.clone())\n275:         }\n276:         // A raw line is already the element, blank ones included: `lines` keeps them.\n277:         tir::Source::Lines => (\"t_line_raw\".to_string(), Type::Str),\n278:     };\n279:     for stage in &fusion.stages {\n280:         match stage {\n281:             tir::Stage::Map { param, body } => {\n282:                 out.push_str(&format!(\"  const {} = {};\\n\", local(*param), current));\n283:                 current = expr(enums, body);\n284:                 current_ty = body.ty.clone();\n285:             }\n286:             tir::Stage::Select { param, pred } => {\n287:                 out.push_str(&format!(\"  const {} = {};\\n\", local(*param), current));\n288:                 out.push_str(&format!(\"  if (!({})) continue;\\n\", expr(enums, pred)));\n289:                 current = local(*param);\n290:             }\n291:         }\n292:     }\n293:     out.push_str(&format!(\n294:         \"  console.log({});\\n\",\n295:         show(enums, &current_ty, &current, 0)\n296:     ));\n297:     out.push_str(\"}\\n\");\n298:     out\n299: }\n300: \n301: /// The printer is built from the type rather than by inspecting the value, so a record's keys\n302: /// are known and ordered at compile time, in declaration order. That removes the whole class\n303: /// of disagreement where one backend enumerates keys in insertion order and another sorts\n304: /// them, and it is what a native backend will have to do anyway, having no runtime type\n305: /// information at all.\n306: fn show(enums: &Enums, ty: &Type, value: &str, depth: usize) -> String {\n307:     match ty {\n308:         Type::Param(_) => unreachable!(\"params are substituted before emit\"),\n309:         // The checker refuses a program whose result contains a stream, since there is nothing to\n310:         // print: a stream has no value, only a promise that collect can redeem.\n311:         Type::Stream(_) => unreachable!(\"a stream cannot reach the printer\"),\n312:         Type::Char => unreachable!(\"Char cannot reach the printer, refused by the checker\"),\n313:         Type::Str => format!(\"JSON.stringify({value})\"),\n314:         // String() on a BigInt is the bare digits, no `n` suffix, so Int64 rides the same arm.\n315:         Type::Int | Type::Int64 | Type::Bool => format!(\"String({value})\"),\n316:         Type::Vec(elem) => {\n317:             let e = format!(\"e{depth}\");\n318:             format!(\n319:                 \"tl_join({value}, ({e}) => {})\",\n320:                 show(enums, elem, &e, depth + 1)\n321:             )\n322:         }\n323:         Type::Enum { .. } if ty.as_opt().is_some() => {\n324:             let inner = ty.as_opt().expect(\"guarded\");\n325:             let v = format!(\"o{depth}\");\n326:             format!(\n327:                 \"(({v}) => {v} === \\\"none\\\" ? \\\"null\\\" : {})({value})\",\n328:                 show(enums, inner, &format!(\"{v}.some\"), depth + 1)\n329:             )\n330:         }\n331:         // A recursive enum prints through a function of its own (`printers`), because expanding\n332:         // one here has no bottom: its payload leads back to the same type.\n333:         Type::Enum { .. } if ty::is_recursive(enums, ty) => format!(\"{}({value})\", ty.show_fn()),\n334:         Type::Enum { .. } => show_enum(enums, ty, value, depth),\n335:         Type::Record(fields) => {\n336:             // The type's field list is declaration order, so this prints as declared. Field\n337:             // names are identifiers, so the JSON key needs no escaping and is one literal.\n338:             let parts: Vec<String> = fields\n339:                 .iter()\n340:                 .map(|(name, fty)| {\n341:                     let read = format!(\"{value}[{}]\", js_string(name));\n342:                     let key = js_string(&format!(\"\\\"{name}\\\":\"));\n343:                     format!(\"{key} + {}\", show(enums, fty, &read, depth + 1))\n344:                 })\n345:                 .collect();\n346:             format!(\"(\\\"{{\\\" + [{}].join(\\\",\\\") + \\\"}}\\\")\", parts.join(\", \"))\n347:         }\n348:     }\n349: }\n350: \n351: /// The printer for one enum, inline. One type, two runtime shapes (ADR 0009): a unit variant is\n352: /// a bare string, a payload variant a single-key object, so the shape is inspected before\n353: /// rendering. Which payload follows which key is still the type's knowledge, as everywhere else.\n354: fn show_enum(enums: &Enums, ty: &Type, value: &str, depth: usize) -> String {\n355:     let variants = ty::variants(enums, ty);\n356:     let n = format!(\"n{depth}\");\n357:     let payloads: Vec<&(String, Option<Type>)> =\n358:         variants.iter().filter(|(_, p)| p.is_some()).collect();\n359:     if payloads.is_empty() {\n360:         return format!(\"JSON.stringify({value})\");\n361:     }\n362:     let mut body = String::new();\n363:     if payloads.len() < variants.len() {\n364:         body.push_str(&format!(\n365:             \"typeof {n} === \\\"string\\\" ? JSON.stringify({n}) : \"\n366:         ));\n367:     }\n368:     for (i, (vname, pty)) in payloads.iter().enumerate() {\n369:         let pty = pty.as_ref().expect(\"filtered to payload variants\");\n370:         let read = format!(\"{n}[{}]\", js_string(vname));\n371:         let wrapped = format!(\n372:             \"({} + {} + \\\"}}\\\")\",\n373:             js_string(&format!(\"{{\\\"{vname}\\\":\")),\n374:             show(enums, pty, &read, depth + 1)\n375:         );\n376:         if i + 1 < payloads.len() {\n377:             body.push_str(&format!(\"{read} !== undefined ? {wrapped} : \"));\n378:         } else {\n379:             // The last payload variant needs no test: the type says nothing else is left.\n380:             body.push_str(&wrapped);\n381:         }\n382:     }\n383:     format!(\"(({n}) => {body})({value})\")\n384: }\n385: \n386: /// A named printer for every recursive enum the program prints. The call in `show` above is\n387: /// what a nested occurrence renders as, so the recursion in the type becomes recursion in the\n388: /// emitted function rather than in this compiler (kantord/toylang#94).\n389: fn printers(program: &Program) -> String {\n390:     let mut out = String::new();\n391:     for ty in tir::printed_recursive_enums(program) {\n392:         out.push_str(&format!(\n393:             \"function {}(v) {{\\n  return {};\\n}}\\n\",\n394:             ty.show_fn(),\n395:             show_enum(&program.enums, &ty, \"v\", 0)\n396:         ));\n397:     }\n398:     out\n399: }\n400: \n401: fn contains_vec(enums: &Enums, ty: &Type) -> bool {\n402:     match ty {\n403:         Type::Vec(_) => true,\n404:         Type::Record(fields) => fields.iter().any(|(_, t)| contains_vec(enums, t)),\n405:         // The Vec arm answers before this one can loop: a self-reference is legal only behind\n406:         // a Vec, so a recursive enum's first payload hop is one.\n407:         Type::Enum { .. } => ty::variants(enums, ty)\n408:             .iter()\n409:             .any(|(_, p)| p.as_ref().is_some_and(|p| contains_vec(enums, p))),\n410:         _ => false,\n411:     }\n412: }\n413: \n414: fn user(name: &str) -> String {\n415:     format!(\"v_{name}\")\n416: }\n417: \n418: fn local(id: LocalId) -> String {\n419:     format!(\"t_{id}\")\n420: }\n421: \n422: #[derive(Default)]\n423: struct Helpers {\n424:     select: bool,\n425:     field: bool,\n426:     index: bool,\n427:     unwrap: bool,\n428:     arith: bool,\n429:     arith64: bool,\n430:     collect: bool,\n431:     jsonlines: bool,\n432:     tail: bool,\n433:     str_cmp: bool,\n434:     chars: bool,\n435:     eq: bool,\n436: }\n437: \n438: /// Which helper a comparison reaches for, decided by the operator and the operand type rather\n439: /// than by anything in the tree below it: ordering on a Str has to step by codepoint, and\n440: /// equality on a composite has to walk the structure.\n441: fn compare_helpers(op: BinOp, operand: &Type, used: &mut Helpers) {\n442:     used.str_cmp |=\n443:         *operand == Type::Str && matches!(op, BinOp::Lt | BinOp::Le | BinOp::Gt | BinOp::Ge);\n444:     used.eq |= operand.is_composite() && matches!(op, BinOp::Eq | BinOp::Ne);\n445: }\n446: \n447: /// Two of the six comparison operators cannot be handed to JS as they are written.\n448: /// `<`/`<=`/`>`/`>=` on native strings compare UTF-16 code units, which disagrees with codepoint\n449: /// order across a surrogate pair, so `tl_str_cmp` steps by codepoint instead; equality is\n450: /// unaffected there (the same codepoints give the same units either way). `===` on two objects\n451: /// is identity, so equality on a composite walks the structure through `tl_eq`\n452: /// (kantord/toylang#68). Ordering on a composite is a separate open question and keeps whatever\n453: /// JS does with it.\n454: fn compare(enums: &Enums, op: BinOp, lhs: &Tir, rhs: &Tir) -> String {\n455:     if lhs.ty.is_composite() && matches!(op, BinOp::Eq | BinOp::Ne) {\n456:         let call = format!(\"tl_eq({}, {})\", expr(enums, lhs), expr(enums, rhs));\n457:         return match op {\n458:             BinOp::Ne => format!(\"(!{call})\"),\n459:             _ => call,\n460:         };\n461:     }\n462:     if lhs.ty == Type::Str && matches!(op, BinOp::Lt | BinOp::Le | BinOp::Gt | BinOp::Ge) {\n463:         return format!(\n464:             \"(tl_str_cmp({}, {}) {} 0)\",\n465:             expr(enums, lhs),\n466:             expr(enums, rhs),\n467:             js_op(op)\n468:         );\n469:     }\n470:     format!(\"({} {} {})\", expr(enums, lhs), js_op(op), expr(enums, rhs))\n471: }\n472: \n473: /// `+` on two arrays stringifies and joins them, so a Vec reaches for `.concat` instead.\n474: fn concat(enums: &Enums, ty: &Type, l: &Tir, r: &Tir) -> String {\n475:     match ty {\n476:         Type::Vec(_) => format!(\"{}.concat({})\", expr(enums, l), expr(enums, r)),\n477:         _ => format!(\"({} + {})\", expr(enums, l), expr(enums, r)),\n478:     }\n479: }\n480: \n481: fn used_helpers(program: &Program) -> Helpers {\n482:     fn walk(t: &Tir, used: &mut Helpers) {\n483:         match &t.kind {\n484:             Kind::Str(_)\n485:             | Kind::Int(_)\n486:             | Kind::Var(_)\n487:             | Kind::Local(_)\n488:             | Kind::Input\n489:             | Kind::Inputs => {}\n490:             // The source is what reads stdin now, so it is what needs the helper.\n491:             Kind::Lines => used.collect = true,\n492:             Kind::VecLit(items) => items.iter().for_each(|i| walk(i, used)),\n493:             Kind::RecordLit { fields } => {\n494:                 fields.iter().for_each(|(_, v)| walk(v, used));\n495:             }\n496:             // A variant's payload and a call's argument are the same shape here -- one optional\n497:             // child, recursed into and nothing else -- so they share the arm.\n498:             Kind::EnumLit { payload: child, .. } | Kind::Call { arg: child, .. } => {\n499:                 if let Some(c) = child {\n500:                     walk(c, used);\n501:                 }\n502:             }\n503:             Kind::Concat(l, r) | Kind::Logic { lhs: l, rhs: r, .. } => {\n504:                 walk(l, used);\n505:                 walk(r, used);\n506:             }\n507:             Kind::Compare { op, lhs: l, rhs: r } => {\n508:                 compare_helpers(*op, &l.ty, used);\n509:                 walk(l, used);\n510:                 walk(r, used);\n511:             }\n512:             Kind::Bind { value, body, .. } => {\n513:                 walk(value, used);\n514:                 walk(body, used);\n515:             }\n516:             Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n517:                 walk(source, used);\n518:                 walk(body, used);\n519:             }\n520:             Kind::Select { source, pred, .. } => {\n521:                 used.select = true;\n522:                 walk(source, used);\n523:                 walk(pred, used);\n524:             }\n525:             Kind::Field { base, .. } => {\n526:                 used.field |= tir::vec_depth(&base.ty) > 0;\n527:                 walk(base, used);\n528:             }\n529:             Kind::Builtin { which, arg } => {\n530:                 used.jsonlines |= *which == Builtin::JsonLines;\n531:                 used.tail |= *which == Builtin::Tail;\n532:                 used.chars |= *which == Builtin::Chars;\n533:                 used.str_cmp |=\n534:                     *which == Builtin::Sort && tir::runtime_elem(&arg.ty) == Some(&Type::Str);\n535:                 walk(arg, used);\n536:             }\n537:             Kind::Cond {\n538:                 cond,\n539:                 then,\n540:                 otherwise,\n541:             } => {\n542:                 walk(cond, used);\n543:                 walk(then, used);\n544:                 walk(otherwise, used);\n545:             }\n546:             Kind::Arith { lhs, rhs, .. } => {\n547:                 if t.ty == Type::Int64 {\n548:                     used.arith64 = true;\n549:                 } else {\n550:                     used.arith = true;\n551:                 }\n552:                 walk(lhs, used);\n553:                 walk(rhs, used);\n554:             }\n555:             Kind::Not(base) => walk(base, used),\n556:             Kind::Unwrap { base } => {\n557:                 used.unwrap = true;\n558:                 walk(base, used);\n559:             }\n560:             Kind::Index { base, index, .. } => {\n561:                 used.index = true;\n562:                 walk(base, used);\n563:                 walk(index, used);\n564:             }\n565:             Kind::Match { subject, arms, .. } => {\n566:                 walk(subject, used);\n567:                 for a in arms {\n568:                     if let Some(g) = &a.guard {\n569:                         walk(g, used);\n570:                     }\n571:                     walk(&a.body, used);\n572:                 }\n573:             }\n574:         }\n575:     }\n576:     let mut used = Helpers::default();\n577:     program.funcs.iter().for_each(|f| walk(&f.body, &mut used));\n578:     walk(&program.body, &mut used);\n579:     used\n580: }\n581: \n582: /// A partial chain's yield is an Opt, so a present arm is tagged; total chains return the\n583: /// body bare. Split out of `expr`'s match arm (kantord/toylang#62).\n584: fn arm_return(body: String, partial: bool) -> String {\n585:     if partial {\n586:         format!(\"return {{some: {body}}}; \")\n587:     } else {\n588:         format!(\"return {body}; \")\n589:     }\n590: }\n591: \n592: fn expr(enums: &Enums, t: &Tir) -> String {\n593:     match &t.kind {\n594:         Kind::Str(s) => js_string(s),\n595:         Kind::Int(n) => int_lit(&t.ty, *n),\n596:         Kind::Var(name) => user(name),\n597:         Kind::Local(id) => local(*id),\n598:         Kind::Input => INPUT.to_string(),\n599:         Kind::Inputs => INPUTS.to_string(),\n600:         // The stream, materialized eagerly: whatever consumes it -- `collect`, a mapper --\n601:         // works on the array of its entries. Fusion is what will remove this materialization.\n602:         Kind::Lines => \"tl_collect_lines()\".to_string(),\n603:         Kind::RecordLit { fields } => {\n604:             let parts: Vec<String> = fields\n605:                 .iter()\n606:                 .map(|(name, value)| format!(\"{}: {}\", js_string(name), expr(enums, value)))\n607:                 .collect();\n608:             // Parenthesised because a brace opening an arrow function's body is a block, so\n609:             // `(e) => {a: 1}` is a labelled statement rather than an object.\n610:             format!(\"({{{}}})\", parts.join(\", \"))\n611:         }\n612: \n613:         // The value is its JSON shape: a unit variant is the variant-name string, a payload\n614:         // variant the single-key object a record already is.\n615:         Kind::EnumLit { variant, payload } => match payload {\n616:             None => js_string(variant),\n617:             Some(p) => format!(\"({{{}: {}}})\", js_string(variant), expr(enums, p)),\n618:         },\n619: \n620:         Kind::VecLit(items) => {\n621:             let parts: Vec<String> = items.iter().map(|i| expr(enums, i)).collect();\n622:             format!(\"[{}]\", parts.join(\", \"))\n623:         }\n624:         Kind::Call { func, arg } => format!(\n625:             \"{}({})\",\n626:             user(func),\n627:             arg.as_deref().map_or_else(String::new, |a| expr(enums, a))\n628:         ),\n629:         Kind::Concat(l, r) => concat(enums, &t.ty, l, r),\n630:         Kind::Arith { op, lhs, rhs } => arith(&t.ty, *op, expr(enums, lhs), expr(enums, rhs)),\n631:         Kind::Cond {\n632:             cond,\n633:             then,\n634:             otherwise,\n635:         } => {\n636:             format!(\n637:                 \"({} ? {} : {})\",\n638:                 expr(enums, cond),\n639:                 expr(enums, then),\n640:                 expr(enums, otherwise)\n641:             )\n642:         }\n643:         Kind::Logic { op, lhs, rhs } => {\n644:             let op = match op {\n645:                 LogicOp::And => \"&&\",\n646:                 LogicOp::Or => \"||\",\n647:             };\n648:             format!(\"({} {op} {})\", expr(enums, lhs), expr(enums, rhs))\n649:         }\n650:         Kind::Not(base) => format!(\"(!{})\", expr(enums, base)),\n651:         Kind::Builtin { which, arg } => match which {\n652:             Builtin::IntToStr => format!(\"String({})\", expr(enums, arg)),\n653:             // The one real conversion among the backends: an Int is a number and an Int64 is\n654:             // a BigInt, and BigInt() of a 32-bit integer is always exact.\n655:             Builtin::IntToI64 => format!(\"BigInt({})\", expr(enums, arg)),\n656:             Builtin::Chars => format!(\"tl_chars({})\", expr(enums, arg)),\n657:             Builtin::Range => {\n658:                 format!(\n659:                     \"Array.from({{ length: Math.max(0, {}) }}, (_, i) => i)\",\n660:                     expr(enums, arg)\n661:                 )\n662:             }\n663:             Builtin::JsonLines => {\n664:                 let elem = tir::runtime_elem(&arg.ty).expect(\"checked to be a Vec or a stream\");\n665:                 let e = \"e0\".to_string();\n666:                 format!(\n667:                     \"tl_jsonlines({}, ({e}) => {})\",\n668:                     expr(enums, arg),\n669:                     show(enums, elem, &e, 1)\n670:                 )\n671:             }\n672:             // The source already materialized, so the exit has nothing left to do.\n673:             Builtin::Collect => expr(enums, arg),\n674:             Builtin::Length => format!(\"{}.length\", expr(enums, arg)),\n675:             Builtin::Tail => format!(\"tl_tail({})\", expr(enums, arg)),\n676:             Builtin::Flatten => format!(\"{}.flat()\", expr(enums, arg)),\n677:             // `Array.prototype.sort`'s default comparator stringifies, which is wrong for\n678:             // numbers; `tl_str_cmp` already returns the -1/0/1 a comparator wants, so it can be\n679:             // passed straight through for Str.\n680:             Builtin::Sort => {\n681:                 let elem = tir::runtime_elem(&arg.ty).expect(\"checked to be a Vec\");\n682:                 if *elem == Type::Str {\n683:                     format!(\"[...{}].sort(tl_str_cmp)\", expr(enums, arg))\n684:                 } else {\n685:                     // `a - b` would coerce the comparator's result with ToNumber, which\n686:                     // throws on BigInt -- and Int64 is BigInt here. The three-way compare\n687:                     // returns plain -1/0/1 for Number and BigInt alike.\n688:                     format!(\n689:                         \"[...{}].sort((a, b) => a < b ? -1 : a > b ? 1 : 0)\",\n690:                         expr(enums, arg)\n691:                     )\n692:                 }\n693:             }\n694:             // `.reverse()` mutates in place, so the spread copy is what keeps this an ordinary\n695:             // expression rather than a statement with a visible side effect on `arg`.\n696:             Builtin::Reverse => format!(\"[...{}].reverse()\", expr(enums, arg)),\n697:             // The names come from the checked type, not the object value, so `arg` is evaluated\n698:             // only for whatever else it does (a division inside it must still throw) and its\n699:             // value discarded with the comma operator.\n700:             Builtin::Fields => {\n701:                 let Type::Record(fields) = &arg.ty else {\n702:                     unreachable!(\"checked to be a record\")\n703:                 };\n704:                 let names: Vec<String> = fields.iter().map(|(n, _)| js_string(n)).collect();\n705:                 format!(\"({}, [{}])\", expr(enums, arg), names.join(\", \"))\n706:             }\n707:         },\n708:         Kind::Compare { op, lhs, rhs } => compare(enums, *op, lhs, rhs),\n709:         Kind::Bind {\n710:             local: id,\n711:             value,\n712:             body,\n713:         } => {\n714:             format!(\n715:                 \"(({}) => {})({})\",\n716:                 local(*id),\n717:                 expr(enums, body),\n718:                 expr(enums, value)\n719:             )\n720:         }\n721:         // Array.prototype.map is exactly this, so no helper is needed.\n722:         Kind::Map {\n723:             source,\n724:             param,\n725:             body,\n726:         } => {\n727:             format!(\n728:                 \"{}.map(({}) => {})\",\n729:                 expr(enums, source),\n730:                 local(*param),\n731:                 expr(enums, body)\n732:             )\n733:         }\n734:         Kind::Select {\n735:             source,\n736:             param,\n737:             pred,\n738:         } => {\n739:             format!(\n740:                 \"tl_select({}, ({}) => {})\",\n741:                 expr(enums, source),\n742:                 local(*param),\n743:                 expr(enums, pred)\n744:             )\n745:         }\n746:         // Opt's reorder pass (kantord/toylang#66): the tagged shape (`\"none\"` or `{some: v}`)\n747:         // is generic enough that this is the ordinary key-presence test every Match arm over\n748:         // an Opt subject would already use, just rebuilding the payload instead of a body.\n749:         Kind::OptMap {\n750:             source,\n751:             param,\n752:             body,\n753:         } => {\n754:             format!(\n755:                 \"(__opt => __opt === \\\"none\\\" ? \\\"none\\\" : (({}) => ({{some: {}}}))(__opt.some))({})\",\n756:                 local(*param),\n757:                 expr(enums, body),\n758:                 expr(enums, source)\n759:             )\n760:         }\n761:         Kind::Unwrap { base } => {\n762:             format!(\n763:                 \"tl_unwrap({}, {})\",\n764:                 expr(enums, base),\n765:                 tir::vec_depth(&base.ty)\n766:             )\n767:         }\n768:         Kind::Index {\n769:             base, index, depth, ..\n770:         } => {\n771:             format!(\n772:                 \"tl_at({}, {}, {})\",\n773:                 expr(enums, base),\n774:                 expr(enums, index),\n775:                 depth\n776:             )\n777:         }\n778:         Kind::Field { base, name } => {\n779:             let depth = tir::vec_depth(&base.ty);\n780:             if depth == 0 {\n781:                 format!(\"{}[{}]\", expr(enums, base), js_string(name))\n782:             } else {\n783:                 format!(\n784:                     \"tl_field({}, {}, {})\",\n785:                     expr(enums, base),\n786:                     js_string(name),\n787:                     depth\n788:                 )\n789:             }\n790:         }\n791:         // A chain of tests over the subject (a plain local, so re-reading it is free): string\n792:         // equality for a unit variant, key presence for a payload variant, the guard's own\n793:         // Bool for a guard arm. A total chain's last arm needs no test, the checker having\n794:         // proved nothing else can reach it; a partial chain tags every present arm and falls\n795:         // through to the absent Opt.\n796:         Kind::Match {\n797:             subject,\n798:             arms,\n799:             partial,\n800:         } => {\n801:             let subj = expr(enums, subject);\n802:             let mut body = String::new();\n803:             for (i, arm) in arms.iter().enumerate() {\n804:                 let mut run = String::new();\n805:                 if let Some(pid) = arm.payload {\n806:                     let variant = arm\n807:                         .variant\n808:                         .as_ref()\n809:                         .expect(\"only a variant arm has a payload\");\n810:                     run.push_str(&format!(\n811:                         \"const {} = {subj}[{}]; \",\n812:                         local(pid),\n813:                         js_string(variant)\n814:                     ));\n815:                 }\n816:                 run.push_str(&arm_return(expr(enums, &arm.body), *partial));\n817:                 let test = match (&arm.variant, &arm.guard) {\n818:                     (Some(v), _) if arm.payload.is_some() => {\n819:                         Some(format!(\"{subj}[{}] !== undefined\", js_string(v)))\n820:                     }\n821:                     (Some(v), _) => Some(format!(\"{subj} === {}\", js_string(v))),\n822:                     (None, Some(g)) => Some(expr(enums, g)),\n823:                     (None, None) => None,\n824:                 };\n825:                 match test {\n826:                     Some(test) if *partial || i + 1 < arms.len() => {\n827:                         body.push_str(&format!(\"if ({test}) {{ {run}}} \"));\n828:                     }\n829:                     _ => body.push_str(&run),\n830:                 }\n831:             }\n832:             if *partial {\n833:                 body.push_str(\"return \\\"none\\\"; \");\n834:             }\n835:             format!(\"(() => {{ {body}}})()\")\n836:         }\n837:     }\n838: }\n839: \n840: /// The node's type picks the literal's representation (kantord/toylang#83): an Int64 literal\n841: /// is a BigInt literal, exact at every written value where a bare number would already have\n842: /// rounded past 2^53.\n843: fn int_lit(ty: &Type, n: i64) -> String {\n844:     if *ty == Type::Int64 {\n845:         format!(\"{n}n\")\n846:     } else {\n847:         n.to_string()\n848:     }\n849: }\n850: \n851: /// One arithmetic expression at the width the node's type names. BigInt operators are exact\n852: /// at any width, so on the 64-bit side only the wrap needs spelling -- Math.imul has no\n853: /// 64-bit sibling and none is needed.\n854: fn arith(ty: &Type, op: BinOp, l: String, r: String) -> String {\n855:     if *ty == Type::Int64 {\n856:         match op {\n857:             BinOp::Div => format!(\"tl_div64({l}, {r})\"),\n858:             BinOp::Rem => format!(\"tl_rem64({l}, {r})\"),\n859:             BinOp::Mul => format!(\"BigInt.asIntN(64, {l} * {r})\"),\n860:             BinOp::Add => format!(\"BigInt.asIntN(64, {l} + {r})\"),\n861:             BinOp::Sub => format!(\"BigInt.asIntN(64, {l} - {r})\"),\n862:             other => unreachable!(\"{other} is not arithmetic\"),\n863:         }\n864:     } else {\n865:         match op {\n866:             BinOp::Div => format!(\"tl_div({l}, {r})\"),\n867:             BinOp::Rem => format!(\"tl_rem({l}, {r})\"),\n868:             // Math.imul is the only exact 32-bit multiply here: a plain `*` loses the low\n869:             // bits once the true product passes 2^53.\n870:             BinOp::Mul => format!(\"Math.imul({l}, {r})\"),\n871:             BinOp::Add => format!(\"(({l} + {r}) | 0)\"),\n872:             BinOp::Sub => format!(\"(({l} - {r}) | 0)\"),\n873:             other => unreachable!(\"{other} is not arithmetic\"),\n874:         }\n875:     }\n876: }\n877: \n878: fn js_op(op: BinOp) -> &'static str {\n879:     match op {\n880:         BinOp::Eq => \"===\",\n881:         BinOp::Ne => \"!==\",\n882:         BinOp::Lt => \"<\",\n883:         BinOp::Le => \"<=\",\n884:         BinOp::Gt => \">\",\n885:         BinOp::Ge => \">=\",\n886:         other => unreachable!(\"{other} is not a comparison\"),\n887:     }\n888: }\n889: \n890: fn js_string(s: &str) -> String {\n891:     let mut out = String::with_capacity(s.len() + 2);\n892:     out.push('\"');\n893:     for c in s.chars() {\n894:         match c {\n895:             '\"' => out.push_str(\"\\\\\\\"\"),\n896:             '\\\\' => out.push_str(\"\\\\\\\\\"),\n897:             '\\n' => out.push_str(\"\\\\n\"),\n898:             '\\r' => out.push_str(\"\\\\r\"),\n899:             '\\t' => out.push_str(\"\\\\t\"),\n900:             // U+2028 and U+2029 are line terminators in JavaScript but not in JSON, so a string\n901:             // containing them would end the literal early if written through.\n902:             c if (c as u32) < 0x20 || c == '\\u{7f}' || c == '\\u{2028}' || c == '\\u{2029}' => {\n903:                 out.push_str(&format!(\"\\\\u{:04x}\", c as u32));\n904:             }\n905:             c => out.push(c),\n906:         }\n907:     }\n908:     out.push('\"');\n909:     out\n910: }\n\n(End of file - total 910 lines)\n</content>","metadata":{"preview":"use crate::ast::{BinOp, LogicOp};\nuse crate::tir::{self, Builtin, Kind, LocalId, Program, Tir};\nuse crate::ty::{self, Enums, Type};\n\n/// The binding the input value is read into. Unspellable in source, since every source name is\n/// prefixed.\nconst INPUT: &str = \"t_input\";\nconst INPUTS: &str = \"t_inputs\";\n\nconst SELECT_HELPER: &str = \"\\\nfunction tl_select(src, pred) {\n  const out = [];\n  for (let i = 0; i < src.length; i++) if (pred(src[i])) out.push(src[i]);\n  return out;\n}\n\";\n\nconst FIELD_HELPER: &str = \"\\\nfunction tl_field(v, k, depth) {\n  if (depth === 0) return v[k];","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-149/src/emit_js.rs","text":"use crate::ast::{BinOp, LogicOp};\nuse crate::tir::{self, Builtin, Kind, LocalId, Program, Tir};\nuse crate::ty::{self, Enums, Type};\n\n/// The binding the input value is read into. Unspellable in source, since every source name is\n/// prefixed.\nconst INPUT: &str = \"t_input\";\nconst INPUTS: &str = \"t_inputs\";\n\nconst SELECT_HELPER: &str = \"\\\nfunction tl_select(src, pred) {\n  const out = [];\n  for (let i = 0; i < src.length; i++) if (pred(src[i])) out.push(src[i]);\n  return out;\n}\n\";\n\nconst FIELD_HELPER: &str = \"\\\nfunction tl_field(v, k, depth) {\n  if (depth === 0) return v[k];\n  const out = [];\n  for (let i = 0; i < v.length; i++) out[i] = tl_field(v[i], k, depth - 1);\n  return out;\n}\n\";\n\nconst OPT_HELPER: &str = \"\\\n// An Opt is its enum's own runtime shape (ADR 0009): `{some: v}` present, \\\"none\\\" absent.\n// Tagged, so two levels of absence stay two values; only the printer flattens to null.\nfunction tl_at(v, i, depth) {\n  if (depth > 0) return v.map((e) => tl_at(e, i, depth - 1));\n  const n = v.length;\n  if (i < 0) i = n + i;\n  if (i < 0 || i >= n) return \\\"none\\\";\n  return { some: v[i] };\n}\n\";\n\nconst TAIL_HELPER: &str = \"\\\nfunction tl_tail(v) {\n  if (v.length === 0) return \\\"none\\\";\n  return { some: v.slice(1) };\n}\n\";\n\nconst UNWRAP_HELPER: &str = r#\"function tl_unwrap(v, depth) {\n  if (depth > 0) return v.map((e) => tl_unwrap(e, depth - 1));\n  if (v === \"none\") { throw new Error(\"toylang: unwrapped a value that is not there\"); }\n  return v.some;\n}\n\"#;\n\nconst ARITH_HELPER: &str = r#\"// `|0` is ToInt32: it wraps to 32 bits and truncates toward zero, and V8 folds it away once it\n// knows the value is already a Smi.\nfunction tl_div(a, b) {\n  if (b === 0) { throw new Error(\"toylang: divided by zero\"); }\n  return (a / b) | 0;\n}\nfunction tl_rem(a, b) {\n  if (b === 0) { throw new Error(\"toylang: divided by zero\"); }\n  return (a % b) | 0;\n}\n\"#;\n\n// An Int64 is a BigInt (kantord/toylang#83): a double is off past 2^53, and BigInt's own `/`\n// and `%` already truncate with the dividend's sign. `BigInt.asIntN(64, ...)` is the wrap,\n// including `MIN / -1` back to `MIN`.\nconst ARITH64_HELPER: &str = r#\"function tl_div64(a, b) {\n  if (b === 0n) { throw new Error(\"toylang: divided by zero\"); }\n  return BigInt.asIntN(64, a / b);\n}\nfunction tl_rem64(a, b) {\n  if (b === 0n) { throw new Error(\"toylang: divided by zero\"); }\n  return BigInt.asIntN(64, a % b);\n}\n\"#;\n\nconst COLLECT_HELPER: &str = r#\"// Synchronous, because a toylang expression evaluates to completion and node has no\n// synchronous line reader built in. Reads in fixed chunks off the real fd rather than\n// `readFileSync(0)`, so a line is available to the rest of the program as soon as it arrives\n// rather than only once stdin closes.\nfunction tl_collect_lines() {\n  const fs = require(\"fs\");\n  const out = [];\n  let buf = \"\";\n  const chunk = Buffer.alloc(65536);\n  for (;;) {\n    const n = fs.readSync(0, chunk, 0, chunk.length, null);\n    if (n === 0) break;\n    buf += chunk.toString(\"utf8\", 0, n);\n    let i;\n    while ((i = buf.indexOf(\"\\n\")) !== -1) {\n      out.push(buf.slice(0, i));\n      buf = buf.slice(i + 1);\n    }\n  }\n  if (buf.length > 0) out.push(buf);\n  return out;\n}\n\"#;\n\nconst JOIN_HELPER: &str = \"\\\nfunction tl_join(v, f) {\n  const parts = [];\n  for (let i = 0; i < v.length; i++) parts.push(f(v[i]));\n  return \\\"[\\\" + parts.join(\\\",\\\") + \\\"]\\\";\n}\n\";\n\n// JS string comparison compares UTF-16 code units, which disagrees with codepoint order on any\n// pair straddling a surrogate pair: a BMP character above U+DFFF (e.g. U+E000) sorts below an\n// astral character's lead surrogate even though its codepoint is smaller. Iterating with the\n// string iterator (rather than indexing) steps one codepoint at a time, surrogate pairs included.\nconst STR_CMP_HELPER: &str = \"\\\nfunction tl_str_cmp(a, b) {\n  const ai = a[Symbol.iterator]();\n  const bi = b[Symbol.iterator]();\n  for (;;) {\n    const x = ai.next();\n    const y = bi.next();\n    if (x.done || y.done) return (x.done ? 0 : 1) - (y.done ? 0 : 1);\n    const cx = x.value.codePointAt(0);\n    const cy = y.value.codePointAt(0);\n    if (cx !== cy) return cx < cy ? -1 : 1;\n  }\n}\n\";\n\n// A record and a payload-carrying variant are both objects, and JS `===` on two objects is\n// identity, so `{a: 1} === {a: 1}` was false here and true on Python (kantord/toylang#68).\n// Structural equality is the ratified answer, so composites walk. Keyed rather than ordered:\n// two spellings of one record type may reach here with their keys in different orders.\nconst EQ_HELPER: &str = \"\\\nfunction tl_eq(a, b) {\n  if (a === b) return true;\n  if (typeof a !== \\\"object\\\" || a === null || typeof b !== \\\"object\\\" || b === null) return false;\n  const keys = Object.keys(a);\n  if (keys.length !== Object.keys(b).length) return false;\n  return keys.every((k) => Object.hasOwn(b, k) && tl_eq(a[k], b[k]));\n}\n\";\n\nconst JSONLINES_HELPER: &str = \"\\\nfunction tl_jsonlines(v, f) {\n  const parts = [];\n  for (let i = 0; i < v.length; i++) parts.push(f(v[i]));\n  return parts.join(\\\"\\\\n\\\");\n}\n\";\n\n// The string iterator steps one codepoint at a time, surrogate pairs included (the same\n// iterator STR_CMP_HELPER uses above), so there is no decoding to get right here.\nconst CHARS_HELPER: &str = \"\\\nfunction tl_chars(s) {\n  return Array.from(s, (c) => c.codePointAt(0));\n}\n\";\n\npub fn emit(program: &Program) -> String {\n    let enums = &program.enums;\n    let mut out = String::new();\n\n    let used = used_helpers(program);\n    let join = matches!(program.body.ty, Type::Vec(_))\n        || contains_vec(enums, &program.body.ty)\n        || used.jsonlines;\n    for (on, text) in [\n        (used.select, SELECT_HELPER),\n        (used.field, FIELD_HELPER),\n        (join, JOIN_HELPER),\n        (used.index, OPT_HELPER),\n        (used.tail, TAIL_HELPER),\n        (used.unwrap, UNWRAP_HELPER),\n        (used.arith, ARITH_HELPER),\n        (used.arith64, ARITH64_HELPER),\n        (used.collect, COLLECT_HELPER),\n        (used.jsonlines, JSONLINES_HELPER),\n        (used.str_cmp, STR_CMP_HELPER),\n        (used.chars, CHARS_HELPER),\n        (used.eq, EQ_HELPER),\n    ] {\n        if on {\n            out.push_str(text);\n        }\n    }\n    out.push_str(&printers(program));\n\n    // Function declarations hoist, so a call to one defined further down resolves without the\n    // forward declarations Lua needs. Each backend does what its own target does.\n    for f in &program.funcs {\n        out.push_str(&format!(\n            \"function {}({}) {{\\n  return {};\\n}}\\n\",\n            user(&f.name),\n            f.param.as_deref().map_or_else(String::new, user),\n            expr(enums, &f.body)\n        ));\n    }\n\n    if let Some(fusion) = tir::fusion(program) {\n        out.push_str(&fused_main(program, &fusion));\n        return out;\n    }\n\n    if program.input.is_some() {\n        out.push_str(&format!(\n            \"const {INPUT} = JSON.parse(require(\\\"fs\\\").readFileSync(0, \\\"utf8\\\"));\\n\"\n        ));\n    }\n    if program.inputs.is_some() {\n        out.push_str(&format!(\n            \"const {INPUTS} = require(\\\"fs\\\").readFileSync(0, \\\"utf8\\\").split(\\\"\\\\n\\\").filter((l) => l.length > 0).map((l) => JSON.parse(l));\\n\"\n        ));\n    }\n\n    let body = expr(enums, &program.body);\n    // A top-level Str prints raw, the way jq's -r does; anything else prints as JSON.\n    if program.body.ty == Type::Str {\n        out.push_str(&format!(\"console.log({body});\\n\"));\n    } else {\n        out.push_str(&format!(\n            \"console.log({});\\n\",\n            show(enums, &program.body.ty, &body, 0)\n        ));\n    }\n    out\n}\n\n/// A stream-typed `jsonlines` program, compiled as a loop reading one line at a time off the\n/// real fd rather than `readFileSync(0)`'s read-everything-first.\n///\n/// `process.stdout.write` is synchronous to a file or TTY on POSIX but asynchronous to a pipe --\n/// queued rather than issued immediately -- and the very next thing this loop does is a\n/// *synchronous* read that blocks the whole event loop, which risks stopping a queued write from\n/// ever reaching the pipe before the process blocks again. `tests/streaming.rs`'s `js_streams`\n/// checks this directly against a live pipe rather than assuming either way.\nfn fused_main(program: &Program, fusion: &tir::Fusion) -> String {\n    let enums = &program.enums;\n    let mut out = String::new();\n    out.push_str(\"let tl_stdin_buf = \\\"\\\";\\n\");\n    out.push_str(\"let tl_stdin_eof = false;\\n\");\n    out.push_str(\"function tl_read_line() {\\n\");\n    out.push_str(\"  const fs = require(\\\"fs\\\");\\n\");\n    out.push_str(\"  for (;;) {\\n\");\n    out.push_str(\"    const i = tl_stdin_buf.indexOf(\\\"\\\\n\\\");\\n\");\n    out.push_str(\"    if (i !== -1) {\\n\");\n    out.push_str(\"      const line = tl_stdin_buf.slice(0, i);\\n\");\n    out.push_str(\"      tl_stdin_buf = tl_stdin_buf.slice(i + 1);\\n\");\n    out.push_str(\"      return line;\\n\");\n    out.push_str(\"    }\\n\");\n    out.push_str(\"    if (tl_stdin_eof) {\\n\");\n    out.push_str(\"      if (tl_stdin_buf.length === 0) return null;\\n\");\n    out.push_str(\"      const line = tl_stdin_buf;\\n\");\n    out.push_str(\"      tl_stdin_buf = \\\"\\\";\\n\");\n    out.push_str(\"      return line;\\n\");\n    out.push_str(\"    }\\n\");\n    out.push_str(\"    const chunk = Buffer.alloc(65536);\\n\");\n    out.push_str(\"    const n = fs.readSync(0, chunk, 0, chunk.length, null);\\n\");\n    out.push_str(\"    if (n === 0) { tl_stdin_eof = true; continue; }\\n\");\n    out.push_str(\"    tl_stdin_buf += chunk.toString(\\\"utf8\\\", 0, n);\\n\");\n    out.push_str(\"  }\\n\");\n    out.push_str(\"}\\n\");\n\n    out.push_str(\"for (;;) {\\n\");\n    out.push_str(\"  const t_line_raw = tl_read_line();\\n\");\n    out.push_str(\"  if (t_line_raw === null) break;\\n\");\n    let (mut current, mut current_ty) = match fusion.source {\n        tir::Source::Inputs => {\n            out.push_str(\"  if (t_line_raw.length === 0) continue;\\n\");\n            out.push_str(\"  const t_line = JSON.parse(t_line_raw);\\n\");\n            let elem = program\n                .inputs\n                .as_ref()\n                .expect(\"an inputs source recorded its element\");\n            (\"t_line\".to_string(), elem.clone())\n        }\n        // A raw line is already the element, blank ones included: `lines` keeps them.\n        tir::Source::Lines => (\"t_line_raw\".to_string(), Type::Str),\n    };\n    for stage in &fusion.stages {\n        match stage {\n            tir::Stage::Map { param, body } => {\n                out.push_str(&format!(\"  const {} = {};\\n\", local(*param), current));\n                current = expr(enums, body);\n                current_ty = body.ty.clone();\n            }\n            tir::Stage::Select { param, pred } => {\n                out.push_str(&format!(\"  const {} = {};\\n\", local(*param), current));\n                out.push_str(&format!(\"  if (!({})) continue;\\n\", expr(enums, pred)));\n                current = local(*param);\n            }\n        }\n    }\n    out.push_str(&format!(\n        \"  console.log({});\\n\",\n        show(enums, &current_ty, &current, 0)\n    ));\n    out.push_str(\"}\\n\");\n    out\n}\n\n/// The printer is built from the type rather than by inspecting the value, so a record's keys\n/// are known and ordered at compile time, in declaration order. That removes the whole class\n/// of disagreement where one backend enumerates keys in insertion order and another sorts\n/// them, and it is what a native backend will have to do anyway, having no runtime type\n/// information at all.\nfn show(enums: &Enums, ty: &Type, value: &str, depth: usize) -> String {\n    match ty {\n        Type::Param(_) => unreachable!(\"params are substituted before emit\"),\n        // The checker refuses a program whose result contains a stream, since there is nothing to\n        // print: a stream has no value, only a promise that collect can redeem.\n        Type::Stream(_) => unreachable!(\"a stream cannot reach the printer\"),\n        Type::Char => unreachable!(\"Char cannot reach the printer, refused by the checker\"),\n        Type::Str => format!(\"JSON.stringify({value})\"),\n        // String() on a BigInt is the bare digits, no `n` suffix, so Int64 rides the same arm.\n        Type::Int | Type::Int64 | Type::Bool => format!(\"String({value})\"),\n        Type::Vec(elem) => {\n            let e = format!(\"e{depth}\");\n            format!(\n                \"tl_join({value}, ({e}) => {})\",\n                show(enums, elem, &e, depth + 1)\n            )\n        }\n        Type::Enum { .. } if ty.as_opt().is_some() => {\n            let inner = ty.as_opt().expect(\"guarded\");\n            let v = format!(\"o{depth}\");\n            format!(\n                \"(({v}) => {v} === \\\"none\\\" ? \\\"null\\\" : {})({value})\",\n                show(enums, inner, &format!(\"{v}.some\"), depth + 1)\n            )\n        }\n        // A recursive enum prints through a function of its own (`printers`), because expanding\n        // one here has no bottom: its payload leads back to the same type.\n        Type::Enum { .. } if ty::is_recursive(enums, ty) => format!(\"{}({value})\", ty.show_fn()),\n        Type::Enum { .. } => show_enum(enums, ty, value, depth),\n        Type::Record(fields) => {\n            // The type's field list is declaration order, so this prints as declared. Field\n            // names are identifiers, so the JSON key needs no escaping and is one literal.\n            let parts: Vec<String> = fields\n                .iter()\n                .map(|(name, fty)| {\n                    let read = format!(\"{value}[{}]\", js_string(name));\n                    let key = js_string(&format!(\"\\\"{name}\\\":\"));\n                    format!(\"{key} + {}\", show(enums, fty, &read, depth + 1))\n                })\n                .collect();\n            format!(\"(\\\"{{\\\" + [{}].join(\\\",\\\") + \\\"}}\\\")\", parts.join(\", \"))\n        }\n    }\n}\n\n/// The printer for one enum, inline. One type, two runtime shapes (ADR 0009): a unit variant is\n/// a bare string, a payload variant a single-key object, so the shape is inspected before\n/// rendering. Which payload follows which key is still the type's knowledge, as everywhere else.\nfn show_enum(enums: &Enums, ty: &Type, value: &str, depth: usize) -> String {\n    let variants = ty::variants(enums, ty);\n    let n = format!(\"n{depth}\");\n    let payloads: Vec<&(String, Option<Type>)> =\n        variants.iter().filter(|(_, p)| p.is_some()).collect();\n    if payloads.is_empty() {\n        return format!(\"JSON.stringify({value})\");\n    }\n    let mut body = String::new();\n    if payloads.len() < variants.len() {\n        body.push_str(&format!(\n            \"typeof {n} === \\\"string\\\" ? JSON.stringify({n}) : \"\n        ));\n    }\n    for (i, (vname, pty)) in payloads.iter().enumerate() {\n        let pty = pty.as_ref().expect(\"filtered to payload variants\");\n        let read = format!(\"{n}[{}]\", js_string(vname));\n        let wrapped = format!(\n            \"({} + {} + \\\"}}\\\")\",\n            js_string(&format!(\"{{\\\"{vname}\\\":\")),\n            show(enums, pty, &read, depth + 1)\n        );\n        if i + 1 < payloads.len() {\n            body.push_str(&format!(\"{read} !== undefined ? {wrapped} : \"));\n        } else {\n            // The last payload variant needs no test: the type says nothing else is left.\n            body.push_str(&wrapped);\n        }\n    }\n    format!(\"(({n}) => {body})({value})\")\n}\n\n/// A named printer for every recursive enum the program prints. The call in `show` above is\n/// what a nested occurrence renders as, so the recursion in the type becomes recursion in the\n/// emitted function rather than in this compiler (kantord/toylang#94).\nfn printers(program: &Program) -> String {\n    let mut out = String::new();\n    for ty in tir::printed_recursive_enums(program) {\n        out.push_str(&format!(\n            \"function {}(v) {{\\n  return {};\\n}}\\n\",\n            ty.show_fn(),\n            show_enum(&program.enums, &ty, \"v\", 0)\n        ));\n    }\n    out\n}\n\nfn contains_vec(enums: &Enums, ty: &Type) -> bool {\n    match ty {\n        Type::Vec(_) => true,\n        Type::Record(fields) => fields.iter().any(|(_, t)| contains_vec(enums, t)),\n        // The Vec arm answers before this one can loop: a self-reference is legal only behind\n        // a Vec, so a recursive enum's first payload hop is one.\n        Type::Enum { .. } => ty::variants(enums, ty)\n            .iter()\n            .any(|(_, p)| p.as_ref().is_some_and(|p| contains_vec(enums, p))),\n        _ => false,\n    }\n}\n\nfn user(name: &str) -> String {\n    format!(\"v_{name}\")\n}\n\nfn local(id: LocalId) -> String {\n    format!(\"t_{id}\")\n}\n\n#[derive(Default)]\nstruct Helpers {\n    select: bool,\n    field: bool,\n    index: bool,\n    unwrap: bool,\n    arith: bool,\n    arith64: bool,\n    collect: bool,\n    jsonlines: bool,\n    tail: bool,\n    str_cmp: bool,\n    chars: bool,\n    eq: bool,\n}\n\n/// Which helper a comparison reaches for, decided by the operator and the operand type rather\n/// than by anything in the tree below it: ordering on a Str has to step by codepoint, and\n/// equality on a composite has to walk the structure.\nfn compare_helpers(op: BinOp, operand: &Type, used: &mut Helpers) {\n    used.str_cmp |=\n        *operand == Type::Str && matches!(op, BinOp::Lt | BinOp::Le | BinOp::Gt | BinOp::Ge);\n    used.eq |= operand.is_composite() && matches!(op, BinOp::Eq | BinOp::Ne);\n}\n\n/// Two of the six comparison operators cannot be handed to JS as they are written.\n/// `<`/`<=`/`>`/`>=` on native strings compare UTF-16 code units, which disagrees with codepoint\n/// order across a surrogate pair, so `tl_str_cmp` steps by codepoint instead; equality is\n/// unaffected there (the same codepoints give the same units either way). `===` on two objects\n/// is identity, so equality on a composite walks the structure through `tl_eq`\n/// (kantord/toylang#68). Ordering on a composite is a separate open question and keeps whatever\n/// JS does with it.\nfn compare(enums: &Enums, op: BinOp, lhs: &Tir, rhs: &Tir) -> String {\n    if lhs.ty.is_composite() && matches!(op, BinOp::Eq | BinOp::Ne) {\n        let call = format!(\"tl_eq({}, {})\", expr(enums, lhs), expr(enums, rhs));\n        return match op {\n            BinOp::Ne => format!(\"(!{call})\"),\n            _ => call,\n        };\n    }\n    if lhs.ty == Type::Str && matches!(op, BinOp::Lt | BinOp::Le | BinOp::Gt | BinOp::Ge) {\n        return format!(\n            \"(tl_str_cmp({}, {}) {} 0)\",\n            expr(enums, lhs),\n            expr(enums, rhs),\n            js_op(op)\n        );\n    }\n    format!(\"({} {} {})\", expr(enums, lhs), js_op(op), expr(enums, rhs))\n}\n\n/// `+` on two arrays stringifies and joins them, so a Vec reaches for `.concat` instead.\nfn concat(enums: &Enums, ty: &Type, l: &Tir, r: &Tir) -> String {\n    match ty {\n        Type::Vec(_) => format!(\"{}.concat({})\", expr(enums, l), expr(enums, r)),\n        _ => format!(\"({} + {})\", expr(enums, l), expr(enums, r)),\n    }\n}\n\nfn used_helpers(program: &Program) -> Helpers {\n    fn walk(t: &Tir, used: &mut Helpers) {\n        match &t.kind {\n            Kind::Str(_)\n            | Kind::Int(_)\n            | Kind::Var(_)\n            | Kind::Local(_)\n            | Kind::Input\n            | Kind::Inputs => {}\n            // The source is what reads stdin now, so it is what needs the helper.\n            Kind::Lines => used.collect = true,\n            Kind::VecLit(items) => items.iter().for_each(|i| walk(i, used)),\n            Kind::RecordLit { fields } => {\n                fields.iter().for_each(|(_, v)| walk(v, used));\n            }\n            // A variant's payload and a call's argument are the same shape here -- one optional\n            // child, recursed into and nothing else -- so they share the arm.\n            Kind::EnumLit { payload: child, .. } | Kind::Call { arg: child, .. } => {\n                if let Some(c) = child {\n                    walk(c, used);\n                }\n            }\n            Kind::Concat(l, r) | Kind::Logic { lhs: l, rhs: r, .. } => {\n                walk(l, used);\n                walk(r, used);\n            }\n            Kind::Compare { op, lhs: l, rhs: r } => {\n                compare_helpers(*op, &l.ty, used);\n                walk(l, used);\n                walk(r, used);\n            }\n            Kind::Bind { value, body, .. } => {\n                walk(value, used);\n                walk(body, used);\n            }\n            Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n                walk(source, used);\n                walk(body, used);\n            }\n            Kind::Select { source, pred, .. } => {\n                used.select = true;\n                walk(source, used);\n                walk(pred, used);\n            }\n            Kind::Field { base, .. } => {\n                used.field |= tir::vec_depth(&base.ty) > 0;\n                walk(base, used);\n            }\n            Kind::Builtin { which, arg } => {\n                used.jsonlines |= *which == Builtin::JsonLines;\n                used.tail |= *which == Builtin::Tail;\n                used.chars |= *which == Builtin::Chars;\n                used.str_cmp |=\n                    *which == Builtin::Sort && tir::runtime_elem(&arg.ty) == Some(&Type::Str);\n                walk(arg, used);\n            }\n            Kind::Cond {\n                cond,\n                then,\n                otherwise,\n            } => {\n                walk(cond, used);\n                walk(then, used);\n                walk(otherwise, used);\n            }\n            Kind::Arith { lhs, rhs, .. } => {\n                if t.ty == Type::Int64 {\n                    used.arith64 = true;\n                } else {\n                    used.arith = true;\n                }\n                walk(lhs, used);\n                walk(rhs, used);\n            }\n            Kind::Not(base) => walk(base, used),\n            Kind::Unwrap { base } => {\n                used.unwrap = true;\n                walk(base, used);\n            }\n            Kind::Index { base, index, .. } => {\n                used.index = true;\n                walk(base, used);\n                walk(index, used);\n            }\n            Kind::Match { subject, arms, .. } => {\n                walk(subject, used);\n                for a in arms {\n                    if let Some(g) = &a.guard {\n                        walk(g, used);\n                    }\n                    walk(&a.body, used);\n                }\n            }\n        }\n    }\n    let mut used = Helpers::default();\n    program.funcs.iter().for_each(|f| walk(&f.body, &mut used));\n    walk(&program.body, &mut used);\n    used\n}\n\n/// A partial chain's yield is an Opt, so a present arm is tagged; total chains return the\n/// body bare. Split out of `expr`'s match arm (kantord/toylang#62).\nfn arm_return(body: String, partial: bool) -> String {\n    if partial {\n        format!(\"return {{some: {body}}}; \")\n    } else {\n        format!(\"return {body}; \")\n    }\n}\n\nfn expr(enums: &Enums, t: &Tir) -> String {\n    match &t.kind {\n        Kind::Str(s) => js_string(s),\n        Kind::Int(n) => int_lit(&t.ty, *n),\n        Kind::Var(name) => user(name),\n        Kind::Local(id) => local(*id),\n        Kind::Input => INPUT.to_string(),\n        Kind::Inputs => INPUTS.to_string(),\n        // The stream, materialized eagerly: whatever consumes it -- `collect`, a mapper --\n        // works on the array of its entries. Fusion is what will remove this materialization.\n        Kind::Lines => \"tl_collect_lines()\".to_string(),\n        Kind::RecordLit { fields } => {\n            let parts: Vec<String> = fields\n                .iter()\n                .map(|(name, value)| format!(\"{}: {}\", js_string(name), expr(enums, value)))\n                .collect();\n            // Parenthesised because a brace opening an arrow function's body is a block, so\n            // `(e) => {a: 1}` is a labelled statement rather than an object.\n            format!(\"({{{}}})\", parts.join(\", \"))\n        }\n\n        // The value is its JSON shape: a unit variant is the variant-name string, a payload\n        // variant the single-key object a record already is.\n        Kind::EnumLit { variant, payload } => match payload {\n            None => js_string(variant),\n            Some(p) => format!(\"({{{}: {}}})\", js_string(variant), expr(enums, p)),\n        },\n\n        Kind::VecLit(items) => {\n            let parts: Vec<String> = items.iter().map(|i| expr(enums, i)).collect();\n            format!(\"[{}]\", parts.join(\", \"))\n        }\n        Kind::Call { func, arg } => format!(\n            \"{}({})\",\n            user(func),\n            arg.as_deref().map_or_else(String::new, |a| expr(enums, a))\n        ),\n        Kind::Concat(l, r) => concat(enums, &t.ty, l, r),\n        Kind::Arith { op, lhs, rhs } => arith(&t.ty, *op, expr(enums, lhs), expr(enums, rhs)),\n        Kind::Cond {\n            cond,\n            then,\n            otherwise,\n        } => {\n            format!(\n                \"({} ? {} : {})\",\n                expr(enums, cond),\n                expr(enums, then),\n                expr(enums, otherwise)\n            )\n        }\n        Kind::Logic { op, lhs, rhs } => {\n            let op = match op {\n                LogicOp::And => \"&&\",\n                LogicOp::Or => \"||\",\n            };\n            format!(\"({} {op} {})\", expr(enums, lhs), expr(enums, rhs))\n        }\n        Kind::Not(base) => format!(\"(!{})\", expr(enums, base)),\n        Kind::Builtin { which, arg } => match which {\n            Builtin::IntToStr => format!(\"String({})\", expr(enums, arg)),\n            // The one real conversion among the backends: an Int is a number and an Int64 is\n            // a BigInt, and BigInt() of a 32-bit integer is always exact.\n            Builtin::IntToI64 => format!(\"BigInt({})\", expr(enums, arg)),\n            Builtin::Chars => format!(\"tl_chars({})\", expr(enums, arg)),\n            Builtin::Range => {\n                format!(\n                    \"Array.from({{ length: Math.max(0, {}) }}, (_, i) => i)\",\n                    expr(enums, arg)\n                )\n            }\n            Builtin::JsonLines => {\n                let elem = tir::runtime_elem(&arg.ty).expect(\"checked to be a Vec or a stream\");\n                let e = \"e0\".to_string();\n                format!(\n                    \"tl_jsonlines({}, ({e}) => {})\",\n                    expr(enums, arg),\n                    show(enums, elem, &e, 1)\n                )\n            }\n            // The source already materialized, so the exit has nothing left to do.\n            Builtin::Collect => expr(enums, arg),\n            Builtin::Length => format!(\"{}.length\", expr(enums, arg)),\n            Builtin::Tail => format!(\"tl_tail({})\", expr(enums, arg)),\n            Builtin::Flatten => format!(\"{}.flat()\", expr(enums, arg)),\n            // `Array.prototype.sort`'s default comparator stringifies, which is wrong for\n            // numbers; `tl_str_cmp` already returns the -1/0/1 a comparator wants, so it can be\n            // passed straight through for Str.\n            Builtin::Sort => {\n                let elem = tir::runtime_elem(&arg.ty).expect(\"checked to be a Vec\");\n                if *elem == Type::Str {\n                    format!(\"[...{}].sort(tl_str_cmp)\", expr(enums, arg))\n                } else {\n                    // `a - b` would coerce the comparator's result with ToNumber, which\n                    // throws on BigInt -- and Int64 is BigInt here. The three-way compare\n                    // returns plain -1/0/1 for Number and BigInt alike.\n                    format!(\n                        \"[...{}].sort((a, b) => a < b ? -1 : a > b ? 1 : 0)\",\n                        expr(enums, arg)\n                    )\n                }\n            }\n            // `.reverse()` mutates in place, so the spread copy is what keeps this an ordinary\n            // expression rather than a statement with a visible side effect on `arg`.\n            Builtin::Reverse => format!(\"[...{}].reverse()\", expr(enums, arg)),\n            // The names come from the checked type, not the object value, so `arg` is evaluated\n            // only for whatever else it does (a division inside it must still throw) and its\n            // value discarded with the comma operator.\n            Builtin::Fields => {\n                let Type::Record(fields) = &arg.ty else {\n                    unreachable!(\"checked to be a record\")\n                };\n                let names: Vec<String> = fields.iter().map(|(n, _)| js_string(n)).collect();\n                format!(\"({}, [{}])\", expr(enums, arg), names.join(\", \"))\n            }\n        },\n        Kind::Compare { op, lhs, rhs } => compare(enums, *op, lhs, rhs),\n        Kind::Bind {\n            local: id,\n            value,\n            body,\n        } => {\n            format!(\n                \"(({}) => {})({})\",\n                local(*id),\n                expr(enums, body),\n                expr(enums, value)\n            )\n        }\n        // Array.prototype.map is exactly this, so no helper is needed.\n        Kind::Map {\n            source,\n            param,\n            body,\n        } => {\n            format!(\n                \"{}.map(({}) => {})\",\n                expr(enums, source),\n                local(*param),\n                expr(enums, body)\n            )\n        }\n        Kind::Select {\n            source,\n            param,\n            pred,\n        } => {\n            format!(\n                \"tl_select({}, ({}) => {})\",\n                expr(enums, source),\n                local(*param),\n                expr(enums, pred)\n            )\n        }\n        // Opt's reorder pass (kantord/toylang#66): the tagged shape (`\"none\"` or `{some: v}`)\n        // is generic enough that this is the ordinary key-presence test every Match arm over\n        // an Opt subject would already use, just rebuilding the payload instead of a body.\n        Kind::OptMap {\n            source,\n            param,\n            body,\n        } => {\n            format!(\n                \"(__opt => __opt === \\\"none\\\" ? \\\"none\\\" : (({}) => ({{some: {}}}))(__opt.some))({})\",\n                local(*param),\n                expr(enums, body),\n                expr(enums, source)\n            )\n        }\n        Kind::Unwrap { base } => {\n            format!(\n                \"tl_unwrap({}, {})\",\n                expr(enums, base),\n                tir::vec_depth(&base.ty)\n            )\n        }\n        Kind::Index {\n            base, index, depth, ..\n        } => {\n            format!(\n                \"tl_at({}, {}, {})\",\n                expr(enums, base),\n                expr(enums, index),\n                depth\n            )\n        }\n        Kind::Field { base, name } => {\n            let depth = tir::vec_depth(&base.ty);\n            if depth == 0 {\n                format!(\"{}[{}]\", expr(enums, base), js_string(name))\n            } else {\n                format!(\n                    \"tl_field({}, {}, {})\",\n                    expr(enums, base),\n                    js_string(name),\n                    depth\n                )\n            }\n        }\n        // A chain of tests over the subject (a plain local, so re-reading it is free): string\n        // equality for a unit variant, key presence for a payload variant, the guard's own\n        // Bool for a guard arm. A total chain's last arm needs no test, the checker having\n        // proved nothing else can reach it; a partial chain tags every present arm and falls\n        // through to the absent Opt.\n        Kind::Match {\n            subject,\n            arms,\n            partial,\n        } => {\n            let subj = expr(enums, subject);\n            let mut body = String::new();\n            for (i, arm) in arms.iter().enumerate() {\n                let mut run = String::new();\n                if let Some(pid) = arm.payload {\n                    let variant = arm\n                        .variant\n                        .as_ref()\n                        .expect(\"only a variant arm has a payload\");\n                    run.push_str(&format!(\n                        \"const {} = {subj}[{}]; \",\n                        local(pid),\n                        js_string(variant)\n                    ));\n                }\n                run.push_str(&arm_return(expr(enums, &arm.body), *partial));\n                let test = match (&arm.variant, &arm.guard) {\n                    (Some(v), _) if arm.payload.is_some() => {\n                        Some(format!(\"{subj}[{}] !== undefined\", js_string(v)))\n                    }\n                    (Some(v), _) => Some(format!(\"{subj} === {}\", js_string(v))),\n                    (None, Some(g)) => Some(expr(enums, g)),\n                    (None, None) => None,\n                };\n                match test {\n                    Some(test) if *partial || i + 1 < arms.len() => {\n                        body.push_str(&format!(\"if ({test}) {{ {run}}} \"));\n                    }\n                    _ => body.push_str(&run),\n                }\n            }\n            if *partial {\n                body.push_str(\"return \\\"none\\\"; \");\n            }\n            format!(\"(() => {{ {body}}})()\")\n        }\n    }\n}\n\n/// The node's type picks the literal's representation (kantord/toylang#83): an Int64 literal\n/// is a BigInt literal, exact at every written value where a bare number would already have\n/// rounded past 2^53.\nfn int_lit(ty: &Type, n: i64) -> String {\n    if *ty == Type::Int64 {\n        format!(\"{n}n\")\n    } else {\n        n.to_string()\n    }\n}\n\n/// One arithmetic expression at the width the node's type names. BigInt operators are exact\n/// at any width, so on the 64-bit side only the wrap needs spelling -- Math.imul has no\n/// 64-bit sibling and none is needed.\nfn arith(ty: &Type, op: BinOp, l: String, r: String) -> String {\n    if *ty == Type::Int64 {\n        match op {\n            BinOp::Div => format!(\"tl_div64({l}, {r})\"),\n            BinOp::Rem => format!(\"tl_rem64({l}, {r})\"),\n            BinOp::Mul => format!(\"BigInt.asIntN(64, {l} * {r})\"),\n            BinOp::Add => format!(\"BigInt.asIntN(64, {l} + {r})\"),\n            BinOp::Sub => format!(\"BigInt.asIntN(64, {l} - {r})\"),\n            other => unreachable!(\"{other} is not arithmetic\"),\n        }\n    } else {\n        match op {\n            BinOp::Div => format!(\"tl_div({l}, {r})\"),\n            BinOp::Rem => format!(\"tl_rem({l}, {r})\"),\n            // Math.imul is the only exact 32-bit multiply here: a plain `*` loses the low\n            // bits once the true product passes 2^53.\n            BinOp::Mul => format!(\"Math.imul({l}, {r})\"),\n            BinOp::Add => format!(\"(({l} + {r}) | 0)\"),\n            BinOp::Sub => format!(\"(({l} - {r}) | 0)\"),\n            other => unreachable!(\"{other} is not arithmetic\"),\n        }\n    }\n}\n\nfn js_op(op: BinOp) -> &'static str {\n    match op {\n        BinOp::Eq => \"===\",\n        BinOp::Ne => \"!==\",\n        BinOp::Lt => \"<\",\n        BinOp::Le => \"<=\",\n        BinOp::Gt => \">\",\n        BinOp::Ge => \">=\",\n        other => unreachable!(\"{other} is not a comparison\"),\n    }\n}\n\nfn js_string(s: &str) -> String {\n    let mut out = String::with_capacity(s.len() + 2);\n    out.push('\"');\n    for c in s.chars() {\n        match c {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            // U+2028 and U+2029 are line terminators in JavaScript but not in JSON, so a string\n            // containing them would end the literal early if written through.\n            c if (c as u32) < 0x20 || c == '\\u{7f}' || c == '\\u{2028}' || c == '\\u{2029}' => {\n                out.push_str(&format!(\"\\\\u{:04x}\", c as u32));\n            }\n            c => out.push(c),\n        }\n    }\n    out.push('\"');\n    out\n}","lineStart":1,"lineEnd":910,"totalLines":910,"truncated":false}},"title":"src/emit_js.rs","time":{"start":1788120725224,"end":1788120725231}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me look at how printing works on a couple of backends. The printer is the crux: \"Float literal print format must be byte-identical across all seven backends.\" Let me understand the current printing infrastructure. Let me look at how Int printing is done in each backend, and how the runtime printers work.\n\nLet me look at emit_js.rs around the Int literal, printing, and Arith handling.","format":"unknown","index":0}]}},"id":"prt_0544cf4150014UNORDG6OvarZ9","sessionID":"ses_fabb535ccffe1uMPqoZsBbW0jp","messageID":"msg_0544ce10f0019LvsXxcQUzSAqX"}}
