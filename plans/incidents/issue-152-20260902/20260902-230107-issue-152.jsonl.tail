sink; nothing else is a\n335:         // sink, and a body that is not one fails here with the declared-vs-found mismatch below\n336:         // naming the function.\n337:         let body = if sig.ret == Type::Sink {\n338:             if matches!(def.body, Expr::TailPipe { .. }) {\n339:                 tail_pipe(&def_ctx, &def.body)?\n340:             } else if let Some(tir) = sink_call(&def_ctx, &def.body)? {\n341:                 tir\n342:             } else {\n343:                 return Err(Error::new(\n344:                     def.body.span(),\n345:                     format!(\n346:                         \"`{}` declares it returns Sink, so its body must be a sink call \\\n347:                          such as `jsonlines(...)` or `x |> jsonlines`\",\n348:                         def.name\n349:                     ),\n350:                 ));\n351:             }\n352:         } else {\n353:             match expect_inner(&def_ctx, &def.body, &sig.ret)? {\n354:                 Expected::Checked(body) => body,\n355:                 Expected::Synthesised(body) => conform(&def_ctx, body, &sig.ret),\n356:             }\n357:         };\n358:         if let Some(param) = &def.param {\n359:             check_param(&body, param, &sig.param, &def.name, def.body.span())?;\n360:         }\n361:         if body.ty != sig.ret {\n362:             return Err(Error::new(\n363:                 def.body.span(),\n364:                 format!(\n365:                     \"`{}` declares it returns {}, but its body is {}\",\n366:                     def.name, sig.ret, body.ty\n367:                 ),\n368:             ));\n369:         }\n370:         funcs.push(tir::Func {\n371:             name: def.name.clone(),\n372:             param: def.param.as_ref().map(|p| p.name.clone()),\n373:             param_ty: sig.param.clone(),\n374:             body,\n375:         });\n376:     }\n377:     Ok(funcs)\n378: }\n379: \n380: /// Checks a module's own `pub` declarations in isolation -- `prelude.toy`'s, at build time\n381: /// (`build.rs`), before there is any file for them to be merged into and nothing yet calling any\n382: /// of it. Every declaration is kept: reachability is the calling file's question, decided once\n383: /// program and prelude are merged (`check` above, via `prune_unreachable`).\n384: pub fn check_module(module: &crate::ast::Module) -> Result<Vec<tir::Func>, Error> {\n385:     let env = TypeEnv {\n386:         aliases: HashMap::new(),\n387:         enums: enum_map(&module.enums)?,\n388:     };\n389:     let mut enums: HashMap<String, Type> = HashMap::new();\n390:     for e in &module.enums {\n391:         enums.insert(\n392:             e.name.clone(),\n393:             resolve_enum(e, &env, &mut Vec::new(), None)?,\n394:         );\n395:     }\n396:     let mut variant_owners: HashMap<String, Vec<String>> = HashMap::new();\n397:     for e in &module.enums {\n398:         for v in &e.variants {\n399:             variant_owners\n400:                 .entry(v.name.clone())\n401:                 .or_default()\n402:                 .push(e.name.clone());\n403:             let constructor = constructor_of(&v.name);\n404:             if constructor != v.name {\n405:                 variant_owners\n406:                     .entry(constructor)\n407:                     .or_default()\n408:                     .push(e.name.clone());\n409:             }\n410:         }\n411:     }\n412:     let sigs = signatures(&module.defs, &env)?;\n413:     let input = RefCell::new(None);\n414:     let inputs = RefCell::new(None);\n415:     let lines_used = Cell::new(false);\n416:     let dsv = RefCell::new(None);\n417:     let next_local = Cell::new(0);\n418:     let visibility: HashMap<String, (Origin, bool)> = module\n419:         .defs\n420:         .iter()\n421:         .map(|d| (d.name.clone(), (d.origin, d.is_pub)))\n422:         .collect();\n423:     let ctx = Ctx {\n424:         sigs: &sigs,\n425:         enums: &enums,\n426:         variant_owners: &variant_owners,\n427:         scope: Vec::new(),\n428:         arm_fields: Vec::new(),\n429:         subject: None,\n430:         input: &input,\n431:         inputs: &inputs,\n432:         lines_used: &lines_used,\n433:         dsv: &dsv,\n434:         in_mapper: false,\n435:         in_fn: None,\n436:         visibility: &visibility,\n437:         file: Origin::Prelude,\n438:         next_local: &next_local,\n439:     };\n440:     check_defs(module.defs.iter(), &ctx)\n441: }\n442: \n443: /// A signature may spell Stream now, which un-does the trick the Lines design leaned on (a\n444: /// return annotation could never match a body holding a stream), so what that trick guaranteed\n445: /// for free is checked for real here. Called only when `def` takes a parameter: a nullary\n446: /// function has none of this to check.\n447: fn check_param(\n448:     body: &Tir,\n449:     param: &Param,\n450:     param_ty: &Option<Type>,\n451:     func_name: &str,\n452:     body_span: Span,\n453: ) -> Result<(), Error> {\n454:     if matches!(param_ty, Some(Type::Stream(_))) {\n455:         check_linear(\n456:             body,\n457:             &StreamBinding::Param(&param.name),\n458:             &format!(\"`{}`\", param.name),\n459:             body_span,\n460:         )?;\n461:     }\n462:     if !param_used(body, &param.name) {\n463:         return Err(Error::new(\n464:             param.span,\n465:             format!(\n466:                 \"parameter `{}` is never used; delete it from `{}`'s definition and its call sites\",\n467:                 param.name, func_name\n468:             ),\n469:         ));\n470:     }\n471:     Ok(())\n472: }\n473: \n474: /// The program's own body. A sink-shaped body -- the tail-pipeline `lhs |> callee` or a direct\n475: /// sink call (`jsonlines(...)` or a call to a function declared `-> Sink`) -- is the one legal\n476: /// place a `Sink` may be born besides a `Sink`-returning function's body, so it is recognized\n477: /// ahead of `synth`, which refuses a sink everywhere else (the general position rule; see\n478: /// `tail_pipe` and `sink_call`). Any other body is synthesized, and a `Sink` result that slips\n479: /// past recognition can only mean a shape `synth` should have refused.\n480: fn check_program_body(ctx: &Ctx, body: &Expr) -> Result<Tir, Error> {\n481:     if matches!(body, Expr::TailPipe { .. }) {\n482:         return tail_pipe(ctx, body);\n483:     }\n\n(Showing lines 304-483 of 3239. Use offset=484 to continue.)\n</content>","metadata":{"preview":"    for def in defs {\n        let sig = &ctx.sigs[&def.name];\n        let scope = match (&def.param, &sig.param) {\n            (Some(param), Some(param_ty)) => vec![(param.name.clone(), param_ty.clone(), None)],\n            (None, None) => Vec::new(),\n            _ => unreachable!(\"a signature's param mirrors its definition's\"),\n        };\n        let def_ctx = Ctx {\n            sigs: ctx.sigs,\n            enums: ctx.enums,\n            variant_owners: ctx.variant_owners,\n            scope,\n            arm_fields: Vec::new(),\n            subject: None,\n            input: ctx.input,\n            inputs: ctx.inputs,\n            lines_used: ctx.lines_used,\n            dsv: ctx.dsv,\n            in_mapper: false,\n            in_fn: Some(&def.name),","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-152/src/check/mod.rs","text":"    for def in defs {\n        let sig = &ctx.sigs[&def.name];\n        let scope = match (&def.param, &sig.param) {\n            (Some(param), Some(param_ty)) => vec![(param.name.clone(), param_ty.clone(), None)],\n            (None, None) => Vec::new(),\n            _ => unreachable!(\"a signature's param mirrors its definition's\"),\n        };\n        let def_ctx = Ctx {\n            sigs: ctx.sigs,\n            enums: ctx.enums,\n            variant_owners: ctx.variant_owners,\n            scope,\n            arm_fields: Vec::new(),\n            subject: None,\n            input: ctx.input,\n            inputs: ctx.inputs,\n            lines_used: ctx.lines_used,\n            dsv: ctx.dsv,\n            in_mapper: false,\n            in_fn: Some(&def.name),\n            visibility: ctx.visibility,\n            file: ctx.file,\n            next_local: ctx.next_local,\n        };\n        // The declared return type flows into the body, so a form whose type comes from its\n        // position (`[]`, `input`, a variant-naming string) resolves against the annotation. A\n        // body that synthesises instead is compared below, where the error can name the\n        // function rather than just the two types.\n        //\n        // A function declared `-> Sink` is the other sink position, so its body must be a sink\n        // call -- the tail-pipeline `|>` form or a direct call to a sink; nothing else is a\n        // sink, and a body that is not one fails here with the declared-vs-found mismatch below\n        // naming the function.\n        let body = if sig.ret == Type::Sink {\n            if matches!(def.body, Expr::TailPipe { .. }) {\n                tail_pipe(&def_ctx, &def.body)?\n            } else if let Some(tir) = sink_call(&def_ctx, &def.body)? {\n                tir\n            } else {\n                return Err(Error::new(\n                    def.body.span(),\n                    format!(\n                        \"`{}` declares it returns Sink, so its body must be a sink call \\\n                         such as `jsonlines(...)` or `x |> jsonlines`\",\n                        def.name\n                    ),\n                ));\n            }\n        } else {\n            match expect_inner(&def_ctx, &def.body, &sig.ret)? {\n                Expected::Checked(body) => body,\n                Expected::Synthesised(body) => conform(&def_ctx, body, &sig.ret),\n            }\n        };\n        if let Some(param) = &def.param {\n            check_param(&body, param, &sig.param, &def.name, def.body.span())?;\n        }\n        if body.ty != sig.ret {\n            return Err(Error::new(\n                def.body.span(),\n                format!(\n                    \"`{}` declares it returns {}, but its body is {}\",\n                    def.name, sig.ret, body.ty\n                ),\n            ));\n        }\n        funcs.push(tir::Func {\n            name: def.name.clone(),\n            param: def.param.as_ref().map(|p| p.name.clone()),\n            param_ty: sig.param.clone(),\n            body,\n        });\n    }\n    Ok(funcs)\n}\n\n/// Checks a module's own `pub` declarations in isolation -- `prelude.toy`'s, at build time\n/// (`build.rs`), before there is any file for them to be merged into and nothing yet calling any\n/// of it. Every declaration is kept: reachability is the calling file's question, decided once\n/// program and prelude are merged (`check` above, via `prune_unreachable`).\npub fn check_module(module: &crate::ast::Module) -> Result<Vec<tir::Func>, Error> {\n    let env = TypeEnv {\n        aliases: HashMap::new(),\n        enums: enum_map(&module.enums)?,\n    };\n    let mut enums: HashMap<String, Type> = HashMap::new();\n    for e in &module.enums {\n        enums.insert(\n            e.name.clone(),\n            resolve_enum(e, &env, &mut Vec::new(), None)?,\n        );\n    }\n    let mut variant_owners: HashMap<String, Vec<String>> = HashMap::new();\n    for e in &module.enums {\n        for v in &e.variants {\n            variant_owners\n                .entry(v.name.clone())\n                .or_default()\n                .push(e.name.clone());\n            let constructor = constructor_of(&v.name);\n            if constructor != v.name {\n                variant_owners\n                    .entry(constructor)\n                    .or_default()\n                    .push(e.name.clone());\n            }\n        }\n    }\n    let sigs = signatures(&module.defs, &env)?;\n    let input = RefCell::new(None);\n    let inputs = RefCell::new(None);\n    let lines_used = Cell::new(false);\n    let dsv = RefCell::new(None);\n    let next_local = Cell::new(0);\n    let visibility: HashMap<String, (Origin, bool)> = module\n        .defs\n        .iter()\n        .map(|d| (d.name.clone(), (d.origin, d.is_pub)))\n        .collect();\n    let ctx = Ctx {\n        sigs: &sigs,\n        enums: &enums,\n        variant_owners: &variant_owners,\n        scope: Vec::new(),\n        arm_fields: Vec::new(),\n        subject: None,\n        input: &input,\n        inputs: &inputs,\n        lines_used: &lines_used,\n        dsv: &dsv,\n        in_mapper: false,\n        in_fn: None,\n        visibility: &visibility,\n        file: Origin::Prelude,\n        next_local: &next_local,\n    };\n    check_defs(module.defs.iter(), &ctx)\n}\n\n/// A signature may spell Stream now, which un-does the trick the Lines design leaned on (a\n/// return annotation could never match a body holding a stream), so what that trick guaranteed\n/// for free is checked for real here. Called only when `def` takes a parameter: a nullary\n/// function has none of this to check.\nfn check_param(\n    body: &Tir,\n    param: &Param,\n    param_ty: &Option<Type>,\n    func_name: &str,\n    body_span: Span,\n) -> Result<(), Error> {\n    if matches!(param_ty, Some(Type::Stream(_))) {\n        check_linear(\n            body,\n            &StreamBinding::Param(&param.name),\n            &format!(\"`{}`\", param.name),\n            body_span,\n        )?;\n    }\n    if !param_used(body, &param.name) {\n        return Err(Error::new(\n            param.span,\n            format!(\n                \"parameter `{}` is never used; delete it from `{}`'s definition and its call sites\",\n                param.name, func_name\n            ),\n        ));\n    }\n    Ok(())\n}\n\n/// The program's own body. A sink-shaped body -- the tail-pipeline `lhs |> callee` or a direct\n/// sink call (`jsonlines(...)` or a call to a function declared `-> Sink`) -- is the one legal\n/// place a `Sink` may be born besides a `Sink`-returning function's body, so it is recognized\n/// ahead of `synth`, which refuses a sink everywhere else (the general position rule; see\n/// `tail_pipe` and `sink_call`). Any other body is synthesized, and a `Sink` result that slips\n/// past recognition can only mean a shape `synth` should have refused.\nfn check_program_body(ctx: &Ctx, body: &Expr) -> Result<Tir, Error> {\n    if matches!(body, Expr::TailPipe { .. }) {\n        return tail_pipe(ctx, body);\n    }","lineStart":304,"lineEnd":483,"totalLines":3239,"truncated":true}},"title":"src/check/mod.rs","time":{"start":1788382951628,"end":1788382951655}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_063ee3707001VY8TE5X30xwdvO","sessionID":"ses_f9c130ecaffeXIzoGLIIVyKiu4","messageID":"msg_063ee31b10017VbrwSwF5vUphc"}}
