   span,\n1124:             };\n1125:         }\n1126: \n1127:         Ok(lhs)\n1128:     }\n1129: \n1130:     /// The program's body (or a function's, when it is not a `let` block): an ordinary\n1131:     /// expression, or the tail-pipeline `lhs |> callee` that is the one way a sink is written.\n1132:     /// Parsed only here, at the outermost position, so a nested `|>` is a parse error rather\n1133:     /// than a value -- the checker's sink position rule is this production's, not a search for\n1134:     /// a stray token somewhere inside a larger expression.\n1135:     fn tail_pipe(&mut self) -> Result<Expr, Error> {\n1136:         let lhs = self.expr(0)?;\n1137:         let (tok, _) = self.peek()?;\n1138:         if tok != Tok::PipeGt {\n1139:             return Ok(lhs);\n1140:         }\n1141:         self.advance()?;\n1142:         let (callee, callee_span) = self.eat_ident(\"a sink call\")?;\n1143:         let span = lhs.span().to(callee_span);\n1144:         Ok(Expr::TailPipe {\n1145:             lhs: Box::new(lhs),\n1146:             callee,\n1147:             callee_span,\n1148:             span,\n1149:         })\n1150:     }\n1151: \n1152:     fn operand(&mut self, min_power: u8) -> Result<Expr, Error> {\n1153:         let mut lhs = self.complement(min_power)?;\n1154: \n1155:         loop {\n1156:             let (tok, _) = self.peek()?;\n1157:             // Where `or` is the arm separator it is not an operator at all, so the table is not\n1158:             // even consulted: the chain the arm belongs to takes the token.\n1159:             if tok == Tok::Or && self.or_separates {\n1160:                 break;\n1161:             }\n1162:             let Some((op, left, right)) = infix_power(&tok) else {\n1163:                 break;\n1164:             };\n1165:             if left < min_power {\n1166:                 break;\n1167:             }\n1168:             self.advance()?;\n1169:             let rhs = self.operand(right)?;\n1170:             let span = lhs.span().to(rhs.span());\n1171:             lhs = match op {\n1172:                 Infix::Bin(op) => Expr::Binary {\n1173:                     op,\n1174:                     lhs: Box::new(lhs),\n1175:                     rhs: Box::new(rhs),\n1176:                     span,\n1177:                 },\n1178:                 Infix::Logic(op) => Expr::Logic {\n1179:                     op,\n1180:                     lhs: Box::new(lhs),\n1181:                     rhs: Box::new(rhs),\n1182:                     span,\n1183:                 },\n1184:             };\n1185:         }\n1186: \n1187:         Ok(lhs)\n1188:     }\n1189: \n1190:     /// `not`, which is prefix but not unary in `-`'s sense: it binds looser than every operator\n1191:     /// in the infix table above comparison, so it reads its own operand at its own power rather\n1192:     /// than taking whatever `unary` returns. A position that binds tighter than `not` (a\n1193:     /// comparison's right side, say) declines it, and parens are what reach in there.\n1194:     fn complement(&mut self, min_power: u8) -> Result<Expr, Error> {\n1195:         let (tok, span) = self.peek()?;\n1196:         if tok == Tok::Not && min_power <= NOT_POWER {\n1197:             self.advance()?;\n1198:             let base = self.operand(NOT_POWER)?;\n1199:             let full = span.to(base.span());\n1200:             return Ok(Expr::Not {\n1201:                 base: Box::new(base),\n1202:                 span: full,\n1203:             });\n1204:         }\n1205:         self.unary()\n1206:     }\n1207: \n1208:     /// Negation binds tighter than any infix operator and looser than any postfix one, so\n1209:     /// `-a.b` negates the field and `-a * b` negates only `a`.\n1210:     fn unary(&mut self) -> Result<Expr, Error> {\n1211:         let (tok, span) = self.peek()?;\n1212:         if tok == Tok::Minus {\n1213:             self.advance()?;\n1214:             let base = self.unary()?;\n1215:             let full = span.to(base.span());\n1216:             return Ok(Expr::Neg {\n1217:                 base: Box::new(base),\n1218:                 span: full,\n1219:             });\n1220:         }\n1221:         self.postfix()\n1222:     }\n1223: \n1224:     /// `[]` and `.name` bind tighter than any infix operator, so `a.b[] | c` projects `a.b`.\n1225:     fn postfix(&mut self) -> Result<Expr, Error> {\n1226:         let mut e = self.atom()?;\n1227:         loop {\n1228:             let (tok, _) = self.peek()?;\n1229:             match tok {\n1230:                 Tok::LBracket => {\n1231:                     let (_, bspan) = self.peek()?;\n1232:                     // Indexing owns `[` on the same line only, the same rule call arguments\n1233:                     // follow: a definition's body and the program's body sit adjacent, and the\n1234:                     // line break keeps one from swallowing the other.\n1235:                     if !self.same_line(e.span().end, bspan.start) {\n1236:                         return Ok(e);\n1237:                     }\n1238:                     let (_, lspan) = self.advance()?;\n1239:                     let (next, _) = self.peek()?;\n1240:                     if next == Tok::RBracket {\n1241:                         let close = self.advance()?.1;\n1242:                         let span = e.span().to(close);\n1243:                         e = Expr::Project {\n1244:                             base: Box::new(e),\n1245:                             span,\n1246:                         };\n1247:                     } else {\n1248:                         // `[a]` collapses; `[a:b]` narrows, with either bound optional. A `:`\n1249:                         // is never an expression token, so peeking past the first operand (or\n1250:                         // past the `[`, for `[:b]`) tells the two apart unambiguously.\n1251:                         let start = if next == Tok::Colon {\n1252:                             None\n1253:                         } else {\n1254:                             Some(Box::new(self.expr(0)?))\n1255:                         };\n1256:                         if self.peek()?.0 == Tok::Colon {\n1257:                             self.advance()?;\n1258:                             let (next, _) = self.peek()?;\n1259:                             let end = if next == Tok::RBracket {\n1260:                                 None\n1261:                             } else {\n1262:                                 Some(Box::new(self.expr(0)?))\n1263:                             };\n1264:                             let close = self.eat(Tok::RBracket)?;\n1265:                             // Both edges at the dimension's own boundaries is the identity\n1266:                             // `[]` already is, and jq itself rejects the both-omitted form,\n1267:                             // so there is no reason to carry a spelling for it.\n1268:                             if start.is_none() && end.is_none() {\n\n(Showing lines 1089-1268 of 1509. Use offset=1269 to continue.)\n</content>","metadata":{"preview":"    fn expr(&mut self, min_power: u8) -> Result<Expr, Error> {\n        if min_power <= PIPE_RIGHT {\n            return self.with_or(false, |p| p.expr_at(min_power, true));\n        }\n        self.expr_at(min_power, false)\n    }\n\n    fn expr_at(&mut self, min_power: u8, fresh: bool) -> Result<Expr, Error> {\n        let mut lhs = if fresh && self.arm_starts_here() {\n            self.match_expr(None)?\n        } else {\n            let e = self.operand(min_power)?;\n            let (tok, _) = self.peek()?;\n            // No `Tok::Or` here: a fresh position reads `or` as disjunction, so `operand` has\n            // already taken any that were there, and an arm chain is revealed by the `->` that\n            // follows the whole disjunction (`a == 1 or b == 2 -> ...` is one guard).\n            if fresh && tok == Tok::Arrow {\n                self.match_expr(Some(e))?\n            } else {\n                e","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-152/src/parse.rs","text":"    fn expr(&mut self, min_power: u8) -> Result<Expr, Error> {\n        if min_power <= PIPE_RIGHT {\n            return self.with_or(false, |p| p.expr_at(min_power, true));\n        }\n        self.expr_at(min_power, false)\n    }\n\n    fn expr_at(&mut self, min_power: u8, fresh: bool) -> Result<Expr, Error> {\n        let mut lhs = if fresh && self.arm_starts_here() {\n            self.match_expr(None)?\n        } else {\n            let e = self.operand(min_power)?;\n            let (tok, _) = self.peek()?;\n            // No `Tok::Or` here: a fresh position reads `or` as disjunction, so `operand` has\n            // already taken any that were there, and an arm chain is revealed by the `->` that\n            // follows the whole disjunction (`a == 1 or b == 2 -> ...` is one guard).\n            if fresh && tok == Tok::Arrow {\n                self.match_expr(Some(e))?\n            } else {\n                e\n            }\n        };\n\n        loop {\n            let (tok, _) = self.peek()?;\n            if tok != Tok::Pipe || PIPE_LEFT < min_power {\n                break;\n            }\n            self.advance()?;\n            let rhs = self.expr(PIPE_RIGHT)?;\n            let span = lhs.span().to(rhs.span());\n            lhs = Expr::Pipe {\n                lhs: Box::new(lhs),\n                rhs: Box::new(rhs),\n                span,\n            };\n        }\n\n        Ok(lhs)\n    }\n\n    /// The program's body (or a function's, when it is not a `let` block): an ordinary\n    /// expression, or the tail-pipeline `lhs |> callee` that is the one way a sink is written.\n    /// Parsed only here, at the outermost position, so a nested `|>` is a parse error rather\n    /// than a value -- the checker's sink position rule is this production's, not a search for\n    /// a stray token somewhere inside a larger expression.\n    fn tail_pipe(&mut self) -> Result<Expr, Error> {\n        let lhs = self.expr(0)?;\n        let (tok, _) = self.peek()?;\n        if tok != Tok::PipeGt {\n            return Ok(lhs);\n        }\n        self.advance()?;\n        let (callee, callee_span) = self.eat_ident(\"a sink call\")?;\n        let span = lhs.span().to(callee_span);\n        Ok(Expr::TailPipe {\n            lhs: Box::new(lhs),\n            callee,\n            callee_span,\n            span,\n        })\n    }\n\n    fn operand(&mut self, min_power: u8) -> Result<Expr, Error> {\n        let mut lhs = self.complement(min_power)?;\n\n        loop {\n            let (tok, _) = self.peek()?;\n            // Where `or` is the arm separator it is not an operator at all, so the table is not\n            // even consulted: the chain the arm belongs to takes the token.\n            if tok == Tok::Or && self.or_separates {\n                break;\n            }\n            let Some((op, left, right)) = infix_power(&tok) else {\n                break;\n            };\n            if left < min_power {\n                break;\n            }\n            self.advance()?;\n            let rhs = self.operand(right)?;\n            let span = lhs.span().to(rhs.span());\n            lhs = match op {\n                Infix::Bin(op) => Expr::Binary {\n                    op,\n                    lhs: Box::new(lhs),\n                    rhs: Box::new(rhs),\n                    span,\n                },\n                Infix::Logic(op) => Expr::Logic {\n                    op,\n                    lhs: Box::new(lhs),\n                    rhs: Box::new(rhs),\n                    span,\n                },\n            };\n        }\n\n        Ok(lhs)\n    }\n\n    /// `not`, which is prefix but not unary in `-`'s sense: it binds looser than every operator\n    /// in the infix table above comparison, so it reads its own operand at its own power rather\n    /// than taking whatever `unary` returns. A position that binds tighter than `not` (a\n    /// comparison's right side, say) declines it, and parens are what reach in there.\n    fn complement(&mut self, min_power: u8) -> Result<Expr, Error> {\n        let (tok, span) = self.peek()?;\n        if tok == Tok::Not && min_power <= NOT_POWER {\n            self.advance()?;\n            let base = self.operand(NOT_POWER)?;\n            let full = span.to(base.span());\n            return Ok(Expr::Not {\n                base: Box::new(base),\n                span: full,\n            });\n        }\n        self.unary()\n    }\n\n    /// Negation binds tighter than any infix operator and looser than any postfix one, so\n    /// `-a.b` negates the field and `-a * b` negates only `a`.\n    fn unary(&mut self) -> Result<Expr, Error> {\n        let (tok, span) = self.peek()?;\n        if tok == Tok::Minus {\n            self.advance()?;\n            let base = self.unary()?;\n            let full = span.to(base.span());\n            return Ok(Expr::Neg {\n                base: Box::new(base),\n                span: full,\n            });\n        }\n        self.postfix()\n    }\n\n    /// `[]` and `.name` bind tighter than any infix operator, so `a.b[] | c` projects `a.b`.\n    fn postfix(&mut self) -> Result<Expr, Error> {\n        let mut e = self.atom()?;\n        loop {\n            let (tok, _) = self.peek()?;\n            match tok {\n                Tok::LBracket => {\n                    let (_, bspan) = self.peek()?;\n                    // Indexing owns `[` on the same line only, the same rule call arguments\n                    // follow: a definition's body and the program's body sit adjacent, and the\n                    // line break keeps one from swallowing the other.\n                    if !self.same_line(e.span().end, bspan.start) {\n                        return Ok(e);\n                    }\n                    let (_, lspan) = self.advance()?;\n                    let (next, _) = self.peek()?;\n                    if next == Tok::RBracket {\n                        let close = self.advance()?.1;\n                        let span = e.span().to(close);\n                        e = Expr::Project {\n                            base: Box::new(e),\n                            span,\n                        };\n                    } else {\n                        // `[a]` collapses; `[a:b]` narrows, with either bound optional. A `:`\n                        // is never an expression token, so peeking past the first operand (or\n                        // past the `[`, for `[:b]`) tells the two apart unambiguously.\n                        let start = if next == Tok::Colon {\n                            None\n                        } else {\n                            Some(Box::new(self.expr(0)?))\n                        };\n                        if self.peek()?.0 == Tok::Colon {\n                            self.advance()?;\n                            let (next, _) = self.peek()?;\n                            let end = if next == Tok::RBracket {\n                                None\n                            } else {\n                                Some(Box::new(self.expr(0)?))\n                            };\n                            let close = self.eat(Tok::RBracket)?;\n                            // Both edges at the dimension's own boundaries is the identity\n                            // `[]` already is, and jq itself rejects the both-omitted form,\n                            // so there is no reason to carry a spelling for it.\n                            if start.is_none() && end.is_none() {","lineStart":1089,"lineEnd":1268,"totalLines":1509,"truncated":true}},"title":"src/parse.rs","time":{"start":1788382997167,"end":1788382997176}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me look at how the `expr` function parses calls, and how `Call` arguments are parsed (`argument` at 