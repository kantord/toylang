ght side: the one position where a bare `or` is the chain's separator rather\n1004:     /// than disjunction, so a Bool `or` written here needs parens (draft.md, the match-arms\n1005:     /// decision).\n1006:     fn arm_body(&mut self) -> Result<Expr, Error> {\n1007:         self.with_or(true, |p| p.expr(COND_POWER))\n1008:     }\n1009: \n1010:     /// The element `left` opens: `left -> body` makes `left` a guard, and a bare `left` is the\n1011:     /// default, desugared to a `Default` arm whose body is `left` itself.\n1012:     fn guard_or_default_arm(&mut self, left: Expr) -> Result<MatchArm, Error> {\n1013:         if self.peek()?.0 == Tok::Arrow {\n1014:             self.advance()?;\n1015:             let body = self.arm_body()?;\n1016:             let span = left.span().to(body.span());\n1017:             return Ok(MatchArm {\n1018:                 pattern: Pattern::Guard(left),\n1019:                 body,\n1020:                 span,\n1021:             });\n1022:         }\n1023:         let span = left.span();\n1024:         Ok(MatchArm {\n1025:             pattern: Pattern::Default { span },\n1026:             body: left,\n1027:             span,\n1028:         })\n1029:     }\n1030: \n1031:     fn pattern(&mut self) -> Result<Pattern, Error> {\n1032:         let (name, span) = self.eat_ident(\"a pattern\")?;\n1033:         let (next, brace_span) = self.peek()?;\n1034:         if name == \"any\" && next == Tok::LParen {\n1035:             self.advance()?;\n1036:             let close = self.eat(Tok::RParen)?;\n1037:             return Ok(Pattern::Default {\n1038:                 span: span.to(close),\n1039:             });\n1040:         }\n1041:         if next != Tok::LBrace {\n1042:             return Ok(Pattern::Variant {\n1043:                 name,\n1044:                 span,\n1045:                 fields: None,\n1046:             });\n1047:         }\n1048:         self.advance()?;\n1049:         let mut names = Vec::new();\n1050:         let mut rest = false;\n1051:         let (first, _) = self.peek()?;\n1052:         if first != Tok::RBrace {\n1053:             loop {\n1054:                 // `..` is two Dot tokens, and it ends the list: naming a field after \"and the\n1055:                 // rest\" would make the marker meaningless.\n1056:                 if self.peek()?.0 == Tok::Dot {\n1057:                     self.advance()?;\n1058:                     self.eat(Tok::Dot)?;\n1059:                     rest = true;\n\n(Showing lines 930-1059 of 1509. Use offset=1060 to continue.)\n</content>","metadata":{"preview":"    /// surface it.\n    fn arm_starts_here(&self) -> bool {\n        let mut probe = self.input;\n        let mut next = || read_tok(&mut probe).map(|(t, _)| t);\n        let Ok(Tok::Ident(name)) = next() else {\n            return false;\n        };\n        match next() {\n            Ok(Tok::Arrow) => true,\n            Ok(Tok::LParen) if name == \"any\" => {\n                matches!(next(), Ok(Tok::RParen)) && matches!(next(), Ok(Tok::Arrow))\n            }\n            Ok(Tok::LBrace) => {\n                loop {\n                    match next() {\n                        Ok(Tok::Ident(_) | Tok::Comma | Tok::Dot) => continue,\n                        Ok(Tok::RBrace) => break,\n                        _ => return false,\n                    }\n                }","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-152/src/parse.rs","text":"    /// surface it.\n    fn arm_starts_here(&self) -> bool {\n        let mut probe = self.input;\n        let mut next = || read_tok(&mut probe).map(|(t, _)| t);\n        let Ok(Tok::Ident(name)) = next() else {\n            return false;\n        };\n        match next() {\n            Ok(Tok::Arrow) => true,\n            Ok(Tok::LParen) if name == \"any\" => {\n                matches!(next(), Ok(Tok::RParen)) && matches!(next(), Ok(Tok::Arrow))\n            }\n            Ok(Tok::LBrace) => {\n                loop {\n                    match next() {\n                        Ok(Tok::Ident(_) | Tok::Comma | Tok::Dot) => continue,\n                        Ok(Tok::RBrace) => break,\n                        _ => return false,\n                    }\n                }\n                matches!(next(), Ok(Tok::Arrow))\n            }\n            _ => false,\n        }\n    }\n\n    /// `left -> body or left -> body or ...`, first match wins; `or` is the one arm composer.\n    /// A left side is a variant pattern (`circle{r}`), `any()`, or a Bool guard expression; the\n    /// chain's final element may instead be a bare expression, the default. The chain reads `.`\n    /// as its subject, so it usually sits to the right of a `|`; each body stops at `|` and\n    /// `or`, which is what lets the chain be one pipe stage.\n    ///\n    /// The two `or`s meet here and nowhere else. A body is read with the separator reading, so\n    /// it ends at the next `or`; an element's own left side is read with the disjunction one, so\n    /// `a -> 1 or b == 2 or c == 3 -> 4` is two arms whose second has a two-clause guard. What\n    /// makes that split decidable is that an element ending at a bare `or` could only ever have\n    /// been a bare default in a non-final position, which was already an error.\n    ///\n    /// `lead` is an expression `expr` had already read when the `->` after it revealed a chain;\n    /// the first element continues from it instead of parsing fresh.\n    fn match_expr(&mut self, lead: Option<Expr>) -> Result<Expr, Error> {\n        let mut arms = Vec::new();\n        let mut lead = lead;\n        loop {\n            let arm = match lead.take() {\n                Some(e) => self.guard_or_default_arm(e)?,\n                None if self.arm_starts_here() => {\n                    let pattern = self.pattern()?;\n                    self.eat(Tok::Arrow)?;\n                    let body = self.arm_body()?;\n                    let span = pattern.span().to(body.span());\n                    MatchArm {\n                        pattern,\n                        body,\n                        span,\n                    }\n                }\n                None => {\n                    let e = self.with_or(false, |p| p.operand(COND_POWER))?;\n                    self.guard_or_default_arm(e)?\n                }\n            };\n            arms.push(arm);\n            let (sep, _) = self.peek()?;\n            if sep != Tok::Or {\n                break;\n            }\n            self.advance()?;\n        }\n        let span = arms[0].span.to(arms[arms.len() - 1].span);\n        Ok(Expr::Match { arms, span })\n    }\n\n    /// An arm's right side: the one position where a bare `or` is the chain's separator rather\n    /// than disjunction, so a Bool `or` written here needs parens (draft.md, the match-arms\n    /// decision).\n    fn arm_body(&mut self) -> Result<Expr, Error> {\n        self.with_or(true, |p| p.expr(COND_POWER))\n    }\n\n    /// The element `left` opens: `left -> body` makes `left` a guard, and a bare `left` is the\n    /// default, desugared to a `Default` arm whose body is `left` itself.\n    fn guard_or_default_arm(&mut self, left: Expr) -> Result<MatchArm, Error> {\n        if self.peek()?.0 == Tok::Arrow {\n            self.advance()?;\n            let body = self.arm_body()?;\n            let span = left.span().to(body.span());\n            return Ok(MatchArm {\n                pattern: Pattern::Guard(left),\n                body,\n                span,\n            });\n        }\n        let span = left.span();\n        Ok(MatchArm {\n            pattern: Pattern::Default { span },\n            body: left,\n            span,\n        })\n    }\n\n    fn pattern(&mut self) -> Result<Pattern, Error> {\n        let (name, span) = self.eat_ident(\"a pattern\")?;\n        let (next, brace_span) = self.peek()?;\n        if name == \"any\" && next == Tok::LParen {\n            self.advance()?;\n            let close = self.eat(Tok::RParen)?;\n            return Ok(Pattern::Default {\n                span: span.to(close),\n            });\n        }\n        if next != Tok::LBrace {\n            return Ok(Pattern::Variant {\n                name,\n                span,\n                fields: None,\n            });\n        }\n        self.advance()?;\n        let mut names = Vec::new();\n        let mut rest = false;\n        let (first, _) = self.peek()?;\n        if first != Tok::RBrace {\n            loop {\n                // `..` is two Dot tokens, and it ends the list: naming a field after \"and the\n                // rest\" would make the marker meaningless.\n                if self.peek()?.0 == Tok::Dot {\n                    self.advance()?;\n                    self.eat(Tok::Dot)?;\n                    rest = true;","lineStart":930,"lineEnd":1059,"totalLines":1509,"truncated":true}},"title":"src/parse.rs","time":{"start":1788382993372,"end":1788382993376}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now I have a good understanding of the Sig structure. Now, option A is a significant change. Let me think about the design.\n\nGiven the complexity, let me first look at how the maintainer's exact sketch is intended to work and how the parse/check would flow. The key surfaces:\n\n1. **New fn-declaration shape**: `fn render = Msg(Ping -> \"*ping*\" or Quit -> \"*quit*\" or Text -> .body)`. No params list, no return annotation. The body is a \"type-name-as-match-call\" expression form.\n\n2. **Return-type inference from the match arms**.\n\n3. **Type-name-as-match-call expression form**: `Msg(Ping -> ... or ...)` where `Msg` is a variant type used like a call, and the arms are match arms over the implicit input `.`.\n\nNow, how should the parser handle this? When parsing a `fn` definition, after the name, if the next token is `=`, then it's the new call-form-hoist shape. Otherwise it's the old shape (with params).\n\nBut wait - how does this interact with the grammar? Currently: `fn name(param: Type) -> Type = body`. The new form is `fn name = body` where body is `TypeName(arms)`. \n\nActually, let me reconsider. The fn body in the new form is a match-call expression. The expression `Msg(Ping -> \"*ping*\" or Quit -> \"*quit*\" or Text -> .body)` needs to be parsed as an expression. So the new expr form is: a type name followed by `(match-arms)`.\n\nBut there's ambiguity: a type name followed by `(` could also be... well, actually in the expression grammar, `name(...)` is a Call. So `Msg(...)` would parse as a Call to `Msg`. But we need to distinguish: is `Msg(...)` a call-form match (where the args are match arms separated by `or`) or an ordinary call (where the arg is a single expression)?\n\nThe key distinguishing feature: the args inside are match arms (patterns `->` bodies separated by `or`). So when parsing the argument of a call `Msg(...)`, if the first thing is a pattern followed by `->`, then it's a match-call form.\n\nHmm, this is getting complex. Let me look at how the match_expr parses arms, and how call arguments parse.\n\nLet me look at the match parsing (lines 970-1031).","format":"unknown","index":0}]}},"id":"prt_063eed9d10016Nc5Sq884uSnt2","sessionID":"ses_f9c130ecaffeXIzoGLIIVyKiu4","messageID":"msg_063ee9b51001vwuovhtPMP38tm"}}
