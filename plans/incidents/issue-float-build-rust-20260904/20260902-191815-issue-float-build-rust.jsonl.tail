what lets a backend address one by index rather than\n@@ -488,6 +492,7 @@ fn each_node(t: &Tir, f: &mut impl FnMut(&Tir)) {\n     match &t.kind {\n         Kind::Str(_)\n         | Kind::Int(_)\n+        | Kind::Float(_)\n         | Kind::Var(_)\n         | Kind::Local(_)\n         | Kind::Input\ndiff --git a/src/ty.rs b/src/ty.rs\nindex ff00785..6415d60 100644\n--- a/src/ty.rs\n+++ b/src/ty.rs\n@@ -23,6 +23,14 @@ pub enum Type {\n     /// cannot yet read one faithfully (JS parses numbers into doubles), and that codec design\n     /// has not been done.\n     Int64,\n+    /// A double-precision IEEE 754 binary64 float, exactly JavaScript's number (ADR 0007):\n+    /// no alternative width, no decimal type. Deliberately a separate type from `Int`, and\n+    /// nothing converts implicitly: a decimal point is the spelling that makes a literal a\n+    /// Float, and mixing the two in one operator is an error rather than a silent promotion.\n+    /// Unlike the integer widths, arithmetic on a Float is total -- division by zero returns\n+    /// Infinity, the IEEE answer, where `Int` stops the program (the Q37 ruling in\n+    /// plans/questions.md, kantord/toylang#149).\n+    Float,\n     Bool,\n     /// A single Unicode scalar value (kantord/toylang#75): never a surrogate half, so a\n     /// codepoint outside the Basic Multilingual Plane is one `Char`, on every backend, even\n@@ -97,6 +105,7 @@ impl Type {\n             \"Str\" => Some(Type::Str),\n             \"Int\" => Some(Type::Int),\n             \"Int64\" => Some(Type::Int64),\n+            \"Float\" => Some(Type::Float),\n             \"Bool\" => Some(Type::Bool),\n             \"Char\" => Some(Type::Char),\n             _ => None,\n@@ -238,6 +247,7 @@ impl Type {\n             Type::Str => \"Str\".to_string(),\n             Type::Int => \"Int\".to_string(),\n             Type::Int64 => \"Int64\".to_string(),\n+            Type::Float => \"Float\".to_string(),\n             Type::Bool => \"Bool\".to_string(),\n             Type::Char => \"Char\".to_string(),\n             Type::Vec(t) => format!(\"Vec_{}\", t.ident()),\n@@ -276,6 +286,7 @@ impl std::fmt::Display for Type {\n             Type::Str => write!(f, \"Str\"),\n             Type::Int => write!(f, \"Int\"),\n             Type::Int64 => write!(f, \"Int64\"),\n+            Type::Float => write!(f, \"Float\"),\n             Type::Bool => write!(f, \"Bool\"),\n             Type::Char => write!(f, \"Char\"),\n             Type::Vec(t) => write!(f, \"Vec<{t}>\"),\n@@ -315,6 +326,7 @@ impl PartialEq for Type {\n             (Type::Str, Type::Str)\n             | (Type::Int, Type::Int)\n             | (Type::Int64, Type::Int64)\n+            | (Type::Float, Type::Float)\n             | (Type::Bool, Type::Bool)\n             | (Type::Char, Type::Char) => true,\n             (Type::Vec(a), Type::Vec(b)) => a == b,\n@@ -371,7 +383,7 @@ pub fn substitute(t: &Type, map: &HashMap<String, Type>) -> Type {\n                 .map(|(n, p)| (n.clone(), p.as_ref().map(|p| substitute(p, map))))\n                 .collect(),\n         },\n-        Type::Str | Type::Int | Type::Int64 | Type::Bool | Type::Char => t.clone(),\n+        Type::Str | Type::Int | Type::Int64 | Type::Float | Type::Bool | Type::Char => t.clone(),\n     }\n }\n \n","exit":0,"truncated":false},"title":"git show f22a806 -- src/ty.rs src/tir.rs src/ast.rs src/check/mod.rs src/check/linearity.rs src/emit_toylang.rs","time":{"start":1788369566677,"end":1788369566679}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me look at the JS commit's diffs for the other files: ast.rs, parse.rs, ty.rs, tir.rs, check/mod.rs, check/linearity.rs, emit_toylang.rs. Since those are shared and already landed, I need to know what's there so I can complete the Rust backend. Let me view the current state of the key shared files rather than diffs, since they're already in HEAD.\n\nLet me check the current emit_rs.rs unreachable arms and what tests exist. Also let me look at tests/corpus to see what corpus cases exist. And tests/backend_rs.rs.\n\nLet me also check what `emit_toylang.rs` change was (it had 1 line) and parse.rs to understand the float grammar.","format":"unknown","index":0}]}},"id":"prt_06321fa2c001g5bBCpfNQsAjVz","sessionID":"ses_f9cdf1744ffeXefkzNuE7Vt14g","messageID":"msg_06321eb8f001FsTbw6G7SQhCJi"}}
