pan,\n     },\n+    /// A decimal-point literal (ADR 0007): an IEEE 754 binary64 double, the same\n+    /// representation every JavaScript engine carries. The dot is what makes a number a Float,\n+    /// and there is no alternative width or decimal type to guess at.\n+    Float {\n+        value: f64,\n+        span: Span,\n+    },\n     VecLit {\n         items: Vec<Expr>,\n         span: Span,\n@@ -365,6 +372,7 @@ impl Expr {\n         match self {\n             Expr::Str { span, .. }\n             | Expr::Int { span, .. }\n+            | Expr::Float { span, .. }\n             | Expr::VecLit { span, .. }\n             | Expr::Subject { span }\n             | Expr::Var { span, .. }\ndiff --git a/src/check/linearity.rs b/src/check/linearity.rs\nindex 9925273..b0da974 100644\n--- a/src/check/linearity.rs\n+++ b/src/check/linearity.rs\n@@ -37,7 +37,7 @@ fn stream_uses(t: &Tir, binding: &StreamBinding) -> Result<usize, LinearViolatio\n             StreamBinding::Local(l) => (l == id) as usize,\n             StreamBinding::Param(_) => 0,\n         }),\n-        Kind::Str(_) | Kind::Int(_) | Kind::Input | Kind::Inputs | Kind::Lines => Ok(0),\n+        Kind::Str(_) | Kind::Int(_) | Kind::Float(_) | Kind::Input | Kind::Inputs | Kind::Lines => Ok(0),\n         Kind::VecLit(items) => items\n             .iter()\n             .try_fold(0, |n, i| Ok(n + stream_uses(i, binding)?)),\n@@ -167,6 +167,7 @@ fn any_node(t: &Tir, pred: &dyn Fn(&Tir) -> bool) -> bool {\n         | Kind::Local(_)\n         | Kind::Str(_)\n         | Kind::Int(_)\n+        | Kind::Float(_)\n         | Kind::Input\n         | Kind::Inputs\n         | Kind::Lines => false,\n@@ -254,6 +255,7 @@ fn calls_in(t: &Tir, out: &mut Vec<String>) {\n     match &t.kind {\n         Kind::Str(_)\n         | Kind::Int(_)\n+        | Kind::Float(_)\n         | Kind::Var(_)\n         | Kind::Local(_)\n         | Kind::Input\ndiff --git a/src/check/mod.rs b/src/check/mod.rs\nindex 3328821..d306e2f 100644\n--- a/src/check/mod.rs\n+++ b/src/check/mod.rs\n@@ -1295,6 +1295,13 @@ fn synth(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\n             Ok(Tir::new(Type::Int, Kind::Int(*value)))\n         }\n \n+        // A float literal is exactly the binary64 it spells (ADR 0007): there is no width to\n+        // resolve and no range to check, so a position has nothing to contribute, unlike Int.\n+        Expr::Float { value, span } => {\n+            let _ = span;\n+            Ok(Tir::new(Type::Float, Kind::Float(*value)))\n+        }\n+\n         Expr::Subject { span } => match &ctx.subject {\n             Some((ty, id)) => Ok(Tir::new(ty.clone(), Kind::Local(*id))),\n             None => Err(Error::new(*span, \"`.` is not bound here\")),\n@@ -1488,11 +1495,14 @@ fn synth(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\n                 }\n                 return Ok(Tir::new(Type::Int, Kind::Int(-value)));\n             }\n+            if let Expr::Float { value, .. } = base.as_ref() {\n+                return Ok(Tir::new(Type::Float, Kind::Float(-value)));\n+            }\n             // Synthesise first, so `-x` works at whichever integer width `x` already has; a\n             // form that can only be checked (`-input` fixing input to Int) falls back to the\n             // Int expectation this arm always applied.\n             let inner = match synth(ctx, base) {\n-                Ok(inner) if matches!(inner.ty, Type::Int | Type::Int64) => inner,\n+                Ok(inner) if matches!(inner.ty, Type::Int | Type::Int64 | Type::Float) => inner,\n                 Ok(inner) => {\n                     return Err(Error::new(\n                         base.span(),\n@@ -2091,7 +2101,7 @@ fn binary(ctx: &Ctx, op: BinOp, lhs: &Expr, rhs: &Expr) -> Result<Tir, Error> {\n \n         // Comparison never crosses the integer widths either: the sides must already agree,\n         // and the mismatch names `i64` the same way arithmetic's does.\n-        if matches!(left.ty, Type::Int | Type::Int64) {\n+        if matches!(left.ty, Type::Int | Type::Int64 | Type::Float) {\n             let right = expect_int_width(ctx, rhs, &left.ty, op)?;\n             return Ok(Tir::new(\n                 Type::Bool,\n@@ -2136,10 +2146,10 @@ fn binary(ctx: &Ctx, op: BinOp, lhs: &Expr, rhs: &Expr) -> Result<Tir, Error> {\n     }\n \n     if op.is_arithmetic() {\n-        if !matches!(left.ty, Type::Int | Type::Int64) {\n+        if !matches!(left.ty, Type::Int | Type::Int64 | Type::Float) {\n             return Err(Error::new(\n                 lhs.span(),\n-                format!(\"expected Int or Int64, found {}\", left.ty),\n+                format!(\"expected Int, Int64, or Float, found {}\", left.ty),\n             ));\n         }\n         // Both sides share the left's width: nothing widens implicitly (kantord/toylang#83),\n@@ -2167,7 +2177,7 @@ fn binary(ctx: &Ctx, op: BinOp, lhs: &Expr, rhs: &Expr) -> Result<Tir, Error> {\n /// sides to agree.\n fn plus(ctx: &Ctx, lhs: &Expr, left: Tir, rhs: &Expr) -> Result<Tir, Error> {\n     match &left.ty {\n-        Type::Int | Type::Int64 => {\n+        Type::Int | Type::Int64 | Type::Float => {\n             let width = left.ty.clone();\n             let right = expect_int_width(ctx, rhs, &width, BinOp::Add)?;\n             let kind = Kind::Arith {\ndiff --git a/src/emit_toylang.rs b/src/emit_toylang.rs\nindex 7195ffa..c70f825 100644\n--- a/src/emit_toylang.rs\n+++ b/src/emit_toylang.rs\n@@ -405,6 +405,7 @@ fn print_expr_inner(e: &Expr, ctx: Ctx) -> String {\n     match e {\n         Expr::Str { text, .. } => format!(\"\\\"{}\\\"\", escape_str(text)),\n         Expr::Int { value, .. } => value.to_string(),\n+        Expr::Float { value, .. } => crate::float::lit(*value),\n         Expr::VecLit { items, .. } => {\n             let items_str = items\n                 .iter()\ndiff --git a/src/tir.rs b/src/tir.rs\nindex e677161..6e548c2 100644\n--- a/src/tir.rs\n+++ b/src/tir.rs\n@@ -27,6 +27,10 @@ pub type LocalId = u32;\n p