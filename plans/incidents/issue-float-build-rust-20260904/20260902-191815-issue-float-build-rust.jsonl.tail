e() {\n+        panic!(\"cannot write a non-finite value as a float literal\");\n+    }\n+    n.to_string()\n+}\ndiff --git a/src/input.rs b/src/input.rs\nindex 3f4a6d9..6134c1b 100644\n--- a/src/input.rs\n+++ b/src/input.rs\n@@ -30,6 +30,12 @@ pub fn validate(enums: &Enums, value: &Value, ty: &Type, path: &str) -> Result<(\n             };\n         }\n \n+        (Type::Float, Value::Number(_)) => {\n+            // A Float is the double a JSON number already is (ADR 0007), so every JSON number\n+            // -- integer or not -- reads as one, with no exactness to lose the way Int64 does.\n+            return Ok(());\n+        }\n+\n         (Type::Vec(elem), Value::Array(items)) => {\n             for (i, item) in items.iter().enumerate() {\n                 validate(enums, item, elem, &format!(\"{path}[{i}]\"))?;\ndiff --git a/src/lib.rs b/src/lib.rs\nindex b0f20d1..6eda96b 100644\n--- a/src/lib.rs\n+++ b/src/lib.rs\n@@ -9,6 +9,7 @@ pub mod emit_py;\n pub mod emit_rs;\n pub mod emit_toylang;\n pub mod error;\n+pub mod float;\n pub mod fmt_tree;\n pub mod input;\n pub mod parse;\ndiff --git a/src/tags.rs b/src/tags.rs\nindex 3364201..715ed05 100644\n--- a/src/tags.rs\n+++ b/src/tags.rs\n@@ -32,6 +32,7 @@ fn walk(tir: &Tir, tags: &mut BTreeSet<String>) {\n     match &tir.kind {\n         Kind::Str(_)\n         | Kind::Int(_)\n+        | Kind::Float(_)\n         | Kind::Var(_)\n         | Kind::Local(_)\n         | Kind::Input\n@@ -111,6 +112,7 @@ fn tag(tir: &Tir) -> String {\n         // say (kantord/toylang#83), so the tag reads it rather than the kind.\n         Kind::Int(_) if tir.ty == crate::ty::Type::Int64 => \"int64\".into(),\n         Kind::Int(_) => \"int\".into(),\n+        Kind::Float(_) => \"float\".into(),\n         Kind::VecLit(_) => \"vec-literal\".into(),\n         Kind::RecordLit { .. } => \"record-literal\".into(),\n         // CONTEXT.md's terms: a `variant` is one alternative, a `unit variant` carries nothing.\n","exit":0,"truncated":false},"title":"git show f22a806 -- src/float.rs src/input.rs build.rs src/lib.rs src/tags.rs","time":{"start":1788369562278,"end":1788369562282}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now I have a full picture of emit_rs.rs. It's the Rust backend emitter. Currently it has `unreachable!(\"Float is JS-only in this row\")` in several places:\n- `rs_type`: `Type::Float => unreachable!(\"Float is JS-only in this row\")`\n- `parser_expr`: `Type::Float => unreachable!(\"Float is JS-only in this row\")`\n- `expr`: `Kind::Float(_) => unreachable!(\"Float is JS-only in this row\")`\n- `show`: `Type::Float => unreachable!(\"Float is JS-only in this row\")`\n\nWait, interesting: `parser_expr` has `Type::Float => unreachable!(\"Float is JS-only in this row\")` but the JS commit's message said \"A Float reads off the wire as the JSON number it already is, the case that made Int64 refuse input.\" So the Rust backend needs a float parser too (`tl_parse_f64`).\n\nLet me now look at the JS implementation's emit_js.rs diff and the shared parts. Also let me look at:\n- src/float.rs\n- tests/backend_js.rs (to see what tests were added)\n- tests/corpus/ (to see what corpus cases were added)\n- src/input.rs (to see how Float is read off the wire)\n- build.rs (what changed there)\n\nLet me look at the JS commit's full diff for the relevant parts.","format":"unknown","index":0}]}},"id":"prt_06321e93b0015G6O5l2Yr2RGkM","sessionID":"ses_f9cdf1744ffeXefkzNuE7Vt14g","messageID":"msg_06321cfcb001A4c1KHpu5Pot2Q"}}
{"type":"tool_use","timestamp":1788369562479,"sessionID":"ses_f9cdf1744ffeXefkzNuE7Vt14g","part":{"type":"tool","tool":"bash","callID":"chatcmpl-tool-8f2f5d15c6f09cb4","state":{"status":"completed","input":{"command":"git show f22a806 -- tests/backend_js.rs"},"output":"commit f22a8060efeb4cc81b8722763ee401b0943bca2e\nAuthor: Daniel Kantor <git@daniel-kantor.com>\nDate:   Wed Sep 2 10:08:40 2026 +0200\n\n    Add Float for the JS backend (IEEE binary64, ADR 0007)\n    \n    A decimal-point literal is a Float: a separate type from Int with no\n    implicit conversion, so mixing the two in one operator is an error the\n    same way mixing Int and Int64 is. Division is total -- a zero divisor\n    returns Infinity, the IEEE answer, where Int stops the program -- and\n    NaN and Infinity print as their names. A Float reads off the wire as\n    the JSON number it already is, the case that made Int64 refuse input.\n    JS emits plain number operators and prints through String().\n    \n    The other six backends get unreachable arms for Float nodes and types:\n    their exhaustive matches over the shared Type/Kind enums have to\n    compile, and Float never reaches them while it is JS-only. Their real\n    implementations are follow-up rows, not this one.\n    \n    Derived: binary64 representation and total division (ADR 0007, the Q37\n    ruling), Float-in-input reading a JSON number, the separate-type and\n    no-implicit-conversion rules (Int64's precedent)\n    Agent-invented: float literal grammar (. and exponent only join when\n    digits follow), the shortest-round-trip literal spelling in src/float.rs\n    Written by DeepSeek V4 Flash via opencode.\n    \n    Co-Authored-By: DeepSeek V4 Flash <deepseek-v4-flash>\n\ndiff --git a/tests/backend_js.rs b/tests/backend_js.rs\nindex 4f53f33..aa209f2 100644\n--- a/tests/backend_js.rs\n+++ b/tests/backend_js.rs\n@@ -31,3 +31,47 @@ first(input)\n     assert_eq!(declared_order, reversed);\n     insta::assert_snapshot!(declared_order);\n }\n+\n+// Float is JS-only in this row (kantord/toylang#149): the other backends do not carry it yet,\n+// so none of these can be a corpus case, which would require every backend to agree. They live\n+// here, JS-only, until the follow-up rows bring Float to the rest of the backends.\n+\n+/// A decimal-point literal parses, type-checks, and prints through the JS printer.\n+#[test]\n+fn float_literals_parse_and_print() {\n+    let out = toylang::run_on(\"1.5 + 0.25 * 2.0\\n\", None, Backend::Js).unwrap();\n+    assert_eq!(out, \"2\\n\");\n+}\n+\n+/// Division on a Float is total (ADR 0007, the Q37 ruling): a zero divisor is the IEEE answer,\n+/// Infinity, not the stop an Int's `1 / 0` is.\n+#[test]\n+fn float_division_by_zero_is_infinity() {\n+    let out = toylang::run_on(\"1.0 / 0.0\\n\", None, Backend::Js).unwrap();\n+    assert_eq!(out, \"Infinity\\n\");\n+}\n+\n+/// NaN and Infinity are values a Float can hold, and both print as their names.\n+#[test]\n+fn float_nan_and_infinity_are_producible() {\n+    let nan = toylang::run_on(\"0.0 / 0.0\\n\", None, Backend::Js).unwrap();\n+    assert_eq!(nan, \"NaN\\n\");\n+    let neg = toylang::run_on(\"-1.0 / 0.0\\n\", None, Backend::Js).unwrap();\n+    assert_eq!(neg, \"-Infinity\\n\");\n+}\n+\n+/// Float comparisons type-check and print a Bool.\n+#[test]\n+fn float_comparison() {\n+    let out = toylang::run_on(\"1.5 < 2.5\\n\", None, Backend::Js).unwrap();\n+    assert_eq!(out, \"true\\n\");\n+}\n+\n+/// A Float result keeps its value when read back off the wire: a JSON number already is the\n+/// double a Float names (ADR 0007), the case that made Int64 refuse `input`.\n+#[test]\n+fn float_input_reads_a_json_number() {\n+    let src = \"fn twice(x: Float) -> Float = x * 2.0\\n\\ntwice(input)\\n\";\n+    let out = toylang::run_on(src, Some(\"2.5\"), Backend::Js).unwrap();\n+    assert_eq!(out, \"5\\n\");\n+}\n","metadata":{"output":"commit f22a8060efeb4cc81b8722763ee401b0943bca2e\nAuthor: Daniel Kantor <git@daniel-kantor.com>\nDate:   Wed Sep 2 10:08:40 2026 +0200\n\n    Add Float for the JS backend (IEEE binary64, ADR 0007)\n    \n    A decimal-point literal is a Float: a separate type from Int with no\n    implicit conversion, so mixing the two in one operator is an error the\n    same way mixing Int and Int64 is. Division is total -- a zero divisor\n    returns Infinity, the IEEE answer, where Int stops the program -- and\n    NaN and Infinity print as their names. A Float reads off the wire as\n    the JSON number it already is, the case that made Int64 refuse input.\n    JS emits plain number operators and prints through String().\n    \n    The other six backends get unreachable arms for Float nodes and types:\n    their exhaustive matches over the shared Type/Kind enums have to\n    compile, and Float never reaches them while it is JS-only. Their real\n    implementations are follow-up rows, not this one.\n    \n    Derived: binary64 representation and total division (ADR 0007, the Q37\n    ruling), Float-in-input reading a JSON number, the separate-type and\n    no-implicit-conversion rules (Int64's precedent)\n    Agent-invented: float literal grammar (. and exponent only join when\n    digits follow), the shortest-round-trip literal spelling in src/float.rs\n    Written by DeepSeek V4 Flash via opencode.\n    \n    Co-Authored-By: DeepSeek V4 Flash <deepseek-v4-flash>\n\ndiff --git a/tests/backend_js.rs b/tests/backend_js.rs\nindex 4f53f33..aa209f2 100644\n--- a/tests/backend_js.rs\n+++ b/tests/backend_js.rs\n@@ -31,3 +31,47 @@ first(input)\n     assert_eq!(declared_order, reversed);\n     insta::assert_snapshot!(declared_order);\n }\n+\n+// Float is JS-only in this row (kantord/toylang#149): the other backends do not carry it yet,\n+// so none of these can be a corpus case, which would require every backend to agree. They live\n+// here, JS-only, until the follow-up rows bring Float to the rest of the backends.\n+\n+/// A decimal-point literal parses, type-checks, and prints through the JS printer.\n+#[test]\n+fn float_literals_parse_and_print() {\n+    let out = toylang::run_on(\"1.5 + 0.25 * 2.0\\n\", None, Backend::Js).unwrap();\n+    assert_eq!(out, \"2\\n\");\n+}\n+\n+/// Division on a Float is total (ADR 0007, the Q37 ruling): a zero divisor is the IEEE answer,\n+/// Infinity, not the stop an Int's `1 / 0` is.\n+#[test]\n+fn float_division_by_zero_is_infinity() {\n+    let out = toylang::run_on(\"1.0 / 0.0\\n\", None, Backend::Js).unwrap();\n+    assert_eq!(out, \"Infinity\\n\");\n+}\n+\n+/// NaN and Infinity are values a Float can hold, and both print as their names.\n+#[test]\n+fn float_nan_and_infinity_are_producible() {\n+    let nan = toylang::run_on(\"0.0 / 0.0\\n\", None, Backend::Js).unwrap();\n+    assert_eq!(nan, \"NaN\\n\");\n+    let neg = toylang::run_on(\"-1.0 / 0.0\\n\", None, Backend::Js).unwrap();\n+    assert_eq!(neg, \"-Infinity\\n\");\n+}\n+\n+/// Float comparisons type-check and print a Bool.\n+#[test]\n+fn float_comparison() {\n+    let out = toylang::run_on(\"1.5 < 2.5\\n\", None, Backend::Js).unwrap();\n+    assert_eq!(out, \"true\\n\");\n+}\n+\n+/// A Float result keeps its value when read back off the wire: a JSON number already is the\n+/// double a Float names (ADR 0007), the case that made Int64 refuse `input`.\n+#[test]\n+fn float_input_reads_a_json_number() {\n+    let src = \"fn twice(x: Float) -> Float = x * 2.0\\n\\ntwice(input)\\n\";\n+    let out = toylang::run_on(src, Some(\"2.5\"), Backend::Js).unwrap();\n+    assert_eq!(out, \"5\\n\");\n+}\n","exit":0,"truncated":false},"title":"git show f22a806 -- tests/backend_js.rs","time":{"start":1788369562477,"end":1788369562478}},"id":"prt_06321ea97001RvSzQZhZdxiMET","sessionID":"ses_f9cdf1744ffeXefkzNuE7Vt14g","messageID":"msg_06321cfcb001A4c1KHpu5Pot2Q"}}
