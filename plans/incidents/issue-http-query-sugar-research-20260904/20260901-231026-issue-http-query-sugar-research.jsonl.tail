end::Js => \"js\",\n63:            Backend::Native => \"native\",\n64:            Backend::Jq => \"jq\",\n65:            Backend::Go => \"go\",\n66:            Backend::Py => \"py\",\n67:            Backend::Rust => \"rust\",\n73:            Backend::Lua => Ok(emit_lua::emit(program)),\n74:            Backend::Js => Ok(emit_js::emit(program)),\n75:            Backend::Native => emit_llvm::to_ir(program),\n76:            Backend::Jq => emit_jq::emit(program),\n77:            Backend::Go => Ok(emit_go::emit(program)),\n78:            Backend::Py => Ok(emit_py::emit(program)),\n79:            Backend::Rust => Ok(emit_rs::emit(program)),\n98:    run_on(src, None, Backend::Lua)\n102:    run_on(src, stdin, Backend::Lua)\n138:    let lua_fused = matches!(backend, Backend::Lua) && streams_inputs(&program);\n143:        (Some(ty), Some(text)) => {\n148:        (Some(ty), None) => anyhow::bail!(\"this program reads input, of type {ty}\"),\n149:        (None, _) => None,\n165:            (Some(elem_ty), Some(text)) => {\n175:            (Some(elem_ty), None) => {\n","exit":0,"truncated":false},"title":"grep -n \"Backend::\\|fn from_str\\|=> \" src/lib.rs | head -30","time":{"start":1788297258336,"end":1788297258339}},"id":"prt_05ed2a437001BMm60dVmERCa1a","sessionID":"ses_fa130e14bffeHOCZtybDeHH22K","messageID":"msg_05ed21b700014x54H6wO7X1qt5"}}
