.join(\", \"))\nsrc/emit_toylang.rs:371:fn escape_str(s: &str) -> String {\nsrc/fmt_tree.rs:83:fn collect(dir: &Path, out: &mut Vec<PathBuf>, report: &mut Report) {\nsrc/parse.rs:188:                \"dsv\" => Tok::Dsv,\nsrc/parse.rs:713:            return Ok(match name.as_str() {\nsrc/tags.rs:126:        Kind::Dsv { .. } => \"dsv\".into(),\nsrc/tags.rs:169:        Builtin::Range => \"range\",\nsrc/tags.rs:170:        Builtin::Collect => \"collect\",\n","metadata":{"output":"src/check/mod.rs:495:    \"collect\",\nsrc/check/mod.rs:503:    \"range\",\nsrc/check/mod.rs:524:        \"range\" => (\nsrc/check/mod.rs:941:fn collect(ctx: &Ctx, arg: &Expr, want_elem: Option<&Type>) -> Result<Tir, Error> {\nsrc/check/mod.rs:1345:                        \"a match cannot yield a stream; pass each arm to `collect` first\"\nsrc/check/mod.rs:1452:                        \"`dsv` cannot be read inside `fn {func}`; a source is legal only in \\\nsrc/check/mod.rs:1811:    if func == \"collect\" {\nsrc/check/mod.rs:2953:    if let Some(arg) = call_named(expr, \"collect\")\nsrc/emit_jq.rs:78:        out.push_str(&match &f.param {\nsrc/emit_jq.rs:865:    fn collect(\nsrc/emit_llvm.rs:1407:                    Builtin::Range => self.call_rt(self.rt.range, &[arg], \"range\")?,\nsrc/emit_llvm.rs:2454:    fn range_has_more(\nsrc/emit_rs.rs:294:    fn parse_str(&mut self) -> String {\nsrc/emit_rs.rs:390:fn tl_parse_str(p: &mut TlParser) -> String {\nsrc/emit_rs.rs:623:        decls.push_str(\"fn main() {\\n\");\nsrc/emit_rs.rs:713:fn collect_wire(enums: &Enums, ty: &Type, out: &mut Vec<Type>) {\nsrc/emit_rs.rs:961:        out.push_str(\"        match s.as_str() {\\n\");\nsrc/emit_rs.rs:974:        out.push_str(\"        let v = match key.as_str() {\\n\");\nsrc/emit_rs.rs:1012:        out.push_str(\"            match key.as_str() {\\n\");\nsrc/emit_rs.rs:1046:        out.push_str(\"fn main() {\\n\");\nsrc/emit_rs.rs:1049:        out.push_str(match fusion.source {\nsrc/emit_rs.rs:1511:        for