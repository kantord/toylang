{"type":"tool_use","timestamp":1788372460821,"sessionID":"ses_f9cb37b32ffekf1PK55ZywltbG","part":{"type":"tool","tool":"bash","callID":"call_c44e3871e2704a45897f7316","state":{"status":"completed","input":{"command":"git show 45c76be -- src/tir.rs src/check/mod.rs | head -350"},"output":"commit 45c76bedb230aa116e19dbd1e30e47aee4ca4d94\nAuthor: Daniel Kantor <git@daniel-kantor.com>\nDate:   Tue Sep 1 23:26:58 2026 +0200\n\n    Retire input/inputs/lines for one stdin source with parse as a library call\n    \n    The stdin-syntax-design ruling (gh:159, tentative): three keywords become a\n    single raw Stream<Str> source named `stdin`, and reading a value is an\n    ordinary `parse(.)` call over it. The parser, checker, TIR, and every backend\n    now carry `stdin` and the `parse` builtin instead of the three source forms;\n    the host connects live stdin only when the program reads the source.\n    \n    Source migration only; the corpus and test files still spell the old keywords\n    and land in a follow-up.\n    \n    Human-authored: the single-source shape and parse-as-library-call semantics\n    Derived: per-backend parse emission from each target's native JSON handling\n    Agent-invented: the parse_read checked-form wiring in the checker\n    \n    Written by DeepSeek V4 Flash via opencode.\n    \n    Co-Authored-By: DeepSeek V4 Flash via opencode <git@daniel-kantor.com>\n\ndiff --git a/src/check/mod.rs b/src/check/mod.rs\nindex ec005db..b3076bd 100644\n--- a/src/check/mod.rs\n+++ b/src/check/mod.rs\n@@ -1,4 +1,4 @@\n-use std::cell::{Cell, RefCell};\n+use std::cell::Cell;\n use std::collections::{HashMap, HashSet};\n \n use crate::ast::{BinOp, Expr, FieldsPattern, File, MatchArm, Param, Pattern, Span};\n@@ -28,22 +28,17 @@ struct Ctx<'a> {\n     arm_fields: Vec<(String, Type, LocalId)>,\n     /// What `.` refers to here, if anything: its type and the local holding it.\n     subject: Option<(Type, LocalId)>,\n-    /// The type `input` was checked against, filled in the first time it is used.\n-    input: &'a RefCell<Option<Type>>,\n-    /// The element type `inputs` was checked against, filled in the first time it is used. A\n-    /// separate cell from `input`'s: one records a whole value's type, the other one line's.\n-    inputs: &'a RefCell<Option<Type>>,\n-    /// Whether `lines` has already been read. There is only ever one real stdin, so a second\n+    /// Whether `stdin` has already been read. There is only ever one real stdin, so a second\n     /// read is refused rather than silently handed nothing, the way a second pass over an\n     /// already-consumed iterator would be in a language that let it compile.\n-    lines_used: &'a Cell<bool>,\n+    stdin_used: &'a Cell<bool>,\n     /// Whether checking is inside a mapper's body (`map`'s, or `select`'s predicate), which\n     /// runs once per element: a source read there would drain stdin on the first element and\n-    /// hand every later one nothing, so `lines` and `inputs` are refused in that position.\n+    /// hand every later one nothing, so `stdin` is refused in that position.\n     in_mapper: bool,\n     /// The name of the `fn` whose body is being checked; `None` in the program's own body. A\n-    /// source is legal only in the program body (see `source_in_fn`), so `lines` and `inputs`\n-    /// are refused whenever this is set.\n+    /// source is legal only in the program body (see `source_in_fn`), so `stdin` is refused\n+    /// whenever this is set.\n     in_fn: Option<&'a str>,\n     next_local: &'a Cell<LocalId>,\n }\n@@ -57,9 +52,7 @@ impl Ctx<'_> {\n             scope: self.scope.clone(),\n             arm_fields: self.arm_fields.clone(),\n             subject,\n-            input: self.input,\n-            inputs: self.inputs,\n-            lines_used: self.lines_used,\n+            stdin_used: self.stdin_used,\n             in_mapper: self.in_mapper,\n             in_fn: self.in_fn,\n             next_local: self.next_local,\n@@ -74,7 +67,7 @@ impl Ctx<'_> {\n }\n \n pub fn check(file: &File) -> Result<tir::Program, Error> {\n-    let lines_used = Cell::new(false);\n+    let stdin_used = Cell::new(false);\n     let aliases = alias_map(&file.aliases)?;\n     let env = TypeEnv {\n         aliases,\n@@ -110,8 +103,6 @@ pub fn check(file: &File) -> Result<tir::Program, Error> {\n         }\n     }\n     let sigs = signatures(&file.defs, &env)?;\n-    let input = RefCell::new(None);\n-    let inputs = RefCell::new(None);\n     let next_local = Cell::new(0);\n     let ctx = Ctx {\n         sigs: &sigs,\n@@ -120,9 +111,7 @@ pub fn check(file: &File) -> Result<tir::Program, Error> {\n         scope: Vec::new(),\n         arm_fields: Vec::new(),\n         subject: None,\n-        input: &input,\n-        inputs: &inputs,\n-        lines_used: &lines_used,\n+        stdin_used: &stdin_used,\n         in_mapper: false,\n         in_fn: None,\n         next_local: &next_local,\n@@ -162,43 +151,10 @@ pub fn check(file: &File) -> Result<tir::Program, Error> {\n             \"the program's result contains a Char, which has no wire form to print\".to_string(),\n         ));\n     }\n-    let input = input.into_inner();\n-    let inputs = inputs.into_inner();\n-    // Forced by the backends, not chosen: Python's `input` reads all of stdin to EOF before\n-    // parsing, leaving nothing for anything else to read afterward, and jq needs a different\n-    // invocation flag for raw lines (`-R -n`) than for parsed JSON values (`-n` alone) -- one\n-    // process cannot run with both. So all three ways of reading the same real stdin are\n-    // mutually exclusive, not just `input` and `lines` as before.\n-    if input.is_some() && lines_used.get() {\n-        return Err(Error::new(\n-            file.body.span(),\n-            \"a program cannot use both `input` and `lines`; they read the same real stdin two \\\n-             different ways\"\n-                .to_string(),\n-        ));\n-    }\n-    if input.is_some() && inputs.is_some() {\n-        return Err(Error::new(\n-            file.body.span(),\n-            \"a program cannot use both `input` and `inputs`; they read the same real stdin two \\\n-             different ways\"\n-                .to_string(),\n-        ));\n-    }\n-    if lines_used.get() && inputs.is_some() {\n-        return Err(Error::new(\n-            file.body.span(),\n-            \"a program cannot use both `lines` and `inputs`; they read the same real stdin two \\\n-             different ways\"\n-                .to_string(),\n-        ));\n-    }\n     Ok(tir::Program {\n         funcs: prune_unreachable(funcs, &body),\n         body,\n-        input,\n-        inputs,\n-        uses_lines: lines_used.get(),\n+        uses_stdin: stdin_used.get(),\n         enums,\n     })\n }\n@@ -228,9 +184,7 @@ fn check_defs<'a>(\n             scope,\n             arm_fields: Vec::new(),\n             subject: None,\n-            input: ctx.input,\n-            inputs: ctx.inputs,\n-            lines_used: ctx.lines_used,\n+            stdin_used: ctx.stdin_used,\n             in_mapper: false,\n             in_fn: Some(&def.name),\n             next_local: ctx.next_local,\n@@ -291,9 +245,7 @@ pub fn check_module(module: &crate::ast::Module) -> Result<Vec<tir::Func>, Error\n         }\n     }\n     let sigs = signatures(&module.defs, &env)?;\n-    let input = RefCell::new(None);\n-    let inputs = RefCell::new(None);\n-    let lines_used = Cell::new(false);\n+    let stdin_used = Cell::new(false);\n     let next_local = Cell::new(0);\n     let ctx = Ctx {\n         sigs: &sigs,\n@@ -302,9 +254,7 @@ pub fn check_module(module: &crate::ast::Module) -> Result<Vec<tir::Func>, Error\n         scope: Vec::new(),\n         arm_fields: Vec::new(),\n         subject: None,\n-        input: &input,\n-        inputs: &inputs,\n-        lines_used: &lines_used,\n+        stdin_used: &stdin_used,\n         in_mapper: false,\n         in_fn: None,\n         next_local: &next_local,\n@@ -388,11 +338,11 @@ fn check_program_body(ctx: &Ctx, body: &Expr) -> Result<Tir, Error> {\n \n /// Every function name the language itself provides, and therefore reserves. `str`, `range`,\n /// `chars`, and `i64` live in `builtin()`'s fixed table; `jsonlines`, `length`, `flatten`,\n-/// `tail`, `collect`, `fields`, `sort`, `reverse`, `sum`, and `max` are polymorphic and checked\n-/// from `synth`'s own arms; `select` and `map` rebind `.`. All sixteen are reserved the same\n-/// way, and the docs harness (tests/docs.rs) reads this list to insist each one has a\n-/// reference page.\n-pub const BUILTIN_NAMES: [&str; 16] = [\n+/// `tail`, `collect`, `fields`, `sort`, `reverse`, `sum`, `max`, and `parse` are polymorphic\n+/// and checked from `synth`'s own arms; `select` and `map` rebind `.`. All seventeen are\n+/// reserved the same way, and the docs harness (tests/docs.rs) reads this list to insist each\n+/// one has a reference page.\n+pub const BUILTIN_NAMES: [&str; 17] = [\n     \"chars\",\n     \"collect\",\n     \"length\",\n@@ -402,6 +352,7 @@ pub const BUILTIN_NAMES: [&str; 16] = [\n     \"jsonlines\",\n     \"map\",\n     \"max\",\n+    \"parse\",\n     \"range\",\n     \"reverse\",\n     \"select\",\n@@ -1258,25 +1209,25 @@ fn match_chain(\n fn synth(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\n     match expr {\n         Expr::Str { text, .. } => Ok(Tir::new(Type::Str, Kind::Str(text.clone()))),\n-        Expr::Lines { span } => {\n+        Expr::Stdin { span } => {\n             if let Some(func) = ctx.in_fn {\n-                return Err(source_in_fn(*span, \"lines\", func));\n+                return Err(source_in_fn(*span, \"stdin\", func));\n             }\n             if ctx.in_mapper {\n                 return Err(Error::new(\n                     *span,\n-                    \"`lines` cannot be read inside a mapper body, which runs once per element\"\n+                    \"`stdin` cannot be read inside a mapper body, which runs once per element\"\n                         .to_string(),\n                 ));\n             }\n-            if ctx.lines_used.get() {\n+            if ctx.stdin_used.get() {\n                 return Err(Error::new(\n                     *span,\n-                    \"`lines` has already been read; there is only one stdin\".to_string(),\n+                    \"`stdin` has already been read; there is only one stdin\".to_string(),\n                 ));\n             }\n-            ctx.lines_used.set(true);\n-            Ok(Tir::new(Type::Stream(Box::new(Type::Str)), Kind::Lines))\n+            ctx.stdin_used.set(true);\n+            Ok(Tir::new(Type::Stream(Box::new(Type::Str)), Kind::Stdin))\n         }\n         Expr::Int { value, span } => {\n             // The literal is the one place a value could enter without meeting the 32-bit rule,\n@@ -1427,19 +1378,6 @@ fn synth(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\n             Ok(access.tir)\n         }\n \n-        // `input` names one value, so its first checked use fixes the type for the whole\n-        // program -- and a later use in a position that expects nothing can borrow what the\n-        // first use fixed. With no use typed yet, nothing says what it contains, and guessing\n-        // is what the annotation rule avoids.\n-        Expr::Input { span } => match ctx.input.borrow().as_ref() {\n-            Some(ty) => Ok(Tir::new(ty.clone(), Kind::Input)),\n-            None => Err(Error::new(*span, \"cannot tell what `input` contains\")),\n-        },\n-        Expr::Inputs { span } => match ctx.in_fn {\n-            Some(func) => Err(source_in_fn(*span, \"inputs\", func)),\n-            None => Err(Error::new(*span, \"cannot tell what `inputs` contains\")),\n-        },\n-\n         Expr::Call {\n             func,\n             func_span,\n@@ -1606,6 +1544,17 @@ fn call(\n             \"`jsonlines` is a sink, legal only as the program's outermost expression\".to_string(),\n         ));\n     }\n+    // `parse` has no type of its own: it is `Str -> T` for the `T` the position expects, so a\n+    // call in a position that expects nothing has nothing to resolve to. `expect` handles the\n+    // real call; reaching here is a synthesising position.\n+    if func == \"parse\" {\n+        return Err(Error::new(\n+            span,\n+            \"`parse` needs a position that expects its type; parse where something wants the \\\n+             value, like `collect(stdin | map(parse(.)))`\"\n+                .to_string(),\n+        ));\n+    }\n     // `length`, `tail`, and `flatten` are polymorphic over the element type, the same reason\n     // `jsonlines` is checked here rather than through `builtin()`'s fixed table.\n     if func == \"length\" {\n@@ -2503,114 +2452,46 @@ fn reorder_fields(\n         .collect()\n }\n \n-/// `expect`, minus the final comparison. Each arm here is a form whose type can come from its\n-/// position rather than its contents; expectation only ever resolves what synthesis would have\n-/// refused -- a form that can synthesise falls through and is compared, never coerced.\n-/// `input` against the type its position wants: the first use fills the program-wide slot,\n-/// and every later use must agree with it. A signature can spell Stream now, so this position\n-/// can ask for one; `input` is a whole value already in hand, which is exactly what a stream\n-/// is not.\n-fn input_read(ctx: &Ctx, span: Span, want: &Type) -> Result<Tir, Error> {\n+/// `parse(arg)`, checked against the type its position wants: the line's `Str` (the argument,\n+/// almost always `.` in a mapper body) is parsed as a value of `want`. The same no-wire-form\n+/// rules `input` used to state apply to the wanted type -- a stream is not a wire value, and\n+/// absence, Char, and Int64 have no decided codec -- because parse is the one place a wire\n+/// value enters the program.\n+fn parse_read(ctx: &Ctx, arg: &Expr, want: &Type) -> Result<Tir, Error> {\n     if want.contains_stream() {\n         return Err(Error::new(\n-            span,\n-            format!(\"`input` is one value read from stdin, but {want} is wanted here\"),\n+            arg.span(),\n+            format!(\"`parse` cannot produce {want}; a stream is read, not parsed\"),\n         ));\n     }\n-    // Absence has no ratified wire form: the tag is an in-memory fact, serialization emits\n-    // `null` for it going out, and whether `null` coming in reads as `none` is codec design\n-    // nobody has done. Refusing is the reversible direction.\n     if want.contains_opt() {\n         return Err(Error::new(\n-            span,\n-            format!(\"`input` cannot be read as {want}; absence has no wire form to read\"),\n+            arg.span(),\n+            format!(\"`parse` cannot produce {want}; absence has no wire form to read\"),\n         ));\n     }\n-    // A Char is never itself JSON; it only ever comes from decoding a Str already in hand\n-    // (`chars`), so there is nothing for a wire value to decode into.\n     if want.contains_char() {\n         return Err(Error::new(\n-            span,\n-            format!(\"`input` cannot be read as {want}; Char has no wire form to read\"),\n+            arg.span(),\n+            format!(\"`parse` cannot produce {want}; Char has no wire form to read\"),\n         ));\n     }\n-    // One-directional, unlike Char: an Int64 result prints fine, but reading one back is\n-    // codec design nobody has done -- JS parses JSON numbers into doubles and is off past\n-    // 2^53, and jq computes in them. Refusing is the reversible direction.\n     if want.contains_int64() {\n         return Err(Error::new(\n-            span,\n-            format!(\n-                \"`input` cannot be read as {want}; how an Int64 crosses the wire is not decided yet\"\n-            ),\n-        ));\n-    }\n-    let mut slot = ctx.input.borrow_mut();\n-    match slot.as_ref() {\n-        None => *slot = Some(want.clone()),\n-        Some(prev) if prev != want => {\n-            return Err(Error::new(\n-                span,\n-                format!(\"`input` is used as {prev} here and as {want} elsewhere\"),\n-            ));\n-        }\n-        Some(_) => {}\n-    }\n-    Ok(Tir::new(want.clone(), Kind::Input))\n-}\n-\n-/// `inputs` against the type its position wants, which must be a Stream. The filled slot\n-/// doubles as the single-use flag: a second `inputs` would be a second stream claiming the\n-/// same real stdin, the same mistake a second `lines` is.\n","metadata":{"output":"commit 45c76bedb230aa116e19dbd1e30e47aee4ca4d94\nAuthor: Daniel Kantor <git@daniel-kantor.com>\nDate:   Tue Sep 1 23:26:58 2026 +0200\n\n    Retire input/inputs/lines for one stdin source with parse as a library call\n    \n    The stdin-syntax-design ruling (gh:159, tentative): three keywords become a\n    single raw Stream<Str> source named `stdin`, and reading a value is an\n    ordinary `parse(.)` call over it. The parser, checker, TIR, and every backend\n    now carry `stdin` and the `parse` builtin instead of the three source forms;\n    the host connects live stdin only when the program reads the source.\n    \n    Source migration only; the corpus and test files still spell the old keywords\n    and land in a follow-up.\n    \n    Human-authored: the single-source shape and parse-as-library-call semantics\n    Derived: per-backend parse emission from each target's native JSON handling\n    Agent-invented: the parse_read checked-form wiring in the checker\n    \n    Written by DeepSeek V4 Flash via opencode.\n    \n    Co-Authored-By: DeepSeek V4 Flash via opencode <git@daniel-kantor.com>\n\ndiff --git a/src/check/mod.rs b/src/check/mod.rs\nindex ec005db..b3076bd 100644\n--- a/src/check/mod.rs\n+++ b/src/check/mod.rs\n@@ -1,4 +1,4 @@\n-use std::cell::{Cell, RefCell};\n+use std::cell::Cell;\n use std::collections::{HashMap, HashSet};\n \n use crate::ast::{BinOp, Expr, FieldsPattern, File, MatchArm, Param, Pattern, Span};\n@@ -28,22 +28,17 @@ struct Ctx<'a> {\n     arm_fields: Vec<(String, Type, LocalId)>,\n     /// What `.` refers to here, if anything: its type and the local holding it.\n     subject: Option<(Type, LocalId)>,\n-    /// The type `input` was checked against, filled in the first time it is used.\n-    input: &'a RefCell<Option<Type>>,\n-    /// The element type `inputs` was checked against, filled in the first time it is used. A\n-    /// separate cell from `input`'s: one records a whole value's type, the other one line's.\n-    inputs: &'a RefCell<Option<Type>>,\n-    /// Whether `lines` has already been read. There is only ever one real stdin, so a second\n+    /// Whether `stdin` has already been read. There is only ever one real stdin, so a second\n     /// read is refused rather than silently handed nothing, the way a second pass over an\n     /// already-consumed iterator would be in a language that let it compile.\n-    lines_used: &'a Cell<bool>,\n+    stdin_used: &'a Cell<bool>,\n     /// Whether checking is inside a mapper's body (`map`'s, or `select`'s predicate), which\n     /// runs once per element: a source read there would drain stdin on the first element and\n-    /// hand every later one nothing, so `lines` and `inputs` are refused in that position.\n+    /// hand every later one nothing, so `stdin` is refused in that position.\n     in_mapper: bool,\n     /// The name of the `fn` whose body is being checked; `None` in the program's own body. A\n-    /// source is legal only in the program body (see `source_in_fn`), so `lines` and `inputs`\n-    /// are refused whenever this is set.\n+    /// source is legal only in the program body (see `source_in_fn`), so `stdin` is refused\n+    /// whenever this is set.\n     in_fn: Option<&'a str>,\n     next_local: &'a Cell<LocalId>,\n }\n@@ -57,9 +52,7 @@ impl Ctx<'_> {\n             scope: self.scope.clone(),\n             arm_fields: self.arm_fields.clone(),\n             subject,\n-            input: self.input,\n-            inputs: self.inputs,\n-            lines_used: self.lines_used,\n+            stdin_used: self.stdin_used,\n             in_mapper: self.in_mapper,\n             in_fn: self.in_fn,\n             next_local: self.next_local,\n@@ -74,7 +67,7 @@ impl Ctx<'_> {\n }\n \n pub fn check(file: &File) -> Result<tir::Program, Error> {\n-    let lines_used = Cell::new(false);\n+    let stdin_used = Cell::new(false);\n     let aliases = alias_map(&file.aliases)?;\n     let env = TypeEnv {\n         aliases,\n@@ -110,8 +103,6 @@ pub fn check(file: &File) -> Result<tir::Program, Error> {\n         }\n     }\n     let sigs = signatures(&file.defs, &env)?;\n-    let input = RefCell::new(None);\n-    let inputs = RefCell::new(None);\n     let next_local = Cell::new(0);\n     let ctx = Ctx {\n         sigs: &sigs,\n@@ -120,9 +111,7 @@ pub fn check(file: &File) -> Result<tir::Program, Error> {\n         scope: Vec::new(),\n         arm_fields: Vec::new(),\n         subject: None,\n-        input: &input,\n-        inputs: &inputs,\n-        lines_used: &lines_used,\n+        stdin_used: &stdin_used,\n         in_mapper: false,\n         in_fn: None,\n         next_local: &next_local,\n@@ -162,43 +151,10 @@ pub fn check(file: &File) -> Result<tir::Program, Error> {\n             \"the program's result contains a Char, which has no wire form to print\".to_string(),\n         ));\n     }\n-    let input = input.into_inner();\n-    let inputs = inputs.into_inner();\n-    // Forced by the backends, not chosen: Python's `input` reads all of stdin to EOF before\n-    // parsing, leaving nothing for anything else to read afterward, and jq needs a different\n-    // invocation flag for raw lines (`-R -n`) than for parsed JSON values (`-n` alone) -- one\n-    // process cannot run with both. So all three ways of reading the same real stdin are\n-    // mutually exclusive, not just `input` and `lines` as before.\n-    if input.is_some() && lines_used.get() {\n-     