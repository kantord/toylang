{"type":"tool_use","timestamp":1788372572937,"sessionID":"ses_f9cb37b32ffekf1PK55ZywltbG","part":{"type":"tool","tool":"bash","callID":"call_d19b6ce7da9f49849f1416d1","state":{"status":"completed","input":{"command":"git show HEAD:src/ast.rs | grep -n 'input\\|Input\\|lines\\|Lines\\|annotation\\|stdin\\|Stdin' | head -30"},"output":"99:    /// `Stream<T>`, legal only as the whole of a parameter or return annotation: a stream is\n267:    /// The one source: a stream of raw lines read from stdin, born `Stream<Str>`. Whatever\n269:    /// than accepting a second stream, since there is only ever one real stdin.\n270:    Stdin {\n371:            | Expr::Stdin { span }\n","metadata":{"output":"99:    /// `Stream<T>`, legal only as the whole of a parameter or return annotation: a stream is\n267:    /// The one source: a stream of raw lines read from stdin, born `Stream<Str>`. Whatever\n269:    /// than accepting a second stream, since there is only ever one real stdin.\n270:    Stdin {\n371:            | Expr::Stdin { span }\n","exit":0,"truncated":false},"title":"git show HEAD:src/ast.rs | grep -n 'input\\|Input\\|lines\\|Lines\\|annotation\\|stdin\\|Stdin' | head -30","time":{"start":1788372572935,"end":1788372572936}},"id":"prt_0634fdafc0017G2U4QqSC5tDjs","sessionID":"ses_f9cb37b32ffekf1PK55ZywltbG","messageID":"msg_0634fc93a001po0pp4WHmfaEbt"}}
