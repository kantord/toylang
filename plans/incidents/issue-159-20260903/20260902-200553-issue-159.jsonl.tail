st of functions to write (kantord/toylang#94). Only what is\n491: /// printed: a program can hold a recursive value, match on it and print an Int, and a printer\n492: /// nobody calls is dead code that Go, at least, would then demand an import for.\n493: pub fn printed_recursive_enums(program: &Program) -> Vec<Type> {\n494:     let mut printed = vec![program.body.ty.clone()];\n495:     let mut collect_printed = |t: &Tir| {\n496:         if let Kind::Builtin {\n497:             which: Builtin::JsonLines,\n498:             arg,\n499:         } = &t.kind\n500:         {\n501:             printed.push(\n502:                 runtime_elem(&arg.ty)\n503:                     .expect(\"jsonlines takes a Vec or a stream\")\n504:                     .clone(),\n505:             );\n506:         }\n507:     };\n508:     for f in &program.funcs {\n509:         each_node(&f.body, &mut collect_printed);\n510:     }\n511:     each_node(&program.body, &mut collect_printed);\n512: \n513:     let mut found = Vec::new();\n514:     let mut seen = Vec::new();\n515:     for ty in &printed {\n516:         reachable_enums(&program.enums, ty, &mut seen, &mut found);\n517:     }\n518:     found.retain(|ty| crate::ty::is_recursive(&program.enums, ty));\n519:     found\n520: }\n521: \n522: /// Append every enum type nested anywhere in `ty` to `found`, descending through payloads read\n523: /// from the registry rather than off the type. `seen` is what stops a recursive one: its own\n524: /// payload leads back to a type already visited.\n525: fn reachable_enums(enums: &Enums, ty: &Type, seen: &mut Vec<Type>, found: &mut Vec<Type>) {\n526:     match ty {\n527:         Type::Vec(e) | Type::Stream(e) => reachable_enums(enums, e, seen, found),\n528:         Type::Record(fields) => {\n529:             for (_, f) in fields {\n530:                 reachable_enums(enums, f, seen, found);\n531:             }\n532:         }\n533:         Type::Enum { name, args, .. } => {\n534:             if seen.contains(ty) {\n535:                 return;\n536:             }\n537:             seen.push(ty.clone());\n538:             found.push(ty.clone());\n539:             for arg in args {\n540:                 reachable_enums(enums, arg, seen, found);\n541:             }\n542:             for (_, payload) in crate::ty::variants_of(enums, name, args) {\n543:                 if let Some(p) = payload {\n544:                     reachable_enums(enums, &p, seen, found);\n545:                 }\n546:             }\n547:         }\n548:         _ => {}\n549:     }\n550: }\n551: \n552: /// Every node in the tree, `t` itself included, in no particular order. The backends each walk\n553: /// the tree their own way, gathering what their own target needs; this is for the questions\n554: /// that are the same on every target.\n555: fn each_node(t: &Tir, f: &mut impl FnMut(&Tir)) {\n556:     f(t);\n557:     match &t.kind {\n558:         Kind::Str(_)\n559:         | Kind::Int(_)\n560:         | Kind::Var(_)\n561:         | Kind::Local(_)\n562: <<<<<<< HEAD\n563:         | Kind::Stdin => {}\n564: =======\n565:         | Kind::Input\n566:         | Kind::Inputs\n567:         | Kind::Lines\n568:         | Kind::Dsv { .. } => {}\n569: >>>>>>> origin/main\n570:         Kind::VecLit(items) => items.iter().for_each(|i| each_node(i, f)),\n571:         Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| each_node(v, f)),\n572:         Kind::EnumLit { payload, .. } => {\n573:             if let Some(p) = payload {\n574:                 each_node(p, f);\n575:             }\n576:         }\n577:         Kind::Call { arg, .. } => {\n578:             if let Some(a) = arg {\n579:                 each_node(a, f);\n580:             }\n581:         }\n582:         Kind::Concat(l, r)\n583:         | Kind::Compare { lhs: l, rhs: r, .. }\n584:         | Kind::Logic { lhs: l, rhs: r, .. }\n\n(Showing lines 455-584 of 646. Use offset=585 to continue.)\n</content>","metadata":{"preview":"/// The type question `streams_inputs` used to answer by pattern match: a `jsonlines` program\n/// whose argument is stream-typed fuses, and one whose argument is a Vec (already collected)\n/// stays an ordinary value and runs eagerly, exactly as its types say.\npub fn fusion(program: &Program) -> Option<Fusion<'_>> {\n    let Kind::Builtin {\n        which: Builtin::JsonLines,\n        arg,\n    } = &program.body.kind\n    else {\n        return None;\n    };\n    if !matches!(arg.ty, Type::Stream(_)) {\n        return None;\n    }\n    let mut stages = Vec::new();\n    let source = match flatten(arg, program, &mut stages) {\n<<<<<<< HEAD\n        Base::Stdin => Source::Stdin,\n=======\n        Base::Inputs => Source::Inputs,","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-159/src/tir.rs","text":"/// The type question `streams_inputs` used to answer by pattern match: a `jsonlines` program\n/// whose argument is stream-typed fuses, and one whose argument is a Vec (already collected)\n/// stays an ordinary value and runs eagerly, exactly as its types say.\npub fn fusion(program: &Program) -> Option<Fusion<'_>> {\n    let Kind::Builtin {\n        which: Builtin::JsonLines,\n        arg,\n    } = &program.body.kind\n    else {\n        return None;\n    };\n    if !matches!(arg.ty, Type::Stream(_)) {\n        return None;\n    }\n    let mut stages = Vec::new();\n    let source = match flatten(arg, program, &mut stages) {\n<<<<<<< HEAD\n        Base::Stdin => Source::Stdin,\n=======\n        Base::Inputs => Source::Inputs,\n        Base::Lines => Source::Lines,\n        Base::Range(bound) => Source::Range(bound),\n>>>>>>> origin/main\n        Base::Var(_) | Base::Local(_) => {\n            unreachable!(\"a program-level stream chain bottoms at its source\")\n        }\n    };\n    Some(Fusion { source, stages })\n}\n\n/// Every enum type the program prints that can hold another of its own type, deduplicated and\n/// in the order the walk meets them.\n///\n/// A backend writes its printer by expanding a type inline, which is exactly what does not\n/// terminate on one of these. So each gets a named function the expansion can call back into\n/// instead, and this is the list of functions to write (kantord/toylang#94). Only what is\n/// printed: a program can hold a recursive value, match on it and print an Int, and a printer\n/// nobody calls is dead code that Go, at least, would then demand an import for.\npub fn printed_recursive_enums(program: &Program) -> Vec<Type> {\n    let mut printed = vec![program.body.ty.clone()];\n    let mut collect_printed = |t: &Tir| {\n        if let Kind::Builtin {\n            which: Builtin::JsonLines,\n            arg,\n        } = &t.kind\n        {\n            printed.push(\n                runtime_elem(&arg.ty)\n                    .expect(\"jsonlines takes a Vec or a stream\")\n                    .clone(),\n            );\n        }\n    };\n    for f in &program.funcs {\n        each_node(&f.body, &mut collect_printed);\n    }\n    each_node(&program.body, &mut collect_printed);\n\n    let mut found = Vec::new();\n    let mut seen = Vec::new();\n    for ty in &printed {\n        reachable_enums(&program.enums, ty, &mut seen, &mut found);\n    }\n    found.retain(|ty| crate::ty::is_recursive(&program.enums, ty));\n    found\n}\n\n/// Append every enum type nested anywhere in `ty` to `found`, descending through payloads read\n/// from the registry rather than off the type. `seen` is what stops a recursive one: its own\n/// payload leads back to a type already visited.\nfn reachable_enums(enums: &Enums, ty: &Type, seen: &mut Vec<Type>, found: &mut Vec<Type>) {\n    match ty {\n        Type::Vec(e) | Type::Stream(e) => reachable_enums(enums, e, seen, found),\n        Type::Record(fields) => {\n            for (_, f) in fields {\n                reachable_enums(enums, f, seen, found);\n            }\n        }\n        Type::Enum { name, args, .. } => {\n            if seen.contains(ty) {\n                return;\n            }\n            seen.push(ty.clone());\n            found.push(ty.clone());\n            for arg in args {\n                reachable_enums(enums, arg, seen, found);\n            }\n            for (_, payload) in crate::ty::variants_of(enums, name, args) {\n                if let Some(p) = payload {\n                    reachable_enums(enums, &p, seen, found);\n                }\n            }\n        }\n        _ => {}\n    }\n}\n\n/// Every node in the tree, `t` itself included, in no particular order. The backends each walk\n/// the tree their own way, gathering what their own target needs; this is for the questions\n/// that are the same on every target.\nfn each_node(t: &Tir, f: &mut impl FnMut(&Tir)) {\n    f(t);\n    match &t.kind {\n        Kind::Str(_)\n        | Kind::Int(_)\n        | Kind::Var(_)\n        | Kind::Local(_)\n<<<<<<< HEAD\n        | Kind::Stdin => {}\n=======\n        | Kind::Input\n        | Kind::Inputs\n        | Kind::Lines\n        | Kind::Dsv { .. } => {}\n>>>>>>> origin/main\n        Kind::VecLit(items) => items.iter().for_each(|i| each_node(i, f)),\n        Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| each_node(v, f)),\n        Kind::EnumLit { payload, .. } => {\n            if let Some(p) = payload {\n                each_node(p, f);\n            }\n        }\n        Kind::Call { arg, .. } => {\n            if let Some(a) = arg {\n                each_node(a, f);\n            }\n        }\n        Kind::Concat(l, r)\n        | Kind::Compare { lhs: l, rhs: r, .. }\n        | Kind::Logic { lhs: l, rhs: r, .. }","lineStart":455,"lineEnd":584,"totalLines":646,"truncated":true}},"title":"src/tir.rs","time":{"start":1788372486341,"end":1788372486351}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"This is getting complex. The tir.rs conflicts involve:\n\n1. Lines 61-76: Kind enum: Stdin (ours) vs Input/Inputs/Lines/Dsv (theirs, but with retirement → Stdin + Dsv).\n\n2. Lines 278-294: Program struct: `uses_stdin: bool` (ours) vs `input: Option<Type>, inputs: Option<Type>, uses_lines: bool, dsv: Option<String>` (theirs. The retirement means: the merged Program should carry `uses_stdin: bool` (ours, and ALSO `dsv: Option<String>` from origin/main. So merged:\n\n```\n    /// Whether the program reads `stdin`. A stream is read at most once,and the flag is what\n    /// lets the host connect the real stdin through rather than pre-reading it.\n    pub uses_stdin: bool,\n    /// The delimiter the program splits raw lines on, if it reads `dsv`/`csv`/`tsv`. It\n    /// reads the same real stdin as the source,so it is exclusive with it.\n    pub dsv: Option<String>,\n```\n\nHmm wait, but is `dsv` compatible with our retirement? Dsv is a source that origin/main added. Our retirement didn't touch it. So merged Program: uses_stdin: bool + dsv: Option<String>.. But hold on: does dsv reading relate to uses_stdin? In origin/main, `uses_lines` etc indicate whether to connect stdin. With dsv being a separate reader of stdin, it should also set the stdin flag. Hmm. Actually, let me look at how origin/main's check/mod.rs sets dsv, and how our branch's check sets uses_stdin, to build a consistent merged model. \n\nLet me look at our HEAD's tir.rs around the Program struct to see our full side, and origin/main's. Actually I have our side (lines 279-281)and theirs (283-293)already. Our side: only `uses_stdin: bool`. Theirs: `input/inputs/uses_lines/dsv`. Merged: `uses_stdin: bool` + `dsv: Option<String>`.\n\n,with the doc comment for dsv adjusted (\"reads the same real stdin as the source\" rather than \"the other three\").\n\nHmm wait, but actually is `dsv` really a stdin reader in origin/main? The doc says \"It reads the same real stdin as the other three,so it is exclusive with them.\" So yes dsv is stdin. So merged: uses_stdin and dsv (both stdin readers).\n\n3. Lines 331-347: `Source` enum: ours = `#[derive(Clone, Copy, PartialEq, Eq)] pub enum Source { Stdin, }`; theirs = `#[derive(Clone, Copy)] pub enum Source<'a> { Inputs, Lines, Range(&'a Tir), }`. \n\nMerged: Source should include Stdin, Range (theirs,, and maybe not Inputs/Lines. So:\n\n```\n/// What a fused loop reads one entry at a time: a raw line of stdin,to be parsed by whatever\n/// `parse` calls sit in the stages,or integers counted out of a `range` call.\n#[derive(Clone, Copy)]\npub enum Source<'a> {\n    Stdin,\n    /// `range(n)` with its already-checked bound `n`, evaluated once before the loop runs.\n    Range(&'a Tir),\n}\n```\n\nNote: the `PartialEq, Eq` derive from ours (because Stdin is unit-like; Range(&'a Tir) can't be PartialEq without Tir PartialEq). The theirs version dropped PartialEq/Eq (probably because Range<Tir> can't derive Eq). So use theirs' derive (Clone, Copy, no PartialEq/Eq. Wait, ours had `PartialEq, Eq`. Theirs just `Clone, Copy`. Since merged includes Range(&'a Tir), we need theirs' derive. So `#[derive(Clone, Copy)]`.\n\n\n\n4. Lines 361-370: `Base` enum: ours = `Stdin,`; theirs = `Inputs, Lines, Range(&'a Tir),`. Merged:\n\n```\nenum Base<'a> {\n    Stdin,\n    Range(&'a Tir),\n    Var(&'a String),\n    Local(LocalId),\n}\n```\n\nWait, the order: theirs had `Inputs, Lines, Range, Var, Local`. Merged: `Stdin, Range, Var, Local`. Hmm, keep Stdin first (or Range first? whatever. Let me put Stdin then Range. Actually ours had just `Stdin`. theirs had `Inputs, Lines, Range`. So merged `Stdin, Range`.\n\n5. Lines 382-393: flatten() match: ours = `Kind::Stdin => Base::Stdin,`; theirs = `Kind::Inputs => Base::Inputs, Kind::Lines => Base::Lines, Kind::Builtin { which: Builtin::Range, arg, } => Base::Range(arg),` with comment. Merged:\n\n```\n        Kind::Stdin => Base::Stdin,\n        // A stream-typed range is its own birth point:the bound is an ordinary value\n        // evaluated once,before the loop.\n\n        Kind::Builtin {\n            which: Builtin::Range,\n            arg,\n        } => Base::Range(arg),\n```\n\n6. Lines 471-477 and 562-569: more blocks. Let me read those.","format":"unknown","index":0}]}},"id":"prt_0634e88bd001Fc6QcmbDQoBKeo","sessionID":"ses_f9cb37b32ffekf1PK55ZywltbG","messageID":"msg_0634e612a001zPSytpyMFB7YSA"}}
