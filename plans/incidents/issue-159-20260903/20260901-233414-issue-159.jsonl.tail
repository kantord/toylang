{"type":"tool_use","timestamp":1788298471156,"sessionID":"ses_fa11b16e3ffejSNgKGkK0vX2sJ","part":{"type":"tool","tool":"bash","callID":"call_17d57bccdf304ef29d8f7794","state":{"status":"completed","input":{"command":"git show 45c76be -- src/ast.rs src/tags.rs src/tir.rs src/parse.rs"},"output":"commit 45c76bedb230aa116e19dbd1e30e47aee4ca4d94\nAuthor: Daniel Kantor <git@daniel-kantor.com>\nDate:   Tue Sep 1 23:26:58 2026 +0200\n\n    Retire input/inputs/lines for one stdin source with parse as a library call\n    \n    The stdin-syntax-design ruling (gh:159, tentative): three keywords become a\n    single raw Stream<Str> source named `stdin`, and reading a value is an\n    ordinary `parse(.)` call over it. The parser, checker, TIR, and every backend\n    now carry `stdin` and the `parse` builtin instead of the three source forms;\n    the host connects live stdin only when the program reads the source.\n    \n    Source migration only; the corpus and test files still spell the old keywords\n    and land in a follow-up.\n    \n    Human-authored: the single-source shape and parse-as-library-call semantics\n    Derived: per-backend parse emission from each target's native JSON handling\n    Agent-invented: the parse_read checked-form wiring in the checker\n    \n    Written by DeepSeek V4 Flash via opencode.\n    \n    Co-Authored-By: DeepSeek V4 Flash via opencode <git@daniel-kantor.com>\n\ndiff --git a/src/ast.rs b/src/ast.rs\nindex 149374f..61cdd55 100644\n--- a/src/ast.rs\n+++ b/src/ast.rs\n@@ -264,19 +264,10 @@ pub enum Expr {\n         name: String,\n         span: Span,\n     },\n-    /// The value read from stdin. It has no type of its own and can only be checked against an\n-    /// expected one, which is the same rule the draft gives for lambdas.\n-    Input {\n-        span: Span,\n-    },\n-    /// Every remaining JSON value on stdin, one per line, collected eagerly into a `Vec<T>`.\n-    /// Like `input`, its element type comes only from where it is used.\n-    Inputs {\n-        span: Span,\n-    },\n-    /// The stream of lines read from stdin, born `Stream<Str>`. The checker rejects a second\n-    /// use rather than accepting a second stream, since there is only ever one real stdin.\n-    Lines {\n+    /// The one source: a stream of raw lines read from stdin, born `Stream<Str>`. Whatever\n+    /// each line means is a `parse(.)` call's business. The checker rejects a second use rather\n+    /// than accepting a second stream, since there is only ever one real stdin.\n+    Stdin {\n         span: Span,\n     },\n     /// An `or` chain of match arms over the subject `.`: `point -> 0 or circle{r} -> r * r`.\n@@ -377,9 +368,7 @@ impl Expr {\n             | Expr::Not { span, .. }\n             | Expr::Cond { span, .. }\n             | Expr::Field { span, .. }\n-            | Expr::Input { span }\n-            | Expr::Inputs { span }\n-            | Expr::Lines { span }\n+            | Expr::Stdin { span }\n             | Expr::Variant { span, .. }\n             | Expr::Match { span, .. }\n             | Expr::Pipe { span, .. }\ndiff --git a/src/parse.rs b/src/parse.rs\nindex 69ccc21..d54a7eb 100644\n--- a/src/parse.rs\n+++ b/src/parse.rs\n@@ -44,9 +44,7 @@ enum Tok {\n     Enum,\n     If,\n     Else,\n-    Input,\n-    Inputs,\n-    Lines,\n+    Stdin,\n     And,\n     Or,\n     Not,\n@@ -89,9 +87,7 @@ impl std::fmt::Display for Tok {\n             Tok::Enum => \"`enum`\",\n             Tok::If => \"`if`\",\n             Tok::Else => \"`else`\",\n-            Tok::Input => \"`input`\",\n-            Tok::Inputs => \"`inputs`\",\n-            Tok::Lines => \"`lines`\",\n+            Tok::Stdin => \"`stdin`\",\n             Tok::And => \"`and`\",\n             Tok::Or => \"`or`\",\n             Tok::Not => \"`not`\",\n@@ -179,9 +175,7 @@ fn read_tok<'i>(input: &mut Input<'i>) -> Result<(Tok, Span), Error> {\n                 \"enum\" => Tok::Enum,\n                 \"if\" => Tok::If,\n                 \"else\" => Tok::Else,\n-                \"input\" => Tok::Input,\n-                \"inputs\" => Tok::Inputs,\n-                \"lines\" => Tok::Lines,\n+                \"stdin\" => Tok::Stdin,\n                 \"and\" => Tok::And,\n                 // Two operators sharing one spelling, told apart by position: the arm separator\n                 // at a chain's top level, Bool disjunction everywhere else. `Cursor::or_separates`\n@@ -1165,7 +1159,7 @@ impl<'i> Cursor<'i> {\n         }\n         let argument_starts = match next {\n             Tok::LParen | Tok::LBrace => true,\n-            Tok::Str(_) | Tok::Int(_) | Tok::Input | Tok::Inputs | Tok::Lines | Tok::Ident(_) => {\n+            Tok::Str(_) | Tok::Int(_) | Tok::Stdin | Tok::Ident(_) => {\n                 bare_callee(&name)\n             }\n             _ => false,\n@@ -1212,9 +1206,7 @@ impl<'i> Cursor<'i> {\n         match tok {\n             Tok::Str(text) => Ok(Expr::Str { text, span }),\n             Tok::Int(value) => Ok(Expr::Int { value, span }),\n-            Tok::Input => Ok(Expr::Input { span }),\n-            Tok::Inputs => Ok(Expr::Inputs { span }),\n-            Tok::Lines => Ok(Expr::Lines { span }),\n+            Tok::Stdin => Ok(Expr::Stdin { span }),\n \n             // `.name` is field access on the subject, so the leading dot yields `.` and the\n             // postfix loop above picks the field up.\ndiff --git a/src/tags.rs b/src/tags.rs\nindex 7b727fc..23501e1 100644\n--- a/src/tags.rs\n+++ b/src/tags.rs\n@@ -34,9 +34,7 @@ fn walk(tir: &Tir, tags: &mut BTreeSet<String>) {\n         | Kind::Int(_)\n         | Kind::Var(_)\n         | Kind::Local(_)\n-        | Kind::Input\n-        | Kind::Inputs\n-        | Kind::Lines => {}\n+        | Kind::Stdin => {}\n         Kind::VecLit(items) => items.iter().for_each(|i| walk(i, tags)),\n         Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| walk(v, tags)),\n         Kind::EnumLit { payload, .. } => {\n@@ -120,8 +118,7 @@ fn tag(tir: &Tir) -> String {\n         } => \"variant.payload\".into(),\n         Kind::Var(_) => \"var\".into(),\n         Kind::Local(_) => \"local\".into(),\n-        Kind::Input => \"input\".into(),\n-        Kind::Lines => \"lines\".into(),\n+        Kind::Stdin => \"stdin\".into(),\n         Kind::Call { .. } => \"application\".into(),\n         Kind::Concat(..) => \"concat\".into(),\n         Kind::Arith { op, .. } => format!(\"arith.{}\", binop_tag(*op)),\n@@ -137,7 +134,6 @@ fn tag(tir: &Tir) -> String {\n         Kind::Builtin { which, .. } => format!(\"builtin.{}\", builtin_tag(*which)),\n         Kind::Unwrap { .. } => \"unwrap\".into(),\n         Kind::Index { .. } => \"selection.collapse\".into(),\n-        Kind::Inputs => \"inputs\".into(),\n         Kind::Match { .. } => \"match\".into(),\n     }\n }\n@@ -174,5 +170,6 @@ fn builtin_tag(which: Builtin) -> &'static str {\n         Builtin::Reverse => \"reverse\",\n         Builtin::Sum => \"sum\",\n         Builtin::Max => \"max\",\n+        Builtin::Parse => \"parse\",\n     }\n }\ndiff --git a/src/tir.rs b/src/tir.rs\nindex 8db97b3..918c2b6 100644\n--- a/src/tir.rs\n+++ b/src/tir.rs\n@@ -58,12 +58,8 @@ pub enum Kind {\n     /// A name written in the source: today only a function parameter.\n     Var(String),\n     Local(LocalId),\n-    /// The value read from stdin.\n-    Input,\n-    /// Every remaining JSON value on stdin, one per line, eagerly collected into a `Vec<T>`.\n-    Inputs,\n-    /// The stream of lines read from stdin, read incrementally by whatever consumes it.\n-    Lines,\n+    /// The one source: the stream of raw lines read from stdin, born `Stream<Str>`.\n+    Stdin,\n     Call {\n         func: String,\n         /// `None` for a call to a nullary function.\n@@ -243,6 +239,11 @@ pub enum Builtin {\n     /// same two integer element types `sum` takes, so a backend can reach for its native\n     /// maximum.\n     Max,\n+    /// `parse(s)`, `Str -> T`: parse one line of stdin (a raw `Str`) as a value of the type\n+    /// the position expects. The one place a wire value enters the program, so it is checked\n+    /// against the wanted type the way a source used to be, and a backend emits it as its own\n+    /// per-type JSON parser over the argument string.\n+    Parse,\n }\n \n pub struct Func {\n@@ -256,14 +257,9 @@ pub struct Func {\n pub struct Program {\n     pub funcs: Vec<Func>,\n     pub body: Tir,\n-    /// The type stdin must have, if the program reads it.\n-    pub input: Option<Type>,\n-    /// The element type each line of stdin parses as, if the program reads `inputs`.\n-    pub inputs: Option<Type>,\n-    /// Whether the program reads `lines`. A separate flag from `input`, since the two are\n-    /// unrelated readers of the same real stdin and a program using `lines` alone still needs\n-    /// it connected, even though `input` is `None`.\n-    pub uses_lines: bool,\n+    /// Whether the program reads `stdin`. A stream is read at most once, and the flag is what\n+    /// lets the host connect the real stdin through rather than pre-reading it.\n+    pub uses_stdin: bool,\n     /// Every enum the program declared, the prelude's included. A backend has no checker `Ctx`\n     /// to hand, and the variant list on a `Type::Enum` is a placeholder wherever a recursive\n     /// enum's payload reaches back to itself, so this travels with the tree: it is what\n@@ -300,11 +296,11 @@ pub enum Stage<'a> {\n     Select { param: LocalId, pred: &'a Tir },\n }\n \n-/// What a fused loop reads one entry at a time: parsed JSON values, or raw lines.\n+/// What a fused loop reads one entry at a time: a raw line of stdin, to be parsed by whatever\n+/// `parse` calls sit in the stages.\n #[derive(Clone, Copy, PartialEq, Eq)]\n pub enum Source {\n-    Inputs,\n-    Lines,\n+    Stdin,\n }\n \n /// A stream-typed pipeline ending in `jsonlines`, compiled as a read-one/transform-one/\n@@ -319,8 +315,7 @@ pub struct Fusion<'a> {\n /// What a stream chain bottoms out at: a source, a function's own parameter, or the local a\n /// `|` bound.\n enum Base<'a> {\n-    Inputs,\n-    Lines,\n+    Stdin,\n     Var(&'a String),\n     Local(LocalId),\n }\n@@ -335,8 +330,7 @@ enum Base<'a> {\n /// to fuse would silently materialize stdin, which is the defect the feature exists to remove.\n fn flatten<'a>(t: &'a Tir, program: &'a Program, stages: &mut Vec<Stage<'a>>) -> Base<'a> {\n     match &t.kind {\n-        Kind::Inputs => Base::Inputs,\n-        Kind::Lines => Base::Lines,\n+        Kind::Stdin => Base::Stdin,\n         Kind::Var(name) => Base::Var(name),\n         Kind::Local(id) => Base::Local(*id),\n         Kind::Bind { local, value, body } => {\n@@ -414,8 +408,7 @@ pub fn fusion(program: &Program) -> Option<Fusion<'_>> {\n     }\n     let mut stages = Vec::new();\n     let source = match flatten(arg, program, &mut stages) {\n-        Base::Inputs => Source::Inputs,\n-        Base::Lines => Source::Lines,\n+        Base::Stdin => Source::Stdin,\n         Base::Var(_) | Base::Local(_) => {\n             unreachable!(\"a program-level stream chain bottoms at its source\")\n         }\n@@ -500,9 +493,7 @@ fn each_node(t: &Tir, f: &mut impl FnMut(&Tir)) {\n         | Kind::Int(_)\n         | Kind::Var(_)\n         | Kind::Local(_)\n-        | Kind::Input\n-        | Kind::Inputs\n-        | Kind::Lines => {}\n+        | Kind::Stdin => {}\n         Kind::VecLit(items) => items.iter().for_each(|i| each_node(i, f)),\n         Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| each_node(v, f)),\n         Kind::EnumLit { payload, .. } => {\n","metadata":{"output":"commit 45c76bedb230aa116e19dbd1e30e47aee4ca4d94\nAuthor: Daniel Kantor <git@daniel-kantor.com>\nDate:   Tue Sep 1 23:26:58 2026 +0200\n\n    Retire input/inputs/lines for one stdin source with parse as a library call\n    \n    The stdin-syntax-design ruling (gh:159, tentative): three keywords become a\n    single raw Stream<Str> source named `stdin`, and reading a value is an\n    ordinary `parse(.)` call over it. The parser, checker, TIR, and every backend\n    now carry `stdin` and the `parse` builtin instead of the three source forms;\n    the host connects live stdin only when the program reads the source.\n    \n    Source migration only; the corpus and test files still spell the old keywords\n    and land in a follow-up.\n    \n    Human-authored: the single-source shape and parse-as-library-call semantics\n    Derived: per-backend parse emission from each target's native JSON handling\n    Agent-invented: the parse_read checked-form wiring in the checker\n    \n    Written by DeepSeek V4 Flash via opencode.\n    \n    Co-Authored-By: DeepSeek V4 Flash via opencode <git@daniel-kantor.com>\n\ndiff --git a/src/ast.rs b/src/ast.rs\nindex 149374f..61cdd55 100644\n--- a/src/ast.rs\n+++ b/src/ast.rs\n@@ -264,19 +264,10 @@ pub enum Expr {\n         name: String,\n         span: Span,\n     },\n-    /// The value read from stdin. It has no type of its own and can only be checked against an\n-    /// expected one, which is the same rule the draft gives for lambdas.\n-    Input {\n-        span: Span,\n-    },\n-    /// Every remaining JSON value on stdin, one per line, collected eagerly into a `Vec<T>`.\n-    /// Like `input`, its element type comes only from where it is used.\n-    Inputs {\n-        span: Span,\n-    },\n-    /// The stream of lines read from stdin, born `Stream<Str>`. The checker rejects a second\n-    /// use rather than accepting a second stream, since there is only ever one real stdin.\n-    Lines {\n+    /// The one source: a stream of raw lines read from stdin, born `Stream<Str>`. Whatever\n+    /// each line means is a `parse(.)` call's business. The checker rejects a second use rather\n+    /// than accepting a second stream, since there is only ever one real stdin.\n+    Stdin {\n         span: Span,\n     },\n     /// An `or` chain of match arms over the subject `.`: `point -> 0 or circle{r} -> r * r`.\n@@ 