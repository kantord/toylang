 local function skip_ws()\n+    while true do\n+      local c = s:sub(pos, pos)\n+      if c == \" \" or c == \"\\t\" or c == \"\\n\" or c == \"\\r\" then pos = pos + 1 else break end\n+    end\n+  end\n+  local function fail(msg) tl_fail(msg) end\n+  local function parse_string()\n+    pos = pos + 1\n+    local out = {}\n+    while true do\n+      local c = s:sub(pos, pos)\n+      if c == \"\" then fail(\"unterminated string\") end\n+      if c == '\"' then pos = pos + 1 break end\n+      if c == \"\\\\\" then\n+        local e = s:sub(pos + 1, pos + 1)\n+        if e == \"n\" then out[#out + 1] = \"\\n\"\n+        elseif e == \"t\" then out[#out + 1] = \"\\t\"\n+        elseif e == \"r\" then out[#out + 1] = \"\\r\"\n+        elseif e == \"b\" then out[#out + 1] = \"\\8\"\n+        elseif e == \"f\" then out[#out + 1] = \"\\12\"\n+        elseif e == \"/\" or e == \"\\\\\" or e == '\"' then out[#out + 1] = e\n+        else fail(\"unsupported escape\") end\n+        pos = pos + 2\n+      else\n+        out[#out + 1] = c\n+        pos = pos + 1\n+      end\n+    end\n+    return table.concat(out)\n+  end\n+  local function parse_value()\n+    skip_ws()\n+    local c = s:sub(pos, pos)\n+    if c == \"{\" then\n+      pos = pos + 1\n+      local t = {}\n+      skip_ws()\n+      if s:sub(pos, pos) == \"}\" then pos = pos + 1 return t end\n+      while true do\n+        skip_ws()\n+        local key = parse_string()\n+        skip_ws()\n+        if s:sub(pos, pos) ~= \":\" then fail(\"expected ':'\") end\n+        pos = pos + 1\n+        t[key] = parse_value()\n+        skip_ws()\n+        local d = s:sub(pos, pos)\n+        if d == \",\" then pos = pos + 1\n+        elseif d == \"}\" then pos = pos + 1 return t\n+        else fail(\"expected ',' or '}'\") end\n+      end\n+    elseif c == \"[\" then\n+      pos = pos + 1\n+      local t = {}\n+      skip_ws()\n+      if s:sub(pos, pos) == \"]\" then pos = pos + 1 return t end\n+      while true do\n+        t[#t + 1] = parse_value()\n+        skip_ws()\n+        local d = s:sub(pos, pos)\n+        if d == \",\" then pos = pos + 1\n+        elseif d == \"]\" then pos = pos + 1 return t\n+        else fail(\"expected ',' or ']'\") end\n+      end\n+    elseif c == '\"' then\n+      return parse_string()\n+    elseif s:sub(pos, pos + 3) == \"true\" then pos = pos + 4 return true\n+    elseif s:sub(pos, pos + 4) == \"false\" then pos = pos + 5 return false\n+    elseif s:sub(pos, pos + 3) == \"null\" then pos = pos + 4 return nil\n+    else\n+      local n = s:match(\"^-?%d+%.?%d*([eE][+-]?%d+)?\", pos)\n+      if not n or n == \"\" then fail(\"expected a number\") end\n+      pos = pos + #n\n+      return tonumber(n)\n+    end\n+  end\n+  local v = parse_value()\n+  skip_ws()\n+  if pos ~= #s + 1 then fail(\"trailing content after the value\") end\n+  return v\n+end\n+\"#;\n+\n pub fn emit(program: &Program) -> String {\n     let enums = &program.enums;\n     let mut out = String::new();\n@@ -286,6 +365,7 @@ pub fn emit(program: &Program) -> String {\n         (used.collect, COLLECT_HELPER),\n         (used.jsonlines, JSONLINES_HELPER),\n         (used.chars, CHARS_HELPER),\n+        (used.parse, JSON_HELPER),\n         (used.eq, EQ_HELPER),\n     ] {\n         if on {\n@@ -328,25 +408,16 @@ pub fn emit(program: &Program) -> String {\n     out\n }\n \n-/// A stream-typed `jsonlines` program, compiled as a loop over one entry at a time: for an\n-/// `inputs` source, a call to `NEXT_INPUT` for one already-parsed record (see that constant's\n-/// doc comment for why the parsing itself is not written here); for `lines`, `io.lines()`\n-/// itself, exactly as the eager collect helper reads it.\n+/// A stream-typed `jsonlines` program, compiled as a loop over one raw line at a time, exactly\n+/// as the eager collect helper reads it: `io.lines()`, which runs the Lua backend's own\n+/// line-splitting in the loop.\n fn fused_main(program: &Program, fusion: &tir::Fusion) -> String {\n     let enums = &program.enums;\n     let mut out = String::new();\n     let (mut current, mut current_ty) = match fusion.source {\n-        tir::Source::Inputs => {\n-            out.push_str(\"while true do\\n\");\n-            out.push_str(&format!(\"  local t_line = {NEXT_INPUT}()\\n\"));\n-            out.push_str(\"  if t_line == nil then break end\\n\");\n-            let elem = program\n-                .inputs\n-                .as_ref()\n-                .expect(\"an inputs source recorded its element\");\n-            (\"t_line\".to_string(), elem.clone())\n-        }\n-        tir::Source::Lines => {\n+        // `io.lines()` reads one raw line at a time, exactly as the eager collect helper reads\n+        // it; a raw line is already the element, blank ones included.\n+        tir::Source::Stdin => {\n             out.push_str(\"for t_line in io.lines() do\\n\");\n             (\"t_line\".to_string(), Type::Str)\n         }\n@@ -537,6 +608,7 @@ struct Helpers {\n     sum: bool,\n     max: bool,\n     eq: bool,\n+    parse: bool,\n }\n \n /// Equality on a composite is structural, which Lua's `==` on two tables is not -- it compares\n@@ -583,6 +655,7 @@ fn builtin_helpers(which: Builtin, arg_ty: &Type, used: &mut Helpers) {\n     used.reverse |= which == Builtin::Reverse;\n     used.sum |= which == Builtin::Sum;\n     used.max |= which == Builtin::Max;\n+    used.parse |= which == Builtin::Parse;\n     used.arith |= which == Builtin::Sum && tir::runtime_elem(arg_ty) == Some(&Type::Int);\n }\n \n@@ -592,11 +665,9 @@ fn used_helpers(program: &Program) -> Helpers {\n             Kind::Str(_)\n             | Kind::Int(_)\n             | Kind::Var(_)\n-            | Kind::Local(_)\n-            | Kind::Input\n-            | Kind::Inputs => {}\n+            | Kind::Local(_) => {}\n             // The source is what reads stdin now, so it is what needs the helper.\n-            Kind::Lines => used.collect = true,\n+            Kind::Stdin => used.collect = true,\n             Kind::VecLit(items) => items.iter().for_each(|i| walk(i, used)),\n             Kind::RecordLit { fields } => {\n                 fields.iter().for_each(|(_, v)| walk(v, used));\n@@ -715,11 +786,9 @@ fn expr(enums: &Enums, t: &Tir) -> String {\n         Kind::Int(n) => n.to_string(),\n         Kind::Var(name) => user(name),\n         Kind::Local(id) => local(*id),\n-        Kind::Input => INPUT.to_string(),\n-        Kind::Inputs => INPUTS.to_string(),\n         // The stream, materialized eagerly: whatever consumes it -- `collect`, a mapper --\n-        // works on the table of its entries. Fusion is what will remove this materialization.\n-        Kind::Lines => \"tl_collect_lines()\".to_string(),\n+        // works on the table of its raw lines.\n+        Kind::Stdin => \"tl_collect_lines()\".to_string(),\n         // A record is a table keyed by field name, which is what field access reads.\n         Kind::RecordLit { fields } => {\n             let parts: Vec<String> = fields\n@@ -791,6 +860,8 @@ fn expr(enums: &Enums, t: &Tir) -> String {\n                 tir::runtime_elem(&arg.ty) == Some(&Type::Int)\n             ),\n             Builtin::Max => format!(\"tl_max({})\", expr(enums, arg)),\n+            // Parse one raw line as the node's own result type: the in-language JSON parser.\n+            Builtin::Parse => format!(\"tl_parse_json({})\", expr(enums, arg)),\n             // The names come from the checked type, not the table value, so `arg` runs as the\n             // function literal's ignored parameter -- the same IIFE shape `Bind` uses -- purely\n             // for whatever else it does.\ndiff --git a/src/emit_toylang.rs b/src/emit_toylang.rs\nindex 7195ffa..3361143 100644\n--- a/src/emit_toylang.rs\n+++ b/src/emit_toylang.rs\n@@ -454,9 +454,7 @@ fn print_expr_inner(e: &Expr, ctx: Ctx) -> String {\n                 format!(\"{base_str}.{name}\")\n             }\n         }\n-        Expr::Input { .. } => \"input\".to_string(),\n-        E