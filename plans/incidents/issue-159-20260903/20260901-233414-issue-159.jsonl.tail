ne (a raw `Str`) as the node's own result type: the per-type\n+                // parser the `wire` collection emitted, applied to the argument string.\n+                Builtin::Parse => format!(\n+                    \"tl_parse_line(&{}, {})\",\n+                    self.expr(arg),\n+                    self.parser_expr(&t.ty)\n+                ),\n                 // The names come from the checked type, not the struct value, so `arg` is\n                 // evaluated only for whatever else it does (a division inside it must still\n                 // trap) and its value discarded.\n","exit":0,"truncated":false},"title":"git show 45c76be -- src/emit_go.rs src/emit_llvm.rs src/emit_rs.rs","time":{"start":1788298480861,"end":1788298480863}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05ee54cc0001HqM9hwZcOUYarR","sessionID":"ses_fa11b16e3ffejSNgKGkK0vX2sJ","messageID":"msg_05ee54730001mVLut4rQGfP4dK"}}
