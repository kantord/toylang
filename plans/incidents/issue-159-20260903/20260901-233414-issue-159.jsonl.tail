lk(lhs, tags);\n65:             walk(rhs, tags);\n66:         }\n67:         Kind::Bind { value, body, .. }\n68:         | Kind::Map {\n69:             source: value,\n70:             body,\n71:             ..\n72:         }\n73:         | Kind::OptMap {\n74:             source: value,\n75:             body,\n76:             ..\n77:         } => {\n78:             walk(value, tags);\n79:             walk(body, tags);\n80:         }\n81:         Kind::Select { source, pred, .. } => {\n82:             walk(source, tags);\n83:             walk(pred, tags);\n84:         }\n85:         Kind::Field { base, .. } | Kind::Unwrap { base } | Kind::Not(base) => walk(base, tags),\n86:         Kind::Builtin { arg, .. } => walk(arg, tags),\n87:         Kind::Index { base, index, .. } => {\n88:             walk(base, tags);\n89:             walk(index, tags);\n\n(Showing lines 20-89 of 194. Use offset=90 to continue.)\n</content>","metadata":{"preview":"/// name (`projection`); one with a sub-case is `parent.child` (`arith.add`, `builtin.range`).\npub fn node_types(program: &Program) -> Vec<String> {\n    let mut tags = BTreeSet::new();\n    for func in &program.funcs {\n        walk(&func.body, &mut tags);\n    }\n    walk(&program.body, &mut tags);\n    tags.into_iter().collect()\n}\n\nfn walk(tir: &Tir, tags: &mut BTreeSet<String>) {\n    tags.insert(tag(tir));\n    match &tir.kind {\n        Kind::Str(_)\n        | Kind::Int(_)\n        | Kind::Var(_)\n        | Kind::Local(_)\n<<<<<<< HEAD\n        | Kind::Stdin => {}\n=======","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-159/src/tags.rs","text":"/// name (`projection`); one with a sub-case is `parent.child` (`arith.add`, `builtin.range`).\npub fn node_types(program: &Program) -> Vec<String> {\n    let mut tags = BTreeSet::new();\n    for func in &program.funcs {\n        walk(&func.body, &mut tags);\n    }\n    walk(&program.body, &mut tags);\n    tags.into_iter().collect()\n}\n\nfn walk(tir: &Tir, tags: &mut BTreeSet<String>) {\n    tags.insert(tag(tir));\n    match &tir.kind {\n        Kind::Str(_)\n        | Kind::Int(_)\n        | Kind::Var(_)\n        | Kind::Local(_)\n<<<<<<< HEAD\n        | Kind::Stdin => {}\n=======\n        | Kind::Input\n        | Kind::Inputs\n        | Kind::Lines\n        | Kind::Dsv { .. } => {}\n>>>>>>> origin/main\n        Kind::VecLit(items) => items.iter().for_each(|i| walk(i, tags)),\n        Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| walk(v, tags)),\n        Kind::EnumLit { payload, .. } => {\n            if let Some(p) = payload {\n                walk(p, tags);\n            }\n        }\n        Kind::Call { arg, .. } => {\n            if let Some(a) = arg {\n                walk(a, tags);\n            }\n        }\n        Kind::Concat(lhs, rhs) => {\n            walk(lhs, tags);\n            walk(rhs, tags);\n        }\n        Kind::Arith { lhs, rhs, .. }\n        | Kind::Compare { lhs, rhs, .. }\n        | Kind::Logic { lhs, rhs, .. } => {\n            walk(lhs, tags);\n            walk(rhs, tags);\n        }\n        Kind::Bind { value, body, .. }\n        | Kind::Map {\n            source: value,\n            body,\n            ..\n        }\n        | Kind::OptMap {\n            source: value,\n            body,\n            ..\n        } => {\n            walk(value, tags);\n            walk(body, tags);\n        }\n        Kind::Select { source, pred, .. } => {\n            walk(source, tags);\n            walk(pred, tags);\n        }\n        Kind::Field { base, .. } | Kind::Unwrap { base } | Kind::Not(base) => walk(base, tags),\n        Kind::Builtin { arg, .. } => walk(arg, tags),\n        Kind::Index { base, index, .. } => {\n            walk(base, tags);\n            walk(index, tags);","lineStart":20,"lineEnd":89,"totalLines":194,"truncated":true}},"title":"src/tags.rs","time":{"start":1788298586805,"end":1788298586813}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"parse.rs done. Now tags.rs.","format":"unknown","index":0}]}},"id":"prt_05ee6eab1001vpZhX7Oo44iy28","sessionID":"ses_fa11b16e3ffejSNgKGkK0vX2sJ","messageID":"msg_05ee6e642001aZnwABlGjkiMKo"}}
