{"type":"tool_use","timestamp":1788298541002,"sessionID":"ses_fa11b16e3ffejSNgKGkK0vX2sJ","part":{"type":"tool","tool":"read","callID":"call_070d78cd6d4f4d778b24397a","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-159/src/check/linearity.rs","limit":40,"offset":150},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-159/src/check/linearity.rs</path>\n<type>file</type>\n<content>\n150:             format!(\"{subject} must be consumed exactly once, not {n} times\"),\n151:         )),\n152:     }\n153: }\n154: \n155: /// Whether any node in `t` satisfies `pred`, walking every child a Tir node can hold. The same\n156: /// shape as `stream_uses`, but a plain OR rather than a count: unused-binding checks only need\n157: /// to know whether a name was read at all, not how many times or along which path.\n158: fn any_node(t: &Tir, pred: &dyn Fn(&Tir) -> bool) -> bool {\n159:     if pred(t) {\n160:         return true;\n161:     }\n162:     match &t.kind {\n163:         Kind::Var(_)\n164:         | Kind::Local(_)\n165:         | Kind::Str(_)\n166:         | Kind::Int(_)\n167: <<<<<<< HEAD\n168:         | Kind::Stdin => false,\n169: =======\n170:         | Kind::Input\n171:         | Kind::Inputs\n172:         | Kind::Lines\n173:         | Kind::Dsv { .. } => false,\n174: >>>>>>> origin/main\n175:         Kind::VecLit(items) => items.iter().any(|i| any_node(i, pred)),\n176:         Kind::RecordLit { fields } => fields.iter().any(|(_, v)| any_node(v, pred)),\n177:         Kind::EnumLit { payload, .. } => payload.as_deref().is_some_and(|p| any_node(p, pred)),\n178:         Kind::Call { arg, .. } => arg.as_deref().is_some_and(|a| any_node(a, pred)),\n179:         Kind::Builtin { arg, .. } => any_node(arg, pred),\n180:         Kind::Concat(l, r) => any_node(l, pred) || any_node(r, pred),\n181:         Kind::Not(base) => any_node(base, pred),\n182:         Kind::Arith { lhs, rhs, .. }\n183:         | Kind::Compare { lh