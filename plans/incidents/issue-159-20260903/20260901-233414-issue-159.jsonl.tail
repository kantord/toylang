4ca4d94\nAuthor: Daniel Kantor <git@daniel-kantor.com>\nDate:   Tue Sep 1 23:26:58 2026 +0200\n\n    Retire input/inputs/lines for one stdin source with parse as a library call\n    \n    The stdin-syntax-design ruling (gh:159, tentative): three keywords become a\n    single raw Stream<Str> source named `stdin`, and reading a value is an\n    ordinary `parse(.)` call over it. The parser, checker, TIR, and every backend\n    now carry `stdin` and the `parse` builtin instead of the three source forms;\n    the host connects live stdin only when the program reads the source.\n    \n    Source migration only; the corpus and test files still spell the old keywords\n    and land in a follow-up.\n    \n    Human-authored: the single-source shape and parse-as-library-call semantics\n    Derived: per-backend parse emission from each target's native JSON handling\n    Agent-invented: the parse_read checked-form wiring in the checker\n    \n    Written by DeepSeek V4 Flash via opencode.\n    \n    Co-Authored-By: DeepSeek V4 Flash via opencode <git@daniel-kantor.com>\n\ndiff --git a/src/check/linearity.rs b/src/check/linearity.rs\nindex 9925273..d62a644 100644\n--- a/src/check/linearity.rs\n+++ b/src/check/linearity.rs\n@@ -37,7 +37,7 @@ fn stream_uses(t: &Tir, binding: &StreamBinding) -> Result<usize, LinearViolatio\n             StreamBinding::Local(l) => (l == id) as usize,\n             StreamBinding::Param(_) => 0,\n         }),\n-        Kind::Str(_) | Kind::Int(_) | Kind::Input | Kind::Inputs | Kind::Lines => Ok(0),\n+        Kind::Str(_) | Kind::Int(_) | Kind::Stdin => Ok(0),\n         Kind::VecLit(items) => items\n             .iter()\n             .try_fold(0, |n, i| Ok(n + stream_uses(i, binding)?)),\n@@ -167,9 +167,7 @@ fn any_node(t: &Tir, pred: &dyn Fn(&Tir) -> bool) -> bool {\n         | Kind::Local(_)\n         | Kind::Str(_)\n         | Kind::Int(_)\n-        | Kind::Input\n-        | Kind::Inputs\n-        | Kind::Lines => false,\n+        | Kind::Stdin => false,\n         Kind::VecLit(items) => items.iter().any(|i| any_node(i, pred)),\n         Kind::RecordLit { fields } => fields.iter().any(|(_, v)| any_node(v, pred)),\n         Kind::EnumLit { payload, .. } => payload.as_deref().is_some_and(|p| any_node(p, pred)),\n@@ -256,9 +254,7 @@ fn calls_in(t: &Tir, out: &mut Vec<String>) {\n         | Kind::Int(_)\n         | Kind::Var(_)\n         | Kind::Local(_)\n-        | Kind::Input\n-        | Kind::Inputs\n-        | Kind::Lines => {}\n+        | Kind::Stdin => {}\n         Kind::VecLit(items) => items.iter().for_each(|i| calls_in(i, out)),\n         Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| calls_in(v, out)),\n         Kind::EnumLit { payload, .. } => {\ndiff --git a/src/check/mod.rs b/src/check/mod.rs\nindex ec005db..b3076bd 100644\n--- a/src/check/mod.rs\n+++ b/src/check/mod.rs\n@@ -1,4 +1,4 @@\n-use std::cell::{Cell, RefCell};\n+use std::cell::Cell;\n use std::collections::{HashMap, HashSet};\n \n use crate::ast::{BinOp, Expr, FieldsPattern, File, MatchArm, Param, Pattern, Span};\n@@ -28,22 +28,17 @@ struct Ctx<'a> {\n     arm_fields: Vec<(String, Type, LocalId)>,\n     /// What `.` refers to here, if anything: its type and the local holding it.\n     subject: Option<(Type, LocalId)>,\n-    /// The type `input` was checked against, filled in the first time it is used.\n-    input: &'a RefCell<Option<Type>>,\n-    /// The element type `inputs` was checked against, filled in the first time it is used. A\n-    /// separate cell from `input`'s: one records a whole value's type, the other one line's.\n-    inputs: &'a RefCell<Option<Type>>,\n-    /// Whether `lines` has already been read. There is only ever one real stdin, so a second\n+    /// Whether `stdin` has already been read. There is only ever one real stdin, so a second\n     /// read is refused rather than silently handed nothing, the way a second pass over an\n     /// already-consumed iterator would be in a language that let it compile.\n