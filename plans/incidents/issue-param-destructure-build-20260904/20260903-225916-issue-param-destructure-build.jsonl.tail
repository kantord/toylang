odSig, TypeExpr, Variant,\n+    Module, Param, ParamShape, Pattern, Span, TraitDecl, TraitMethodSig, TypeExpr, Variant,\n };\n use crate::error::Error;\n use crate::ty;\n \n","additions":1,"deletions":1},"truncated":false},"title":"src/parse.rs","time":{"start":1788469620775,"end":1788469620780}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_06918b014001ZVhbCuiyaBKtRg","sessionID":"ses_f96ee63ceffebQ0LD64zWsaHwP","messageID":"msg_06918aa6e001w7NqpfOAeCszUC"}}
