                    &StreamBinding::Param(name),\n                    &format!(\"`{}`\", name),\n                    body_span,\n                )?;\n            }\n    if !param_used(body, &param.name) {\n        return Err(Error::new(\n            param.span,\n            format!(\n                \"parameter `{}` is never used; delete it from `{}`'s definition and its call sites\",\n                param.name, func_name\n            ),\n        ));\n    }\n    Ok(())\n}\n\n/// The program's own body. A sink-shaped body -- the tail-pipeline `lhs |> callee` or a direct\n/// sink call (`jsonlines(...)` or a call to a function declared `-> Sink`) -- is the one legal\n/// place a `Sink` may be born besides a `Sink`-returning function's body, so it is recognized","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-param-destructure-build/src/check/mod.rs","text":"                    &StreamBinding::Param(name),\n                    &format!(\"`{}`\", name),\n                    body_span,\n                )?;\n            }\n    if !param_used(body, &param.name) {\n        return Err(Error::new(\n            param.span,\n            format!(\n                \"parameter `{}` is never used; delete it from `{}`'s definition and its call sites\",\n                param.name, func_name\n            ),\n        ));\n    }\n    Ok(())\n}\n\n/// The program's own body. A sink-shaped body -- the tail-pipeline `lhs |> callee` or a direct\n/// sink call (`jsonlines(...)` or a call to a function declared `-> Sink`) -- is the one legal\n/// place a `Sink` may be born besides a `Sink`-returning function's body, so it is recognized\n/// ahead of `synth`, which refuses a sink everywhere else (the general position rule; see\n/// `tail_pipe` and `sink_call`). Any other body is synthesized, and a `Sink` result that slips\n/// past recognition can only mean a shape `synth` should have refused.\nfn check_program_body(ctx: &Ctx, body: &Expr) -> Result<Tir, Error> {\n    if matches!(body, Expr::TailPipe { .. }) {\n        return tail_pipe(ctx, body);\n    }\n    if let Some(tir) = sink_call(ctx, body)? {\n        return Ok(tir);\n    }","lineStart":578,"lineEnd":607,"totalLines":3360,"truncated":true}},"title":"src/check/mod.rs","time":{"start":1788469694487,"end":1788469694494}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"That worked! So the issue was the deeper text in the long oldString (some subtle mismatch — probably the `),` lines). Now let me replace the remaining `if !param_used...` block with the rest. Let me view the current state.","format":"unknown","index":0}]}},"id":"prt_06919d015001xqiiCmwLJIWKRe","sessionID":"ses_f96ee63ceffebQ0LD64zWsaHwP","messageID":"msg_06919ca23001yu9DSKiRbze5XO"}}
