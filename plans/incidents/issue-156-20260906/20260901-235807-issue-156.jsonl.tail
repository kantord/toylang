Err(Error::new(\n96:                     v.span,\n97:                     format!(\"variant `{}` is declared twice in `{}`\", v.name, e.name),\n98:                 ));\n99:             }\n100:             // The declared name is the matcher, so it starts with a capital letter; the value is\n101:             // built with the lowercase constructor (`Circle` declares, `circle` builds). The\n102:             // prelude's Opt/Result still spell their variants lowercase -- exempting pub enums\n103:             // keeps the build green until gh:165 migrates them, and a program's own variants are\n104:             // all non-pub, so the rule still bites everywhere it should.\n105:             if !e.is_pub && !v.name.chars().next().is_some_and(char::is_uppercase) {\n106:                 return Err(Error::new(\n107:                     v.span,\n108:                     format!(\n109:                         \"a variant name starts with a capital letter; declare `{}` of `{}` as \\\n110:                          `{}`, and build its value with the lowercase constructor `{}`\",\n111:                         v.name,\n112:                         e.name,\n113:                         matcher_of(&v.name),\n114:                         v.name\n115:                     ),\n116:                 ));\n117:             }\n118:         }\n119:         if map.insert(e.name.clone(), e).is_some() {\n120:             return Err(Error::new(\n121:                 e.span,\n122:                 format!(\"type `{}` is defined twice\", e.name),\n123:             ));\n124:         }\n125:     }\n126:     Ok(map)\n127: }\n128: \n129: /// Resolve one enum declaration to its type. `seen` carries the names being expanded and the\n130: /// arguments each was expanded with, exactly as for aliases (whose entry carries no arguments),\n131: /// so an enum whose payload mentions itself is refused rather than expanded forever -- unless it\n132: /// does so behind a `Vec`, which `resolve_named` treats as legal (kantord/toylang#76) and stops\n133: /// expanding at, rather than looping. The arguments travel alongside the name so that a boxed\n134: /// self-reference can be checked against the instantiation it reappears inside\n135: /// (kantord/toylang#117): reusing them is the only way `resolve_named` avoids expanding one\n136: /// forever, so a self-reference that reappears with different arguments -- `Nest<Vec<T>>` inside\n137: /// `Nest<T>` -- has no honest placeholder to return and is refused instead.\n138: ///\n139: /// `args` instantiates a generic declaration: payloads resolve with each parameter bound to\n\n(Showing lines 60-139 of 556. Use offset=140 to continue.)\n</content>","metadata":{"preview":"        _ => false,\n    }\n}\n\n/// What a type name stands for. An alias is an abbreviation, so this maps to the written form\n/// and `resolve` expands it; nothing downstream ever learns a name was involved.\ntype Aliases<'a> = HashMap<String, &'a TypeExpr>;\n\n/// The named types a written annotation can refer to. Aliases expand away; an enum resolves to\n/// the identity its declaration created.\npub(super) struct TypeEnv<'a> {\n    pub(super) aliases: Aliases<'a>,\n    pub(super) enums: HashMap<String, &'a EnumDecl>,\n}\n\npub(super) fn enum_map(enums: &[EnumDecl]) -> Result<HashMap<String, &EnumDecl>, Error> {\n    let mut map: HashMap<String, &EnumDecl> = HashMap::new();\n    for e in enums {\n        if !e.name.chars().next().is_some_and(char::is_uppercase) {\n            return Err(Error::new(","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-156/src/check/types.rs","text":"        _ => false,\n    }\n}\n\n/// What a type name stands for. An alias is an abbreviation, so this maps to the written form\n/// and `resolve` expands it; nothing downstream ever learns a name was involved.\ntype Aliases<'a> = HashMap<String, &'a TypeExpr>;\n\n/// The named types a written annotation can refer to. Aliases expand away; an enum resolves to\n/// the identity its declaration created.\npub(super) struct TypeEnv<'a> {\n    pub(super) aliases: Aliases<'a>,\n    pub(super) enums: HashMap<String, &'a EnumDecl>,\n}\n\npub(super) fn enum_map(enums: &[EnumDecl]) -> Result<HashMap<String, &EnumDecl>, Error> {\n    let mut map: HashMap<String, &EnumDecl> = HashMap::new();\n    for e in enums {\n        if !e.name.chars().next().is_some_and(char::is_uppercase) {\n            return Err(Error::new(\n                e.span,\n                format!(\n                    \"a type name starts with a capital letter, and `{}` reads as a value\",\n                    e.name\n                ),\n            ));\n        }\n        if ty::is_builtin_type_name(&e.name) {\n            return Err(Error::new(\n                e.span,\n                format!(\"`{}` is a built-in type and cannot be redefined\", e.name),\n            ));\n        }\n        for (i, v) in e.variants.iter().enumerate() {\n            if e.variants[..i].iter().any(|earlier| earlier.name == v.name) {\n                return Err(Error::new(\n                    v.span,\n                    format!(\"variant `{}` is declared twice in `{}`\", v.name, e.name),\n                ));\n            }\n            // The declared name is the matcher, so it starts with a capital letter; the value is\n            // built with the lowercase constructor (`Circle` declares, `circle` builds). The\n            // prelude's Opt/Result still spell their variants lowercase -- exempting pub enums\n            // keeps the build green until gh:165 migrates them, and a program's own variants are\n            // all non-pub, so the rule still bites everywhere it should.\n            if !e.is_pub && !v.name.chars().next().is_some_and(char::is_uppercase) {\n                return Err(Error::new(\n                    v.span,\n                    format!(\n                        \"a variant name starts with a capital letter; declare `{}` of `{}` as \\\n                         `{}`, and build its value with the lowercase constructor `{}`\",\n                        v.name,\n                        e.name,\n                        matcher_of(&v.name),\n                        v.name\n                    ),\n                ));\n            }\n        }\n        if map.insert(e.name.clone(), e).is_some() {\n            return Err(Error::new(\n                e.span,\n                format!(\"type `{}` is defined twice\", e.name),\n            ));\n        }\n    }\n    Ok(map)\n}\n\n/// Resolve one enum declaration to its type. `seen` carries the names being expanded and the\n/// arguments each was expanded with, exactly as for aliases (whose entry carries no arguments),\n/// so an enum whose payload mentions itself is refused rather than expanded forever -- unless it\n/// does so behind a `Vec`, which `resolve_named` treats as legal (kantord/toylang#76) and stops\n/// expanding at, rather than looping. The arguments travel alongside the name so that a boxed\n/// self-reference can be checked against the instantiation it reappears inside\n/// (kantord/toylang#117): reusing them is the only way `resolve_named` avoids expanding one\n/// forever, so a self-reference that reappears with different arguments -- `Nest<Vec<T>>` inside\n/// `Nest<T>` -- has no honest placeholder to return and is refused instead.\n///\n/// `args` instantiates a generic declaration: payloads resolve with each parameter bound to","lineStart":60,"lineEnd":139,"totalLines":556,"truncated":true}},"title":"src/check/types.rs","time":{"start":1788300094498,"end":1788300094555}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05efddc32001MZD9atAImuT9Yv","sessionID":"ses_fa1053b46ffegpZct5fvxttIRv","messageID":"msg_05efdba18001tXpMLUtTtIg2rk"}}
{"type":"tool_use","timestamp":1788300094783,"sessionID":"ses_fa1053b46ffegpZct5fvxttIRv","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-833614081ee1a1e8","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-156/tests/variant_casing.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-156/tests/variant_casing.rs</path>\n<type>file</type>\n<content>\n1: //! The gh:156 casing split: the declared variant name is the matcher and starts with a capital\n2: //! letter; the value is built with the lowercase constructor. The corpus carries the accept\n3: //! case across every backend; these pin what the corpus cannot see, the checker's refusals.\n4: \n5: #[track_caller]\n6: fn err(src: &str) -> String {\n7:     toylang::compile(src).map(|_| ()).unwrap_err().to_string()\n8: }\n9: \n10: /// A lowercase declaration names a value, but a variant declaration is a matcher, so it must\n11: /// start with a capital letter.\n12: #[test]\n13: fn a_lowercase_variant_declaration_is_refused() {\n14:     insta::assert_snapshot!(err(\"enum Shape { point, circle{r: Int} }\\n\\nstr(1)\"));\n15: }\n16: \n17: /// A capitalized name builds nothing: it is the matcher, so using it in value position is\n18: /// refused, and the lowercase constructor is the way to build.\n19: #[test]\n20: fn a_capitalized_constructor_is_refused() {\n21:     insta::assert_snapshot!(err(\n22:         \"enum Shape { Point, Circle{r: Int} }\\n\\nCircle{r: 1}\"\n23:     ));\n24: }\n25: \n26: /// A lowercase pattern names the constructor, not a matcher, so it cannot be matched against.\n27: #[test]\n28: fn a_lowercase_pattern_is_refused() {\n29:     insta::assert_snapshot!(err(\n30:         \"enum Shape { Point, Circle{r: Int} }\\n\\n\\\n31:          fn f(s: Shape) -> Int = s | circle{r} -> r or Point -> 0\\n\\n\\\n32:          f(Shape.point)\"\n33:     ));\n34: }\n35: \n36: /// The accept case end to end: a capitalized declaration with a lowercase constructor builds\n37: /// the value, and the capitalized matcher matches it.\n38: #[test]\n39: fn capitalized_declaration_with_lowercase_constructor_runs() {\n40:     let src = \"enum Shape { Point, Circle{r: Int} }\\n\\nfn area(s: Shape) -> Int = \\\n41:                s | Circle{r} -> r * r or Point -> 0\\n\\n{a: area(Shape.point), b: area(circle{r: 3})}\";\n42:     assert_eq!(toylang::run(src).unwrap(), \"{\\\"a\\\":0,\\\"b\\\":9}\\n\");\n43: }\n\n(End of file - total 43 lines)\n</content>","metadata":{"preview":"//! The gh:156 casing split: the declared variant name is the matcher and starts with a capital\n//! letter; the value is built with the lowercase constructor. The corpus carries the accept\n//! case across every backend; these pin what the corpus cannot see, the checker's refusals.\n\n#[track_caller]\nfn err(src: &str) -> String {\n    toylang::compile(src).map(|_| ()).unwrap_err().to_string()\n}\n\n/// A lowercase declaration names a value, but a variant declaration is a matcher, so it must\n/// start with a capital letter.\n#[test]\nfn a_lowercase_variant_declaration_is_refused() {\n    insta::assert_snapshot!(err(\"enum Shape { point, circle{r: Int} }\\n\\nstr(1)\"));\n}\n\n/// A capitalized name builds nothing: it is the matcher, so using it in value position is\n/// refused, and the lowercase constructor is the way to build.\n#[test]\nfn a_capitalized_constructor_is_refused() {","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-156/tests/variant_casing.rs","text":"//! The gh:156 casing split: the declared variant name is the matcher and starts with a capital\n//! letter; the value is built with the lowercase constructor. The corpus carries the accept\n//! case across every backend; these pin what the corpus cannot see, the checker's refusals.\n\n#[track_caller]\nfn err(src: &str) -> String {\n    toylang::compile(src).map(|_| ()).unwrap_err().to_string()\n}\n\n/// A lowercase declaration names a value, but a variant declaration is a matcher, so it must\n/// start with a capital letter.\n#[test]\nfn a_lowercase_variant_declaration_is_refused() {\n    insta::assert_snapshot!(err(\"enum Shape { point, circle{r: Int} }\\n\\nstr(1)\"));\n}\n\n/// A capitalized name builds nothing: it is the matcher, so using it in value position is\n/// refused, and the lowercase constructor is the way to build.\n#[test]\nfn a_capitalized_constructor_is_refused() {\n    insta::assert_snapshot!(err(\n        \"enum Shape { Point, Circle{r: Int} }\\n\\nCircle{r: 1}\"\n    ));\n}\n\n/// A lowercase pattern names the constructor, not a matcher, so it cannot be matched against.\n#[test]\nfn a_lowercase_pattern_is_refused() {\n    insta::assert_snapshot!(err(\n        \"enum Shape { Point, Circle{r: Int} }\\n\\n\\\n         fn f(s: Shape) -> Int = s | circle{r} -> r or Point -> 0\\n\\n\\\n         f(Shape.point)\"\n    ));\n}\n\n/// The accept case end to end: a capitalized declaration with a lowercase constructor builds\n/// the value, and the capitalized matcher matches it.\n#[test]\nfn capitalized_declaration_with_lowercase_constructor_runs() {\n    let src = \"enum Shape { Point, Circle{r: Int} }\\n\\nfn area(s: Shape) -> Int = \\\n               s | Circle{r} -> r * r or Point -> 0\\n\\n{a: area(Shape.point), b: area(circle{r: 3})}\";\n    assert_eq!(toylang::run(src).unwrap(), \"{\\\"a\\\":0,\\\"b\\\":9}\\n\");\n}","lineStart":1,"lineEnd":43,"totalLines":43,"truncated":false}},"title":"tests/variant_casing.rs","time":{"start":1788300094772,"end":1788300094778}},"id":"prt_05efdec27001R4aC2OFYneuZ7w","sessionID":"ses_fa1053b46ffegpZct5fvxttIRv","messageID":"msg_05efdba18001tXpMLUtTtIg2rk"}}
