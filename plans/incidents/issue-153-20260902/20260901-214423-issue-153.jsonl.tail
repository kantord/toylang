{"type":"tool_use","timestamp":1788292026662,"sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","part":{"type":"tool","tool":"read","callID":"call_87d41e5fe0094e119ab9c021","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-153/src/lib.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-153/src/lib.rs</path>\n<type>file</type>\n<content>\n1: pub mod ast;\n2: pub mod check;\n3: pub mod emit_go;\n4: pub mod emit_jq;\n5: pub mod emit_js;\n6: pub mod emit_llvm;\n7: pub mod emit_lua;\n8: pub mod emit_py;\n9: pub mod emit_rs;\n10: pub mod emit_toylang;\n11: pub mod error;\n12: pub mod fmt_tree;\n13: pub mod input;\n14: pub mod parse;\n15: pub mod prelude;\n16: pub mod tags;\n17: pub mod tir;\n18: pub mod ty;\n19: \n20: use std::cell::RefCell;\n21: use std::io::{BufRead, Write};\n22: use std::rc::Rc;\n23: \n24: use anyhow::{Context, Result};\n25: use error::Error;\n26: use tir::Program;\n27: \n28: #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n29: pub enum Backend {\n30:     Lua,\n31:     Js,\n32:     Native,\n33:     Jq,\n34:     Go,\n35:     Py,\n36:     Rust,\n37: }\n38: \n39: impl Backend {\n40:     /// The backends that must agree on every corpus program. Native and Rust each joined once\n41:     /// they could compile the whole language; until then they were kept out rather than allowed\n42:     /// to turn the harness permanently red, tracked by tests/backend_llvm.rs and\n43:     /// tests/backend_rust.rs respectively.\n44:     pub const ALL: [Backend; 7] = [\n45:         Backend::Lua,\n46:         Backend::Js,\n47:         Backend::Native,\n48:         Backend::Jq,\n49:         Backend::Go,\n50:         Backend::Py,\n51:         Backend::Rust,\n52:     ];\n53: \n54:     /// The spelling used on the command line and in a corpus case's `snapshot` list.\n55:     pub fn from_name(name: &str) -> Option<Backend> {\n56:         Backend::ALL.into_iter().find(|b| b.name() == name)\n57:     }\n58: \n59:     pub fn name(self) -> &'static str {\n60:         match self {\n61:             Backend::Lua => \"lua\",\n62:             Backend::Js => \"js\",\n63:             Backend::Native => \"native\",\n64:             Backend::Jq => \"jq\",\n65:             Backend::Go => \"go\",\n66:             Backend::Py => \"py\",\n67:             Backend::Rust => \"rust\",\n68:         }\n69:     }\n70: \n71:     pub fn emit(self, program: &Program) -> Result<String, String> {\n72:         match self {\n73:             Backend::Lua => Ok(emit_lua::emit(program)),\n74:             Backend::Js => Ok(emit_js::emit(program)),\n75:             Backend::Native => emit_llvm::to_ir(program),\n76:             Backend::Jq => emit_jq::emit(program),\n77:             Backend::Go => Ok(emit_go::emit(program)),\n78:             Backend::Py => Ok(emit_py::emit(program)),\n79:             Backend::Rust => Ok(emit_rs::emit(program)),\n80:         }\n81:     }\n82: }\n83: \n84: pub fn compile(src: &str) -> Result<Program, Error> {\n85:     let mut file = parse::parse(src)?;\n86:     prelude::inject(&mut file);\n87:     check::check(&file)\n88: }\n89: \n90: /// Parses `src` and re-renders it in the canonical toylang style, without checking or injecting\n91: /// the prelude -- a formatter has to work on a program that does not type-check, and it must\n92: /// never print the prelude definitions `compile` splices in for its own purposes.\n93: pub fn fmt(src: &str) -> Result<String, Error> {\n94:     emit_toylang::format_source(src)\n95: }\n96: \n97: pub fn run(src: &str) -> Result<String> {\n98:     run_on(src, None, Backend::Lua)\n99: }\n100: \n101: pub fn run_with_input(src: &str, stdin: Option<&str>) -> Result<String> {\n102:     run_on(src, stdin, Backend::Lua)\n103: }\n104: \n105: /// Whether the generated code for `program` reads `inputs` for itself, one record at a time,\n106: /// rather than needing the whole thing parsed and handed over up front. A type question now,\n107: /// not a shape guess: exactly the programs `tir::fusion` reads from `inputs` -- every backend\n108: /// has a fused loop to emit. An aggregate like `length(collect(inputs))` still has no way to\n109: /// stream no matter which backend runs it. Public so `main.rs` can decide, before it has read\n110: /// anything, whether to drain real stdin itself or hand it to `run_on` untouched.\n111: pub fn streams_inputs(program: &tir::Program) -> bool {\n112:     matches!(\n113:         tir::fusion(program),\n114:         Some(f) if matches!(f.source, tir::Source::Inputs)\n115:     )\n116: }\n117: \n118: /// Compile and run, capturing what the program printed -- except when `stdin` is `None` and\n119: /// `streams_inputs` says the backend reads `inputs` for itself, in which case the real stdin and\n120: /// stdout are connected straight through (`Feed::Live`) and there is nothing left to capture.\n121: /// Capturing otherwise keeps the tests to one call: it also means output is held in memory, which\n122: /// is fine for every program whose result has statically known length, and is exactly the case\n123: /// `Feed::Live` exists for on the ones that no longer do.\n124: pub fn run_on(src: &str, stdin: Option<&str>, backend: Backend) -> Result<String> {\n125:     let program = compile(src)?;\n126: \n127:     // `stdin.is_none()` is the same convention `uses_lines` already uses below: nothing was\n128:     // supplied, which only happens on the real command line, never from a test fixture. Only\n129:     // then is there real live stdin worth handing straight to a subprocess backend rather than\n130:     // something already sitting in memory to validate up front.\n131:     let live_inputs = stdin.is_none() && streams_inputs(&program);\n132:     // Lua is the one backend with no subprocess of its own: `run_lua` itself decides how\n133:     // `inputs` reaches the running chunk, by injecting either a pre-populated global or a\n134:     // per-call function, and the emitted source commits to one of those two shapes purely from\n135:     // `tir::fusion`, independent of whether a fixture or the real command line supplied the\n136:     // bytes. So unlike `live_inputs` above, this also has to hold for a fixture-fed test, or\n137:     // the host would inject the global while the fused source calls the function.\n138:     let lua_fused = matches!(backend, Backend::Lua) && streams_inputs(&program);\n139: \n140:     // The input is checked against the declared type once, here, rather than by each backend.\n141:     // What a backend receives has already been parsed, so no backend re-decides what is valid.\n142:     let value = match (&program.input, stdin) {\n143:         (Some(ty), Some(text)) => {\n144:             let value: serde_json::Value = serde_json::from_str(text)?;\n145:             input::validate(&program.enums, &value, ty, \"input\").map_err(anyhow::Error::msg)?;\n146:             Some(value)\n147:         }\n148:         (Some(ty), None) => anyhow::bail!(\"this program reads input, of type {ty}\"),\n149:         (None, _) => None,\n150:     };\n151: \n152:     // `inputs` is eager like `input`, not incremental like `lines`, so it normally goes through\n153:     // the same validate-then-re-serialize step: every backend receives canonical bytes, one\n154:     // compact JSON value per line, rather than whatever formatting the original text happened to\n155:     // use. `live_inputs` and `lua_fused` are the exceptions -- nothing is precomputed for them,\n156:     // because the whole point of a fused loop is not reading the whole stream before the first\n157:     // record is handled. Validation still happens record-by-record on the host: `run_lua`'s\n158:     // `next_input` function does it for the Lua backend it is embedded in, and `Feed::LiveInputs`\n159:     // below does it for every other, subprocess-based backend, since generated code cannot be\n160:     // trusted to reimplement `input::validate` correctly in six different target languages.\n161:     let inputs_values = if live_inputs || lua_fused {\n162:         None\n163:     } else {\n164:         match (&program.inputs, stdin) {\n165:             (Some(elem_ty), Some(text)) => {\n166:                 let mut values = Vec::new();\n167:                 for line in text.lines().filter(|l| !l.trim().is_empty()) {\n168:                     let value: serde_json::Value = serde_json::from_str(line)?;\n169:                     input::validate(&program.enums, &value, elem_ty, \"inputs\")\n170:                         .map_err(anyhow::Error::msg)?;\n171:                     values.push(value);\n172:                 }\n173:                 Some(values)\n174:             }\n175:             (Some(elem_ty), None) => {\n176:                 anyhow::bail!(\"this program reads inputs, of type Vec<{elem_ty}>\");\n177:             }\n178:             (None, _) => None,\n179:         }\n180:     };\n181: \n182:     // What a backend's stdin should be connected to. `input` always has known bytes: the\n183:     // re-serialized, already-validated value. `lines` has known bytes only when a caller (a\n184:     // corpus fixture, most often) supplied them directly -- and when it does, they are piped in\n185:     // verbatim rather than pre-split, so a backend's own splitting genuinely runs against them\n186:     // rather than being bypassed by the test that is supposed to exercise it. Only when nothing\n187:     // was supplied, which is the real command-line case, does `lines` connect the real stdin\n188:     // straight through, with no Rust-side buffering in between -- the one thing that would make\n189:     // its streaming indistinguishable from having read everything first. A live, fused `inputs`\n190:     // program has no type to lean on the way `lines` does (raw text is always valid `Str`), so it\n191:     // cannot connect the real stdin straight through: `Feed::LiveInputs` reads and validates one\n192:     // record at a time itself and forwards only what passes, real streaming with no read-it-all-\n193:     // first buffering, but through Rust rather than direct fd inheritance. The Lua backend is the\n194:     // one exception -- it validates through its own `next_input` function instead, direct from\n195:     // `Feed::Live`, since it runs embedded rather than as a subprocess with a pipe to mediate.\n196:     // A fused Lua program run against a fixture is not live, but still needs the raw bytes\n197:     // verbatim rather than the eager re-serialized form, since `run_lua`'s injected function does\n198:     // its own splitting the same way `lines` always has.\n199:     let feed = if program.uses_lines || program.dsv.is_some() {\n200:         match stdin {\n201:             Some(text) => Feed::Text(text.to_string()),\n202:             None => Feed::Live,\n203:         }\n204:     } else if live_inputs {\n205:         live_inputs_feed(&program, backend)\n206:     } else if lua_fused {\n207:         Feed::Text(stdin.map(str::to_string).unwrap_or_default())\n208:     } else if let Some(values) = &inputs_values {\n209:         Feed::Text(\n210:             values\n211:                 .iter()\n212:                 .map(|v| v.to_string())\n213:                 .collect::<Vec<_>>()\n214:                 .join(\"\\n\"),\n215:         )\n216:     } else {\n217:         Feed::Text(value.as_ref().map(|v| v.to_string()).unwrap_or_default())\n218:     };\n219: \n220:     match backend {\n221:         Backend::Lua => run_lua(\n222:             &emit_lua::emit(&program),\n223:             &program.enums,\n224:             value.as_ref(),\n225:             inputs_values.as_ref(),\n226:             program.inputs.as_ref(),\n227:             &feed,\n228:         ),\n229:         Backend::Js => run_node(&emit_js::emit(&program), &feed),\n230:         Backend::Jq => run_jq(\n231:             &emit_jq::emit(&program).map_err(anyhow::Error::msg)?,\n232:             JqInvocation {\n233:                 has_value: value.is_some(),\n234:                 raw: matches!(program.body.ty, ty::Type::Str | ty::Type::Sink),\n235:                 uses_lines: program.uses_lines || program.dsv.is_some(),\n236:             },\n237:             &feed,\n238:         ),\n239:         Backend::Go => run_go(&emit_go::emit(&program), &feed),\n240:         Backend::Py => run_py(&emit_py::emit(&program), &feed),\n241:         Backend::Native => {\n242:             let dir = tempfile::tempdir()?;\n243:             let exe = dir.path().join(\"program\");\n244:             link(&program, &exe)?;\n245:             run_binary(&exe, &feed)\n246:         }\n247:         Backend::Rust => {\n248:             let dir = tempfile::tempdir()?;\n249:             let exe = dir.path().join(\"program\");\n250:             link_rust(&emit_rs::emit(&program), &exe)?;\n251:             run_binary(&exe, &feed)\n252:         }\n253:     }\n254: }\n255: \n256: /// The feed for a live, fused `inputs` program: real stdin, but validated. Lua is the exception,\n257: /// since `run_lua`'s own `next_input` function validates directly off `Feed::Live` rather than\n258: /// needing `Feed::LiveInputs` to mediate a pipe it has no subprocess to write into.\n259: fn live_inputs_feed(program: &Program, backend: Backend) -> Feed {\n260:     if matches!(backend, Backend::Lua) {\n261:         Feed::Live\n262:     } else {\n263:         Feed::LiveInputs(\n264:             program\n265:                 .inputs\n266:                 .clone()\n267:                 .expect(\"live_inputs implies an inputs type\"),\n268:             program.enums.clone(),\n269:         )\n270:     }\n271: }\n272: \n273: /// What a subprocess backend's stdin is connected to.\n274: enum Feed {\n275:     /// Known bytes, written through a pipe: `input`'s re-serialized value, a `lines` program's\n276:     /// fixture text verbatim, or nothing for a program that reads no stdin at all.\n277:     Text(String),\n278:     /// The real process stdin, inherited rather than piped. Reachable only for a `lines`\n279:     /// program run with no fixture supplied.\n280:     Live,\n281:     /// The real process stdin, read and validated one record at a time against the element type,\n282:     /// then forwarded through a pipe -- real streaming, but mediated by the host rather than\n283:     /// inherited directly, which is what lets `input::validate` see every record before a\n284:     /// subprocess backend's own, untrusted parse of it does. Reachable only for a live, fused\n285:     /// `inputs` program on a backend other than Lua (see `write_to`).\n286:     LiveInputs(ty::Type, ty::Enums),\n287: }\n288: \n289: impl Feed {\n290:     fn stdio(&self) -> std::process::Stdio {\n291:         match self {\n292:             Feed::Text(_) | Feed::LiveInputs(..) => std::process::Stdio::piped(),\n293:             Feed::Live => std::process::Stdio::inherit(),\n294:         }\n295:     }\n296: \n297:     fn write_to(&self, child: &mut std::process::Child) -> Result<()> {\n298:         match self {\n299:             Feed::Text(text) => {\n300:                 child\n301:                     .stdin\n302:                     .take()\n303:                     .expect(\"piped\")\n304:                     .write_all(text.as_bytes())?;\n305:             }\n306:             Feed::Live => {}\n307:             Feed::LiveInputs(elem_ty, enums) => {\n308:                 let mut stdin = child.stdin.take().expect(\"piped\");\n309:                 for line in std::io::stdin().lock().lines() {\n310:                     let line = line?;\n311:                     if line.trim().is_empty() {\n312:                         continue;\n313:                     }\n314:                     let value: serde_json::Value = serde_json::from_str(&line)?;\n315:                     if let Err(msg) = input::validate(enums, &value, elem_ty, \"inputs\") {\n316:                         // Close the pipe so the child sees EOF and can finish printing whatever\n317:                         // it already validly received, then wait for it before reporting the\n318:                         // refusal -- otherwise this leaves an unreaped child behind.\n319:                         drop(stdin);\n320:                         child.wait()?;\n321:                         return Err(anyhow::Error::msg(msg));\n322:                     }\n323:                     writeln!(stdin, \"{line}\")?;\n324:                 }\n325:             }\n326:         }\n327:         Ok(())\n328:     }\n329: }\n330: \n331: /// Compile to a native executable at `out`.\n332: ///\n333: /// LLVM produces an object file, which is not a program, so this shells out to `cc` for the\n334: /// link. That is a toolchain requirement the Lua backend does not have, since mlua vendors its\n335: /// interpreter.\n336: pub fn link(program: &Program, out: &std::path::Path) -> Result<()> {\n337:     let dir = tempfile::tempdir()?;\n338:     let object = dir.path().join(\"program.o\");\n339:     emit_llvm::compile_to_object(program, &object).map_err(anyhow::Error::msg)?;\n340: \n341:     // The runtime is compiled alongside rather than shipped as a library, which keeps the build\n342:     // to one `cc` call and means there is nothing to install.\n343:     let runtime = dir.path().join(\"toylang.c\");\n344:     std::fs::write(&runtime, emit_llvm::RUNTIME_C)?;\n345: \n346:     let status = std::process::Command::new(\"cc\")\n347:         .arg(&object)\n348:         .arg(&runtime)\n349:         .arg(\"-o\")\n350:         .arg(out)\n351:         .status()\n352:         .context(\"could not run `cc`\")?;\n353:     if !status.success() {\n354:         anyhow::bail!(\"cc failed to link: {status}\");\n355:     }\n356:     Ok(())\n357: }\n358: \n359: /// Compile Rust source to an executable at `out`. One `rustc` call on one self-contained file,\n360: /// no external crate and no Cargo project, the same reason `link` above is one `cc` call: the\n361: /// generated source depends on nothing this compiler did not already assume was installed.\n362: /// Public for the same reason as `link`: `tests/backend_rust.rs` calls it directly, separately\n363: /// from running the result, so a genuine codegen gap (`rustc` rejects the source) is told apart\n364: /// from a legitimate runtime refusal (`rustc` succeeds, the binary exits non-zero).\n365: pub fn link_rust(source: &str, out: &std::path::Path) -> Result<()> {\n366:     let dir = tempfile::tempdir()?;\n367:     let src = dir.path().join(\"program.rs\");\n368:     std::fs::write(&src, source)?;\n369: \n370:     let result = std::process::Command::new(\"rustc\")\n371:         .arg(\"--edition\")\n372:         .arg(\"2021\")\n373:         .arg(&src)\n374:         .arg(\"-o\")\n375:         .arg(out)\n376:         .output()\n377:         .context(\"could not run `rustc`\")?;\n378:     if !result.status.success() {\n379:         anyhow::bail!(\n380:             \"rustc failed to compile: {}\",\n381:             String::from_utf8_lossy(&result.stderr)\n382:         );\n383:     }\n384:     Ok(())\n385: }\n386: \n387: /// Runs `cmd` (already given whatever args the caller needs) connected to `feed`, and returns\n388: /// what it printed.\n389: ///\n390: /// When `feed` is `Feed::Live` or `Feed::LiveInputs` there is no test harness reading the result\n391: /// back: stdout and stderr are inherited straight through to the real terminal or pipe instead of\n392: /// being captured, which is what lets a program that streams actually show output as it produces\n393: /// it rather than all at once when it exits. `Ok(String::new())` reflects that nothing is left to\n394: /// hand back -- it already went to the real stdout directly. `feed.write_to` reports a validation\n395: /// refusal for `Feed::LiveInputs` as an `Err` before this function's own `child.wait()` runs, so\n396: /// that path never reaches here at all.\n397: fn run_subprocess(mut cmd: std::process::Command, label: &str, feed: &Feed) -> Result<String> {\n398:     let live = matches!(feed, Feed::Live | Feed::LiveInputs(..));\n399:     let mut child = cmd\n400:         .stdin(feed.stdio())\n401:         .stdout(if live {\n402:             std::process::Stdio::inherit()\n403:         } else {\n404:             std::process::Stdio::piped()\n405:         })\n406:         .stderr(if live {\n407:             std::process::Stdio::inherit()\n408:         } else {\n409:             std::process::Stdio::piped()\n410:         })\n411:         .spawn()\n412:         .with_context(|| format!(\"could not run `{label}`\"))?;\n413: \n414:     feed.write_to(&mut child)?;\n415: \n416:     if live {\n417:         let status = child.wait()?;\n418:         if !status.success() {\n419:             anyhow::bail!(\"{label} failed\");\n420:         }\n421:         return Ok(String::new());\n422:     }\n423: \n424:     let out = child.wait_with_output()?;\n425:     if !out.status.success() {\n426:         anyhow::bail!(\"{label} failed: {}\", String::from_utf8_lossy(&out.stderr));\n427:     }\n428:     Ok(String::from_utf8(out.stdout)?)\n429: }\n430: \n431: fn run_binary(exe: &std::path::Path, feed: &Feed) -> Result<String> {\n432:     run_subprocess(\n433:         std::process::Command::new(exe),\n434:         \"the compiled program\",\n435:         feed,\n436:     )\n437: }\n438: \n439: /// jq puts stdin in `.`, so a program that reads no input runs with `-n` rather than waiting on\n440: /// a terminal. `has_value` rather than the `Feed` itself, since a `lines` program run live\n441: /// (`Feed::Live`) still has real stdin coming and must not get `-n` on that account.\n442: /// The three facts about a program that shape a jq invocation's flags. Each is derived from\n443: /// the compiled program, not a caller identity -- the fn-params-excessive-bools finding on the\n444: /// old three-bool signature was escalated, and the settled answer was this struct: the facts\n445: /// travel under their names.\n446: struct JqInvocation {\n447:     has_value: bool,\n448:     raw: bool,\n449:     uses_lines: bool,\n450: }\n451: \n452: fn run_jq(source: &str, inv: JqInvocation, feed: &Feed) -> Result<String> {\n453:     let JqInvocation {\n454:         has_value,\n455:         raw,\n456:         uses_lines,\n457:     } = inv;\n458:     let mut cmd = std::process::Command::new(\"jq\");\n459:     // jq's stdout is fully buffered rather than line-buffered whenever it is not a terminal, the\n460:     // same as any other libc stdio program, so a filter over `inputs` piped into another process\n461:     // would otherwise sit on every result until the run ends. `run_subprocess` only inherits\n462:     // stdout instead of capturing it for a live run, so this is still what makes that case show a\n463:     // result as soon as jq produces one rather than at exit.\n464:     cmd.arg(\"--unbuffered\");\n465:     cmd.arg(\"-c\");\n466:     // `-r` decides from the runtime value, so it would print a present Opt<Str> raw and an\n467:     // absent one as the word null. The rule here is the type's, as on every other backend.\n468:     if raw {\n469:         cmd.arg(\"-r\");\n470:     }\n471:     if !has_value && !uses_lines {\n472:         cmd.arg(\"-n\");\n473:     }\n474:     // Raw-input mode, needed for `[ inputs ]` to read lines rather than JSON, and forced by the\n475:     // checker to be the only way `lines` is used in this invocation: mixing it with `input` was\n476:     // rejected there, because `-R` changes what the whole invocation means, not just one call.\n477:     // `-n` here is not \"no input coming\"; it is what raw-input mode needs regardless, since\n478:     // `[ inputs ]` reads for itself rather than through the implicit `.` a normal run would use.\n479:     if uses_lines {\n480:         cmd.arg(\"-R\").arg(\"-n\");\n481:     }\n482:     cmd.arg(source);\n483:     run_subprocess(cmd, \"jq\", feed)\n484: }\n485: \n486: fn run_lua(\n487:     source: &str,\n488:     enums: &ty::Enums,\n489:     value: Option<&serde_json::Value>,\n490:     inputs_values: Option<&Vec<serde_json::Value>>,\n491:     inputs_elem_ty: Option<&ty::Type>,\n492:     feed: &Feed,\n493: ) -> Result<String> {\n494:     let lua = mlua::Lua::new();\n495:     if let Some(value) = value {\n496:         lua.globals()\n497:             .set(emit_lua::INPUT, input::to_lua(&lua, value)?)?;\n498:     }\n499:     if let Some(values) = inputs_values {\n500:         let array = serde_json::Value::Array(values.clone());\n501:         lua.globals()\n502:             .set(emit_lua::INPUTS, input::to_lua(&lua, &array)?)?;\n503:     } else if let Some(elem_ty) = inputs_elem_ty {\n504:         // `inputs_values` is `None` here for one of two reasons: the program does not read\n505:         // `inputs` at all (then `inputs_elem_ty` is also `None`, and neither branch runs), or\n506:         // `run_on` recognized this as a fused program and skipped precomputing the whole Vec on\n507:         // purpose (`live_inputs` or `lua_fused` there). mlua is embedded in this same process, so\n508:         // there is no separate JSON parser to write in Lua source the way Rust's own is -- the\n509:         // generated source just calls this function for the next already-validated, already-\n510:         // converted record. Reading from `feed` rather than always the real stdin is what keeps\n511:         // this correct for a fixture-tested fused program too: `feed` is `Feed::Text` there, the\n512:         // same raw bytes a subprocess backend would have been piped.\n513:         let elem_ty = elem_ty.clone();\n514:         let enums = enums.clone();\n515:         let reader: RefCell<Box<dyn std::io::BufRead>> = RefCell::new(match feed {\n516:             Feed::Live => Box::new(std::io::BufReader::new(std::io::stdin())),\n517:             Feed::Text(text) => Box::new(std::io::Cursor::new(text.clone().into_bytes())),\n518:             // `run_on` never builds this feed for the Lua backend: `live_inputs` there stays\n519:             // `Feed::Live`, since this function's own reader validates each record itself.\n520:             Feed::LiveInputs(..) => unreachable!(\"run_on keeps the Lua backend on Feed::Live\"),\n521:         });\n522:         let next_input = lua.create_function(move |lua, ()| {\n523:             use std::io::BufRead;\n524:             loop {\n525:                 let mut line = String::new();\n526:                 let n = reader\n527:                     .borrow_mut()\n528:                     .read_line(&mut line)\n529:                     .map_err(mlua::Error::external)?;\n530:                 if n == 0 {\n531:                     return Ok(mlua::Value::Nil);\n532:                 }\n533:                 let line = line.strip_suffix('\\n').unwrap_or(&line);\n534:                 if line.trim().is_empty() {\n535:                     continue;\n536:                 }\n537:                 let value: serde_json::Value =\n538:                     serde_json::from_str(line).map_err(mlua::Error::external)?;\n539:                 input::validate(&enums, &value, &elem_ty, \"inputs\")\n540:                     .map_err(mlua::Error::RuntimeError)?;\n541:                 return input::to_lua(lua, &value);\n542:             }\n543:         })?;\n544:         lua.globals().set(emit_lua::NEXT_INPUT, next_input)?;\n545:     }\n546:     // mlua is embedded in this same process, so `io.lines()` in the emitted source reads the\n547:     // real stdin directly -- verified against a live pipe, and exactly what a `lines` program\n548:     // run for real should do. A fixture is different: cargo test runs many tests concurrently\n549:     // in one process, so redirecting the process's own fd 0 would race with all of them, and is\n550:     // not done. Instead the fixture is written to a file of its own and `io.lines` is pointed at\n551:     // it, which keeps Lua's own real line-splitting in the loop rather than reimplementing it in\n552:     // Rust and only testing that reimplementation.\n553:     let _fixture_dir;\n554:     if let Feed::Text(text) = feed {\n555:         let dir = tempfile::tempdir()?;\n556:         let path = dir.path().join(\"stdin.txt\");\n557:         std::fs::write(&path, text)?;\n558:         let path = path\n559:             .to_str()\n560:             .expect(\"a temp path is valid UTF-8\")\n561:             .to_string();\n562:         let io: mlua::Table = lua.globals().get(\"io\")?;\n563:         let real_lines: mlua::Function = io.get(\"lines\")?;\n564:         let fixture =\n565:             lua.create_function(move |_, ()| real_lines.call::<mlua::Value>(path.clone()))?;\n566:         io.set(\"lines\", fixture)?;\n567:         _fixture_dir = Some(dir);\n568:     }\n569: \n570:     // A live run has no test harness reading the result back, the same distinction\n571:     // `run_subprocess` makes for the OS-process backends: `print` writes straight to the real\n572:     // stdout and flushes per call instead of buffering into a string only handed back once the\n573:     // whole chunk finishes.\n574:     let live = matches!(feed, Feed::Live);\n575:     let captured = Rc::new(RefCell::new(String::new()));\n576:     let sink = Rc::clone(&captured);\n577:     let print = lua.create_function(move |_, s: String| {\n578:         if live {\n579:             let mut stdout = std::io::stdout();\n580:             writeln!(stdout, \"{s}\").map_err(mlua::Error::external)?;\n581:             stdout.flush().map_err(mlua::Error::external)?;\n582:         } else {\n583:             sink.borrow_mut().push_str(&s);\n584:             sink.borrow_mut().push('\\n');\n585:         }\n586:         Ok(())\n587:     })?;\n588:     lua.globals().set(\"print\", print)?;\n589: \n590:     lua.load(source).exec()?;\n591: \n592:     if live {\n593:         return Ok(String::new());\n594:     }\n595:     let out = captured.borrow().clone();\n596:     Ok(out)\n597: }\n598: \n599: /// Runs through `python3`. Like `node`, this is an interpreter that has to be on the machine\n600: /// rather than one vendored into the build.\n601: fn run_py(source: &str, feed: &Feed) -> Result<String> {\n602:     let dir = tempfile::tempdir()?;\n603:     let path = dir.path().join(\"program.py\");\n604:     std::fs::write(&path, source)?;\n605: \n606:     let mut cmd = std::process::Command::new(\"python3\");\n607:     cmd.arg(&path);\n608:     run_subprocess(cmd, \"python3\", feed)\n609: }\n610: \n611: /// Runs through `go run`, which compiles and executes in one step. Go has no interpreter, so\n612: /// this is the second backend that needs a real toolchain; like `node` and `cc`, a missing one\n613: /// is an error rather than a skipped backend.\n614: fn run_go(source: &str, feed: &Feed) -> Result<String> {\n615:     let dir = tempfile::tempdir()?;\n616:     let path = dir.path().join(\"main.go\");\n617:     std::fs::write(&path, source)?;\n618: \n619:     let mut cmd = std::process::Command::new(\"go\");\n620:     cmd.arg(\"run\").arg(&path);\n621:     run_subprocess(cmd, \"go\", feed)\n622: }\n623: \n624: /// Runs through `node`, which must be present. A missing toolchain is an error rather than a\n625: /// quietly skipped backend: a report that says two backends agreed when only one ran is worse\n626: /// than no report.\n627: fn run_node(source: &str, feed: &Feed) -> Result<String> {\n628:     let dir = tempfile::tempdir()?;\n629:     let path = dir.path().join(\"program.js\");\n630:     std::fs::write(&path, source)?;\n631: \n632:     let mut cmd = std::process::Command::new(\"node\");\n633:     cmd.arg(&path);\n634:     run_subprocess(cmd, \"node\", feed)\n635: }\n636: \n637: impl std::error::Error for Error {}\n\n(End of file - total 637 lines)\n</content>","metadata":{"preview":"pub mod ast;\npub mod check;\npub mod emit_go;\npub mod emit_jq;\npub mod emit_js;\npub mod emit_llvm;\npub mod emit_lua;\npub mod emit_py;\npub mod emit_rs;\npub mod emit_toylang;\npub mod error;\npub mod fmt_tree;\npub mod input;\npub mod parse;\npub mod prelude;\npub mod tags;\npub mod tir;\npub mod ty;\n\nuse std::cell::RefCell;","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-153/src/lib.rs","text":"pub mod ast;\npub mod check;\npub mod emit_go;\npub mod emit_jq;\npub mod emit_js;\npub mod emit_llvm;\npub mod emit_lua;\npub mod emit_py;\npub mod emit_rs;\npub mod emit_toylang;\npub mod error;\npub mod fmt_tree;\npub mod input;\npub mod parse;\npub mod prelude;\npub mod tags;\npub mod tir;\npub mod ty;\n\nuse std::cell::RefCell;\nuse std::io::{BufRead, Write};\nuse std::rc::Rc;\n\nuse anyhow::{Context, Result};\nuse error::Error;\nuse tir::Program;\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum Backend {\n    Lua,\n    Js,\n    Native,\n    Jq,\n    Go,\n    Py,\n    Rust,\n}\n\nimpl Backend {\n    /// The backends that must agree on every corpus program. Native and Rust each joined once\n    /// they could compile the whole language; until then they were kept out rather than allowed\n    /// to turn the harness permanently red, tracked by tests/backend_llvm.rs and\n    /// tests/backend_rust.rs respectively.\n    pub const ALL: [Backend; 7] = [\n        Backend::Lua,\n        Backend::Js,\n        Backend::Native,\n        Backend::Jq,\n        Backend::Go,\n        Backend::Py,\n        Backend::Rust,\n    ];\n\n    /// The spelling used on the command line and in a corpus case's `snapshot` list.\n    pub fn from_name(name: &str) -> Option<Backend> {\n        Backend::ALL.into_iter().find(|b| b.name() == name)\n    }\n\n    pub fn name(self) -> &'static str {\n        match self {\n            Backend::Lua => \"lua\",\n            Backend::Js => \"js\",\n            Backend::Native => \"native\",\n            Backend::Jq => \"jq\",\n            Backend::Go => \"go\",\n            Backend::Py => \"py\",\n            Backend::Rust => \"rust\",\n        }\n    }\n\n    pub fn emit(self, program: &Program) -> Result<String, String> {\n        match self {\n            Backend::Lua => Ok(emit_lua::emit(program)),\n            Backend::Js => Ok(emit_js::emit(program)),\n            Backend::Native => emit_llvm::to_ir(program),\n            Backend::Jq => emit_jq::emit(program),\n            Backend::Go => Ok(emit_go::emit(program)),\n            Backend::Py => Ok(emit_py::emit(program)),\n            Backend::Rust => Ok(emit_rs::emit(program)),\n        }\n    }\n}\n\npub fn compile(src: &str) -> Result<Program, Error> {\n    let mut file = parse::parse(src)?;\n    prelude::inject(&mut file);\n    check::check(&file)\n}\n\n/// Parses `src` and re-renders it in the canonical toylang style, without checking or injecting\n/// the prelude -- a formatter has to work on a program that does not type-check, and it must\n/// never print the prelude definitions `compile` splices in for its own purposes.\npub fn fmt(src: &str) -> Result<String, Error> {\n    emit_toylang::format_source(src)\n}\n\npub fn run(src: &str) -> Result<String> {\n    run_on(src, None, Backend::Lua)\n}\n\npub fn run_with_input(src: &str, stdin: Option<&str>) -> Result<String> {\n    run_on(src, stdin, Backend::Lua)\n}\n\n/// Whether the generated code for `program` reads `inputs` for itself, one record at a time,\n/// rather than needing the whole thing parsed and handed over up front. A type question now,\n/// not a shape guess: exactly the programs `tir::fusion` reads from `inputs` -- every backend\n/// has a fused loop to emit. An aggregate like `length(collect(inputs))` still has no way to\n/// stream no matter which backend runs it. Public so `main.rs` can decide, before it has read\n/// anything, whether to drain real stdin itself or hand it to `run_on` untouched.\npub fn streams_inputs(program: &tir::Program) -> bool {\n    matches!(\n        tir::fusion(program),\n        Some(f) if matches!(f.source, tir::Source::Inputs)\n    )\n}\n\n/// Compile and run, capturing what the program printed -- except when `stdin` is `None` and\n/// `streams_inputs` says the backend reads `inputs` for itself, in which case the real stdin and\n/// stdout are connected straight through (`Feed::Live`) and there is nothing left to capture.\n/// Capturing otherwise keeps the tests to one call: it also means output is held in memory, which\n/// is fine for every program whose result has statically known length, and is exactly the case\n/// `Feed::Live` exists for on the ones that no longer do.\npub fn run_on(src: &str, stdin: Option<&str>, backend: Backend) -> Result<String> {\n    let program = compile(src)?;\n\n    // `stdin.is_none()` is the same convention `uses_lines` already uses below: nothing was\n    // supplied, which only happens on the real command line, never from a test fixture. Only\n    // then is there real live stdin worth handing straight to a subprocess backend rather than\n    // something already sitting in memory to validate up front.\n    let live_inputs = stdin.is_none() && streams_inputs(&program);\n    // Lua is the one backend with no subprocess of its own: `run_lua` itself decides how\n    // `inputs` reaches the running chunk, by injecting either a pre-populated global or a\n    // per-call function, and the emitted source commits to one of those two shapes purely from\n    // `tir::fusion`, independent of whether a fixture or the real command line supplied the\n    // bytes. So unlike `live_inputs` above, this also has to hold for a fixture-fed test, or\n    // the host would inject the global while the fused source calls the function.\n    let lua_fused = matches!(backend, Backend::Lua) && streams_inputs(&program);\n\n    // The input is checked against the declared type once, here, rather than by each backend.\n    // What a backend receives has already been parsed, so no backend re-decides what is valid.\n    let value = match (&program.input, stdin) {\n        (Some(ty), Some(text)) => {\n            let value: serde_json::Value = serde_json::from_str(text)?;\n            input::validate(&program.enums, &value, ty, \"input\").map_err(anyhow::Error::msg)?;\n            Some(value)\n        }\n        (Some(ty), None) => anyhow::bail!(\"this program reads input, of type {ty}\"),\n        (None, _) => None,\n    };\n\n    // `inputs` is eager like `input`, not incremental like `lines`, so it normally goes through\n    // the same validate-then-re-serialize step: every backend receives canonical bytes, one\n    // compact JSON value per line, rather than whatever formatting the original text happened to\n    // use. `live_inputs` and `lua_fused` are the exceptions -- nothing is precomputed for them,\n    // because the whole point of a fused loop is not reading the whole stream before the first\n    // record is handled. Validation still happens record-by-record on the host: `run_lua`'s\n    // `next_input` function does it for the Lua backend it is embedded in, and `Feed::LiveInputs`\n    // below does it for every other, subprocess-based backend, since generated code cannot be\n    // trusted to reimplement `input::validate` correctly in six different target languages.\n    let inputs_values = if live_inputs || lua_fused {\n        None\n    } else {\n        match (&program.inputs, stdin) {\n            (Some(elem_ty), Some(text)) => {\n                let mut values = Vec::new();\n                for line in text.lines().filter(|l| !l.trim().is_empty()) {\n                    let value: serde_json::Value = serde_json::from_str(line)?;\n                    input::validate(&program.enums, &value, elem_ty, \"inputs\")\n                        .map_err(anyhow::Error::msg)?;\n                    values.push(value);\n                }\n                Some(values)\n            }\n            (Some(elem_ty), None) => {\n                anyhow::bail!(\"this program reads inputs, of type Vec<{elem_ty}>\");\n            }\n            (None, _) => None,\n        }\n    };\n\n    // What a backend's stdin should be connected to. `input` always has known bytes: the\n    // re-serialized, already-validated value. `lines` has known bytes only when a caller (a\n    // corpus fixture, most often) supplied them directly -- and when it does, they are piped in\n    // verbatim rather than pre-split, so a backend's own splitting genuinely runs against them\n    // rather than being bypassed by the test that is supposed to exercise it. Only when nothing\n    // was supplied, which is the real command-line case, does `lines` connect the real stdin\n    // straight through, with no Rust-side buffering in between -- the one thing that would make\n    // its streaming indistinguishable from having read everything first. A live, fused `inputs`\n    // program has no type to lean on the way `lines` does (raw text is always valid `Str`), so it\n    // cannot connect the real stdin straight through: `Feed::LiveInputs` reads and validates one\n    // record at a time itself and forwards only what passes, real streaming with no read-it-all-\n    // first buffering, but through Rust rather than direct fd inheritance. The Lua backend is the\n    // one exception -- it validates through its own `next_input` function instead, direct from\n    // `Feed::Live`, since it runs embedded rather than as a subprocess with a pipe to mediate.\n    // A fused Lua program run against a fixture is not live, but still needs the raw bytes\n    // verbatim rather than the eager re-serialized form, since `run_lua`'s injected function does\n    // its own splitting the same way `lines` always has.\n    let feed = if program.uses_lines || program.dsv.is_some() {\n        match stdin {\n            Some(text) => Feed::Text(text.to_string()),\n            None => Feed::Live,\n        }\n    } else if live_inputs {\n        live_inputs_feed(&program, backend)\n    } else if lua_fused {\n        Feed::Text(stdin.map(str::to_string).unwrap_or_default())\n    } else if let Some(values) = &inputs_values {\n        Feed::Text(\n            values\n                .iter()\n                .map(|v| v.to_string())\n                .collect::<Vec<_>>()\n                .join(\"\\n\"),\n        )\n    } else {\n        Feed::Text(value.as_ref().map(|v| v.to_string()).unwrap_or_default())\n    };\n\n    match backend {\n        Backend::Lua => run_lua(\n            &emit_lua::emit(&program),\n            &program.enums,\n            value.as_ref(),\n            inputs_values.as_ref(),\n            program.inputs.as_ref(),\n            &feed,\n        ),\n        Backend::Js => run_node(&emit_js::emit(&program), &feed),\n        Backend::Jq => run_jq(\n            &emit_jq::emit(&program).map_err(anyhow::Error::msg)?,\n            JqInvocation {\n                has_value: value.is_some(),\n                raw: matches!(program.body.ty, ty::Type::Str | ty::Type::Sink),\n                uses_lines: program.uses_lines || program.dsv.is_some(),\n            },\n            &feed,\n        ),\n        Backend::Go => run_go(&emit_go::emit(&program), &feed),\n        Backend::Py => run_py(&emit_py::emit(&program), &feed),\n        Backend::Native => {\n            let dir = tempfile::tempdir()?;\n            let exe = dir.path().join(\"program\");\n            link(&program, &exe)?;\n            run_binary(&exe, &feed)\n        }\n        Backend::Rust => {\n            let dir = tempfile::tempdir()?;\n            let exe = dir.path().join(\"program\");\n            link_rust(&emit_rs::emit(&program), &exe)?;\n            run_binary(&exe, &feed)\n        }\n    }\n}\n\n/// The feed for a live, fused `inputs` program: real stdin, but validated. Lua is the exception,\n/// since `run_lua`'s own `next_input` function validates directly off `Feed::Live` rather than\n/// needing `Feed::LiveInputs` to mediate a pipe it has no subprocess to write into.\nfn live_inputs_feed(program: &Program, backend: Backend) -> Feed {\n    if matches!(backend, Backend::Lua) {\n        Feed::Live\n    } else {\n        Feed::LiveInputs(\n            program\n                .inputs\n                .clone()\n                .expect(\"live_inputs implies an inputs type\"),\n            program.enums.clone(),\n        )\n    }\n}\n\n/// What a subprocess backend's stdin is connected to.\nenum Feed {\n    /// Known bytes, written through a pipe: `input`'s re-serialized value, a `lines` program's\n    /// fixture text verbatim, or nothing for a program that reads no stdin at all.\n    Text(String),\n    /// The real process stdin, inherited rather than piped. Reachable only for a `lines`\n    /// program run with no fixture supplied.\n    Live,\n    /// The real process stdin, read and validated one record at a time against the element type,\n    /// then forwarded through a pipe -- real streaming, but mediated by the host rather than\n    /// inherited directly, which is what lets `input::validate` see every record before a\n    /// subprocess backend's own, untrusted parse of it does. Reachable only for a live, fused\n    /// `inputs` program on a backend other than Lua (see `write_to`).\n    LiveInputs(ty::Type, ty::Enums),\n}\n\nimpl Feed {\n    fn stdio(&self) -> std::process::Stdio {\n        match self {\n            Feed::Text(_) | Feed::LiveInputs(..) => std::process::Stdio::piped(),\n            Feed::Live => std::process::Stdio::inherit(),\n        }\n    }\n\n    fn write_to(&self, child: &mut std::process::Child) -> Result<()> {\n        match self {\n            Feed::Text(text) => {\n                child\n                    .stdin\n                    .take()\n                    .expect(\"piped\")\n                    .write_all(text.as_bytes())?;\n            }\n            Feed::Live => {}\n            Feed::LiveInputs(elem_ty, enums) => {\n                let mut stdin = child.stdin.take().expect(\"piped\");\n                for line in std::io::stdin().lock().lines() {\n                    let line = line?;\n                    if line.trim().is_empty() {\n                        continue;\n                    }\n                    let value: serde_json::Value = serde_json::from_str(&line)?;\n                    if let Err(msg) = input::validate(enums, &value, elem_ty, \"inputs\") {\n                        // Close the pipe so the child sees EOF and can finish printing whatever\n                        // it already validly received, then wait for it before reporting the\n                        // refusal -- otherwise this leaves an unreaped child behind.\n                        drop(stdin);\n                        child.wait()?;\n                        return Err(anyhow::Error::msg(msg));\n                    }\n                    writeln!(stdin, \"{line}\")?;\n                }\n            }\n        }\n        Ok(())\n    }\n}\n\n/// Compile to a native executable at `out`.\n///\n/// LLVM produces an object file, which is not a program, so this shells out to `cc` for the\n/// link. That is a toolchain requirement the Lua backend does not have, since mlua vendors its\n/// interpreter.\npub fn link(program: &Program, out: &std::path::Path) -> Result<()> {\n    let dir = tempfile::tempdir()?;\n    let object = dir.path().join(\"program.o\");\n    emit_llvm::compile_to_object(program, &object).map_err(anyhow::Error::msg)?;\n\n    // The runtime is compiled alongside rather than shipped as a library, which keeps the build\n    // to one `cc` call and means there is nothing to install.\n    let runtime = dir.path().join(\"toylang.c\");\n    std::fs::write(&runtime, emit_llvm::RUNTIME_C)?;\n\n    let status = std::process::Command::new(\"cc\")\n        .arg(&object)\n        .arg(&runtime)\n        .arg(\"-o\")\n        .arg(out)\n        .status()\n        .context(\"could not run `cc`\")?;\n    if !status.success() {\n        anyhow::bail!(\"cc failed to link: {status}\");\n    }\n    Ok(())\n}\n\n/// Compile Rust source to an executable at `out`. One `rustc` call on one self-contained file,\n/// no external crate and no Cargo project, the same reason `link` above is one `cc` call: the\n/// generated source depends on nothing this compiler did not already assume was installed.\n/// Public for the same reason as `link`: `tests/backend_rust.rs` calls it directly, separately\n/// from running the result, so a genuine codegen gap (`rustc` rejects the source) is told apart\n/// from a legitimate runtime refusal (`rustc` succeeds, the binary exits non-zero).\npub fn link_rust(source: &str, out: &std::path::Path) -> Result<()> {\n    let dir = tempfile::tempdir()?;\n    let src = dir.path().join(\"program.rs\");\n    std::fs::write(&src, source)?;\n\n    let result = std::process::Command::new(\"rustc\")\n        .arg(\"--edition\")\n        .arg(\"2021\")\n        .arg(&src)\n        .arg(\"-o\")\n        .arg(out)\n        .output()\n        .context(\"could not run `rustc`\")?;\n    if !result.status.success() {\n        anyhow::bail!(\n            \"rustc failed to compile: {}\",\n            String::from_utf8_lossy(&result.stderr)\n        );\n    }\n    Ok(())\n}\n\n/// Runs `cmd` (already given whatever args the caller needs) connected to `feed`, and returns\n/// what it printed.\n///\n/// When `feed` is `Feed::Live` or `Feed::LiveInputs` there is no test harness reading the result\n/// back: stdout and stderr are inherited straight through to the real terminal or pipe instead of\n/// being captured, which is what lets a program that streams actually show output as it produces\n/// it rather than all at once when it exits. `Ok(String::new())` reflects that nothing is left to\n/// hand back -- it already went to the real stdout directly. `feed.write_to` reports a validation\n/// refusal for `Feed::LiveInputs` as an `Err` before this function's own `child.wait()` runs, so\n/// that path never reaches here at all.\nfn run_subprocess(mut cmd: std::process::Command, label: &str, feed: &Feed) -> Result<String> {\n    let live = matches!(feed, Feed::Live | Feed::LiveInputs(..));\n    let mut child = cmd\n        .stdin(feed.stdio())\n        .stdout(if live {\n            std::process::Stdio::inherit()\n        } else {\n            std::process::Stdio::piped()\n        })\n        .stderr(if live {\n            std::process::Stdio::inherit()\n        } else {\n            std::process::Stdio::piped()\n        })\n        .spawn()\n        .with_context(|| format!(\"could not run `{label}`\"))?;\n\n    feed.write_to(&mut child)?;\n\n    if live {\n        let status = child.wait()?;\n        if !status.success() {\n            anyhow::bail!(\"{label} failed\");\n        }\n        return Ok(String::new());\n    }\n\n    let out = child.wait_with_output()?;\n    if !out.status.success() {\n        anyhow::bail!(\"{label} failed: {}\", String::from_utf8_lossy(&out.stderr));\n    }\n    Ok(String::from_utf8(out.stdout)?)\n}\n\nfn run_binary(exe: &std::path::Path, feed: &Feed) -> Result<String> {\n    run_subprocess(\n        std::process::Command::new(exe),\n        \"the compiled program\",\n        feed,\n    )\n}\n\n/// jq puts stdin in `.`, so a program that reads no input runs with `-n` rather than waiting on\n/// a terminal. `has_value` rather than the `Feed` itself, since a `lines` program run live\n/// (`Feed::Live`) still has real stdin coming and must not get `-n` on that account.\n/// The three facts about a program that shape a jq invocation's flags. Each is derived from\n/// the compiled program, not a caller identity -- the fn-params-excessive-bools finding on the\n/// old three-bool signature was escalated, and the settled answer was this struct: the facts\n/// travel under their names.\nstruct JqInvocation {\n    has_value: bool,\n    raw: bool,\n    uses_lines: bool,\n}\n\nfn run_jq(source: &str, inv: JqInvocation, feed: &Feed) -> Result<String> {\n    let JqInvocation {\n        has_value,\n        raw,\n        uses_lines,\n    } = inv;\n    let mut cmd = std::process::Command::new(\"jq\");\n    // jq's stdout is fully buffered rather than line-buffered whenever it is not a terminal, the\n    // same as any other libc stdio program, so a filter over `inputs` piped into another process\n    // would otherwise sit on every result until the run ends. `run_subprocess` only inherits\n    // stdout instead of capturing it for a live run, so this is still what makes that case show a\n    // result as soon as jq produces one rather than at exit.\n    cmd.arg(\"--unbuffered\");\n    cmd.arg(\"-c\");\n    // `-r` decides from the runtime value, so it would print a present Opt<Str> raw and an\n    // absent one as the word null. The rule here is the type's, as on every other backend.\n    if raw {\n        cmd.arg(\"-r\");\n    }\n    if !has_value && !uses_lines {\n        cmd.arg(\"-n\");\n    }\n    // Raw-input mode, needed for `[ inputs ]` to read lines rather than JSON, and forced by the\n    // checker to be the only way `lines` is used in this invocation: mixing it with `input` was\n    // rejected there, because `-R` changes what the whole invocation means, not just one call.\n    // `-n` here is not \"no input coming\"; it is what raw-input mode needs regardless, since\n    // `[ inputs ]` reads for itself rather than through the implicit `.` a normal run would use.\n    if uses_lines {\n        cmd.arg(\"-R\").arg(\"-n\");\n    }\n    cmd.arg(source);\n    run_subprocess(cmd, \"jq\", feed)\n}\n\nfn run_lua(\n    source: &str,\n    enums: &ty::Enums,\n    value: Option<&serde_json::Value>,\n    inputs_values: Option<&Vec<serde_json::Value>>,\n    inputs_elem_ty: Option<&ty::Type>,\n    feed: &Feed,\n) -> Result<String> {\n    let lua = mlua::Lua::new();\n    if let Some(value) = value {\n        lua.globals()\n            .set(emit_lua::INPUT, input::to_lua(&lua, value)?)?;\n    }\n    if let Some(values) = inputs_values {\n        let array = serde_json::Value::Array(values.clone());\n        lua.globals()\n            .set(emit_lua::INPUTS, input::to_lua(&lua, &array)?)?;\n    } else if let Some(elem_ty) = inputs_elem_ty {\n        // `inputs_values` is `None` here for one of two reasons: the program does not read\n        // `inputs` at all (then `inputs_elem_ty` is also `None`, and neither branch runs), or\n        // `run_on` recognized this as a fused program and skipped precomputing the whole Vec on\n        // purpose (`live_inputs` or `lua_fused` there). mlua is embedded in this same process, so\n        // there is no separate JSON parser to write in Lua source the way Rust's own is -- the\n        // generated source just calls this function for the next already-validated, already-\n        // converted record. Reading from `feed` rather than always the real stdin is what keeps\n        // this correct for a fixture-tested fused program too: `feed` is `Feed::Text` there, the\n        // same raw bytes a subprocess backend would have been piped.\n        let elem_ty = elem_ty.clone();\n        let enums = enums.clone();\n        let reader: RefCell<Box<dyn std::io::BufRead>> = RefCell::new(match feed {\n            Feed::Live => Box::new(std::io::BufReader::new(std::io::stdin())),\n            Feed::Text(text) => Box::new(std::io::Cursor::new(text.clone().into_bytes())),\n            // `run_on` never builds this feed for the Lua backend: `live_inputs` there stays\n            // `Feed::Live`, since this function's own reader validates each record itself.\n            Feed::LiveInputs(..) => unreachable!(\"run_on keeps the Lua backend on Feed::Live\"),\n        });\n        let next_input = lua.create_function(move |lua, ()| {\n            use std::io::BufRead;\n            loop {\n                let mut line = String::new();\n                let n = reader\n                    .borrow_mut()\n                    .read_line(&mut line)\n                    .map_err(mlua::Error::external)?;\n                if n == 0 {\n                    return Ok(mlua::Value::Nil);\n                }\n                let line = line.strip_suffix('\\n').unwrap_or(&line);\n                if line.trim().is_empty() {\n                    continue;\n                }\n                let value: serde_json::Value =\n                    serde_json::from_str(line).map_err(mlua::Error::external)?;\n                input::validate(&enums, &value, &elem_ty, \"inputs\")\n                    .map_err(mlua::Error::RuntimeError)?;\n                return input::to_lua(lua, &value);\n            }\n        })?;\n        lua.globals().set(emit_lua::NEXT_INPUT, next_input)?;\n    }\n    // mlua is embedded in this same process, so `io.lines()` in the emitted source reads the\n    // real stdin directly -- verified against a live pipe, and exactly what a `lines` program\n    // run for real should do. A fixture is different: cargo test runs many tests concurrently\n    // in one process, so redirecting the process's own fd 0 would race with all of them, and is\n    // not done. Instead the fixture is written to a file of its own and `io.lines` is pointed at\n    // it, which keeps Lua's own real line-splitting in the loop rather than reimplementing it in\n    // Rust and only testing that reimplementation.\n    let _fixture_dir;\n    if let Feed::Text(text) = feed {\n        let dir = tempfile::tempdir()?;\n        let path = dir.path().join(\"stdin.txt\");\n        std::fs::write(&path, text)?;\n        let path = path\n            .to_str()\n            .expect(\"a temp path is valid UTF-8\")\n            .to_string();\n        let io: mlua::Table = lua.globals().get(\"io\")?;\n        let real_lines: mlua::Function = io.get(\"lines\")?;\n        let fixture =\n            lua.create_function(move |_, ()| real_lines.call::<mlua::Value>(path.clone()))?;\n        io.set(\"lines\", fixture)?;\n        _fixture_dir = Some(dir);\n    }\n\n    // A live run has no test harness reading the result back, the same distinction\n    // `run_subprocess` makes for the OS-process backends: `print` writes straight to the real\n    // stdout and flushes per call instead of buffering into a string only handed back once the\n    // whole chunk finishes.\n    let live = matches!(feed, Feed::Live);\n    let captured = Rc::new(RefCell::new(String::new()));\n    let sink = Rc::clone(&captured);\n    let print = lua.create_function(move |_, s: String| {\n        if live {\n            let mut stdout = std::io::stdout();\n            writeln!(stdout, \"{s}\").map_err(mlua::Error::external)?;\n            stdout.flush().map_err(mlua::Error::external)?;\n        } else {\n            sink.borrow_mut().push_str(&s);\n            sink.borrow_mut().push('\\n');\n        }\n        Ok(())\n    })?;\n    lua.globals().set(\"print\", print)?;\n\n    lua.load(source).exec()?;\n\n    if live {\n        return Ok(String::new());\n    }\n    let out = captured.borrow().clone();\n    Ok(out)\n}\n\n/// Runs through `python3`. Like `node`, this is an interpreter that has to be on the machine\n/// rather than one vendored into the build.\nfn run_py(source: &str, feed: &Feed) -> Result<String> {\n    let dir = tempfile::tempdir()?;\n    let path = dir.path().join(\"program.py\");\n    std::fs::write(&path, source)?;\n\n    let mut cmd = std::process::Command::new(\"python3\");\n    cmd.arg(&path);\n    run_subprocess(cmd, \"python3\", feed)\n}\n\n/// Runs through `go run`, which compiles and executes in one step. Go has no interpreter, so\n/// this is the second backend that needs a real toolchain; like `node` and `cc`, a missing one\n/// is an error rather than a skipped backend.\nfn run_go(source: &str, feed: &Feed) -> Result<String> {\n    let dir = tempfile::tempdir()?;\n    let path = dir.path().join(\"main.go\");\n    std::fs::write(&path, source)?;\n\n    let mut cmd = std::process::Command::new(\"go\");\n    cmd.arg(\"run\").arg(&path);\n    run_subprocess(cmd, \"go\", feed)\n}\n\n/// Runs through `node`, which must be present. A missing toolchain is an error rather than a\n/// quietly skipped backend: a report that says two backends agreed when only one ran is worse\n/// than no report.\nfn run_node(source: &str, feed: &Feed) -> Result<String> {\n    let dir = tempfile::tempdir()?;\n    let path = dir.path().join(\"program.js\");\n    std::fs::write(&path, source)?;\n\n    let mut cmd = std::process::Command::new(\"node\");\n    cmd.arg(&path);\n    run_subprocess(cmd, \"node\", feed)\n}\n\nimpl std::error::Error for Error {}","lineStart":1,"lineEnd":637,"totalLines":637,"truncated":false}},"title":"src/lib.rs","time":{"start":1788292026640,"end":1788292026659}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me look at `toylang::fmt` in lib.rs.","format":"unknown","index":0}]}},"id":"prt_05e82d0e70019evcKoL94Pbu28","sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","messageID":"msg_05e82b47c001OVuZsyUSK7dbwG"}}
{"type":"step_finish","timestamp":1788292026672,"sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","part":{"id":"prt_05e82d12e001frpDYVgMhIKeXC","reason":"tool-calls","snapshot":"0ebf070b795b2e106627c5d8e519929a4e05dbe7","messageID":"msg_05e82b47c001OVuZsyUSK7dbwG","sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","type":"step-finish","tokens":{"total":67326,"input":65454,"output":69,"reasoning":11,"cache":{"write":0,"read":1792}},"cost":0.004297582}}
{"type":"step_start","timestamp":1788292027875,"sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","part":{"id":"prt_05e82d5de001MRtHffmefDY0kw","messageID":"msg_05e82d142001zMG9Cww6l5kczB","sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","snapshot":"0ebf070b795b2e106627c5d8e519929a4e05dbe7","type":"step-start"}}
{"type":"tool_use","timestamp":1788292028221,"sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","part":{"type":"tool","tool":"read","callID":"call_01a05e82d61b7240a51383a9","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-153/src/emit_toylang.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-153/src/emit_toylang.rs</path>\n<type>file</type>\n<content>\n1: //! The formatter's own backend: re-renders a parsed file as toylang source, in one canonical\n2: //! style. Unlike the other `emit_*` backends this walks `ast::File`, not `tir::Program` -- a\n3: //! formatter has to work on a program that does not type-check, and it must not print the\n4: //! prelude that `prelude::inject` would otherwise splice in.\n5: //!\n6: //! Two things drive the design. First, minimal-but-correct parenthesization: the AST does not\n7: //! record which parens the source actually used, so every paren in the output is one this module\n8: //! decided it needed, by comparing a node's own operator power against the power the position it\n9: //! sits in requires -- the same table `parse.rs::infix_power` parses with, walked in reverse.\n10: //! Second, the maintainer's own sample (docs/examples/euler/01-multiples-of-3-and-5.md) is the\n11: //! only ground truth for layout: a function whose signature-plus-body fits on one line stays on\n12: //! one line; otherwise the body moves to its own indented line, and a binary chain that still\n13: //! does not fit breaks at its outermost operator, trailing the operator on the first line.\n14: //! Match-arm and conditional chains extend that same \"trailing operator, one extra indent\" rule\n15: //! by analogy, since nothing in the sample pins their layout directly. A pipeline that does not\n16: //! fit is the one exception: it breaks one stage per line, with `|` leading each continuation\n17: //! line so the pipes form a vertical column (maintainer directive, issue #101), rather than\n18: //! trailing like the other chains.\n19: //!\n20: //! Two style choices worth naming since nothing in the grammar forces them: calls are always\n21: //! written with explicit parens (`f(x)`, never the bare `f x` or brace-shorthand `f{...}`),\n22: //! matching both calls in the sample; and the wrap width is 80 columns, backed out from the\n23: //! sample itself -- the one line it left alone is 44 columns, and the two it broke are 89 and\n24: //! 118.\n25: //!\n26: //! One thing the AST cannot carry: comments. `parse::parse` throws every `#...` away as trivia\n27: //! (`skip_trivia`), so `emit` alone can only ever produce a program with none. `format_source`\n28: //! covers the one shape that actually appears in this repository -- a file's leading banner,\n29: //! read back off the raw text rather than the tree -- and nothing else; a comment anywhere else\n30: //! does not survive formatting, which is why every fragment that puts one somewhere else is\n31: //! marked a syntax-spelling exception rather than swept.\n32: \n33: use crate::ast::{\n34:     Alias, BinOp, Def, EnumDecl, Expr, FieldsPattern, File, LogicOp, MatchArm, Module, Param,\n35:     Pattern, TypeExpr, Variant,\n36: };\n37: \n38: const WIDTH: usize = 80;\n39: const INDENT: usize = 4;\n40: \n41: // Mirrors parse.rs's precedence table exactly (`infix_power`, `PIPE_LEFT`/`PIPE_RIGHT`,\n42: // `COND_POWER`, `OR_LEFT`/`OR_RIGHT`, `NOT_POWER`): the numbers a paren decision here has to\n43: // answer to are the parser's, not this module's own invention.\n44: const PIPE_LEFT: u8 = 1;\n45: const PIPE_RIGHT: u8 = 2;\n46: const COND_POWER: u8 = 3;\n47: const NOT_POWER: u8 = 8;\n48: \n49: /// A match arm's body is printed at a power just above `or`'s, which is how the parser's second\n50: /// reading of `or` -- the arm separator, which has no power at all -- reaches this table: a bare\n51: /// disjunction in an arm body is the one expression whose parens the powers alone would not ask\n52: /// for, and the one the parser would otherwise read as two arms.\n53: const ARM_BODY: u8 = 5;\n54: \n55: fn bin_power(op: BinOp) -> (u8, u8) {\n56:     match op {\n57:         BinOp::Eq | BinOp::Ne | BinOp::Lt | BinOp::Le | BinOp::Gt | BinOp::Ge => (8, 9),\n58:         BinOp::Add | BinOp::Sub => (10, 11),\n59:         BinOp::Mul | BinOp::Div | BinOp::Rem => (12, 13),\n60:     }\n61: }\n62: \n63: fn logic_power(op: LogicOp) -> (u8, u8) {\n64:     match op {\n65:         LogicOp::Or => (4, 5),\n66:         LogicOp::And => (6, 7),\n67:     }\n68: }\n69: \n70: /// Where a conditional's `else` tail is printed: the same position the conditional itself sits\n71: /// in when that is an arm body (so `or` keeps reading as the separator all the way down the\n72: /// chain), and an ordinary `expr(COND_POWER)` position otherwise.\n73: fn cond_tail(m: u8) -> u8 {\n74:     if m == ARM_BODY { ARM_BODY } else { COND_POWER }\n75: }\n76: \n77: /// Where a child expression sits, in terms of what the parser would have accepted bare at that\n78: /// spot -- everything `needs_parens` and the wrapping printer need to know to reproduce the tree\n79: /// exactly, and nothing else.\n80: #[derive(Clone, Copy)]\n81: enum Ctx {\n82:     /// A fresh `self.expr(m)` call: File/Def body, a call argument (always real parens here, so\n83:     /// always reset to `Expr(0)` inside them), `Index`'s bracketed expression, a match arm's\n84:     /// body, or `Cond::otherwise`. The one context where a bare `Cond` and, when `m` is loose\n85:     /// enough, a bare `Pipe` or `Match` are all reachable.\n86:     Expr(u8),\n87:     /// A `self.operand(m)` call: a `Binary` child, or `Pattern::Guard`'s expression. `Cond`,\n88:     /// `Pipe`, and `Match` are never reachable bare here -- only `expr()` parses those.\n89:     Operand(u8),\n90:     /// `Cond::then`: built the same way as `Operand(m)`, except a `Match` is also reachable\n91:     /// (bare, when `m <= PIPE_RIGHT`) because it is built by the same call that would otherwise\n92:     /// have produced the `Operand(m)` result, before the `if` is even seen.\n93:     CondThen(u8),\n94:     /// The base of a postfix chain (`Field`/`Index`/`Project`/`Unwrap`), or a `Call`/`Variant`'s\n95:     /// argument print used only when NOT already inside real parens. Nothing compound is\n96:     /// reachable bare here -- not even `Neg`.\n97:     Atom,\n98:     /// `Neg`'s base: like `Atom`, except a nested `Neg` is reachable bare (`- -a`).\n99:     Unary,\n100: }\n101: \n102: /// The left binding power of whatever operator `e` is, for the three contexts that decide by\n103: /// power alone. `None` for everything else, which each context rules on by kind.\n104: fn left_power(e: &Expr) -> Option<u8> {\n105:     match e {\n106:         Expr::Binary { op, .. } => Some(bin_power(*op).0),\n107:         Expr::Logic { op, .. } => Some(logic_power(*op).0),\n108:         Expr::Not { .. } => Some(NOT_POWER),\n109:         _ => None,\n110:     }\n111: }\n112: \n113: fn needs_parens(e: &Expr, ctx: Ctx) -> bool {\n114:     // A `let` block is only ever a function body, never a sub-expression, so no child position\n115:     // can hold one; treating it as needing parens everywhere is the safe dead arm.\n116:     if matches!(e, Expr::Let { .. }) {\n117:         return true;\n118:     }\n119:     match ctx {\n120:         Ctx::Atom => matches!(\n121:             e,\n122:             Expr::Binary { .. }\n123:                 | Expr::Logic { .. }\n124:                 | Expr::Not { .. }\n125:                 | Expr::Pipe { .. }\n126:                 | Expr::Cond { .. }\n127:                 | Expr::Match { .. }\n128:                 | Expr::Neg { .. }\n129:         ),\n130:         Ctx::Unary => {\n131:             matches!(\n132:                 e,\n133:                 Expr::Binary { .. }\n134:                     | Expr::Logic { .. }\n135:                     | Expr::Not { .. }\n136:                     | Expr::Pipe { .. }\n137:                     | Expr::Cond { .. }\n138:                     | Expr::Match { .. }\n139:             )\n140:         }\n141:         Ctx::Operand(m) => match e {\n142:             Expr::Pipe { .. } | Expr::Cond { .. } | Expr::Match { .. } => true,\n143:             _ => left_power(e).is_some_and(|p| p < m),\n144:         },\n145:         Ctx::CondThen(m) => match e {\n146:             Expr::Match { .. } => m > PIPE_RIGHT,\n147:             Expr::Pipe { .. } | Expr::Cond { .. } => true,\n148:             _ => left_power(e).is_some_and(|p| p < m),\n149:         },\n150:         Ctx::Expr(m) => match e {\n151:             Expr::Pipe { .. } => PIPE_LEFT < m,\n152:             Expr::Match { .. } => m > PIPE_RIGHT,\n153:             _ => left_power(e).is_some_and(|p| p < m),\n154:         },\n155:     }\n156: }\n157: \n158: fn fits(s: &str, indent: usize) -> bool {\n159:     indent + s.chars().count() <= WIDTH\n160: }\n161: \n162: fn pad(n: usize) -> String {\n163:     \" \".repeat(n)\n164: }\n165: \n166: pub fn emit(file: &File) -> String {\n167:     let mut out = String::new();\n168:     for decl in decls_in_source_order(&file.aliases, &file.enums, &file.defs) {\n169:         out.push_str(&decl);\n170:         out.push_str(\"\\n\\n\");\n171:     }\n172:     if let Some(ty) = &file.input {\n173:         out.push_str(&format!(\"input {}\\n\\n\", print_type(ty)));\n174:     }\n175:     out.push_str(&print_expr_wrapped(&file.body, Ctx::Expr(0), 0));\n176:     out.push('\\n');\n177:     out\n178: }\n179: \n180: /// A module is the declarations alone: no trailing expression to separate them from, so they end\n181: /// the file rather than each being followed by a blank line the way `emit` writes them.\n182: pub fn emit_module(module: &Module) -> String {\n183:     let decls = decls_in_source_order(&[], &module.enums, &module.defs);\n184:     if decls.is_empty() {\n185:         return String::new();\n186:     }\n187:     format!(\"{}\\n\", decls.join(\"\\n\\n\"))\n188: }\n189: \n190: /// Every declaration rendered, back in the order it was written.\n191: ///\n192: /// The AST groups declarations by kind, losing their interleaving in the source; sorting by span\n193: /// start puts them back, which is what makes the output idempotent -- reformatting an\n194: /// already-sorted file is a no-op re-sort.\n195: fn decls_in_source_order(aliases: &[Alias], enums: &[EnumDecl], defs: &[Def]) -> Vec<String> {\n196:     enum Item<'a> {\n197:         Alias(&'a Alias),\n198:         Enum(&'a EnumDecl),\n199:         Def(&'a Def),\n200:     }\n201: \n202:     let mut items: Vec<(usize, Item)> = Vec::new();\n203:     for a in aliases {\n204:         items.push((a.span.start, Item::Alias(a)));\n205:     }\n206:     for e in enums {\n207:         items.push((e.span.start, Item::Enum(e)));\n208:     }\n209:     for d in defs {\n210:         items.push((d.span.start, Item::Def(d)));\n211:     }\n212:     items.sort_by_key(|(start, _)| *start);\n213: \n214:     items\n215:         .iter()\n216:         .map(|(_, item)| match item {\n217:             Item::Alias(a) => print_alias(a),\n218:             Item::Enum(e) => print_enum(e),\n219:             Item::Def(d) => print_def(d),\n220:         })\n221:         .collect()\n222: }\n223: \n224: /// Parses `src` and formats it, then reattaches the one piece of source text `emit` cannot\n225: /// reconstruct from the tree: a leading run of `#` comment (and blank) lines, copied back\n226: /// verbatim ahead of the formatted body.\n227: ///\n228: /// Two file shapes reach a formatter that walks a project: a program, and a module --\n229: /// declarations with no trailing expression, which `parse` rejects outright and which\n230: /// `prelude.toy` is the one instance of here. Which one a file is only shows up in the parsing,\n231: /// so both are tried. When neither parse succeeds, the error reported is whichever got further\n232: /// into the file, so a typo halfway down a module is not reported as a missing program body.\n233: pub fn format_source(src: &str) -> Result<String, crate::error::Error> {\n234:     let banner = leading_comment(src);\n235:     let as_program = match crate::parse::parse(src) {\n236:         Ok(file) => return Ok(format!(\"{banner}{}\", emit(&file))),\n237:         Err(e) => e,\n238:     };\n239:     match crate::parse::parse_module(src) {\n240:         Ok(module) => Ok(format!(\"{banner}{}\", emit_module(&module))),\n241:         Err(as_module) if as_module.span.start > as_program.span.start => Err(as_module),\n242:         Err(_) => Err(as_program),\n243:     }\n244: }\n245: \n246: fn leading_comment(src: &str) -> String {\n247:     let mut banner = String::new();\n248:     for line in src.lines() {\n249:         let trimmed = line.trim_start();\n250:         if trimmed.starts_with('#') {\n251:             banner.push_str(line.trim_end());\n252:             banner.push('\\n');\n253:         } else if trimmed.is_empty() {\n254:             if banner.is_empty() {\n255:                 continue;\n256:             }\n257:             break;\n258:         } else {\n259:             break;\n260:         }\n261:     }\n262:     banner\n263: }\n264: \n265: fn print_alias(a: &Alias) -> String {\n266:     format!(\"type {} = {}\", a.name, print_type(&a.ty))\n267: }\n268: \n269: fn print_param(p: &Option<Param>) -> String {\n270:     match p {\n271:         None => String::new(),\n272:         Some(p) => format!(\"{}: {}\", p.name, print_type(&p.ty)),\n273:     }\n274: }\n275: \n276: fn print_def(d: &Def) -> String {\n277:     let pub_prefix = if d.is_pub { \"pub \" } else { \"\" };\n278:     let sig = format!(\n279:         \"{pub_prefix}fn {}({}) -> {}\",\n280:         d.name,\n281:         print_param(&d.param),\n282:         print_type(&d.ret)\n283:     );\n284:     // A `let` block is line-structured, so it has no one-line form: the signature, then one\n285:     // `let` line per binding, then the value, each indented one level.\n286:     if let Expr::Let { bindings, body, .. } = &d.body {\n287:         let mut lines: Vec<String> = bindings\n288:             .iter()\n289:             .map(|(n, v)| format!(\"let {n} = {}\", print_expr_compact(v, Ctx::Expr(0))))\n290:             .collect();\n291:         lines.push(print_expr_wrapped(body, Ctx::Expr(0), INDENT));\n292:         let mut out = format!(\"{sig} =\\n\");\n293:         for line in lines {\n294:             out.push_str(&pad(INDENT));\n295:             out.push_str(&line);\n296:             out.push('\\n');\n297:         }\n298:         return out.trim_end().to_string();\n299:     }\n300:     let compact_body = print_expr_compact(&d.body, Ctx::Expr(0));\n301:     let one_line = format!(\"{sig} = {compact_body}\");\n302:     if fits(&one_line, 0) {\n303:         return one_line;\n304:     }\n305:     let body = print_expr_wrapped(&d.body, Ctx::Expr(0), INDENT);\n306:     format!(\"{sig} =\\n{}{body}\", pad(INDENT))\n307: }\n308: \n309: fn print_variant_decl(v: &Variant) -> String {\n310:     match &v.payload {\n311:         None => v.name.clone(),\n312:         Some(TypeExpr::Record { fields, .. }) => {\n313:             let fields_str = fields\n314:                 .iter()\n315:                 .map(|(n, t)| format!(\"{n}: {}\", print_type(t)))\n316:                 .collect::<Vec<_>>()\n317:                 .join(\", \");\n318:             format!(\"{}{{{fields_str}}}\", v.name)\n319:         }\n320:         Some(t) => format!(\"{}({})\", v.name, print_type(t)),\n321:     }\n322: }\n323: \n324: fn print_enum(e: &EnumDecl) -> String {\n325:     let pub_prefix = if e.is_pub { \"pub \" } else { \"\" };\n326:     let params = if e.params.is_empty() {\n327:         String::new()\n328:     } else {\n329:         let names: Vec<&str> = e.params.iter().map(|(n, _)| n.as_str()).collect();\n330:         format!(\"<{}>\", names.join(\", \"))\n331:     };\n332:     let head = format!(\"{pub_prefix}enum {}{params}\", e.name);\n333:     let variants: Vec<String> = e.variants.iter().map(print_variant_decl).collect();\n334:     if variants.is_empty() {\n335:         return format!(\"{head} {{}}\");\n336:     }\n337:     let compact = format!(\"{head} {{ {} }}\", variants.join(\", \"));\n338:     if fits(&compact, 0) {\n339:         return compact;\n340:     }\n341:     format!(\"{head} {}\", wrap_delim(\"{\", &variants, \"}\", 0))\n342: }\n343: \n344: fn print_type(t: &TypeExpr) -> String {\n345:     match t {\n346:         TypeExpr::Named { name, args, .. } => {\n347:             if args.is_empty() {\n348:                 name.clone()\n349:             } else {\n350:                 let args_str = args.iter().map(print_type).collect::<Vec<_>>().join(\", \");\n351:                 format!(\"{name}<{args_str}>\")\n352:             }\n353:         }\n354:         TypeExpr::Vec { elem, .. } => format!(\"Vec<{}>\", print_type(elem)),\n355:         TypeExpr::Stream { elem, .. } => format!(\"Stream<{}>\", print_type(elem)),\n356:         TypeExpr::Record { fields, .. } => {\n357:             let fields_str = fields\n358:                 .iter()\n359:                 .map(|(n, t)| format!(\"{n}: {}\", print_type(t)))\n360:                 .collect::<Vec<_>>()\n361:                 .join(\", \");\n362:             format!(\"{{{fields_str}}}\")\n363:         }\n364:     }\n365: }\n366: \n367: /// A closing delimiter's list never accepts a trailing comma (every list-parser in `parse.rs`\n368: /// tries to read one more item right after a comma, with no check for an immediate close), so a\n369: /// broken list must never write one before `close`.\n370: fn wrap_delim(open: &str, items: &[String], close: &str, indent: usize) -> String {\n371:     if items.is_empty() {\n372:         return format!(\"{open}{close}\");\n373:     }\n374:     let inner = indent + INDENT;\n375:     let mut out = format!(\"{open}\\n\");\n376:     for (i, item) in items.iter().enumerate() {\n377:         out.push_str(&pad(inner));\n378:         out.push_str(item);\n379:         if i + 1 < items.len() {\n380:             out.push(',');\n381:         }\n382:         out.push('\\n');\n383:     }\n384:     out.push_str(&pad(indent));\n385:     out.push_str(close);\n386:     out\n387: }\n388: \n389: fn escape_str(s: &str) -> String {\n390:     let mut out = String::with_capacity(s.len());\n391:     for c in s.chars() {\n392:         match c {\n393:             '\"' => out.push_str(\"\\\\\\\"\"),\n394:             '\\\\' => out.push_str(\"\\\\\\\\\"),\n395:             '\\n' => out.push_str(\"\\\\n\"),\n396:             '\\t' => out.push_str(\"\\\\t\"),\n397:             '\\r' => out.push_str(\"\\\\r\"),\n398:             _ => out.push(c),\n399:         }\n400:     }\n401:     out\n402: }\n403: \n404: /// The base of a postfix chain (`Field`/`Index`/`Project`/`Unwrap`): only reachable bare via\n405: /// `atom()`, so a compound child always needs parens there.\n406: fn print_atom_base(base: &Expr) -> String {\n407:     print_expr_compact(base, Ctx::Atom)\n408: }\n409: \n410: /// A `Call`/`Variant` argument is always printed inside real parens this module writes itself\n411: /// (see the module doc), so the content resets to a fresh `Expr(0)` position.\n412: fn print_paren_arg(e: &Expr) -> String {\n413:     print_expr_compact(e, Ctx::Expr(0))\n414: }\n415: \n416: fn print_expr_compact(e: &Expr, ctx: Ctx) -> String {\n417:     if needs_parens(e, ctx) {\n418:         return format!(\"({})\", print_expr_inner(e, ctx));\n419:     }\n420:     print_expr_inner(e, ctx)\n421: }\n422: \n423: /// The outer parens decision (`needs_parens`) has already been made by `print_expr_compact`;\n424: /// `ctx` is threaded in only for `Cond::then`, which is the one child position whose available\n425: /// bare kinds depend on where the *whole* `Cond` sits. Every other child position is fixed by\n426: /// its own node (a `Binary`'s own operator powers, `Pipe`'s hard-coded `PIPE_RIGHT`, and so on),\n427: /// independent of `ctx`.\n428: fn print_expr_inner(e: &Expr, ctx: Ctx) -> String {\n429:     match e {\n430:         Expr::Str { text, .. } => format!(\"\\\"{}\\\"\", escape_str(text)),\n431:         Expr::Int { value, .. } => value.to_string(),\n432:         Expr::VecLit { items, .. } => {\n433:             let items_str = items\n434:                 .iter()\n435:                 .map(print_paren_arg)\n436:                 .collect::<Vec<_>>()\n437:                 .join(\", \");\n438:             format!(\"[{items_str}]\")\n439:         }\n440:         Expr::RecordLit { fields, .. } => format!(\"{{{}}}\", print_record_fields(fields)),\n441:         Expr::Subject { .. } => \".\".to_string(),\n442:         Expr::Var { name, .. } => name.clone(),\n443:         Expr::Call { func, arg, .. } => match arg {\n444:             None => format!(\"{func}()\"),\n445:             Some(a) => format!(\"{func}({})\", print_paren_arg(a)),\n446:         },\n447:         Expr::Project { base, .. } => format!(\"{}[]\", print_atom_base(base)),\n448:         Expr::Index { base, index, .. } => {\n449:             format!(\"{}[{}]\", print_atom_base(base), print_paren_arg(index))\n450:         }\n451:         Expr::Slice { base, start, end, .. } => {\n452:             let lo = match start {\n453:                 Some(s) => print_paren_arg(s),\n454:                 None => String::new(),\n455:             };\n456:             let hi = match end {\n457:                 Some(e) => print_paren_arg(e),\n458:                 None => String::new(),\n459:             };\n460:             format!(\"{}[{lo}:{hi}]\", print_atom_base(base))\n461:         }\n462:         Expr::Unwrap { base, .. } => format!(\"{}!\", print_atom_base(base)),\n463:         Expr::Neg { base, .. } => format!(\"-{}\", print_expr_compact(base, Ctx::Unary)),\n464:         // `not x`, not `not(x)`: this is an operator, and the parens spelling would read as the\n465:         // call it is not. What follows is printed at `not`'s own power, so `not a == b` keeps\n466:         // the parens off the comparison the parser would give it back.\n467:         Expr::Not { base, .. } => {\n468:             format!(\"not {}\", print_expr_compact(base, Ctx::Operand(NOT_POWER)))\n469:         }\n470:         Expr::Cond {\n471:             then,\n472:             cond,\n473:             otherwise,\n474:             ..\n475:         } => {\n476:             let m = outer_m(ctx);\n477:             format!(\n478:                 \"{} if {} else {}\",\n479:                 print_expr_compact(then, Ctx::CondThen(m)),\n480:                 print_expr_compact(cond, Ctx::Operand(COND_POWER + 1)),\n481:                 print_expr_compact(otherwise, Ctx::Expr(cond_tail(m)))\n482:             )\n483:         }\n484:         Expr::Field { base, name, .. } => {\n485:             let base_str = print_atom_base(base);\n486:             if base_str == \".\" {\n487:                 format!(\".{name}\")\n488:             } else {\n489:                 format!(\"{base_str}.{name}\")\n490:             }\n491:         }\n492:         Expr::Input { .. } => \"input\".to_string(),\n493:         Expr::Inputs { .. } => \"inputs\".to_string(),\n494:         Expr::Lines { .. } => \"lines\".to_string(),\n495:         // `csv`/`tsv` are parser sugar, so the canonical spelling is the parameterized form.\n496:         Expr::Dsv { delim, .. } => format!(\"dsv(\\\"{}\\\")\", escape_str(delim)),\n497:         Expr::Variant {\n498:             enum_name,\n499:             variant,\n500:             payload,\n501:             ..\n502:         } => match payload {\n503:             None => format!(\"{enum_name}.{variant}\"),\n504:             Some(p) => format!(\"{enum_name}.{variant}({})\", print_paren_arg(p)),\n505:         },\n506:         Expr::Match { arms, .. } => arms\n507:             .iter()\n508:             .enumerate()\n509:             .map(|(i, a)| print_match_arm(a, i + 1 == arms.len()))\n510:             .collect::<Vec<_>>()\n511:             .join(\" or \"),\n512:         Expr::Pipe { lhs, rhs, .. } => {\n513:             // `Pipe.lhs` accumulates the same way a `Binary` chain does (`a | b | c` folds\n514:             // left, exactly like `a - b - c`), so a nested `Pipe` there reproduces itself with\n515:             // no parens needed, the same as any other `Ctx::Expr(0)` position. Only `rhs` -- a\n516:             // genuinely fresh `expr(PIPE_RIGHT)` call -- can force parens on a nested `Pipe`.\n517:             format!(\n518:                 \"{} | {}\",\n519:                 print_expr_compact(lhs, Ctx::Expr(0)),\n520:                 print_expr_compact(rhs, Ctx::Expr(PIPE_RIGHT))\n521:             )\n522:         }\n523:         Expr::Binary { op, lhs, rhs, .. } => {\n524:             let (left, right) = bin_power(*op);\n525:             format!(\n526:                 \"{} {op} {}\",\n527:                 print_expr_compact(lhs, Ctx::Operand(left)),\n528:                 print_expr_compact(rhs, Ctx::Operand(right))\n529:             )\n530:         }\n531:         Expr::Logic { op, lhs, rhs, .. } => {\n532:             let (left, right) = logic_power(*op);\n533:             format!(\n534:                 \"{} {op} {}\",\n535:                 print_expr_compact(lhs, Ctx::Operand(left)),\n536:                 print_expr_compact(rhs, Ctx::Operand(right))\n537:             )\n538:         }\n539:         // `print_def` emits a `let` block before reaching this match; a `Let` here is a\n540:         // nested one the parser never produces (the block form is only a function body).\n541:         Expr::Let { .. } => unreachable!(\"a `let` block is only ever a function body\"),\n542:     }\n543: }\n544: \n545: fn outer_m(ctx: Ctx) -> u8 {\n546:     match ctx {\n547:         Ctx::Expr(m) | Ctx::Operand(m) | Ctx::CondThen(m) => m,\n548:         Ctx::Atom | Ctx::Unary => 0,\n549:     }\n550: }\n551: \n552: fn print_record_fields(fields: &[(String, crate::ast::Span, Expr)]) -> String {\n553:     fields\n554:         .iter()\n555:         .map(|(n, _, v)| format!(\"{n}: {}\", print_paren_arg(v)))\n556:         .collect::<Vec<_>>()\n557:         .join(\", \")\n558: }\n559: \n560: fn print_fields_pattern(f: &FieldsPattern) -> String {\n561:     let names: Vec<&str> = f.names.iter().map(|(n, _)| n.as_str()).collect();\n562:     if f.rest {\n563:         if names.is_empty() {\n564:             \"..\".to_string()\n565:         } else {\n566:             format!(\"{}, ..\", names.join(\", \"))\n567:         }\n568:     } else {\n569:         names.join(\", \")\n570:     }\n571: }\n572: \n573: /// A `Default` pattern comes from either an explicit `any()` or a bare trailing expression --\n574: /// indistinguishable in the AST except that the bare form's span is exactly its body's span\n575: /// (`parse.rs::guard_or_default_arm`). Printing bare whenever that holds and the arm is last\n576: /// (the only place a bare default is legal) reproduces the shorter, and by construction always\n577: /// idempotent, spelling; every other `Default` prints the explicit `any()` it must have been.\n578: fn print_match_arm(arm: &MatchArm, is_last: bool) -> String {\n579:     let body = print_expr_compact(&arm.body, Ctx::Expr(ARM_BODY));\n580:     match &arm.pattern {\n581:         Pattern::Default { span } if is_last && *span == arm.body.span() => body,\n582:         Pattern::Default { .. } => format!(\"any() -> {body}\"),\n583:         Pattern::Guard(g) => format!(\n584:             \"{} -> {body}\",\n585:             print_expr_compact(g, Ctx::Operand(COND_POWER))\n586:         ),\n587:         Pattern::Variant { name, fields, .. } => {\n588:             let head = match fields {\n589:                 None => name.clone(),\n590:                 Some(f) => format!(\"{name}{{{}}}\", print_fields_pattern(f)),\n591:             };\n592:             format!(\"{head} -> {body}\")\n593:         }\n594:     }\n595: }\n596: \n597: /// Tries the compact form first; when it does not fit at `indent`, breaks the node at its own\n598: /// natural seam (an operator, an arm, a delimited list) rather than leaving it overlong. Falls\n599: /// back to the (overlong) compact form for node kinds with no seam to break at -- accepted\n600: /// overflow, not a correctness problem, since every backend agrees on lines it never sees.\n601: fn print_expr_wrapped(e: &Expr, ctx: Ctx, indent: usize) -> String {\n602:     let compact = print_expr_compact(e, ctx);\n603:     if fits(&compact, indent) {\n604:         return compact;\n605:     }\n606:     if needs_parens(e, ctx) {\n607:         let inner = print_expr_wrapped(e, Ctx::Expr(0), indent + INDENT);\n608:         return format!(\"(\\n{}{inner}\\n{})\", pad(indent + INDENT), pad(indent));\n609:     }\n610:     match e {\n611:         Expr::Binary { op, lhs, rhs, .. } => {\n612:             let (left, right) = bin_power(*op);\n613:             let lhs_str = print_expr_wrapped(lhs, Ctx::Operand(left), indent);\n614:             let rhs_str = print_expr_wrapped(rhs, Ctx::Operand(right), indent + INDENT);\n615:             format!(\"{lhs_str} {op}\\n{}{rhs_str}\", pad(indent + INDENT))\n616:         }\n617:         Expr::Logic { op, lhs, rhs, .. } => {\n618:             let (left, right) = logic_power(*op);\n619:             let lhs_str = print_expr_wrapped(lhs, Ctx::Operand(left), indent);\n620:             let rhs_str = print_expr_wrapped(rhs, Ctx::Operand(right), indent + INDENT);\n621:             format!(\"{lhs_str} {op}\\n{}{rhs_str}\", pad(indent + INDENT))\n622:         }\n623:         Expr::Not { base, .. } => format!(\n624:             \"not {}\",\n625:             print_expr_wrapped(base, Ctx::Operand(NOT_POWER), indent)\n626:         ),\n627:         Expr::Pipe { .. } => wrap_pipe(e, indent),\n628:         Expr::Match { arms, .. } => wrap_match(arms, indent),\n629:         Expr::Cond { .. } => wrap_cond(e, outer_m(ctx), indent),\n630:         Expr::VecLit { items, .. } => {\n631:             let rendered: Vec<String> = items\n632:                 .iter()\n633:                 .map(|i| print_expr_wrapped(i, Ctx::Expr(0), indent + INDENT))\n634:                 .collect();\n635:             wrap_delim(\"[\", &rendered, \"]\", indent)\n636:         }\n637:         Expr::RecordLit { fields, .. } => {\n638:             let rendered: Vec<String> = fields\n639:                 .iter()\n640:                 .map(|(n, _, v)| {\n641:                     format!(\n642:                         \"{n}: {}\",\n643:                         print_expr_wrapped(v, Ctx::Expr(0), indent + INDENT)\n644:                     )\n645:                 })\n646:                 .collect();\n647:             wrap_delim(\"{\", &rendered, \"}\", indent)\n648:         }\n649:         Expr::Call {\n650:             func, arg: Some(a), ..\n651:         } => {\n652:             let item = print_expr_wrapped(a, Ctx::Expr(0), indent + INDENT);\n653:             format!(\"{func}{}\", wrap_delim(\"(\", &[item], \")\", indent))\n654:         }\n655:         Expr::Variant {\n656:             enum_name,\n657:             variant,\n658:             payload: Some(p),\n659:             ..\n660:         } => {\n661:             let item = print_expr_wrapped(p, Ctx::Expr(0), indent + INDENT);\n662:             format!(\n663:                 \"{enum_name}.{variant}{}\",\n664:                 wrap_delim(\"(\", &[item], \")\", indent)\n665:             )\n666:         }\n667:         Expr::Neg { base, .. } => format!(\"-{}\", print_expr_wrapped(base, Ctx::Unary, indent)),\n668:         // No natural seam to break at (`Var`, `Call`/`Variant` with no argument, a projection or\n669:         // field chain, and so on): the compact form already computed above is the best available.\n670:         _ => compact,\n671:     }\n672: }\n673: \n674: /// Flattens a left-recursive `Pipe` chain (`a | b | c` parses as `(a | b) | c`, the same fold\n675: /// `Binary` chains use) into its stages in source order.\n676: fn flatten_pipe(e: &Expr) -> Vec<&Expr> {\n677:     let mut stages = Vec::new();\n678:     let mut cur = e;\n679:     while let Expr::Pipe { lhs, rhs, .. } = cur {\n680:         stages.push(rhs.as_ref());\n681:         cur = lhs.as_ref();\n682:     }\n683:     stages.push(cur);\n684:     stages.reverse();\n685:     stages\n686: }\n687: \n688: /// A pipeline that does not fit breaks one stage per line, with `|` as the first character of\n689: /// every continuation line so the pipes line up in a vertical column (issue #101) -- unlike\n690: /// `Binary`'s trailing-operator rule, which a bare two-operand `Pipe` no longer follows.\n691: fn wrap_pipe(e: &Expr, indent: usize) -> String {\n692:     let stages = flatten_pipe(e);\n693:     let mut out = print_expr_wrapped(stages[0], Ctx::Expr(0), indent);\n694:     for stage in &stages[1..] {\n695:         // The stage's budget must include the two columns \"| \" occupies, or a stage that\n696:         // just fits alone overruns the line by exactly that prefix -- and a stage that\n697:         // wraps internally hangs its closing bracket left of its own opener.\n698:         let stage_str = print_expr_wrapped(stage, Ctx::Expr(PIPE_RIGHT), indent + INDENT + 2);\n699:         out.push('\\n');\n700:         out.push_str(&pad(indent + INDENT));\n701:         out.push_str(\"| \");\n702:         out.push_str(&stage_str);\n703:     }\n704:     out\n705: }\n706: \n707: fn wrap_match(arms: &[MatchArm], indent: usize) -> String {\n708:     let n = arms.len();\n709:     let mut parts = arms\n710:         .iter()\n711:         .enumerate()\n712:         .map(|(i, a)| print_match_arm(a, i + 1 == n));\n713:     let mut out = parts.next().expect(\"a match always has at least one arm\");\n714:     for p in parts {\n715:         out.push_str(\" or\\n\");\n716:         out.push_str(&pad(indent + INDENT));\n717:         out.push_str(&p);\n718:     }\n719:     out\n720: }\n721: \n722: /// Flattens a right-recursive `Cond` chain (`a if c else b if d else e`) into its branches and\n723: /// final default, the same shape `wrap_match` handles for an arm chain: `if`/`else` chains and\n724: /// `or` chains are printed identically for the reason described where each is called.\n725: fn flatten_cond(e: &Expr) -> (Vec<(&Expr, &Expr)>, &Expr) {\n726:     let mut branches = Vec::new();\n727:     let mut cur = e;\n728:     while let Expr::Cond {\n729:         then,\n730:         cond,\n731:         otherwise,\n732:         ..\n733:     } = cur\n734:     {\n735:         branches.push((then.as_ref(), cond.as_ref()));\n736:         cur = otherwise.as_ref();\n737:     }\n738:     (branches, cur)\n739: }\n740: \n741: fn wrap_cond(e: &Expr, m: u8, indent: usize) -> String {\n742:     let (branches, final_otherwise) = flatten_cond(e);\n743:     let mut lines: Vec<String> = branches\n744:         .iter()\n745:         .enumerate()\n746:         .map(|(i, (then, cond))| {\n747:             // The first branch's `then` sits wherever the whole `Cond` sits; every later branch\n748:             // is reached only through `Cond::otherwise`, so its own `then` sits wherever that\n749:             // tail does.\n750:             let then_m = if i == 0 { m } else { cond_tail(m) };\n751:             format!(\n752:                 \"{} if {} else\",\n753:                 print_expr_compact(then, Ctx::CondThen(then_m)),\n754:                 print_expr_compact(cond, Ctx::Operand(COND_POWER + 1))\n755:             )\n756:         })\n757:         .collect();\n758:     lines.push(print_expr_wrapped(\n759:         final_otherwise,\n760:         Ctx::Expr(cond_tail(m)),\n761:         indent + INDENT,\n762:     ));\n763: \n764:     let mut out = lines[0].clone();\n765:     for line in &lines[1..] {\n766:         out.push('\\n');\n767:         out.push_str(&pad(indent + INDENT));\n768:         out.push_str(line);\n769:     }\n770:     out\n771: }\n\n(End of file - total 771 lines)\n</content>","metadata":{"preview":"//! The formatter's own backend: re-renders a parsed file as toylang source, in one canonical\n//! style. Unlike the other `emit_*` backends this walks `ast::File`, not `tir::Program` -- a\n//! formatter has to work on a program that does not type-check, and it must not print the\n//! prelude that `prelude::inject` would otherwise splice in.\n//!\n//! Two things drive the design. First, minimal-but-correct parenthesization: the AST does not\n//! record which parens the source actually used, so every paren in the output is one this module\n//! decided it needed, by comparing a node's own operator power against the power the position it\n//! sits in requires -- the same table `parse.rs::infix_power` parses with, walked in reverse.\n//! Second, the maintainer's own sample (docs/examples/euler/01-multiples-of-3-and-5.md) is the\n//! only ground truth for layout: a function whose signature-plus-body fits on one line stays on\n//! one line; otherwise the body moves to its own indented line, and a binary chain that still\n//! does not fit breaks at its outermost operator, trailing the operator on the first line.\n//! Match-arm and conditional chains extend that same \"trailing operator, one extra indent\" rule\n//! by analogy, since nothing in the sample pins their layout directly. A pipeline that does not\n//! fit is the one exception: it breaks one stage per line, with `|` leading each continuation\n//! line so the pipes form a vertical column (maintainer directive, issue #101), rather than\n//! trailing like the other chains.\n//!\n//! Two style choices worth naming since nothing in the grammar forces them: calls are always","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-153/src/emit_toylang.rs","text":"//! The formatter's own backend: re-renders a parsed file as toylang source, in one canonical\n//! style. Unlike the other `emit_*` backends this walks `ast::File`, not `tir::Program` -- a\n//! formatter has to work on a program that does not type-check, and it must not print the\n//! prelude that `prelude::inject` would otherwise splice in.\n//!\n//! Two things drive the design. First, minimal-but-correct parenthesization: the AST does not\n//! record which parens the source actually used, so every paren in the output is one this module\n//! decided it needed, by comparing a node's own operator power against the power the position it\n//! sits in requires -- the same table `parse.rs::infix_power` parses with, walked in reverse.\n//! Second, the maintainer's own sample (docs/examples/euler/01-multiples-of-3-and-5.md) is the\n//! only ground truth for layout: a function whose signature-plus-body fits on one line stays on\n//! one line; otherwise the body moves to its own indented line, and a binary chain that still\n//! does not fit breaks at its outermost operator, trailing the operator on the first line.\n//! Match-arm and conditional chains extend that same \"trailing operator, one extra indent\" rule\n//! by analogy, since nothing in the sample pins their layout directly. A pipeline that does not\n//! fit is the one exception: it breaks one stage per line, with `|` leading each continuation\n//! line so the pipes form a vertical column (maintainer directive, issue #101), rather than\n//! trailing like the other chains.\n//!\n//! Two style choices worth naming since nothing in the grammar forces them: calls are always\n//! written with explicit parens (`f(x)`, never the bare `f x` or brace-shorthand `f{...}`),\n//! matching both calls in the sample; and the wrap width is 80 columns, backed out from the\n//! sample itself -- the one line it left alone is 44 columns, and the two it broke are 89 and\n//! 118.\n//!\n//! One thing the AST cannot carry: comments. `parse::parse` throws every `#...` away as trivia\n//! (`skip_trivia`), so `emit` alone can only ever produce a program with none. `format_source`\n//! covers the one shape that actually appears in this repository -- a file's leading banner,\n//! read back off the raw text rather than the tree -- and nothing else; a comment anywhere else\n//! does not survive formatting, which is why every fragment that puts one somewhere else is\n//! marked a syntax-spelling exception rather than swept.\n\nuse crate::ast::{\n    Alias, BinOp, Def, EnumDecl, Expr, FieldsPattern, File, LogicOp, MatchArm, Module, Param,\n    Pattern, TypeExpr, Variant,\n};\n\nconst WIDTH: usize = 80;\nconst INDENT: usize = 4;\n\n// Mirrors parse.rs's precedence table exactly (`infix_power`, `PIPE_LEFT`/`PIPE_RIGHT`,\n// `COND_POWER`, `OR_LEFT`/`OR_RIGHT`, `NOT_POWER`): the numbers a paren decision here has to\n// answer to are the parser's, not this module's own invention.\nconst PIPE_LEFT: u8 = 1;\nconst PIPE_RIGHT: u8 = 2;\nconst COND_POWER: u8 = 3;\nconst NOT_POWER: u8 = 8;\n\n/// A match arm's body is printed at a power just above `or`'s, which is how the parser's second\n/// reading of `or` -- the arm separator, which has no power at all -- reaches this table: a bare\n/// disjunction in an arm body is the one expression whose parens the powers alone would not ask\n/// for, and the one the parser would otherwise read as two arms.\nconst ARM_BODY: u8 = 5;\n\nfn bin_power(op: BinOp) -> (u8, u8) {\n    match op {\n        BinOp::Eq | BinOp::Ne | BinOp::Lt | BinOp::Le | BinOp::Gt | BinOp::Ge => (8, 9),\n        BinOp::Add | BinOp::Sub => (10, 11),\n        BinOp::Mul | BinOp::Div | BinOp::Rem => (12, 13),\n    }\n}\n\nfn logic_power(op: LogicOp) -> (u8, u8) {\n    match op {\n        LogicOp::Or => (4, 5),\n        LogicOp::And => (6, 7),\n    }\n}\n\n/// Where a conditional's `else` tail is printed: the same position the conditional itself sits\n/// in when that is an arm body (so `or` keeps reading as the separator all the way down the\n/// chain), and an ordinary `expr(COND_POWER)` position otherwise.\nfn cond_tail(m: u8) -> u8 {\n    if m == ARM_BODY { ARM_BODY } else { COND_POWER }\n}\n\n/// Where a child expression sits, in terms of what the parser would have accepted bare at that\n/// spot -- everything `needs_parens` and the wrapping printer need to know to reproduce the tree\n/// exactly, and nothing else.\n#[derive(Clone, Copy)]\nenum Ctx {\n    /// A fresh `self.expr(m)` call: File/Def body, a call argument (always real parens here, so\n    /// always reset to `Expr(0)` inside them), `Index`'s bracketed expression, a match arm's\n    /// body, or `Cond::otherwise`. The one context where a bare `Cond` and, when `m` is loose\n    /// enough, a bare `Pipe` or `Match` are all reachable.\n    Expr(u8),\n    /// A `self.operand(m)` call: a `Binary` child, or `Pattern::Guard`'s expression. `Cond`,\n    /// `Pipe`, and `Match` are never reachable bare here -- only `expr()` parses those.\n    Operand(u8),\n    /// `Cond::then`: built the same way as `Operand(m)`, except a `Match` is also reachable\n    /// (bare, when `m <= PIPE_RIGHT`) because it is built by the same call that would otherwise\n    /// have produced the `Operand(m)` result, before the `if` is even seen.\n    CondThen(u8),\n    /// The base of a postfix chain (`Field`/`Index`/`Project`/`Unwrap`), or a `Call`/`Variant`'s\n    /// argument print used only when NOT already inside real parens. Nothing compound is\n    /// reachable bare here -- not even `Neg`.\n    Atom,\n    /// `Neg`'s base: like `Atom`, except a nested `Neg` is reachable bare (`- -a`).\n    Unary,\n}\n\n/// The left binding power of whatever operator `e` is, for the three contexts that decide by\n/// power alone. `None` for everything else, which each context rules on by kind.\nfn left_power(e: &Expr) -> Option<u8> {\n    match e {\n        Expr::Binary { op, .. } => Some(bin_power(*op).0),\n        Expr::Logic { op, .. } => Some(logic_power(*op).0),\n        Expr::Not { .. } => Some(NOT_POWER),\n        _ => None,\n    }\n}\n\nfn needs_parens(e: &Expr, ctx: Ctx) -> bool {\n    // A `let` block is only ever a function body, never a sub-expression, so no child position\n    // can hold one; treating it as needing parens everywhere is the safe dead arm.\n    if matches!(e, Expr::Let { .. }) {\n        return true;\n    }\n    match ctx {\n        Ctx::Atom => matches!(\n            e,\n            Expr::Binary { .. }\n                | Expr::Logic { .. }\n                | Expr::Not { .. }\n                | Expr::Pipe { .. }\n                | Expr::Cond { .. }\n                | Expr::Match { .. }\n                | Expr::Neg { .. }\n        ),\n        Ctx::Unary => {\n            matches!(\n                e,\n                Expr::Binary { .. }\n                    | Expr::Logic { .. }\n                    | Expr::Not { .. }\n                    | Expr::Pipe { .. }\n                    | Expr::Cond { .. }\n                    | Expr::Match { .. }\n            )\n        }\n        Ctx::Operand(m) => match e {\n            Expr::Pipe { .. } | Expr::Cond { .. } | Expr::Match { .. } => true,\n            _ => left_power(e).is_some_and(|p| p < m),\n        },\n        Ctx::CondThen(m) => match e {\n            Expr::Match { .. } => m > PIPE_RIGHT,\n            Expr::Pipe { .. } | Expr::Cond { .. } => true,\n            _ => left_power(e).is_some_and(|p| p < m),\n        },\n        Ctx::Expr(m) => match e {\n            Expr::Pipe { .. } => PIPE_LEFT < m,\n            Expr::Match { .. } => m > PIPE_RIGHT,\n            _ => left_power(e).is_some_and(|p| p < m),\n        },\n    }\n}\n\nfn fits(s: &str, indent: usize) -> bool {\n    indent + s.chars().count() <= WIDTH\n}\n\nfn pad(n: usize) -> String {\n    \" \".repeat(n)\n}\n\npub fn emit(file: &File) -> String {\n    let mut out = String::new();\n    for decl in decls_in_source_order(&file.aliases, &file.enums, &file.defs) {\n        out.push_str(&decl);\n        out.push_str(\"\\n\\n\");\n    }\n    if let Some(ty) = &file.input {\n        out.push_str(&format!(\"input {}\\n\\n\", print_type(ty)));\n    }\n    out.push_str(&print_expr_wrapped(&file.body, Ctx::Expr(0), 0));\n    out.push('\\n');\n    out\n}\n\n/// A module is the declarations alone: no trailing expression to separate them from, so they end\n/// the file rather than each being followed by a blank line the way `emit` writes them.\npub fn emit_module(module: &Module) -> String {\n    let decls = decls_in_source_order(&[], &module.enums, &module.defs);\n    if decls.is_empty() {\n        return String::new();\n    }\n    format!(\"{}\\n\", decls.join(\"\\n\\n\"))\n}\n\n/// Every declaration rendered, back in the order it was written.\n///\n/// The AST groups declarations by kind, losing their interleaving in the source; sorting by span\n/// start puts them back, which is what makes the output idempotent -- reformatting an\n/// already-sorted file is a no-op re-sort.\nfn decls_in_source_order(aliases: &[Alias], enums: &[EnumDecl], defs: &[Def]) -> Vec<String> {\n    enum Item<'a> {\n        Alias(&'a Alias),\n        Enum(&'a EnumDecl),\n        Def(&'a Def),\n    }\n\n    let mut items: Vec<(usize, Item)> = Vec::new();\n    for a in aliases {\n        items.push((a.span.start, Item::Alias(a)));\n    }\n    for e in enums {\n        items.push((e.span.start, Item::Enum(e)));\n    }\n    for d in defs {\n        items.push((d.span.start, Item::Def(d)));\n    }\n    items.sort_by_key(|(start, _)| *start);\n\n    items\n        .iter()\n        .map(|(_, item)| match item {\n            Item::Alias(a) => print_alias(a),\n            Item::Enum(e) => print_enum(e),\n            Item::Def(d) => print_def(d),\n        })\n        .collect()\n}\n\n/// Parses `src` and formats it, then reattaches the one piece of source text `emit` cannot\n/// reconstruct from the tree: a leading run of `#` comment (and blank) lines, copied back\n/// verbatim ahead of the formatted body.\n///\n/// Two file shapes reach a formatter that walks a project: a program, and a module --\n/// declarations with no trailing expression, which `parse` rejects outright and which\n/// `prelude.toy` is the one instance of here. Which one a file is only shows up in the parsing,\n/// so both are tried. When neither parse succeeds, the error reported is whichever got further\n/// into the file, so a typo halfway down a module is not reported as a missing program body.\npub fn format_source(src: &str) -> Result<String, crate::error::Error> {\n    let banner = leading_comment(src);\n    let as_program = match crate::parse::parse(src) {\n        Ok(file) => return Ok(format!(\"{banner}{}\", emit(&file))),\n        Err(e) => e,\n    };\n    match crate::parse::parse_module(src) {\n        Ok(module) => Ok(format!(\"{banner}{}\", emit_module(&module))),\n        Err(as_module) if as_module.span.start > as_program.span.start => Err(as_module),\n        Err(_) => Err(as_program),\n    }\n}\n\nfn leading_comment(src: &str) -> String {\n    let mut banner = String::new();\n    for line in src.lines() {\n        let trimmed = line.trim_start();\n        if trimmed.starts_with('#') {\n            banner.push_str(line.trim_end());\n            banner.push('\\n');\n        } else if trimmed.is_empty() {\n            if banner.is_empty() {\n                continue;\n            }\n            break;\n        } else {\n            break;\n        }\n    }\n    banner\n}\n\nfn print_alias(a: &Alias) -> String {\n    format!(\"type {} = {}\", a.name, print_type(&a.ty))\n}\n\nfn print_param(p: &Option<Param>) -> String {\n    match p {\n        None => String::new(),\n        Some(p) => format!(\"{}: {}\", p.name, print_type(&p.ty)),\n    }\n}\n\nfn print_def(d: &Def) -> String {\n    let pub_prefix = if d.is_pub { \"pub \" } else { \"\" };\n    let sig = format!(\n        \"{pub_prefix}fn {}({}) -> {}\",\n        d.name,\n        print_param(&d.param),\n        print_type(&d.ret)\n    );\n    // A `let` block is line-structured, so it has no one-line form: the signature, then one\n    // `let` line per binding, then the value, each indented one level.\n    if let Expr::Let { bindings, body, .. } = &d.body {\n        let mut lines: Vec<String> = bindings\n            .iter()\n            .map(|(n, v)| format!(\"let {n} = {}\", print_expr_compact(v, Ctx::Expr(0))))\n            .collect();\n        lines.push(print_expr_wrapped(body, Ctx::Expr(0), INDENT));\n        let mut out = format!(\"{sig} =\\n\");\n        for line in lines {\n            out.push_str(&pad(INDENT));\n            out.push_str(&line);\n            out.push('\\n');\n        }\n        return out.trim_end().to_string();\n    }\n    let compact_body = print_expr_compact(&d.body, Ctx::Expr(0));\n    let one_line = format!(\"{sig} = {compact_body}\");\n    if fits(&one_line, 0) {\n        return one_line;\n    }\n    let body = print_expr_wrapped(&d.body, Ctx::Expr(0), INDENT);\n    format!(\"{sig} =\\n{}{body}\", pad(INDENT))\n}\n\nfn print_variant_decl(v: &Variant) -> String {\n    match &v.payload {\n        None => v.name.clone(),\n        Some(TypeExpr::Record { fields, .. }) => {\n            let fields_str = fields\n                .iter()\n                .map(|(n, t)| format!(\"{n}: {}\", print_type(t)))\n                .collect::<Vec<_>>()\n                .join(\", \");\n            format!(\"{}{{{fields_str}}}\", v.name)\n        }\n        Some(t) => format!(\"{}({})\", v.name, print_type(t)),\n    }\n}\n\nfn print_enum(e: &EnumDecl) -> String {\n    let pub_prefix = if e.is_pub { \"pub \" } else { \"\" };\n    let params = if e.params.is_empty() {\n        String::new()\n    } else {\n        let names: Vec<&str> = e.params.iter().map(|(n, _)| n.as_str()).collect();\n        format!(\"<{}>\", names.join(\", \"))\n    };\n    let head = format!(\"{pub_prefix}enum {}{params}\", e.name);\n    let variants: Vec<String> = e.variants.iter().map(print_variant_decl).collect();\n    if variants.is_empty() {\n        return format!(\"{head} {{}}\");\n    }\n    let compact = format!(\"{head} {{ {} }}\", variants.join(\", \"));\n    if fits(&compact, 0) {\n        return compact;\n    }\n    format!(\"{head} {}\", wrap_delim(\"{\", &variants, \"}\", 0))\n}\n\nfn print_type(t: &TypeExpr) -> String {\n    match t {\n        TypeExpr::Named { name, args, .. } => {\n            if args.is_empty() {\n                name.clone()\n            } else {\n                let args_str = args.iter().map(print_type).collect::<Vec<_>>().join(\", \");\n                format!(\"{name}<{args_str}>\")\n            }\n        }\n        TypeExpr::Vec { elem, .. } => format!(\"Vec<{}>\", print_type(elem)),\n        TypeExpr::Stream { elem, .. } => format!(\"Stream<{}>\", print_type(elem)),\n        TypeExpr::Record { fields, .. } => {\n            let fields_str = fields\n                .iter()\n                .map(|(n, t)| format!(\"{n}: {}\", print_type(t)))\n                .collect::<Vec<_>>()\n                .join(\", \");\n            format!(\"{{{fields_str}}}\")\n        }\n    }\n}\n\n/// A closing delimiter's list never accepts a trailing comma (every list-parser in `parse.rs`\n/// tries to read one more item right after a comma, with no check for an immediate close), so a\n/// broken list must never write one before `close`.\nfn wrap_delim(open: &str, items: &[String], close: &str, indent: usize) -> String {\n    if items.is_empty() {\n        return format!(\"{open}{close}\");\n    }\n    let inner = indent + INDENT;\n    let mut out = format!(\"{open}\\n\");\n    for (i, item) in items.iter().enumerate() {\n        out.push_str(&pad(inner));\n        out.push_str(item);\n        if i + 1 < items.len() {\n            out.push(',');\n        }\n        out.push('\\n');\n    }\n    out.push_str(&pad(indent));\n    out.push_str(close);\n    out\n}\n\nfn escape_str(s: &str) -> String {\n    let mut out = String::with_capacity(s.len());\n    for c in s.chars() {\n        match c {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            _ => out.push(c),\n        }\n    }\n    out\n}\n\n/// The base of a postfix chain (`Field`/`Index`/`Project`/`Unwrap`): only reachable bare via\n/// `atom()`, so a compound child always needs parens there.\nfn print_atom_base(base: &Expr) -> String {\n    print_expr_compact(base, Ctx::Atom)\n}\n\n/// A `Call`/`Variant` argument is always printed inside real parens this module writes itself\n/// (see the module doc), so the content resets to a fresh `Expr(0)` position.\nfn print_paren_arg(e: &Expr) -> String {\n    print_expr_compact(e, Ctx::Expr(0))\n}\n\nfn print_expr_compact(e: &Expr, ctx: Ctx) -> String {\n    if needs_parens(e, ctx) {\n        return format!(\"({})\", print_expr_inner(e, ctx));\n    }\n    print_expr_inner(e, ctx)\n}\n\n/// The outer parens decision (`needs_parens`) has already been made by `print_expr_compact`;\n/// `ctx` is threaded in only for `Cond::then`, which is the one child position whose available\n/// bare kinds depend on where the *whole* `Cond` sits. Every other child position is fixed by\n/// its own node (a `Binary`'s own operator powers, `Pipe`'s hard-coded `PIPE_RIGHT`, and so on),\n/// independent of `ctx`.\nfn print_expr_inner(e: &Expr, ctx: Ctx) -> String {\n    match e {\n        Expr::Str { text, .. } => format!(\"\\\"{}\\\"\", escape_str(text)),\n        Expr::Int { value, .. } => value.to_string(),\n        Expr::VecLit { items, .. } => {\n            let items_str = items\n                .iter()\n                .map(print_paren_arg)\n                .collect::<Vec<_>>()\n                .join(\", \");\n            format!(\"[{items_str}]\")\n        }\n        Expr::RecordLit { fields, .. } => format!(\"{{{}}}\", print_record_fields(fields)),\n        Expr::Subject { .. } => \".\".to_string(),\n        Expr::Var { name, .. } => name.clone(),\n        Expr::Call { func, arg, .. } => match arg {\n            None => format!(\"{func}()\"),\n            Some(a) => format!(\"{func}({})\", print_paren_arg(a)),\n        },\n        Expr::Project { base, .. } => format!(\"{}[]\", print_atom_base(base)),\n        Expr::Index { base, index, .. } => {\n            format!(\"{}[{}]\", print_atom_base(base), print_paren_arg(index))\n        }\n        Expr::Slice { base, start, end, .. } => {\n            let lo = match start {\n                Some(s) => print_paren_arg(s),\n                None => String::new(),\n            };\n            let hi = match end {\n                Some(e) => print_paren_arg(e),\n                None => String::new(),\n            };\n            format!(\"{}[{lo}:{hi}]\", print_atom_base(base))\n        }\n        Expr::Unwrap { base, .. } => format!(\"{}!\", print_atom_base(base)),\n        Expr::Neg { base, .. } => format!(\"-{}\", print_expr_compact(base, Ctx::Unary)),\n        // `not x`, not `not(x)`: this is an operator, and the parens spelling would read as the\n        // call it is not. What follows is printed at `not`'s own power, so `not a == b` keeps\n        // the parens off the comparison the parser would give it back.\n        Expr::Not { base, .. } => {\n            format!(\"not {}\", print_expr_compact(base, Ctx::Operand(NOT_POWER)))\n        }\n        Expr::Cond {\n            then,\n            cond,\n            otherwise,\n            ..\n        } => {\n            let m = outer_m(ctx);\n            format!(\n                \"{} if {} else {}\",\n                print_expr_compact(then, Ctx::CondThen(m)),\n                print_expr_compact(cond, Ctx::Operand(COND_POWER + 1)),\n                print_expr_compact(otherwise, Ctx::Expr(cond_tail(m)))\n            )\n        }\n        Expr::Field { base, name, .. } => {\n            let base_str = print_atom_base(base);\n            if base_str == \".\" {\n                format!(\".{name}\")\n            } else {\n                format!(\"{base_str}.{name}\")\n            }\n        }\n        Expr::Input { .. } => \"input\".to_string(),\n        Expr::Inputs { .. } => \"inputs\".to_string(),\n        Expr::Lines { .. } => \"lines\".to_string(),\n        // `csv`/`tsv` are parser sugar, so the canonical spelling is the parameterized form.\n        Expr::Dsv { delim, .. } => format!(\"dsv(\\\"{}\\\")\", escape_str(delim)),\n        Expr::Variant {\n            enum_name,\n            variant,\n            payload,\n            ..\n        } => match payload {\n            None => format!(\"{enum_name}.{variant}\"),\n            Some(p) => format!(\"{enum_name}.{variant}({})\", print_paren_arg(p)),\n        },\n        Expr::Match { arms, .. } => arms\n            .iter()\n            .enumerate()\n            .map(|(i, a)| print_match_arm(a, i + 1 == arms.len()))\n            .collect::<Vec<_>>()\n            .join(\" or \"),\n        Expr::Pipe { lhs, rhs, .. } => {\n            // `Pipe.lhs` accumulates the same way a `Binary` chain does (`a | b | c` folds\n            // left, exactly like `a - b - c`), so a nested `Pipe` there reproduces itself with\n            // no parens needed, the same as any other `Ctx::Expr(0)` position. Only `rhs` -- a\n            // genuinely fresh `expr(PIPE_RIGHT)` call -- can force parens on a nested `Pipe`.\n            format!(\n                \"{} | {}\",\n                print_expr_compact(lhs, Ctx::Expr(0)),\n                print_expr_compact(rhs, Ctx::Expr(PIPE_RIGHT))\n            )\n        }\n        Expr::Binary { op, lhs, rhs, .. } => {\n            let (left, right) = bin_power(*op);\n            format!(\n                \"{} {op} {}\",\n                print_expr_compact(lhs, Ctx::Operand(left)),\n                print_expr_compact(rhs, Ctx::Operand(right))\n            )\n        }\n        Expr::Logic { op, lhs, rhs, .. } => {\n            let (left, right) = logic_power(*op);\n            format!(\n                \"{} {op} {}\",\n                print_expr_compact(lhs, Ctx::Operand(left)),\n                print_expr_compact(rhs, Ctx::Operand(right))\n            )\n        }\n        // `print_def` emits a `let` block before reaching this match; a `Let` here is a\n        // nested one the parser never produces (the block form is only a function body).\n        Expr::Let { .. } => unreachable!(\"a `let` block is only ever a function body\"),\n    }\n}\n\nfn outer_m(ctx: Ctx) -> u8 {\n    match ctx {\n        Ctx::Expr(m) | Ctx::Operand(m) | Ctx::CondThen(m) => m,\n        Ctx::Atom | Ctx::Unary => 0,\n    }\n}\n\nfn print_record_fields(fields: &[(String, crate::ast::Span, Expr)]) -> String {\n    fields\n        .iter()\n        .map(|(n, _, v)| format!(\"{n}: {}\", print_paren_arg(v)))\n        .collect::<Vec<_>>()\n        .join(\", \")\n}\n\nfn print_fields_pattern(f: &FieldsPattern) -> String {\n    let names: Vec<&str> = f.names.iter().map(|(n, _)| n.as_str()).collect();\n    if f.rest {\n        if names.is_empty() {\n            \"..\".to_string()\n        } else {\n            format!(\"{}, ..\", names.join(\", \"))\n        }\n    } else {\n        names.join(\", \")\n    }\n}\n\n/// A `Default` pattern comes from either an explicit `any()` or a bare trailing expression --\n/// indistinguishable in the AST except that the bare form's span is exactly its body's span\n/// (`parse.rs::guard_or_default_arm`). Printing bare whenever that holds and the arm is last\n/// (the only place a bare default is legal) reproduces the shorter, and by construction always\n/// idempotent, spelling; every other `Default` prints the explicit `any()` it must have been.\nfn print_match_arm(arm: &MatchArm, is_last: bool) -> String {\n    let body = print_expr_compact(&arm.body, Ctx::Expr(ARM_BODY));\n    match &arm.pattern {\n        Pattern::Default { span } if is_last && *span == arm.body.span() => body,\n        Pattern::Default { .. } => format!(\"any() -> {body}\"),\n        Pattern::Guard(g) => format!(\n            \"{} -> {body}\",\n            print_expr_compact(g, Ctx::Operand(COND_POWER))\n        ),\n        Pattern::Variant { name, fields, .. } => {\n            let head = match fields {\n                None => name.clone(),\n                Some(f) => format!(\"{name}{{{}}}\", print_fields_pattern(f)),\n            };\n            format!(\"{head} -> {body}\")\n        }\n    }\n}\n\n/// Tries the compact form first; when it does not fit at `indent`, breaks the node at its own\n/// natural seam (an operator, an arm, a delimited list) rather than leaving it overlong. Falls\n/// back to the (overlong) compact form for node kinds with no seam to break at -- accepted\n/// overflow, not a correctness problem, since every backend agrees on lines it never sees.\nfn print_expr_wrapped(e: &Expr, ctx: Ctx, indent: usize) -> String {\n    let compact = print_expr_compact(e, ctx);\n    if fits(&compact, indent) {\n        return compact;\n    }\n    if needs_parens(e, ctx) {\n        let inner = print_expr_wrapped(e, Ctx::Expr(0), indent + INDENT);\n        return format!(\"(\\n{}{inner}\\n{})\", pad(indent + INDENT), pad(indent));\n    }\n    match e {\n        Expr::Binary { op, lhs, rhs, .. } => {\n            let (left, right) = bin_power(*op);\n            let lhs_str = print_expr_wrapped(lhs, Ctx::Operand(left), indent);\n            let rhs_str = print_expr_wrapped(rhs, Ctx::Operand(right), indent + INDENT);\n            format!(\"{lhs_str} {op}\\n{}{rhs_str}\", pad(indent + INDENT))\n        }\n        Expr::Logic { op, lhs, rhs, .. } => {\n            let (left, right) = logic_power(*op);\n            let lhs_str = print_expr_wrapped(lhs, Ctx::Operand(left), indent);\n            let rhs_str = print_expr_wrapped(rhs, Ctx::Operand(right), indent + INDENT);\n            format!(\"{lhs_str} {op}\\n{}{rhs_str}\", pad(indent + INDENT))\n        }\n        Expr::Not { base, .. } => format!(\n            \"not {}\",\n            print_expr_wrapped(base, Ctx::Operand(NOT_POWER), indent)\n        ),\n        Expr::Pipe { .. } => wrap_pipe(e, indent),\n        Expr::Match { arms, .. } => wrap_match(arms, indent),\n        Expr::Cond { .. } => wrap_cond(e, outer_m(ctx), indent),\n        Expr::VecLit { items, .. } => {\n            let rendered: Vec<String> = items\n                .iter()\n                .map(|i| print_expr_wrapped(i, Ctx::Expr(0), indent + INDENT))\n                .collect();\n            wrap_delim(\"[\", &rendered, \"]\", indent)\n        }\n        Expr::RecordLit { fields, .. } => {\n            let rendered: Vec<String> = fields\n                .iter()\n                .map(|(n, _, v)| {\n                    format!(\n                        \"{n}: {}\",\n                        print_expr_wrapped(v, Ctx::Expr(0), indent + INDENT)\n                    )\n                })\n                .collect();\n            wrap_delim(\"{\", &rendered, \"}\", indent)\n        }\n        Expr::Call {\n            func, arg: Some(a), ..\n        } => {\n            let item = print_expr_wrapped(a, Ctx::Expr(0), indent + INDENT);\n            format!(\"{func}{}\", wrap_delim(\"(\", &[item], \")\", indent))\n        }\n        Expr::Variant {\n            enum_name,\n            variant,\n            payload: Some(p),\n            ..\n        } => {\n            let item = print_expr_wrapped(p, Ctx::Expr(0), indent + INDENT);\n            format!(\n                \"{enum_name}.{variant}{}\",\n                wrap_delim(\"(\", &[item], \")\", indent)\n            )\n        }\n        Expr::Neg { base, .. } => format!(\"-{}\", print_expr_wrapped(base, Ctx::Unary, indent)),\n        // No natural seam to break at (`Var`, `Call`/`Variant` with no argument, a projection or\n        // field chain, and so on): the compact form already computed above is the best available.\n        _ => compact,\n    }\n}\n\n/// Flattens a left-recursive `Pipe` chain (`a | b | c` parses as `(a | b) | c`, the same fold\n/// `Binary` chains use) into its stages in source order.\nfn flatten_pipe(e: &Expr) -> Vec<&Expr> {\n    let mut stages = Vec::new();\n    let mut cur = e;\n    while let Expr::Pipe { lhs, rhs, .. } = cur {\n        stages.push(rhs.as_ref());\n        cur = lhs.as_ref();\n    }\n    stages.push(cur);\n    stages.reverse();\n    stages\n}\n\n/// A pipeline that does not fit breaks one stage per line, with `|` as the first character of\n/// every continuation line so the pipes line up in a vertical column (issue #101) -- unlike\n/// `Binary`'s trailing-operator rule, which a bare two-operand `Pipe` no longer follows.\nfn wrap_pipe(e: &Expr, indent: usize) -> String {\n    let stages = flatten_pipe(e);\n    let mut out = print_expr_wrapped(stages[0], Ctx::Expr(0), indent);\n    for stage in &stages[1..] {\n        // The stage's budget must include the two columns \"| \" occupies, or a stage that\n        // just fits alone overruns the line by exactly that prefix -- and a stage that\n        // wraps internally hangs its closing bracket left of its own opener.\n        let stage_str = print_expr_wrapped(stage, Ctx::Expr(PIPE_RIGHT), indent + INDENT + 2);\n        out.push('\\n');\n        out.push_str(&pad(indent + INDENT));\n        out.push_str(\"| \");\n        out.push_str(&stage_str);\n    }\n    out\n}\n\nfn wrap_match(arms: &[MatchArm], indent: usize) -> String {\n    let n = arms.len();\n    let mut parts = arms\n        .iter()\n        .enumerate()\n        .map(|(i, a)| print_match_arm(a, i + 1 == n));\n    let mut out = parts.next().expect(\"a match always has at least one arm\");\n    for p in parts {\n        out.push_str(\" or\\n\");\n        out.push_str(&pad(indent + INDENT));\n        out.push_str(&p);\n    }\n    out\n}\n\n/// Flattens a right-recursive `Cond` chain (`a if c else b if d else e`) into its branches and\n/// final default, the same shape `wrap_match` handles for an arm chain: `if`/`else` chains and\n/// `or` chains are printed identically for the reason described where each is called.\nfn flatten_cond(e: &Expr) -> (Vec<(&Expr, &Expr)>, &Expr) {\n    let mut branches = Vec::new();\n    let mut cur = e;\n    while let Expr::Cond {\n        then,\n        cond,\n        otherwise,\n        ..\n    } = cur\n    {\n        branches.push((then.as_ref(), cond.as_ref()));\n        cur = otherwise.as_ref();\n    }\n    (branches, cur)\n}\n\nfn wrap_cond(e: &Expr, m: u8, indent: usize) -> String {\n    let (branches, final_otherwise) = flatten_cond(e);\n    let mut lines: Vec<String> = branches\n        .iter()\n        .enumerate()\n        .map(|(i, (then, cond))| {\n            // The first branch's `then` sits wherever the whole `Cond` sits; every later branch\n            // is reached only through `Cond::otherwise`, so its own `then` sits wherever that\n            // tail does.\n            let then_m = if i == 0 { m } else { cond_tail(m) };\n            format!(\n                \"{} if {} else\",\n                print_expr_compact(then, Ctx::CondThen(then_m)),\n                print_expr_compact(cond, Ctx::Operand(COND_POWER + 1))\n            )\n        })\n        .collect();\n    lines.push(print_expr_wrapped(\n        final_otherwise,\n        Ctx::Expr(cond_tail(m)),\n        indent + INDENT,\n    ));\n\n    let mut out = lines[0].clone();\n    for line in &lines[1..] {\n        out.push('\\n');\n        out.push_str(&pad(indent + INDENT));\n        out.push_str(line);\n    }\n    out\n}","lineStart":1,"lineEnd":771,"totalLines":771,"truncated":false}},"title":"src/emit_toylang.rs","time":{"start":1788292028210,"end":1788292028218}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me look at the emit_toylang.rs to understand the formatter, since I'll need to update it to emit the `;`terminator.","format":"unknown","index":0}]}},"id":"prt_05e82d68d001aVNtDCTADLMVl2","sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","messageID":"msg_05e82d142001zMG9Cww6l5kczB"}}
