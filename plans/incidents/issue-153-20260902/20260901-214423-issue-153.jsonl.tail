{"type":"tool_use","timestamp":1788292031958,"sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","part":{"type":"tool","tool":"read","callID":"call_01a05e82e4b07e41b35c9fa2","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-153/tests/bare_application.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-153/tests/bare_application.rs</path>\n<type>file</type>\n<content>\n1: //! Bare (parenless) application: `f x` reads as `f(x)`, and it is the default calling style,\n2: //! with `f(x)` as the explicit disambiguator. One rule confines it: an argument -- bare or\n3: //! delimited -- must start on the same line as its function, which is what keeps a\n4: //! definition's trailing identifier from swallowing the program body that follows it.\n5: \n6: #[track_caller]\n7: fn err(src: &str) -> String {\n8:     toylang::compile(src).map(|_| ()).unwrap_err().to_string()\n9: }\n10: \n11: #[test]\n12: fn matches_the_parenthesized_form() {\n13:     assert_eq!(\n14:         toylang::run(\"str 5\").unwrap(),\n15:         toylang::run(\"str(5)\").unwrap()\n16:     );\n17: }\n18: \n19: /// Right-recursive, so `f g x` is `f(g(x))` rather than needing `f(g(x))` spelled with parens.\n20: #[test]\n21: fn chains_right_to_left() {\n22:     let chained = \"fn inc(n: Int) -> Int = n + 1\\n\\nstr inc 5\";\n23:     let parenthesized = \"fn inc(n: Int) -> Int = n + 1\\n\\nstr(inc(5))\";\n24:     assert_eq!(\n25:         toylang::run(chained).unwrap(),\n26:         toylang::run(parenthesized).unwrap()\n27:     );\n28: }\n29: \n30: /// A bare call is an ordinary atom, so it composes inside larger expressions: the argument is\n31: /// a postfix chain, and an infix operator after it belongs to the enclosing expression, making\n32: /// `1 + inc 2 + inc 3` read `(1 + inc(2)) + inc(3)`.\n33: #[test]\n34: fn composes_with_operators() {\n35:     let src = \"fn inc(n: Int) -> Int = n + 1\\n\\n1 + inc 2 + inc 3\";\n36:     assert_eq!(toylang::run(src).unwrap(), \"8\\n\");\n37: }\n38: \n39: /// The definition-body suspension is gone: `= length v` is a call, and the same-line rule is\n40: /// what keeps the definition boundary safe instead.\n41: #[test]\n42: fn a_definition_body_may_end_in_a_bare_call() {\n43:     let src = \"fn size(v: Vec<Int>) -> Int = length v\\n\\nsize([1, 2, 3])\";\n44:     assert_eq!(toylang::run(src).unwrap(), \"3\\n\");\n45: }\n46: \n47: /// An argument on the line below its function is not an argument -- that reading is what let a\n48: /// definition's body swallow the program's -- and the leftover token's error says how to spell\n49: /// the call across lines.\n50: #[test]\n51: fn a_cross_line_argument_is_rejected_naming_the_parens_spelling() {\n52:     insta::assert_snapshot!(err(\"fn inc(n: Int) -> Int = n + 1\\n\\ninc\\n1\"));\n53: }\n54: \n55: /// `-` is already subtraction, so `f -1` stays `f - 1` rather than `f` applied to `-1` -- the\n56: /// same resolution Haskell gives the identical clash. `f` is then a function where a value is\n57: /// needed, and the error says that instead of claiming the name is undefined.\n58: #[test]\n59: fn a_trailing_minus_is_subtraction_not_negation() {\n60:     insta::assert_snapshot!(err(\"fn f(n: Int) -> Int = n\\n\\nf -1\"));\n61: }\n62: \n63: /// Projection binds tighter than bare application everywhere, so `map .n` is a field access on\n64: /// `map` -- a function where a value is needed -- and passing a projection as an argument takes\n65: /// the parens spelling, `map(.n)`.\n66: #[test]\n67: fn projection_wins_over_bare_application() {\n68:     insta::assert_snapshot!(err(\"[{n: 1}] | map .n\"));\n69: }\n70: \n71: /// `select` and `map` carry no dedicated syntax any more: they are ordinary calls, checked by\n72: /// name inside `Call`, and so are reserved the same way every other builtin is.\n73: #[test]\n74: fn select_and_map_cannot_be_redefined() {\n75:     insta::assert_snapshot!(err(\"fn select(x: Int) -> Int = x\\n\\n1\"));\n76:     insta::assert_snapshot!(err(\"fn map(x: Int) -> Int = x\\n\\n1\"));\n77: }\n78: \n79: /// A definition's body and whatever follows it -- another `fn`, or the file's own body -- sit\n80: /// adjacent with no token between them, the one place two `expr` parses meet without a delimiter\n81: /// to anchor on. The same-line rule is what keeps a trailing bare identifier in a body from\n82: /// reaching across that boundary and swallowing the next definition or the program's body.\n83: #[test]\n84: fn a_function_body_does_not_swallow_what_follows_it() {\n85:     assert_eq!(\n86:         toylang::run(\"fn f(x: Int) -> Int = x\\n\\nf(1)\").unwrap(),\n87:         \"1\\n\"\n88:     );\n89: }\n90: \n91: /// The rule covers the parenthesized argument too -- a reach across the boundary the old\n92: /// suspension flag never gated, since it only ever switched the bare form off.\n93: #[test]\n94: fn a_parenthesized_program_body_is_not_swallowed() {\n95:     assert_eq!(\n96:         toylang::run(\"fn f(x: Int) -> Int = x\\n\\n(1 + 2)\").unwrap(),\n97:         \"3\\n\"\n98:     );\n99: }\n\n(End of file - total 99 lines)\n</content>","metadata":{"preview":"//! Bare (parenless) application: `f x` reads as `f(x)`, and it is the default calling style,\n//! with `f(x)` as the explicit disambiguator. One rule confines it: an argument -- bare or\n//! delimited -- must start on the same line as its function, which is what keeps a\n//! definition's trailing identifier from swallowing the program body that follows it.\n\n#[track_caller]\nfn err(src: &str) -> String {\n    toylang::compile(src).map(|_| ()).unwrap_err().to_string()\n}\n\n#[test]\nfn matches_the_parenthesized_form() {\n    assert_eq!(\n        toylang::run(\"str 5\").unwrap(),\n        toylang::run(\"str(5)\").unwrap()\n    );\n}\n\n/// Right-recursive, so `f g x` is `f(g(x))` rather than needing `f(g(x))` spelled with parens.\n#[test]","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-153/tests/bare_application.rs","text":"//! Bare (parenless) application: `f x` reads as `f(x)`, and it is the default calling style,\n//! with `f(x)` as the explicit disambiguator. One rule confines it: an argument -- bare or\n//! delimited -- must start on the same line as its function, which is what keeps a\n//! definition's trailing identifier from swallowing the program body that follows it.\n\n#[track_caller]\nfn err(src: &str) -> String {\n    toylang::compile(src).map(|_| ()).unwrap_err().to_string()\n}\n\n#[test]\nfn matches_the_parenthesized_form() {\n    assert_eq!(\n        toylang::run(\"str 5\").unwrap(),\n        toylang::run(\"str(5)\").unwrap()\n    );\n}\n\n/// Right-recursive, so `f g x` is `f(g(x))` rather than needing `f(g(x))` spelled with parens.\n#[test]\nfn chains_right_to_left() {\n    let chained = \"fn inc(n: Int) -> Int = n + 1\\n\\nstr inc 5\";\n    let parenthesized = \"fn inc(n: Int) -> Int = n + 1\\n\\nstr(inc(5))\";\n    assert_eq!(\n        toylang::run(chained).unwrap(),\n        toylang::run(parenthesized).unwrap()\n    );\n}\n\n/// A bare call is an ordinary atom, so it composes inside larger expressions: the argument is\n/// a postfix chain, and an infix operator after it belongs to the enclosing expression, making\n/// `1 + inc 2 + inc 3` read `(1 + inc(2)) + inc(3)`.\n#[test]\nfn composes_with_operators() {\n    let src = \"fn inc(n: Int) -> Int = n + 1\\n\\n1 + inc 2 + inc 3\";\n    assert_eq!(toylang::run(src).unwrap(), \"8\\n\");\n}\n\n/// The definition-body suspension is gone: `= length v` is a call, and the same-line rule is\n/// what keeps the definition boundary safe instead.\n#[test]\nfn a_definition_body_may_end_in_a_bare_call() {\n    let src = \"fn size(v: Vec<Int>) -> Int = length v\\n\\nsize([1, 2, 3])\";\n    assert_eq!(toylang::run(src).unwrap(), \"3\\n\");\n}\n\n/// An argument on the line below its function is not an argument -- that reading is what let a\n/// definition's body swallow the program's -- and the leftover token's error says how to spell\n/// the call across lines.\n#[test]\nfn a_cross_line_argument_is_rejected_naming_the_parens_spelling() {\n    insta::assert_snapshot!(err(\"fn inc(n: Int) -> Int = n + 1\\n\\ninc\\n1\"));\n}\n\n/// `-` is already subtraction, so `f -1` stays `f - 1` rather than `f` applied to `-1` -- the\n/// same resolution Haskell gives the identical clash. `f` is then a function where a value is\n/// needed, and the error says that instead of claiming the name is undefined.\n#[test]\nfn a_trailing_minus_is_subtraction_not_negation() {\n    insta::assert_snapshot!(err(\"fn f(n: Int) -> Int = n\\n\\nf -1\"));\n}\n\n/// Projection binds tighter than bare application everywhere, so `map .n` is a field access on\n/// `map` -- a function where a value is needed -- and passing a projection as an argument takes\n/// the parens spelling, `map(.n)`.\n#[test]\nfn projection_wins_over_bare_application() {\n    insta::assert_snapshot!(err(\"[{n: 1}] | map .n\"));\n}\n\n/// `select` and `map` carry no dedicated syntax any more: they are ordinary calls, checked by\n/// name inside `Call`, and so are reserved the same way every other builtin is.\n#[test]\nfn select_and_map_cannot_be_redefined() {\n    insta::assert_snapshot!(err(\"fn select(x: Int) -> Int = x\\n\\n1\"));\n    insta::assert_snapshot!(err(\"fn map(x: Int) -> Int = x\\n\\n1\"));\n}\n\n/// A definition's body and whatever follows it -- another `fn`, or the file's own body -- sit\n/// adjacent with no token between them, the one place two `expr` parses meet without a delimiter\n/// to anchor on. The same-line rule is what keeps a trailing bare identifier in a body from\n/// reaching across that boundary and swallowing the next definition or the program's body.\n#[test]\nfn a_function_body_does_not_swallow_what_follows_it() {\n    assert_eq!(\n        toylang::run(\"fn f(x: Int) -> Int = x\\n\\nf(1)\").unwrap(),\n        \"1\\n\"\n    );\n}\n\n/// The rule covers the parenthesized argument too -- a reach across the boundary the old\n/// suspension flag never gated, since it only ever switched the bare form off.\n#[test]\nfn a_parenthesized_program_body_is_not_swallowed() {\n    assert_eq!(\n        toylang::run(\"fn f(x: Int) -> Int = x\\n\\n(1 + 2)\").unwrap(),\n        \"3\\n\"\n    );\n}","lineStart":1,"lineEnd":99,"totalLines":99,"truncated":false}},"title":"tests/bare_application.rs","time":{"start":1788292031946,"end":1788292031956}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05e82e54a001Qceuker2YAobGl","sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","messageID":"msg_05e82e0d1001YlZVvCxQEEUerW"}}
