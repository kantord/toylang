{"type":"tool_use","timestamp":1788292019289,"sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","part":{"type":"tool","tool":"read","callID":"call_581e4c551ae34165bac19b46","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-153/tests/fmt_examples.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-153/tests/fmt_examples.rs</path>\n<type>file</type>\n<content>\n1: //! The sweep harness: every `examples/*.toy` file, and every `toylang` fence under `docs/`, is\n2: //! required to already be in `toylang fmt`'s canonical form -- checked here so a hand-edited\n3: //! example cannot drift from what a real user would get by running the formatter on it.\n4: //!\n5: //! Two escapes, both narrow on purpose. A fragment that does not parse at all (`docs/tutorial/\n6: //! 06-matching.md`'s deliberately malformed default-arm example) has nothing for `fmt` to\n7: //! canonicalize, so it is skipped rather than failed. A fragment that exists specifically to\n8: //! show a spelling the canonical style does not use -- bare application, the brace-call\n9: //! shorthand -- opens with the exact line `# fmt: syntax-example`, checked for as plain text\n10: //! before parsing (a marker, not a directive `fmt` itself understands); reformatting it would\n11: //! erase the very thing the surrounding prose is pointing at. As of this writing there are three:\n12: //! `docs/reference/syntax/functions.md`, `docs/tutorial/02-records.md`, and\n13: //! `docs/tutorial/04-enums.md`.\n14: \n15: use std::path::{Path, PathBuf};\n16: \n17: /// Plain text, not a `fmt`-recognized directive: this file is the only reader of it.\n18: const EXEMPT_MARKER: &str = \"# fmt: syntax-example\";\n19: \n20: #[test]\n21: fn every_example_file_is_already_formatted() {\n22:     let mut checked = 0;\n23:     let mut failures = Vec::new();\n24: \n25:     let dir = repo_root().join(\"examples\");\n26:     let mut paths: Vec<PathBuf> = std::fs::read_dir(&dir)\n27:         .unwrap_or_else(|e| panic!(\"cannot read {}: {e}\", dir.display()))\n28:         .map(|e| e.expect(\"readable entry\").path())\n29:         .filter(|p| p.extension().is_some_and(|e| e == \"toy\"))\n30:         .collect();\n31:     paths.sort();\n32: \n33:     for path in paths {\n34:         let src =\n35:             std::fs::read_to_string(&path).unwrap_or_else(|e| panic!(\"{}: {e}\", path.display()));\n36:         checked += 1;\n37:         check_formatted(&path.display().to_string(), &src, &mut failures);\n38:     }\n39: \n40:     assert!(\n41:         checked > 0,\n42:         \"found no examples/*.toy files, so this test proves nothing\"\n43:     );\n44:     report(checked, &failures);\n45: }\n46: \n47: #[test]\n48: fn every_docs_fragment_is_already_formatted() {\n49:     let mut checked = 0;\n50:     let mut failures = Vec::new();\n51: \n52:     let mut pages = Vec::new();\n53:     walk(&repo_root().join(\"docs\"), &mut pages);\n54:     pages.sort();\n55: \n56:     for page in pages {\n57:         let text =\n58:             std::fs::read_to_string(&page).unwrap_or_else(|e| panic!(\"{}: {e}\", page.display()));\n59:         let rel = page\n60:             .strip_prefix(repo_root())\n61:             .expect(\"under the repo\")\n62:             .to_string_lossy()\n63:             .into_owned();\n64:         for (line, body) in toylang_fences(&text) {\n65:             checked += 1;\n66:             check_formatted(&format!(\"{rel}:{line}\"), &body, &mut failures);\n67:         }\n68:     }\n69: \n70:     assert!(\n71:         checked > 0,\n72:         \"found no toylang fences under docs/, so this test proves nothing\"\n73:     );\n74:     report(checked, &failures);\n75: }\n76: \n77: fn check_formatted(at: &str, src: &str, failures: &mut Vec<String>) {\n78:     if src.trim_start().starts_with(EXEMPT_MARKER) {\n79:         return;\n80:     }\n81:     // A fragment that cannot parse has nothing for `fmt` to canonicalize; that is a claim about\n82:     // the checker (pinned elsewhere, in the docs harness), not about formatting.\n83:     let Ok(formatted) = toylang::fmt(src) else {\n84:         return;\n85:     };\n86:     if formatted != src {\n87:         failures.push(format!(\n88:             \"{at}: not in canonical form -- run `toylang fmt` on it, or mark it \\\n89:              `{EXEMPT_MARKER}` if it deliberately shows a non-canonical spelling\\n\\\n90:              --- as written ---\\n{src}--- canonical ---\\n{formatted}\"\n91:         ));\n92:     }\n93: }\n94: \n95: fn report(checked: usize, failures: &[String]) {\n96:     assert!(\n97:         failures.is_empty(),\n98:         \"{} of {checked} not formatted:\\n{}\",\n99:         failures.len(),\n100:         failures.join(\"\\n\\n\")\n101:     );\n102: }\n103: \n104: fn repo_root() -> PathBuf {\n105:     Path::new(env!(\"CARGO_MANIFEST_DIR\")).to_path_buf()\n106: }\n107: \n108: fn walk(dir: &Path, out: &mut Vec<PathBuf>) {\n109:     for entry in\n110:         std::fs::read_dir(dir).unwrap_or_else(|e| panic!(\"cannot read {}: {e}\", dir.display()))\n111:     {\n112:         let path = entry.expect(\"readable entry\").path();\n113:         if path.is_dir() {\n114:             walk(&path, out);\n115:         } else if path.extension().is_some_and(|e| e == \"md\") {\n116:             out.push(path);\n117:         }\n118:     }\n119: }\n120: \n121: /// Every `toylang`-fenced block in a markdown page, as (the line its body starts on, the body).\n122: /// Lighter than `tests/docs.rs`'s `extract`: this only needs the program text, not the\n123: /// input/output fences that go with it, since formatting does not care what a program prints.\n124: fn toylang_fences(text: &str) -> Vec<(usize, String)> {\n125:     let mut out = Vec::new();\n126:     let mut lines = text.lines().enumerate();\n127:     while let Some((i, line)) = lines.next() {\n128:         if line.trim() != \"```toylang\" {\n129:             continue;\n130:         }\n131:         let start = i + 2;\n132:         let mut body = String::new();\n133:         for (_, l) in lines.by_ref() {\n134:             if l == \"```\" {\n135:                 break;\n136:             }\n137:             body.push_str(l);\n138:             body.push('\\n');\n139:         }\n140:         out.push((start, body));\n141:     }\n142:     out\n143: }\n\n(End of file - total 143 lines)\n</content>","metadata":{"preview":"//! The sweep harness: every `examples/*.toy` file, and every `toylang` fence under `docs/`, is\n//! required to already be in `toylang fmt`'s canonical form -- checked here so a hand-edited\n//! example cannot drift from what a real user would get by running the formatter on it.\n//!\n//! Two escapes, both narrow on purpose. A fragment that does not parse at all (`docs/tutorial/\n//! 06-matching.md`'s deliberately malformed default-arm example) has nothing for `fmt` to\n//! canonicalize, so it is skipped rather than failed. A fragment that exists specifically to\n//! show a spelling the canonical style does not use -- bare application, the brace-call\n//! shorthand -- opens with the exact line `# fmt: syntax-example`, checked for as plain text\n//! before parsing (a marker, not a directive `fmt` itself understands); reformatting it would\n//! erase the very thing the surrounding prose is pointing at. As of this writing there are three:\n//! `docs/reference/syntax/functions.md`, `docs/tutorial/02-records.md`, and\n//! `docs/tutorial/04-enums.md`.\n\nuse std::path::{Path, PathBuf};\n\n/// Plain text, not a `fmt`-recognized directive: this file is the only reader of it.\nconst EXEMPT_MARKER: &str = \"# fmt: syntax-example\";\n\n#[test]","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-153/tests/fmt_examples.rs","text":"//! The sweep harness: every `examples/*.toy` file, and every `toylang` fence under `docs/`, is\n//! required to already be in `toylang fmt`'s canonical form -- checked here so a hand-edited\n//! example cannot drift from what a real user would get by running the formatter on it.\n//!\n//! Two escapes, both narrow on purpose. A fragment that does not parse at all (`docs/tutorial/\n//! 06-matching.md`'s deliberately malformed default-arm example) has nothing for `fmt` to\n//! canonicalize, so it is skipped rather than failed. A fragment that exists specifically to\n//! show a spelling the canonical style does not use -- bare application, the brace-call\n//! shorthand -- opens with the exact line `# fmt: syntax-example`, checked for as plain text\n//! before parsing (a marker, not a directive `fmt` itself understands); reformatting it would\n//! erase the very thing the surrounding prose is pointing at. As of this writing there are three:\n//! `docs/reference/syntax/functions.md`, `docs/tutorial/02-records.md`, and\n//! `docs/tutorial/04-enums.md`.\n\nuse std::path::{Path, PathBuf};\n\n/// Plain text, not a `fmt`-recognized directive: this file is the only reader of it.\nconst EXEMPT_MARKER: &str = \"# fmt: syntax-example\";\n\n#[test]\nfn every_example_file_is_already_formatted() {\n    let mut checked = 0;\n    let mut failures = Vec::new();\n\n    let dir = repo_root().join(\"examples\");\n    let mut paths: Vec<PathBuf> = std::fs::read_dir(&dir)\n        .unwrap_or_else(|e| panic!(\"cannot read {}: {e}\", dir.display()))\n        .map(|e| e.expect(\"readable entry\").path())\n        .filter(|p| p.extension().is_some_and(|e| e == \"toy\"))\n        .collect();\n    paths.sort();\n\n    for path in paths {\n        let src =\n            std::fs::read_to_string(&path).unwrap_or_else(|e| panic!(\"{}: {e}\", path.display()));\n        checked += 1;\n        check_formatted(&path.display().to_string(), &src, &mut failures);\n    }\n\n    assert!(\n        checked > 0,\n        \"found no examples/*.toy files, so this test proves nothing\"\n    );\n    report(checked, &failures);\n}\n\n#[test]\nfn every_docs_fragment_is_already_formatted() {\n    let mut checked = 0;\n    let mut failures = Vec::new();\n\n    let mut pages = Vec::new();\n    walk(&repo_root().join(\"docs\"), &mut pages);\n    pages.sort();\n\n    for page in pages {\n        let text =\n            std::fs::read_to_string(&page).unwrap_or_else(|e| panic!(\"{}: {e}\", page.display()));\n        let rel = page\n            .strip_prefix(repo_root())\n            .expect(\"under the repo\")\n            .to_string_lossy()\n            .into_owned();\n        for (line, body) in toylang_fences(&text) {\n            checked += 1;\n            check_formatted(&format!(\"{rel}:{line}\"), &body, &mut failures);\n        }\n    }\n\n    assert!(\n        checked > 0,\n        \"found no toylang fences under docs/, so this test proves nothing\"\n    );\n    report(checked, &failures);\n}\n\nfn check_formatted(at: &str, src: &str, failures: &mut Vec<String>) {\n    if src.trim_start().starts_with(EXEMPT_MARKER) {\n        return;\n    }\n    // A fragment that cannot parse has nothing for `fmt` to canonicalize; that is a claim about\n    // the checker (pinned elsewhere, in the docs harness), not about formatting.\n    let Ok(formatted) = toylang::fmt(src) else {\n        return;\n    };\n    if formatted != src {\n        failures.push(format!(\n            \"{at}: not in canonical form -- run `toylang fmt` on it, or mark it \\\n             `{EXEMPT_MARKER}` if it deliberately shows a non-canonical spelling\\n\\\n             --- as written ---\\n{src}--- canonical ---\\n{formatted}\"\n        ));\n    }\n}\n\nfn report(checked: usize, failures: &[String]) {\n    assert!(\n        failures.is_empty(),\n        \"{} of {checked} not formatted:\\n{}\",\n        failures.len(),\n        failures.join(\"\\n\\n\")\n    );\n}\n\nfn repo_root() -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\")).to_path_buf()\n}\n\nfn walk(dir: &Path, out: &mut Vec<PathBuf>) {\n    for entry in\n        std::fs::read_dir(dir).unwrap_or_else(|e| panic!(\"cannot read {}: {e}\", dir.display()))\n    {\n        let path = entry.expect(\"readable entry\").path();\n        if path.is_dir() {\n            walk(&path, out);\n        } else if path.extension().is_some_and(|e| e == \"md\") {\n            out.push(path);\n        }\n    }\n}\n\n/// Every `toylang`-fenced block in a markdown page, as (the line its body starts on, the body).\n/// Lighter than `tests/docs.rs`'s `extract`: this only needs the program text, not the\n/// input/output fences that go with it, since formatting does not care what a program prints.\nfn toylang_fences(text: &str) -> Vec<(usize, String)> {\n    let mut out = Vec::new();\n    let mut lines = text.lines().enumerate();\n    while let Some((i, line)) = lines.next() {\n        if line.trim() != \"```toylang\" {\n            continue;\n        }\n        let start = i + 2;\n        let mut body = String::new();\n        for (_, l) in lines.by_ref() {\n            if l == \"```\" {\n                break;\n            }\n            body.push_str(l);\n            body.push('\\n');\n        }\n        out.push((start, body));\n    }\n    out\n}","lineStart":1,"lineEnd":143,"totalLines":143,"truncated":false}},"title":"tests/fmt_examples.rs","time":{"start":1788292019282,"end":1788292019288}},"id":"prt_05e82b44e001I3bhWa0f9LAI22","sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","messageID":"msg_05e82adb3001hqEul7fTJHAKf5"}}
