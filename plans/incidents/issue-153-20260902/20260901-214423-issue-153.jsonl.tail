{"type":"tool_use","timestamp":1788291898678,"sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-bab8976fc3ab4cc7","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-153/src/parse.rs","limit":400,"offset":1080},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-153/src/parse.rs</path>\n<type>file</type>\n<content>\n1080:                 span,\n1081:             };\n1082:         }\n1083: \n1084:         Ok(lhs)\n1085:     }\n1086: \n1087:     fn operand(&mut self, min_power: u8) -> Result<Expr, Error> {\n1088:         let mut lhs = self.complement(min_power)?;\n1089: \n1090:         loop {\n1091:             let (tok, _) = self.peek()?;\n1092:             // Where `or` is the arm separator it is not an operator at all, so the table is not\n1093:             // even consulted: the chain the arm belongs to takes the token.\n1094:             if tok == Tok::Or && self.or_separates {\n1095:                 break;\n1096:             }\n1097:             let Some((op, left, right)) = infix_power(&tok) else {\n1098:                 break;\n1099:             };\n1100:             if left < min_power {\n1101:                 break;\n1102:             }\n1103:             self.advance()?;\n1104:             let rhs = self.operand(right)?;\n1105:             let span = lhs.span().to(rhs.span());\n1106:             lhs = match op {\n1107:                 Infix::Bin(op) => Expr::Binary {\n1108:                     op,\n1109:                     lhs: Box::new(lhs),\n1110:                     rhs: Box::new(rhs),\n1111:                     span,\n1112:                 },\n1113:                 Infix::Logic(op) => Expr::Logic {\n1114:                     op,\n1115:                     lhs: Box::new(lhs),\n1116:                     rhs: Box::new(rhs),\n1117:                     span,\n1118:                 },\n1119:             };\n1120:         }\n1121: \n1122:         Ok(lhs)\n1123:     }\n1124: \n1125:     /// `not`, which is prefix but not unary in `-`'s sense: it binds looser than every operator\n1126:     /// in the infix table above comparison, so it reads its own operand at its own power rather\n1127:     /// than taking whatever `unary` returns. A position that binds tighter than `not` (a\n1128:     /// comparison's right side, say) declines it, and parens are what reach in there.\n1129:     fn complement(&mut self, min_power: u8) -> Result<Expr, Error> {\n1130:         let (tok, span) = self.peek()?;\n1131:         if tok == Tok::Not && min_power <= NOT_POWER {\n1132:             self.advance()?;\n1133:             let base = self.operand(NOT_POWER)?;\n1134:             let full = span.to(base.span());\n1135:             return Ok(Expr::Not {\n1136:                 base: Box::new(base),\n1137:                 span: full,\n1138:             });\n1139:         }\n1140:         self.unary()\n1141:     }\n1142: \n1143:     /// Negation binds tighter than any infix operator and looser than any postfix one, so\n1144:     /// `-a.b` negates the field and `-a * b` negates only `a`.\n1145:     fn unary(&mut self) -> Result<Expr, Error> {\n1146:         let (tok, span) = self.peek()?;\n1147:         if tok == Tok::Minus {\n1148:             self.advance()?;\n1149:             let base = self.unary()?;\n1150:             let full = span.to(base.span());\n1151:             return Ok(Expr::Neg {\n1152:                 base: Box::new(base),\n1153:                 span: full,\n1154:             });\n1155:         }\n1156:         self.postfix()\n1157:     }\n1158: \n1159:     /// `[]` and `.name` bind tighter than any infix operator, so `a.b[] | c` projects `a.b`.\n1160:     fn postfix(&mut self) -> Result<Expr, Error> {\n1161:         let mut e = self.atom()?;\n1162:         loop {\n1163:             let (tok, _) = self.peek()?;\n1164:             match tok {\n1165:                 Tok::LBracket => {\n1166:                     let (_, bspan) = self.peek()?;\n1167:                     // Indexing owns `[` on the same line only, the same rule call arguments\n1168:                     // follow: a definition's body and the program's body sit adjacent, and the\n1169:                     // line break keeps one from swallowing the other.\n1170:                     if !self.same_line(e.span().end, bspan.start) {\n1171:                         return Ok(e);\n1172:                     }\n1173:                     let (_, lspan) = self.advance()?;\n1174:                     let (next, _) = self.peek()?;\n1175:                     if next == Tok::RBracket {\n1176:                         let close = self.advance()?.1;\n1177:                         let span = e.span().to(close);\n1178:                         e = Expr::Project {\n1179:                             base: Box::new(e),\n1180:                             span,\n1181:                         };\n1182:                     } else {\n1183:                         // `[a]` collapses; `[a:b]` narrows, with either bound optional. A `:`\n1184:                         // is never an expression token, so peeking past the first operand (or\n1185:                         // past the `[`, for `[:b]`) tells the two apart unambiguously.\n1186:                         let start = if next == Tok::Colon {\n1187:                             None\n1188:                         } else {\n1189:                             Some(Box::new(self.expr(0)?))\n1190:                         };\n1191:                         if self.peek()?.0 == Tok::Colon {\n1192:                             self.advance()?;\n1193:                             let (next, _) = self.peek()?;\n1194:                             let end = if next == Tok::RBracket {\n1195:                                 None\n1196:                             } else {\n1197:                                 Some(Box::new(self.expr(0)?))\n1198:                             };\n1199:                             let close = self.eat(Tok::RBracket)?;\n1200:                             // Both edges at the dimension's own boundaries is the identity\n1201:                             // `[]` already is, and jq itself rejects the both-omitted form,\n1202:                             // so there is no reason to carry a spelling for it.\n1203:                             if start.is_none() && end.is_none() {\n1204:                                 return Err(Error::new(\n1205:                                     lspan.to(close),\n1206:                                     \"a slice needs at least one bound\",\n1207:                                 ));\n1208:                             }\n1209:                             let span = e.span().to(close);\n1210:                             e = Expr::Slice {\n1211:                                 base: Box::new(e),\n1212:                                 start,\n1213:                                 end,\n1214:                                 span,\n1215:                             };\n1216:                         } else {\n1217:                             // No colon after the first operand: a plain collapsing index,\n1218:                             // whose `start` is the index.\n1219:                             let close = self.eat(Tok::RBracket)?;\n1220:                             let span = e.span().to(close);\n1221:                             e = Expr::Index {\n1222:                                 base: Box::new(e),\n1223:                                 index: start.expect(\"no colon means start was parsed\"),\n1224:                                 span,\n1225:                             };\n1226:                         }\n1227:                     }\n1228:                 }\n1229:                 Tok::Bang => {\n1230:                     let bang = self.advance()?.1;\n1231:                     let span = e.span().to(bang);\n1232:                     e = Expr::Unwrap {\n1233:                         base: Box::new(e),\n1234:                         span,\n1235:                     };\n1236:                 }\n1237:                 Tok::Dot => {\n1238:                     self.advance()?;\n1239:                     let (ft, fspan) = self.advance()?;\n1240:                     let Tok::Ident(name) = ft else {\n1241:                         return Err(Error::new(\n1242:                             fspan,\n1243:                             format!(\"expected a field name, found {ft}\"),\n1244:                         ));\n1245:                     };\n1246:                     let span = e.span().to(fspan);\n1247:                     e = Expr::Field {\n1248:                         base: Box::new(e),\n1249:                         name,\n1250:                         span,\n1251:                     };\n1252:                 }\n1253:                 _ => return Ok(e),\n1254:             }\n1255:         }\n1256:     }\n1257: \n1258:     /// What a name means once read: a qualified variant (`Shape.circle`), a call when an\n1259:     /// argument starts after it on the same line, or a plain variable reference.\n1260:     ///\n1261:     /// A name followed by an argument is a call; bare application is the default spelling and\n1262:     /// `f(x)` is `f` applied to the grouped atom `(x)`. The bare form asks two things of the\n1263:     /// call that the delimited forms do not: the callee must be lowercase (a capitalised bare\n1264:     /// call could never typecheck), and the argument's first token excludes `-` (already\n1265:     /// subtraction: `f -1` stays `f - 1`), `.` (projection binds tighter than bare application\n1266:     /// everywhere, so `p.b` is a field access even though `.b` alone could be an argument --\n1267:     /// issue #19), and `[` (indexing owns it for the same reason: `v[0]` indexes, so a Vec\n1268:     /// literal argument needs parens).\n1269:     fn ident_expr(&mut self, name: String, span: Span) -> Result<Expr, Error> {\n1270:         let (next, next_span) = self.peek()?;\n1271:         // `Shape.circle`: the casing rule makes uppercase-then-dot unambiguous, since a\n1272:         // capitalised name can never be a value for `.` to project a field out of.\n1273:         if next == Tok::Dot && name.chars().next().is_some_and(char::is_uppercase) {\n1274:             self.advance()?;\n1275:             let (variant, variant_span) = self.eat_ident(\"a variant name\")?;\n1276:             let (after, after_span) = self.peek()?;\n1277:             let (payload, end) = if (after == Tok::LParen || after == Tok::LBrace)\n1278:                 && self.takes_argument(&format!(\"{name}.{variant}\"), variant_span, after_span)\n1279:             {\n1280:                 let (arg, close) = self.argument()?;\n1281:                 (Some(Box::new(arg)), close)\n1282:             } else {\n1283:                 (None, variant_span)\n1284:             };\n1285:             return Ok(Expr::Variant {\n1286:                 enum_name: name,\n1287:                 enum_span: span,\n1288:                 variant,\n1289:                 variant_span,\n1290:                 payload,\n1291:                 span: span.to(end),\n1292:             });\n1293:         }\n1294:         let argument_starts = match next {\n1295:             Tok::LParen | Tok::LBrace => true,\n1296:             Tok::Str(_) | Tok::Int(_) | Tok::Input | Tok::Inputs | Tok::Lines | Tok::Dsv\n1297:             | Tok::Csv | Tok::Tsv | Tok::Ident(_) => {\n1298:                 bare_callee(&name)\n1299:             }\n1300:             _ => false,\n1301:         };\n1302:         if !argument_starts || !self.takes_argument(&name, span, next_span) {\n1303:             return Ok(Expr::Var { name, span });\n1304:         }\n1305:         // `name()` is a nullary call, the one place a call's argument is optional: the empty\n1306:         // parens are checked for before falling into the ordinary single-expression parse, so\n1307:         // every other argument form (parenthesized, record, or bare) still names exactly one.\n1308:         let (arg, close) = if next == Tok::LParen {\n1309:             self.advance()?;\n1310:             let (after, _) = self.peek()?;\n1311:             if after == Tok::RParen {\n1312:                 let close = self.advance()?.1;\n1313:                 (None, close)\n1314:             } else {\n1315:                 let inner = self.expr(0)?;\n1316:                 let close = self.eat(Tok::RParen)?;\n1317:                 (Some(inner), close)\n1318:             }\n1319:         } else if next == Tok::LBrace {\n1320:             let (lit, close) = self.argument()?;\n1321:             (Some(lit), close)\n1322:         } else {\n1323:             // A bare argument is a postfix chain, not an operand: an infix operator after it\n1324:             // belongs to the enclosing expression, so `f x + y` is `f(x) + y`. Chaining is\n1325:             // right-recursive through `atom` itself, making `f g x` read `f(g(x))` -- with no\n1326:             // first-class functions, the only reading that could ever typecheck.\n1327:             let arg = self.postfix()?;\n1328:             let end = arg.span();\n1329:             (Some(arg), end)\n1330:         };\n1331:         Ok(Expr::Call {\n1332:             func: name,\n1333:             func_span: span,\n1334:             arg: arg.map(Box::new),\n1335:             span: span.to(close),\n1336:         })\n1337:     }\n1338: \n1339:     fn atom(&mut self) -> Result<Expr, Error> {\n1340:         let (tok, span) = self.advance()?;\n1341:         match tok {\n1342:             Tok::Str(text) => Ok(Expr::Str { text, span }),\n1343:             Tok::Int(value) => Ok(Expr::Int { value, span }),\n1344:             Tok::Input => Ok(Expr::Input { span }),\n1345:             Tok::Inputs => Ok(Expr::Inputs { span }),\n1346:             Tok::Lines => Ok(Expr::Lines { span }),\n1347:             Tok::Csv => Ok(Expr::Dsv {\n1348:                 delim: \",\".to_string(),\n1349:                 span,\n1350:             }),\n1351:             Tok::Tsv => Ok(Expr::Dsv {\n1352:                 delim: \"\\t\".to_string(),\n1353:                 span,\n1354:             }),\n1355:             // The parameterized spelling: the delimiter is a string literal in parens, the\n1356:             // one argument form that cannot be misread as anything else at this position.\n1357:             Tok::Dsv => {\n1358:                 self.eat(Tok::LParen)?;\n1359:                 let (tok, _) = self.advance()?;\n1360:                 let Tok::Str(delim) = tok else {\n1361:                     return Err(Error::new(\n1362:                         span,\n1363:                         \"`dsv`'s delimiter must be a string literal, as in `dsv(\\\",\\\")`\"\n1364:                             .to_string(),\n1365:                     ));\n1366:                 };\n1367:                 let close = self.eat(Tok::RParen)?;\n1368:                 Ok(Expr::Dsv {\n1369:                     delim,\n1370:                     span: span.to(close),\n1371:                 })\n1372:             }\n1373: \n1374:             // `.name` is field access on the subject, so the leading dot yields `.` and the\n1375:             // postfix loop above picks the field up.\n1376:             Tok::Dot => {\n1377:                 let (next, _) = self.peek()?;\n1378:                 if let Tok::Ident(name) = next {\n1379:                     let (_, fspan) = self.advance()?;\n1380:                     return Ok(Expr::Field {\n1381:                         base: Box::new(Expr::Subject { span }),\n1382:                         name,\n1383:                         span: span.to(fspan),\n1384:                     });\n1385:                 }\n1386:                 Ok(Expr::Subject { span })\n1387:             }\n1388: \n1389:             Tok::LBrace => self.record_lit(span),\n1390: \n1391:             Tok::LBracket => {\n1392:                 // `,` is a separator here, not an operator. It has no meaning outside a literal\n1393:                 // while everything stays in the value layer.\n1394:                 let mut items = Vec::new();\n1395:                 let (first, _) = self.peek()?;\n1396:                 if first != Tok::RBracket {\n1397:                     loop {\n1398:                         items.push(self.expr(0)?);\n1399:                         let (sep, _) = self.peek()?;\n1400:                         if sep != Tok::Comma {\n1401:                             break;\n1402:                         }\n1403:                         self.advance()?;\n1404:                     }\n1405:                 }\n1406:                 let close = self.eat(Tok::RBracket)?;\n1407:                 Ok(Expr::VecLit {\n1408:                     items,\n1409:                     span: span.to(close),\n1410:                 })\n1411:             }\n1412: \n1413:             Tok::Ident(name) => self.ident_expr(name, span),\n1414: \n1415:             Tok::LParen => {\n1416:                 let inner = self.expr(0)?;\n1417:                 self.eat(Tok::RParen)?;\n1418:                 Ok(inner)\n1419:             }\n1420: \n1421:             other => Err(Error::new(\n1422:                 span,\n1423:                 format!(\"expected an expression, found {other}\"),\n1424:             )),\n1425:         }\n1426:     }\n1427: }\n1428: \n1429: /// Whether `name` can take a bare (undelimited) argument. Only a lowercase name can: a\n1430: /// capitalised name is a type under the casing rule, so a capitalised bare call could never\n1431: /// typecheck. Constructors still apply with the delimited forms (`Circle{r: 1}`,\n1432: /// `Circle(...)`), which this does not gate.\n1433: fn bare_callee(name: &str) -> bool {\n1434:     !name.chars().next().is_some_and(char::is_uppercase)\n1435: }\n\n(End of file - total 1435 lines)\n</content>","metadata":{"preview":"                span,\n            };\n        }\n\n        Ok(lhs)\n    }\n\n    fn operand(&mut self, min_power: u8) -> Result<Expr, Error> {\n        let mut lhs = self.complement(min_power)?;\n\n        loop {\n            let (tok, _) = self.peek()?;\n            // Where `or` is the arm separator it is not an operator at all, so the table is not\n            // even consulted: the chain the arm belongs to takes the token.\n            if tok == Tok::Or && self.or_separates {\n                break;\n            }\n            let Some((op, left, right)) = infix_power(&tok) else {\n                break;\n            };","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-153/src/parse.rs","text":"                span,\n            };\n        }\n\n        Ok(lhs)\n    }\n\n    fn operand(&mut self, min_power: u8) -> Result<Expr, Error> {\n        let mut lhs = self.complement(min_power)?;\n\n        loop {\n            let (tok, _) = self.peek()?;\n            // Where `or` is the arm separator it is not an operator at all, so the table is not\n            // even consulted: the chain the arm belongs to takes the token.\n            if tok == Tok::Or && self.or_separates {\n                break;\n            }\n            let Some((op, left, right)) = infix_power(&tok) else {\n                break;\n            };\n            if left < min_power {\n                break;\n            }\n            self.advance()?;\n            let rhs = self.operand(right)?;\n            let span = lhs.span().to(rhs.span());\n            lhs = match op {\n                Infix::Bin(op) => Expr::Binary {\n                    op,\n                    lhs: Box::new(lhs),\n                    rhs: Box::new(rhs),\n                    span,\n                },\n                Infix::Logic(op) => Expr::Logic {\n                    op,\n                    lhs: Box::new(lhs),\n                    rhs: Box::new(rhs),\n                    span,\n                },\n            };\n        }\n\n        Ok(lhs)\n    }\n\n    /// `not`, which is prefix but not unary in `-`'s sense: it binds looser than every operator\n    /// in the infix table above comparison, so it reads its own operand at its own power rather\n    /// than taking whatever `unary` returns. A position that binds tighter than `not` (a\n    /// comparison's right side, say) declines it, and parens are what reach in there.\n    fn complement(&mut self, min_power: u8) -> Result<Expr, Error> {\n        let (tok, span) = self.peek()?;\n        if tok == Tok::Not && min_power <= NOT_POWER {\n            self.advance()?;\n            let base = self.operand(NOT_POWER)?;\n            let full = span.to(base.span());\n            return Ok(Expr::Not {\n                base: Box::new(base),\n                span: full,\n            });\n        }\n        self.unary()\n    }\n\n    /// Negation binds tighter than any infix operator and looser than any postfix one, so\n    /// `-a.b` negates the field and `-a * b` negates only `a`.\n    fn unary(&mut self) -> Result<Expr, Error> {\n        let (tok, span) = self.peek()?;\n        if tok == Tok::Minus {\n            self.advance()?;\n            let base = self.unary()?;\n            let full = span.to(base.span());\n            return Ok(Expr::Neg {\n                base: Box::new(base),\n                span: full,\n            });\n        }\n        self.postfix()\n    }\n\n    /// `[]` and `.name` bind tighter than any infix operator, so `a.b[] | c` projects `a.b`.\n    fn postfix(&mut self) -> Result<Expr, Error> {\n        let mut e = self.atom()?;\n        loop {\n            let (tok, _) = self.peek()?;\n            match tok {\n                Tok::LBracket => {\n                    let (_, bspan) = self.peek()?;\n                    // Indexing owns `[` on the same line only, the same rule call arguments\n                    // follow: a definition's body and the program's body sit adjacent, and the\n                    // line break keeps one from swallowing the other.\n                    if !self.same_line(e.span().end, bspan.start) {\n                        return Ok(e);\n                    }\n                    let (_, lspan) = self.advance()?;\n                    let (next, _) = self.peek()?;\n                    if next == Tok::RBracket {\n                        let close = self.advance()?.1;\n                        let span = e.span().to(close);\n                        e = Expr::Project {\n                            base: Box::new(e),\n                            span,\n                        };\n                    } else {\n                        // `[a]` collapses; `[a:b]` narrows, with either bound optional. A `:`\n                        // is never an expression token, so peeking past the first operand (or\n                        // past the `[`, for `[:b]`) tells the two apart unambiguously.\n                        let start = if next == Tok::Colon {\n                            None\n                        } else {\n                            Some(Box::new(self.expr(0)?))\n                        };\n                        if self.peek()?.0 == Tok::Colon {\n                            self.advance()?;\n                            let (next, _) = self.peek()?;\n                            let end = if next == Tok::RBracket {\n                                None\n                            } else {\n                                Some(Box::new(self.expr(0)?))\n                            };\n                            let close = self.eat(Tok::RBracket)?;\n                            // Both edges at the dimension's own boundaries is the identity\n                            // `[]` already is, and jq itself rejects the both-omitted form,\n                            // so there is no reason to carry a spelling for it.\n                            if start.is_none() && end.is_none() {\n                                return Err(Error::new(\n                                    lspan.to(close),\n                                    \"a slice needs at least one bound\",\n                                ));\n                            }\n                            let span = e.span().to(close);\n                            e = Expr::Slice {\n                                base: Box::new(e),\n                                start,\n                                end,\n                                span,\n                            };\n                        } else {\n                            // No colon after the first operand: a plain collapsing index,\n                            // whose `start` is the index.\n                            let close = self.eat(Tok::RBracket)?;\n                            let span = e.span().to(close);\n                            e = Expr::Index {\n                                base: Box::new(e),\n                                index: start.expect(\"no colon means start was parsed\"),\n                                span,\n                            };\n                        }\n                    }\n                }\n                Tok::Bang => {\n                    let bang = self.advance()?.1;\n                    let span = e.span().to(bang);\n                    e = Expr::Unwrap {\n                        base: Box::new(e),\n                        span,\n                    };\n                }\n                Tok::Dot => {\n                    self.advance()?;\n                    let (ft, fspan) = self.advance()?;\n                    let Tok::Ident(name) = ft else {\n                        return Err(Error::new(\n                            fspan,\n                            format!(\"expected a field name, found {ft}\"),\n                        ));\n                    };\n                    let span = e.span().to(fspan);\n                    e = Expr::Field {\n                        base: Box::new(e),\n                        name,\n                        span,\n                    };\n                }\n                _ => return Ok(e),\n            }\n        }\n    }\n\n    /// What a name means once read: a qualified variant (`Shape.circle`), a call when an\n    /// argument starts after it on the same line, or a plain variable reference.\n    ///\n    /// A name followed by an argument is a call; bare application is the default spelling and\n    /// `f(x)` is `f` applied to the grouped atom `(x)`. The bare form asks two things of the\n    /// call that the delimited forms do not: the callee must be lowercase (a capitalised bare\n    /// call could never typecheck), and the argument's first token excludes `-` (already\n    /// subtraction: `f -1` stays `f - 1`), `.` (projection binds tighter than bare application\n    /// everywhere, so `p.b` is a field access even though `.b` alone could be an argument --\n    /// issue #19), and `[` (indexing owns it for the same reason: `v[0]` indexes, so a Vec\n    /// literal argument needs parens).\n    fn ident_expr(&mut self, name: String, span: Span) -> Result<Expr, Error> {\n        let (next, next_span) = self.peek()?;\n        // `Shape.circle`: the casing rule makes uppercase-then-dot unambiguous, since a\n        // capitalised name can never be a value for `.` to project a field out of.\n        if next == Tok::Dot && name.chars().next().is_some_and(char::is_uppercase) {\n            self.advance()?;\n            let (variant, variant_span) = self.eat_ident(\"a variant name\")?;\n            let (after, after_span) = self.peek()?;\n            let (payload, end) = if (after == Tok::LParen || after == Tok::LBrace)\n                && self.takes_argument(&format!(\"{name}.{variant}\"), variant_span, after_span)\n            {\n                let (arg, close) = self.argument()?;\n                (Some(Box::new(arg)), close)\n            } else {\n                (None, variant_span)\n            };\n            return Ok(Expr::Variant {\n                enum_name: name,\n                enum_span: span,\n                variant,\n                variant_span,\n                payload,\n                span: span.to(end),\n            });\n        }\n        let argument_starts = match next {\n            Tok::LParen | Tok::LBrace => true,\n            Tok::Str(_) | Tok::Int(_) | Tok::Input | Tok::Inputs | Tok::Lines | Tok::Dsv\n            | Tok::Csv | Tok::Tsv | Tok::Ident(_) => {\n                bare_callee(&name)\n            }\n            _ => false,\n        };\n        if !argument_starts || !self.takes_argument(&name, span, next_span) {\n            return Ok(Expr::Var { name, span });\n        }\n        // `name()` is a nullary call, the one place a call's argument is optional: the empty\n        // parens are checked for before falling into the ordinary single-expression parse, so\n        // every other argument form (parenthesized, record, or bare) still names exactly one.\n        let (arg, close) = if next == Tok::LParen {\n            self.advance()?;\n            let (after, _) = self.peek()?;\n            if after == Tok::RParen {\n                let close = self.advance()?.1;\n                (None, close)\n            } else {\n                let inner = self.expr(0)?;\n                let close = self.eat(Tok::RParen)?;\n                (Some(inner), close)\n            }\n        } else if next == Tok::LBrace {\n            let (lit, close) = self.argument()?;\n            (Some(lit), close)\n        } else {\n            // A bare argument is a postfix chain, not an operand: an infix operator after it\n            // belongs to the enclosing expression, so `f x + y` is `f(x) + y`. Chaining is\n            // right-recursive through `atom` itself, making `f g x` read `f(g(x))` -- with no\n            // first-class functions, the only reading that could ever typecheck.\n            let arg = self.postfix()?;\n            let end = arg.span();\n            (Some(arg), end)\n        };\n        Ok(Expr::Call {\n            func: name,\n            func_span: span,\n            arg: arg.map(Box::new),\n            span: span.to(close),\n        })\n    }\n\n    fn atom(&mut self) -> Result<Expr, Error> {\n        let (tok, span) = self.advance()?;\n        match tok {\n            Tok::Str(text) => Ok(Expr::Str { text, span }),\n            Tok::Int(value) => Ok(Expr::Int { value, span }),\n            Tok::Input => Ok(Expr::Input { span }),\n            Tok::Inputs => Ok(Expr::Inputs { span }),\n            Tok::Lines => Ok(Expr::Lines { span }),\n            Tok::Csv => Ok(Expr::Dsv {\n                delim: \",\".to_string(),\n                span,\n            }),\n            Tok::Tsv => Ok(Expr::Dsv {\n                delim: \"\\t\".to_string(),\n                span,\n            }),\n            // The parameterized spelling: the delimiter is a string literal in parens, the\n            // one argument form that cannot be misread as anything else at this position.\n            Tok::Dsv => {\n                self.eat(Tok::LParen)?;\n                let (tok, _) = self.advance()?;\n                let Tok::Str(delim) = tok else {\n                    return Err(Error::new(\n                        span,\n                        \"`dsv`'s delimiter must be a string literal, as in `dsv(\\\",\\\")`\"\n                            .to_string(),\n                    ));\n                };\n                let close = self.eat(Tok::RParen)?;\n                Ok(Expr::Dsv {\n                    delim,\n                    span: span.to(close),\n                })\n            }\n\n            // `.name` is field access on the subject, so the leading dot yields `.` and the\n            // postfix loop above picks the field up.\n            Tok::Dot => {\n                let (next, _) = self.peek()?;\n                if let Tok::Ident(name) = next {\n                    let (_, fspan) = self.advance()?;\n                    return Ok(Expr::Field {\n                        base: Box::new(Expr::Subject { span }),\n                        name,\n                        span: span.to(fspan),\n                    });\n                }\n                Ok(Expr::Subject { span })\n            }\n\n            Tok::LBrace => self.record_lit(span),\n\n            Tok::LBracket => {\n                // `,` is a separator here, not an operator. It has no meaning outside a literal\n                // while everything stays in the value layer.\n                let mut items = Vec::new();\n                let (first, _) = self.peek()?;\n                if first != Tok::RBracket {\n                    loop {\n                        items.push(self.expr(0)?);\n                        let (sep, _) = self.peek()?;\n                        if sep != Tok::Comma {\n                            break;\n                        }\n                        self.advance()?;\n                    }\n                }\n                let close = self.eat(Tok::RBracket)?;\n                Ok(Expr::VecLit {\n                    items,\n                    span: span.to(close),\n                })\n            }\n\n            Tok::Ident(name) => self.ident_expr(name, span),\n\n            Tok::LParen => {\n                let inner = self.expr(0)?;\n                self.eat(Tok::RParen)?;\n                Ok(inner)\n            }\n\n            other => Err(Error::new(\n                span,\n                format!(\"expected an expression, found {other}\"),\n            )),\n        }\n    }\n}\n\n/// Whether `name` can take a bare (undelimited) argument. Only a lowercase name can: a\n/// capitalised name is a type under the casing rule, so a capitalised bare call could never\n/// typecheck. Constructors still apply with the delimited forms (`Circle{r: 1}`,\n/// `Circle(...)`), which this does not gate.\nfn bare_callee(name: &str) -> bool {\n    !name.chars().next().is_some_and(char::is_uppercase)\n}","lineStart":1080,"lineEnd":1435,"totalLines":1435,"truncated":false}},"title":"src/parse.rs","time":{"start":17882