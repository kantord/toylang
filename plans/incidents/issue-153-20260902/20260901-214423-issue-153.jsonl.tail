fs = Vec::new();\n    let mut aliases = Vec::new();\n    let mut enums = Vec::new();\n    loop {\n        let (tok, span) = p.peek()?;\n        match tok {\n            Tok::Pub => {\n                p.advance()?;\n                match p.peek()?.0 {\n                    Tok::Enum => enums.push(p.enum_decl(true)?),\n                    _ => defs.push(p.def(true)?),\n                }\n            }","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-153/src/parse.rs","text":"/// only names for a program to import. `pub` marks which ones a program actually receives.\npub fn parse_module(src: &str) -> Result<Module, Error> {\nlet mut p = Cursor {\n        input: LocatingSlice::new(src),\n        src,\n        or_separates: false,\n    };\n    let mut defs = Vec::new();\n    let mut aliases = Vec::new();\n    let mut enums = Vec::new();\n    loop {\n        let (tok, span) = p.peek()?;\n        match tok {\n            Tok::Pub => {\n                p.advance()?;\n                match p.peek()?.0 {\n                    Tok::Enum => enums.push(p.enum_decl(true)?),\n                    _ => defs.push(p.def(true)?),\n                }\n            }\n            Tok::Fn => defs.push(p.def(false)?),\n            Tok::Enum => enums.push(p.enum_decl(false)?),\n            Tok::Eof => break,\n            other => {\n                return Err(Error::new(\n                    span,\n                    format!(\"expected `fn` or end of module, found {other}\"),\n                ));\n            }\n        }","lineStart":440,"lineEnd":469,"totalLines":1435,"truncated":true}},"title":"src/parse.rs","time":{"start":1788292455743,"end":1788292455748}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05e895d3c001M6Y21VlbJbOT6R","sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","messageID":"msg_05e89585b001vLJ0ksVgTogZN3"}}
