{"type":"tool_use","timestamp":1788291877583,"sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-a743c0cd743311ce","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-153/src/parse.rs","offset":380,"limit":300},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-153/src/parse.rs</path>\n<type>file</type>\n<content>\n380:         or_separates: false,\n381:     };\n382: \n383:     // Declarations in any order and any mix, since no kind can refer to another's position:\n384:     // aliases and enums are resolved before any signature is read.\n385:     let mut defs = Vec::new();\n386:     let mut aliases = Vec::new();\n387:     let mut enums = Vec::new();\n388:     loop {\n389:         let (tok, _) = p.peek()?;\n390:         match tok {\n391:             Tok::Pub => {\n392:                 p.advance()?;\n393:                 match p.peek()?.0 {\n394:                     Tok::Enum => enums.push(p.enum_decl(true)?),\n395:                     _ => defs.push(p.def(true)?),\n396:                 }\n397:             }\n398:             Tok::Fn => defs.push(p.def(false)?),\n399:             Tok::Type => aliases.push(p.alias()?),\n400:             Tok::Enum => enums.push(p.enum_decl(false)?),\n401:             _ => break,\n402:         }\n403:     }\n404: \n405:     // `input <type>` declares what stdin holds before the body reads it. It is the one\n406:     // declaration that sits after the defs rather than among them, so it is read here, and it is\n407:     // recognized by the same-line rule a call argument follows: only when the type opens on\n408:     // `input`'s own line does the keyword start an annotation, so a body that merely uses\n409:     // `input` is never mistaken for one.\n410:     let input = match p.peek()? {\n411:         (Tok::Input, input_span) => {\n412:             let (next, next_span) = p.peek2()?;\n413:             if (next == Tok::LBrace || matches!(next, Tok::Ident(_)))\n414:                 && p.same_line(input_span.end, next_span.start)\n415:             {\n416:                 p.advance()?;\n417:                 Some(p.type_expr()?)\n418:             } else {\n419:                 None\n420:             }\n421:         }\n422:         _ => None,\n423:     };\n424: \n425:     let body = p.expr(0)?;\n426:     let (rest, rest_span) = p.peek()?;\n427:     if rest != Tok::Eof {\n428:         return Err(p.unexpected(rest_span, format!(\"expected end of program, found {rest}\")));\n429:     }\n430:     Ok(File {\n431:         aliases,\n432:         enums,\n433:         defs,\n434:         input,\n435:         body,\n436:     })\n437: }\n438: \n439: /// A module is declarations only, with no trailing expression -- there is nothing here to run,\n440: /// only names for a program to import. `pub` marks which ones a program actually receives.\n441: pub fn parse_module(src: &str) -> Result<Module, Error> {\n442:     let mut p = Cursor {\n443:         input: LocatingSlice::new(src),\n444:         src,\n445:         declined_cross_line: None,\n446:         or_separates: false,\n447:     };\n448:     let mut defs = Vec::new();\n449:     let mut enums = Vec::new();\n450:     loop {\n451:         let (tok, span) = p.peek()?;\n452:         match tok {\n453:             Tok::Pub => {\n454:                 p.advance()?;\n455:                 match p.peek()?.0 {\n456:                     Tok::Enum => enums.push(p.enum_decl(true)?),\n457:                     _ => defs.push(p.def(true)?),\n458:                 }\n459:             }\n460:             Tok::Fn => defs.push(p.def(false)?),\n461:             Tok::Enum => enums.push(p.enum_decl(false)?),\n462:             Tok::Eof => break,\n463:             other => {\n464:                 return Err(Error::new(\n465:                     span,\n466:                     format!(\"expected `fn` or end of module, found {other}\"),\n467:                 ));\n468:             }\n469:         }\n470:     }\n471:     Ok(Module { defs, enums })\n472: }\n473: \n474: struct Cursor<'i> {\n475:     input: Input<'i>,\n476:     /// The full source, kept alongside the advancing `input` so the same-line rule can look at\n477:     /// the trivia between two tokens it already has spans for.\n478:     src: &'i str,\n479:     /// Where a call was declined because its argument started on a later line: the argument\n480:     /// token's start, and the callee's name. Declining is usually right -- a definition's body\n481:     /// and the program's body sit adjacent with nothing between them, and the line break is what\n482:     /// keeps one from swallowing the other -- but when the parse then fails at exactly the\n483:     /// declined token, the intended reading was probably the call, and the error can name the\n484:     /// parens spelling that works across lines.\n485:     declined_cross_line: Option<(usize, String)>,\n486:     /// Which of `or`'s two readings is in force here: the match-arm separator (true), or Bool\n487:     /// disjunction (false). True only inside an arm's body, where the separator has to win so\n488:     /// that `a -> b or c` is two arms; every fresh expression position below that -- a\n489:     /// parenthesized group, a call argument, an arm's own guard -- puts it back to false, since\n490:     /// nothing there is a chain's top level. This is the split kantord/toylang#96 set out to\n491:     /// prove clean, and the one place a token's meaning depends on where it is read.\n492:     or_separates: bool,\n493: }\n494: \n495: impl<'i> Cursor<'i> {\n496:     /// Reads the next token without consuming it. `Input` is `Copy` (a source `&str` plus an\n497:     /// offset), so looking ahead is just tokenizing a throwaway copy of the cursor.\n498:     fn peek(&self) -> Result<(Tok, Span), Error> {\n499:         let mut probe = self.input;\n500:         read_tok(&mut probe)\n501:     }\n502: \n503:     /// Reads the token after the next one without consuming either. One probe over `input`,\n504:     /// then a second over the probe, so the cursor never moves.\n505:     fn peek2(&self) -> Result<(Tok, Span), Error> {\n506:         let mut probe = self.input;\n507:         read_tok(&mut probe)?;\n508:         read_tok(&mut probe)\n509:     }\n510: \n511:     fn advance(&mut self) -> Result<(Tok, Span), Error> {\n512:         read_tok(&mut self.input)\n513:     }\n514: \n515:     fn eat(&mut self, want: Tok) -> Result<Span, Error> {\n516:         let (tok, span) = self.peek()?;\n517:         if tok != want {\n518:             return Err(self.unexpected(span, format!(\"expected {want}, found {tok}\")));\n519:         }\n520:         self.advance()?;\n521:         Ok(span)\n522:     }\n523: \n524:     /// An \"unexpected token\" error, extended with the parens spelling when the failing token is\n525:     /// one a call declined to take as a cross-line argument (see `declined_cross_line`): the\n526:     /// token had somewhere to go, and only the line break kept it from going there.\n527:     fn unexpected(&self, span: Span, msg: String) -> Error {\n528:         if let Some((at, callee)) = &self.declined_cross_line\n529:             && *at == span.start\n530:         {\n531:             return Error::new(\n532:                 span,\n533:                 format!(\n534:                     \"{msg}; an argument must start on the same line as its function -- \\\n535:                      write `{callee}(...)` to call across lines\"\n536:                 ),\n537:             );\n538:         }\n539:         Error::new(span, msg)\n540:     }\n541: \n542:     /// Whether nothing but spaces and tabs sits between two byte offsets. The same-line rule for\n543:     /// call arguments: an argument, bare or parenthesized, must start on the same line as its\n544:     /// function, which is what lets a definition's body end next to the program's body without\n545:     /// either reaching across the line break and swallowing the other.\n546:     fn same_line(&self, from: usize, to: usize) -> bool {\n547:         !self.src[from..to].contains('\\n')\n548:     }\n549: \n550:     /// The same-line rule applied at one call site: true when the argument starting at\n551:     /// `arg_span` is on `callee_span`'s line. A cross-line decline is recorded (see\n552:     /// `declined_cross_line`) so that if the parse then fails at that token, the error can say\n553:     /// why the call was not taken.\n554:     fn takes_argument(&mut self, callee: &str, callee_span: Span, arg_span: Span) -> bool {\n555:         if self.same_line(callee_span.end, arg_span.start) {\n556:             return true;\n557:         }\n558:         self.declined_cross_line = Some((arg_span.start, callee.to_string()));\n559:         false\n560:     }\n561: \n562:     /// Runs `f` with `or` reading as `separates` says, restoring the caller's reading after.\n563:     fn with_or<T>(\n564:         &mut self,\n565:         separates: bool,\n566:         f: impl FnOnce(&mut Self) -> Result<T, Error>,\n567:     ) -> Result<T, Error> {\n568:         let outer = std::mem::replace(&mut self.or_separates, separates);\n569:         let out = f(self);\n570:         self.or_separates = outer;\n571:         out\n572:     }\n573: \n574:     fn eat_ident(&mut self, what: &str) -> Result<(String, Span), Error> {\n575:         match self.advance()? {\n576:             (Tok::Ident(n), span) => Ok((n, span)),\n577:             (other, span) => Err(Error::new(span, format!(\"expected {what}, found {other}\"))),\n578:         }\n579:     }\n580: \n581:     /// `fn name(param: Type) -> Type = body` or `fn name() -> Type = body`.\n582:     ///\n583:     /// Both annotations are required by the grammar rather than by the checker, which is what\n584:     /// makes the message point at the missing annotation instead of at an inference failure.\n585:     fn def(&mut self, is_pub: bool) -> Result<Def, Error> {\n586:         let start = self.eat(Tok::Fn)?;\n587:         let (name, _) = self.eat_ident(\"a name\")?;\n588:         self.eat(Tok::LParen)?;\n589: \n590:         let (next, _) = self.peek()?;\n591:         let param = if next == Tok::RParen {\n592:             None\n593:         } else {\n594:             let (param_name, param_span) = self.eat_ident(\"a name\")?;\n595:             let (colon, _) = self.peek()?;\n596:             if colon != Tok::Colon {\n597:                 return Err(Error::new(\n598:                     param_span,\n599:                     format!(\"parameter `{param_name}` needs a type annotation\"),\n600:                 ));\n601:             }\n602:             self.advance()?;\n603:             let param_ty = self.type_expr()?;\n604:             Some(Param {\n605:                 span: param_span.to(param_ty.span()),\n606:                 name: param_name,\n607:                 ty: param_ty,\n608:             })\n609:         };\n610: \n611:         let close = self.eat(Tok::RParen)?;\n612:         let (arrow, _) = self.peek()?;\n613:         if arrow != Tok::Arrow {\n614:             return Err(Error::new(\n615:                 close,\n616:                 format!(\"function `{name}` needs a return type\"),\n617:             ));\n618:         }\n619:         self.advance()?;\n620:         let ret = self.type_expr()?;\n621: \n622:         self.eat(Tok::Eq)?;\n623:         let body = self.def_body()?;\n624:         Ok(Def {\n625:             span: start.to(body.span()),\n626:             name,\n627:             param,\n628:             ret,\n629:             body,\n630:             is_pub,\n631:             origin: crate::ast::Origin::Program,\n632:         })\n633:     }\n634: \n635:     /// A function's body. An ordinary expression, or -- when the `let` keyword opens it -- the\n636:     /// local-binding block the ruling on #87 settled on: `let <name> = <expr>` one per line,\n637:     /// then the expression that ends the block, with no `in` keyword. The line that is not a\n638:     /// `let` is the value, so each binding's value has to fit on its own line or the next line\n639:     /// cannot be told apart from the block's result.\n640:     fn def_body(&mut self) -> Result<Expr, Error> {\n641:         let (first, _) = self.peek()?;\n642:         if first != Tok::Let {\n643:             return self.expr(0);\n644:         }\n645:         let first_let = self.advance()?.1;\n646:         let mut bindings = Vec::new();\n647:         let mut binding_start = first_let.start;\n648: \n649:         loop {\n650:             let (name, _) = self.eat_ident(\"a binding name\")?;\n651:             self.eat(Tok::Eq)?;\n652:             let value = self.expr(0)?;\n653:             if !self.same_line(binding_start, value.span().end) {\n654:                 return Err(Error::new(\n655:                     value.span(),\n656:                     \"a `let` binding must fit on its line; write the whole `let <name> = <expr>` \\\n657:                      on one line and let the next line be another `let` or the block's value\"\n658:                         .to_string(),\n659:                 ));\n660:             }\n661:             bindings.push((name, value));\n662:             if self.peek()?.0 == Tok::Let {\n663:                 binding_start = self.advance()?.1.start;\n664: \n665:                 continue;\n666:             }\n667:             break;\n668:         }\n669:         let body = self.expr(0)?;\n670:         let span = first_let.to(body.span());\n671:         Ok(Expr::Let {\n672:             bindings,\n673:             body: Box::new(body),\n674:             span,\n675:         })\n676:     }\n677: \n678:     /// `Str`, `Int`, `Bool`, `Vec<T>`, `Stream<T>`, or any declared name -- with\n679:     /// `<...>` arguments when the name is a generic enum's. The parser accepts arguments on\n\n(Showing lines 380-679 of 1435. Use offset=680 to continue.)\n</content>","metadata":{"preview":"        or_separates: false,\n    };\n\n    // Declarations in an