{"type":"tool_use","timestamp":1788292017560,"sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","part":{"type":"tool","tool":"read","callID":"call_2e1e3ec6fe6b4338bbafc54c","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-153/src/fmt_tree.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-153/src/fmt_tree.rs</path>\n<type>file</type>\n<content>\n1: //! The project-wide half of `toylang fmt`: walk a folder, and either report which files are not\n2: //! in canonical form or rewrite them. The filter half is one `toylang::fmt` call, and stays in\n3: //! `main.rs`.\n4: //!\n5: //! Nothing here stops at the first problem. A file the formatter cannot handle is recorded and\n6: //! the walk continues, so one unparseable file does not hide the state of the rest of the tree.\n7: \n8: use std::path::{Path, PathBuf};\n9: \n10: /// Only `.toy` files. A `toylang` fence inside a markdown page is formattable source too, and\n11: /// `tests/fmt_examples.rs` holds every fence under `docs/` to canonical form, but rewriting one\n12: /// means editing the page around it: not something a walk should do to a reader's prose.\n13: const EXTENSION: &str = \"toy\";\n14: \n15: #[derive(Clone, Copy, PartialEq, Eq)]\n16: pub enum Mode {\n17:     /// Report what would change, write nothing.\n18:     Check,\n19:     /// Rewrite in place.\n20:     Write,\n21: }\n22: \n23: #[derive(Default)]\n24: pub struct Report {\n25:     /// The files not in canonical form: listed under `Check`, rewritten under `Write`.\n26:     pub changed: Vec<PathBuf>,\n27:     /// What the walk could not format, and why: an unreadable file or folder, a source the\n28:     /// parser rejected, a rewrite that failed.\n29:     pub failed: Vec<(PathBuf, String)>,\n30: }\n31: \n32: impl Report {\n33:     /// The exit condition both modes share: a run that found something is a failed run, whether\n34:     /// or not it did anything about it.\n35:     pub fn is_clean(&self) -> bool {\n36:         self.changed.is_empty() && self.failed.is_empty()\n37:     }\n38: }\n39: \n40: /// Checks, or formats, every `.toy` file under `root`.\n41: pub fn run(root: &Path, mode: Mode) -> Report {\n42:     let mut report = Report::default();\n43:     let mut paths = Vec::new();\n44:     collect(root, &mut paths, &mut report);\n45:     // Directory order is whatever the filesystem hands back, which differs between machines and\n46:     // between runs on the same one. The listing is the output of this command, so it is sorted.\n47:     paths.sort();\n48:     for path in paths {\n49:         format_one(&path, mode, &mut report);\n50:     }\n51:     report\n52: }\n53: \n54: fn format_one(path: &Path, mode: Mode, report: &mut Report) {\n55:     let mut fail = |e: String| report.failed.push((path.to_path_buf(), e));\n56:     let src = match std::fs::read_to_string(path) {\n57:         Ok(src) => src,\n58:         Err(e) => return fail(e.to_string()),\n59:     };\n60:     let formatted = match crate::fmt(&src) {\n61:         Ok(formatted) => formatted,\n62:         Err(e) => return fail(e.to_string()),\n63:     };\n64:     if formatted == src {\n65:         return;\n66:     }\n67:     if mode == Mode::Write\n68:         && let Err(e) = std::fs::write(path, &formatted)\n69:     {\n70:         return fail(e.to_string());\n71:     }\n72:     report.changed.push(path.to_path_buf());\n73: }\n74: \n75: /// `target` and `node_modules` are build and cache trees; `site` is this project's own docs\n76: /// app, which holds no toylang source of its own. Skipped by exact name at any depth.\n77: const SKIP_DIRS: &[&str] = &[\"target\", \"node_modules\", \"site\"];\n78: \n79: /// Hidden entries are skipped: a walk from the current folder would otherwise descend into\n80: /// `.git`, and a leading dot is the usual way a folder says it is not the project's own source.\n81: /// Symlinks are skipped as well, both kinds: a link cycle would hang the walk, and rewriting\n82: /// through a link edits a file outside the tree that was walked. `SKIP_DIRS` names the rest.\n83: fn collect(dir: &Path, out: &mut Vec<PathBuf>, report: &mut Report) {\n84:     let entries = match std::fs::read_dir(dir) {\n85:         Ok(entries) => entries,\n86:         Err(e) => {\n87:             report.failed.push((dir.to_path_buf(), e.to_string()));\n88:             return;\n89:         }\n90:     };\n91:     for entry in entries {\n92:         let entry = match entry {\n93:             Ok(entry) => entry,\n94:             Err(e) => {\n95:                 report.failed.push((dir.to_path_buf(), e.to_string()));\n96:                 continue;\n97:             }\n98:         };\n99:         let name = entry.file_name();\n100:         let name_str = name.to_string_lossy();\n101:         if name_str.starts_with('.') {\n102:             continue;\n103:         }\n104:         if SKIP_DIRS.contains(&name_str.as_ref()) {\n105:             continue;\n106:         }\n107:         let path = entry.path();\n108:         match entry.file_type() {\n109:             Ok(t) if t.is_dir() => collect(&path, out, report),\n110:             Ok(t) if t.is_file() && path.extension().is_some_and(|e| e == EXTENSION) => {\n111:                 out.push(path);\n112:             }\n113:             Ok(_) => {}\n114:             Err(e) => report.failed.push((path, e.to_string())),\n115:         }\n116:     }\n117: }\n\n(End of file - total 117 lines)\n</content>","metadata":{"preview":"//! The project-wide half of `toylang fmt`: walk a folder, and either report which files are not\n//! in canonical form or rewrite them. The filter half is one `toylang::fmt` call, and stays in\n//! `main.rs`.\n//!\n//! Nothing here stops at the first problem. A file the formatter cannot handle is recorded and\n//! the walk continues, so one unparseable file does not hide the state of the rest of the tree.\n\nuse std::path::{Path, PathBuf};\n\n/// Only `.toy` files. A `toylang` fence inside a markdown page is formattable source too, and\n/// `tests/fmt_examples.rs` holds every fence under `docs/` to canonical form, but rewriting one\n/// means editing the page around it: not something a walk should do to a reader's prose.\nconst EXTENSION: &str = \"toy\";\n\n#[derive(Clone, Copy, PartialEq, Eq)]\npub enum Mode {\n    /// Report what would change, write nothing.\n    Check,\n    /// Rewrite in place.\n    Write,","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-153/src/fmt_tree.rs","text":"//! The project-wide half of `toylang fmt`: walk a folder, and either report which files are not\n//! in canonical form or rewrite them. The filter half is one `toylang::fmt` call, and stays in\n//! `main.rs`.\n//!\n//! Nothing here stops at the first problem. A file the formatter cannot handle is recorded and\n//! the walk continues, so one unparseable file does not hide the state of the rest of the tree.\n\nuse std::path::{Path, PathBuf};\n\n/// Only `.toy` files. A `toylang` fence inside a markdown page is formattable source too, and\n/// `tests/fmt_examples.rs` holds every fence under `docs/` to canonical form, but rewriting one\n/// means editing the page around it: not something a walk should do to a reader's prose.\nconst EXTENSION: &str = \"toy\";\n\n#[derive(Clone, Copy, PartialEq, Eq)]\npub enum Mode {\n    /// Report what would change, write nothing.\n    Check,\n    /// Rewrite in place.\n    Write,\n}\n\n#[derive(Default)]\npub struct Report {\n    /// The files not in canonical form: listed under `Check`, rewritten under `Write`.\n    pub changed: Vec<PathBuf>,\n    /// What the walk could not format, and why: an unreadable file or folder, a source the\n    /// parser rejected, a rewrite that failed.\n    pub failed: Vec<(PathBuf, String)>,\n}\n\nimpl Report {\n    /// The exit condition both modes share: a run that found something is a failed run, whether\n    /// or not it did anything about it.\n    pub fn is_clean(&self) -> bool {\n        self.changed.is_empty() && self.failed.is_empty()\n    }\n}\n\n/// Checks, or formats, every `.toy` file under `root`.\npub fn run(root: &Path, mode: Mode) -> Report {\n    let mut report = Report::default();\n    let mut paths = Vec::new();\n    collect(root, &mut paths, &mut report);\n    // Directory order is whatever the filesystem hands back, which differs between machines and\n    // between runs on the same one. The listing is the output of this command, so it is sorted.\n    paths.sort();\n    for path in paths {\n        format_one(&path, mode, &mut report);\n    }\n    report\n}\n\nfn format_one(path: &Path, mode: Mode, report: &mut Report) {\n    let mut fail = |e: String| report.failed.push((path.to_path_buf(), e));\n    let src = match std::fs::read_to_string(path) {\n        Ok(src) => src,\n        Err(e) => return fail(e.to_string()),\n    };\n    let formatted = match crate::fmt(&src) {\n        Ok(formatted) => formatted,\n        Err(e) => return fail(e.to_string()),\n    };\n    if formatted == src {\n        return;\n    }\n    if mode == Mode::Write\n        && let Err(e) = std::fs::write(path, &formatted)\n    {\n        return fail(e.to_string());\n    }\n    report.changed.push(path.to_path_buf());\n}\n\n/// `target` and `node_modules` are build and cache trees; `site` is this project's own docs\n/// app, which holds no toylang source of its own. Skipped by exact name at any depth.\nconst SKIP_DIRS: &[&str] = &[\"target\", \"node_modules\", \"site\"];\n\n/// Hidden entries are skipped: a walk from the current folder would otherwise descend into\n/// `.git`, and a leading dot is the usual way a folder says it is not the project's own source.\n/// Symlinks are skipped as well, both kinds: a link cycle would hang the walk, and rewriting\n/// through a link edits a file outside the tree that was walked. `SKIP_DIRS` names the rest.\nfn collect(dir: &Path, out: &mut Vec<PathBuf>, report: &mut Report) {\n    let entries = match std::fs::read_dir(dir) {\n        Ok(entries) => entries,\n        Err(e) => {\n            report.failed.push((dir.to_path_buf(), e.to_string()));\n            return;\n        }\n    };\n    for entry in entries {\n        let entry = match entry {\n            Ok(entry) => entry,\n            Err(e) => {\n                report.failed.push((dir.to_path_buf(), e.to_string()));\n                continue;\n            }\n        };\n        let name = entry.file_name();\n        let name_str = name.to_string_lossy();\n        if name_str.starts_with('.') {\n            continue;\n        }\n        if SKIP_DIRS.contains(&name_str.as_ref()) {\n            continue;\n        }\n        let path = entry.path();\n        match entry.file_type() {\n            Ok(t) if t.is_dir() => collect(&path, out, report),\n            Ok(t) if t.is_file() && path.extension().is_some_and(|e| e == EXTENSION) => {\n                out.push(path);\n            }\n            Ok(_) => {}\n            Err(e) => report.failed.push((path, e.to_string())),\n        }\n    }\n}","lineStart":1,"lineEnd":117,"totalLines":117,"truncated":false}},"title":"src/fmt_tree.rs","time":{"start":1788292017547,"end":1788292017558}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_05e82ad830018kulapt7dvs372","sessionID":"ses_fa17fa8b8ffeRDvLpqU7vbxt5Y","messageID":"msg_05e82890a001CBT1y5g36Xvl5b"}}
