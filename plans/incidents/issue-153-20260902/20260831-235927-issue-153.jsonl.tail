ple = \"fn triangle(m: Int) -> Int = m * (m + 1) / 2\\n\\\n92:                   \\n\\\n93:                   fn sum_of_multiples(p: {k: Int, limit: Int}) -> Int =\\n\\\n94:                   \\x20   triangle((p.limit - 1) / p.k) * p.k\\n\\\n95:                   \\n\\\n96:                   sum_of_multiples({k: 3, limit: 1000}) + sum_of_multiples({k: 5, limit: 1000}) -\\n\\\n97:                   \\x20   sum_of_multiples({k: 15, limit: 1000})\\n\";\n98:     assert_eq!(toylang::fmt(sample).unwrap(), sample);\n99: }\n100: \n101: /// A pipeline that overflows the width breaks one stage per line, `|` leading each continuation\n102: /// line so the pipes draw a vertical column (issue #101) -- the opposite of `Binary`'s trailing\n103: /// rule, which pipelines used to follow by analogy before the maintainer pinned this shape.\n104: #[test]\n105: fn a_pipeline_that_does_not_fit_breaks_one_stage_per_line_pipe_first() {\n106:     let src = \"range(1000)\\n\\\n107:                \\x20   | select(. > 5)\\n\\\n108:                \\x20   | select(. < 1000 - somewhatlongvariablename)\\n\\\n109:                \\x20   | map(. * 2)\\n\";\n110:     assert_eq!(toylang::fmt(src).unwrap(), src);\n111: }\n112: \n113: /// The one piece of source text `emit_toylang::emit` cannot reconstruct from the parsed tree --\n114: /// see its module doc -- is a leading comment banner, which `fmt` reattaches from the raw text\n\n(Showing lines 55-114 of 140. Use offset=115 to continue.)\n</content>","metadata":{"preview":"    let mut failures = Vec::new();\n\n    for case in &cases {\n        let formatted = match toylang::fmt(&case.program) {\n            Ok(s) => s,\n            Err(e) => {\n                failures.push(format!(\"{}: fmt failed: {e}\", case.name));\n                continue;\n            }\n        };\n        let before = toylang::run_on(&case.program, case.input.as_deref(), toylang::Backend::Lua);\n        let after = toylang::run_on(&formatted, case.input.as_deref(), toylang