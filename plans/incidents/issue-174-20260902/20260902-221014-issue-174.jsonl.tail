{"type":"tool_use","timestamp":1788379883819,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"type":"tool","tool":"read","callID":"call_9dd0a535934d49eda543aad6","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-174/src/check/mod.rs","limit":560,"offset":1530},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-174/src/check/mod.rs</path>\n<type>file</type>\n<content>\n1530:             subject: Box::new(subject),\n1531:             arms: out,\n1532:             partial,\n1533:         },\n1534:     ))\n1535: }\n1536: \n1537: fn synth(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\n1538:     let tir = synth_inner(ctx, expr)?;\n1539:     // A sink is not a value, so it can exist only where `tail_pipe` or `sink_call` recognized a\n1540:     // sink position: the program's own body or a Sink-returning function's. Reaching `synth`\n1541:     // with a sink means it is nested where its output would be observed, which is the general\n1542:     // position rule.\n1543:     if tir.ty.contains_sink() {\n1544:         return Err(Error::new(\n1545:             expr.span(),\n1546:             \"a sink is not a value, so it is legal only as the program's outermost expression \\\n1547:              or a Sink-returning function's body\"\n1548:                 .to_string(),\n1549:         ));\n1550:     }\n1551:     Ok(tir)\n1552: }\n1553: \n1554: fn synth_inner(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\n1555:     match expr {\n1556:         Expr::Str { text, .. } => Ok(Tir::new(Type::Str, Kind::Str(text.clone()))),\n1557:         Expr::Lines { span } => {\n1558:             if let Some(func) = ctx.in_fn {\n1559:                 return Err(source_in_fn(*span, \"lines\", func));\n1560:             }\n1561:             if ctx.in_mapper {\n1562:                 return Err(Error::new(\n1563:                     *span,\n1564:                     \"`lines` cannot be read inside a mapper body, which runs once per element\"\n1565:                         .to_string(),\n1566:                 ));\n1567:             }\n1568:             if ctx.lines_used.get() {\n1569:                 return Err(Error::new(\n1570:                     *span,\n1571:                     \"`lines` has already been read; there is only one stdin\".to_string(),\n1572:                 ));\n1573:             }\n1574:             ctx.lines_used.set(true);\n1575:             Ok(Tir::new(Type::Stream(Box::new(Type::Str)), Kind::Lines))\n1576:         }\n1577:         // `dsv` reads the same raw lines `lines` does and splits each on the delimiter, so it\n1578:         // shares every rule: refused in function and mapper bodies, read at most once, and its\n1579:         // type is fixed (`Vec<Vec<Str>>`) rather than borrowed from a position. `csv`/`tsv`\n1580:         // are this same node with the delimiter already fixed by the parser.\n1581:         Expr::Dsv { delim, span } => {\n1582:             if let Some(func) = ctx.in_fn {\n1583:                 return Err(Error::new(\n1584:                     *span,\n1585:                     format!(\n1586:                         \"`dsv` cannot be read inside `fn {func}`; a source is legal only in \\\n1587:                          the program's own body, so take the value through a parameter\"\n1588:                     ),\n1589:                 ));\n1590:             }\n1591:             if ctx.in_mapper {\n1592:                 return Err(Error::new(\n1593:                     *span,\n1594:                     \"`dsv` cannot be read inside a mapper body, which runs once per element\"\n1595:                         .to_string(),\n1596:                 ));\n1597:             }\n1598:             // Every backend's split on an empty separator is its own undefined behaviour (Rust\n1599:             // panics, Python raises, jq matches nothing), so the empty delimiter is refused\n1600:             // rather than left to disagree.\n1601:             if delim.is_empty() {\n1602:                 return Err(Error::new(\n1603:                     *span,\n1604:                     \"`dsv`'s delimiter cannot be empty\".to_string(),\n1605:                 ));\n1606:             }\n1607:             if ctx.dsv.borrow().is_some() {\n1608:                 return Err(Error::new(\n1609:                     *span,\n1610:                     \"`dsv` has already been read; there is only one stdin\".to_string(),\n1611:                 ));\n1612:             }\n1613:             *ctx.dsv.borrow_mut() = Some(delim.clone());\n1614:             let field = Type::Vec(Box::new(Type::Str));\n1615:             Ok(Tir::new(\n1616:                 Type::Vec(Box::new(field)),\n1617:                 Kind::Dsv { delim: delim.clone() },\n1618:             ))\n1619:         }\n1620:         Expr::Int { value, span } => {\n1621:             // The literal is the one place a value could enter without meeting the 32-bit rule,\n1622:             // and four backends agreed on the wrong answer only because each held it in its own\n1623:             // wider representation until an operator wrapped it. Go refuses to compile such a\n1624:             // constant at all, which is what made the hole visible. A wider literal is not\n1625:             // guessed to be Int64 -- `expect_inner` resolves one only where an Int64 is\n1626:             // already expected, the same rule `[]` follows.\n1627:             if *value > i32::MAX as i64 {\n1628:                 return Err(Error::new(\n1629:                     *span,\n1630:                     format!(\n1631:                         \"integer `{value}` does not fit in Int, which is 32 bits; only a \\\n1632:                          position that expects Int64 can hold it\"\n1633:                     ),\n1634:                 ));\n1635:             }\n1636:             Ok(Tir::new(Type::Int, Kind::Int(*value)))\n1637:         }\n1638: \n1639:         // A float literal is exactly the binary64 it spells (ADR 0007): there is no width to\n1640:         // resolve and no range to check, so a position has nothing to contribute, unlike Int.\n1641:         Expr::Float { value, span } => {\n1642:             let _ = span;\n1643:             Ok(Tir::new(Type::Float, Kind::Float(*value)))\n1644:         }\n1645: \n1646:         Expr::Subject { span } => match &ctx.subject {\n1647:             Some((ty, id)) => Ok(Tir::new(ty.clone(), Kind::Local(*id))),\n1648:             None => Err(Error::new(*span, \"`.` is not bound here\")),\n1649:         },\n1650: \n1651:         // Innermost binding first: a pattern binding shadows a parameter, and a parameter\n1652:         // shadows a variant, the way any binding shadows a constant.\n1653:         Expr::Var { name, span } => {\n1654:             if let Some((_, payload_ty, pid)) =\n1655:                 ctx.arm_fields.iter().rev().find(|(n, _, _)| n == name)\n1656:             {\n1657:                 let fty = payload_ty\n1658:                     .field(name)\n1659:                     .expect(\"the field existed when the pattern was checked\")\n1660:                     .clone();\n1661:                 let base = Tir::new(payload_ty.clone(), Kind::Local(*pid));\n1662:                 return Ok(Tir::new(\n1663:                     fty,\n1664:                     Kind::Field {\n1665:                         base: Box::new(base),\n1666:                         name: name.clone(),\n1667:                     },\n1668:                 ));\n1669:             }\n1670:             if let Some((_, t, local)) = ctx.scope.iter().rev().find(|(n, _, _)| n == name) {\n1671:                 return match local {\n1672:                     // A `let`-bound name reads the local it was bound to, not a `Var`: the\n1673:                     // backends' `Bind` only ever binds locals, so a bare name reference would dangle.\n1674: \n1675:                     Some(id) => Ok(Tir::new(t.clone(), Kind::Local(*id))),\n1676:                     None => Ok(Tir::new(t.clone(), Kind::Var(name.clone()))),\n1677:                 };\n1678:             }\n1679:             if let Some(owners) = ctx.variant_owners.get(name) {\n1680:                 let enum_ty = sole_owner(ctx, name, owners, *span)?.clone();\n1681:                 return construct(ctx, &enum_ty, name, *span, None, None, false);\n1682:             }\n1683:             // A function is not a value, but \"`f` is not defined\" for a defined function is a\n1684:             // lie. This is where `f -1` lands: `-` cannot start a bare argument, so the parse\n1685:             // is subtraction and `f` arrives here alone.\n1686:             if ctx.sigs.contains_key(name) || BUILTIN_NAMES.contains(&name.as_str()) {\n1687:                 return Err(Error::new(\n1688:                     *span,\n1689:                     format!(\"`{name}` is a function, not a value; write `{name}(...)` to call it\"),\n1690:                 ));\n1691:             }\n1692:             Err(Error::new(*span, format!(\"`{name}` is not defined\")))\n1693:         }\n1694: \n1695:         Expr::RecordLit { fields, .. } => {\n1696:             let mut built: Vec<(String, Tir)> = Vec::new();\n1697:             for (name, name_span, value) in fields {\n1698:                 if built.iter().any(|(seen, _)| seen == name) {\n1699:                     return Err(Error::new(\n1700:                         *name_span,\n1701:                         format!(\"field `{name}` is given twice\"),\n1702:                     ));\n1703:                 }\n1704:                 let field = synth(ctx, value)?;\n1705:                 // A stream can never enter a record: a record's fields can be printed, copied,\n1706:                 // and read back out by name, none of which make sense for a single-use stream,\n1707:                 // and no path exists for a stream-typed field to leave one again once inside.\n1708:                 if field.ty.contains_stream() {\n1709:                     return Err(Error::new(\n1710:                         value.span(),\n1711:                         format!(\"`{name}` cannot hold a stream, which has nothing to store\"),\n1712:                     ));\n1713:                 }\n1714:                 built.push((name.clone(), field));\n1715:             }\n1716:             // Declaration order, kept as written: the type's field list and this literal's\n1717:             // fields stay index-for-index aligned, which is what the columnar backends key on.\n1718:             let ty = Type::Record(\n1719:                 built\n1720:                     .iter()\n1721:                     .map(|(n, t)| (n.clone(), t.ty.clone()))\n1722:                     .collect(),\n1723:             );\n1724:             Ok(Tir::new(ty, Kind::RecordLit { fields: built }))\n1725:         }\n1726: \n1727:         Expr::VecLit { items, span } => {\n1728:             let Some(first) = items.first() else {\n1729:                 // Nothing says what an empty literal contains, and there is no expected type to\n1730:                 // supply it. Guessing here is what the annotation rule exists to avoid.\n1731:                 return Err(Error::new(*span, \"cannot tell what `[]` contains\"));\n1732:             };\n1733:             let head = synth(ctx, first)?;\n1734:             let elem = head.ty.clone();\n1735:             // Same reasoning as a record field: nothing can get a stream back out of a Vec\n1736:             // once it is in one, and a Vec of them makes no sense when there is only ever one\n1737:             // real stdin to begin with.\n1738:             if elem.contains_stream() {\n1739:                 return Err(Error::new(\n1740:                     first.span(),\n1741:                     \"a Vec cannot hold a stream, which has nothing to store\".to_string(),\n1742:                 ));\n1743:             }\n1744:             let mut out = vec![head];\n1745:             for item in &items[1..] {\n1746:                 out.push(expect(ctx, item, &elem)?);\n1747:             }\n1748:             Ok(Tir::new(Type::Vec(Box::new(elem)), Kind::VecLit(out)))\n1749:         }\n1750: \n1751:         Expr::Pipe { lhs, rhs, .. } => match pipe(ctx, lhs, rhs, None)? {\n1752:             Expected::Checked(tir) | Expected::Synthesised(tir) => Ok(tir),\n1753:         },\n1754: \n1755:         // A `|>` node only ever appears as a program's or a Sink-returning function's body,\n1756:         // which `check_program_body` and `check_defs` handle before `synth` is reached. A `Sink`\n1757:         // result here is refused by `synth`'s wrapper with the general position rule, so this\n1758:         // arm exists for totality and is only reachable through a shape the parser cannot make.\n1759:         Expr::TailPipe { .. } => tail_pipe(ctx, expr),\n1760: \n1761:         Expr::Field { .. } | Expr::Index { .. } | Expr::Slice { .. } | Expr::Unwrap { .. } => {\n1762:             let Access { tir, stream, .. } = access(ctx, expr)?;\n1763:             // Projection over a stream is a mapper, and it is normalized to one here: the chain\n1764:             // is rebased onto a fresh per-element param, so neither the backends nor fusion\n1765:             // ever see a Field, Index, or Unwrap whose base is stream-typed.\n1766:             if stream {\n1767:                 let param = ctx.fresh();\n1768:                 let Rebased { body, source } = rebase(tir, param);\n1769:                 return Ok(Tir::new(\n1770:                     Type::Stream(Box::new(body.ty.clone())),\n1771:                     Kind::Map {\n1772:                         source: Box::new(source),\n1773:                         param,\n1774:                         body: Box::new(body),\n1775:                     },\n1776:                 ));\n1777:             }\n1778:             Ok(tir)\n1779:         }\n1780: \n1781:         // `v[]` with nothing after it is the identity: \"keep every entry\" is what a Vec (or\n1782:         // stream) already is, with no field/index/unwrap left to distribute across it.\n1783:         Expr::Project { .. } => {\n1784:             let access = access(ctx, expr)?;\n1785:             Ok(access.tir)\n1786:         }\n1787: \n1788:         // `input` names one value, so its first checked use fixes the type for the whole\n1789:         // program -- and a later use in a position that expects nothing can borrow what the\n1790:         // first use fixed. With no use typed yet, nothing says what it contains, and guessing\n1791:         // is what the annotation rule avoids.\n1792:         Expr::Input { span } => match ctx.input.borrow().as_ref() {\n1793:             Some(ty) => Ok(Tir::new(ty.clone(), Kind::Input)),\n1794:             None => Err(Error::new(*span, \"cannot tell what `input` contains\")),\n1795:         },\n1796:         Expr::Inputs { span } => match ctx.in_fn {\n1797:             Some(func) => Err(source_in_fn(*span, \"inputs\", func)),\n1798:             None => Err(Error::new(*span, \"cannot tell what `inputs` contains\")),\n1799:         },\n1800: \n1801:         Expr::Call {\n1802:             func,\n1803:             func_span,\n1804:             arg,\n1805:             span,\n1806:         } => call(ctx, func, *func_span, arg, *span),\n1807: \n1808:         Expr::Match { arms, span } => match_chain(ctx, arms, *span, None),\n1809: \n1810:         Expr::Variant {\n1811:             enum_name,\n1812:             enum_span,\n1813:             variant,\n1814:             variant_span,\n1815:             payload,\n1816:             ..\n1817:         } => {\n1818:             let Some(enum_ty) = ctx.enums.get(enum_name) else {\n1819:                 return Err(Error::new(\n1820:                     *enum_span,\n1821:                     format!(\"`{enum_name}` is not an enum\"),\n1822:                 ));\n1823:             };\n1824:             construct(\n1825:                 ctx,\n1826:                 &enum_ty.clone(),\n1827:                 variant,\n1828:                 *variant_span,\n1829:                 payload.as_deref(),\n1830:                 None,\n1831:                 false,\n1832:             )\n1833:         }\n1834: \n1835:         Expr::Neg { base, span } => {\n1836:             // A minus directly on a literal is part of the literal, so the most negative Int can\n1837:             // be written even though its magnitude is one past the most positive. This is the\n1838:             // rule Rust uses, and it is why `-` was not folded into the lexer: `a -1` has to\n1839:             // stay `a - 1`.\n1840:             if let Expr::Int { value, span: lit } = base.as_ref() {\n1841:                 if *value > -(i32::MIN as i64) {\n1842:                     return Err(Error::new(\n1843:                         *lit,\n1844:                         format!(\n1845:                             \"integer `-{value}` does not fit in Int, which is 32 bits; only a \\\n1846:                              position that expects Int64 can hold it\"\n1847:                         ),\n1848:                     ));\n1849:                 }\n1850:                 return Ok(Tir::new(Type::Int, Kind::Int(-value)));\n1851:             }\n1852:             if let Expr::Float { value, .. } = base.as_ref() {\n1853:                 return Ok(Tir::new(Type::Float, Kind::Float(-value)));\n1854:             }\n1855:             // Synthesise first, so `-x` works at whichever integer width `x` already has; a\n1856:             // form that can only be checked (`-input` fixing input to Int) falls back to the\n1857:             // Int expectation this arm always applied.\n1858:             let inner = match synth(ctx, base) {\n1859:                 Ok(inner) if matches!(inner.ty, Type::Int | Type::Int64 | Type::Float) => inner,\n1860:                 Ok(inner) => {\n1861:                     return Err(Error::new(\n1862:                         base.span(),\n1863:                         format!(\"expected Int, found {}\", inner.ty),\n1864:                     ));\n1865:                 }\n1866:                 Err(_) => expect(ctx, base, &Type::Int)?,\n1867:             };\n1868:             let width = inner.ty.clone();\n1869:             let zero = Tir::new(width.clone(), Kind::Int(0));\n1870:             let _ = span;\n1871:             Ok(Tir::new(\n1872:                 width,\n1873:                 Kind::Arith {\n1874:                     op: BinOp::Sub,\n1875:                     lhs: Box::new(zero),\n1876:                     rhs: Box::new(inner),\n1877:                 },\n1878:             ))\n1879:         }\n1880: \n1881:         Expr::Binary { op, lhs, rhs, .. } => binary(ctx, *op, lhs, rhs),\n1882: \n1883:         // The connectives are the one place a subexpression may go unevaluated: `and` runs its\n1884:         // right side only when the left is true, `or` only when it is false. Nothing here has\n1885:         // to say so -- every backend emits its own short-circuiting operator -- but it is why\n1886:         // `x != 0 and 10 / x > 1` is a program and not a division by zero.\n1887:         Expr::Logic { op, lhs, rhs, .. } => {\n1888:             let lhs = expect(ctx, lhs, &Type::Bool)?;\n1889:             let rhs = expect(ctx, rhs, &Type::Bool)?;\n1890:             Ok(Tir::new(\n1891:                 Type::Bool,\n1892:                 Kind::Logic {\n1893:                     op: *op,\n1894:                     lhs: Box::new(lhs),\n1895:                     rhs: Box::new(rhs),\n1896:                 },\n1897:             ))\n1898:         }\n1899: \n1900:         Expr::Not { base, .. } => {\n1901:             let base = expect(ctx, base, &Type::Bool)?;\n1902:             Ok(Tir::new(Type::Bool, Kind::Not(Box::new(base))))\n1903:         }\n1904: \n1905:         // A `let` block is only reachable as a function body, which is always checked against an\n1906:         // expected return type, so `expect_inner` owns it. `synth` has no want to hand the block's\n1907:         // value, so this arm is unreachable in practice but must exist for the match to be total.\n1908:         Expr::Let { bindings, body, .. } => match let_bind(ctx, bindings, body, None)? {\n1909:             Expected::Checked(_) => unreachable!(\"synth has no want, so nothing is Checked\"),\n1910:             Expected::Synthesised(tir) => Ok(tir),\n1911:         }\n1912:     }\n1913: }\n1914: \n1915: /// `synth`'s `Expr::Call` arm, pulled out on its own: a call is one of `select`/`map` (special\n1916: /// forms rebinding `.`), a fixed sink or polymorphic builtin, or an ordinary user function or\n1917: /// payload-constructor lookup, each with its own argument shape to check.\n1918: fn call(\n1919:     ctx: &Ctx,\n1920:     func: &str,\n1921:     func_span: Span,\n1922:     arg: &Option<Box<Expr>>,\n1923:     span: Span,\n1924: ) -> Result<Tir, Error> {\n1925:     // `select` and `map` are not special syntax, only special names: they are ordinary calls\n1926:     // whose argument is checked with `.` rebound to the subject's element type instead of\n1927:     // evaluated in the enclosing scope, which no ordinary function needs and is why they cannot\n1928:     // be defined as one (see `signatures`).\n1929:     if func == \"select\" {\n1930:         return select_call(ctx, need_arg(arg, func, span)?, span);\n1931:     }\n1932:     // The one way to produce a new element value. `select` removes elements and a field access\n1933:     // reads a field; neither can turn a Vec<Int> into a Vec<Str>.\n1934:     if func == \"map\" {\n1935:         return map_call(ctx, need_arg(arg, func, span)?, span, None);\n1936:     }\n1937:     // The one sink builtin: a regular call now, typed `Sink`, and so subject to the same\n1938:     // general position rule every sink is -- `synth`'s wrapper refuses a `Sink` result except\n1939:     // where `sink_call` or the tail-pipeline `|>` (`tail_pipe`) born it. The old hand-checked\n1940:     // `jsonlines` position in `check_program_body` retired in favor of that rule.\n1941:     if func == \"jsonlines\" {\n1942:         return jsonlines_call(ctx, arg, span);\n1943:     }\n1944:     // `length`, `tail`, and `flatten` are polymorphic over the element type, the same reason\n1945:     // `jsonlines` is checked here rather than through `builtin()`'s fixed table.\n1946:     if func == \"length\" {\n1947:         return length_call(ctx, need_arg(arg, func, span)?);\n1948:     }\n1949:     // `None` on an empty Vec, the same way `Index` turns reaching past what's there into `Opt`\n1950:     // rather than a runtime failure.\n1951:     if func == \"tail\" {\n1952:         return tail_call(ctx, need_arg(arg, func, span)?);\n1953:     }\n1954:     // Flattens a Vec<Vec<T>> into a Vec<T>, the way jq's `add` flattens a list of arrays.\n1955:     // Joining a fixed, known count of Vecs is `+` (kantord/toylang#97); this is for when the\n1956:     // outer Vec's length is not known at the call site.\n1957:     if func == \"flatten\" {\n1958:         return flatten_call(ctx, need_arg(arg, func, span)?);\n1959:     }\n1960:     // The one exit a stream has: `Stream<T> -> Vec<T>`, polymorphic over the element type like\n1961:     // `length` and the others above, so the argument is synthesised first.\n1962:     if func == \"collect\" {\n1963:         return collect(ctx, need_arg(arg, func, span)?, None);\n1964:     }\n1965:     // Polymorphic over which record, the same reason `length` is checked here: the return type\n1966:     // (`Vec<Str>`) is fixed, but the argument's shape is not.\n1967:     if func == \"fields\" {\n1968:         return fields_call(ctx, need_arg(arg, func, span)?);\n1969:     }\n1970:     // Blocking, one Vec in and one Vec out with no Stream instance (kantord/toylang#86, Q20 in\n1971:     // draft.md), so both are checked here rather than through `select`'s subject-context\n1972:     // mechanism.\n1973:     if func == \"sort\" {\n1974:         return sort_call(ctx, need_arg(arg, func, span)?);\n1975:     }\n1976:     if func == \"reverse\" {\n1977:         return reverse_call(ctx, need_arg(arg, func, span)?);\n1978:     }\n1979:     // The two reductions (kantord/toylang#140): `sum` folds `+` at the element width, `max`\n1980:     // returns `Opt` because an empty Vec has no maximum. Both are checked here rather than\n1981:     // through `builtin()`'s fixed table because the return type is the element type's, which\n1982:     // no fixed signature can express.\n1983:     if func == \"sum\" {\n1984:         return sum_call(ctx, need_arg(arg, func, span)?);\n1985:     }\n1986:     if func == \"max\" {\n1987:         return max_call(ctx, need_arg(arg, func, span)?);\n1988:     }\n1989:     if let Some((which, sig)) = builtin(func) {\n1990:         let param_ty = sig\n1991:             .param\n1992:             .as_ref()\n1993:             .expect(\"every builtin in the fixed table is unary\");\n1994:         let arg = expect(ctx, need_arg(arg, func, span)?, param_ty)?;\n1995:         return Ok(Tir::new(\n1996:             sig.ret,\n1997:             Kind::Builtin {\n1998:                 which,\n1999:                 arg: Box::new(arg),\n2000:             },\n2001:         ));\n2002:     }\n2003:     let Some(sig) = ctx.sigs.get(func) else {\n2004:         // A payload constructor is ordinary application (the Q34 path), so `circle{r: 1}` lands\n2005:         // here; it resolves as a variant only after the function namespace declines.\n2006:         if let Some(owners) = ctx.variant_owners.get(func) {\n2007:             let enum_ty = sole_owner(ctx, func, owners, func_span)?.clone();\n2008:             return construct(ctx, &enum_ty, func, func_span, arg.as_deref(), None, false);\n2009:         }\n2010:         return Err(Error::new(func_span, format!(\"`{func}` is not a function\")));\n2011:     };\n2012:     // A non-`pub` definition is a helper for its own file: it may be called from where it was\n2013:     // defined, and nowhere else. `file` is the caller's file, so a `Prelude`-origin private\n2014:     // helper is refused from the program's file while remaining legal inside prelude.toy -- the\n2015:     // same privacy a `pub` prelude function already kept from calling a private helper, now\n2016:     // stated as a per-call-site rule rather than by dropping the helper (gh:166).\n2017:     if let Some((origin, is_pub)) = ctx.visibility.get(func)\n2018:         && !is_pub\n2019:         && *origin != ctx.file\n2020:     {\n2021:         return Err(Error::new(\n2022:             func_span,\n2023:             format!(\"`{func}` is not `pub`, so it can only be called from its own file\"),\n2024:         ));\n2025:     }\n2026:     let arg = call_arg(ctx, func, span, &sig.param, arg)?;\n2027:     Ok(Tir::new(\n2028:         sig.ret.clone(),\n2029:         Kind::Call {\n2030:             func: func.to_string(),\n2031:             arg,\n2032:         },\n2033:     ))\n2034: }\n2035: \n2036: /// A user function's argument against its (optionally nullary) signature: the four arity/type\n2037: /// combinations a call and a signature can be in relative to each other.\n2038: fn call_arg(\n2039:     ctx: &Ctx,\n2040:     func: &str,\n2041:     span: Span,\n2042:     param_ty: &Option<Type>,\n2043:     arg: &Option<Box<Expr>>,\n2044: ) -> Result<Option<Box<Tir>>, Error> {\n2045:     match (param_ty, arg) {\n2046:         (Some(param_ty), Some(arg)) => Ok(Some(Box::new(expect(ctx, arg, param_ty)?))),\n2047:         (None, None) => Ok(None),\n2048:         (Some(param_ty), None) => Err(Error::new(\n2049:             span,\n2050:             format!(\"`{func}` needs an argument of {param_ty}, but was called with none\"),\n2051:         )),\n2052:         (None, Some(arg)) => Err(Error::new(\n2053:             arg.span(),\n2054:             format!(\"`{func}` takes no argument\"),\n2055:         )),\n2056:     }\n2057: }\n2058: \n2059: /// Cardinality-polymorphic: the same subject-context mechanism types `select` over a Vec and\n2060: /// over a Stream, with the element drawn from either's parameter. Stream in, stream out.\n2061: fn select_call(ctx: &Ctx, arg: &Expr, span: Span) -> Result<Tir, Error> {\n2062:     let Some((subject, id)) = ctx.subject.clone() else {\n2063:         return Err(Error::new(\n2064:             span,\n2065:             \"`select` needs a subject, so it must follow `|`\",\n2066:         ));\n2067:     };\n2068:     let Some(elem) = mapper_elem(&subject) else {\n2069:         return Err(Error::new(\n2070:             span,\n2071:             format!(\"`select` needs a Vec or a stream, found {subject}\"),\n2072:         ));\n2073:     };\n2074:     let param = ctx.fresh();\n2075:     let inner = mapper_ctx(ctx, elem, param);\n2076:     let pred = expect(&inner, arg, &Type::Bool)?;\n2077:     let source = Tir::new(subject.clone(), Kind::Local(id));\n2078:     Ok(Tir::new(\n2079:         subject,\n2080:         Kind::Select {\n2081:             source: Box::new(source),\n2082:             param,\n2083:             pred: Box::new(pred),\n2084:         },\n2085:     ))\n2086: }\n2087: \n2088: /// `jsonlines(x)`, the one sink builtin, typed `Sink`. A sink is not a value, so a direct call\n2089: /// survives only where `sink_call` recognized the sink position (the program's body or a\n\n(Showing lines 1530-2089 of 3239. Use offset=2090 to continue.)\n</content>","metadata":{"preview":"            subject: Box::new(subject),\n            arms: out,\n            partial,\n        },\n    ))\n}\n\nfn synth(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\n    let tir = synth_inner(ctx, expr)?;\n    // A sink is not a value, so it can exist only where `tail_pipe` or `sink_call` recognized a\n    // sink position: the program's own body or a Sink-returning function's. Reaching `synth`\n    // with a sink means it is nested where its output would be observed, which is the general\n    // position rule.\n    if tir.ty.contains_sink() {\n        return Err(Error::new(\n            expr.span(),\n            \"a sink is not a value, so it is legal only as the program's outermost expression \\\n             or a Sink-returning function's body\"\n                .to_string(),\n        ));","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-174/src/check/mod.rs","text":"            subject: Box::new(subject),\n            arms: out,\n            partial,\n        },\n    ))\n}\n\nfn synth(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\n    let tir = synth_inner(ctx, expr)?;\n    // A sink is not a value, so it can exist only where `tail_pipe` or `sink_call` recognized a\n    // sink position: the program's own body or a Sink-returning function's. Reaching `synth`\n    // with a sink means it is nested where its output would be observed, which is the general\n    // position rule.\n    if tir.ty.contains_sink() {\n        return Err(Error::new(\n            expr.span(),\n            \"a sink is not a value, so it is legal only as the program's outermost expression \\\n             or a Sink-returning function's body\"\n                .to_string(),\n        ));\n    }\n    Ok(tir)\n}\n\nfn synth_inner(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\n    match expr {\n        Expr::Str { text, .. } => Ok(Tir::new(Type::Str, Kind::Str(text.clone()))),\n        Expr::Lines { span } => {\n            if let Some(func) = ctx.in_fn {\n                return Err(source_in_fn(*span, \"lines\", func));\n            }\n            if ctx.in_mapper {\n                return Err(Error::new(\n                    *span,\n                    \"`lines` cannot be read inside a mapper body, which runs once per element\"\n                        .to_string(),\n                ));\n            }\n            if ctx.lines_used.get() {\n                return Err(Error::new(\n                    *span,\n                    \"`lines` has already been read; there is only one stdin\".to_string(),\n                ));\n            }\n            ctx.lines_used.set(true);\n            Ok(Tir::new(Type::Stream(Box::new(Type::Str)), Kind::Lines))\n        }\n        // `dsv` reads the same raw lines `lines` does and splits each on the delimiter, so it\n        // shares every rule: refused in function and mapper bodies, read at most once, and its\n        // type is fixed (`Vec<Vec<Str>>`) rather than borrowed from a position. `csv`/`tsv`\n        // are this same node with the delimiter already fixed by the parser.\n        Expr::Dsv { delim, span } => {\n            if let Some(func) = ctx.in_fn {\n                return Err(Error::new(\n                    *span,\n                    format!(\n                        \"`dsv` cannot be read inside `fn {func}`; a source is legal only in \\\n                         the program's own body, so take the value through a parameter\"\n                    ),\n                ));\n            }\n            if ctx.in_mapper {\n                return Err(Error::new(\n                    *span,\n                    \"`dsv` cannot be read inside a mapper body, which runs once per element\"\n                        .to_string(),\n                ));\n            }\n            // Every backend's split on an empty separator is its own undefined behaviour (Rust\n            // panics, Python raises, jq matches nothing), so the empty delimiter is refused\n            // rather than left to disagree.\n            if delim.is_empty() {\n                return Err(Error::new(\n                    *span,\n                    \"`dsv`'s delimiter cannot be empty\".to_string(),\n                ));\n            }\n            if ctx.dsv.borrow().is_some() {\n                return Err(Error::new(\n                    *span,\n                    \"`dsv` has already been read; there is only one stdin\".to_string(),\n                ));\n            }\n            *ctx.dsv.borrow_mut() = Some(delim.clone());\n            let field = Type::Vec(Box::new(Type::Str));\n            Ok(Tir::new(\n                Type::Vec(Box::new(field)),\n                Kind::Dsv { delim: delim.clone() },\n            ))\n        }\n        Expr::Int { value, span } => {\n            // The literal is the one place a value could enter without meeting the 32-bit rule,\n            // and four backends agreed on the wrong answer only because each held it in its own\n            // wider representation until an operator wrapped it. Go refuses to compile such a\n            // constant at all, which is what made the hole visible. A wider literal is not\n            // guessed to be Int64 -- `expect_inner` resolves one only where an Int64 is\n            // already expected, the same rule `[]` follows.\n            if *value > i32::MAX as i64 {\n                return Err(Error::new(\n                    *span,\n                    format!(\n                        \"integer `{value}` does not fit in Int, which is 32 bits; only a \\\n                         position that expects Int64 can hold it\"\n                    ),\n                ));\n            }\n            Ok(Tir::new(Type::Int, Kind::Int(*value)))\n        }\n\n        // A float literal is exactly the binary64 it spells (ADR 0007): there is no width to\n        // resolve and no range to check, so a position has nothing to contribute, unlike Int.\n        Expr::Float { value, span } => {\n            let _ = span;\n            Ok(Tir::new(Type::Float, Kind::Float(*value)))\n        }\n\n        Expr::Subject { span } => match &ctx.subject {\n            Some((ty, id)) => Ok(Tir::new(ty.clone(), Kind::Local(*id))),\n            None => Err(Error::new(*span, \"`.` is not bound here\")),\n        },\n\n        // Innermost binding first: a pattern binding shadows a parameter, and a parameter\n        // shadows a variant, the way any binding shadows a constant.\n        Expr::Var { name, span } => {\n            if let Some((_, payload_ty, pid)) =\n                ctx.arm_fields.iter().rev().find(|(n, _, _)| n == name)\n            {\n                let fty = payload_ty\n                    .field(name)\n                    .expect(\"the field existed when the pattern was checked\")\n                    .clone();\n                let base = Tir::new(payload_ty.clone(), Kind::Local(*pid));\n                return Ok(Tir::new(\n                    fty,\n                    Kind::Field {\n                        base: Box::new(base),\n                        name: name.clone(),\n                    },\n                ));\n            }\n            if let Some((_, t, local)) = ctx.scope.iter().rev().find(|(n, _, _)| n == name) {\n                return match local {\n                    // A `let`-bound name reads the local it was bound to, not a `Var`: the\n                    // backends' `Bind` only ever binds locals, so a bare name reference would dangle.\n\n                    Some(id) => Ok(Tir::new(t.clone(), Kind::Local(*id))),\n                    None => Ok(Tir::new(t.clone(), Kind::Var(name.clone()))),\n                };\n            }\n            if let Some(owners) = ctx.variant_owners.get(name) {\n                let enum_ty = sole_owner(ctx, name, owners, *span)?.clone();\n                return construct(ctx, &enum_ty, name, *span, None, None, false);\n            }\n            // A function is not a value, but \"`f` is not defined\" for a defined function is a\n            // lie. This is where `f -1` lands: `-` cannot start a bare argument, so the parse\n            // is subtraction and `f` arrives here alone.\n            if ctx.sigs.contains_key(name) || BUILTIN_NAMES.contains(&name.as_str()) {\n                return Err(Error::new(\n                    *span,\n                    format!(\"`{name}` is a function, not a value; write `{name}(...)` to call it\"),\n                ));\n            }\n            Err(Error::new(*span, format!(\"`{name}` is not defined\")))\n        }\n\n        Expr::RecordLit { fields, .. } => {\n            let mut built: Vec<(String, Tir)> = Vec::new();\n            for (name, name_span, value) in fields {\n                if built.iter().any(|(seen, _)| seen == name) {\n                    return Err(Error::new(\n                        *name_span,\n                        format!(\"field `{name}` is given twice\"),\n                    ));\n                }\n                let field = synth(ctx, value)?;\n                // A stream can never enter a record: a record's fields can be printed, copied,\n                // and read back out by name, none of which make sense for a single-use stream,\n                // and no path exists for a stream-typed field to leave one again once inside.\n                if field.ty.contains_stream() {\n                    return Err(Error::new(\n                        value.span(),\n                        format!(\"`{name}` cannot hold a stream, which has nothing to store\"),\n                    ));\n                }\n                built.push((name.clone(), field));\n            }\n            // Declaration order, kept as written: the type's field list and this literal's\n            // fields stay index-for-index aligned, which is what the columnar backends key on.\n            let ty = Type::Record(\n                built\n                    .iter()\n                    .map(|(n, t)| (n.clone(), t.ty.clone()))\n                    .collect(),\n            );\n            Ok(Tir::new(ty, Kind::RecordLit { fields: built }))\n        }\n\n        Expr::VecLit { items, span } => {\n            let Some(first) = items.first() else {\n                // Nothing says what an empty literal contains, and there is no expected type to\n                // supply it. Guessing here is what the annotation rule exists to avoid.\n                return Err(Error::new(*span, \"cannot tell what `[]` contains\"));\n            };\n            let head = synth(ctx, first)?;\n            let elem = head.ty.clone();\n            // Same reasoning as a record field: nothing can get a stream back out of a Vec\n            // once it is in one, and a Vec of them makes no sense when there is only ever one\n            // real stdin to begin with.\n            if elem.contains_stream() {\n                return Err(Error::new(\n                    first.span(),\n                    \"a Vec cannot hold a stream, which has nothing to store\".to_string(),\n                ));\n            }\n            let mut out = vec![head];\n            for item in &items[1..] {\n                out.push(expect(ctx, item, &elem)?);\n            }\n            Ok(Tir::new(Type::Vec(Box::new(elem)), Kind::VecLit(out)))\n        }\n\n        Expr::Pipe { lhs, rhs, .. } => match pipe(ctx, lhs, rhs, None)? {\n            Expected::Checked(tir) | Expected::Synthesised(tir) => Ok(tir),\n        },\n\n        // A `|>` node only ever appears as a program's or a Sink-returning function's body,\n        // which `check_program_body` and `check_defs` handle before `synth` is reached. A `Sink`\n        // result here is refused by `synth`'s wrapper with the general position rule, so this\n        // arm exists for totality and is only reachable through a shape the parser cannot make.\n        Expr::TailPipe { .. } => tail_pipe(ctx, expr),\n\n        Expr::Field { .. } | Expr::Index { .. } | Expr::Slice { .. } | Expr::Unwrap { .. } => {\n            let Access { tir, stream, .. } = access(ctx, expr)?;\n            // Projection over a stream is a mapper, and it is normalized to one here: the chain\n            // is rebased onto a fresh per-element param, so neither the backends nor fusion\n            // ever see a Field, Index, or Unwrap whose base is stream-typed.\n            if stream {\n                let param = ctx.fresh();\n                let Rebased { body, source } = rebase(tir, param);\n                return Ok(Tir::new(\n                    Type::Stream(Box::new(body.ty.clone())),\n                    Kind::Map {\n                        source: Box::new(source),\n                        param,\n                        body: Box::new(body),\n                    },\n                ));\n            }\n            Ok(tir)\n        }\n\n        // `v[]` with nothing after it is the identity: \"keep every entry\" is what a Vec (or\n        // stream) already is, with no field/index/unwrap left to distribute across it.\n        Expr::Project { .. } => {\n            let access = access(ctx, expr)?;\n            Ok(access.tir)\n        }\n\n        // `input` names one value, so its first checked use fixes the type for the whole\n        // program -- and a later use in a position that expects nothing can borrow what the\n        // first use fixed. With no use typed yet, nothing says what it contains, and guessing\n        // is what the annotation rule avoids.\n        Expr::Input { span } => match ctx.input.borrow().as_ref() {\n            Some(ty) => Ok(Tir::new(ty.clone(), Kind::Input)),\n            None => Err(Error::new(*span, \"cannot tell what `input` contains\")),\n        },\n        Expr::Inputs { span } => match ctx.in_fn {\n            Some(func) => Err(source_in_fn(*span, \"inputs\", func)),\n            None => Err(Error::new(*span, \"cannot tell what `inputs` contains\")),\n        },\n\n        Expr::Call {\n            func,\n            func_span,\n            arg,\n            span,\n        } => call(ctx, func, *func_span, arg, *span),\n\n        Expr::Match { arms, span } => match_chain(ctx, arms, *span, None),\n\n        Expr::Variant {\n            enum_name,\n            enum_span,\n            variant,\n            variant_span,\n            payload,\n            ..\n        } => {\n            let Some(enum_ty) = ctx.enums.get(enum_name) else {\n                return Err(Error::new(\n                    *enum_span,\n                    format!(\"`{enum_name}` is not an enum\"),\n                ));\n            };\n            construct(\n                ctx,\n                &enum_ty.clone(),\n                variant,\n                *variant_span,\n                payload.as_deref(),\n                None,\n                false,\n            )\n        }\n\n        Expr::Neg { base, span } => {\n            // A minus directly on a literal is part of the literal, so the most negative Int can\n            // be written even though its magnitude is one past the most positive. This is the\n            // rule Rust uses, and it is why `-` was not folded into the lexer: `a -1` has to\n            // stay `a - 1`.\n            if let Expr::Int { value, span: lit } = base.as_ref() {\n                if *value > -(i32::MIN as i64) {\n                    return Err(Error::new(\n                        *lit,\n                        format!(\n                            \"integer `-{value}` does not fit in Int, which is 32 bits; only a \\\n                             position that expects Int64 can hold it\"\n                        ),\n                    ));\n                }\n                return Ok(Tir::new(Type::Int, Kind::Int(-value)));\n            }\n            if let Expr::Float { value, .. } = base.as_ref() {\n                return Ok(Tir::new(Type::Float, Kind::Float(-value)));\n            }\n            // Synthesise first, so `-x` works at whichever integer width `x` already has; a\n            // form that can only be checked (`-input` fixing input to Int) falls back to the\n            // Int expectation this arm always applied.\n            let inner = match synth(ctx, base) {\n                Ok(inner) if matches!(inner.ty, Type::Int | Type::Int64 | Type::Float) => inner,\n                Ok(inner) => {\n                    return Err(Error::new(\n                        base.span(),\n                        format!(\"expected Int, found {}\", inner.ty),\n                    ));\n                }\n                Err(_) => expect(ctx, base, &Type::Int)?,\n            };\n            let width = inner.ty.clone();\n            let zero = Tir::new(width.clone(), Kind::Int(0));\n            let _ = span;\n            Ok(Tir::new(\n                width,\n                Kind::Arith {\n                    op: BinOp::Sub,\n                    lhs: Box::new(zero),\n                    rhs: Box::new(inner),\n                },\n            ))\n        }\n\n        Expr::Binary { op, lhs, rhs, .. } => binary(ctx, *op, lhs, rhs),\n\n        // The connectives are the one place a subexpression may go unevaluated: `and` runs its\n        // right side only when the left is true, `or` only when it is false. Nothing here has\n        // to say so -- every backend emits its own short-circuiting operator -- but it is why\n        // `x != 0 and 10 / x > 1` is a program and not a division by zero.\n        Expr::Logic { op, lhs, rhs, .. } => {\n            let lhs = expect(ctx, lhs, &Type::Bool)?;\n            let rhs = expect(ctx, rhs, &Type::Bool)?;\n            Ok(Tir::new(\n                Type::Bool,\n                Kind::Logic {\n                    op: *op,\n                    lhs: Box::new(lhs),\n                    rhs: Box::new(rhs),\n                },\n            ))\n        }\n\n        Expr::Not { base, .. } => {\n            let base = expect(ctx, base, &Type::Bool)?;\n            Ok(Tir::new(Type::Bool, Kind::Not(Box::new(base))))\n        }\n\n        // A `let` block is only reachable as a function body, which is always checked against an\n        // expected return type, so `expect_inner` owns it. `synth` has no want to hand the block's\n        // value, so this arm is unreachable in practice but must exist for the match to be total.\n        Expr::Let { bindings, body, .. } => match let_bind(ctx, bindings, body, None)? {\n            Expected::Checked(_) => unreachable!(\"synth has no want, so nothing is Checked\"),\n            Expected::Synthesised(tir) => Ok(tir),\n        }\n    }\n}\n\n/// `synth`'s `Expr::Call` arm, pulled out on its own: a call is one of `select`/`map` (special\n/// forms rebinding `.`), a fixed sink or polymorphic builtin, or an ordinary user function or\n/// payload-constructor lookup, each with its own argument shape to check.\nfn call(\n    ctx: &Ctx,\n    func: &str,\n    func_span: Span,\n    arg: &Option<Box<Expr>>,\n    span: Span,\n) -> Result<Tir, Error> {\n    // `select` and `map` are not special syntax, only special names: they are ordinary calls\n    // whose argument is checked with `.` rebound to the subject's element type instead of\n    // evaluated in the enclosing scope, which no ordinary function needs and is why they cannot\n    // be defined as one (see `signatures`).\n    if func == \"select\" {\n        return select_call(ctx, need_arg(arg, func, span)?, span);\n    }\n    // The one way to produce a new element value. `select` removes elements and a field access\n    // reads a field; neither can turn a Vec<Int> into a Vec<Str>.\n    if func == \"map\" {\n        return map_call(ctx, need_arg(arg, func, span)?, span, None);\n    }\n    // The one sink builtin: a regular call now, typed `Sink`, and so subject to the same\n    // general position rule every sink is -- `synth`'s wrapper refuses a `Sink` result except\n    // where `sink_call` or the tail-pipeline `|>` (`tail_pipe`) born it. The old hand-checked\n    // `jsonlines` position in `check_program_body` retired in favor of that rule.\n    if func == \"jsonlines\" {\n        return jsonlines_call(ctx, arg, span);\n    }\n    // `length`, `tail`, and `flatten` are polymorphic over the element type, the same reason\n    // `jsonlines` is checked here rather than through `builtin()`'s fixed table.\n    if func == \"length\" {\n        return length_call(ctx, need_arg(arg, func, span)?);\n    }\n    // `None` on an empty Vec, the same way `Index` turns reaching past what's there into `Opt`\n    // rather than a runtime failure.\n    if func == \"tail\" {\n        return tail_call(ctx, need_arg(arg, func, span)?);\n    }\n    // Flattens a Vec<Vec<T>> into a Vec<T>, the way jq's `add` flattens a list of arrays.\n    // Joining a fixed, known count of Vecs is `+` (kantord/toylang#97); this is for when the\n    // outer Vec's length is not known at the call site.\n    if func == \"flatten\" {\n        return flatten_call(ctx, need_arg(arg, func, span)?);\n    }\n    // The one exit a stream has: `Stream<T> -> Vec<T>`, polymorphic over the element type like\n    // `length` and the others above, so the argument is synthesised first.\n    if func == \"collect\" {\n        return collect(ctx, need_arg(arg, func, span)?, None);\n    }\n    // Polymorphic over which record, the same reason `length` is checked here: the return type\n    // (`Vec<Str>`) is fixed, but the argument's shape is not.\n    if func == \"fields\" {\n        return fields_call(ctx, need_arg(arg, func, span)?);\n    }\n    // Blocking, one Vec in and one Vec out with no Stream instance (kantord/toylang#86, Q20 in\n    // draft.md), so both are checked here rather than through `select`'s subject-context\n    // mechanism.\n    if func == \"sort\" {\n        return sort_call(ctx, need_arg(arg, func, span)?);\n    }\n    if func == \"reverse\" {\n        return reverse_call(ctx, need_arg(arg, func, span)?);\n    }\n    // The two reductions (kantord/toylang#140): `sum` folds `+` at the element width, `max`\n    // returns `Opt` because an empty Vec has no maximum. Both are checked here rather than\n    // through `builtin()`'s fixed table because the return type is the element type's, which\n    // no fixed signature can express.\n    if func == \"sum\" {\n        return sum_call(ctx, need_arg(arg, func, span)?);\n    }\n    if func == \"max\" {\n        return max_call(ctx, need_arg(arg, func, span)?);\n    }\n    if let Some((which, sig)) = builtin(func) {\n        let param_ty = sig\n            .param\n            .as_ref()\n            .expect(\"every builtin in the fixed table is unary\");\n        let arg = expect(ctx, need_arg(arg, func, span)?, param_ty)?;\n        return Ok(Tir::new(\n            sig.ret,\n            Kind::Builtin {\n                which,\n                arg: Box::new(arg),\n            },\n        ));\n    }\n    let Some(sig) = ctx.sigs.get(func) else {\n        // A payload constructor is ordinary application (the Q34 path), so `circle{r: 1}` lands\n        // here; it resolves as a variant only after the function namespace declines.\n        if let Some(owners) = ctx.variant_owners.get(func) {\n            let enum_ty = sole_owner(ctx, func, owners, func_span)?.clone();\n            return construct(ctx, &enum_ty, func, func_span, arg.as_deref(), None, false);\n        }\n        return Err(Error::new(func_span, format!(\"`{func}` is not a function\")));\n    };\n    // A non-`pub` definition is a helper for its own file: it may be called from where it was\n    // defined, and nowhere else. `file` is the caller's file, so a `Prelude`-origin private\n    // helper is refused from the program's file while remaining legal inside prelude.toy -- the\n    // same privacy a `pub` prelude function already kept from calling a private helper, now\n    // stated as a per-call-site rule rather than by dropping the helper (gh:166).\n    if let Some((origin, is_pub)) = ctx.visibility.get(func)\n        && !is_pub\n        && *origin != ctx.file\n    {\n        return Err(Error::new(\n            func_span,\n            format!(\"`{func}` is not `pub`, so it can only be called from its own file\"),\n        ));\n    }\n    let arg = call_arg(ctx, func, span, &sig.param, arg)?;\n    Ok(Tir::new(\n        sig.ret.clone(),\n        Kind::Call {\n            func: func.to_string(),\n            arg,\n        },\n    ))\n}\n\n/// A user function's argument against its (optionally nullary) signature: the four arity/type\n/// combinations a call and a signature can be in relative to each other.\nfn call_arg(\n    ctx: &Ctx,\n    func: &str,\n    span: Span,\n    param_ty: &Option<Type>,\n    arg: &Option<Box<Expr>>,\n) -> Result<Option<Box<Tir>>, Error> {\n    match (param_ty, arg) {\n        (Some(param_ty), Some(arg)) => Ok(Some(Box::new(expect(ctx, arg, param_ty)?))),\n        (None, None) => Ok(None),\n        (Some(param_ty), None) => Err(Error::new(\n            span,\n            format!(\"`{func}` needs an argument of {param_ty}, but was called with none\"),\n        )),\n        (None, Some(arg)) => Err(Error::new(\n            arg.span(),\n            format!(\"`{func}` takes no argument\"),\n        )),\n    }\n}\n\n/// Cardinality-polymorphic: the same subject-context mechanism types `select` over a Vec and\n/// over a Stream, with the element drawn from either's parameter. Stream in, stream out.\nfn select_call(ctx: &Ctx, arg: &Expr, span: Span) -> Result<Tir, Error> {\n    let Some((subject, id)) = ctx.subject.clone() else {\n        return Err(Error::new(\n            span,\n            \"`select` needs a subject, so it must follow `|`\",\n        ));\n    };\n    let Some(elem) = mapper_elem(&subject) else {\n        return Err(Error::new(\n            span,\n            format!(\"`select` needs a Vec or a stream, found {subject}\"),\n        ));\n    };\n    let param = ctx.fresh();\n    let inner = mapper_ctx(ctx, elem, param);\n    let pred = expect(&inner, arg, &Type::Bool)?;\n    let source = Tir::new(subject.clone(), Kind::Local(id));\n    Ok(Tir::new(\n        subject,\n        Kind::Select {\n            source: Box::new(source),\n            param,\n            pred: Box::new(pred),\n        },\n    ))\n}\n\n/// `jsonlines(x)`, the one sink builtin, typed `Sink`. A sink is not a value, so a direct call\n/// survives only where `sink_call` recognized the sink position (the program's body or a","lineStart":1530,"lineEnd":2089,"totalLines":3239,"truncated":true}},"title":"src/check/mod.rs","time":{"start":1788379883798,"end":1788379883817}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"This is a big task. Let me continue reading key parts of the checker - specifically `call`, `binary`, `plus`, and `synth_inner`. Let me read lines 1530-2100 and 2500-2800.","format":"unknown","index":0}]}},"id":"prt_063bf690e001ZXycKybIPANY3y","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","messageID":"msg_063bf5d1f001C3WwxV1km5TzRl"}}
{"type":"step_finish","timestamp":1788379883829,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"id":"prt_063bf6933001cvzbsHGgaCeBgr","reason":"tool-calls","snapshot":"1792faf63d5bfa2d3bcfd92d0c0629bb0dedcd06","messageID":"msg_063bf5d1f001C3WwxV1km5TzRl","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","type":"step-finish","tokens":{"total":79336,"input":5714,"output":107,"reasoning":43,"cache":{"write":0,"read":73472}},"cost":0.001573962}}
{"type":"step_start","timestamp":1788379888148,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"id":"prt_063bf7a0b001i8wQyS5crX5XCI","messageID":"msg_063bf6944001bb0PMg8JskzuCq","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","snapshot":"1792faf63d5bfa2d3bcfd92d0c0629bb0dedcd06","type":"step-start"}}
{"type":"tool_use","timestamp":1788379889752,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-b3bee1db277b764d","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-174/src/check/mod.rs","limit":460,"offset":2500},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-174/src/check/mod.rs</path>\n<type>file</type>\n<content>\n2500: /// A literal (or a minus on one, or a negation) met by an Int64 expectation: literals carry\n2501: /// no suffix, so the position is the only thing that can say which width one has\n2502: /// (kantord/toylang#83), the `[]` rule applied to numbers. A minus directly on a literal is\n2503: /// part of the literal, as for Int, so the whole written range short of\n2504: /// `-9223372036854775808` is reachable (the parser refuses `9223372036854775808` before the\n2505: /// minus could claim it, the same edge Rust's own i64 literals have). `None` for any other\n2506: /// form -- or any other `want` -- which falls through to `expect_inner`'s remaining arms.\n2507: fn int64_resolved(ctx: &Ctx, expr: &Expr, want: &Type) -> Option<Result<Tir, Error>> {\n2508:     if *want != Type::Int64 {\n2509:         return None;\n2510:     }\n2511:     match expr {\n2512:         Expr::Int { value, .. } => Some(Ok(Tir::new(Type::Int64, Kind::Int(*value)))),\n2513:         Expr::Neg { base, .. } => {\n2514:             if let Expr::Int { value, .. } = base.as_ref() {\n2515:                 return Some(Ok(Tir::new(Type::Int64, Kind::Int(-value))));\n2516:             }\n2517:             let inner = match expect(ctx, base, &Type::Int64) {\n2518:                 Ok(inner) => inner,\n2519:                 Err(e) => return Some(Err(e)),\n2520:             };\n2521:             let zero = Tir::new(Type::Int64, Kind::Int(0));\n2522:             Some(Ok(Tir::new(\n2523:                 Type::Int64,\n2524:                 Kind::Arith {\n2525:                     op: BinOp::Sub,\n2526:                     lhs: Box::new(zero),\n2527:                     rhs: Box::new(inner),\n2528:                 },\n2529:             )))\n2530:         }\n2531:         _ => None,\n2532:     }\n2533: }\n2534: \n2535: /// An arithmetic operand checked at the width the other side fixed, with the type mismatch\n2536: /// upgraded to name the bridge when the two integer types met: \"expected Int, found Int64\" is\n2537: /// true but leaves the reader to discover `i64` on their own. The re-synthesis in the error\n2538: /// path mirrors `stream_refusal`'s.\n2539: fn expect_int_width(ctx: &Ctx, rhs: &Expr, width: &Type, op: BinOp) -> Result<Tir, Error> {\n2540:     expect(ctx, rhs, width).map_err(|err| {\n2541:         let Ok(found) = synth(ctx, rhs) else {\n2542:             return err;\n2543:         };\n2544:         match (width, &found.ty) {\n2545:             (Type::Int, Type::Int64) => Error::new(\n2546:                 rhs.span(),\n2547:                 format!(\"`{op}` cannot mix Int and Int64; widen the Int side with `i64(...)`\"),\n2548:             ),\n2549:             (Type::Int64, Type::Int) => Error::new(\n2550:                 rhs.span(),\n2551:                 format!(\"`{op}` cannot mix Int64 and Int; widen the Int side with `i64(...)`\"),\n2552:             ),\n2553:             _ => err,\n2554:         }\n2555:     })\n2556: }\n2557: \n2558: fn binary(ctx: &Ctx, op: BinOp, lhs: &Expr, rhs: &Expr) -> Result<Tir, Error> {\n2559:     let left = synth(ctx, lhs)?;\n2560: \n2561:     // Q2 is open, so an operator over a Vec is rejected rather than being silently given\n2562:     // broadcast or zip semantics. Under C1 that restriction is ordinary typing: there is no\n2563:     // separate cardinality to check, because a Vec is just a type. `+` is the one exception:\n2564:     // it concatenates two Vecs of the same type now (kantord/toylang#97, the add-trait\n2565:     // reading), which settles that half of Q2 without deciding what any other operator means\n2566:     // over two Vecs.\n2567:     if left.ty.elem().is_some() && op != BinOp::Add {\n2568:         return Err(Error::new(\n2569:             lhs.span(),\n2570:             format!(\"`{op}` does not apply to {}\", left.ty),\n2571:         ));\n2572:     }\n2573: \n2574:     if op.is_comparison() {\n2575:         // A Vec one level down is the same open question a bare one is. `==` on a record whose\n2576:         // field is a Vec would have to answer whether that field compares as a whole value or\n2577:         // broadcasts, which is Q2, so structural equality stops at the first Vec rather than\n2578:         // settling it silently (kantord/toylang#95). The bare case is already gone above; this\n2579:         // catches the composite that carries one.\n2580:         if left.ty.contains_vec() {\n2581:             return Err(Error::new(\n2582:                 lhs.span(),\n2583:                 format!(\"`{op}` does not apply to {}\", left.ty),\n2584:             ));\n2585:         }\n2586: \n2587:         // Comparison never crosses the integer widths either: the sides must already agree,\n2588:         // and the mismatch names `i64` the same way arithmetic's does.\n2589:         if matches!(left.ty, Type::Int | Type::Int64 | Type::Float) {\n2590:             let right = expect_int_width(ctx, rhs, &left.ty, op)?;\n2591:             return Ok(Tir::new(\n2592:                 Type::Bool,\n2593:                 Kind::Compare {\n2594:                     op,\n2595:                     lhs: Box::new(left),\n2596:                     rhs: Box::new(right),\n2597:                 },\n2598:             ));\n2599:         }\n2600:         let right = match expect(ctx, rhs, &left.ty) {\n2601:             Ok(right) => right,\n2602:             Err(err) => {\n2603:                 // Postfix `!` next to `!=` merges into one token: `x!=y` lexes as `!=`, not\n2604:                 // `x! == y`. Once the plain comparison has failed, Opt<T> against its own\n2605:                 // element is specific enough to name the likely cause instead of just the\n2606:                 // type mismatch.\n2607:                 if op == BinOp::Ne\n2608:                     && let Some(inner) = left.ty.as_opt().cloned()\n2609:                     && expect(ctx, rhs, &inner).is_ok()\n2610:                 {\n2611:                     return Err(Error::new(\n2612:                         rhs.span(),\n2613:                         format!(\n2614:                             \"expected {}, found {inner}: `!` and `=` read as one token \\\n2615:                              here (`!=`); did you mean `! ==`?\",\n2616:                             left.ty\n2617:                         ),\n2618:                     ));\n2619:                 }\n2620:                 return Err(err);\n2621:             }\n2622:         };\n2623:         return Ok(Tir::new(\n2624:             Type::Bool,\n2625:             Kind::Compare {\n2626:                 op,\n2627:                 lhs: Box::new(left),\n2628:                 rhs: Box::new(right),\n2629:             },\n2630:         ));\n2631:     }\n2632: \n2633:     if op.is_arithmetic() {\n2634:         if !matches!(left.ty, Type::Int | Type::Int64 | Type::Float) {\n2635:             return Err(Error::new(\n2636:                 lhs.span(),\n2637:                 format!(\"expected Int, Int64, or Float, found {}\", left.ty),\n2638:             ));\n2639:         }\n2640:         // Both sides share the left's width: nothing widens implicitly (kantord/toylang#83),\n2641:         // so an Int meeting an Int64 is an error naming the bridge rather than a silent\n2642:         // promotion -- and a bare literal on the right resolves at whichever width the left\n2643:         // already has, since `expect_inner` types a literal by its position.\n2644:         let width = left.ty.clone();\n2645:         let right = expect_int_width(ctx, rhs, &width, op)?;\n2646:         return Ok(Tir::new(\n2647:             width,\n2648:             Kind::Arith {\n2649:                 op,\n2650:                 lhs: Box::new(left),\n2651:                 rhs: Box::new(right),\n2652:             },\n2653:         ));\n2654:     }\n2655: \n2656:     plus(ctx, lhs, left, rhs)\n2657: }\n2658: \n2659: /// `+` is the one operator whose meaning depends on its operands: addition on Int or Int64,\n2660: /// concatenation on Str, and concatenation on Vec (kantord/toylang#97, the add-trait reading)\n2661: /// when both sides are the same Vec type. Nothing is coerced, so all three still require both\n2662: /// sides to agree.\n2663: fn plus(ctx: &Ctx, lhs: &Expr, left: Tir, rhs: &Expr) -> Result<Tir, Error> {\n2664:     match &left.ty {\n2665:         Type::Int | Type::Int64 | Type::Float => {\n2666:             let width = left.ty.clone();\n2667:             let right = expect_int_width(ctx, rhs, &width, BinOp::Add)?;\n2668:             let kind = Kind::Arith {\n2669:                 op: BinOp::Add,\n2670:                 lhs: Box::new(left),\n2671:                 rhs: Box::new(right),\n2672:             };\n2673:             Ok(Tir::new(width, kind))\n2674:         }\n2675:         Type::Str => {\n2676:             let right = expect(ctx, rhs, &Type::Str)?;\n2677:             Ok(Tir::new(\n2678:                 Type::Str,\n2679:                 Kind::Concat(Box::new(left), Box::new(right)),\n2680:             ))\n2681:         }\n2682:         Type::Vec(_) => {\n2683:             let want = left.ty.clone();\n2684:             let right = expect(ctx, rhs, &want)?;\n2685:             Ok(Tir::new(\n2686:                 want,\n2687:                 Kind::Concat(Box::new(left), Box::new(right)),\n2688:             ))\n2689:         }\n2690:         other => Err(Error::new(\n2691:             lhs.span(),\n2692:             format!(\"`+` needs Int, Str, or Vec, found {other}\"),\n2693:         )),\n2694:     }\n2695: }\n2696: \n2697: /// How an expression met an expectation. `Checked` consumed it: the expected type flowed into\n2698: /// the form, and the result is `want`-typed by construction. `Synthesised` means the form\n2699: /// answers for itself, so the expectation resolved nothing and the caller still owns the\n2700: /// comparison -- which is what lets `check` blame a function's signature, by name, when a\n2701: /// body's synthesised type misses its annotation.\n2702: enum Expected {\n2703:     Checked(Tir),\n2704:     Synthesised(Tir),\n2705: }\n2706: \n2707: /// The checking direction: an expected type goes in, and the expression is verified against it\n2708: /// rather than asked what it is. Most forms answer both questions, but not all do.\n2709: fn expect(ctx: &Ctx, expr: &Expr, want: &Type) -> Result<Tir, Error> {\n2710:     match expect_inner(ctx, expr, want)? {\n2711:         Expected::Checked(tir) => Ok(tir),\n2712:         Expected::Synthesised(found) => {\n2713:             if &found.ty != want {\n2714:                 return Err(Error::new(\n2715:                     expr.span(),\n2716:                     format!(\"expected {want}, found {}\", found.ty),\n2717:                 ));\n2718:             }\n2719:             Ok(reorder_record(ctx, found, want))\n2720:         }\n2721:     }\n2722: }\n2723: \n2724: /// `found`, rebuilt to `want`'s field order when the two already agree (kantord/toylang#60) --\n2725: /// a no-op when they don't, leaving a real mismatch for the caller's own comparison to catch\n2726: /// and name.\n2727: fn conform(ctx: &Ctx, found: Tir, want: &Type) -> Tir {\n2728:     if &found.ty == want {\n2729:         reorder_record(ctx, found, want)\n2730:     } else {\n2731:         found\n2732:     }\n2733: }\n2734: \n2735: /// Whether `a` and `b` are not just the same type (kantord/toylang#60: a record's fields are a\n2736: /// set, not a sequence) but physically identical -- same fields, same order, all the way into\n2737: /// any field that is itself a record. Every non-nominal backend reads a record by name and does\n2738: /// not care; the native backend and the columnar Vec layout read it by position, off whichever\n2739: /// type a value is currently checked against, so a value crossing into a differently-ordered\n2740: /// but equal position needs rebuilding before those readers see it. This is what decides\n2741: /// whether that rebuild is needed.\n2742: ///\n2743: /// Also recurses into an enum's variant payloads (kantord/toylang#66): two instantiations of the\n2744: /// same generic enum are one `Type` (`Type::Enum`'s `PartialEq` compares `name` and `args`\n2745: /// only, and a generic argument's own order-insensitivity comes from `Type::Record`'s), so a\n2746: /// payload written in a different field order at each call site is exactly the same hazard a\n2747: /// bare record or a Vec element is. The variant list itself is never out of order -- it comes\n2748: /// from one declaration -- so zipping the two enums' variants positionally is safe, *except*\n2749: /// when one side's list is a recursive self-reference's placeholder (kantord/toylang#76): the\n2750: /// zip then runs zero pairs and this reports \"no reorder needed\" rather than crashing, which is\n2751: /// conservatively correct (nothing gets left mis-ordered that this function could have fixed)\n2752: /// though not necessarily complete (a reorder a full expansion would have found stays undone).\n2753: fn same_field_order(a: &Type, b: &Type) -> bool {\n2754:     match (a, b) {\n2755:         (Type::Record(x), Type::Record(y)) => {\n2756:             x.len() == y.len()\n2757:                 && x.iter()\n2758:                     .zip(y)\n2759:                     .all(|((n1, t1), (n2, t2))| n1 == n2 && same_field_order(t1, t2))\n2760:         }\n2761:         (Type::Vec(x), Type::Vec(y)) | (Type::Stream(x), Type::Stream(y)) => same_field_order(x, y),\n2762:         (Type::Enum { variants: vx, .. }, Type::Enum { variants: vy, .. }) => {\n2763:             vx.iter().zip(vy).all(|((_, px), (_, py))| match (px, py) {\n2764:                 (Some(tx), Some(ty)) => same_field_order(tx, ty),\n2765:                 _ => true,\n2766:             })\n2767:         }\n2768:         _ => true,\n2769:     }\n2770: }\n2771: \n2772: /// Rebuilds `found` -- already known equal to `want` -- so it is physically laid out in\n2773: /// `want`'s field order: a bound local read back out field by field into a fresh literal in\n2774: /// that order, recursing into any field that is itself a differently-ordered record. Also\n2775: /// recurses through a Vec or Stream wrapper, via a real `map` that rebuilds every element --\n2776: /// unlike the record case this is a runtime loop, not a free relabelling, since a Vec's\n2777: /// elements are not reachable one at a time the way a record's fields are (kantord/toylang#64).\n2778: ///\n2779: /// A general enum reorders through `Match`/`EnumLit`: every arm rebuilds its variant with a\n2780: /// freshly reordered payload, which every backend can already run since it is exactly how a\n2781: /// user-written match over that enum already compiles. Opt is the one enum this can't reach\n2782: /// (kantord/toylang#66) -- three backends keep Opt in a representation of their own (`Option<T>`,\n2783: /// `tlOpt[T]{ok,v}`, the null-or-boxed native encoding) rather than the general tagged shape, so\n2784: /// `Match`'s tag-indexed codegen does not apply to it. `OptMap` is the dedicated node every\n2785: /// backend already has the pieces to run: it is exactly the presence branch each one's unwrap\n2786: /// and printer already take, generalised to rebuild the payload instead of rendering it.\n2787: fn reorder_enum(ctx: &Ctx, found: Tir, want: &Type) -> Tir {\n2788:     if let Some(want_inner) = want.as_opt() {\n2789:         let found_inner = found\n2790:             .ty\n2791:             .as_opt()\n2792:             .expect(\"found.ty == want: both Opt\")\n2793:             .clone();\n2794:         let param = ctx.fresh();\n2795:         let body = reorder_record(ctx, Tir::new(found_inner, Kind::Local(param)), want_inner);\n2796:         return Tir::new(\n2797:             want.clone(),\n2798:             Kind::OptMap {\n2799:                 source: Box::new(found),\n2800:                 param,\n2801:                 body: Box::new(body),\n2802:             },\n2803:         );\n2804:     }\n2805:     let Type::Enum {\n2806:         variants: want_variants,\n2807:         ..\n2808:     } = want\n2809:     else {\n2810:         unreachable!(\"reorder_enum is only called with an enum want\")\n2811:     };\n2812:     let found_variants = match &found.ty {\n2813:         Type::Enum { variants, .. } => variants.clone(),\n2814:         _ => unreachable!(\"found.ty == want: both enums\"),\n2815:     };\n2816:     let arms = want_variants\n2817:         .iter()\n2818:         .zip(&found_variants)\n2819:         .map(|((vname, want_payload), (_, found_payload))| {\n2820:             let payload = match (want_payload, found_payload) {\n2821:                 (Some(want_p), Some(found_p)) => {\n2822:                     let pid = ctx.fresh();\n2823:                     let rebuilt =\n2824:                         reorder_record(ctx, Tir::new(found_p.clone(), Kind::Local(pid)), want_p);\n2825:                     (Some(pid), Some(Box::new(rebuilt)))\n2826:                 }\n2827:                 (None, None) => (None, None),\n2828:                 _ => unreachable!(\"found.ty == want: variant shapes line up\"),\n2829:             };\n2830:             tir::MatchArm {\n2831:                 variant: Some(vname.clone()),\n2832:                 guard: None,\n2833:                 payload: payload.0,\n2834:                 body: Tir::new(\n2835:                     want.clone(),\n2836:                     Kind::EnumLit {\n2837:                         variant: vname.clone(),\n2838:                         payload: payload.1,\n2839:                     },\n2840:                 ),\n2841:             }\n2842:         })\n2843:         .collect();\n2844:     Tir::new(\n2845:         want.clone(),\n2846:         Kind::Match {\n2847:             subject: Box::new(found),\n2848:             arms,\n2849:             partial: false,\n2850:         },\n2851:     )\n2852: }\n2853: fn reorder_record(ctx: &Ctx, found: Tir, want: &Type) -> Tir {\n2854:     if same_field_order(&found.ty, want) {\n2855:         return found;\n2856:     }\n2857:     match want {\n2858:         Type::Record(want_fields) => {\n2859:             // A bare local can supply its own fields directly without being bound again: a\n2860:             // Field read reaches through it (a struct-of-arrays cursor, when it is a Vec\n2861:             // element, or an ordinary bound value otherwise) without ever asking for the whole\n2862:             // local as a value, which is what a redundant rebind here would do -- and which\n2863:             // the native backend refuses for a cursor, since a map body's element local is\n2864:             // never materialised as one.\n2865:             if let Kind::Local(local) = found.kind {\n2866:                 return Tir::new(\n2867:                     want.clone(),\n2868:                     Kind::RecordLit {\n2869:                         fields: reorder_fields(ctx, local, &found.ty, want_fields),\n2870:                     },\n2871:                 );\n2872:             }\n2873:             let local = ctx.fresh();\n2874:             let found_ty = found.ty.clone();\n2875:             let fields = reorder_fields(ctx, local, &found_ty, want_fields);\n2876:             Tir::new(\n2877:                 want.clone(),\n2878:                 Kind::Bind {\n2879:                     local,\n2880:                     value: Box::new(found),\n2881:                     body: Box::new(Tir::new(want.clone(), Kind::RecordLit { fields })),\n2882:                 },\n2883:             )\n2884:         }\n2885:         Type::Vec(want_elem) | Type::Stream(want_elem) => {\n2886:             // `found.ty == want` already (the caller's own guard), so its wrapper is the same\n2887:             // kind as `want`'s and `runtime_elem` cannot miss.\n2888:             let elem_ty = tir::runtime_elem(&found.ty)\n2889:                 .expect(\"want is Vec/Stream and found.ty == want\")\n2890:                 .clone();\n2891:             let param = ctx.fresh();\n2892:             let body = reorder_record(ctx, Tir::new(elem_ty, Kind::Local(param)), want_elem);\n2893:             Tir::new(\n2894:                 want.clone(),\n2895:                 Kind::Map {\n2896:                     source: Box::new(found),\n2897:                     param,\n2898:                     body: Box::new(body),\n2899:                 },\n2900:             )\n2901:         }\n2902:         Type::Enum { .. } => reorder_enum(ctx, found, want),\n2903:         _ => found,\n2904:     }\n2905: }\n2906: \n2907: /// `want_fields`, each read off `local` (of type `local_ty`) in `want_fields`'s order, recursing\n2908: /// into any field that is itself a differently-ordered record.\n2909: fn reorder_fields(\n2910:     ctx: &Ctx,\n2911:     local: LocalId,\n2912:     local_ty: &Type,\n2913:     want_fields: &[(String, Type)],\n2914: ) -> Vec<(String, Tir)> {\n2915:     want_fields\n2916:         .iter()\n2917:         .map(|(name, field_ty)| {\n2918:             let access = Tir::new(\n2919:                 field_ty.clone(),\n2920:                 Kind::Field {\n2921:                     base: Box::new(Tir::new(local_ty.clone(), Kind::Local(local))),\n2922:                     name: name.clone(),\n2923:                 },\n2924:             );\n2925:             (name.clone(), reorder_record(ctx, access, field_ty))\n2926:         })\n2927:         .collect()\n2928: }\n2929: \n2930: /// `expect`, minus the final comparison. Each arm here is a form whose type can come from its\n2931: /// position rather than its contents; expectation only ever resolves what synthesis would have\n2932: /// refused -- a form that can synthesise falls through and is compared, never coerced.\n2933: /// `input` against the type its position wants: the first use fills the program-wide slot,\n2934: /// and every later use must agree with it. A signature can spell Stream now, so this position\n2935: /// can ask for one; `input` is a whole value already in hand, which is exactly what a stream\n2936: /// is not.\n2937: fn input_read(ctx: &Ctx, span: Span, want: &Type) -> Result<Tir, Error> {\n2938:     if want.contains_stream() {\n2939:         return Err(Error::new(\n2940:             span,\n2941:             format!(\"`input` is one value read from stdin, but {want} is wanted here\"),\n2942:         ));\n2943:     }\n2944:     // Absence has no ratified wire form: the tag is an in-memory fact, serialization emits\n2945:     // `null` for it going out, and whether `null` coming in reads as `none` is codec design\n2946:     // nobody has done. Refusing is the reversible direction.\n2947:     if want.contains_opt() {\n2948:         return Err(Error::new(\n2949:             span,\n2950:             format!(\"`input` cannot be read as {want}; absence has no wire form to read\"),\n2951:         ));\n2952:     }\n2953:     // A Char is never itself JSON; it only ever comes from decoding a Str already in hand\n2954:     // (`chars`), so there is nothing for a wire value to decode into.\n2955:     if want.contains_char() {\n2956:         return Err(Error::new(\n2957:             span,\n2958:             format!(\"`input` cannot be read as {want}; Char has no wire form to read\"),\n2959:         ));\n\n(Showing lines 2500-2959 of 3239. Use offset=2960 to continue.)\n</content>","metadata":{"preview":"/// A literal (or a minus on one, or a negation) met by an Int64 expectation: literals carry\n/// no suffix, so the position is the only thing that can say which width one has\n/// (kantord/toylang#83), the `[]` rule applied to numbers. A minus directly on a literal is\n/// part of the literal, as for Int, so the whole written range short of\n/// `-9223372036854775808` is reachable (the parser refuses `9223372036854775808` before the\n/// minus could claim it, the same edge Rust's own i64 literals have). `None` for any other\n/// form -- or any other `want` -- which falls through to `expect_inner`'s remaining arms.\nfn int64_resolved(ctx: &Ctx, expr: &Expr, want: &Type) -> Option<Result<Tir, Error>> {\n    if *want != Type::Int64 {\n        return None;\n    }\n    match expr {\n        Expr::Int { value, .. } => Some(Ok(Tir::new(Type::Int64, Kind::Int(*value)))),\n        Expr::Neg { base, .. } => {\n            if let Expr::Int { value, .. } = base.as_ref() {\n                return Some(Ok(Tir::new(Type::Int64, Kind::Int(-value))));\n            }\n            let inner = match expect(ctx, base, &Type::Int64) {\n                Ok(inner) => inner,\n                Err(e) => return Some(Err(e)),","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-174/src/check/mod.rs","text":"/// A literal (or a minus on one, or a negation) met by an Int64 expectation: literals carry\n/// no suffix, so the position is the only thing that can say which width one has\n/// (kantord/toylang#83), the `[]` rule applied to numbers. A minus directly on a literal is\n/// part of the literal, as for Int, so the whole written range short of\n/// `-9223372036854775808` is reachable (the parser refuses `9223372036854775808` before the\n/// minus could claim it, the same edge Rust's own i64 literals have). `None` for any other\n/// form -- or any other `want` -- which falls through to `expect_inner`'s remaining arms.\nfn int64_resolved(ctx: &Ctx, expr: &Expr, want: &Type) -> Option<Result<Tir, Error>> {\n    if *want != Type::Int64 {\n        return None;\n    }\n    match expr {\n        Expr::Int { value, .. } => Some(Ok(Tir::new(Type::Int64, Kind::Int(*value)))),\n        Expr::Neg { base, .. } => {\n            if let Expr::Int { value, .. } = base.as_ref() {\n                return Some(Ok(Tir::new(Type::Int64, Kind::Int(-value))));\n            }\n            let inner = match expect(ctx, base, &Type::Int64) {\n                Ok(inner) => inner,\n                Err(e) => return Some(Err(e)),\n            };\n            let zero = Tir::new(Type::Int64, Kind::Int(0));\n            Some(Ok(Tir::new(\n                Type::Int64,\n                Kind::Arith {\n                    op: BinOp::Sub,\n                    lhs: Box::new(zero),\n                    rhs: Box::new(inner),\n                },\n            )))\n        }\n        _ => None,\n    }\n}\n\n/// An arithmetic operand checked at the width the other side fixed, with the type mismatch\n/// upgraded to name the bridge when the two integer types met: \"expected Int, found Int64\" is\n/// true but leaves the reader to discover `i64` on their own. The re-synthesis in the error\n/// path mirrors `stream_refusal`'s.\nfn expect_int_width(ctx: &Ctx, rhs: &Expr, width: &Type, op: BinOp) -> Result<Tir, Error> {\n    expect(ctx, rhs, width).map_err(|err| {\n        let Ok(found) = synth(ctx, rhs) else {\n            return err;\n        };\n        match (width, &found.ty) {\n            (Type::Int, Type::Int64) => Error::new(\n                rhs.span(),\n                format!(\"`{op}` cannot mix Int and Int64; widen the Int side with `i64(...)`\"),\n            ),\n            (Type::Int64, Type::Int) => Error::new(\n                rhs.span(),\n                format!(\"`{op}` cannot mix Int64 and Int; widen the Int side with `i64(...)`\"),\n            ),\n            _ => err,\n        }\n    })\n}\n\nfn binary(ctx: &Ctx, op: BinOp, lhs: &Expr, rhs: &Expr) -> Result<Tir, Error> {\n    let left = synth(ctx, lhs)?;\n\n    // Q2 is open, so an operator over a Vec is rejected rather than being silently given\n    // broadcast or zip semantics. Under C1 that restriction is ordinary typing: there is no\n    // separate cardinality to check, because a Vec is just a type. `+` is the one exception:\n    // it concatenates two Vecs of the same type now (kantord/toylang#97, the add-trait\n    // reading), which settles that half of Q2 without deciding what any other operator means\n    // over two Vecs.\n    if left.ty.elem().is_some() && op != BinOp::Add {\n        return Err(Error::new(\n            lhs.span(),\n            format!(\"`{op}` does not apply to {}\", left.ty),\n        ));\n    }\n\n    if op.is_comparison() {\n        // A Vec one level down is the same open question a bare one is. `==` on a record whose\n        // field is a Vec would have to answer whether that field compares as a whole value or\n        // broadcasts, which is Q2, so structural equality stops at the first Vec rather than\n        // settling it silently (kantord/toylang#95). The bare case is already gone above; this\n        // catches the composite that carries one.\n        if left.ty.contains_vec() {\n            return Err(Error::new(\n                lhs.span(),\n                format!(\"`{op}` does not apply to {}\", left.ty),\n            ));\n        }\n\n        // Comparison never crosses the integer widths either: the sides must already agree,\n        // and the mismatch names `i64` the same way arithmetic's does.\n        if matches!(left.ty, Type::Int | Type::Int64 | Type::Float) {\n            let right = expect_int_width(ctx, rhs, &left.ty, op)?;\n            return Ok(Tir::new(\n                Type::Bool,\n                Kind::Compare {\n                    op,\n                    lhs: Box::new(left),\n                    rhs: Box::new(right),\n                },\n            ));\n        }\n        let right = match expect(ctx, rhs, &left.ty) {\n            Ok(right) => right,\n            Err(err) => {\n                // Postfix `!` next to `!=` merges into one token: `x!=y` lexes as `!=`, not\n                // `x! == y`. Once the plain comparison has failed, Opt<T> against its own\n                // element is specific enough to name the likely cause instead of just the\n                // type mismatch.\n                if op == BinOp::Ne\n                    && let Some(inner) = left.ty.as_opt().cloned()\n                    && expect(ctx, rhs, &inner).is_ok()\n                {\n                    return Err(Error::new(\n                        rhs.span(),\n                        format!(\n                            \"expected {}, found {inner}: `!` and `=` read as one token \\\n                             here (`!=`); did you mean `! ==`?\",\n                            left.ty\n                        ),\n                    ));\n                }\n                return Err(err);\n            }\n        };\n        return Ok(Tir::new(\n            Type::Bool,\n            Kind::Compare {\n                op,\n                lhs: Box::new(left),\n                rhs: Box::new(right),\n            },\n        ));\n    }\n\n    if op.is_arithmetic() {\n        if !matches!(left.ty, Type::Int | Type::Int64 | Type::Float) {\n            return Err(Error::new(\n                lhs.span(),\n                format!(\"expected Int, Int64, or Float, found {}\", left.ty),\n            ));\n        }\n        // Both sides share the left's width: nothing widens implicitly (kantord/toylang#83),\n        // so an Int meeting an Int64 is an error naming the bridge rather than a silent\n        // promotion -- and a bare literal on the right resolves at whichever width the left\n        // already has, since `expect_inner` types a literal by its position.\n        let width = left.ty.clone();\n        let right = expect_int_width(ctx, rhs, &width, op)?;\n        return Ok(Tir::new(\n            width,\n            Kind::Arith {\n                op,\n                lhs: Box::new(left),\n                rhs: Box::new(right),\n            },\n        ));\n    }\n\n    plus(ctx, lhs, left, rhs)\n}\n\n/// `+` is the one operator whose meaning depends on its operands: addition on Int or Int64,\n/// concatenation on Str, and concatenation on Vec (kantord/toylang#97, the add-trait reading)\n/// when both sides are the same Vec type. Nothing is coerced, so all three still require both\n/// sides to agree.\nfn plus(ctx: &Ctx, lhs: &Expr, left: Tir, rhs: &Expr) -> Result<Tir, Error> {\n    match &left.ty {\n        Type::Int | Type::Int64 | Type::Float => {\n            let width = left.ty.clone();\n            let right = expect_int_width(ctx, rhs, &width, BinOp::Add)?;\n            let kind = Kind::Arith {\n                op: BinOp::Add,\n                lhs: Box::new(left),\n                rhs: Box::new(right),\n            };\n            Ok(Tir::new(width, kind))\n        }\n        Type::Str => {\n            let right = expect(ctx, rhs, &Type::Str)?;\n            Ok(Tir::new(\n                Type::Str,\n                Kind::Concat(Box::new(left), Box::new(right)),\n            ))\n        }\n        Type::Vec(_) => {\n            let want = left.ty.clone();\n            let right = expect(ctx, rhs, &want)?;\n            Ok(Tir::new(\n                want,\n                Kind::Concat(Box::new(left), Box::new(right)),\n            ))\n        }\n        other => Err(Error::new(\n            lhs.span(),\n            format!(\"`+` needs Int, Str, or Vec, found {other}\"),\n        )),\n    }\n}\n\n/// How an expression met an expectation. `Checked` consumed it: the expected type flowed into\n/// the form, and the result is `want`-typed by construction. `Synthesised` means the form\n/// answers for itself, so the expectation resolved nothing and the caller still owns the\n/// comparison -- which is what lets `check` blame a function's signature, by name, when a\n/// body's synthesised type misses its annotation.\nenum Expected {\n    Checked(Tir),\n    Synthesised(Tir),\n}\n\n/// The checking direction: an expected type goes in, and the expression is verified against it\n/// rather than asked what it is. Most forms answer both questions, but not all do.\nfn expect(ctx: &Ctx, expr: &Expr, want: &Type) -> Result<Tir, Error> {\n    match expect_inner(ctx, expr, want)? {\n        Expected::Checked(tir) => Ok(tir),\n        Expected::Synthesised(found) => {\n            if &found.ty != want {\n                return Err(Error::new(\n                    expr.span(),\n                    format!(\"expected {want}, found {}\", found.ty),\n                ));\n            }\n            Ok(reorder_record(ctx, found, want))\n        }\n    }\n}\n\n/// `found`, rebuilt to `want`'s field order when the two already agree (kantord/toylang#60) --\n/// a no-op when they don't, leaving a real mismatch for the caller's own comparison to catch\n/// and name.\nfn conform(ctx: &Ctx, found: Tir, want: &Type) -> Tir {\n    if &found.ty == want {\n        reorder_record(ctx, found, want)\n    } else {\n        found\n    }\n}\n\n/// Whether `a` and `b` are not just the same type (kantord/toylang#60: a record's fields are a\n/// set, not a sequence) but physically identical -- same fields, same order, all the way into\n/// any field that is itself a record. Every non-nominal backend reads a record by name and does\n/// not care; the native backend and the columnar Vec layout read it by position, off whichever\n/// type a value is currently checked against, so a value crossing into a differently-ordered\n/// but equal position needs rebuilding before those readers see it. This is what decides\n/// whether that rebuild is needed.\n///\n/// Also recurses into an enum's variant payloads (kantord/toylang#66): two instantiations of the\n/// same generic enum are one `Type` (`Type::Enum`'s `PartialEq` compares `name` and `args`\n/// only, and a generic argument's own order-insensitivity comes from `Type::Record`'s), so a\n/// payload written in a different field order at each call site is exactly the same hazard a\n/// bare record or a Vec element is. The variant list itself is never out of order -- it comes\n/// from one declaration -- so zipping the two enums' variants positionally is safe, *except*\n/// when one side's list is a recursive self-reference's placeholder (kantord/toylang#76): the\n/// zip then runs zero pairs and this reports \"no reorder needed\" rather than crashing, which is\n/// conservatively correct (nothing gets left mis-ordered that this function could have fixed)\n/// though not necessarily complete (a reorder a full expansion would have found stays undone).\nfn same_field_order(a: &Type, b: &Type) -> bool {\n    match (a, b) {\n        (Type::Record(x), Type::Record(y)) => {\n            x.len() == y.len()\n                && x.iter()\n                    .zip(y)\n                    .all(|((n1, t1), (n2, t2))| n1 == n2 && same_field_order(t1, t2))\n        }\n        (Type::Vec(x), Type::Vec(y)) | (Type::Stream(x), Type::Stream(y)) => same_field_order(x, y),\n        (Type::Enum { variants: vx, .. }, Type::Enum { variants: vy, .. }) => {\n            vx.iter().zip(vy).all(|((_, px), (_, py))| match (px, py) {\n                (Some(tx), Some(ty)) => same_field_order(tx, ty),\n                _ => true,\n            })\n        }\n        _ => true,\n    }\n}\n\n/// Rebuilds `found` -- already known equal to `want` -- so it is physically laid out in\n/// `want`'s field order: a bound local read back out field by field into a fresh literal in\n/// that order, recursing into any field that is itself a differently-ordered record. Also\n/// recurses through a Vec or Stream wrapper, via a real `map` that rebuilds every element --\n/// unlike the record case this is a runtime loop, not a free relabelling, since a Vec's\n/// elements are not reachable one at a time the way a record's fields are (kantord/toylang#64).\n///\n/// A general enum reorders through `Match`/`EnumLit`: every arm rebuilds its variant with a\n/// freshly reordered payload, which every backend can already run since it is exactly how a\n/// user-written match over that enum already compiles. Opt is the one enum this can't reach\n/// (kantord/toylang#66) -- three backends keep Opt in a representation of their own (`Option<T>`,\n/// `tlOpt[T]{ok,v}`, the null-or-boxed native encoding) rather than the general tagged shape, so\n/// `Match`'s tag-indexed codegen does not apply to it. `OptMap` is the dedicated node every\n/// backend already has the pieces to run: it is exactly the presence branch each one's unwrap\n/// and printer already take, generalised to rebuild the payload instead of rendering it.\nfn reorder_enum(ctx: &Ctx, found: Tir, want: &Type) -> Tir {\n    if let Some(want_inner) = want.as_opt() {\n        let found_inner = found\n            .ty\n            .as_opt()\n            .expect(\"found.ty == want: both Opt\")\n            .clone();\n        let param = ctx.fresh();\n        let body = reorder_record(ctx, Tir::new(found_inner, Kind::Local(param)), want_inner);\n        return Tir::new(\n            want.clone(),\n            Kind::OptMap {\n                source: Box::new(found),\n                param,\n                body: Box::new(body),\n            },\n        );\n    }\n    let Type::Enum {\n        variants: want_variants,\n        ..\n    } = want\n    else {\n        unreachable!(\"reorder_enum is only called with an enum want\")\n    };\n    let found_variants = match &found.ty {\n        Type::Enum { variants, .. } => variants.clone(),\n        _ => unreachable!(\"found.ty == want: both enums\"),\n    };\n    let arms = want_variants\n        .iter()\n        .zip(&found_variants)\n        .map(|((vname, want_payload), (_, found_payload))| {\n            let payload = match (want_payload, found_payload) {\n                (Some(want_p), Some(found_p)) => {\n                    let pid = ctx.fresh();\n                    let rebuilt =\n                        reorder_record(ctx, Tir::new(found_p.clone(), Kind::Local(pid)), want_p);\n                    (Some(pid), Some(Box::new(rebuilt)))\n                }\n                (None, None) => (None, None),\n                _ => unreachable!(\"found.ty == want: variant shapes line up\"),\n            };\n            tir::MatchArm {\n                variant: Some(vname.clone()),\n                guard: None,\n                payload: payload.0,\n                body: Tir::new(\n                    want.clone(),\n                    Kind::EnumLit {\n                        variant: vname.clone(),\n                        payload: payload.1,\n                    },\n                ),\n            }\n        })\n        .collect();\n    Tir::new(\n        want.clone(),\n        Kind::Match {\n            subject: Box::new(found),\n            arms,\n            partial: false,\n        },\n    )\n}\nfn reorder_record(ctx: &Ctx, found: Tir, want: &Type) -> Tir {\n    if same_field_order(&found.ty, want) {\n        return found;\n    }\n    match want {\n        Type::Record(want_fields) => {\n            // A bare local can supply its own fields directly without being bound again: a\n            // Field read reaches through it (a struct-of-arrays cursor, when it is a Vec\n            // element, or an ordinary bound value otherwise) without ever asking for the whole\n            // local as a value, which is what a redundant rebind here would do -- and which\n            // the native backend refuses for a cursor, since a map body's element local is\n            // never materialised as one.\n            if let Kind::Local(local) = found.kind {\n                return Tir::new(\n                    want.clone(),\n                    Kind::RecordLit {\n                        fields: reorder_fields(ctx, local, &found.ty, want_fields),\n                    },\n                );\n            }\n            let local = ctx.fresh();\n            let found_ty = found.ty.clone();\n            let fields = reorder_fields(ctx, local, &found_ty, want_fields);\n            Tir::new(\n                want.clone(),\n                Kind::Bind {\n                    local,\n                    value: Box::new(found),\n                    body: Box::new(Tir::new(want.clone(), Kind::RecordLit { fields })),\n                },\n            )\n        }\n        Type::Vec(want_elem) | Type::Stream(want_elem) => {\n            // `found.ty == want` already (the caller's own guard), so its wrapper is the same\n            // kind as `want`'s and `runtime_elem` cannot miss.\n            let elem_ty = tir::runtime_elem(&found.ty)\n                .expect(\"want is Vec/Stream and found.ty == want\")\n                .clone();\n            let param = ctx.fresh();\n            let body = reorder_record(ctx, Tir::new(elem_ty, Kind::Local(param)), want_elem);\n            Tir::new(\n                want.clone(),\n                Kind::Map {\n                    source: Box::new(found),\n                    param,\n                    body: Box::new(body),\n                },\n            )\n        }\n        Type::Enum { .. } => reorder_enum(ctx, found, want),\n        _ => found,\n    }\n}\n\n/// `want_fields`, each read off `local` (of type `local_ty`) in `want_fields`'s order, recursing\n/// into any field that is itself a differently-ordered record.\nfn reorder_fields(\n    ctx: &Ctx,\n    local: LocalId,\n    local_ty: &Type,\n    want_fields: &[(String, Type)],\n) -> Vec<(String, Tir)> {\n    want_fields\n        .iter()\n        .map(|(name, field_ty)| {\n            let access = Tir::new(\n                field_ty.clone(),\n                Kind::Field {\n                    base: Box::new(Tir::new(local_ty.clone(), Kind::Local(local))),\n                    name: name.clone(),\n                },\n            );\n            (name.clone(), reorder_record(ctx, access, field_ty))\n        })\n        .collect()\n}\n\n/// `expect`, minus the final comparison. Each arm here is a form whose type can come from its\n/// position rather than its contents; expectation only ever resolves what synthesis would have\n/// refused -- a form that can synthesise falls through and is compared, never coerced.\n/// `input` against the type its position wants: the first use fills the program-wide slot,\n/// and every later use must agree with it. A signature can spell Stream now, so this position\n/// can ask for one; `input` is a whole value already in hand, which is exactly what a stream\n/// is not.\nfn input_read(ctx: &Ctx, span: Span, want: &Type) -> Result<Tir, Error> {\n    if want.contains_stream() {\n        return Err(Error::new(\n            span,\n            format!(\"`input` is one value read from stdin, but {want} is wanted here\"),\n        ));\n    }\n    // Absence has no ratified wire form: the tag is an in-memory fact, serialization emits\n    // `null` for it going out, and whether `null` coming in reads as `none` is codec design\n    // nobody has done. Refusing is the reversible direction.\n    if want.contains_opt() {\n        return Err(Error::new(\n            span,\n            format!(\"`input` cannot be read as {want}; absence has no wire form to read\"),\n        ));\n    }\n    // A Char is never itself JSON; it only ever comes from decoding a Str already in hand\n    // (`chars`), so there is nothing for a wire value to decode into.\n    if want.contains_char() {\n        return Err(Error::new(\n            span,\n            format!(\"`input` cannot be read as {want}; Char has no wire form to read\"),\n        ));","lineStart":2500,"lineEnd":2959,"totalLines":3239,"truncated":true}},"title":"src/check/mod.rs","time":{"start":1788379889740,"end":1788379889749}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me read the `binary`, `plus`, and the surrounding code (lines 2500-2900), and the `expect`/`conform`/`expect_inner` functions.","format":"unknown","index":0}]}},"id":"prt_063bf7cfe001Rn3t2MqxTo1wtn","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","messageID":"msg_063bf6944001bb0PMg8JskzuCq"}}
{"type":"step_finish","timestamp":1788379889760,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"id":"prt_063bf805d001A8IIB4Dbzeqgj5","reason":"tool-calls","snapshot":"1792faf63d5bfa2d3bcfd92d0c0629bb0dedcd06","messageID":"msg_063bf6944001bb0PMg8JskzuCq","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","type":"step-finish","tokens":{"total":87258,"input":84557,"output":100,"reasoning":41,"cache":{"write":0,"read":2560}},"cost":0.005562545}}
{"type":"step_start","timestamp":1788379891997,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"id":"prt_063bf890d001qWqhmbPLn4Hoek","messageID":"msg_063bf8069001F55YK7cP640ZW1","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","snapshot":"1792faf63d5bfa2d3bcfd92d0c0629bb0dedcd06","type":"step-start"}}
{"type":"tool_use","timestamp":1788379892749,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"type":"tool","tool":"read","callID":"call_14dcc59b280644ca91ca2531","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-174/src/tir.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-174/src/tir.rs</path>\n<type>file</type>\n<content>\n1: //! The typed IR the backends consume.\n2: //!\n3: //! Every node carries the type it was checked at, so a backend never has to ask what a value is\n4: //! at runtime and never has to look a type up in a table beside the tree. A static target cannot\n5: //! work from anything less: it has to know that an add is an integer add before it can emit one.\n6: //!\n7: //! Names are deliberately *not* mangled here. Which identifiers are reserved is a property of\n8: //! the target, not of toylang, so each backend renders these as it needs to.\n9: \n10: use crate::ast::{BinOp, LogicOp};\n11: use crate::ty::{Enums, Type};\n12: \n13: pub struct Tir {\n14:     pub ty: Type,\n15:     pub kind: Kind,\n16: }\n17: \n18: impl Tir {\n19:     pub fn new(ty: Type, kind: Kind) -> Tir {\n20:         Tir { ty, kind }\n21:     }\n22: }\n23: \n24: /// A binding the source cannot name, introduced for `|` and for `select`'s parameter.\n25: pub type LocalId = u32;\n26: \n27: pub enum Kind {\n28:     Str(String),\n29:     Int(i64),\n30:     /// A float literal: an IEEE 754 binary64 double (ADR 0007). Like `Int`, the width lives\n31:     /// in the node's own type -- there is only one float width, so a `Float` node is always\n32:     /// the binary64 the ADR picks, and no other backend needs to consult the type to know.\n33:     Float(f64),\n34:     VecLit(Vec<Tir>),\n35:     /// A record literal, its fields in declaration order so a field's position here matches\n36:     /// its position in the type. That is what lets a backend address one by index rather than\n37:     /// searching for it.\n38:     RecordLit {\n39:         fields: Vec<(String, Tir)>,\n40:     },\n41:     /// A constructed enum value. The node's type is the enum, so a backend finds the variant's\n42:     /// position (its tag, where one is needed) and its payload type by asking `ty::variants`\n43:     /// for that type's list rather than by carrying either here. `payload` is `None` for a unit\n44:     /// variant, which every backend renders as the bare variant-name string; a payload variant\n45:     /// is the single-key wrapper (ADR 0009).\n46:     EnumLit {\n47:         variant: String,\n48:         payload: Option<Box<Tir>>,\n49:     },\n50:     /// Rebuilds an Opt: present-preserving, absent-preserving. `body` runs with `param` bound\n51:     /// to the unwrapped payload only when `source` is present; an absent `source` passes\n52:     /// through untouched. Never surface syntax -- Opt has no general map or match a program can\n53:     /// reach (kantord/toylang#47's totality round owns that) -- this is only how the checker's\n54:     /// own reorder pass reaches inside an Opt payload (kantord/toylang#66): every other enum\n55:     /// reorders through `Match`/`EnumLit`, but Opt keeps a representation of its own in three\n56:     /// backends, so those two general nodes cannot reach it.\n57:     OptMap {\n58:         source: Box<Tir>,\n59:         param: LocalId,\n60:         body: Box<Tir>,\n61:     },\n62:     /// A name written in the source: today only a function parameter.\n63:     Var(String),\n64:     Local(LocalId),\n65:     /// The value read from stdin.\n66:     Input,\n67:     /// Every remaining JSON value on stdin, one per line, eagerly collected into a `Vec<T>`.\n68:     Inputs,\n69:     /// The stream of lines read from stdin, read incrementally by whatever consumes it.\n70:     Lines,\n71:     /// Stdin read as raw lines, each split on the delimiter, born `Vec<Vec<Str>>`: the\n72:     /// parameterized DSV source. `csv`/`tsv` arrive here with the delimiter already fixed.\n73:     Dsv {\n74:         delim: String,\n75:     },\n76:     Call {\n77:         func: String,\n78:         /// `None` for a call to a nullary function.\n79:         arg: Option<Box<Tir>>,\n80:     },\n81:     Concat(Box<Tir>, Box<Tir>),\n82:     /// Wrapping integer arithmetic, at the width the node's own type names: 32 bits for `Int`,\n83:     /// 64 for `Int64` (kantord/toylang#83) -- both operands always share it, since nothing\n84:     /// converts implicitly. Division and remainder stop the program on a zero divisor, which\n85:     /// is the only way arithmetic can fail.\n86:     Arith {\n87:         op: BinOp,\n88:         lhs: Box<Tir>,\n89:         rhs: Box<Tir>,\n90:     },\n91:     Compare {\n92:         op: BinOp,\n93:         lhs: Box<Tir>,\n94:         rhs: Box<Tir>,\n95:     },\n96:     /// `and` / `or` over two Bools, short-circuiting: `rhs` is evaluated only when `lhs` leaves\n97:     /// the answer open. That is not a nicety here -- division and `!` can stop the program, so\n98:     /// whether the right side runs is observable -- which is why every backend emits its own\n99:     /// short-circuiting operator rather than two evaluated operands combined afterwards.\n100:     Logic {\n101:         op: LogicOp,\n102:         lhs: Box<Tir>,\n103:         rhs: Box<Tir>,\n104:     },\n105:     /// `not b`.\n106:     Not(Box<Tir>),\n107:     /// `let local = value in body`, which is what `|` becomes once `.` has a name.\n108:     Bind {\n109:         local: LocalId,\n110:         value: Box<Tir>,\n111:         body: Box<Tir>,\n112:     },\n113:     /// Every element replaced by `body`, with `param` bound to each. Same loop as Select, kept\n114:     /// separate because the result's element type is the body's rather than the source's.\n115:     Map {\n116:         source: Box<Tir>,\n117:         param: LocalId,\n118:         body: Box<Tir>,\n119:     },\n120:     Select {\n121:         source: Box<Tir>,\n122:         param: LocalId,\n123:         pred: Box<Tir>,\n124:     },\n125:     /// Read `name` off `base`. How many Vec layers to descend through is `base.ty`'s doing and\n126:     /// is not stored, so it cannot disagree with the type.\n127:     Field {\n128:         base: Box<Tir>,\n129:         name: String,\n130:     },\n131:     /// Collapse one dimension of `base` at `index`, `depth` layers down.\n132:     ///\n133:     /// Unlike a field access this has to store its depth. A field access leaves a record behind,\n134:     /// so the depth is every Vec layer of the base; an index leaves a Vec behind, so the layers\n135:     /// below the one being collapsed are indistinguishable from the ones above it.\n136:     /// A unary builtin. Unary like every other function, so it needs no special call form.\n137:     Builtin {\n138:         which: Builtin,\n139:         arg: Box<Tir>,\n140:     },\n141:     /// Insist an Opt is present, `depth` layers down. Like a field access and unlike an index,\n142:     /// the depth is every Vec layer of the base, because an Opt is not a dimension.\n143:     Unwrap {\n144:         base: Box<Tir>,\n145:     },\n146:     Index {\n147:         base: Box<Tir>,\n148:         index: Box<Tir>,\n149:         depth: usize,\n150:         /// Whether an entry is a record, which decides if collapsing has to gather columns.\n151:         elem_is_record: bool,\n152:     },\n153:     /// Narrow a dimension to the `[start, end)` window, `depth` layers down, counting negative\n154:     /// bounds from the end. Out-of-range bounds clamp to the valid range rather than answering\n155:     /// `Opt` the way a collapsing `Index` does (kantord/toylang#143), jq's `.[a:b]`; `None`\n156:     /// means the dimension's own boundary (0 and its length), and `start >= end` after\n157:     /// clamping yields empty.\n158:     Slice {\n159:         base: Box<Tir>,\n160:         start: Option<Box<Tir>>,\n161:         end: Option<Box<Tir>>,\n162:         depth: usize,\n163:     },\n164:     /// First-match-wins dispatch over the subject: variant arms test its shape, guard arms\n165:     /// evaluate a Bool of their own. The checker has already resolved every name a pattern\n166:     /// bound, so an arm is only a test, a payload local to bind, and a body.\n167:     ///\n168:     /// When the chain is total (`partial` is false) -- every variant covered, or a default at\n169:     /// the end -- a backend may take the last arm without a test. A partial chain has no such\n170:     /// arm: every test is emitted, and falling off the end produces the absent `Opt`, which is\n171:     /// why the node's type is then `Opt` of the arms' common body type.\n172:     Match {\n173:         subject: Box<Tir>,\n174:         arms: Vec<MatchArm>,\n175:         partial: bool,\n176:     },\n177: }\n178: \n179: pub struct MatchArm {\n180:     /// `Some` tests the subject for this variant. `None` with a `guard` is a guard arm; `None`\n181:     /// with no guard is the default arm, which the checker keeps last.\n182:     pub variant: Option<String>,\n183:     /// The Bool deciding a guard arm, already checked in the subject's scope.\n184:     pub guard: Option<Tir>,\n185:     /// The local the payload binds to in a payload-variant arm; `.` and destructured field\n186:     /// names in the body both read through it.\n187:     pub payload: Option<LocalId>,\n188:     pub body: Tir,\n189: }\n190: \n191: /// The functions the language provides. Each is unary, and so is every user function: something\n192: /// wanting two arguments takes a record, which is what a record literal is for in argument\n193: /// position.\n194: #[derive(Clone, Copy, PartialEq, Eq)]\n195: pub enum Builtin {\n196:     /// `str(n)`, rendering an Int the way the printer does but reachable from a program.\n197:     IntToStr,\n198:     /// `i64(n)`, `Int -> Int64`: the one bridge between the two integer types, explicit\n199:     /// because nothing widens implicitly (kantord/toylang#83). A no-op on every backend whose\n200:     /// runtime integers are already 64 bits wide; JS builds a BigInt, and Go and Rust spell\n201:     /// the cast.\n202:     IntToI64,\n203:     /// `range(n)`, the integers from zero up to but not including n. Zero-based, matching jq,\n204:     /// Python, and this language's own indices.\n205:     Range,\n206:     /// `collect(s)`, `Stream<T> -> Vec<T>`: the one place a stream stops being a stream. What\n207:     /// comes back is an ordinary value, exactly as sized as it needs to be, with no trace left\n208:     /// of how it arrived.\n209:     Collect,\n210:     /// `jsonlines(v)`, printing each element of a `Vec<T>` on its own line rather than wrapping\n211:     /// the whole thing in `[...]`. Named for the format (jsonlines.org, also called NDJSON):\n212:     /// one JSON value per line. Polymorphic over the element type, so it is not in the fixed\n213:     /// signature table `builtin()` reads from; `synth` checks it directly, the way `map` and\n214:     /// `select` are checked from their own arm rather than through a table.\n215:     JsonLines,\n216:     /// `length(v)`, a Vec's length. A dense Vec already tracks this at runtime, so reading it out\n217:     /// costs nothing -- there is no fold or scan hiding behind the name.\n218:     Length,\n219:     /// `flatten(vv)`, flattening a `Vec<Vec<T>>` into one `Vec<T>`, for the case where the\n220:     /// number of inner Vecs is not known at the call site. Joining a fixed, known count of Vecs\n221:     /// is `+` instead (kantord/toylang#97, the add-trait reading of Q2 in plans/questions.md); this\n222:     /// builtin used to be named `concat` and cover both cases before that split.\n223:     Flatten,\n224:     /// `tail(v)`, every element but the first, `None` when `v` is empty. Consistent with how\n225:     /// `Index` already turns \"reaching past what's there\" into `Opt` rather than a runtime\n226:     /// failure.\n227:     Tail,\n228:     /// `fields(r)`, a record's field names in declaration order (kantord/toylang#63, the\n229:     /// accessor #60's ratification promised once order left type identity). The names come from\n230:     /// `r`'s checked type, not its runtime value, so every backend can emit them as a literal;\n231:     /// `r` is still evaluated for whatever it would otherwise do, the same as any other argument.\n232:     Fields,\n233:     /// `chars(s)`, `Str -> Vec<Char>`: every Unicode scalar value in `s`, in order. Decoded by\n234:     /// codepoint on every backend, so a character outside the Basic Multilingual Plane is one\n235:     /// element here even on a target whose own strings need a surrogate pair to spell it\n236:     /// (kantord/toylang#75).\n237:     Chars,\n238:     /// `sort(v)`, `Vec<T> -> Vec<T>`: `v`'s elements in ascending order by the same total order\n239:     /// `<` already gives `T`. One value in, one value out with no lawful Stream instance\n240:     /// (kantord/toylang#86, Q20 in plans/questions.md), so it is checked as a Vec-only builtin the way\n241:     /// `length`/`tail`/`flatten` are rather than through `select`/`map`'s cardinality\n242:     /// polymorphism. Restricted to the element types ordering already typechecks on --\n243:     /// Int, Int64, Str, Char -- so every backend can reach for its native ordering.\n244:     Sort,\n245:     /// `reverse(v)`, `Vec<T> -> Vec<T>`: `v`'s elements in the opposite order. Blocking for the\n246:     /// same reason `sort` is (the whole Vec has to be there before the first output element\n247:     /// is), but unrestricted in element type, since reversing needs no comparison.\n248:     Reverse,\n249:     /// `sum(v)`, the reduction of `+` over `v`'s elements, at the element type's own width: a\n250:     /// `Vec<Int>` sums to `Int`, a `Vec<Int64>` to `Int64`, and an empty Vec sums to 0. Each\n251:     /// addition wraps the way the language's `+` does, so a sum that leaves the width is the\n252:     /// same number a hand-written fold would produce (kantord/toylang#140).\n253:     Sum,\n254:     /// `max(v)`, the greatest of `v`'s elements, `Opt<T>` because an empty Vec has no maximum\n255:     /// -- the same answer indexing gives to absence (kantord/toylang#140). Restricted to the\n256:     /// same two integer element types `sum` takes, so a backend can reach for its native\n257:     /// maximum.\n258:     Max,\n259: }\n260: \n261: pub struct Func {\n262:     pub name: String,\n263:     /// `None` for a nullary function.\n264:     pub param: Option<String>,\n265:     pub param_ty: Option<Type>,\n266:     pub body: Tir,\n267: }\n268: \n269: pub struct Program {\n270:     pub funcs: Vec<Func>,\n271:     pub body: Tir,\n272:     /// The type stdin must have, if the program reads it.\n273:     pub input: Option<Type>,\n274:     /// The element type each line of stdin parses as, if the program reads `inputs`.\n275:     pub inputs: Option<Type>,\n276:     /// Whether the program reads `lines`. A separate flag from `input`, since the two are\n277:     /// unrelated readers of the same real stdin and a program using `lines` alone still needs\n278:     /// it connected, even though `input` is `None`.\n279:     pub uses_lines: bool,\n280:     /// The delimiter the program splits raw lines on, if it reads `dsv`/`csv`/`tsv`. It\n281:     /// reads the same real stdin as the other three, so it is exclusive with them.\n282:     pub dsv: Option<String>,\n283:     /// Every enum the program declared, the prelude's included. A backend has no checker `Ctx`\n284:     /// to hand, and the variant list on a `Type::Enum` is a placeholder wherever a recursive\n285:     /// enum's payload reaches back to itself, so this travels with the tree: it is what\n286:     /// `ty::variants` re-derives from (kantord/toylang#94).\n287:     pub enums: Enums,\n288: }\n289: \n290: /// The element type a backend iterates over. Under eager lowering a stream is materialized as\n291: /// the Vec of its entries, so a Stream's element counts exactly as a Vec's here; the checker's\n292: /// `Type::elem` deliberately does not agree, keeping the reducers Vec-only at the surface.\n293: pub fn runtime_elem(ty: &Type) -> Option<&Type> {\n294:     match ty {\n295:         Type::Vec(t) | Type::Stream(t) => Some(t),\n296:         _ => None,\n297:     }\n298: }\n299: \n300: /// How many dimension layers wrap a scalar -- `Vec`s, plus the outermost `Stream` when there\n301: /// is one. Field access distributes over each of them.\n302: pub fn vec_depth(ty: &Type) -> usize {\n303:     let mut depth = 0;\n304:     let mut inner = ty;\n305:     while let Some(elem) = runtime_elem(inner) {\n306:         depth += 1;\n307:         inner = elem;\n308:     }\n309:     depth\n310: }\n311: \n312: /// One `map`/`select` applied between reading a record and printing it, in source order (the\n313: /// stage nearest the source first).\n314: pub enum Stage<'a> {\n315:     Map { param: LocalId, body: &'a Tir },\n316:     Select { param: LocalId, pred: &'a Tir },\n317: }\n318: \n319: /// What a fused loop reads one entry at a time: parsed JSON values, raw lines, or integers\n320: /// counted out of a `range` call.\n321: #[derive(Clone, Copy)]\n322: pub enum Source<'a> {\n323:     Inputs,\n324:     Lines,\n325:     /// `range(n)` with its already-checked bound `n`, evaluated once before the loop runs.\n326:     Range(&'a Tir),\n327: }\n328: \n329: /// A stream-typed pipeline ending in `jsonlines`, compiled as a read-one/transform-one/\n330: /// write-one loop. Decided by the types, not by a structural guess: the old `recognize_fusion`\n331: /// pattern match retired when `Stream` entered the type grammar (plans/streams.md step 5), so\n332: /// whether a program streams is now exactly whether its types say so.\n333: pub struct Fusion<'a> {\n334:     pub source: Source<'a>,\n335:     pub stages: Vec<Stage<'a>>,\n336: }\n337: \n338: /// What a stream chain bottoms out at: a source, a function's own parameter, or the local a\n339: /// `|` bound.\n340: enum Base<'a> {\n341:     Inputs,\n342:     Lines,\n343:     Range(&'a Tir),\n344:     Var(&'a String),\n345:     Local(LocalId),\n346: }\n347: \n348: /// Append the per-element stages of the stream-typed `t`, returning what its chain bottoms out\n349: /// at.\n350: ///\n351: /// Total, not a recognizer: the checker leaves exactly these kinds able to carry a Stream type\n352: /// (sources, bindings, mappers, calls -- a conditional or match yielding one is refused, and\n353: /// projection is normalized to a Map), so the `unreachable!` arms are compiler bugs, never\n354: /// program shapes. That is the invariant this step lands: a stream-typed program that failed\n355: /// to fuse would silently materialize stdin, which is the defect the feature exists to remove.\n356: fn flatten<'a>(t: &'a Tir, program: &'a Program, stages: &mut Vec<Stage<'a>>) -> Base<'a> {\n357:     match &t.kind {\n358:         Kind::Inputs => Base::Inputs,\n359:         Kind::Lines => Base::Lines,\n360:         // A stream-typed range is its own birth point: the bound is an ordinary value\n361:         // evaluated once, before the loop.\n362:         Kind::Builtin {\n363:             which: Builtin::Range,\n364:             arg,\n365:         } => Base::Range(arg),\n366:         Kind::Var(name) => Base::Var(name),\n367:         Kind::Local(id) => Base::Local(*id),\n368:         Kind::Bind { local, value, body } => {\n369:             let base = flatten(value, program, stages);\n370:             match flatten(body, program, stages) {\n371:                 Base::Local(id) if id == *local => base,\n372:                 _ => unreachable!(\"a piped stream is consumed by the pipe's own body\"),\n373:             }\n374:         }\n375:         Kind::Map {\n376:             source,\n377:             param,\n378:             body,\n379:         } => {\n380:             let base = flatten(source, program, stages);\n381:             stages.push(Stage::Map {\n382:                 param: *param,\n383:                 body,\n384:             });\n385:             base\n386:         }\n387:         Kind::Select {\n388:             source,\n389:             param,\n390:             pred,\n391:         } => {\n392:             let base = flatten(source, program, stages);\n393:             stages.push(Stage::Select {\n394:                 param: *param,\n395:                 pred,\n396:             });\n397:             base\n398:         }\n399:         // The argument's stages first, then the callee's body inlined: its chain bottoms at\n400:         // its own parameter (a stream-returning function must take a stream, and linearity\n401:         // makes the parameter the base of whatever it returns).\n402:         Kind::Call { func, arg } => {\n403:             let f = program\n404:                 .funcs\n405:                 .iter()\n406:                 .find(|f| &f.name == func)\n407:                 .expect(\"the checker resolved every call\");\n408:             // A stream-returning function must take a stream (see `signatures`), so a call\n409:             // reaching here -- one whose result is stream-typed -- always carries an argument.\n410:             let arg = arg\n411:                 .as_deref()\n412:                 .expect(\"a stream-returning function is never nullary\");\n413:             let base = flatten(arg, program, stages);\n414:             let param = f\n415:                 .param\n416:                 .as_deref()\n417:                 .expect(\"a stream-returning function is never nullary\");\n418:             match flatten(&f.body, program, stages) {\n419:                 Base::Var(name) if name == param => base,\n420:                 _ => unreachable!(\"a stream-returning function's chain bottoms at its parameter\"),\n421:             }\n422:         }\n423:         _ => unreachable!(\"the checker leaves no other kind stream-typed\"),\n424:     }\n425: }\n426: \n427: /// The type question `streams_inputs` used to answer by pattern match: a `jsonlines` program\n428: /// whose argument is stream-typed fuses, and one whose argument is a Vec (already collected)\n429: /// stays an ordinary value and runs eagerly, exactly as its types say.\n430: pub fn fusion(program: &Program) -> Option<Fusion<'_>> {\n431:     let Kind::Builtin {\n432:         which: Builtin::JsonLines,\n433:         arg,\n434:     } = &program.body.kind\n435:     else {\n436:         return None;\n437:     };\n438:     if !matches!(arg.ty, Type::Stream(_)) {\n439:         return None;\n440:     }\n441:     let mut stages = Vec::new();\n442:     let source = match flatten(arg, program, &mut stages) {\n443:         Base::Inputs => Source::Inputs,\n444:         Base::Lines => Source::Lines,\n445:         Base::Range(bound) => Source::Range(bound),\n446:         Base::Var(_) | Base::Local(_) => {\n447:             unreachable!(\"a program-level stream chain bottoms at its source\")\n448:         }\n449:     };\n450:     Some(Fusion { source, stages })\n451: }\n452: \n453: /// Every enum type the program prints that can hold another of its own type, deduplicated and\n454: /// in the order the walk meets them.\n455: ///\n456: /// A backend writes its printer by expanding a type inline, which is exactly what does not\n457: /// terminate on one of these. So each gets a named function the expansion can call back into\n458: /// instead, and this is the list of functions to write (kantord/toylang#94). Only what is\n459: /// printed: a program can hold a recursive value, match on it and print an Int, and a printer\n460: /// nobody calls is dead code that Go, at least, would then demand an import for.\n461: pub fn printed_recursive_enums(program: &Program) -> Vec<Type> {\n462:     let mut printed = vec![program.body.ty.clone()];\n463:     let mut collect_printed = |t: &Tir| {\n464:         if let Kind::Builtin {\n465:             which: Builtin::JsonLines,\n466:             arg,\n467:         } = &t.kind\n468:         {\n469:             printed.push(\n470:                 runtime_elem(&arg.ty)\n471:                     .expect(\"jsonlines takes a Vec or a stream\")\n472:                     .clone(),\n473:             );\n474:         }\n475:     };\n476:     for f in &program.funcs {\n477:         each_node(&f.body, &mut collect_printed);\n478:     }\n479:     each_node(&program.body, &mut collect_printed);\n480: \n481:     let mut found = Vec::new();\n482:     let mut seen = Vec::new();\n483:     for ty in &printed {\n484:         reachable_enums(&program.enums, ty, &mut seen, &mut found);\n485:     }\n486:     found.retain(|ty| crate::ty::is_recursive(&program.enums, ty));\n487:     found\n488: }\n489: \n490: /// Append every enum type nested anywhere in `ty` to `found`, descending through payloads read\n491: /// from the registry rather than off the type. `seen` is what stops a recursive one: its own\n492: /// payload leads back to a type already visited.\n493: fn reachable_enums(enums: &Enums, ty: &Type, seen: &mut Vec<Type>, found: &mut Vec<Type>) {\n494:     match ty {\n495:         Type::Vec(e) | Type::Stream(e) => reachable_enums(enums, e, seen, found),\n496:         Type::Record(fields) => {\n497:             for (_, f) in fields {\n498:                 reachable_enums(enums, f, seen, found);\n499:             }\n500:         }\n501:         Type::Enum { name, args, .. } => {\n502:             if seen.contains(ty) {\n503:                 return;\n504:             }\n505:             seen.push(ty.clone());\n506:             found.push(ty.clone());\n507:             for arg in args {\n508:                 reachable_enums(enums, arg, seen, found);\n509:             }\n510:             for (_, payload) in crate::ty::variants_of(enums, name, args) {\n511:                 if let Some(p) = payload {\n512:                     reachable_enums(enums, &p, seen, found);\n513:                 }\n514:             }\n515:         }\n516:         _ => {}\n517:     }\n518: }\n519: \n520: /// Every node in the tree, `t` itself included, in no particular order. The backends each walk\n521: /// the tree their own way, gathering what their own target needs; this is for the questions\n522: /// that are the same on every target.\n523: fn each_node(t: &Tir, f: &mut impl FnMut(&Tir)) {\n524:     f(t);\n525:     match &t.kind {\n526:         Kind::Str(_)\n527:         | Kind::Int(_)\n528:         | Kind::Float(_)\n529:         | Kind::Var(_)\n530:         | Kind::Local(_)\n531:         | Kind::Input\n532:         | Kind::Inputs\n533:         | Kind::Lines\n534:         | Kind::Dsv { .. } => {}\n535:         Kind::VecLit(items) => items.iter().for_each(|i| each_node(i, f)),\n536:         Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| each_node(v, f)),\n537:         Kind::EnumLit { payload, .. } => {\n538:             if let Some(p) = payload {\n539:                 each_node(p, f);\n540:             }\n541:         }\n542:         Kind::Call { arg, .. } => {\n543:             if let Some(a) = arg {\n544:                 each_node(a, f);\n545:             }\n546:         }\n547:         Kind::Concat(l, r)\n548:         | Kind::Compare { lhs: l, rhs: r, .. }\n549:         | Kind::Logic { lhs: l, rhs: r, .. }\n550:         | Kind::Arith { lhs: l, rhs: r, .. } => {\n551:             each_node(l, f);\n552:             each_node(r, f);\n553:         }\n554:         Kind::Not(base) => each_node(base, f),\n555:         Kind::Bind { value, body, .. } => {\n556:             each_node(value, f);\n557:             each_node(body, f);\n558:         }\n559:         Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n560:             each_node(source, f);\n561:             each_node(body, f);\n562:         }\n563:         Kind::Select { source, pred, .. } => {\n564:             each_node(source, f);\n565:             each_node(pred, f);\n566:         }\n567:         Kind::Field { base, .. } | Kind::Unwrap { base } => each_node(base, f),\n568:         Kind::Builtin { arg, .. } => each_node(arg, f),\n569:         Kind::Index { base, index, .. } => {\n570:             each_node(base, f);\n571:             each_node(index, f);\n572:         }\n573:         Kind::Slice { base, start, end, .. } => {\n574:             each_node(base, f);\n575:             if let Some(s) = start {\n576:                 each_node(s, f);\n577:             }\n578:             if let Some(e) = end {\n579:                 each_node(e, f);\n580:             }\n581:         }\n582:         Kind::Match { subject, arms, .. } => {\n583:             each_node(subject, f);\n584:             for arm in arms {\n585:                 if let Some(g) = &arm.guard {\n586:                     each_node(g, f);\n587:                 }\n588:                 each_node(&arm.body, f);\n589:             }\n590:         }\n591:     }\n592: }\n593: \n594: /// Whether `t` makes a self-call to `name` in a tail position: a call whose result is the\n595: /// function's result, with nothing left to do after it. This is what lets the js and py\n596: /// emitters lower a self-tail-recursive function to a loop, the constant-stack contract\n597: /// (kantord/toylang#141).\n598: ///\n599: /// Only a total `Match`'s arm bodies and a `Bind`'s body put their child in tail position; a\n600: /// partial `Match` wraps every arm body in `{some: ...}`, so nothing there is a tail call, and\n601: /// a call feeding an operator (`f(x) + 1`) is a genuine recursion the contract does not cover.\n602: pub fn has_tail_call(name: &str, t: &Tir) -> bool {\n603:     match &t.kind {\n604:         Kind::Call { func, .. } => func == name,\n605:         Kind::Bind { body, .. } => has_tail_call(name, body),\n606:         Kind::Match { arms, partial, .. } if !partial => {\n607:             arms.iter().any(|a| has_tail_call(name, &a.body))\n608:         }\n609:         _ => false,\n610:     }\n611: }\n\n(End of file - total 611 lines)\n</content>","metadata":{"preview":"//! The typed IR the backends consume.\n//!\n//! Every node carries the type it was checked at, so a backend never has to ask what a value is\n//! at runtime and never has to look a type up in a table beside the tree. A static target cannot\n//! work from anything less: it has to know that an add is an integer add before it can emit one.\n//!\n//! Names are deliberately *not* mangled here. Which identifiers are reserved is a property of\n//! the target, not of toylang, so each backend renders these as it needs to.\n\nuse crate::ast::{BinOp, LogicOp};\nuse crate::ty::{Enums, Type};\n\npub struct Tir {\n    pub ty: Type,\n    pub kind: Kind,\n}\n\nimpl Tir {\n    pub fn new(ty: Type, kind: Kind) -> Tir {\n        Tir { ty, kind }","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-174/src/tir.rs","text":"//! The typed IR the backends consume.\n//!\n//! Every node carries the type it was checked at, so a backend never has to ask what a value is\n//! at runtime and never has to look a type up in a table beside the tree. A static target cannot\n//! work from anything less: it has to know that an add is an integer add before it can emit one.\n//!\n//! Names are deliberately *not* mangled here. Which identifiers are reserved is a property of\n//! the target, not of toylang, so each backend renders these as it needs to.\n\nuse crate::ast::{BinOp, LogicOp};\nuse crate::ty::{Enums, Type};\n\npub struct Tir {\n    pub ty: Type,\n    pub kind: Kind,\n}\n\nimpl Tir {\n    pub fn new(ty: Type, kind: Kind) -> Tir {\n        Tir { ty, kind }\n    }\n}\n\n/// A binding the source cannot name, introduced for `|` and for `select`'s parameter.\npub type LocalId = u32;\n\npub enum Kind {\n    Str(String),\n    Int(i64),\n    /// A float literal: an IEEE 754 binary64 double (ADR 0007). Like `Int`, the width lives\n    /// in the node's own type -- there is only one float width, so a `Float` node is always\n    /// the binary64 the ADR picks, and no other backend needs to consult the type to know.\n    Float(f64),\n    VecLit(Vec<Tir>),\n    /// A record literal, its fields in declaration order so a field's position here matches\n    /// its position in the type. That is what lets a backend address one by index rather than\n    /// searching for it.\n    RecordLit {\n        fields: Vec<(String, Tir)>,\n    },\n    /// A constructed enum value. The node's type is the enum, so a backend finds the variant's\n    /// position (its tag, where one is needed) and its payload type by asking `ty::variants`\n    /// for that type's list rather than by carrying either here. `payload` is `None` for a unit\n    /// variant, which every backend renders as the bare variant-name string; a payload variant\n    /// is the single-key wrapper (ADR 0009).\n    EnumLit {\n        variant: String,\n        payload: Option<Box<Tir>>,\n    },\n    /// Rebuilds an Opt: present-preserving, absent-preserving. `body` runs with `param` bound\n    /// to the unwrapped payload only when `source` is present; an absent `source` passes\n    /// through untouched. Never surface syntax -- Opt has no general map or match a program can\n    /// reach (kantord/toylang#47's totality round owns that) -- this is only how the checker's\n    /// own reorder pass reaches inside an Opt payload (kantord/toylang#66): every other enum\n    /// reorders through `Match`/`EnumLit`, but Opt keeps a representation of its own in three\n    /// backends, so those two general nodes cannot reach it.\n    OptMap {\n        source: Box<Tir>,\n        param: LocalId,\n        body: Box<Tir>,\n    },\n    /// A name written in the source: today only a function parameter.\n    Var(String),\n    Local(LocalId),\n    /// The value read from stdin.\n    Input,\n    /// Every remaining JSON value on stdin, one per line, eagerly collected into a `Vec<T>`.\n    Inputs,\n    /// The stream of lines read from stdin, read incrementally by whatever consumes it.\n    Lines,\n    /// Stdin read as raw lines, each split on the delimiter, born `Vec<Vec<Str>>`: the\n    /// parameterized DSV source. `csv`/`tsv` arrive here with the delimiter already fixed.\n    Dsv {\n        delim: String,\n    },\n    Call {\n        func: String,\n        /// `None` for a call to a nullary function.\n        arg: Option<Box<Tir>>,\n    },\n    Concat(Box<Tir>, Box<Tir>),\n    /// Wrapping integer arithmetic, at the width the node's own type names: 32 bits for `Int`,\n    /// 64 for `Int64` (kantord/toylang#83) -- both operands always share it, since nothing\n    /// converts implicitly. Division and remainder stop the program on a zero divisor, which\n    /// is the only way arithmetic can fail.\n    Arith {\n        op: BinOp,\n        lhs: Box<Tir>,\n        rhs: Box<Tir>,\n    },\n    Compare {\n        op: BinOp,\n        lhs: Box<Tir>,\n        rhs: Box<Tir>,\n    },\n    /// `and` / `or` over two Bools, short-circuiting: `rhs` is evaluated only when `lhs` leaves\n    /// the answer open. That is not a nicety here -- division and `!` can stop the program, so\n    /// whether the right side runs is observable -- which is why every backend emits its own\n    /// short-circuiting operator rather than two evaluated operands combined afterwards.\n    Logic {\n        op: LogicOp,\n        lhs: Box<Tir>,\n        rhs: Box<Tir>,\n    },\n    /// `not b`.\n    Not(Box<Tir>),\n    /// `let local = value in body`, which is what `|` becomes once `.` has a name.\n    Bind {\n        local: LocalId,\n        value: Box<Tir>,\n        body: Box<Tir>,\n    },\n    /// Every element replaced by `body`, with `param` bound to each. Same loop as Select, kept\n    /// separate because the result's element type is the body's rather than the source's.\n    Map {\n        source: Box<Tir>,\n        param: LocalId,\n        body: Box<Tir>,\n    },\n    Select {\n        source: Box<Tir>,\n        param: LocalId,\n        pred: Box<Tir>,\n    },\n    /// Read `name` off `base`. How many Vec layers to descend through is `base.ty`'s doing and\n    /// is not stored, so it cannot disagree with the type.\n    Field {\n        base: Box<Tir>,\n        name: String,\n    },\n    /// Collapse one dimension of `base` at `index`, `depth` layers down.\n    ///\n    /// Unlike a field access this has to store its depth. A field access leaves a record behind,\n    /// so the depth is every Vec layer of the base; an index leaves a Vec behind, so the layers\n    /// below the one being collapsed are indistinguishable from the ones above it.\n    /// A unary builtin. Unary like every other function, so it needs no special call form.\n    Builtin {\n        which: Builtin,\n        arg: Box<Tir>,\n    },\n    /// Insist an Opt is present, `depth` layers down. Like a field access and unlike an index,\n    /// the depth is every Vec layer of the base, because an Opt is not a dimension.\n    Unwrap {\n        base: Box<Tir>,\n    },\n    Index {\n        base: Box<Tir>,\n        index: Box<Tir>,\n        depth: usize,\n        /// Whether an entry is a record, which decides if collapsing has to gather columns.\n        elem_is_record: bool,\n    },\n    /// Narrow a dimension to the `[start, end)` window, `depth` layers down, counting negative\n    /// bounds from the end. Out-of-range bounds clamp to the valid range rather than answering\n    /// `Opt` the way a collapsing `Index` does (kantord/toylang#143), jq's `.[a:b]`; `None`\n    /// means the dimension's own boundary (0 and its length), and `start >= end` after\n    /// clamping yields empty.\n    Slice {\n        base: Box<Tir>,\n        start: Option<Box<Tir>>,\n        end: Option<Box<Tir>>,\n        depth: usize,\n    },\n    /// First-match-wins dispatch over the subject: variant arms test its shape, guard arms\n    /// evaluate a Bool of their own. The checker has already resolved every name a pattern\n    /// bound, so an arm is only a test, a payload local to bind, and a body.\n    ///\n    /// When the chain is total (`partial` is false) -- every variant covered, or a default at\n    /// the end -- a backend may take the last arm without a test. A partial chain has no such\n    /// arm: every test is emitted, and falling off the end produces the absent `Opt`, which is\n    /// why the node's type is then `Opt` of the arms' common body type.\n    Match {\n        subject: Box<Tir>,\n        arms: Vec<MatchArm>,\n        partial: bool,\n    },\n}\n\npub struct MatchArm {\n    /// `Some` tests the subject for this variant. `None` with a `guard` is a guard arm; `None`\n    /// with no guard is the default arm, which the checker keeps last.\n    pub variant: Option<String>,\n    /// The Bool deciding a guard arm, already checked in the subject's scope.\n    pub guard: Option<Tir>,\n    /// The local the payload binds to in a payload-variant arm; `.` and destructured field\n    /// names in the body both read through it.\n    pub payload: Option<LocalId>,\n    pub body: Tir,\n}\n\n/// The functions the language provides. Each is unary, and so is every user function: something\n/// wanting two arguments takes a record, which is what a record literal is for in argument\n/// position.\n#[derive(Clone, Copy, PartialEq, Eq)]\npub enum Builtin {\n    /// `str(n)`, rendering an Int the way the printer does but reachable from a program.\n    IntToStr,\n    /// `i64(n)`, `Int -> Int64`: the one bridge between the two integer types, explicit\n    /// because nothing widens implicitly (kantord/toylang#83). A no-op on every backend whose\n    /// runtime integers are already 64 bits wide; JS builds a BigInt, and Go and Rust spell\n    /// the cast.\n    IntToI64,\n    /// `range(n)`, the integers from zero up to but not including n. Zero-based, matching jq,\n    /// Python, and this language's own indices.\n    Range,\n    /// `collect(s)`, `Stream<T> -> Vec<T>`: the one place a stream stops being a stream. What\n    /// comes back is an ordinary value, exactly as sized as it needs to be, with no trace left\n    /// of how it arrived.\n    Collect,\n    /// `jsonlines(v)`, printing each element of a `Vec<T>` on its own line rather than wrapping\n    /// the whole thing in `[...]`. Named for the format (jsonlines.org, also called NDJSON):\n    /// one JSON value per line. Polymorphic over the element type, so it is not in the fixed\n    /// signature table `builtin()` reads from; `synth` checks it directly, the way `map` and\n    /// `select` are checked from their own arm rather than through a table.\n    JsonLines,\n    /// `length(v)`, a Vec's length. A dense Vec already tracks this at runtime, so reading it out\n    /// costs nothing -- there is no fold or scan hiding behind the name.\n    Length,\n    /// `flatten(vv)`, flattening a `Vec<Vec<T>>` into one `Vec<T>`, for the case where the\n    /// number of inner Vecs is not known at the call site. Joining a fixed, known count of Vecs\n    /// is `+` instead (kantord/toylang#97, the add-trait reading of Q2 in plans/questions.md); this\n    /// builtin used to be named `concat` and cover both cases before that split.\n    Flatten,\n    /// `tail(v)`, every element but the first, `None` when `v` is empty. Consistent with how\n    /// `Index` already turns \"reaching past what's there\" into `Opt` rather than a runtime\n    /// failure.\n    Tail,\n    /// `fields(r)`, a record's field names in declaration order (kantord/toylang#63, the\n    /// accessor #60's ratification promised once order left type identity). The names come from\n    /// `r`'s checked type, not its runtime value, so every backend can emit them as a literal;\n    /// `r` is still evaluated for whatever it would otherwise do, the same as any other argument.\n    Fields,\n    /// `chars(s)`, `Str -> Vec<Char>`: every Unicode scalar value in `s`, in order. Decoded by\n    /// codepoint on every backend, so a character outside the Basic Multilingual Plane is one\n    /// element here even on a target whose own strings need a surrogate pair to spell it\n    /// (kantord/toylang#75).\n    Chars,\n    /// `sort(v)`, `Vec<T> -> Vec<T>`: `v`'s elements in ascending order by the same total order\n    /// `<` already gives `T`. One value in, one value out with no lawful Stream instance\n    /// (kantord/toylang#86, Q20 in plans/questions.md), so it is checked as a Vec-only builtin the way\n    /// `length`/`tail`/`flatten` are rather than through `select`/`map`'s cardinality\n    /// polymorphism. Restricted to the element types ordering already typechecks on --\n    /// Int, Int64, Str, Char -- so every backend can reach for its native ordering.\n    Sort,\n    /// `reverse(v)`, `Vec<T> -> Vec<T>`: `v`'s elements in the opposite order. Blocking for the\n    /// same reason `sort` is (the whole Vec has to be there before the first output element\n    /// is), but unrestricted in element type, since reversing needs no comparison.\n    Reverse,\n    /// `sum(v)`, the reduction of `+` over `v`'s elements, at the element type's own width: a\n    /// `Vec<Int>` sums to `Int`, a `Vec<Int64>` to `Int64`, and an empty Vec sums to 0. Each\n    /// addition wraps the way the language's `+` does, so a sum that leaves the width is the\n    /// same number a hand-written fold would produce (kantord/toylang#140).\n    Sum,\n    /// `max(v)`, the greatest of `v`'s elements, `Opt<T>` because an empty Vec has no maximum\n    /// -- the same answer indexing gives to absence (kantord/toylang#140). Restricted to the\n    /// same two integer element types `sum` takes, so a backend can reach for its native\n    /// maximum.\n    Max,\n}\n\npub struct Func {\n    pub name: String,\n    /// `None` for a nullary function.\n    pub param: Option<String>,\n    pub param_ty: Option<Type>,\n    pub body: Tir,\n}\n\npub struct Program {\n    pub funcs: Vec<Func>,\n    pub body: Tir,\n    /// The type stdin must have, if the program reads it.\n    pub input: Option<Type>,\n    /// The element type each line of stdin parses as, if the program reads `inputs`.\n    pub inputs: Option<Type>,\n    /// Whether the program reads `lines`. A separate flag from `input`, since the two are\n    /// unrelated readers of the same real stdin and a program using `lines` alone still needs\n    /// it connected, even though `input` is `None`.\n    pub uses_lines: bool,\n    /// The delimiter the program splits raw lines on, if it reads `dsv`/`csv`/`tsv`. It\n    /// reads the same real stdin as the other three, so it is exclusive with them.\n    pub dsv: Option<String>,\n    /// Every enum the program declared, the prelude's included. A backend has no checker `Ctx`\n    /// to hand, and the variant list on a `Type::Enum` is a placeholder wherever a recursive\n    /// enum's payload reaches back to itself, so this travels with the tree: it is what\n    /// `ty::variants` re-derives from (kantord/toylang#94).\n    pub enums: Enums,\n}\n\n/// The element type a backend iterates over. Under eager lowering a stream is materialized as\n/// the Vec of its entries, so a Stream's element counts exactly as a Vec's here; the checker's\n/// `Type::elem` deliberately does not agree, keeping the reducers Vec-only at the surface.\npub fn runtime_elem(ty: &Type) -> Option<&Type> {\n    match ty {\n        Type::Vec(t) | Type::Stream(t) => Some(t),\n        _ => None,\n    }\n}\n\n/// How many dimension layers wrap a scalar -- `Vec`s, plus the outermost `Stream` when there\n/// is one. Field access distributes over each of them.\npub fn vec_depth(ty: &Type) -> usize {\n    let mut depth = 0;\n    let mut inner = ty;\n    while let Some(elem) = runtime_elem(inner) {\n        depth += 1;\n        inner = elem;\n    }\n    depth\n}\n\n/// One `map`/`select` applied between reading a record and printing it, in source order (the\n/// stage nearest the source first).\npub enum Stage<'a> {\n    Map { param: LocalId, body: &'a Tir },\n    Select { param: LocalId, pred: &'a Tir },\n}\n\n/// What a fused loop reads one entry at a time: parsed JSON values, raw lines, or integers\n/// counted out of a `range` call.\n#[derive(Clone, Copy)]\npub enum Source<'a> {\n    Inputs,\n    Lines,\n    /// `range(n)` with its already-checked bound `n`, evaluated once before the loop runs.\n    Range(&'a Tir),\n}\n\n/// A stream-typed pipeline ending in `jsonlines`, compiled as a read-one/transform-one/\n/// write-one loop. Decided by the types, not by a structural guess: the old `recognize_fusion`\n/// pattern match retired when `Stream` entered the type grammar (plans/streams.md step 5), so\n/// whether a program streams is now exactly whether its types say so.\npub struct Fusion<'a> {\n    pub source: Source<'a>,\n    pub stages: Vec<Stage<'a>>,\n}\n\n/// What a stream chain bottoms out at: a source, a function's own parameter, or the local a\n/// `|` bound.\nenum Base<'a> {\n    Inputs,\n    Lines,\n    Range(&'a Tir),\n    Var(&'a String),\n    Local(LocalId),\n}\n\n/// Append the per-element stages of the stream-typed `t`, returning what its chain bottoms out\n/// at.\n///\n/// Total, not a recognizer: the checker leaves exactly these kinds able to carry a Stream type\n/// (sources, bindings, mappers, calls -- a conditional or match yielding one is refused, and\n/// projection is normalized to a Map), so the `unreachable!` arms are compiler bugs, never\n/// program shapes. That is the invariant this step lands: a stream-typed program that failed\n/// to fuse would silently materialize stdin, which is the defect the feature exists to remove.\nfn flatten<'a>(t: &'a Tir, program: &'a Program, stages: &mut Vec<Stage<'a>>) -> Base<'a> {\n    match &t.kind {\n        Kind::Inputs => Base::Inputs,\n        Kind::Lines => Base::Lines,\n        // A stream-typed range is its own birth point: the bound is an ordinary value\n        // evaluated once, before the loop.\n        Kind::Builtin {\n            which: Builtin::Range,\n            arg,\n        } => Base::Range(arg),\n        Kind::Var(name) => Base::Var(name),\n        Kind::Local(id) => Base::Local(*id),\n        Kind::Bind { local, value, body } => {\n            let base = flatten(value, program, stages);\n            match flatten(body, program, stages) {\n                Base::Local(id) if id == *local => base,\n                _ => unreachable!(\"a piped stream is consumed by the pipe's own body\"),\n            }\n        }\n        Kind::Map {\n            source,\n            param,\n            body,\n        } => {\n            let base = flatten(source, program, stages);\n            stages.push(Stage::Map {\n                param: *param,\n                body,\n            });\n            base\n        }\n        Kind::Select {\n            source,\n            param,\n            pred,\n        } => {\n            let base = flatten(source, program, stages);\n            stages.push(Stage::Select {\n                param: *param,\n                pred,\n            });\n            base\n        }\n        // The argument's stages first, then the callee's body inlined: its chain bottoms at\n        // its own parameter (a stream-returning function must take a stream, and linearity\n        // makes the parameter the base of whatever it returns).\n        Kind::Call { func, arg } => {\n            let f = program\n                .funcs\n                .iter()\n                .find(|f| &f.name == func)\n                .expect(\"the checker resolved every call\");\n            // A stream-returning function must take a stream (see `signatures`), so a call\n            // reaching here -- one whose result is stream-typed -- always carries an argument.\n            let arg = arg\n                .as_deref()\n                .expect(\"a stream-returning function is never nullary\");\n            let base = flatten(arg, program, stages);\n            let param = f\n                .param\n                .as_deref()\n                .expect(\"a stream-returning function is never nullary\");\n            match flatten(&f.body, program, stages) {\n                Base::Var(name) if name == param => base,\n                _ => unreachable!(\"a stream-returning function's chain bottoms at its parameter\"),\n            }\n        }\n        _ => unreachable!(\"the checker leaves no other kind stream-typed\"),\n    }\n}\n\n/// The type question `streams_inputs` used to answer by pattern match: a `jsonlines` program\n/// whose argument is stream-typed fuses, and one whose argument is a Vec (already collected)\n/// stays an ordinary value and runs eagerly, exactly as its types say.\npub fn fusion(program: &Program) -> Option<Fusion<'_>> {\n    let Kind::Builtin {\n        which: Builtin::JsonLines,\n        arg,\n    } = &program.body.kind\n    else {\n        return None;\n    };\n    if !matches!(arg.ty, Type::Stream(_)) {\n        return None;\n    }\n    let mut stages = Vec::new();\n    let source = match flatten(arg, program, &mut stages) {\n        Base::Inputs => Source::Inputs,\n        Base::Lines => Source::Lines,\n        Base::Range(bound) => Source::Range(bound),\n        Base::Var(_) | Base::Local(_) => {\n            unreachable!(\"a program-level stream chain bottoms at its source\")\n        }\n    };\n    Some(Fusion { source, stages })\n}\n\n/// Every enum type the program prints that can hold another of its own type, deduplicated and\n/// in the order the walk meets them.\n///\n/// A backend writes its printer by expanding a type inline, which is exactly what does not\n/// terminate on one of these. So each gets a named function the expansion can call back into\n/// instead, and this is the list of functions to write (kantord/toylang#94). Only what is\n/// printed: a program can hold a recursive value, match on it and print an Int, and a printer\n/// nobody calls is dead code that Go, at least, would then demand an import for.\npub fn printed_recursive_enums(program: &Program) -> Vec<Type> {\n    let mut printed = vec![program.body.ty.clone()];\n    let mut collect_printed = |t: &Tir| {\n        if let Kind::Builtin {\n            which: Builtin::JsonLines,\n            arg,\n        } = &t.kind\n        {\n            printed.push(\n                runtime_elem(&arg.ty)\n                    .expect(\"jsonlines takes a Vec or a stream\")\n                    .clone(),\n            );\n        }\n    };\n    for f in &program.funcs {\n        each_node(&f.body, &mut collect_printed);\n    }\n    each_node(&program.body, &mut collect_printed);\n\n    let mut found = Vec::new();\n    let mut seen = Vec::new();\n    for ty in &printed {\n        reachable_enums(&program.enums, ty, &mut seen, &mut found);\n    }\n    found.retain(|ty| crate::ty::is_recursive(&program.enums, ty));\n    found\n}\n\n/// Append every enum type nested anywhere in `ty` to `found`, descending through payloads read\n/// from the registry rather than off the type. `seen` is what stops a recursive one: its own\n/// payload leads back to a type already visited.\nfn reachable_enums(enums: &Enums, ty: &Type, seen: &mut Vec<Type>, found: &mut Vec<Type>) {\n    match ty {\n        Type::Vec(e) | Type::Stream(e) => reachable_enums(enums, e, seen, found),\n        Type::Record(fields) => {\n            for (_, f) in fields {\n                reachable_enums(enums, f, seen, found);\n            }\n        }\n        Type::Enum { name, args, .. } => {\n            if seen.contains(ty) {\n                return;\n            }\n            seen.push(ty.clone());\n            found.push(ty.clone());\n            for arg in args {\n                reachable_enums(enums, arg, seen, found);\n            }\n            for (_, payload) in crate::ty::variants_of(enums, name, args) {\n                if let Some(p) = payload {\n                    reachable_enums(enums, &p, seen, found);\n                }\n            }\n        }\n        _ => {}\n    }\n}\n\n/// Every node in the tree, `t` itself included, in no particular order. The backends each walk\n/// the tree their own way, gathering what their own target needs; this is for the questions\n/// that are the same on every target.\nfn each_node(t: &Tir, f: &mut impl FnMut(&Tir)) {\n    f(t);\n    match &t.kind {\n        Kind::Str(_)\n        | Kind::Int(_)\n        | Kind::Float(_)\n        | Kind::Var(_)\n        | Kind::Local(_)\n        | Kind::Input\n        | Kind::Inputs\n        | Kind::Lines\n        | Kind::Dsv { .. } => {}\n        Kind::VecLit(items) => items.iter().for_each(|i| each_node(i, f)),\n        Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| each_node(v, f)),\n        Kind::EnumLit { payload, .. } => {\n            if let Some(p) = payload {\n                each_node(p, f);\n            }\n        }\n        Kind::Call { arg, .. } => {\n            if let Some(a) = arg {\n                each_node(a, f);\n            }\n        }\n        Kind::Concat(l, r)\n        | Kind::Compare { lhs: l, rhs: r, .. }\n        | Kind::Logic { lhs: l, rhs: r, .. }\n        | Kind::Arith { lhs: l, rhs: r, .. } => {\n            each_node(l, f);\n            each_node(r, f);\n        }\n        Kind::Not(base) => each_node(base, f),\n        Kind::Bind { value, body, .. } => {\n            each_node(value, f);\n            each_node(body, f);\n        }\n        Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n            each_node(source, f);\n            each_node(body, f);\n        }\n        Kind::Select { source, pred, .. } => {\n            each_node(source, f);\n            each_node(pred, f);\n        }\n        Kind::Field { base, .. } | Kind::Unwrap { base } => each_node(base, f),\n        Kind::Builtin { arg, .. } => each_node(arg, f),\n        Kind::Index { base, index, .. } => {\n            each_node(base, f);\n            each_node(index, f);\n        }\n        Kind::Slice { base, start, end, .. } => {\n            each_node(base, f);\n            if let Some(s) = start {\n                each_node(s, f);\n            }\n            if let Some(e) = end {\n                each_node(e, f);\n            }\n        }\n        Kind::Match { subject, arms, .. } => {\n            each_node(subject, f);\n            for arm in arms {\n                if let Some(g) = &arm.guard {\n                    each_node(g, f);\n                }\n                each_node(&arm.body, f);\n            }\n        }\n    }\n}\n\n/// Whether `t` makes a self-call to `name` in a tail position: a call whose result is the\n/// function's result, with nothing left to do after it. This is what lets the js and py\n/// emitters lower a self-tail-recursive function to a loop, the constant-stack contract\n/// (kantord/toylang#141).\n///\n/// Only a total `Match`'s arm bodies and a `Bind`'s body put their child in tail position; a\n/// partial `Match` wraps every arm body in `{some: ...}`, so nothing there is a tail call, and\n/// a call feeding an operator (`f(x) + 1`) is a genuine recursion the contract does not cover.\npub fn has_tail_call(name: &str, t: &Tir) -> bool {\n    match &t.kind {\n        Kind::Call { func, .. } => func == name,\n        Kind::Bind { body, .. } => has_tail_call(name, body),\n        Kind::Match { arms, partial, .. } if !partial => {\n            arms.iter().any(|a| has_tail_call(name, &a.body))\n        }\n        _ => false,\n    }\n}","lineStart":1,"lineEnd":611,"totalLines":611,"truncated":false}},"title":"src/tir.rs","time":{"start":1788379892737,"end":1788379892747}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me look at the TIR, prelude.rs, lib.rs, and how the backends emit `Kind::Call`. Let me also look at how the prelude module is built (prelude.rs) and how it's checked at build time. And how the funcs become named. The synthesized impl functions will need names like `(trait, type)` pairs.\n\nLet me look at tir.rs.","format":"unknown","index":0}]}},"id":"prt_063bf8bfb001PsxJjHgAg5e1qI","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","messageID":"msg_063bf8069001F55YK7cP640ZW1"}}
{"type":"step_finish","timestamp":1788379892759,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"id":"prt_063bf8c13001pP8iYrqlTwQ4PV","reason":"tool-calls","snapshot":"1792faf63d5bfa2d3bcfd92d0c0629bb0dedcd06","messageID":"msg_063bf8069001F55YK7cP640ZW1","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","type":"step-finish","tokens":{"total":93731,"input":14477,"output":69,"reasoning":81,"cache":{"write":0,"read":79104}},"cost":0.002233669}}
{"type":"step_start","timestamp":1788379894582,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"id":"prt_063bf9334001WYCFLpqu3JvsEF","messageID":"msg_063bf8c23001dE6ayvTQTRT4S4","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","snapshot":"1792faf63d5bfa2d3bcfd92d0c0629bb0dedcd06","type":"step-start"}}
{"type":"tool_use","timestamp":1788379895205,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"type":"tool","tool":"read","callID":"call_94f6e7ff9a4d4f5a9cac35ba","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-174/src/prelude.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-174/src/prelude.rs</path>\n<type>file</type>\n<content>\n1: //! The rudimentary beginning of a module system: one file, `prelude.toy`, whose `pub`\n2: //! definitions are always available to every program. There is no import statement yet -- a\n3: //! program does not name what it wants, it just gets all of it -- and no way for a program's own\n4: //! file to be imported by another. What already exists: `pub fn` marks a definition as part of\n5: //! that always-available set; a non-`pub` one is kept and can serve as a private helper, callable\n6: //! only from within this file (the checker enforces that, by origin, at each call site).\n7: //!\n8: //! `join_lines` used to be a `tir::Builtin`, needing its own codegen in all six backends. Written as\n9: //! ordinary toylang source instead, it is checked and compiled exactly the way a program's own\n10: //! functions are, so getting it right once in the checker is getting it right everywhere.\n11: //!\n12: //! Every `pub` definition is always merged in, whether the program uses it or not; what keeps an\n13: //! unused one from cluttering output and `tags::node_types` is `check::check`'s reachability\n14: //! pass, which prunes any function -- prelude or the program's own -- that the program's body\n15: //! never calls, directly or transitively.\n16: \n17: use crate::ast::{Module, Origin};\n18: \n19: const PRELUDE_SRC: &str = include_str!(\"../prelude.toy\");\n20: \n21: // Defines `checked()`, constructing prelude.toy's already-checked `pub` functions directly\n22: // rather than parsing or type-checking anything: build.rs runs that once, against this same\n23: // source, and writes the result here as plain Rust (kantord/toylang#73).\n24: include!(concat!(env!(\"OUT_DIR\"), \"/prelude_checked.rs\"));\n25: \n26: /// Every declaration in `prelude.toy`, `pub` and private alike. A private one stays in so it can\n27: /// serve as a helper for a `pub` one; the checker refuses any call to it from the program's file.\n28: pub fn module() -> Module {\n29:     let mut module = crate::parse::parse_module(PRELUDE_SRC).expect(\"prelude.toy is valid toylang\");\n30:     for def in &mut module.defs {\n31:         def.origin = Origin::Prelude;\n32:     }\n33:     Module {\n34:         defs: module.defs,\n35:         enums: module.enums.into_iter().filter(|e| e.is_pub).collect(),\n36:     }\n37: }\n38: \n39: /// Prepends the prelude's declarations to `file`, so a program can call any of them. Prepended\n40: /// rather than appended, so a program that redefines the same name is the one flagged as the\n41: /// duplicate -- its span is the one worth showing.\n42: pub fn inject(file: &mut crate::ast::File) {\n43:     let mut module = module();\n44:     module.defs.append(&mut file.defs);\n45:     file.defs = module.defs;\n46:     module.enums.append(&mut file.enums);\n47:     file.enums = module.enums;\n48: }\n\n(End of file - total 48 lines)\n</content>","metadata":{"preview":"//! The rudimentary beginning of a module system: one file, `prelude.toy`, whose `pub`\n//! definitions are always available to every program. There is no import statement yet -- a\n//! program does not name what it wants, it just gets all of it -- and no way for a program's own\n//! file to be imported by another. What already exists: `pub fn` marks a definition as part of\n//! that always-available set; a non-`pub` one is kept and can serve as a private helper, callable\n//! only from within this file (the checker enforces that, by origin, at each call site).\n//!\n//! `join_lines` used to be a `tir::Builtin`, needing its own codegen in all six backends. Written as\n//! ordinary toylang source instead, it is checked and compiled exactly the way a program's own\n//! functions are, so getting it right once in the checker is getting it right everywhere.\n//!\n//! Every `pub` definition is always merged in, whether the program uses it or not; what keeps an\n//! unused one from cluttering output and `tags::node_types` is `check::check`'s reachability\n//! pass, which prunes any function -- prelude or the program's own -- that the program's body\n//! never calls, directly or transitively.\n\nuse crate::ast::{Module, Origin};\n\nconst PRELUDE_SRC: &str = include_str!(\"../prelude.toy\");\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-174/src/prelude.rs","text":"//! The rudimentary beginning of a module system: one file, `prelude.toy`, whose `pub`\n//! definitions are always available to every program. There is no import statement yet -- a\n//! program does not name what it wants, it just gets all of it -- and no way for a program's own\n//! file to be imported by another. What already exists: `pub fn` marks a definition as part of\n//! that always-available set; a non-`pub` one is kept and can serve as a private helper, callable\n//! only from within this file (the checker enforces that, by origin, at each call site).\n//!\n//! `join_lines` used to be a `tir::Builtin`, needing its own codegen in all six backends. Written as\n//! ordinary toylang source instead, it is checked and compiled exactly the way a program's own\n//! functions are, so getting it right once in the checker is getting it right everywhere.\n//!\n//! Every `pub` definition is always merged in, whether the program uses it or not; what keeps an\n//! unused one from cluttering output and `tags::node_types` is `check::check`'s reachability\n//! pass, which prunes any function -- prelude or the program's own -- that the program's body\n//! never calls, directly or transitively.\n\nuse crate::ast::{Module, Origin};\n\nconst PRELUDE_SRC: &str = include_str!(\"../prelude.toy\");\n\n// Defines `checked()`, constructing prelude.toy's already-checked `pub` functions directly\n// rather than parsing or type-checking anything: build.rs runs that once, against this same\n// source, and writes the result here as plain Rust (kantord/toylang#73).\ninclude!(concat!(env!(\"OUT_DIR\"), \"/prelude_checked.rs\"));\n\n/// Every declaration in `prelude.toy`, `pub` and private alike. A private one stays in so it can\n/// serve as a helper for a `pub` one; the checker refuses any call to it from the program's file.\npub fn module() -> Module {\n    let mut module = crate::parse::parse_module(PRELUDE_SRC).expect(\"prelude.toy is valid toylang\");\n    for def in &mut module.defs {\n        def.origin = Origin::Prelude;\n    }\n    Module {\n        defs: module.defs,\n        enums: module.enums.into_iter().filter(|e| e.is_pub).collect(),\n    }\n}\n\n/// Prepends the prelude's declarations to `file`, so a program can call any of them. Prepended\n/// rather than appended, so a program that redefines the same name is the one flagged as the\n/// duplicate -- its span is the one worth showing.\npub fn inject(file: &mut crate::ast::File) {\n    let mut module = module();\n    module.defs.append(&mut file.defs);\n    file.defs = module.defs;\n    module.enums.append(&mut file.enums);\n    file.enums = module.enums;\n}","lineStart":1,"lineEnd":48,"totalLines":48,"truncated":false}},"title":"src/prelude.rs","time":{"start":1788379895178,"end":1788379895188}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now I have a good understanding of the TIR. Let me look at prelude.rs to understand how the prelude module is built, and how `prelude::checked` works.","format":"unknown","index":0}]}},"id":"prt_063bf9587001tkhP4rTEJyDXpg","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","messageID":"msg_063bf8c23001dE6ayvTQTRT4S4"}}
{"type":"tool_use","timestamp":1788379895205,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"type":"tool","tool":"read","callID":"call_2bbf8ceb64ea407f97a56dca","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-174/src/lib.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-174/src/lib.rs</path>\n<type>file</type>\n<content>\n1: pub mod ast;\n2: pub mod check;\n3: pub mod emit_go;\n4: pub mod emit_jq;\n5: pub mod emit_js;\n6: pub mod emit_llvm;\n7: pub mod emit_lua;\n8: pub mod emit_py;\n9: pub mod emit_rs;\n10: pub mod emit_toylang;\n11: pub mod error;\n12: pub mod float;\n13: pub mod fmt_tree;\n14: pub mod input;\n15: pub mod parse;\n16: pub mod prelude;\n17: pub mod tags;\n18: pub mod tir;\n19: pub mod ty;\n20: \n21: use std::cell::RefCell;\n22: use std::io::{BufRead, Write};\n23: use std::rc::Rc;\n24: \n25: use anyhow::{Context, Result};\n26: use error::Error;\n27: use tir::Program;\n28: \n29: #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n30: pub enum Backend {\n31:     Lua,\n32:     Js,\n33:     Native,\n34:     Jq,\n35:     Go,\n36:     Py,\n37:     Rust,\n38: }\n39: \n40: impl Backend {\n41:     /// The backends that must agree on every corpus program. Native and Rust each joined once\n42:     /// they could compile the whole language; until then they were kept out rather than allowed\n43:     /// to turn the harness permanently red, tracked by tests/backend_llvm.rs and\n44:     /// tests/backend_rust.rs respectively.\n45:     pub const ALL: [Backend; 7] = [\n46:         Backend::Lua,\n47:         Backend::Js,\n48:         Backend::Native,\n49:         Backend::Jq,\n50:         Backend::Go,\n51:         Backend::Py,\n52:         Backend::Rust,\n53:     ];\n54: \n55:     /// The spelling used on the command line and in a corpus case's `snapshot` list.\n56:     pub fn from_name(name: &str) -> Option<Backend> {\n57:         Backend::ALL.into_iter().find(|b| b.name() == name)\n58:     }\n59: \n60:     pub fn name(self) -> &'static str {\n61:         match self {\n62:             Backend::Lua => \"lua\",\n63:             Backend::Js => \"js\",\n64:             Backend::Native => \"native\",\n65:             Backend::Jq => \"jq\",\n66:             Backend::Go => \"go\",\n67:             Backend::Py => \"py\",\n68:             Backend::Rust => \"rust\",\n69:         }\n70:     }\n71: \n72:     pub fn emit(self, program: &Program) -> Result<String, String> {\n73:         match self {\n74:             Backend::Lua => Ok(emit_lua::emit(program)),\n75:             Backend::Js => Ok(emit_js::emit(program)),\n76:             Backend::Native => emit_llvm::to_ir(program),\n77:             Backend::Jq => emit_jq::emit(program),\n78:             Backend::Go => Ok(emit_go::emit(program)),\n79:             Backend::Py => Ok(emit_py::emit(program)),\n80:             Backend::Rust => Ok(emit_rs::emit(program)),\n81:         }\n82:     }\n83: }\n84: \n85: pub fn compile(src: &str) -> Result<Program, Error> {\n86:     let mut file = parse::parse(src)?;\n87:     prelude::inject(&mut file);\n88:     check::check(&file)\n89: }\n90: \n91: /// Parses `src` and re-renders it in the canonical toylang style, without checking or injecting\n92: /// the prelude -- a formatter has to work on a program that does not type-check, and it must\n93: /// never print the prelude definitions `compile` splices in for its own purposes.\n94: pub fn fmt(src: &str) -> Result<String, Error> {\n95:     emit_toylang::format_source(src)\n96: }\n97: \n98: pub fn run(src: &str) -> Result<String> {\n99:     run_on(src, None, Backend::Lua)\n100: }\n101: \n102: pub fn run_with_input(src: &str, stdin: Option<&str>) -> Result<String> {\n103:     run_on(src, stdin, Backend::Lua)\n104: }\n105: \n106: /// Whether the generated code for `program` reads `inputs` for itself, one record at a time,\n107: /// rather than needing the whole thing parsed and handed over up front. A type question now,\n108: /// not a shape guess: exactly the programs `tir::fusion` reads from `inputs` -- every backend\n109: /// has a fused loop to emit. An aggregate like `length(collect(inputs))` still has no way to\n110: /// stream no matter which backend runs it. Public so `main.rs` can decide, before it has read\n111: /// anything, whether to drain real stdin itself or hand it to `run_on` untouched.\n112: pub fn streams_inputs(program: &tir::Program) -> bool {\n113:     matches!(\n114:         tir::fusion(program),\n115:         Some(f) if matches!(f.source, tir::Source::Inputs)\n116:     )\n117: }\n118: \n119: /// Compile and run, capturing what the program printed -- except when `stdin` is `None` and\n120: /// `streams_inputs` says the backend reads `inputs` for itself, in which case the real stdin and\n121: /// stdout are connected straight through (`Feed::Live`) and there is nothing left to capture.\n122: /// Capturing otherwise keeps the tests to one call: it also means output is held in memory, which\n123: /// is fine for every program whose result has statically known length, and is exactly the case\n124: /// `Feed::Live` exists for on the ones that no longer do.\n125: pub fn run_on(src: &str, stdin: Option<&str>, backend: Backend) -> Result<String> {\n126:     let program = compile(src)?;\n127: \n128:     // `stdin.is_none()` is the same convention `uses_lines` already uses below: nothing was\n129:     // supplied, which only happens on the real command line, never from a test fixture. Only\n130:     // then is there real live stdin worth handing straight to a subprocess backend rather than\n131:     // something already sitting in memory to validate up front.\n132:     let live_inputs = stdin.is_none() && streams_inputs(&program);\n133:     // Lua is the one backend with no subprocess of its own: `run_lua` itself decides how\n134:     // `inputs` reaches the running chunk, by injecting either a pre-populated global or a\n135:     // per-call function, and the emitted source commits to one of those two shapes purely from\n136:     // `tir::fusion`, independent of whether a fixture or the real command line supplied the\n137:     // bytes. So unlike `live_inputs` above, this also has to hold for a fixture-fed test, or\n138:     // the host would inject the global while the fused source calls the function.\n139:     let lua_fused = matches!(backend, Backend::Lua) && streams_inputs(&program);\n140: \n141:     // The input is checked against the declared type once, here, rather than by each backend.\n142:     // What a backend receives has already been parsed, so no backend re-decides what is valid.\n143:     let value = match (&program.input, stdin) {\n144:         (Some(ty), Some(text)) => {\n145:             let value: serde_json::Value = serde_json::from_str(text)?;\n146:             input::validate(&program.enums, &value, ty, \"input\").map_err(anyhow::Error::msg)?;\n147:             Some(value)\n148:         }\n149:         (Some(ty), None) => anyhow::bail!(\"this program reads input, of type {ty}\"),\n150:         (None, _) => None,\n151:     };\n152: \n153:     // `inputs` is eager like `input`, not incremental like `lines`, so it normally goes through\n154:     // the same validate-then-re-serialize step: every backend receives canonical bytes, one\n155:     // compact JSON value per line, rather than whatever formatting the original text happened to\n156:     // use. `live_inputs` and `lua_fused` are the exceptions -- nothing is precomputed for them,\n157:     // because the whole point of a fused loop is not reading the whole stream before the first\n158:     // record is handled. Validation still happens record-by-record on the host: `run_lua`'s\n159:     // `next_input` function does it for the Lua backend it is embedded in, and `Feed::LiveInputs`\n160:     // below does it for every other, subprocess-based backend, since generated code cannot be\n161:     // trusted to reimplement `input::validate` correctly in six different target languages.\n162:     let inputs_values = if live_inputs || lua_fused {\n163:         None\n164:     } else {\n165:         match (&program.inputs, stdin) {\n166:             (Some(elem_ty), Some(text)) => {\n167:                 let mut values = Vec::new();\n168:                 for line in text.lines().filter(|l| !l.trim().is_empty()) {\n169:                     let value: serde_json::Value = serde_json::from_str(line)?;\n170:                     input::validate(&program.enums, &value, elem_ty, \"inputs\")\n171:                         .map_err(anyhow::Error::msg)?;\n172:                     values.push(value);\n173:                 }\n174:                 Some(values)\n175:             }\n176:             (Some(elem_ty), None) => {\n177:                 anyhow::bail!(\"this program reads inputs, of type Vec<{elem_ty}>\");\n178:             }\n179:             (None, _) => None,\n180:         }\n181:     };\n182: \n183:     // What a backend's stdin should be connected to. `input` always has known bytes: the\n184:     // re-serialized, already-validated value. `lines` has known bytes only when a caller (a\n185:     // corpus fixture, most often) supplied them directly -- and when it does, they are piped in\n186:     // verbatim rather than pre-split, so a backend's own splitting genuinely runs against them\n187:     // rather than being bypassed by the test that is supposed to exercise it. Only when nothing\n188:     // was supplied, which is the real command-line case, does `lines` connect the real stdin\n189:     // straight through, with no Rust-side buffering in between -- the one thing that would make\n190:     // its streaming indistinguishable from having read everything first. A live, fused `inputs`\n191:     // program has no type to lean on the way `lines` does (raw text is always valid `Str`), so it\n192:     // cannot connect the real stdin straight through: `Feed::LiveInputs` reads and validates one\n193:     // record at a time itself and forwards only what passes, real streaming with no read-it-all-\n194:     // first buffering, but through Rust rather than direct fd inheritance. The Lua backend is the\n195:     // one exception -- it validates through its own `next_input` function instead, direct from\n196:     // `Feed::Live`, since it runs embedded rather than as a subprocess with a pipe to mediate.\n197:     // A fused Lua program run against a fixture is not live, but still needs the raw bytes\n198:     // verbatim rather than the eager re-serialized form, since `run_lua`'s injected function does\n199:     // its own splitting the same way `lines` always has.\n200:     let feed = if program.uses_lines || program.dsv.is_some() {\n201:         match stdin {\n202:             Some(text) => Feed::Text(text.to_string()),\n203:             None => Feed::Live,\n204:         }\n205:     } else if live_inputs {\n206:         live_inputs_feed(&program, backend)\n207:     } else if lua_fused {\n208:         Feed::Text(stdin.map(str::to_string).unwrap_or_default())\n209:     } else if let Some(values) = &inputs_values {\n210:         Feed::Text(\n211:             values\n212:                 .iter()\n213:                 .map(|v| v.to_string())\n214:                 .collect::<Vec<_>>()\n215:                 .join(\"\\n\"),\n216:         )\n217:     } else {\n218:         Feed::Text(value.as_ref().map(|v| v.to_string()).unwrap_or_default())\n219:     };\n220: \n221:     match backend {\n222:         Backend::Lua => run_lua(\n223:             &emit_lua::emit(&program),\n224:             &program.enums,\n225:             value.as_ref(),\n226:             inputs_values.as_ref(),\n227:             program.inputs.as_ref(),\n228:             &feed,\n229:         ),\n230:         Backend::Js => run_node(&emit_js::emit(&program), &feed),\n231:         Backend::Jq => run_jq(\n232:             &emit_jq::emit(&program).map_err(anyhow::Error::msg)?,\n233:             JqInvocation {\n234:                 has_value: value.is_some(),\n235:                 raw: matches!(program.body.ty, ty::Type::Str | ty::Type::Sink),\n236:                 uses_lines: program.uses_lines || program.dsv.is_some(),\n237:             },\n238:             &feed,\n239:         ),\n240:         Backend::Go => run_go(&emit_go::emit(&program), &feed),\n241:         Backend::Py => run_py(&emit_py::emit(&program), &feed),\n242:         Backend::Native => {\n243:             let dir = tempfile::tempdir()?;\n244:             let exe = dir.path().join(\"program\");\n245:             link(&program, &exe)?;\n246:             run_binary(&exe, &feed)\n247:         }\n248:         Backend::Rust => {\n249:             let dir = tempfile::tempdir()?;\n250:             let exe = dir.path().join(\"program\");\n251:             link_rust(&emit_rs::emit(&program), &exe)?;\n252:             run_binary(&exe, &feed)\n253:         }\n254:     }\n255: }\n256: \n257: /// The feed for a live, fused `inputs` program: real stdin, but validated. Lua is the exception,\n258: /// since `run_lua`'s own `next_input` function validates directly off `Feed::Live` rather than\n259: /// needing `Feed::LiveInputs` to mediate a pipe it has no subprocess to write into.\n260: fn live_inputs_feed(program: &Program, backend: Backend) -> Feed {\n261:     if matches!(backend, Backend::Lua) {\n262:         Feed::Live\n263:     } else {\n264:         Feed::LiveInputs(\n265:             program\n266:                 .inputs\n267:                 .clone()\n268:                 .expect(\"live_inputs implies an inputs type\"),\n269:             program.enums.clone(),\n270:         )\n271:     }\n272: }\n273: \n274: /// What a subprocess backend's stdin is connected to.\n275: enum Feed {\n276:     /// Known bytes, written through a pipe: `input`'s re-serialized value, a `lines` program's\n277:     /// fixture text verbatim, or nothing for a program that reads no stdin at all.\n278:     Text(String),\n279:     /// The real process stdin, inherited rather than piped. Reachable only for a `lines`\n280:     /// program run with no fixture supplied.\n281:     Live,\n282:     /// The real process stdin, read and validated one record at a time against the element type,\n283:     /// then forwarded through a pipe -- real streaming, but mediated by the host rather than\n284:     /// inherited directly, which is what lets `input::validate` see every record before a\n285:     /// subprocess backend's own, untrusted parse of it does. Reachable only for a live, fused\n286:     /// `inputs` program on a backend other than Lua (see `write_to`).\n287:     LiveInputs(ty::Type, ty::Enums),\n288: }\n289: \n290: impl Feed {\n291:     fn stdio(&self) -> std::process::Stdio {\n292:         match self {\n293:             Feed::Text(_) | Feed::LiveInputs(..) => std::process::Stdio::piped(),\n294:             Feed::Live => std::process::Stdio::inherit(),\n295:         }\n296:     }\n297: \n298:     fn write_to(&self, child: &mut std::process::Child) -> Result<()> {\n299:         match self {\n300:             Feed::Text(text) => {\n301:                 child\n302:                     .stdin\n303:                     .take()\n304:                     .expect(\"piped\")\n305:                     .write_all(text.as_bytes())?;\n306:             }\n307:             Feed::Live => {}\n308:             Feed::LiveInputs(elem_ty, enums) => {\n309:                 let mut stdin = child.stdin.take().expect(\"piped\");\n310:                 for line in std::io::stdin().lock().lines() {\n311:                     let line = line?;\n312:                     if line.trim().is_empty() {\n313:                         continue;\n314:                     }\n315:                     let value: serde_json::Value = serde_json::from_str(&line)?;\n316:                     if let Err(msg) = input::validate(enums, &value, elem_ty, \"inputs\") {\n317:                         // Close the pipe so the child sees EOF and can finish printing whatever\n318:                         // it already validly received, then wait for it before reporting the\n319:                         // refusal -- otherwise this leaves an unreaped child behind.\n320:                         drop(stdin);\n321:                         child.wait()?;\n322:                         return Err(anyhow::Error::msg(msg));\n323:                     }\n324:                     writeln!(stdin, \"{line}\")?;\n325:                 }\n326:             }\n327:         }\n328:         Ok(())\n329:     }\n330: }\n331: \n332: /// Compile to a native executable at `out`.\n333: ///\n334: /// LLVM produces an object file, which is not a program, so this shells out to `cc` for the\n335: /// link. That is a toolchain requirement the Lua backend does not have, since mlua vendors its\n336: /// interpreter.\n337: pub fn link(program: &Program, out: &std::path::Path) -> Result<()> {\n338:     let dir = tempfile::tempdir()?;\n339:     let object = dir.path().join(\"program.o\");\n340:     emit_llvm::compile_to_object(program, &object).map_err(anyhow::Error::msg)?;\n341: \n342:     // The runtime is compiled alongside rather than shipped as a library, which keeps the build\n343:     // to one `cc` call and means there is nothing to install.\n344:     let runtime = dir.path().join(\"toylang.c\");\n345:     std::fs::write(&runtime, emit_llvm::RUNTIME_C)?;\n346: \n347:     let status = std::process::Command::new(\"cc\")\n348:         .arg(&object)\n349:         .arg(&runtime)\n350:         .arg(\"-o\")\n351:         .arg(out)\n352:         .status()\n353:         .context(\"could not run `cc`\")?;\n354:     if !status.success() {\n355:         anyhow::bail!(\"cc failed to link: {status}\");\n356:     }\n357:     Ok(())\n358: }\n359: \n360: /// Compile Rust source to an executable at `out`. One `rustc` call on one self-contained file,\n361: /// no external crate and no Cargo project, the same reason `link` above is one `cc` call: the\n362: /// generated source depends on nothing this compiler did not already assume was installed.\n363: /// Public for the same reason as `link`: `tests/backend_rust.rs` calls it directly, separately\n364: /// from running the result, so a genuine codegen gap (`rustc` rejects the source) is told apart\n365: /// from a legitimate runtime refusal (`rustc` succeeds, the binary exits non-zero).\n366: pub fn link_rust(source: &str, out: &std::path::Path) -> Result<()> {\n367:     let dir = tempfile::tempdir()?;\n368:     let src = dir.path().join(\"program.rs\");\n369:     std::fs::write(&src, source)?;\n370: \n371:     let result = std::process::Command::new(\"rustc\")\n372:         .arg(\"--edition\")\n373:         .arg(\"2021\")\n374:         .arg(&src)\n375:         .arg(\"-o\")\n376:         .arg(out)\n377:         .output()\n378:         .context(\"could not run `rustc`\")?;\n379:     if !result.status.success() {\n380:         anyhow::bail!(\n381:             \"rustc failed to compile: {}\",\n382:             String::from_utf8_lossy(&result.stderr)\n383:         );\n384:     }\n385:     Ok(())\n386: }\n387: \n388: /// Runs `cmd` (already given whatever args the caller needs) connected to `feed`, and returns\n389: /// what it printed.\n390: ///\n391: /// When `feed` is `Feed::Live` or `Feed::LiveInputs` there is no test harness reading the result\n392: /// back: stdout and stderr are inherited straight through to the real terminal or pipe instead of\n393: /// being captured, which is what lets a program that streams actually show output as it produces\n394: /// it rather than all at once when it exits. `Ok(String::new())` reflects that nothing is left to\n395: /// hand back -- it already went to the real stdout directly. `feed.write_to` reports a validation\n396: /// refusal for `Feed::LiveInputs` as an `Err` before this function's own `child.wait()` runs, so\n397: /// that path never reaches here at all.\n398: fn run_subprocess(mut cmd: std::process::Command, label: &str, feed: &Feed) -> Result<String> {\n399:     let live = matches!(feed, Feed::Live | Feed::LiveInputs(..));\n400:     let mut child = cmd\n401:         .stdin(feed.stdio())\n402:         .stdout(if live {\n403:             std::process::Stdio::inherit()\n404:         } else {\n405:             std::process::Stdio::piped()\n406:         })\n407:         .stderr(if live {\n408:             std::process::Stdio::inherit()\n409:         } else {\n410:             std::process::Stdio::piped()\n411:         })\n412:         .spawn()\n413:         .with_context(|| format!(\"could not run `{label}`\"))?;\n414: \n415:     feed.write_to(&mut child)?;\n416: \n417:     if live {\n418:         let status = child.wait()?;\n419:         if !status.success() {\n420:             anyhow::bail!(\"{label} failed\");\n421:         }\n422:         return Ok(String::new());\n423:     }\n424: \n425:     let out = child.wait_with_output()?;\n426:     if !out.status.success() {\n427:         anyhow::bail!(\"{label} failed: {}\", String::from_utf8_lossy(&out.stderr));\n428:     }\n429:     Ok(String::from_utf8(out.stdout)?)\n430: }\n431: \n432: fn run_binary(exe: &std::path::Path, feed: &Feed) -> Result<String> {\n433:     run_subprocess(\n434:         std::process::Command::new(exe),\n435:         \"the compiled program\",\n436:         feed,\n437:     )\n438: }\n439: \n440: /// jq puts stdin in `.`, so a program that reads no input runs with `-n` rather than waiting on\n441: /// a terminal. `has_value` rather than the `Feed` itself, since a `lines` program run live\n442: /// (`Feed::Live`) still has real stdin coming and must not get `-n` on that account.\n443: /// The three facts about a program that shape a jq invocation's flags. Each is derived from\n444: /// the compiled program, not a caller identity -- the fn-params-excessive-bools finding on the\n445: /// old three-bool signature was escalated, and the settled answer was this struct: the facts\n446: /// travel under their names.\n447: struct JqInvocation {\n448:     has_value: bool,\n449:     raw: bool,\n450:     uses_lines: bool,\n451: }\n452: \n453: fn run_jq(source: &str, inv: JqInvocation, feed: &Feed) -> Result<String> {\n454:     let JqInvocation {\n455:         has_value,\n456:         raw,\n457:         uses_lines,\n458:     } = inv;\n459:     let mut cmd = std::process::Command::new(\"jq\");\n460:     // jq's stdout is fully buffered rather than line-buffered whenever it is not a terminal, the\n461:     // same as any other libc stdio program, so a filter over `inputs` piped into another process\n462:     // would otherwise sit on every result until the run ends. `run_subprocess` only inherits\n463:     // stdout instead of capturing it for a live run, so this is still what makes that case show a\n464:     // result as soon as jq produces one rather than at exit.\n465:     cmd.arg(\"--unbuffered\");\n466:     cmd.arg(\"-c\");\n467:     // `-r` decides from the runtime value, so it would print a present Opt<Str> raw and an\n468:     // absent one as the word null. The rule here is the type's, as on every other backend.\n469:     if raw {\n470:         cmd.arg(\"-r\");\n471:     }\n472:     if !has_value && !uses_lines {\n473:         cmd.arg(\"-n\");\n474:     }\n475:     // Raw-input mode, needed for `[ inputs ]` to read lines rather than JSON, and forced by the\n476:     // checker to be the only way `lines` is used in this invocation: mixing it with `input` was\n477:     // rejected there, because `-R` changes what the whole invocation means, not just one call.\n478:     // `-n` here is not \"no input coming\"; it is what raw-input mode needs regardless, since\n479:     // `[ inputs ]` reads for itself rather than through the implicit `.` a normal run would use.\n480:     if uses_lines {\n481:         cmd.arg(\"-R\").arg(\"-n\");\n482:     }\n483:     cmd.arg(source);\n484:     run_subprocess(cmd, \"jq\", feed)\n485: }\n486: \n487: fn run_lua(\n488:     source: &str,\n489:     enums: &ty::Enums,\n490:     value: Option<&serde_json::Value>,\n491:     inputs_values: Option<&Vec<serde_json::Value>>,\n492:     inputs_elem_ty: Option<&ty::Type>,\n493:     feed: &Feed,\n494: ) -> Result<String> {\n495:     let lua = mlua::Lua::new();\n496:     if let Some(value) = value {\n497:         lua.globals()\n498:             .set(emit_lua::INPUT, input::to_lua(&lua, value)?)?;\n499:     }\n500:     if let Some(values) = inputs_values {\n501:         let array = serde_json::Value::Array(values.clone());\n502:         lua.globals()\n503:             .set(emit_lua::INPUTS, input::to_lua(&lua, &array)?)?;\n504:     } else if let Some(elem_ty) = inputs_elem_ty {\n505:         // `inputs_values` is `None` here for one of two reasons: the program does not read\n506:         // `inputs` at all (then `inputs_elem_ty` is also `None`, and neither branch runs), or\n507:         // `run_on` recognized this as a fused program and skipped precomputing the whole Vec on\n508:         // purpose (`live_inputs` or `lua_fused` there). mlua is embedded in this same process, so\n509:         // there is no separate JSON parser to write in Lua source the way Rust's own is -- the\n510:         // generated source just calls this function for the next already-validated, already-\n511:         // converted record. Reading from `feed` rather than always the real stdin is what keeps\n512:         // this correct for a fixture-tested fused program too: `feed` is `Feed::Text` there, the\n513:         // same raw bytes a subprocess backend would have been piped.\n514:         let elem_ty = elem_ty.clone();\n515:         let enums = enums.clone();\n516:         let reader: RefCell<Box<dyn std::io::BufRead>> = RefCell::new(match feed {\n517:             Feed::Live => Box::new(std::io::BufReader::new(std::io::stdin())),\n518:             Feed::Text(text) => Box::new(std::io::Cursor::new(text.clone().into_bytes())),\n519:             // `run_on` never builds this feed for the Lua backend: `live_inputs` there stays\n520:             // `Feed::Live`, since this function's own reader validates each record itself.\n521:             Feed::LiveInputs(..) => unreachable!(\"run_on keeps the Lua backend on Feed::Live\"),\n522:         });\n523:         let next_input = lua.create_function(move |lua, ()| {\n524:             use std::io::BufRead;\n525:             loop {\n526:                 let mut line = String::new();\n527:                 let n = reader\n528:                     .borrow_mut()\n529:                     .read_line(&mut line)\n530:                     .map_err(mlua::Error::external)?;\n531:                 if n == 0 {\n532:                     return Ok(mlua::Value::Nil);\n533:                 }\n534:                 let line = line.strip_suffix('\\n').unwrap_or(&line);\n535:                 if line.trim().is_empty() {\n536:                     continue;\n537:                 }\n538:                 let value: serde_json::Value =\n539:                     serde_json::from_str(line).map_err(mlua::Error::external)?;\n540:                 input::validate(&enums, &value, &elem_ty, \"inputs\")\n541:                     .map_err(mlua::Error::RuntimeError)?;\n542:                 return input::to_lua(lua, &value);\n543:             }\n544:         })?;\n545:         lua.globals().set(emit_lua::NEXT_INPUT, next_input)?;\n546:     }\n547:     // mlua is embedded in this same process, so `io.lines()` in the emitted source reads the\n548:     // real stdin directly -- verified against a live pipe, and exactly what a `lines` program\n549:     // run for real should do. A fixture is different: cargo test runs many tests concurrently\n550:     // in one process, so redirecting the process's own fd 0 would race with all of them, and is\n551:     // not done. Instead the fixture is written to a file of its own and `io.lines` is pointed at\n552:     // it, which keeps Lua's own real line-splitting in the loop rather than reimplementing it in\n553:     // Rust and only testing that reimplementation.\n554:     let _fixture_dir;\n555:     if let Feed::Text(text) = feed {\n556:         let dir = tempfile::tempdir()?;\n557:         let path = dir.path().join(\"stdin.txt\");\n558:         std::fs::write(&path, text)?;\n559:         let path = path\n560:             .to_str()\n561:             .expect(\"a temp path is valid UTF-8\")\n562:             .to_string();\n563:         let io: mlua::Table = lua.globals().get(\"io\")?;\n564:         let real_lines: mlua::Function = io.get(\"lines\")?;\n565:         let fixture =\n566:             lua.create_function(move |_, ()| real_lines.call::<mlua::Value>(path.clone()))?;\n567:         io.set(\"lines\", fixture)?;\n568:         _fixture_dir = Some(dir);\n569:     }\n570: \n571:     // A live run has no test harness reading the result back, the same distinction\n572:     // `run_subprocess` makes for the OS-process backends: `print` writes straight to the real\n573:     // stdout and flushes per call instead of buffering into a string only handed back once the\n574:     // whole chunk finishes.\n575:     let live = matches!(feed, Feed::Live);\n576:     let captured = Rc::new(RefCell::new(String::new()));\n577:     let sink = Rc::clone(&captured);\n578:     let print = lua.create_function(move |_, s: String| {\n579:         if live {\n580:             let mut stdout = std::io::stdout();\n581:             writeln!(stdout, \"{s}\").map_err(mlua::Error::external)?;\n582:             stdout.flush().map_err(mlua::Error::external)?;\n583:         } else {\n584:             sink.borrow_mut().push_str(&s);\n585:             sink.borrow_mut().push('\\n');\n586:         }\n587:         Ok(())\n588:     })?;\n589:     lua.globals().set(\"print\", print)?;\n590: \n591:     lua.load(source).exec()?;\n592: \n593:     if live {\n594:         return Ok(String::new());\n595:     }\n596:     let out = captured.borrow().clone();\n597:     Ok(out)\n598: }\n599: \n600: /// Runs through `python3`. Like `node`, this is an interpreter that has to be on the machine\n601: /// rather than one vendored into the build.\n602: fn run_py(source: &str, feed: &Feed) -> Result<String> {\n603:     let dir = tempfile::tempdir()?;\n604:     let path = dir.path().join(\"program.py\");\n605:     std::fs::write(&path, source)?;\n606: \n607:     let mut cmd = std::process::Command::new(\"python3\");\n608:     cmd.arg(&path);\n609:     run_subprocess(cmd, \"python3\", feed)\n610: }\n611: \n612: /// Runs through `go run`, which compiles and executes in one step. Go has no interpreter, so\n613: /// this is the second backend that needs a real toolchain; like `node` and `cc`, a missing one\n614: /// is an error rather than a skipped backend.\n615: fn run_go(source: &str, feed: &Feed) -> Result<String> {\n616:     let dir = tempfile::tempdir()?;\n617:     let path = dir.path().join(\"main.go\");\n618:     std::fs::write(&path, source)?;\n619: \n620:     let mut cmd = std::process::Command::new(\"go\");\n621:     cmd.arg(\"run\").arg(&path);\n622:     run_subprocess(cmd, \"go\", feed)\n623: }\n624: \n625: /// Runs through `node`, which must be present. A missing toolchain is an error rather than a\n626: /// quietly skipped backend: a report that says two backends agreed when only one ran is worse\n627: /// than no report.\n628: fn run_node(source: &str, feed: &Feed) -> Result<String> {\n629:     let dir = tempfile::tempdir()?;\n630:     let path = dir.path().join(\"program.js\");\n631:     std::fs::write(&path, source)?;\n632: \n633:     let mut cmd = std::process::Command::new(\"node\");\n634:     cmd.arg(&path);\n635:     run_subprocess(cmd, \"node\", feed)\n636: }\n637: \n638: impl std::error::Error for Error {}\n\n(End of file - total 638 lines)\n</content>","metadata":{"preview":"pub mod ast;\npub mod check;\npub mod emit_go;\npub mod emit_jq;\npub mod emit_js;\npub mod emit_llvm;\npub mod emit_lua;\npub mod emit_py;\npub mod emit_rs;\npub mod emit_toylang;\npub mod error;\npub mod float;\npub mod fmt_tree;\npub mod input;\npub mod parse;\npub mod prelude;\npub mod tags;\npub mod tir;\npub mod ty;\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-174/src/lib.rs","text":"pub mod ast;\npub mod check;\npub mod emit_go;\npub mod emit_jq;\npub mod emit_js;\npub mod emit_llvm;\npub mod emit_lua;\npub mod emit_py;\npub mod emit_rs;\npub mod emit_toylang;\npub mod error;\npub mod float;\npub mod fmt_tree;\npub mod input;\npub mod parse;\npub mod prelude;\npub mod tags;\npub mod tir;\npub mod ty;\n\nuse std::cell::RefCell;\nuse std::io::{BufRead, Write};\nuse std::rc::Rc;\n\nuse anyhow::{Context, Result};\nuse error::Error;\nuse tir::Program;\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum Backend {\n    Lua,\n    Js,\n    Native,\n    Jq,\n    Go,\n    Py,\n    Rust,\n}\n\nimpl Backend {\n    /// The backends that must agree on every corpus program. Native and Rust each joined once\n    /// they could compile the whole language; until then they were kept out rather than allowed\n    /// to turn the harness permanently red, tracked by tests/backend_llvm.rs and\n    /// tests/backend_rust.rs respectively.\n    pub const ALL: [Backend; 7] = [\n        Backend::Lua,\n        Backend::Js,\n        Backend::Native,\n        Backend::Jq,\n        Backend::Go,\n        Backend::Py,\n        Backend::Rust,\n    ];\n\n    /// The spelling used on the command line and in a corpus case's `snapshot` list.\n    pub fn from_name(name: &str) -> Option<Backend> {\n        Backend::ALL.into_iter().find(|b| b.name() == name)\n    }\n\n    pub fn name(self) -> &'static str {\n        match self {\n            Backend::Lua => \"lua\",\n            Backend::Js => \"js\",\n            Backend::Native => \"native\",\n            Backend::Jq => \"jq\",\n            Backend::Go => \"go\",\n            Backend::Py => \"py\",\n            Backend::Rust => \"rust\",\n        }\n    }\n\n    pub fn emit(self, program: &Program) -> Result<String, String> {\n        match self {\n            Backend::Lua => Ok(emit_lua::emit(program)),\n            Backend::Js => Ok(emit_js::emit(program)),\n            Backend::Native => emit_llvm::to_ir(program),\n            Backend::Jq => emit_jq::emit(program),\n            Backend::Go => Ok(emit_go::emit(program)),\n            Backend::Py => Ok(emit_py::emit(program)),\n            Backend::Rust => Ok(emit_rs::emit(program)),\n        }\n    }\n}\n\npub fn compile(src: &str) -> Result<Program, Error> {\n    let mut file = parse::parse(src)?;\n    prelude::inject(&mut file);\n    check::check(&file)\n}\n\n/// Parses `src` and re-renders it in the canonical toylang style, without checking or injecting\n/// the prelude -- a formatter has to work on a program that does not type-check, and it must\n/// never print the prelude definitions `compile` splices in for its own purposes.\npub fn fmt(src: &str) -> Result<String, Error> {\n    emit_toylang::format_source(src)\n}\n\npub fn run(src: &str) -> Result<String> {\n    run_on(src, None, Backend::Lua)\n}\n\npub fn run_with_input(src: &str, stdin: Option<&str>) -> Result<String> {\n    run_on(src, stdin, Backend::Lua)\n}\n\n/// Whether the generated code for `program` reads `inputs` for itself, one record at a time,\n/// rather than needing the whole thing parsed and handed over up front. A type question now,\n/// not a shape guess: exactly the programs `tir::fusion` reads from `inputs` -- every backend\n/// has a fused loop to emit. An aggregate like `length(collect(inputs))` still has no way to\n/// stream no matter which backend runs it. Public so `main.rs` can decide, before it has read\n/// anything, whether to drain real stdin itself or hand it to `run_on` untouched.\npub fn streams_inputs(program: &tir::Program) -> bool {\n    matches!(\n        tir::fusion(program),\n        Some(f) if matches!(f.source, tir::Source::Inputs)\n    )\n}\n\n/// Compile and run, capturing what the program printed -- except when `stdin` is `None` and\n/// `streams_inputs` says the backend reads `inputs` for itself, in which case the real stdin and\n/// stdout are connected straight through (`Feed::Live`) and there is nothing left to capture.\n/// Capturing otherwise keeps the tests to one call: it also means output is held in memory, which\n/// is fine for every program whose result has statically known length, and is exactly the case\n/// `Feed::Live` exists for on the ones that no longer do.\npub fn run_on(src: &str, stdin: Option<&str>, backend: Backend) -> Result<String> {\n    let program = compile(src)?;\n\n    // `stdin.is_none()` is the same convention `uses_lines` already uses below: nothing was\n    // supplied, which only happens on the real command line, never from a test fixture. Only\n    // then is there real live stdin worth handing straight to a subprocess backend rather than\n    // something already sitting in memory to validate up front.\n    let live_inputs = stdin.is_none() && streams_inputs(&program);\n    // Lua is the one backend with no subprocess of its own: `run_lua` itself decides how\n    // `inputs` reaches the running chunk, by injecting either a pre-populated global or a\n    // per-call function, and the emitted source commits to one of those two shapes purely from\n    // `tir::fusion`, independent of whether a fixture or the real command line supplied the\n    // bytes. So unlike `live_inputs` above, this also has to hold for a fixture-fed test, or\n    // the host would inject the global while the fused source calls the function.\n    let lua_fused = matches!(backend, Backend::Lua) && streams_inputs(&program);\n\n    // The input is checked against the declared type once, here, rather than by each backend.\n    // What a backend receives has already been parsed, so no backend re-decides what is valid.\n    let value = match (&program.input, stdin) {\n        (Some(ty), Some(text)) => {\n            let value: serde_json::Value = serde_json::from_str(text)?;\n            input::validate(&program.enums, &value, ty, \"input\").map_err(anyhow::Error::msg)?;\n            Some(value)\n        }\n        (Some(ty), None) => anyhow::bail!(\"this program reads input, of type {ty}\"),\n        (None, _) => None,\n    };\n\n    // `inputs` is eager like `input`, not incremental like `lines`, so it normally goes through\n    // the same validate-then-re-serialize step: every backend receives canonical bytes, one\n    // compact JSON value per line, rather than whatever formatting the original text happened to\n    // use. `live_inputs` and `lua_fused` are the exceptions -- nothing is precomputed for them,\n    // because the whole point of a fused loop is not reading the whole stream before the first\n    // record is handled. Validation still happens record-by-record on the host: `run_lua`'s\n    // `next_input` function does it for the Lua backend it is embedded in, and `Feed::LiveInputs`\n    // below does it for every other, subprocess-based backend, since generated code cannot be\n    // trusted to reimplement `input::validate` correctly in six different target languages.\n    let inputs_values = if live_inputs || lua_fused {\n        None\n    } else {\n        match (&program.inputs, stdin) {\n            (Some(elem_ty), Some(text)) => {\n                let mut values = Vec::new();\n                for line in text.lines().filter(|l| !l.trim().is_empty()) {\n                    let value: serde_json::Value = serde_json::from_str(line)?;\n                    input::validate(&program.enums, &value, elem_ty, \"inputs\")\n                        .map_err(anyhow::Error::msg)?;\n                    values.push(value);\n                }\n                Some(values)\n            }\n            (Some(elem_ty), None) => {\n                anyhow::bail!(\"this program reads inputs, of type Vec<{elem_ty}>\");\n            }\n            (None, _) => None,\n        }\n    };\n\n    // What a backend's stdin should be connected to. `input` always has known bytes: the\n    // re-serialized, already-validated value. `lines` has known bytes only when a caller (a\n    // corpus fixture, most often) supplied them directly -- and when it does, they are piped in\n    // verbatim rather than pre-split, so a backend's own splitting genuinely runs against them\n    // rather than being bypassed by the test that is supposed to exercise it. Only when nothing\n    // was supplied, which is the real command-line case, does `lines` connect the real stdin\n    // straight through, with no Rust-side buffering in between -- the one thing that would make\n    // its streaming indistinguishable from having read everything first. A live, fused `inputs`\n    // program has no type to lean on the way `lines` does (raw text is always valid `Str`), so it\n    // cannot connect the real stdin straight through: `Feed::LiveInputs` reads and validates one\n    // record at a time itself and forwards only what passes, real streaming with no read-it-all-\n    // first buffering, but through Rust rather than direct fd inheritance. The Lua backend is the\n    // one exception -- it validates through its own `next_input` function instead, direct from\n    // `Feed::Live`, since it runs embedded rather than as a subprocess with a pipe to mediate.\n    // A fused Lua program run against a fixture is not live, but still needs the raw bytes\n    // verbatim rather than the eager re-serialized form, since `run_lua`'s injected function does\n    // its own splitting the same way `lines` always has.\n    let feed = if program.uses_lines || program.dsv.is_some() {\n        match stdin {\n            Some(text) => Feed::Text(text.to_string()),\n            None => Feed::Live,\n        }\n    } else if live_inputs {\n        live_inputs_feed(&program, backend)\n    } else if lua_fused {\n        Feed::Text(stdin.map(str::to_string).unwrap_or_default())\n    } else if let Some(values) = &inputs_values {\n        Feed::Text(\n            values\n                .iter()\n                .map(|v| v.to_string())\n                .collect::<Vec<_>>()\n                .join(\"\\n\"),\n        )\n    } else {\n        Feed::Text(value.as_ref().map(|v| v.to_string()).unwrap_or_default())\n    };\n\n    match backend {\n        Backend::Lua => run_lua(\n            &emit_lua::emit(&program),\n            &program.enums,\n            value.as_ref(),\n            inputs_values.as_ref(),\n            program.inputs.as_ref(),\n            &feed,\n        ),\n        Backend::Js => run_node(&emit_js::emit(&program), &feed),\n        Backend::Jq => run_jq(\n            &emit_jq::emit(&program).map_err(anyhow::Error::msg)?,\n            JqInvocation {\n                has_value: value.is_some(),\n                raw: matches!(program.body.ty, ty::Type::Str | ty::Type::Sink),\n                uses_lines: program.uses_lines || program.dsv.is_some(),\n            },\n            &feed,\n        ),\n        Backend::Go => run_go(&emit_go::emit(&program), &feed),\n        Backend::Py => run_py(&emit_py::emit(&program), &feed),\n        Backend::Native => {\n            let dir = tempfile::tempdir()?;\n            let exe = dir.path().join(\"program\");\n            link(&program, &exe)?;\n            run_binary(&exe, &feed)\n        }\n        Backend::Rust => {\n            let dir = tempfile::tempdir()?;\n            let exe = dir.path().join(\"program\");\n            link_rust(&emit_rs::emit(&program), &exe)?;\n            run_binary(&exe, &feed)\n        }\n    }\n}\n\n/// The feed for a live, fused `inputs` program: real stdin, but validated. Lua is the exception,\n/// since `run_lua`'s own `next_input` function validates directly off `Feed::Live` rather than\n/// needing `Feed::LiveInputs` to mediate a pipe it has no subprocess to write into.\nfn live_inputs_feed(program: &Program, backend: Backend) -> Feed {\n    if matches!(backend, Backend::Lua) {\n        Feed::Live\n    } else {\n        Feed::LiveInputs(\n            program\n                .inputs\n                .clone()\n                .expect(\"live_inputs implies an inputs type\"),\n            program.enums.clone(),\n        )\n    }\n}\n\n/// What a subprocess backend's stdin is connected to.\nenum Feed {\n    /// Known bytes, written through a pipe: `input`'s re-serialized value, a `lines` program's\n    /// fixture text verbatim, or nothing for a program that reads no stdin at all.\n    Text(String),\n    /// The real process stdin, inherited rather than piped. Reachable only for a `lines`\n    /// program run with no fixture supplied.\n    Live,\n    /// The real process stdin, read and validated one record at a time against the element type,\n    /// then forwarded through a pipe -- real streaming, but mediated by the host rather than\n    /// inherited directly, which is what lets `input::validate` see every record before a\n    /// subprocess backend's own, untrusted parse of it does. Reachable only for a live, fused\n    /// `inputs` program on a backend other than Lua (see `write_to`).\n    LiveInputs(ty::Type, ty::Enums),\n}\n\nimpl Feed {\n    fn stdio(&self) -> std::process::Stdio {\n        match self {\n            Feed::Text(_) | Feed::LiveInputs(..) => std::process::Stdio::piped(),\n            Feed::Live => std::process::Stdio::inherit(),\n        }\n    }\n\n    fn write_to(&self, child: &mut std::process::Child) -> Result<()> {\n        match self {\n            Feed::Text(text) => {\n                child\n                    .stdin\n                    .take()\n                    .expect(\"piped\")\n                    .write_all(text.as_bytes())?;\n            }\n            Feed::Live => {}\n            Feed::LiveInputs(elem_ty, enums) => {\n                let mut stdin = child.stdin.take().expect(\"piped\");\n                for line in std::io::stdin().lock().lines() {\n                    let line = line?;\n                    if line.trim().is_empty() {\n                        continue;\n                    }\n                    let value: serde_json::Value = serde_json::from_str(&line)?;\n                    if let Err(msg) = input::validate(enums, &value, elem_ty, \"inputs\") {\n                        // Close the pipe so the child sees EOF and can finish printing whatever\n                        // it already validly received, then wait for it before reporting the\n                        // refusal -- otherwise this leaves an unreaped child behind.\n                        drop(stdin);\n                        child.wait()?;\n                        return Err(anyhow::Error::msg(msg));\n                    }\n                    writeln!(stdin, \"{line}\")?;\n                }\n            }\n        }\n        Ok(())\n    }\n}\n\n/// Compile to a native executable at `out`.\n///\n/// LLVM produces an object file, which is not a program, so this shells out to `cc` for the\n/// link. That is a toolchain requirement the Lua backend does not have, since mlua vendors its\n/// interpreter.\npub fn link(program: &Program, out: &std::path::Path) -> Result<()> {\n    let dir = tempfile::tempdir()?;\n    let object = dir.path().join(\"program.o\");\n    emit_llvm::compile_to_object(program, &object).map_err(anyhow::Error::msg)?;\n\n    // The runtime is compiled alongside rather than shipped as a library, which keeps the build\n    // to one `cc` call and means there is nothing to install.\n    let runtime = dir.path().join(\"toylang.c\");\n    std::fs::write(&runtime, emit_llvm::RUNTIME_C)?;\n\n    let status = std::process::Command::new(\"cc\")\n        .arg(&object)\n        .arg(&runtime)\n        .arg(\"-o\")\n        .arg(out)\n        .status()\n        .context(\"could not run `cc`\")?;\n    if !status.success() {\n        anyhow::bail!(\"cc failed to link: {status}\");\n    }\n    Ok(())\n}\n\n/// Compile Rust source to an executable at `out`. One `rustc` call on one self-contained file,\n/// no external crate and no Cargo project, the same reason `link` above is one `cc` call: the\n/// generated source depends on nothing this compiler did not already assume was installed.\n/// Public for the same reason as `link`: `tests/backend_rust.rs` calls it directly, separately\n/// from running the result, so a genuine codegen gap (`rustc` rejects the source) is told apart\n/// from a legitimate runtime refusal (`rustc` succeeds, the binary exits non-zero).\npub fn link_rust(source: &str, out: &std::path::Path) -> Result<()> {\n    let dir = tempfile::tempdir()?;\n    let src = dir.path().join(\"program.rs\");\n    std::fs::write(&src, source)?;\n\n    let result = std::process::Command::new(\"rustc\")\n        .arg(\"--edition\")\n        .arg(\"2021\")\n        .arg(&src)\n        .arg(\"-o\")\n        .arg(out)\n        .output()\n        .context(\"could not run `rustc`\")?;\n    if !result.status.success() {\n        anyhow::bail!(\n            \"rustc failed to compile: {}\",\n            String::from_utf8_lossy(&result.stderr)\n        );\n    }\n    Ok(())\n}\n\n/// Runs `cmd` (already given whatever args the caller needs) connected to `feed`, and returns\n/// what it printed.\n///\n/// When `feed` is `Feed::Live` or `Feed::LiveInputs` there is no test harness reading the result\n/// back: stdout and stderr are inherited straight through to the real terminal or pipe instead of\n/// being captured, which is what lets a program that streams actually show output as it produces\n/// it rather than all at once when it exits. `Ok(String::new())` reflects that nothing is left to\n/// hand back -- it already went to the real stdout directly. `feed.write_to` reports a validation\n/// refusal for `Feed::LiveInputs` as an `Err` before this function's own `child.wait()` runs, so\n/// that path never reaches here at all.\nfn run_subprocess(mut cmd: std::process::Command, label: &str, feed: &Feed) -> Result<String> {\n    let live = matches!(feed, Feed::Live | Feed::LiveInputs(..));\n    let mut child = cmd\n        .stdin(feed.stdio())\n        .stdout(if live {\n            std::process::Stdio::inherit()\n        } else {\n            std::process::Stdio::piped()\n        })\n        .stderr(if live {\n            std::process::Stdio::inherit()\n        } else {\n            std::process::Stdio::piped()\n        })\n        .spawn()\n        .with_context(|| format!(\"could not run `{label}`\"))?;\n\n    feed.write_to(&mut child)?;\n\n    if live {\n        let status = child.wait()?;\n        if !status.success() {\n            anyhow::bail!(\"{label} failed\");\n        }\n        return Ok(String::new());\n    }\n\n    let out = child.wait_with_output()?;\n    if !out.status.success() {\n        anyhow::bail!(\"{label} failed: {}\", String::from_utf8_lossy(&out.stderr));\n    }\n    Ok(String::from_utf8(out.stdout)?)\n}\n\nfn run_binary(exe: &std::path::Path, feed: &Feed) -> Result<String> {\n    run_subprocess(\n        std::process::Command::new(exe),\n        \"the compiled program\",\n        feed,\n    )\n}\n\n/// jq puts stdin in `.`, so a program that reads no input runs with `-n` rather than waiting on\n/// a terminal. `has_value` rather than the `Feed` itself, since a `lines` program run live\n/// (`Feed::Live`) still has real stdin coming and must not get `-n` on that account.\n/// The three facts about a program that shape a jq invocation's flags. Each is derived from\n/// the compiled program, not a caller identity -- the fn-params-excessive-bools finding on the\n/// old three-bool signature was escalated, and the settled answer was this struct: the facts\n/// travel under their names.\nstruct JqInvocation {\n    has_value: bool,\n    raw: bool,\n    uses_lines: bool,\n}\n\nfn run_jq(source: &str, inv: JqInvocation, feed: &Feed) -> Result<String> {\n    let JqInvocation {\n        has_value,\n        raw,\n        uses_lines,\n    } = inv;\n    let mut cmd = std::process::Command::new(\"jq\");\n    // jq's stdout is fully buffered rather than line-buffered whenever it is not a terminal, the\n    // same as any other libc stdio program, so a filter over `inputs` piped into another process\n    // would otherwise sit on every result until the run ends. `run_subprocess` only inherits\n    // stdout instead of capturing it for a live run, so this is still what makes that case show a\n    // result as soon as jq produces one rather than at exit.\n    cmd.arg(\"--unbuffered\");\n    cmd.arg(\"-c\");\n    // `-r` decides from the runtime value, so it would print a present Opt<Str> raw and an\n    // absent one as the word null. The rule here is the type's, as on every other backend.\n    if raw {\n        cmd.arg(\"-r\");\n    }\n    if !has_value && !uses_lines {\n        cmd.arg(\"-n\");\n    }\n    // Raw-input mode, needed for `[ inputs ]` to read lines rather than JSON, and forced by the\n    // checker to be the only way `lines` is used in this invocation: mixing it with `input` was\n    // rejected there, because `-R` changes what the whole invocation means, not just one call.\n    // `-n` here is not \"no input coming\"; it is what raw-input mode needs regardless, since\n    // `[ inputs ]` reads for itself rather than through the implicit `.` a normal run would use.\n    if uses_lines {\n        cmd.arg(\"-R\").arg(\"-n\");\n    }\n    cmd.arg(source);\n    run_subprocess(cmd, \"jq\", feed)\n}\n\nfn run_lua(\n    source: &str,\n    enums: &ty::Enums,\n    value: Option<&serde_json::Value>,\n    inputs_values: Option<&Vec<serde_json::Value>>,\n    inputs_elem_ty: Option<&ty::Type>,\n    feed: &Feed,\n) -> Result<String> {\n    let lua = mlua::Lua::new();\n    if let Some(value) = value {\n        lua.globals()\n            .set(emit_lua::INPUT, input::to_lua(&lua, value)?)?;\n    }\n    if let Some(values) = inputs_values {\n        let array = serde_json::Value::Array(values.clone());\n        lua.globals()\n            .set(emit_lua::INPUTS, input::to_lua(&lua, &array)?)?;\n    } else if let Some(elem_ty) = inputs_elem_ty {\n        // `inputs_values` is `None` here for one of two reasons: the program does not read\n        // `inputs` at all (then `inputs_elem_ty` is also `None`, and neither branch runs), or\n        // `run_on` recognized this as a fused program and skipped precomputing the whole Vec on\n        // purpose (`live_inputs` or `lua_fused` there). mlua is embedded in this same process, so\n        // there is no separate JSON parser to write in Lua source the way Rust's own is -- the\n        // generated source just calls this function for the next already-validated, already-\n        // converted record. Reading from `feed` rather than always the real stdin is what keeps\n        // this correct for a fixture-tested fused program too: `feed` is `Feed::Text` there, the\n        // same raw bytes a subprocess backend would have been piped.\n        let elem_ty = elem_ty.clone();\n        let enums = enums.clone();\n        let reader: RefCell<Box<dyn std::io::BufRead>> = RefCell::new(match feed {\n            Feed::Live => Box::new(std::io::BufReader::new(std::io::stdin())),\n            Feed::Text(text) => Box::new(std::io::Cursor::new(text.clone().into_bytes())),\n            // `run_on` never builds this feed for the Lua backend: `live_inputs` there stays\n            // `Feed::Live`, since this function's own reader validates each record itself.\n            Feed::LiveInputs(..) => unreachable!(\"run_on keeps the Lua backend on Feed::Live\"),\n        });\n        let next_input = lua.create_function(move |lua, ()| {\n            use std::io::BufRead;\n            loop {\n                let mut line = String::new();\n                let n = reader\n                    .borrow_mut()\n                    .read_line(&mut line)\n                    .map_err(mlua::Error::external)?;\n                if n == 0 {\n                    return Ok(mlua::Value::Nil);\n                }\n                let line = line.strip_suffix('\\n').unwrap_or(&line);\n                if line.trim().is_empty() {\n                    continue;\n                }\n                let value: serde_json::Value =\n                    serde_json::from_str(line).map_err(mlua::Error::external)?;\n                input::validate(&enums, &value, &elem_ty, \"inputs\")\n                    .map_err(mlua::Error::RuntimeError)?;\n                return input::to_lua(lua, &value);\n            }\n        })?;\n        lua.globals().set(emit_lua::NEXT_INPUT, next_input)?;\n    }\n    // mlua is embedded in this same process, so `io.lines()` in the emitted source reads the\n    // real stdin directly -- verified against a live pipe, and exactly what a `lines` program\n    // run for real should do. A fixture is different: cargo test runs many tests concurrently\n    // in one process, so redirecting the process's own fd 0 would race with all of them, and is\n    // not done. Instead the fixture is written to a file of its own and `io.lines` is pointed at\n    // it, which keeps Lua's own real line-splitting in the loop rather than reimplementing it in\n    // Rust and only testing that reimplementation.\n    let _fixture_dir;\n    if let Feed::Text(text) = feed {\n        let dir = tempfile::tempdir()?;\n        let path = dir.path().join(\"stdin.txt\");\n        std::fs::write(&path, text)?;\n        let path = path\n            .to_str()\n            .expect(\"a temp path is valid UTF-8\")\n            .to_string();\n        let io: mlua::Table = lua.globals().get(\"io\")?;\n        let real_lines: mlua::Function = io.get(\"lines\")?;\n        let fixture =\n            lua.create_function(move |_, ()| real_lines.call::<mlua::Value>(path.clone()))?;\n        io.set(\"lines\", fixture)?;\n        _fixture_dir = Some(dir);\n    }\n\n    // A live run has no test harness reading the result back, the same distinction\n    // `run_subprocess` makes for the OS-process backends: `print` writes straight to the real\n    // stdout and flushes per call instead of buffering into a string only handed back once the\n    // whole chunk finishes.\n    let live = matches!(feed, Feed::Live);\n    let captured = Rc::new(RefCell::new(String::new()));\n    let sink = Rc::clone(&captured);\n    let print = lua.create_function(move |_, s: String| {\n        if live {\n            let mut stdout = std::io::stdout();\n            writeln!(stdout, \"{s}\").map_err(mlua::Error::external)?;\n            stdout.flush().map_err(mlua::Error::external)?;\n        } else {\n            sink.borrow_mut().push_str(&s);\n            sink.borrow_mut().push('\\n');\n        }\n        Ok(())\n    })?;\n    lua.globals().set(\"print\", print)?;\n\n    lua.load(source).exec()?;\n\n    if live {\n        return Ok(String::new());\n    }\n    let out = captured.borrow().clone();\n    Ok(out)\n}\n\n/// Runs through `python3`. Like `node`, this is an interpreter that has to be on the machine\n/// rather than one vendored into the build.\nfn run_py(source: &str, feed: &Feed) -> Result<String> {\n    let dir = tempfile::tempdir()?;\n    let path = dir.path().join(\"program.py\");\n    std::fs::write(&path, source)?;\n\n    let mut cmd = std::process::Command::new(\"python3\");\n    cmd.arg(&path);\n    run_subprocess(cmd, \"python3\", feed)\n}\n\n/// Runs through `go run`, which compiles and executes in one step. Go has no interpreter, so\n/// this is the second backend that needs a real toolchain; like `node` and `cc`, a missing one\n/// is an error rather than a skipped backend.\nfn run_go(source: &str, feed: &Feed) -> Result<String> {\n    let dir = tempfile::tempdir()?;\n    let path = dir.path().join(\"main.go\");\n    std::fs::write(&path, source)?;\n\n    let mut cmd = std::process::Command::new(\"go\");\n    cmd.arg(\"run\").arg(&path);\n    run_subprocess(cmd, \"go\", feed)\n}\n\n/// Runs through `node`, which must be present. A missing toolchain is an error rather than a\n/// quietly skipped backend: a report that says two backends agreed when only one ran is worse\n/// than no report.\nfn run_node(source: &str, feed: &Feed) -> Result<String> {\n    let dir = tempfile::tempdir()?;\n    let path = dir.path().join(\"program.js\");\n    std::fs::write(&path, source)?;\n\n    let mut cmd = std::process::Command::new(\"node\");\n    cmd.arg(&path);\n    run_subprocess(cmd, \"node\", feed)\n}\n\nimpl std::error::Error for Error {}","lineStart":1,"lineEnd":638,"totalLines":638,"truncated":false}},"title":"src/lib.rs","time":{"start":1788379895181,"end":1788379895189}},"id":"prt_063bf958b001DUdalIs5RlC3T4","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","messageID":"msg_063bf8c23001dE6ayvTQTRT4S4"}}
{"type":"step_finish","timestamp":1788379895216,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"id":"prt_063bf95ad001YJhwdO5SpcSkTD","reason":"tool-calls","snapshot":"1792faf63d5bfa2d3bcfd92d0c0629bb0dedcd06","messageID":"msg_063bf8c23001dE6ayvTQTRT4S4","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","type":"step-finish","tokens":{"total":101816,"input":8224,"output":114,"reasoning":38,"cache":{"write":0,"read":93440}},"cost":0.00205696}}
{"type":"step_start","timestamp":1788379896835,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"id":"prt_063bf9c010015FXmcnvnwE5Nwd","messageID":"msg_063bf95bb001YRkwaj5q1woL87","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","snapshot":"1792faf63d5bfa2d3bcfd92d0c0629bb0dedcd06","type":"step-start"}}
{"type":"tool_use","timestamp":1788379897909,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"type":"tool","tool":"read","callID":"call_dedd1d79b4c842678593fa1a","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-174/src/check/types.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-174/src/check/types.rs</path>\n<type>file</type>\n<content>\n1: //! Type resolution: turns the surface syntax of types (`TypeExpr`, `EnumDecl`) into `ty::Type`.\n2: //! Runs once, eagerly, before any expression is checked, and touches neither `Expr` nor `Tir`.\n3: \n4: use std::collections::HashMap;\n5: \n6: use crate::ast::{Alias, Def, EnumDecl, Span, TypeExpr};\n7: use crate::error::Error;\n8: use crate::ty::{self, Sig, Type};\n9: \n10: use super::BUILTIN_NAMES;\n11: \n12: /// Capitalised names are types and lowercase names are values.\n13: ///\n14: /// Every name in the language already followed this, unenforced. Making it a rule is what lets a\n15: /// constructor share a spelling with a call without sharing a namespace: `User {..}` builds and\n16: /// `area {..}` calls, decided by the first letter rather than by looking either one up.\n17: ///\n18: /// Field names are deliberately not covered. They come from data, and JSON objects are entitled\n19: /// to a key spelled `Name`.\n20: fn value_name(name: &str, span: Span, what: &str) -> Result<(), Error> {\n21:     if name.chars().next().is_some_and(char::is_uppercase) {\n22:         return Err(Error::new(\n23:             span,\n24:             format!(\"a {what} starts with a lowercase letter, and `{name}` reads as a type\"),\n25:         ));\n26:     }\n27:     Ok(())\n28: }\n29: \n30: /// The lowercase-constructor spelling of a declared variant's name: identical except the first\n31: /// letter, which is the matcher's capital lowered (gh:156). The casing split is first-letter\n32: /// only, so the rest must match exactly, not merely case-insensitively.\n33: pub(super) fn constructor_of(declared: &str) -> String {\n34:     let mut chars = declared.chars();\n35:     match chars.next() {\n36:         Some(c) => c.to_lowercase().collect::<String>() + chars.as_str(),\n37:         None => String::new(),\n38:     }\n39: }\n40: \n41: /// The matcher spelling of a lowercase constructor: the first letter capitalized (gh:156).\n42: pub(super) fn matcher_of(name: &str) -> String {\n43:     let mut chars = name.chars();\n44:     match chars.next() {\n45:         Some(c) => c.to_uppercase().collect::<String>() + chars.as_str(),\n46:         None => String::new(),\n47:     }\n48: }\n49: \n50: /// Whether `written` is the lowercase-constructor spelling of the declared variant `declared`.\n51: pub(super) fn is_constructor_of(declared: &str, written: &str) -> bool {\n52:     let mut declared_chars = declared.chars();\n53:     let mut written_chars = written.chars();\n54:     match (declared_chars.next(), written_chars.next()) {\n55:         (Some(d), Some(w)) => {\n56:             d.is_uppercase()\n57:                 && w == d.to_lowercase().next().unwrap_or(d)\n58:                 && declared_chars.as_str() == written_chars.as_str()\n59:         }\n60:         _ => false,\n61:     }\n62: }\n63: \n64: /// What a type name stands for. An alias is an abbreviation, so this maps to the written form\n65: /// and `resolve` expands it; nothing downstream ever learns a name was involved.\n66: type Aliases<'a> = HashMap<String, &'a TypeExpr>;\n67: \n68: /// The named types a written annotation can refer to. Aliases expand away; an enum resolves to\n69: /// the identity its declaration created.\n70: pub(super) struct TypeEnv<'a> {\n71:     pub(super) aliases: Aliases<'a>,\n72:     pub(super) enums: HashMap<String, &'a EnumDecl>,\n73: }\n74: \n75: pub(super) fn enum_map(enums: &[EnumDecl]) -> Result<HashMap<String, &EnumDecl>, Error> {\n76:     let mut map: HashMap<String, &EnumDecl> = HashMap::new();\n77:     for e in enums {\n78:         if !e.name.chars().next().is_some_and(char::is_uppercase) {\n79:             return Err(Error::new(\n80:                 e.span,\n81:                 format!(\n82:                     \"a type name starts with a capital letter, and `{}` reads as a value\",\n83:                     e.name\n84:                 ),\n85:             ));\n86:         }\n87:         if ty::is_builtin_type_name(&e.name) {\n88:             return Err(Error::new(\n89:                 e.span,\n90:                 format!(\"`{}` is a built-in type and cannot be redefined\", e.name),\n91:             ));\n92:         }\n93:         for (i, v) in e.variants.iter().enumerate() {\n94:             if e.variants[..i].iter().any(|earlier| earlier.name == v.name) {\n95:                 return Err(Error::new(\n96:                     v.span,\n97:                     format!(\"variant `{}` is declared twice in `{}`\", v.name, e.name),\n98:                 ));\n99:             }\n100:             // The declared name is the matcher, so it starts with a capital letter; the value is\n101:             // built with the lowercase constructor (`Circle` declares, `circle` builds). The\n102:             // prelude's Opt/Result still spell their variants lowercase -- exempting pub enums\n103:             // keeps the build green until gh:165 migrates them, and a program's own variants are\n104:             // all non-pub, so the rule still bites everywhere it should.\n105:             if !e.is_pub && !v.name.chars().next().is_some_and(char::is_uppercase) {\n106:                 return Err(Error::new(\n107:                     v.span,\n108:                     format!(\n109:                         \"a variant name starts with a capital letter; declare `{}` of `{}` as \\\n110:                          `{}`, and build its value with the lowercase constructor `{}`\",\n111:                         v.name,\n112:                         e.name,\n113:                         matcher_of(&v.name),\n114:                         v.name\n115:                     ),\n116:                 ));\n117:             }\n118:         }\n119:         if map.insert(e.name.clone(), e).is_some() {\n120:             return Err(Error::new(\n121:                 e.span,\n122:                 format!(\"type `{}` is defined twice\", e.name),\n123:             ));\n124:         }\n125:     }\n126:     Ok(map)\n127: }\n128: \n129: /// Resolve one enum declaration to its type. `seen` carries the names being expanded and the\n130: /// arguments each was expanded with, exactly as for aliases (whose entry carries no arguments),\n131: /// so an enum whose payload mentions itself is refused rather than expanded forever -- unless it\n132: /// does so behind a `Vec`, which `resolve_named` treats as legal (kantord/toylang#76) and stops\n133: /// expanding at, rather than looping. The arguments travel alongside the name so that a boxed\n134: /// self-reference can be checked against the instantiation it reappears inside\n135: /// (kantord/toylang#117): reusing them is the only way `resolve_named` avoids expanding one\n136: /// forever, so a self-reference that reappears with different arguments -- `Nest<Vec<T>>` inside\n137: /// `Nest<T>` -- has no honest placeholder to return and is refused instead.\n138: ///\n139: /// `args` instantiates a generic declaration: payloads resolve with each parameter bound to\n140: /// its argument, already resolved (an argument never re-enters this enum's `seen` chain, so\n141: /// `Opt<Opt<Int>>` is two honest levels, not a false cycle). `None` builds the registry\n142: /// template instead, each parameter standing for itself as `Type::Param` -- which is also the\n143: /// eager pass that validates a declaration nothing uses.\n144: pub(super) fn resolve_enum(\n145:     decl: &EnumDecl,\n146:     env: &TypeEnv,\n147:     seen: &mut Vec<(String, Vec<Type>)>,\n148:     args: Option<&[Type]>,\n149: ) -> Result<Type, Error> {\n150:     for (i, (p, span)) in decl.params.iter().enumerate() {\n151:         if !p.chars().next().is_some_and(char::is_uppercase) {\n152:             return Err(Error::new(\n153:                 *span,\n154:                 format!(\n155:                     \"a type parameter starts with a capital letter, and `{p}` reads as a value\"\n156:                 ),\n157:             ));\n158:         }\n159:         // A parameter may shadow a declared enum or alias -- resolve_named consults the\n160:         // parameter bindings first, so inside the declaration the name means the parameter,\n161:         // unambiguously, the same scoping Rust gives struct Foo<E> beside an enum E. Refusing\n162:         // the collision instead broke every program declaring enum E the moment the prelude\n163:         // gained Result<T, E> (kantord/toylang#85). Builtins stay off limits: Vec-the-parameter\n164:         // would make every Vec<...> in the payload mean the wrong thing at a distance.\n165:         if ty::is_builtin_type_name(p) {\n166:             return Err(Error::new(\n167:                 *span,\n168:                 format!(\"type parameter `{p}` takes the name of a built-in type\"),\n169:             ));\n170:         }\n171:         if decl.params[..i].iter().any(|(earlier, _)| earlier == p) {\n172:             return Err(Error::new(\n173:                 *span,\n174:                 format!(\"type parameter `{p}` is declared twice in `{}`\", decl.name),\n175:             ));\n176:         }\n177:     }\n178:     let bound: Vec<Type> = match args {\n179:         Some(args) => args.to_vec(),\n180:         None => decl\n181:             .params\n182:             .iter()\n183:             .map(|(p, _)| Type::Param(p.clone()))\n184:             .collect(),\n185:     };\n186:     let params: HashMap<&str, &Type> = decl\n187:         .params\n188:         .iter()\n189:         .map(|(p, _)| p.as_str())\n190:         .zip(bound.iter())\n191:         .collect();\n192:     seen.push((decl.name.clone(), bound.clone()));\n193:     let mut variants = Vec::new();\n194:     for v in &decl.variants {\n195:         let payload = match &v.payload {\n196:             Some(ty) => {\n197:                 // `boxed` starts false at the top of every variant: whether this one payload\n198:                 // reaches back to `decl.name` through a `Vec` is assessed fresh each time, so\n199:                 // `enum E { safe(Vec<E>), bad(E) }` accepts `safe` and still refuses `bad`.\n200:                 let resolved = resolve_bound(ty, env, seen, &params, false)?;\n201:                 // The record and Vec spellings refuse a stream inside themselves, but the\n202:                 // parens spelling can put one directly in payload position, so the ban has to\n203:                 // be stated here too: an enum value is storable, and a stream is not. A sink\n204:                 // is not storable either, for the same reason.\n205:                 if resolved.contains_stream() {\n206:                     return Err(Error::new(\n207:                         ty.span(),\n208:                         format!(\n209:                             \"the payload of `{}` cannot hold a stream, which has nothing to store\",\n210:                             v.name\n211:                         ),\n212:                     ));\n213:                 }\n214:                 if resolved.contains_sink() {\n215:                     return Err(Error::new(\n216:                         ty.span(),\n217:                         format!(\n218:                             \"the payload of `{}` cannot hold a sink, which has no value to store\",\n219:                             v.name\n220:                         ),\n221:                     ));\n222:                 }\n223:                 Some(resolved)\n224:             }\n225:             None => None,\n226:         };\n227:         variants.push((v.name.clone(), payload));\n228:     }\n229:     seen.pop();\n230:     Ok(Type::Enum {\n231:         name: decl.name.clone(),\n232:         args: bound,\n233:         variants,\n234:     })\n235: }\n236: \n237: pub(super) fn alias_map(aliases: &[Alias]) -> Result<Aliases<'_>, Error> {\n238:     let mut map: Aliases = HashMap::new();\n239:     for a in aliases {\n240:         if !a.name.chars().next().is_some_and(char::is_uppercase) {\n241:             return Err(Error::new(\n242:                 a.span,\n243:                 format!(\n244:                     \"a type name starts with a capital letter, and `{}` reads as a value\",\n245:                     a.name\n246:                 ),\n247:             ));\n248:         }\n249:         if ty::is_builtin_type_name(&a.name) {\n250:             return Err(Error::new(\n251:                 a.span,\n252:                 format!(\"`{}` is a built-in type and cannot be redefined\", a.name),\n253:             ));\n254:         }\n255:         if map.insert(a.name.clone(), &a.ty).is_some() {\n256:             return Err(Error::new(\n257:                 a.span,\n258:                 format!(\"type `{}` is defined twice\", a.name),\n259:             ));\n260:         }\n261:     }\n262:     Ok(map)\n263: }\n264: \n265: pub(super) fn signatures(defs: &[Def], env: &TypeEnv) -> Result<HashMap<String, Sig>, Error> {\n266:     let mut sigs = HashMap::new();\n267:     for def in defs {\n268:         value_name(&def.name, def.span, \"function name\")?;\n269:         if let Some(param) = &def.param {\n270:             value_name(&param.name, param.span, \"parameter name\")?;\n271:         }\n272:         if BUILTIN_NAMES.contains(&def.name.as_str()) {\n273:             return Err(Error::new(\n274:                 def.span,\n275:                 format!(\"`{}` is a builtin and cannot be redefined\", def.name),\n276:             ));\n277:         }\n278:         if sigs.contains_key(&def.name) {\n279:             return Err(Error::new(\n280:                 def.span,\n281:                 format!(\"`{}` is defined twice\", def.name),\n282:             ));\n283:         }\n284:         let sig = Sig {\n285:             param: match &def.param {\n286:                 Some(param) => Some(resolve(&param.ty, env, &mut Vec::new())?),\n287:                 None => None,\n288:             },\n289:             ret: resolve(&def.ret, env, &mut Vec::new())?,\n290:         };\n291:         // A stream is born only at a source, so a function cannot conjure one: a stream result\n292:         // flows in through a stream parameter, and the pipeline stays one chain fusion can\n293:         // read. Refusing is the reversible direction.\n294:         if matches!(sig.ret, Type::Stream(_)) && !matches!(sig.param, Some(Type::Stream(_))) {\n295:             return Err(Error::new(\n296:                 def.span,\n297:                 format!(\n298:                     \"`{}` returns {} without taking a stream; a stream is born only at a source\",\n299:                     def.name, sig.ret\n300:                 ),\n301:             ));\n302:         }\n303:         // A sink is not a value, so nothing can be passed one: `Sink` is legal as a return\n304:         // type, and nowhere else in a signature.\n305:         if matches!(sig.param, Some(Type::Sink)) {\n306:             return Err(Error::new(\n307:                 def.span,\n308:                 format!(\n309:                     \"`{}` cannot take a Sink parameter; a sink has no value to pass\",\n310:                     def.name\n311:                 ),\n312:             ));\n313:         }\n314:         sigs.insert(def.name.clone(), sig);\n315:     }\n316:     Ok(sigs)\n317: }\n318: \n319: /// `seen` is the chain of names currently being expanded, each with the arguments it was\n320: /// expanded with -- aliases and enums share it -- so a type written in terms of itself is\n321: /// caught rather than expanded forever.\n322: pub(super) fn resolve(\n323:     ty: &TypeExpr,\n324:     env: &TypeEnv,\n325:     seen: &mut Vec<(String, Vec<Type>)>,\n326: ) -> Result<Type, Error> {\n327:     resolve_bound(ty, env, seen, &HashMap::new(), false)\n328: }\n329: \n330: /// The arity-checked, resolved type arguments for `name`'s `<...>`, shared between an ordinary\n331: /// instantiation and a self-reference caught below -- both need the same check against\n332: /// `decl.params.len()`, one on the way to expanding the declaration and the other on the way to\n333: /// a placeholder for it. An argument is a fresh type position, not a continuation of whatever\n334: /// `Vec` this occurrence of `name` itself sat behind, so it resolves with `boxed` reset to\n335: /// `false` rather than threading the caller's through.\n336: fn resolve_args(\n337:     name: &str,\n338:     args: &[TypeExpr],\n339:     decl_params: usize,\n340:     span: Span,\n341:     env: &TypeEnv,\n342:     seen: &mut Vec<(String, Vec<Type>)>,\n343:     params: &HashMap<&str, &Type>,\n344: ) -> Result<Vec<Type>, Error> {\n345:     if args.len() != decl_params {\n346:         let wants = match decl_params {\n347:             0 => format!(\"`{name}` takes no type argument\"),\n348:             1 => format!(\"`{name}` takes one type argument\"),\n349:             n => format!(\"`{name}` takes {n} type arguments\"),\n350:         };\n351:         let found = match args.len() {\n352:             0 => String::new(),\n353:             n => format!(\", found {n}\"),\n354:         };\n355:         return Err(Error::new(span, format!(\"{wants}{found}\")));\n356:     }\n357:     let mut resolved_args = Vec::new();\n358:     for arg in args {\n359:         let resolved = resolve_bound(arg, env, seen, params, false)?;\n360:         if resolved.contains_stream() {\n361:             return Err(Error::new(\n362:                 arg.span(),\n363:                 format!(\"`{name}` cannot hold a stream, which has nothing to store\"),\n364:             ));\n365:         }\n366:         if resolved.contains_sink() {\n367:             return Err(Error::new(\n368:                 arg.span(),\n369:                 format!(\"`{name}` cannot hold a sink, which has no value to store\"),\n370:             ));\n371:         }\n372:         resolved_args.push(resolved);\n373:     }\n374:     Ok(resolved_args)\n375: }\n376: \n377: /// One named reference: a bound parameter, a built-in scalar, an alias, or an enum -- with\n378: /// the arity of its `<...>` arguments held here, where the declaration is in hand.\n379: ///\n380: /// `boxed` is whether this occurrence has already passed through a `Vec` since the innermost\n381: /// enum currently being expanded (`seen`'s top) started -- reset at the top of each variant's\n382: /// payload by `resolve_enum`, set by the `Vec` arm below, and otherwise carried through\n383: /// unchanged, because once a value's storage is a heap indirection every field nested inside it\n384: /// stays indirect too.\n385: fn resolve_named(\n386:     name: &str,\n387:     args: &[TypeExpr],\n388:     span: Span,\n389:     env: &TypeEnv,\n390:     seen: &mut Vec<(String, Vec<Type>)>,\n391:     params: &HashMap<&str, &Type>,\n392:     boxed: bool,\n393: ) -> Result<Type, Error> {\n394:     if let Some(bound) = params.get(name) {\n395:         if !args.is_empty() {\n396:             return Err(Error::new(\n397:                 span,\n398:                 format!(\"`{name}` is a type parameter and takes no type argument\"),\n399:             ));\n400:         }\n401:         return Ok((*bound).clone());\n402:     }\n403:     if let Some(built_in) = Type::from_name(name) {\n404:         if !args.is_empty() {\n405:             return Err(Error::new(span, format!(\"`{name}` takes no type argument\")));\n406:         }\n407:         return Ok(built_in);\n408:     }\n409:     if let Some(at) = seen.iter().position(|(s, _)| s == name) {\n410:         // Behind a `Vec`, a self-reference is a heap indirection rather than an infinite\n411:         // layout, the same reason `Vec<Json>` is an ordinary field and not a contradiction\n412:         // (kantord/toylang#76: Json's array case). Nothing downstream can expand `name`'s own\n413:         // variants without looping forever -- `name` is still on `seen` -- so this stops one\n414:         // layer short and returns a placeholder instead; whichever consumer actually needs the\n415:         // variants (`check::enum_variants`) re-derives them from the registry, one layer at a\n416:         // time, exactly as deep as the program itself ever navigates.\n417:         if boxed {\n418:             let decl_params = env.enums.get(name).map_or(0, |d| d.params.len());\n419:             let resolved_args = resolve_args(name, args, decl_params, span, env, seen, params)?;\n420:             // The placeholder above stands in for `name`'s own variant list, re-derived later\n421:             // from the registry at whatever arguments this occurrence carries. That only works\n422:             // if those arguments are the ones already being expanded: `Nest<T>` referring to\n423:             // itself as `Nest<Vec<T>>` names a second, larger instantiation the registry never\n424:             // builds, and re-deriving from it recurses one `Vec` deeper every time -- forever,\n425:             // since no two of `Nest<T>`, `Nest<Vec<T>>`, `Nest<Vec<Vec<T>>>`, ... ever coincide\n426:             // (kantord/toylang#117). Requiring an exact repeat closes that off: a self-reference\n427:             // is a cycle back to the instantiation already in progress, not a new one.\n428:             if resolved_args != seen[at].1 {\n429:                 let expected = Type::Enum {\n430:                     name: name.to_string(),\n431:                     args: seen[at].1.clone(),\n432:                     variants: Vec::new(),\n433:                 };\n434:                 return Err(Error::new(\n435:                     span,\n436:                     format!(\n437:                         \"`{name}` refers to itself with different type arguments; a \\\n438:                          self-reference must repeat `{expected}` unchanged\"\n439:                     ),\n440:                 ));\n441:             }\n442:             return Ok(Type::Enum {\n443:                 name: name.to_string(),\n444:                 args: resolved_args,\n445:                 variants: Vec::new(),\n446:             });\n447:         }\n448:         // The names expanded since this one last appeared are the cycle, and naming them\n449:         // is the difference between knowing there is one and finding it.\n450:         let through: Vec<String> = seen[at + 1..]\n451:             .iter()\n452:             .map(|(s, _)| format!(\"`{s}`\"))\n453:             .collect();\n454:         let path = if through.is_empty() {\n455:             String::new()\n456:         } else {\n457:             format!(\", through {}\", through.join(\" and \"))\n458:         };\n459:         return Err(Error::new(\n460:             span,\n461:             format!(\"type `{name}` is written in terms of itself{path}\"),\n462:         ));\n463:     }\n464:     if let Some(written) = env.aliases.get(name) {\n465:         if !args.is_empty() {\n466:             return Err(Error::new(span, format!(\"`{name}` takes no type argument\")));\n467:         }\n468:         seen.push((name.to_string(), Vec::new()));\n469:         let expanded = resolve_bound(written, env, seen, params, boxed);\n470:         seen.pop();\n471:         return expanded;\n472:     }\n473:     if let Some(decl) = env.enums.get(name) {\n474:         let resolved_args = resolve_args(name, args, decl.params.len(), span, env, seen, params)?;\n475:         return resolve_enum(decl, env, seen, Some(&resolved_args));\n476:     }\n477:     Err(Error::new(span, format!(\"unknown type `{name}`\")))\n478: }\n479: \n480: /// `resolve` with a generic enum's parameters in scope: inside `enum Opt<T>`'s payloads,\n481: /// `T` names whatever the binding holds -- the argument at an instantiation, or the\n482: /// parameter itself in the registry template. Everywhere else the binding map is empty.\n483: fn resolve_bound(\n484:     ty: &TypeExpr,\n485:     env: &TypeEnv,\n486:     seen: &mut Vec<(String, Vec<Type>)>,\n487:     params: &HashMap<&str, &Type>,\n488:     boxed: bool,\n489: ) -> Result<Type, Error> {\n490:     match ty {\n491:         TypeExpr::Named { name, args, span } => {\n492:             resolve_named(name, args, *span, env, seen, params, boxed)\n493:         }\n494:         // The containment bans hold in the grammar itself, not just at value construction\n495:         // sites: a stream is not a value, so no annotation may describe one as stored.\n496:         TypeExpr::Vec { elem, .. } => {\n497:             let inner = resolve_bound(elem, env, seen, params, true)?;\n498:             if inner.contains_stream() {\n499:                 return Err(Error::new(\n500:                     elem.span(),\n501:                     \"a Vec cannot hold a stream, which has nothing to store\".to_string(),\n502:                 ));\n503:             }\n504:             if inner.contains_sink() {\n505:                 return Err(Error::new(\n506:                     elem.span(),\n507:                     \"a Vec cannot hold a sink, which has no value to store\".to_string(),\n508:                 ));\n509:             }\n510:             Ok(Type::Vec(Box::new(inner)))\n511:         }\n512:         TypeExpr::Stream { elem, .. } => {\n513:             let inner = resolve_bound(elem, env, seen, params, boxed)?;\n514:             if inner.contains_stream() {\n515:                 return Err(Error::new(\n516:                     elem.span(),\n517:                     \"a Stream cannot hold another stream; there is nothing it could yield\"\n518:                         .to_string(),\n519:                 ));\n520:             }\n521:             if inner.contains_sink() {\n522:                 return Err(Error::new(\n523:                     elem.span(),\n524:                     \"a Stream cannot hold a sink, which has no value to yield\".to_string(),\n525:                 ));\n526:             }\n527:             Ok(Type::Stream(Box::new(inner)))\n528:         }\n529:         TypeExpr::Record { fields, span } => {\n530:             let mut out = Vec::new();\n531:             for (name, ty) in fields {\n532:                 if out.iter().any(|(n, _): &(String, Type)| n == name) {\n533:                     return Err(Error::new(\n534:                         *span,\n535:                         format!(\"field `{name}` is declared twice\"),\n536:                     ));\n537:                 }\n538:                 let field = resolve_bound(ty, env, seen, params, boxed)?;\n539:                 if field.contains_stream() {\n540:                     return Err(Error::new(\n541:                         ty.span(),\n542:                         format!(\"`{name}` cannot hold a stream, which has nothing to store\"),\n543:                     ));\n544:                 }\n545:                 if field.contains_sink() {\n546:                     return Err(Error::new(\n547:                         ty.span(),\n548:                         format!(\"`{name}` cannot hold a sink, which has no value to store\"),\n549:                     ));\n550:                 }\n551:                 out.push((name.clone(), field));\n552:             }\n553:             Ok(Type::Record(out))\n554:         }\n555:     }\n556: }\n\n(End of file - total 556 lines)\n</content>","metadata":{"preview":"//! Type resolution: turns the surface syntax of types (`TypeExpr`, `EnumDecl`) into `ty::Type`.\n//! Runs once, eagerly, before any expression is checked, and touches neither `Expr` nor `Tir`.\n\nuse std::collections::HashMap;\n\nuse crate::ast::{Alias, Def, EnumDecl, Span, TypeExpr};\nuse crate::error::Error;\nuse crate::ty::{self, Sig, Type};\n\nuse super::BUILTIN_NAMES;\n\n/// Capitalised names are types and lowercase names are values.\n///\n/// Every name in the language already followed this, unenforced. Making it a rule is what lets a\n/// constructor share a spelling with a call without sharing a namespace: `User {..}` builds and\n/// `area {..}` calls, decided by the first letter rather than by looking either one up.\n///\n/// Field names are deliberately not covered. They come from data, and JSON objects are entitled\n/// to a key spelled `Name`.\nfn value_name(name: &str, span: Span, what: &str) -> Result<(), Error> {","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-174/src/check/types.rs","text":"//! Type resolution: turns the surface syntax of types (`TypeExpr`, `EnumDecl`) into `ty::Type`.\n//! Runs once, eagerly, before any expression is checked, and touches neither `Expr` nor `Tir`.\n\nuse std::collections::HashMap;\n\nuse crate::ast::{Alias, Def, EnumDecl, Span, TypeExpr};\nuse crate::error::Error;\nuse crate::ty::{self, Sig, Type};\n\nuse super::BUILTIN_NAMES;\n\n/// Capitalised names are types and lowercase names are values.\n///\n/// Every name in the language already followed this, unenforced. Making it a rule is what lets a\n/// constructor share a spelling with a call without sharing a namespace: `User {..}` builds and\n/// `area {..}` calls, decided by the first letter rather than by looking either one up.\n///\n/// Field names are deliberately not covered. They come from data, and JSON objects are entitled\n/// to a key spelled `Name`.\nfn value_name(name: &str, span: Span, what: &str) -> Result<(), Error> {\n    if name.chars().next().is_some_and(char::is_uppercase) {\n        return Err(Error::new(\n            span,\n            format!(\"a {what} starts with a lowercase letter, and `{name}` reads as a type\"),\n        ));\n    }\n    Ok(())\n}\n\n/// The lowercase-constructor spelling of a declared variant's name: identical except the first\n/// letter, which is the matcher's capital lowered (gh:156). The casing split is first-letter\n/// only, so the rest must match exactly, not merely case-insensitively.\npub(super) fn constructor_of(declared: &str) -> String {\n    let mut chars = declared.chars();\n    match chars.next() {\n        Some(c) => c.to_lowercase().collect::<String>() + chars.as_str(),\n        None => String::new(),\n    }\n}\n\n/// The matcher spelling of a lowercase constructor: the first letter capitalized (gh:156).\npub(super) fn matcher_of(name: &str) -> String {\n    let mut chars = name.chars();\n    match chars.next() {\n        Some(c) => c.to_uppercase().collect::<String>() + chars.as_str(),\n        None => String::new(),\n    }\n}\n\n/// Whether `written` is the lowercase-constructor spelling of the declared variant `declared`.\npub(super) fn is_constructor_of(declared: &str, written: &str) -> bool {\n    let mut declared_chars = declared.chars();\n    let mut written_chars = written.chars();\n    match (declared_chars.next(), written_chars.next()) {\n        (Some(d), Some(w)) => {\n            d.is_uppercase()\n                && w == d.to_lowercase().next().unwrap_or(d)\n                && declared_chars.as_str() == written_chars.as_str()\n        }\n        _ => false,\n    }\n}\n\n/// What a type name stands for. An alias is an abbreviation, so this maps to the written form\n/// and `resolve` expands it; nothing downstream ever learns a name was involved.\ntype Aliases<'a> = HashMap<String, &'a TypeExpr>;\n\n/// The named types a written annotation can refer to. Aliases expand away; an enum resolves to\n/// the identity its declaration created.\npub(super) struct TypeEnv<'a> {\n    pub(super) aliases: Aliases<'a>,\n    pub(super) enums: HashMap<String, &'a EnumDecl>,\n}\n\npub(super) fn enum_map(enums: &[EnumDecl]) -> Result<HashMap<String, &EnumDecl>, Error> {\n    let mut map: HashMap<String, &EnumDecl> = HashMap::new();\n    for e in enums {\n        if !e.name.chars().next().is_some_and(char::is_uppercase) {\n            return Err(Error::new(\n                e.span,\n                format!(\n                    \"a type name starts with a capital letter, and `{}` reads as a value\",\n                    e.name\n                ),\n            ));\n        }\n        if ty::is_builtin_type_name(&e.name) {\n            return Err(Error::new(\n                e.span,\n                format!(\"`{}` is a built-in type and cannot be redefined\", e.name),\n            ));\n        }\n        for (i, v) in e.variants.iter().enumerate() {\n            if e.variants[..i].iter().any(|earlier| earlier.name == v.name) {\n                return Err(Error::new(\n                    v.span,\n                    format!(\"variant `{}` is declared twice in `{}`\", v.name, e.name),\n                ));\n            }\n            // The declared name is the matcher, so it starts with a capital letter; the value is\n            // built with the lowercase constructor (`Circle` declares, `circle` builds). The\n            // prelude's Opt/Result still spell their variants lowercase -- exempting pub enums\n            // keeps the build green until gh:165 migrates them, and a program's own variants are\n            // all non-pub, so the rule still bites everywhere it should.\n            if !e.is_pub && !v.name.chars().next().is_some_and(char::is_uppercase) {\n                return Err(Error::new(\n                    v.span,\n                    format!(\n                        \"a variant name starts with a capital letter; declare `{}` of `{}` as \\\n                         `{}`, and build its value with the lowercase constructor `{}`\",\n                        v.name,\n                        e.name,\n                        matcher_of(&v.name),\n                        v.name\n                    ),\n                ));\n            }\n        }\n        if map.insert(e.name.clone(), e).is_some() {\n            return Err(Error::new(\n                e.span,\n                format!(\"type `{}` is defined twice\", e.name),\n            ));\n        }\n    }\n    Ok(map)\n}\n\n/// Resolve one enum declaration to its type. `seen` carries the names being expanded and the\n/// arguments each was expanded with, exactly as for aliases (whose entry carries no arguments),\n/// so an enum whose payload mentions itself is refused rather than expanded forever -- unless it\n/// does so behind a `Vec`, which `resolve_named` treats as legal (kantord/toylang#76) and stops\n/// expanding at, rather than looping. The arguments travel alongside the name so that a boxed\n/// self-reference can be checked against the instantiation it reappears inside\n/// (kantord/toylang#117): reusing them is the only way `resolve_named` avoids expanding one\n/// forever, so a self-reference that reappears with different arguments -- `Nest<Vec<T>>` inside\n/// `Nest<T>` -- has no honest placeholder to return and is refused instead.\n///\n/// `args` instantiates a generic declaration: payloads resolve with each parameter bound to\n/// its argument, already resolved (an argument never re-enters this enum's `seen` chain, so\n/// `Opt<Opt<Int>>` is two honest levels, not a false cycle). `None` builds the registry\n/// template instead, each parameter standing for itself as `Type::Param` -- which is also the\n/// eager pass that validates a declaration nothing uses.\npub(super) fn resolve_enum(\n    decl: &EnumDecl,\n    env: &TypeEnv,\n    seen: &mut Vec<(String, Vec<Type>)>,\n    args: Option<&[Type]>,\n) -> Result<Type, Error> {\n    for (i, (p, span)) in decl.params.iter().enumerate() {\n        if !p.chars().next().is_some_and(char::is_uppercase) {\n            return Err(Error::new(\n                *span,\n                format!(\n                    \"a type parameter starts with a capital letter, and `{p}` reads as a value\"\n                ),\n            ));\n        }\n        // A parameter may shadow a declared enum or alias -- resolve_named consults the\n        // parameter bindings first, so inside the declaration the name means the parameter,\n        // unambiguously, the same scoping Rust gives struct Foo<E> beside an enum E. Refusing\n        // the collision instead broke every program declaring enum E the moment the prelude\n        // gained Result<T, E> (kantord/toylang#85). Builtins stay off limits: Vec-the-parameter\n        // would make every Vec<...> in the payload mean the wrong thing at a distance.\n        if ty::is_builtin_type_name(p) {\n            return Err(Error::new(\n                *span,\n                format!(\"type parameter `{p}` takes the name of a built-in type\"),\n            ));\n        }\n        if decl.params[..i].iter().any(|(earlier, _)| earlier == p) {\n            return Err(Error::new(\n                *span,\n                format!(\"type parameter `{p}` is declared twice in `{}`\", decl.name),\n            ));\n        }\n    }\n    let bound: Vec<Type> = match args {\n        Some(args) => args.to_vec(),\n        None => decl\n            .params\n            .iter()\n            .map(|(p, _)| Type::Param(p.clone()))\n            .collect(),\n    };\n    let params: HashMap<&str, &Type> = decl\n        .params\n        .iter()\n        .map(|(p, _)| p.as_str())\n        .zip(bound.iter())\n        .collect();\n    seen.push((decl.name.clone(), bound.clone()));\n    let mut variants = Vec::new();\n    for v in &decl.variants {\n        let payload = match &v.payload {\n            Some(ty) => {\n                // `boxed` starts false at the top of every variant: whether this one payload\n                // reaches back to `decl.name` through a `Vec` is assessed fresh each time, so\n                // `enum E { safe(Vec<E>), bad(E) }` accepts `safe` and still refuses `bad`.\n                let resolved = resolve_bound(ty, env, seen, &params, false)?;\n                // The record and Vec spellings refuse a stream inside themselves, but the\n                // parens spelling can put one directly in payload position, so the ban has to\n                // be stated here too: an enum value is storable, and a stream is not. A sink\n                // is not storable either, for the same reason.\n                if resolved.contains_stream() {\n                    return Err(Error::new(\n                        ty.span(),\n                        format!(\n                            \"the payload of `{}` cannot hold a stream, which has nothing to store\",\n                            v.name\n                        ),\n                    ));\n                }\n                if resolved.contains_sink() {\n                    return Err(Error::new(\n                        ty.span(),\n                        format!(\n                            \"the payload of `{}` cannot hold a sink, which has no value to store\",\n                            v.name\n                        ),\n                    ));\n                }\n                Some(resolved)\n            }\n            None => None,\n        };\n        variants.push((v.name.clone(), payload));\n    }\n    seen.pop();\n    Ok(Type::Enum {\n        name: decl.name.clone(),\n        args: bound,\n        variants,\n    })\n}\n\npub(super) fn alias_map(aliases: &[Alias]) -> Result<Aliases<'_>, Error> {\n    let mut map: Aliases = HashMap::new();\n    for a in aliases {\n        if !a.name.chars().next().is_some_and(char::is_uppercase) {\n            return Err(Error::new(\n                a.span,\n                format!(\n                    \"a type name starts with a capital letter, and `{}` reads as a value\",\n                    a.name\n                ),\n            ));\n        }\n        if ty::is_builtin_type_name(&a.name) {\n            return Err(Error::new(\n                a.span,\n                format!(\"`{}` is a built-in type and cannot be redefined\", a.name),\n            ));\n        }\n        if map.insert(a.name.clone(), &a.ty).is_some() {\n            return Err(Error::new(\n                a.span,\n                format!(\"type `{}` is defined twice\", a.name),\n            ));\n        }\n    }\n    Ok(map)\n}\n\npub(super) fn signatures(defs: &[Def], env: &TypeEnv) -> Result<HashMap<String, Sig>, Error> {\n    let mut sigs = HashMap::new();\n    for def in defs {\n        value_name(&def.name, def.span, \"function name\")?;\n        if let Some(param) = &def.param {\n            value_name(&param.name, param.span, \"parameter name\")?;\n        }\n        if BUILTIN_NAMES.contains(&def.name.as_str()) {\n            return Err(Error::new(\n                def.span,\n                format!(\"`{}` is a builtin and cannot be redefined\", def.name),\n            ));\n        }\n        if sigs.contains_key(&def.name) {\n            return Err(Error::new(\n                def.span,\n                format!(\"`{}` is defined twice\", def.name),\n            ));\n        }\n        let sig = Sig {\n            param: match &def.param {\n                Some(param) => Some(resolve(&param.ty, env, &mut Vec::new())?),\n                None => None,\n            },\n            ret: resolve(&def.ret, env, &mut Vec::new())?,\n        };\n        // A stream is born only at a source, so a function cannot conjure one: a stream result\n        // flows in through a stream parameter, and the pipeline stays one chain fusion can\n        // read. Refusing is the reversible direction.\n        if matches!(sig.ret, Type::Stream(_)) && !matches!(sig.param, Some(Type::Stream(_))) {\n            return Err(Error::new(\n                def.span,\n                format!(\n                    \"`{}` returns {} without taking a stream; a stream is born only at a source\",\n                    def.name, sig.ret\n                ),\n            ));\n        }\n        // A sink is not a value, so nothing can be passed one: `Sink` is legal as a return\n        // type, and nowhere else in a signature.\n        if matches!(sig.param, Some(Type::Sink)) {\n            return Err(Error::new(\n                def.span,\n                format!(\n                    \"`{}` cannot take a Sink parameter; a sink has no value to pass\",\n                    def.name\n                ),\n            ));\n        }\n        sigs.insert(def.name.clone(), sig);\n    }\n    Ok(sigs)\n}\n\n/// `seen` is the chain of names currently being expanded, each with the arguments it was\n/// expanded with -- aliases and enums share it -- so a type written in terms of itself is\n/// caught rather than expanded forever.\npub(super) fn resolve(\n    ty: &TypeExpr,\n    env: &TypeEnv,\n    seen: &mut Vec<(String, Vec<Type>)>,\n) -> Result<Type, Error> {\n    resolve_bound(ty, env, seen, &HashMap::new(), false)\n}\n\n/// The arity-checked, resolved type arguments for `name`'s `<...>`, shared between an ordinary\n/// instantiation and a self-reference caught below -- both need the same check against\n/// `decl.params.len()`, one on the way to expanding the declaration and the other on the way to\n/// a placeholder for it. An argument is a fresh type position, not a continuation of whatever\n/// `Vec` this occurrence of `name` itself sat behind, so it resolves with `boxed` reset to\n/// `false` rather than threading the caller's through.\nfn resolve_args(\n    name: &str,\n    args: &[TypeExpr],\n    decl_params: usize,\n    span: Span,\n    env: &TypeEnv,\n    seen: &mut Vec<(String, Vec<Type>)>,\n    params: &HashMap<&str, &Type>,\n) -> Result<Vec<Type>, Error> {\n    if args.len() != decl_params {\n        let wants = match decl_params {\n            0 => format!(\"`{name}` takes no type argument\"),\n            1 => format!(\"`{name}` takes one type argument\"),\n            n => format!(\"`{name}` takes {n} type arguments\"),\n        };\n        let found = match args.len() {\n            0 => String::new(),\n            n => format!(\", found {n}\"),\n        };\n        return Err(Error::new(span, format!(\"{wants}{found}\")));\n    }\n    let mut resolved_args = Vec::new();\n    for arg in args {\n        let resolved = resolve_bound(arg, env, seen, params, false)?;\n        if resolved.contains_stream() {\n            return Err(Error::new(\n                arg.span(),\n                format!(\"`{name}` cannot hold a stream, which has nothing to store\"),\n            ));\n        }\n        if resolved.contains_sink() {\n            return Err(Error::new(\n                arg.span(),\n                format!(\"`{name}` cannot hold a sink, which has no value to store\"),\n            ));\n        }\n        resolved_args.push(resolved);\n    }\n    Ok(resolved_args)\n}\n\n/// One named reference: a bound parameter, a built-in scalar, an alias, or an enum -- with\n/// the arity of its `<...>` arguments held here, where the declaration is in hand.\n///\n/// `boxed` is whether this occurrence has already passed through a `Vec` since the innermost\n/// enum currently being expanded (`seen`'s top) started -- reset at the top of each variant's\n/// payload by `resolve_enum`, set by the `Vec` arm below, and otherwise carried through\n/// unchanged, because once a value's storage is a heap indirection every field nested inside it\n/// stays indirect too.\nfn resolve_named(\n    name: &str,\n    args: &[TypeExpr],\n    span: Span,\n    env: &TypeEnv,\n    seen: &mut Vec<(String, Vec<Type>)>,\n    params: &HashMap<&str, &Type>,\n    boxed: bool,\n) -> Result<Type, Error> {\n    if let Some(bound) = params.get(name) {\n        if !args.is_empty() {\n            return Err(Error::new(\n                span,\n                format!(\"`{name}` is a type parameter and takes no type argument\"),\n            ));\n        }\n        return Ok((*bound).clone());\n    }\n    if let Some(built_in) = Type::from_name(name) {\n        if !args.is_empty() {\n            return Err(Error::new(span, format!(\"`{name}` takes no type argument\")));\n        }\n        return Ok(built_in);\n    }\n    if let Some(at) = seen.iter().position(|(s, _)| s == name) {\n        // Behind a `Vec`, a self-reference is a heap indirection rather than an infinite\n        // layout, the same reason `Vec<Json>` is an ordinary field and not a contradiction\n        // (kantord/toylang#76: Json's array case). Nothing downstream can expand `name`'s own\n        // variants without looping forever -- `name` is still on `seen` -- so this stops one\n        // layer short and returns a placeholder instead; whichever consumer actually needs the\n        // variants (`check::enum_variants`) re-derives them from the registry, one layer at a\n        // time, exactly as deep as the program itself ever navigates.\n        if boxed {\n            let decl_params = env.enums.get(name).map_or(0, |d| d.params.len());\n            let resolved_args = resolve_args(name, args, decl_params, span, env, seen, params)?;\n            // The placeholder above stands in for `name`'s own variant list, re-derived later\n            // from the registry at whatever arguments this occurrence carries. That only works\n            // if those arguments are the ones already being expanded: `Nest<T>` referring to\n            // itself as `Nest<Vec<T>>` names a second, larger instantiation the registry never\n            // builds, and re-deriving from it recurses one `Vec` deeper every time -- forever,\n            // since no two of `Nest<T>`, `Nest<Vec<T>>`, `Nest<Vec<Vec<T>>>`, ... ever coincide\n            // (kantord/toylang#117). Requiring an exact repeat closes that off: a self-reference\n            // is a cycle back to the instantiation already in progress, not a new one.\n            if resolved_args != seen[at].1 {\n                let expected = Type::Enum {\n                    name: name.to_string(),\n                    args: seen[at].1.clone(),\n                    variants: Vec::new(),\n                };\n                return Err(Error::new(\n                    span,\n                    format!(\n                        \"`{name}` refers to itself with different type arguments; a \\\n                         self-reference must repeat `{expected}` unchanged\"\n                    ),\n                ));\n            }\n            return Ok(Type::Enum {\n                name: name.to_string(),\n                args: resolved_args,\n                variants: Vec::new(),\n            });\n        }\n        // The names expanded since this one last appeared are the cycle, and naming them\n        // is the difference between knowing there is one and finding it.\n        let through: Vec<String> = seen[at + 1..]\n            .iter()\n            .map(|(s, _)| format!(\"`{s}`\"))\n            .collect();\n        let path = if through.is_empty() {\n            String::new()\n        } else {\n            format!(\", through {}\", through.join(\" and \"))\n        };\n        return Err(Error::new(\n            span,\n            format!(\"type `{name}` is written in terms of itself{path}\"),\n        ));\n    }\n    if let Some(written) = env.aliases.get(name) {\n        if !args.is_empty() {\n            return Err(Error::new(span, format!(\"`{name}` takes no type argument\")));\n        }\n        seen.push((name.to_string(), Vec::new()));\n        let expanded = resolve_bound(written, env, seen, params, boxed);\n        seen.pop();\n        return expanded;\n    }\n    if let Some(decl) = env.enums.get(name) {\n        let resolved_args = resolve_args(name, args, decl.params.len(), span, env, seen, params)?;\n        return resolve_enum(decl, env, seen, Some(&resolved_args));\n    }\n    Err(Error::new(span, format!(\"unknown type `{name}`\")))\n}\n\n/// `resolve` with a generic enum's parameters in scope: inside `enum Opt<T>`'s payloads,\n/// `T` names whatever the binding holds -- the argument at an instantiation, or the\n/// parameter itself in the registry template. Everywhere else the binding map is empty.\nfn resolve_bound(\n    ty: &TypeExpr,\n    env: &TypeEnv,\n    seen: &mut Vec<(String, Vec<Type>)>,\n    params: &HashMap<&str, &Type>,\n    boxed: bool,\n) -> Result<Type, Error> {\n    match ty {\n        TypeExpr::Named { name, args, span } => {\n            resolve_named(name, args, *span, env, seen, params, boxed)\n        }\n        // The containment bans hold in the grammar itself, not just at value construction\n        // sites: a stream is not a value, so no annotation may describe one as stored.\n        TypeExpr::Vec { elem, .. } => {\n            let inner = resolve_bound(elem, env, seen, params, true)?;\n            if inner.contains_stream() {\n                return Err(Error::new(\n                    elem.span(),\n                    \"a Vec cannot hold a stream, which has nothing to store\".to_string(),\n                ));\n            }\n            if inner.contains_sink() {\n                return Err(Error::new(\n                    elem.span(),\n                    \"a Vec cannot hold a sink, which has no value to store\".to_string(),\n                ));\n            }\n            Ok(Type::Vec(Box::new(inner)))\n        }\n        TypeExpr::Stream { elem, .. } => {\n            let inner = resolve_bound(elem, env, seen, params, boxed)?;\n            if inner.contains_stream() {\n                return Err(Error::new(\n                    elem.span(),\n                    \"a Stream cannot hold another stream; there is nothing it could yield\"\n                        .to_string(),\n                ));\n            }\n            if inner.contains_sink() {\n                return Err(Error::new(\n                    elem.span(),\n                    \"a Stream cannot hold a sink, which has no value to yield\".to_string(),\n                ));\n            }\n            Ok(Type::Stream(Box::new(inner)))\n        }\n        TypeExpr::Record { fields, span } => {\n            let mut out = Vec::new();\n            for (name, ty) in fields {\n                if out.iter().any(|(n, _): &(String, Type)| n == name) {\n                    return Err(Error::new(\n                        *span,\n                        format!(\"field `{name}` is declared twice\"),\n                    ));\n                }\n                let field = resolve_bound(ty, env, seen, params, boxed)?;\n                if field.contains_stream() {\n                    return Err(Error::new(\n                        ty.span(),\n                        format!(\"`{name}` cannot hold a stream, which has nothing to store\"),\n                    ));\n                }\n                if field.contains_sink() {\n                    return Err(Error::new(\n                        ty.span(),\n                        format!(\"`{name}` cannot hold a sink, which has no value to store\"),\n                    ));\n                }\n                out.push((name.clone(), field));\n            }\n            Ok(Type::Record(out))\n        }\n    }\n}","lineStart":1,"lineEnd":556,"totalLines":556,"truncated":false}},"title":"src/check/types.rs","time":{"start":1788379897903,"end":1788379897907}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now I have a good understanding. This is a big task. Let me look at the build.rs to understand the prelude checking at build time, and the tests structure. Also let me look at the checker's types.rs (`signatures`, `resolve`) and the tags.rs.\n\nAlso I should check the board.yaml for any relevant context about the `trait-interface-build` row and the plan. Also check the draft.md for relevant design details about method-call colon form, and what's needed.\n\nLet me read check/types.rs.","format":"unknown","index":0}]}},"id":"prt_063bfa02b001mflHFdxMSe2MkO","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","messageID":"msg_063bf95bb001YRkwaj5q1woL87"}}
