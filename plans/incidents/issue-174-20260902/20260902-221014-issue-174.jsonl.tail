{"type":"tool_use","timestamp":1788379852628,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-8bd2ad41b46f5d37","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-174/src/parse.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-174/src/parse.rs</path>\n<type>file</type>\n<content>\n1: use winnow::error::ParserError;\n2: use winnow::prelude::*;\n3: use winnow::stream::{LocatingSlice, Location, Stream};\n4: use winnow::token::take_while;\n5: \n6: use crate::ast::{\n7:     Alias, BinOp, Def, EnumDecl, Expr, FieldsPattern, File, LogicOp, MatchArm, Module, Param,\n8:     Pattern, Span, TypeExpr, Variant,\n9: };\n10: use crate::error::Error;\n11: use crate::ty;\n12: \n13: /// The stream this whole module parses over: a source string with byte-offset tracking built\n14: /// in, so every sub-parser gets `Span`s for free from `current_token_start` rather than threading\n15: /// position by hand.\n16: type Input<'i> = LocatingSlice<&'i str>;\n17: \n18: /// Lets every winnow combinator used below (`take_while`, and anything built on it) report\n19: /// failure as this crate's own `Error` directly -- there is no separate winnow error type to\n20: /// translate out of. `from_input` is winnow's fallback for a failure it synthesises itself\n21: /// rather than one this module constructs explicitly; nothing here is expected to hit it; the\n22: /// hand-written parsers below always build their own `Error` with a specific message instead.\n23: impl<'i> ParserError<Input<'i>> for Error {\n24:     type Inner = Error;\n25: \n26:     fn from_input(input: &Input<'i>) -> Error {\n27:         let at = input.current_token_start();\n28:         Error::new(Span::new(at, at), \"expected a token\".to_string())\n29:     }\n30: \n31:     fn into_inner(self) -> Result<Error, Error> {\n32:         Ok(self)\n33:     }\n34: }\n35: \n36: #[derive(Debug, Clone, PartialEq)]\n37: enum Tok {\n38:     Str(String),\n39:     Int(i64),\n40:     Float(f64),\n41:     Ident(String),\n42:     Fn,\n43:     Pub,\n44:     Type,\n45: Enum,\n46:     Let,\n47:     Input,\n48:     Inputs,\n49:     Lines,\n50:     Dsv,\n51:     Csv,\n52:     Tsv,\n53:     And,\n54:     Or,\n55:     Not,\n56:     Plus,\n57:     Minus,\n58:     Star,\n59:     Slash,\n60:     Percent,\n61:     Pipe,\n62:     PipeGt,\n63:     Comma,\n64:     Dot,\n65:     Eq,\n66:     EqEq,\n67:     Ne,\n68:     Bang,\n69:     Lt,\n70:     Le,\n71:     Gt,\n72:     Ge,\n73:     LParen,\n74:     RParen,\n75:     LBracket,\n76:     RBracket,\n77:     LBrace,\n78:     RBrace,\n79:     Colon,\n80:     Arrow,\n81:     Eof,\n82: }\n83: \n84: impl std::fmt::Display for Tok {\n85:     fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n86:         let s = match self {\n87:             Tok::Str(_) => return write!(f, \"a string\"),\n88:             Tok::Int(n) => return write!(f, \"`{n}`\"),\n89:             Tok::Float(n) => return write!(f, \"`{n}`\"),\n90:             Tok::Ident(name) => return write!(f, \"`{name}`\"),\n91:             Tok::Fn => \"`fn`\",\n92:             Tok::Pub => \"`pub`\",\n93:             Tok::Type => \"`type`\",\n94:             Tok::Enum => \"`enum`\",\n95:             Tok::Let => \"`let`\",\n96:             Tok::Input => \"`input`\",\n97:             Tok::Inputs => \"`inputs`\",\n98:             Tok::Lines => \"`lines`\",\n99:             Tok::Dsv => \"`dsv`\",\n100:             Tok::Csv => \"`csv`\",\n101:             Tok::Tsv => \"`tsv`\",\n102:             Tok::And => \"`and`\",\n103:             Tok::Or => \"`or`\",\n104:             Tok::Not => \"`not`\",\n105:             Tok::Plus => \"`+`\",\n106:             Tok::Minus => \"`-`\",\n107:             Tok::Star => \"`*`\",\n108:             Tok::Slash => \"`/`\",\n109:             Tok::Percent => \"`%`\",\n110:             Tok::Pipe => \"`|`\",\n111:             Tok::PipeGt => \"`|>`\",\n112:             Tok::Comma => \"`,`\",\n113:             Tok::Dot => \"`.`\",\n114:             Tok::Eq => \"`=`\",\n115:             Tok::EqEq => \"`==`\",\n116:             Tok::Ne => \"`!=`\",\n117:             Tok::Bang => \"`!`\",\n118:             Tok::Lt => \"`<`\",\n119:             Tok::Le => \"`<=`\",\n120:             Tok::Gt => \"`>`\",\n121:             Tok::Ge => \"`>=`\",\n122:             Tok::LParen => \"`(`\",\n123:             Tok::RParen => \"`)`\",\n124:             Tok::LBracket => \"`[`\",\n125:             Tok::RBracket => \"`]`\",\n126:             Tok::LBrace => \"`{`\",\n127:             Tok::RBrace => \"`}`\",\n128:             Tok::Colon => \"`:`\",\n129:             Tok::Arrow => \"`->`\",\n130:             Tok::Eof => \"end of program\",\n131:         };\n132:         write!(f, \"{s}\")\n133:     }\n134: }\n135: \n136: /// Zero or more ASCII spaces/tabs/newlines, then a `#`-to-newline comment if one follows,\n137: /// repeated: a run of trivia can mix any number of either in any order.\n138: fn skip_trivia(input: &mut Input) {\n139:     loop {\n140:         take_while::<_, _, Error>(0.., |c: char| c.is_ascii_whitespace())\n141:             .parse_next(input)\n142:             .expect(\"a lower bound of zero never fails\");\n143:         if input.peek_token() != Some('#') {\n144:             return;\n145:         }\n146:         input.next_token();\n147:         while !matches!(input.peek_token(), None | Some('\\n')) {\n148:             input.next_token();\n149:         }\n150:     }\n151: }\n152: \n153: /// Skips trivia, then reads exactly one token from the front of `input`. Called fresh for every\n154: /// `peek`/`peek2`/`advance` rather than once up front into a `Vec`, so a lexical error (a bad\n155: /// escape, an out-of-range integer) surfaces at the point parsing actually reaches it instead of\n156: /// always winning over a parse error earlier in the file the way a separate up-front pass would.\n157: fn read_tok<'i>(input: &mut Input<'i>) -> Result<(Tok, Span), Error> {\n158:     skip_trivia(input);\n159:     let start = input.current_token_start();\n160:     let Some(c) = input.peek_token() else {\n161:         return Ok((Tok::Eof, Span::new(start, start)));\n162:     };\n163: \n164:     let tok = match c {\n165:         '\"' => Tok::Str(read_string(input)?),\n166:         '0'..='9' => read_number(input, start)?,\n167:         c if c.is_ascii_alphabetic() || c == '_' => {\n168:             let word =\n169:                 take_while::<_, _, Error>(1.., |c: char| c.is_ascii_alphanumeric() || c == '_')\n170:                     .parse_next(input)\n171:                     .expect(\"a letter or underscore was just confirmed to follow\");\n172:             match word {\n173:                 \"fn\" => Tok::Fn,\n174:                 \"pub\" => Tok::Pub,\n175:                 \"type\" => Tok::Type,\n176:                 \"enum\" => Tok::Enum,\n177:                 \"let\" => Tok::Let,\n178:                 \"input\" => Tok::Input,\n179:                 \"inputs\" => Tok::Inputs,\n180:                 \"lines\" => Tok::Lines,\n181:                 \"dsv\" => Tok::Dsv,\n182:                 \"csv\" => Tok::Csv,\n183:                 \"tsv\" => Tok::Tsv,\n184:                 \"and\" => Tok::And,\n185:                 // Two operators sharing one spelling, told apart by position: the arm separator\n186:                 // at a chain's top level, Bool disjunction everywhere else. `Cursor::or_separates`\n187:                 // is which one is being read (kantord/toylang#96).\n188:                 \"or\" => Tok::Or,\n189:                 \"not\" => Tok::Not,\n190:                 name => Tok::Ident(name.to_string()),\n191:             }\n192:         }\n193:         // `-` is subtraction and negation now, so a digit after it is no longer a negative\n194:         // literal: `a -1` would otherwise not be `a - 1`.\n195:         '-' => read_two_char(input, '>', Tok::Minus, Tok::Arrow),\n196:         '!' => read_two_char(input, '=', Tok::Bang, Tok::Ne),\n197:         '=' | '<' | '>' => match c {\n198:             '=' => read_two_char(input, '=', Tok::Eq, Tok::EqEq),\n199:             '<' => read_two_char(input, '=', Tok::Lt, Tok::Le),\n200:             _ => read_two_char(input, '=', Tok::Gt, Tok::Ge),\n201:         },\n202:         '+' => single(input, Tok::Plus),\n203:         '*' => single(input, Tok::Star),\n204:         // `//` is not a token anymore: match arms compose with `or` now, so a second slash is\n205:         // just a `/` where no expression can start, which is the parse error migration needs.\n206:         '/' => single(input, Tok::Slash),\n207:         '%' => single(input, Tok::Percent),\n208:         '|' => read_two_char(input, '>', Tok::Pipe, Tok::PipeGt),\n209:         ',' => single(input, Tok::Comma),\n210:         '.' => single(input, Tok::Dot),\n211:         '(' => single(input, Tok::LParen),\n212:         ')' => single(input, Tok::RParen),\n213:         '[' => single(input, Tok::LBracket),\n214:         ']' => single(input, Tok::RBracket),\n215:         '{' => single(input, Tok::LBrace),\n216:         '}' => single(input, Tok::RBrace),\n217:         ':' => single(input, Tok::Colon),\n218:         other => {\n219:             return Err(Error::new(\n220:                 Span::new(start, start + 1),\n221:                 format!(\"unexpected character `{other}`\"),\n222:             ));\n223:         }\n224:     };\n225:     Ok((tok, Span::new(start, input.current_token_start())))\n226: }\n227: \n228: /// A number literal: the integer digits that opened it, then an optional `.digits` fraction\n229: /// and an optional `e`-exponent. Either makes it a Float (ADR 0007); without both it stays the\n230: /// Int it always was. A `.` or `e` only joins the literal when what follows makes a number, so\n231: /// `1.5` and `1e3` are one token while `1.`, `1.x`, and `1e` keep the dot or letter for the\n232: /// parser.\n233: fn read_number<'i>(input: &mut Input<'i>, start: usize) -> Result<Tok, Error> {\n234:     let digits = take_while::<_, _, Error>(1.., |c: char| c.is_ascii_digit())\n235:         .parse_next(input)\n236:         .expect(\"a digit was just confirmed to follow\");\n237:     let mut text = digits.to_string();\n238:     let mut is_float = false;\n239: \n240:     if let Some(frac) = read_fraction(input) {\n241:         text.push('.');\n242:         text.push_str(&frac);\n243:         is_float = true;\n244:     }\n245:     if let Some(exp) = read_exponent(input) {\n246:         text.push('e');\n247:         text.push_str(&exp);\n248:         is_float = true;\n249:     }\n250: \n251:     let end = input.current_token_start();\n252:     if is_float {\n253:         let value = text.parse::<f64>().map_err(|_| {\n254:             Error::new(\n255:                 Span::new(start, end),\n256:                 format!(\"float `{text}` is out of range\"),\n257:             )\n258:         })?;\n259:         Ok(Tok::Float(value))\n260:     } else {\n261:         let n = digits.parse::<i64>().map_err(|_| {\n262:             Error::new(\n263:                 Span::new(start, end),\n264:                 format!(\"integer `{digits}` is out of range\"),\n265:             )\n266:         })?;\n267:         Ok(Tok::Int(n))\n268:     }\n269: }\n270: \n271: /// The `.digits` fraction of a number literal, `None` when the dot is not followed by a digit\n272: /// so it is left for the parser (`1.` and `1.x` are not floats).\n273: fn read_fraction<'i>(input: &mut Input<'i>) -> Option<String> {\n274:     if input.peek_token() != Some('.') {\n275:         return None;\n276:     }\n277:     let cp = input.checkpoint();\n278:     input.next_token();\n279:     if matches!(input.peek_token(), Some(c) if c.is_ascii_digit()) {\n280:         let frac = take_while::<_, _, Error>(1.., |c: char| c.is_ascii_digit())\n281:             .parse_next(input)\n282:             .expect(\"a digit was just confirmed to follow\");\n283:         Some(frac.to_string())\n284:     } else {\n285:         input.reset(&cp);\n286:         None\n287:     }\n288: }\n289: \n290: /// The `e`-exponent of a number literal, `None` when the exponent has no digits after it so\n291: /// the `e` is left for the parser (a bare trailing `e` is not a float).\n292: fn read_exponent<'i>(input: &mut Input<'i>) -> Option<String> {\n293:     if !matches!(input.peek_token(), Some('e') | Some('E')) {\n294:         return None;\n295:     }\n296:     let cp = input.checkpoint();\n297:     input.next_token();\n298:     let mut exp = String::new();\n299:     if matches!(input.peek_token(), Some('+') | Some('-')) {\n300:         exp.push(input.next_token().expect(\"a sign was just seen\"));\n301:     }\n302:     if matches!(input.peek_token(), Some(c) if c.is_ascii_digit()) {\n303:         let exd = take_while::<_, _, Error>(1.., |c: char| c.is_ascii_digit())\n304:             .parse_next(input)\n305:             .expect(\"a digit was just confirmed to follow\");\n306:         exp.push_str(exd);\n307:         Some(exp)\n308:     } else {\n309:         input.reset(&cp);\n310:         None\n311:     }\n312: }\n313: \n314: fn single(input: &mut Input, tok: Tok) -> Tok {\n315:     input.next_token();\n316:     tok\n317: }\n318: \n319: /// `-`, `!`, `=`, `<`, `>`, `|` all may start a two-character token: if the char after the\n320: /// first is `second`, the compound token stands; otherwise the bare operator does. `single` is\n321: /// for tokens that have no compound form at all.\n322: fn read_two_char(input: &mut Input, second: char, bare: Tok, compound: Tok) -> Tok {\n323:     input.next_token();\n324:     if input.peek_token() == Some(second) {\n325:         input.next_token();\n326:         compound\n327:     } else {\n328:         bare\n329:     }\n330: }\n331: \n332: /// Returns the unescaped contents of a string literal, having consumed through the closing\n333: /// quote. `input` is positioned on the opening `\"` on entry.\n334: fn read_string(input: &mut Input) -> Result<String, Error> {\n335:     let open = input.current_token_start();\n336:     input.next_token();\n337:     let mut text = String::new();\n338:     loop {\n339:         let pos = input.current_token_start();\n340:         match input.peek_token() {\n341:             None => return Err(Error::new(Span::new(open, pos), \"unterminated string\")),\n342:             Some('\"') => {\n343:                 input.next_token();\n344:                 return Ok(text);\n345:             }\n346:             // Escapes are JSON's set minus \\u, which waits for a real value model.\n347:             Some('\\\\') => {\n348:                 let backslash = pos;\n349:                 input.next_token();\n350:                 let Some(esc) = input.peek_token() else {\n351:                     return Err(Error::new(\n352:                         Span::new(backslash, backslash + 1),\n353:                         \"unterminated escape sequence\",\n354:                     ));\n355:                 };\n356:                 text.push(match esc {\n357:                     '\"' => '\"',\n358:                     '\\\\' => '\\\\',\n359:                     '/' => '/',\n360:                     'n' => '\\n',\n361:                     't' => '\\t',\n362:                     'r' => '\\r',\n363:                     other => {\n364:                         return Err(Error::new(\n365:                             Span::new(backslash, backslash + 2),\n366:                             format!(\"unknown escape sequence `\\\\{other}`\"),\n367:                         ));\n368:                     }\n369:                 });\n370:                 input.next_token();\n371:             }\n372:             Some(c) => {\n373:                 text.push(c);\n374:                 input.next_token();\n375:             }\n376:         }\n377:     }\n378: }\n379: \n380: /// Which node an infix token builds. `and` and `or` are `ast::LogicOp`, not `BinOp`, so the\n381: /// table has to name the kind as well as the binding power.\n382: enum Infix {\n383:     Bin(BinOp),\n384:     Logic(LogicOp),\n385: }\n386: \n387: /// Left and right binding power. Left below right makes the operator left-associative.\n388: ///\n389: /// `|` sits below comparison so that `a | select(. >= 2)` splits at the pipe, which is the\n390: /// ordering jq uses and the reason this table exists rather than a nest of functions.\n391: fn infix_power(tok: &Tok) -> Option<(Infix, u8, u8)> {\n392:     let (op, left, right) = match tok {\n393:         Tok::Or => (Infix::Logic(LogicOp::Or), OR_LEFT, OR_RIGHT),\n394:         Tok::And => (Infix::Logic(LogicOp::And), 6, 7),\n395:         Tok::EqEq => (Infix::Bin(BinOp::Eq), 8, 9),\n396:         Tok::Ne => (Infix::Bin(BinOp::Ne), 8, 9),\n397:         Tok::Lt => (Infix::Bin(BinOp::Lt), 8, 9),\n398:         Tok::Le => (Infix::Bin(BinOp::Le), 8, 9),\n399:         Tok::Gt => (Infix::Bin(BinOp::Gt), 8, 9),\n400:         Tok::Ge => (Infix::Bin(BinOp::Ge), 8, 9),\n401:         Tok::Plus => (Infix::Bin(BinOp::Add), 10, 11),\n402:         Tok::Minus => (Infix::Bin(BinOp::Sub), 10, 11),\n403:         Tok::Star => (Infix::Bin(BinOp::Mul), 12, 13),\n404:         Tok::Slash => (Infix::Bin(BinOp::Div), 12, 13),\n405:         Tok::Percent => (Infix::Bin(BinOp::Rem), 12, 13),\n406:         _ => return None,\n407:     };\n408:     Some((op, left, right))\n409: }\n410: \n411: const PIPE_LEFT: u8 = 1;\n412: const PIPE_RIGHT: u8 = 2;\n413: \n414: /// Where a match arm's body and its guard operand are read and printed: between `|` (1/2) and\n415: /// the Bool connectives (`or` at 4/5). An arm body read here stops at the separator `or` and\n416: /// `->`, which is what lets a chain be one pipe stage; a guard operand read here still gets the\n417: /// Bool `or` above it, so `a == 1 or b == 2 -> x` is one two-clause guard.\n418: const COND_POWER: u8 = 3;\n419: \n420: /// Bool `or`, the loosest operator a Bool expression is built from: `a == 1 or b == 2` is one\n421: /// disjunction of two comparisons. Its *other* reading, the match-arm separator, has no power\n422: /// at all -- it is not an operator there but the chain's own punctuation, and it binds looser\n423: /// than everything, which is exactly why it cannot be one table entry with this (draft.md, the\n424: /// match-arms decision).\n425: const OR_LEFT: u8 = 4;\n426: const OR_RIGHT: u8 = 5;\n427: \n428: /// `not` sits directly below comparison, so `not a == b` negates the comparison rather than\n429: /// `a`, and above `and`, so `not a and b` negates only `a`. Python's ordering; the alternative,\n430: /// binding it as tight as unary `-`, makes every use of it against a comparison need parens.\n431: const NOT_POWER: u8 = 8;\n432: \n433: pub fn parse(src: &str) -> Result<File, Error> {\n434:     let mut p = Cursor {\n435:         input: LocatingSlice::new(src),\n436:         src,\n437:         declined_cross_line: None,\n438:         or_separates: false,\n439:     };\n440: \n441:     // Declarations in any order and any mix, since no kind can refer to another's position:\n442:     // aliases and enums are resolved before any signature is read.\n443:     let mut defs = Vec::new();\n444:     let mut aliases = Vec::new();\n445:     let mut enums = Vec::new();\n446:     loop {\n447:         let (tok, _) = p.peek()?;\n448:         match tok {\n449:             Tok::Pub => {\n450:                 p.advance()?;\n451:                 match p.peek()?.0 {\n452:                     Tok::Enum => enums.push(p.enum_decl(true)?),\n453:                     _ => defs.push(p.def(true)?),\n454:                 }\n455:             }\n456:             Tok::Fn => defs.push(p.def(false)?),\n457:             Tok::Type => aliases.push(p.alias()?),\n458:             Tok::Enum => enums.push(p.enum_decl(false)?),\n459:             _ => break,\n460:         }\n461:     }\n462: \n463:     // `input <type>` declares what stdin holds before the body reads it. It is the one\n464:     // declaration that sits after the defs rather than among them, so it is read here, and it is\n465:     // recognized by the same-line rule a call argument follows: only when the type opens on\n466:     // `input`'s own line does the keyword start an annotation, so a body that merely uses\n467:     // `input` is never mistaken for one.\n468:     let input = match p.peek()? {\n469:         (Tok::Input, input_span) => {\n470:             let (next, next_span) = p.peek2()?;\n471:             if (next == Tok::LBrace || matches!(next, Tok::Ident(_)))\n472:                 && p.same_line(input_span.end, next_span.start)\n473:             {\n474:                 p.advance()?;\n475:                 Some(p.type_expr()?)\n476:             } else {\n477:                 None\n478:             }\n479:         }\n480:         _ => None,\n481:     };\n482: \n483:     let body = p.tail_pipe()?;\n484:     let (rest, rest_span) = p.peek()?;\n485:     if rest != Tok::Eof {\n486:         return Err(p.unexpected(rest_span, format!(\"expected end of program, found {rest}\")));\n487:     }\n488:     Ok(File {\n489:         aliases,\n490:         enums,\n491:         defs,\n492:         input,\n493:         body,\n494:     })\n495: }\n496: \n497: /// A module is declarations only, with no trailing expression -- there is nothing here to run,\n498: /// only names for a program to import. `pub` marks which ones a program actually receives.\n499: pub fn parse_module(src: &str) -> Result<Module, Error> {\n500:     let mut p = Cursor {\n501:         input: LocatingSlice::new(src),\n502:         src,\n503:         declined_cross_line: None,\n504:         or_separates: false,\n505:     };\n506:     let mut defs = Vec::new();\n507:     let mut enums = Vec::new();\n508:     loop {\n509:         let (tok, span) = p.peek()?;\n510:         match tok {\n511:             Tok::Pub => {\n512:                 p.advance()?;\n513:                 match p.peek()?.0 {\n514:                     Tok::Enum => enums.push(p.enum_decl(true)?),\n515:                     _ => defs.push(p.def(true)?),\n516:                 }\n517:             }\n518:             Tok::Fn => defs.push(p.def(false)?),\n519:             Tok::Enum => enums.push(p.enum_decl(false)?),\n520:             Tok::Eof => break,\n521:             other => {\n522:                 return Err(Error::new(\n523:                     span,\n524:                     format!(\"expected `fn` or end of module, found {other}\"),\n525:                 ));\n526:             }\n527:         }\n528:     }\n529:     Ok(Module { defs, enums })\n530: }\n531: \n532: struct Cursor<'i> {\n533:     input: Input<'i>,\n534:     /// The full source, kept alongside the advancing `input` so the same-line rule can look at\n535:     /// the trivia between two tokens it already has spans for.\n536:     src: &'i str,\n537:     /// Where a call was declined because its argument started on a later line: the argument\n538:     /// token's start, and the callee's name. Declining is usually right -- a definition's body\n539:     /// and the program's body sit adjacent with nothing between them, and the line break is what\n540:     /// keeps one from swallowing the other -- but when the parse then fails at exactly the\n541:     /// declined token, the intended reading was probably the call, and the error can name the\n542:     /// parens spelling that works across lines.\n543:     declined_cross_line: Option<(usize, String)>,\n544:     /// Which of `or`'s two readings is in force here: the match-arm separator (true), or Bool\n545:     /// disjunction (false). True only inside an arm's body, where the separator has to win so\n546:     /// that `a -> b or c` is two arms; every fresh expression position below that -- a\n547:     /// parenthesized group, a call argument, an arm's own guard -- puts it back to false, since\n548:     /// nothing there is a chain's top level. This is the split kantord/toylang#96 set out to\n549:     /// prove clean, and the one place a token's meaning depends on where it is read.\n550:     or_separates: bool,\n551: }\n552: \n553: impl<'i> Cursor<'i> {\n554:     /// Reads the next token without consuming it. `Input` is `Copy` (a source `&str` plus an\n555:     /// offset), so looking ahead is just tokenizing a throwaway copy of the cursor.\n556:     fn peek(&self) -> Result<(Tok, Span), Error> {\n557:         let mut probe = self.input;\n558:         read_tok(&mut probe)\n559:     }\n560: \n561:     /// Reads the token after the next one without consuming either. One probe over `input`,\n562:     /// then a second over the probe, so the cursor never moves.\n563:     fn peek2(&self) -> Result<(Tok, Span), Error> {\n564:         let mut probe = self.input;\n565:         read_tok(&mut probe)?;\n566:         read_tok(&mut probe)\n567:     }\n568: \n569:     fn advance(&mut self) -> Result<(Tok, Span), Error> {\n570:         read_tok(&mut self.input)\n571:     }\n572: \n573:     fn eat(&mut self, want: Tok) -> Result<Span, Error> {\n574:         let (tok, span) = self.peek()?;\n575:         if tok != want {\n576:             return Err(self.unexpected(span, format!(\"expected {want}, found {tok}\")));\n577:         }\n578:         self.advance()?;\n579:         Ok(span)\n580:     }\n581: \n582:     /// An \"unexpected token\" error, extended with the parens spelling when the failing token is\n583:     /// one a call declined to take as a cross-line argument (see `declined_cross_line`): the\n584:     /// token had somewhere to go, and only the line break kept it from going there.\n585:     fn unexpected(&self, span: Span, msg: String) -> Error {\n586:         if let Some((at, callee)) = &self.declined_cross_line\n587:             && *at == span.start\n588:         {\n589:             return Error::new(\n590:                 span,\n591:                 format!(\n592:                     \"{msg}; an argument must start on the same line as its function -- \\\n593:                      write `{callee}(...)` to call across lines\"\n594:                 ),\n595:             );\n596:         }\n597:         Error::new(span, msg)\n598:     }\n599: \n600:     /// Whether nothing but spaces and tabs sits between two byte offsets. The same-line rule for\n601:     /// call arguments: an argument, bare or parenthesized, must start on the same line as its\n602:     /// function, which is what lets a definition's body end next to the program's body without\n603:     /// either reaching across the line break and swallowing the other.\n604:     fn same_line(&self, from: usize, to: usize) -> bool {\n605:         !self.src[from..to].contains('\\n')\n606:     }\n607: \n608:     /// The same-line rule applied at one call site: true when the argument starting at\n609:     /// `arg_span` is on `callee_span`'s line. A cross-line decline is recorded (see\n610:     /// `declined_cross_line`) so that if the parse then fails at that token, the error can say\n611:     /// why the call was not taken.\n612:     fn takes_argument(&mut self, callee: &str, callee_span: Span, arg_span: Span) -> bool {\n613:         if self.same_line(callee_span.end, arg_span.start) {\n614:             return true;\n615:         }\n616:         self.declined_cross_line = Some((arg_span.start, callee.to_string()));\n617:         false\n618:     }\n619: \n620:     /// Runs `f` with `or` reading as `separates` says, restoring the caller's reading after.\n621:     fn with_or<T>(\n622:         &mut self,\n623:         separates: bool,\n624:         f: impl FnOnce(&mut Self) -> Result<T, Error>,\n625:     ) -> Result<T, Error> {\n626:         let outer = std::mem::replace(&mut self.or_separates, separates);\n627:         let out = f(self);\n628:         self.or_separates = outer;\n629:         out\n630:     }\n631: \n632:     fn eat_ident(&mut self, what: &str) -> Result<(String, Span), Error> {\n633:         match self.advance()? {\n634:             (Tok::Ident(n), span) => Ok((n, span)),\n635:             (other, span) => Err(Error::new(span, format!(\"expected {what}, found {other}\"))),\n636:         }\n637:     }\n638: \n639:     /// `fn name(param: Type) -> Type = body` or `fn name() -> Type = body`.\n640:     ///\n641:     /// Both annotations are required by the grammar rather than by the checker, which is what\n642:     /// makes the message point at the missing annotation instead of at an inference failure.\n643:     fn def(&mut self, is_pub: bool) -> Result<Def, Error> {\n644:         let start = self.eat(Tok::Fn)?;\n645:         let (name, _) = self.eat_ident(\"a name\")?;\n646:         self.eat(Tok::LParen)?;\n647: \n648:         let (next, _) = self.peek()?;\n649:         let param = if next == Tok::RParen {\n650:             None\n651:         } else {\n652:             let (param_name, param_span) = self.eat_ident(\"a name\")?;\n653:             let (colon, _) = self.peek()?;\n654:             if colon != Tok::Colon {\n655:                 return Err(Error::new(\n656:                     param_span,\n657:                     format!(\"parameter `{param_name}` needs a type annotation\"),\n658:                 ));\n659:             }\n660:             self.advance()?;\n661:             let param_ty = self.type_expr()?;\n662:             Some(Param {\n663:                 span: param_span.to(param_ty.span()),\n664:                 name: param_name,\n665:                 ty: param_ty,\n666:             })\n667:         };\n668: \n669:         let close = self.eat(Tok::RParen)?;\n670:         let (arrow, _) = self.peek()?;\n671:         if arrow != Tok::Arrow {\n672:             return Err(Error::new(\n673:                 close,\n674:                 format!(\"function `{name}` needs a return type\"),\n675:             ));\n676:         }\n677:         self.advance()?;\n678:         let ret = self.type_expr()?;\n679: \n680:         self.eat(Tok::Eq)?;\n681:         let body = self.def_body()?;\n682:         Ok(Def {\n683:             span: start.to(body.span()),\n684:             name,\n685:             param,\n686:             ret,\n687:             body,\n688:             is_pub,\n689:             origin: crate::ast::Origin::Program,\n690:         })\n691:     }\n692: \n693:     /// A function's body. An ordinary expression, or -- when the `let` keyword opens it -- the\n694:     /// local-binding block the ruling on #87 settled on: `let <name> = <expr>` one per line,\n695:     /// then the expression that ends the block, with no `in` keyword. The line that is not a\n696:     /// `let` is the value, so each binding's value has to fit on its own line or the next line\n697:     /// cannot be told apart from the block's result.\n698:     fn def_body(&mut self) -> Result<Expr, Error> {\n699:         let (first, _) = self.peek()?;\n700:         if first != Tok::Let {\n701:             return self.tail_pipe();\n702:         }\n703:         let first_let = self.advance()?.1;\n704:         let mut bindings = Vec::new();\n705:         let mut binding_start = first_let.start;\n706: \n707:         loop {\n708:             let (name, _) = self.eat_ident(\"a binding name\")?;\n709:             self.eat(Tok::Eq)?;\n710:             let value = self.expr(0)?;\n711:             if !self.same_line(binding_start, value.span().end) {\n712:                 return Err(Error::new(\n713:                     value.span(),\n714:                     \"a `let` binding must fit on its line; write the whole `let <name> = <expr>` \\\n715:                      on one line and let the next line be another `let` or the block's value\"\n716:                         .to_string(),\n717:                 ));\n718:             }\n719:             bindings.push((name, value));\n720:             if self.peek()?.0 == Tok::Let {\n721:                 binding_start = self.advance()?.1.start;\n722: \n723:                 continue;\n724:             }\n725:             break;\n726:         }\n727:         let body = self.expr(0)?;\n728:         let span = first_let.to(body.span());\n729:         Ok(Expr::Let {\n730:             bindings,\n731:             body: Box::new(body),\n732:             span,\n733:         })\n734:     }\n735: \n736:     /// `Str`, `Int`, `Bool`, `Vec<T>`, `Stream<T>`, or any declared name -- with\n737:     /// `<...>` arguments when the name is a generic enum's. The parser accepts arguments on\n738:     /// every name and lets resolution hold the arity, so `Pair` and `Str<Int>` fail with an\n739:     /// error that knows what `Pair` and `Str` are rather than a parse error that does not.\n740:     fn type_expr(&mut self) -> Result<TypeExpr, Error> {\n741:         let (tok, span) = self.advance()?;\n742:         if tok == Tok::LBrace {\n743:             return self.record_type(span);\n744:         }\n745:         let name = match tok {\n746:             Tok::Ident(n) => n,\n747:             other => return Err(Error::new(span, format!(\"expected a type, found {other}\"))),\n748:         };\n749:         if self.peek()?.0 != Tok::Lt {\n750:             return Ok(TypeExpr::Named {\n751:                 name,\n752:                 args: Vec::new(),\n753:                 span,\n754:             });\n755:         }\n756:         self.advance()?;\n757:         let mut args = Vec::new();\n758:         loop {\n759:             args.push(self.type_expr()?);\n760:             let (sep, _) = self.peek()?;\n761:             if sep != Tok::Comma {\n762:                 break;\n763:             }\n764:             self.advance()?;\n765:         }\n766:         let close = self.eat(Tok::Gt)?;\n767:         let span = span.to(close);\n768:         // The two built-in constructors keep their own nodes; their arity is the grammar's.\n769:         if ty::takes_type_arg(&name) {\n770:             if args.len() != 1 {\n771:                 return Err(Error::new(\n772:                     span,\n773:                     format!(\"`{name}` takes one type argument, found {}\", args.len()),\n774:                 ));\n775:             }\n776:             let elem = Box::new(args.remove(0));\n777:             return Ok(match name.as_str() {\n778:                 \"Vec\" => TypeExpr::Vec { elem, span },\n779:                 _ => TypeExpr::Stream { elem, span },\n780:             });\n781:         }\n782:         Ok(TypeExpr::Named { name, args, span })\n783:     }\n784: \n785:     /// A call's argument when it opens with `(` or `{`: a parenthesized expression, or a record\n786:     /// literal standing bare because `{` cannot start any other expression. The closing token\n787:     /// marks the argument's end unambiguously, which is what makes the parens form the\n788:     /// disambiguator wherever the bare form's own stopping rules would read a program\n789:     /// differently.\n790:     fn argument(&mut self) -> Result<(Expr, Span), Error> {\n791:         let (tok, span) = self.peek()?;\n792:         if tok == Tok::LBrace {\n793:             self.advance()?;\n794:             let lit = self.record_lit(span)?;\n795:             let lit_span = lit.span();\n796:             return Ok((lit, lit_span));\n797:         }\n798:         self.eat(Tok::LParen)?;\n799:         let inner = self.expr(0)?;\n800:         let close = self.eat(Tok::RParen)?;\n801:         Ok((inner, close))\n802:     }\n803: \n804:     /// `{name: expr, age: expr}`, the value form of the brace that `record_type` reads in type\n805:     /// position.\n806:     fn record_lit(&mut self, open: Span) -> Result<Expr, Error> {\n807:         let mut fields = Vec::new();\n808:         let (first, _) = self.peek()?;\n809:         if first != Tok::RBrace {\n810:             loop {\n811:                 let (name, name_span) = self.eat_ident(\"a field name\")?;\n812:                 self.eat(Tok::Colon)?;\n813:                 fields.push((name, name_span, self.expr(0)?));\n814:                 let (sep, _) = self.peek()?;\n815:                 if sep != Tok::Comma {\n816:                     break;\n817:                 }\n818:                 self.advance()?;\n819:             }\n820:         }\n821:         let close = self.eat(Tok::RBrace)?;\n822:         Ok(Expr::RecordLit {\n823:             fields,\n824:             span: open.to(close),\n825:         })\n826:     }\n827: \n828:     /// `enum Shape { point, circle{r: Int}, celsius(Int) }`, optionally with type\n829:     /// parameters: `enum Opt<T> { some(T), none }`.\n830:     ///\n831:     /// A variant is a name, optionally followed by its payload type. The payload rule is any\n832:     /// single type, spelled the way a call spells its argument: a record type directly in\n833:     /// braces, or any type in parens.\n834:     fn enum_decl(&mut self, is_pub: bool) -> Result<EnumDecl, Error> {\n835:         let start = self.eat(Tok::Enum)?;\n836:         let (name, _) = self.eat_ident(\"an enum name\")?;\n837:         let mut params = Vec::new();\n838:         if self.peek()?.0 == Tok::Lt {\n839:             self.advance()?;\n840:             loop {\n841:                 params.push(self.eat_ident(\"a type parameter\")?);\n842:                 let (sep, _) = self.peek()?;\n843:                 if sep != Tok::Comma {\n844:                     break;\n845:                 }\n846:                 self.advance()?;\n847:             }\n848:             self.eat(Tok::Gt)?;\n849:         }\n850:         self.eat(Tok::LBrace)?;\n851:         let mut variants = Vec::new();\n852:         let (first, _) = self.peek()?;\n853:         if first != Tok::RBrace {\n854:             loop {\n855:                 let (vname, vspan) = self.eat_ident(\"a variant name\")?;\n856:                 let payload = match self.peek()? {\n857:                     (Tok::LBrace, open) => {\n858:                         self.advance()?;\n859:                         Some(self.record_type(open)?)\n860:                     }\n861:                     (Tok::LParen, _) => {\n862:                         self.advance()?;\n863:                         let ty = self.type_expr()?;\n864:                         self.eat(Tok::RParen)?;\n865:                         Some(ty)\n866:                     }\n867:                     _ => None,\n868:                 };\n869:                 variants.push(Variant {\n870:                     name: vname,\n871:                     span: vspan,\n872:                     payload,\n873:                 });\n874:                 let (sep, _) = self.peek()?;\n875:                 if sep != Tok::Comma {\n876:                     break;\n877:                 }\n878:                 self.advance()?;\n879:             }\n880:         }\n881:         let close = self.eat(Tok::RBrace)?;\n882:         Ok(EnumDecl {\n883:             name,\n884:             params,\n885:             variants,\n886:             span: start.to(close),\n887:             is_pub,\n888:         })\n889:     }\n890: \n891:     /// `type Db = {users: Vec<User>}`\n892:     fn alias(&mut self) -> Result<Alias, Error> {\n893:         let start = self.eat(Tok::Type)?;\n894:         let (name, _) = self.eat_ident(\"a type name\")?;\n895:         self.eat(Tok::Eq)?;\n896:         let ty = self.type_expr()?;\n897:         let span = start.to(ty.span());\n898:         Ok(Alias { name, ty, span })\n899:     }\n900: \n901:     fn record_type(&mut self, open: Span) -> Result<TypeExpr, Error> {\n902:         let mut fields = Vec::new();\n903:         let (first, _) = self.peek()?;\n904:         if first != Tok::RBrace {\n905:             loop {\n906:                 let (fname, _) = self.eat_ident(\"a field name\")?;\n907:                 self.eat(Tok::Colon)?;\n908:                 fields.push((fname, self.type_expr()?));\n909:                 let (sep, _) = self.peek()?;\n910:                 if sep != Tok::Comma {\n911:                     break;\n912:                 }\n913:                 self.advance()?;\n914:             }\n915:         }\n916:         let close = self.eat(Tok::RBrace)?;\n917:         Ok(TypeExpr::Record {\n918:             fields,\n919:             span: open.to(close),\n920:         })\n921:     }\n922: \n923:     /// Whether the tokens ahead begin a match arm: `name ->`, `name{a, b} ->`, or `any() ->`.\n924:     /// The one place this has to look carefully is a brace: a record *pattern* holds bare names\n925:     /// (and `..`), so the first `:` proves the braces are a constructor's record literal\n926:     /// argument instead. A lexical error while probing is not an arm; the ordinary path will\n927:     /// surface it.\n928:     fn arm_starts_here(&self) -> bool {\n929:         let mut probe = self.input;\n930:         let mut next = || read_tok(&mut probe).map(|(t, _)| t);\n931:         let Ok(Tok::Ident(name)) = next() else {\n932:             return false;\n933:         };\n934:         match next() {\n935:             Ok(Tok::Arrow) => true,\n936:             Ok(Tok::LParen) if name == \"any\" => {\n937:                 matches!(next(), Ok(Tok::RParen)) && matches!(next(), Ok(Tok::Arrow))\n938:             }\n939:             Ok(Tok::LBrace) => {\n940:                 loop {\n941:                     match next() {\n942:                         Ok(Tok::Ident(_) | Tok::Comma | Tok::Dot) => continue,\n943:                         Ok(Tok::RBrace) => break,\n944:                         _ => return false,\n945:                     }\n946:                 }\n947:                 matches!(next(), Ok(Tok::Arrow))\n948:             }\n949:             _ => false,\n950:         }\n951:     }\n952: \n953:     /// `left -> body or left -> body or ...`, first match wins; `or` is the one arm composer.\n954:     /// A left side is a variant pattern (`circle{r}`), `any()`, or a Bool guard expression; the\n955:     /// chain's final element may instead be a bare expression, the default. The chain reads `.`\n956:     /// as its subject, so it usually sits to the right of a `|`; each body stops at `|` and\n957:     /// `or`, which is what lets the chain be one pipe stage.\n958:     ///\n959:     /// The two `or`s meet here and nowhere else. A body is read with the separator reading, so\n960:     /// it ends at the next `or`; an element's own left side is read with the disjunction one, so\n961:     /// `a -> 1 or b == 2 or c == 3 -> 4` is two arms whose second has a two-clause guard. What\n962:     /// makes that split decidable is that an element ending at a bare `or` could only ever have\n963:     /// been a bare default in a non-final position, which was already an error.\n964:     ///\n965:     /// `lead` is an expression `expr` had already read when the `->` after it revealed a chain;\n966:     /// the first element continues from it instead of parsing fresh.\n967:     fn match_expr(&mut self, lead: Option<Expr>) -> Result<Expr, Error> {\n968:         let mut arms = Vec::new();\n969:         let mut lead = lead;\n970:         loop {\n971:             let arm = match lead.take() {\n972:                 Some(e) => self.guard_or_default_arm(e)?,\n973:                 None if self.arm_starts_here() => {\n974:                     let pattern = self.pattern()?;\n975:                     self.eat(Tok::Arrow)?;\n976:                     let body = self.arm_body()?;\n977:                     let span = pattern.span().to(body.span());\n978:                     MatchArm {\n979:                         pattern,\n980:                         body,\n981:                         span,\n982:                     }\n983:                 }\n984:                 None => {\n985:                     let e = self.with_or(false, |p| p.operand(COND_POWER))?;\n986:                     self.guard_or_default_arm(e)?\n987:                 }\n988:             };\n989:             arms.push(arm);\n990:             let (sep, _) = self.peek()?;\n991:             if sep != Tok::Or {\n992:                 break;\n993:             }\n994:             self.advance()?;\n995:         }\n996:         let span = arms[0].span.to(arms[arms.len() - 1].span);\n997:         Ok(Expr::Match { arms, span })\n998:     }\n999: \n1000:     /// An arm's right side: the one position where a bare `or` is the chain's separator rather\n1001:     /// than disjunction, so a Bool `or` written here needs parens (draft.md, the match-arms\n1002:     /// decision).\n1003:     fn arm_body(&mut self) -> Result<Expr, Error> {\n1004:         self.with_or(true, |p| p.expr(COND_POWER))\n1005:     }\n1006: \n1007:     /// The element `left` opens: `left -> body` makes `left` a guard, and a bare `left` is the\n1008:     /// default, desugared to a `Default` arm whose body is `left` itself.\n1009:     fn guard_or_default_arm(&mut self, left: Expr) -> Result<MatchArm, Error> {\n1010:         if self.peek()?.0 == Tok::Arrow {\n1011:             self.advance()?;\n1012:             let body = self.arm_body()?;\n1013:             let span = left.span().to(body.span());\n1014:             return Ok(MatchArm {\n1015:                 pattern: Pattern::Guard(left),\n1016:                 body,\n1017:                 span,\n1018:             });\n1019:         }\n1020:         let span = left.span();\n1021:         Ok(MatchArm {\n1022:             pattern: Pattern::Default { span },\n1023:             body: left,\n1024:             span,\n1025:         })\n1026:     }\n1027: \n1028:     fn pattern(&mut self) -> Result<Pattern, Error> {\n1029:         let (name, span) = self.eat_ident(\"a pattern\")?;\n1030:         let (next, brace_span) = self.peek()?;\n1031:         if name == \"any\" && next == Tok::LParen {\n1032:             self.advance()?;\n1033:             let close = self.eat(Tok::RParen)?;\n1034:             return Ok(Pattern::Default {\n1035:                 span: span.to(close),\n1036:             });\n1037:         }\n1038:         if next != Tok::LBrace {\n1039:             return Ok(Pattern::Variant {\n1040:                 name,\n1041:                 span,\n1042:                 fields: None,\n1043:             });\n1044:         }\n1045:         self.advance()?;\n1046:         let mut names = Vec::new();\n1047:         let mut rest = false;\n1048:         let (first, _) = self.peek()?;\n1049:         if first != Tok::RBrace {\n1050:             loop {\n1051:                 // `..` is two Dot tokens, and it ends the list: naming a field after \"and the\n1052:                 // rest\" would make the marker meaningless.\n1053:                 if self.peek()?.0 == Tok::Dot {\n1054:                     self.advance()?;\n1055:                     self.eat(Tok::Dot)?;\n1056:                     rest = true;\n1057:                     break;\n1058:                 }\n1059:                 names.push(self.eat_ident(\"a field name\")?);\n1060:                 let (sep, _) = self.peek()?;\n1061:                 if sep != Tok::Comma {\n1062:                     break;\n1063:                 }\n1064:                 self.advance()?;\n1065:             }\n1066:         }\n1067:         let close = self.eat(Tok::RBrace)?;\n1068:         let fields = FieldsPattern {\n1069:             names,\n1070:             rest,\n1071:             span: brace_span.to(close),\n1072:         };\n1073:         Ok(Pattern::Variant {\n1074:             name,\n1075:             span: span.to(close),\n1076:             fields: Some(fields),\n1077:         })\n1078:     }\n1079: \n1080:     /// Arm chains begin only where an expression begins fresh (a pipe stage, a delimited\n1081:     /// position), and a fresh position is also where `or` goes back to reading as disjunction:\n1082:     /// whatever chain the enclosing arm body belonged to, this expression is not part of it. An\n1083:     /// arm body enters at COND_POWER instead and leaves any `->` or separator `or` it meets for\n1084:     /// the chain that owns it, rather than opening a nested chain that would swallow the rest of\n1085:     /// the outer one.\n1086:     fn expr(&mut self, min_power: u8) -> Result<Expr, Error> {\n1087:         if min_power <= PIPE_RIGHT {\n1088:             return self.with_or(false, |p| p.expr_at(min_power, true));\n1089:         }\n1090:         self.expr_at(min_power, false)\n1091:     }\n1092: \n1093:     fn expr_at(&mut self, min_power: u8, fresh: bool) -> Result<Expr, Error> {\n1094:         let mut lhs = if fresh && self.arm_starts_here() {\n1095:             self.match_expr(None)?\n1096:         } else {\n1097:             let e = self.operand(min_power)?;\n1098:             let (tok, _) = self.peek()?;\n1099:             // No `Tok::Or` here: a fresh position reads `or` as disjunction, so `operand` has\n1100:             // already taken any that were there, and an arm chain is revealed by the `->` that\n1101:             // follows the whole disjunction (`a == 1 or b == 2 -> ...` is one guard).\n1102:             if fresh && tok == Tok::Arrow {\n1103:                 self.match_expr(Some(e))?\n1104:             } else {\n1105:                 e\n1106:             }\n1107:         };\n1108: \n1109:         loop {\n1110:             let (tok, _) = self.peek()?;\n1111:             if tok != Tok::Pipe || PIPE_LEFT < min_power {\n1112:                 break;\n1113:             }\n1114:             self.advance()?;\n1115:             let rhs = self.expr(PIPE_RIGHT)?;\n1116:             let span = lhs.span().to(rhs.span());\n1117:             lhs = Expr::Pipe {\n1118:                 lhs: Box::new(lhs),\n1119:                 rhs: Box::new(rhs),\n1120:                 span,\n1121:             };\n1122:         }\n1123: \n1124:         Ok(lhs)\n1125:     }\n1126: \n1127:     /// The program's body (or a function's, when it is not a `let` block): an ordinary\n1128:     /// expression, or the tail-pipeline `lhs |> callee` that is the one way a sink is written.\n1129:     /// Parsed only here, at the outermost position, so a nested `|>` is a parse error rather\n1130:     /// than a value -- the checker's sink position rule is this production's, not a search for\n1131:     /// a stray token somewhere inside a larger expression.\n1132:     fn tail_pipe(&mut self) -> Result<Expr, Error> {\n1133:         let lhs = self.expr(0)?;\n1134:         let (tok, _) = self.peek()?;\n1135:         if tok != Tok::PipeGt {\n1136:             return Ok(lhs);\n1137:         }\n1138:         self.advance()?;\n1139:         let (callee, callee_span) = self.eat_ident(\"a sink call\")?;\n1140:         let span = lhs.span().to(callee_span);\n1141:         Ok(Expr::TailPipe {\n1142:             lhs: Box::new(lhs),\n1143:             callee,\n1144:             callee_span,\n1145:             span,\n1146:         })\n1147:     }\n1148: \n1149:     fn operand(&mut self, min_power: u8) -> Result<Expr, Error> {\n1150:         let mut lhs = self.complement(min_power)?;\n1151: \n1152:         loop {\n1153:             let (tok, _) = self.peek()?;\n1154:             // Where `or` is the arm separator it is not an operator at all, so the table is not\n1155:             // even consulted: the chain the arm belongs to takes the token.\n1156:             if tok == Tok::Or && self.or_separates {\n1157:                 break;\n1158:             }\n1159:             let Some((op, left, right)) = infix_power(&tok) else {\n1160:                 break;\n1161:             };\n1162:             if left < min_power {\n1163:                 break;\n1164:             }\n1165:             self.advance()?;\n1166:             let rhs = self.operand(right)?;\n1167:             let span = lhs.span().to(rhs.span());\n1168:             lhs = match op {\n1169:                 Infix::Bin(op) => Expr::Binary {\n1170:                     op,\n1171:                     lhs: Box::new(lhs),\n1172:                     rhs: Box::new(rhs),\n1173:                     span,\n1174:                 },\n1175:                 Infix::Logic(op) => Expr::Logic {\n1176:                     op,\n1177:                     lhs: Box::new(lhs),\n1178:                     rhs: Box::new(rhs),\n1179:                     span,\n1180:                 },\n1181:             };\n1182:         }\n1183: \n1184:         Ok(lhs)\n1185:     }\n1186: \n1187:     /// `not`, which is prefix but not unary in `-`'s sense: it binds looser than every operator\n1188:     /// in the infix table above comparison, so it reads its own operand at its own power rather\n1189:     /// than taking whatever `unary` returns. A position that binds tighter than `not` (a\n1190:     /// comparison's right side, say) declines it, and parens are what reach in there.\n1191:     fn complement(&mut self, min_power: u8) -> Result<Expr, Error> {\n1192:         let (tok, span) = self.peek()?;\n1193:         if tok == Tok::Not && min_power <= NOT_POWER {\n1194:             self.advance()?;\n1195:             let base = self.operand(NOT_POWER)?;\n1196:             let full = span.to(base.span());\n1197:             return Ok(Expr::Not {\n1198:                 base: Box::new(base),\n1199:                 span: full,\n1200:             });\n1201:         }\n1202:         self.unary()\n1203:     }\n1204: \n1205:     /// Negation binds tighter than any infix operator and looser than any postfix one, so\n1206:     /// `-a.b` negates the field and `-a * b` negates only `a`.\n1207:     fn unary(&mut self) -> Result<Expr, Error> {\n1208:         let (tok, span) = self.peek()?;\n1209:         if tok == Tok::Minus {\n1210:             self.advance()?;\n1211:             let base = self.unary()?;\n1212:             let full = span.to(base.span());\n1213:             return Ok(Expr::Neg {\n1214:                 base: Box::new(base),\n1215:                 span: full,\n1216:             });\n1217:         }\n1218:         self.postfix()\n1219:     }\n1220: \n1221:     /// `[]` and `.name` bind tighter than any infix operator, so `a.b[] | c` projects `a.b`.\n1222:     fn postfix(&mut self) -> Result<Expr, Error> {\n1223:         let mut e = self.atom()?;\n1224:         loop {\n1225:             let (tok, _) = self.peek()?;\n1226:             match tok {\n1227:                 Tok::LBracket => {\n1228:                     let (_, bspan) = self.peek()?;\n1229:                     // Indexing owns `[` on the same line only, the same rule call arguments\n1230:                     // follow: a definition's body and the program's body sit adjacent, and the\n1231:                     // line break keeps one from swallowing the other.\n1232:                     if !self.same_line(e.span().end, bspan.start) {\n1233:                         return Ok(e);\n1234:                     }\n1235:                     let (_, lspan) = self.advance()?;\n1236:                     let (next, _) = self.peek()?;\n1237:                     if next == Tok::RBracket {\n1238:                         let close = self.advance()?.1;\n1239:                         let span = e.span().to(close);\n1240:                         e = Expr::Project {\n1241:                             base: Box::new(e),\n1242:                             span,\n1243:                         };\n1244:                     } else {\n1245:                         // `[a]` collapses; `[a:b]` narrows, with either bound optional. A `:`\n1246:                         // is never an expression token, so peeking past the first operand (or\n1247:                         // past the `[`, for `[:b]`) tells the two apart unambiguously.\n1248:                         let start = if next == Tok::Colon {\n1249:                             None\n1250:                         } else {\n1251:                             Some(Box::new(self.expr(0)?))\n1252:                         };\n1253:                         if self.peek()?.0 == Tok::Colon {\n1254:                             self.advance()?;\n1255:                             let (next, _) = self.peek()?;\n1256:                             let end = if next == Tok::RBracket {\n1257:                                 None\n1258:                             } else {\n1259:                                 Some(Box::new(self.expr(0)?))\n1260:                             };\n1261:                             let close = self.eat(Tok::RBracket)?;\n1262:                             // Both edges at the dimension's own boundaries is the identity\n1263:                             // `[]` already is, and jq itself rejects the both-omitted form,\n1264:                             // so there is no reason to carry a spelling for it.\n1265:                             if start.is_none() && end.is_none() {\n1266:                                 return Err(Error::new(\n1267:                                     lspan.to(close),\n1268:                                     \"a slice needs at least one bound\",\n1269:                                 ));\n1270:                             }\n1271:                             let span = e.span().to(close);\n1272:                             e = Expr::Slice {\n1273:                                 base: Box::new(e),\n1274:                                 start,\n1275:                                 end,\n1276:                                 span,\n1277:                             };\n1278:                         } else {\n1279:                             // No colon after the first operand: a plain collapsing index,\n1280:                             // whose `start` is the index.\n1281:                             let close = self.eat(Tok::RBracket)?;\n1282:                             let span = e.span().to(close);\n1283:                             e = Expr::Index {\n1284:                                 base: Box::new(e),\n1285:                                 index: start.expect(\"no colon means start was parsed\"),\n1286:                                 span,\n1287:                             };\n1288:                         }\n1289:                     }\n1290:                 }\n1291:                 Tok::Bang => {\n1292:                     let bang = self.advance()?.1;\n1293:                     let span = e.span().to(bang);\n1294:                     e = Expr::Unwrap {\n1295:                         base: Box::new(e),\n1296:                         span,\n1297:                     };\n1298:                 }\n1299:                 Tok::Dot => {\n1300:                     self.advance()?;\n1301:                     let (ft, fspan) = self.advance()?;\n1302:                     let Tok::Ident(name) = ft else {\n1303:                         return Err(Error::new(\n1304:                             fspan,\n1305:                             format!(\"expected a field name, found {ft}\"),\n1306:                         ));\n1307:                     };\n1308:                     let span = e.span().to(fspan);\n1309:                     e = Expr::Field {\n1310:                         base: Box::new(e),\n1311:                         name,\n1312:                         span,\n1313:                     };\n1314:                 }\n1315:                 _ => return Ok(e),\n1316:             }\n1317:         }\n1318:     }\n1319: \n1320:     /// What a name means once read: a qualified variant (`Shape.circle`), a call when an\n1321:     /// argument starts after it on the same line, or a plain variable reference.\n1322:     ///\n1323:     /// A name followed by an argument is a call; bare application is the default spelling and\n1324:     /// `f(x)` is `f` applied to the grouped atom `(x)`. The bare form asks two things of the\n1325:     /// call that the delimited forms do not: the callee must be lowercase (a capitalised bare\n1326:     /// call could never typecheck), and the argument's first token excludes `-` (already\n1327:     /// subtraction: `f -1` stays `f - 1`), `.` (projection binds tighter than bare application\n1328:     /// everywhere, so `p.b` is a field access even though `.b` alone could be an argument --\n1329:     /// issue #19), and `[` (indexing owns it for the same reason: `v[0]` indexes, so a Vec\n1330:     /// literal argument needs parens).\n1331:     fn ident_expr(&mut self, name: String, span: Span) -> Result<Expr, Error> {\n1332:         let (next, next_span) = self.peek()?;\n\n(Output capped at 50 KB. Showing lines 1-1332. Use offset=1333 to continue.)\n</content>","metadata":{"preview":"use winnow::error::ParserError;\nuse winnow::prelude::*;\nuse winnow::stream::{LocatingSlice, Location, Stream};\nuse winnow::token::take_while;\n\nuse crate::ast::{\n    Alias, BinOp, Def, EnumDecl, Expr, FieldsPattern, File, LogicOp, MatchArm, Module, Param,\n    Pattern, Span, TypeExpr, Variant,\n};\nuse crate::error::Error;\nuse crate::ty;\n\n/// The stream this whole module parses over: a source string with byte-offset tracking built\n/// in, so every sub-parser gets `Span`s for free from `current_token_start` rather than threading\n/// position by hand.\ntype Input<'i> = LocatingSlice<&'i str>;\n\n/// Lets every winnow combinator used below (`take_while`, and anything built on it) report\n/// failure as this crate's own `Error` directly -- there is no separate winnow error type to\n/// translate out of. `from_input` is winnow's fallback for a failure it synthesises itself","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-174/src/parse.rs","text":"use winnow::error::ParserError;\nuse winnow::prelude::*;\nuse winnow::stream::{LocatingSlice, Location, Stream};\nuse winnow::token::take_while;\n\nuse crate::ast::{\n    Alias, BinOp, Def, EnumDecl, Expr, FieldsPattern, File, LogicOp, MatchArm, Module, Param,\n    Pattern, Span, TypeExpr, Variant,\n};\nuse crate::error::Error;\nuse crate::ty;\n\n/// The stream this whole module parses over: a source string with byte-offset tracking built\n/// in, so every sub-parser gets `Span`s for free from `current_token_start` rather than threading\n/// position by hand.\ntype Input<'i> = LocatingSlice<&'i str>;\n\n/// Lets every winnow combinator used below (`take_while`, and anything built on it) report\n/// failure as this crate's own `Error` directly -- there is no separate winnow error type to\n/// translate out of. `from_input` is winnow's fallback for a failure it synthesises itself\n/// rather than one this module constructs explicitly; nothing here is expected to hit it; the\n/// hand-written parsers below always build their own `Error` with a specific message instead.\nimpl<'i> ParserError<Input<'i>> for Error {\n    type Inner = Error;\n\n    fn from_input(input: &Input<'i>) -> Error {\n        let at = input.current_token_start();\n        Error::new(Span::new(at, at), \"expected a token\".to_string())\n    }\n\n    fn into_inner(self) -> Result<Error, Error> {\n        Ok(self)\n    }\n}\n\n#[derive(Debug, Clone, PartialEq)]\nenum Tok {\n    Str(String),\n    Int(i64),\n    Float(f64),\n    Ident(String),\n    Fn,\n    Pub,\n    Type,\nEnum,\n    Let,\n    Input,\n    Inputs,\n    Lines,\n    Dsv,\n    Csv,\n    Tsv,\n    And,\n    Or,\n    Not,\n    Plus,\n    Minus,\n    Star,\n    Slash,\n    Percent,\n    Pipe,\n    PipeGt,\n    Comma,\n    Dot,\n    Eq,\n    EqEq,\n    Ne,\n    Bang,\n    Lt,\n    Le,\n    Gt,\n    Ge,\n    LParen,\n    RParen,\n    LBracket,\n    RBracket,\n    LBrace,\n    RBrace,\n    Colon,\n    Arrow,\n    Eof,\n}\n\nimpl std::fmt::Display for Tok {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        let s = match self {\n            Tok::Str(_) => return write!(f, \"a string\"),\n            Tok::Int(n) => return write!(f, \"`{n}`\"),\n            Tok::Float(n) => return write!(f, \"`{n}`\"),\n            Tok::Ident(name) => return write!(f, \"`{name}`\"),\n            Tok::Fn => \"`fn`\",\n            Tok::Pub => \"`pub`\",\n            Tok::Type => \"`type`\",\n            Tok::Enum => \"`enum`\",\n            Tok::Let => \"`let`\",\n            Tok::Input => \"`input`\",\n            Tok::Inputs => \"`inputs`\",\n            Tok::Lines => \"`lines`\",\n            Tok::Dsv => \"`dsv`\",\n            Tok::Csv => \"`csv`\",\n            Tok::Tsv => \"`tsv`\",\n            Tok::And => \"`and`\",\n            Tok::Or => \"`or`\",\n            Tok::Not => \"`not`\",\n            Tok::Plus => \"`+`\",\n            Tok::Minus => \"`-`\",\n            Tok::Star => \"`*`\",\n            Tok::Slash => \"`/`\",\n            Tok::Percent => \"`%`\",\n            Tok::Pipe => \"`|`\",\n            Tok::PipeGt => \"`|>`\",\n            Tok::Comma => \"`,`\",\n            Tok::Dot => \"`.`\",\n            Tok::Eq => \"`=`\",\n            Tok::EqEq => \"`==`\",\n            Tok::Ne => \"`!=`\",\n            Tok::Bang => \"`!`\",\n            Tok::Lt => \"`<`\",\n            Tok::Le => \"`<=`\",\n            Tok::Gt => \"`>`\",\n            Tok::Ge => \"`>=`\",\n            Tok::LParen => \"`(`\",\n            Tok::RParen => \"`)`\",\n            Tok::LBracket => \"`[`\",\n            Tok::RBracket => \"`]`\",\n            Tok::LBrace => \"`{`\",\n            Tok::RBrace => \"`}`\",\n            Tok::Colon => \"`:`\",\n            Tok::Arrow => \"`->`\",\n            Tok::Eof => \"end of program\",\n        };\n        write!(f, \"{s}\")\n    }\n}\n\n/// Zero or more ASCII spaces/tabs/newlines, then a `#`-to-newline comment if one follows,\n/// repeated: a run of trivia can mix any number of either in any order.\nfn skip_trivia(input: &mut Input) {\n    loop {\n        take_while::<_, _, Error>(0.., |c: char| c.is_ascii_whitespace())\n            .parse_next(input)\n            .expect(\"a lower bound of zero never fails\");\n        if input.peek_token() != Some('#') {\n            return;\n        }\n        input.next_token();\n        while !matches!(input.peek_token(), None | Some('\\n')) {\n            input.next_token();\n        }\n    }\n}\n\n/// Skips trivia, then reads exactly one token from the front of `input`. Called fresh for every\n/// `peek`/`peek2`/`advance` rather than once up front into a `Vec`, so a lexical error (a bad\n/// escape, an out-of-range integer) surfaces at the point parsing actually reaches it instead of\n/// always winning over a parse error earlier in the file the way a separate up-front pass would.\nfn read_tok<'i>(input: &mut Input<'i>) -> Result<(Tok, Span), Error> {\n    skip_trivia(input);\n    let start = input.current_token_start();\n    let Some(c) = input.peek_token() else {\n        return Ok((Tok::Eof, Span::new(start, start)));\n    };\n\n    let tok = match c {\n        '\"' => Tok::Str(read_string(input)?),\n        '0'..='9' => read_number(input, start)?,\n        c if c.is_ascii_alphabetic() || c == '_' => {\n            let word =\n                take_while::<_, _, Error>(1.., |c: char| c.is_ascii_alphanumeric() || c == '_')\n                    .parse_next(input)\n                    .expect(\"a letter or underscore was just confirmed to follow\");\n            match word {\n                \"fn\" => Tok::Fn,\n                \"pub\" => Tok::Pub,\n                \"type\" => Tok::Type,\n                \"enum\" => Tok::Enum,\n                \"let\" => Tok::Let,\n                \"input\" => Tok::Input,\n                \"inputs\" => Tok::Inputs,\n                \"lines\" => Tok::Lines,\n                \"dsv\" => Tok::Dsv,\n                \"csv\" => Tok::Csv,\n                \"tsv\" => Tok::Tsv,\n                \"and\" => Tok::And,\n                // Two operators sharing one spelling, told apart by position: the arm separator\n                // at a chain's top level, Bool disjunction everywhere else. `Cursor::or_separates`\n                // is which one is being read (kantord/toylang#96).\n                \"or\" => Tok::Or,\n                \"not\" => Tok::Not,\n                name => Tok::Ident(name.to_string()),\n            }\n        }\n        // `-` is subtraction and negation now, so a digit after it is no longer a negative\n        // literal: `a -1` would otherwise not be `a - 1`.\n        '-' => read_two_char(input, '>', Tok::Minus, Tok::Arrow),\n        '!' => read_two_char(input, '=', Tok::Bang, Tok::Ne),\n        '=' | '<' | '>' => match c {\n            '=' => read_two_char(input, '=', Tok::Eq, Tok::EqEq),\n            '<' => read_two_char(input, '=', Tok::Lt, Tok::Le),\n            _ => read_two_char(input, '=', Tok::Gt, Tok::Ge),\n        },\n        '+' => single(input, Tok::Plus),\n        '*' => single(input, Tok::Star),\n        // `//` is not a token anymore: match arms compose with `or` now, so a second slash is\n        // just a `/` where no expression can start, which is the parse error migration needs.\n        '/' => single(input, Tok::Slash),\n        '%' => single(input, Tok::Percent),\n        '|' => read_two_char(input, '>', Tok::Pipe, Tok::PipeGt),\n        ',' => single(input, Tok::Comma),\n        '.' => single(input, Tok::Dot),\n        '(' => single(input, Tok::LParen),\n        ')' => single(input, Tok::RParen),\n        '[' => single(input, Tok::LBracket),\n        ']' => single(input, Tok::RBracket),\n        '{' => single(input, Tok::LBrace),\n        '}' => single(input, Tok::RBrace),\n        ':' => single(input, Tok::Colon),\n        other => {\n            return Err(Error::new(\n                Span::new(start, start + 1),\n                format!(\"unexpected character `{other}`\"),\n            ));\n        }\n    };\n    Ok((tok, Span::new(start, input.current_token_start())))\n}\n\n/// A number literal: the integer digits that opened it, then an optional `.digits` fraction\n/// and an optional `e`-exponent. Either makes it a Float (ADR 0007); without both it stays the\n/// Int it always was. A `.` or `e` only joins the literal when what follows makes a number, so\n/// `1.5` and `1e3` are one token while `1.`, `1.x`, and `1e` keep the dot or letter for the\n/// parser.\nfn read_number<'i>(input: &mut Input<'i>, start: usize) -> Result<Tok, Error> {\n    let digits = take_while::<_, _, Error>(1.., |c: char| c.is_ascii_digit())\n        .parse_next(input)\n        .expect(\"a digit was just confirmed to follow\");\n    let mut text = digits.to_string();\n    let mut is_float = false;\n\n    if let Some(frac) = read_fraction(input) {\n        text.push('.');\n        text.push_str(&frac);\n        is_float = true;\n    }\n    if let Some(exp) = read_exponent(input) {\n        text.push('e');\n        text.push_str(&exp);\n        is_float = true;\n    }\n\n    let end = input.current_token_start();\n    if is_float {\n        let value = text.parse::<f64>().map_err(|_| {\n            Error::new(\n                Span::new(start, end),\n                format!(\"float `{text}` is out of range\"),\n            )\n        })?;\n        Ok(Tok::Float(value))\n    } else {\n        let n = digits.parse::<i64>().map_err(|_| {\n            Error::new(\n                Span::new(start, end),\n                format!(\"integer `{digits}` is out of range\"),\n            )\n        })?;\n        Ok(Tok::Int(n))\n    }\n}\n\n/// The `.digits` fraction of a number literal, `None` when the dot is not followed by a digit\n/// so it is left for the parser (`1.` and `1.x` are not floats).\nfn read_fraction<'i>(input: &mut Input<'i>) -> Option<String> {\n    if input.peek_token() != Some('.') {\n        return None;\n    }\n    let cp = input.checkpoint();\n    input.next_token();\n    if matches!(input.peek_token(), Some(c) if c.is_ascii_digit()) {\n        let frac = take_while::<_, _, Error>(1.., |c: char| c.is_ascii_digit())\n            .parse_next(input)\n            .expect(\"a digit was just confirmed to follow\");\n        Some(frac.to_string())\n    } else {\n        input.reset(&cp);\n        None\n    }\n}\n\n/// The `e`-exponent of a number literal, `None` when the exponent has no digits after it so\n/// the `e` is left for the parser (a bare trailing `e` is not a float).\nfn read_exponent<'i>(input: &mut Input<'i>) -> Option<String> {\n    if !matches!(input.peek_token(), Some('e') | Some('E')) {\n        return None;\n    }\n    let cp = input.checkpoint();\n    input.next_token();\n    let mut exp = String::new();\n    if matches!(input.peek_token(), Some('+') | Some('-')) {\n        exp.push(input.next_token().expect(\"a sign was just seen\"));\n    }\n    if matches!(input.peek_token(), Some(c) if c.is_ascii_digit()) {\n        let exd = take_while::<_, _, Error>(1.., |c: char| c.is_ascii_digit())\n            .parse_next(input)\n            .expect(\"a digit was just confirmed to follow\");\n        exp.push_str(exd);\n        Some(exp)\n    } else {\n        input.reset(&cp);\n        None\n    }\n}\n\nfn single(input: &mut Input, tok: Tok) -> Tok {\n    input.next_token();\n    tok\n}\n\n/// `-`, `!`, `=`, `<`, `>`, `|` all may start a two-character token: if the char after the\n/// first is `second`, the compound token stands; otherwise the bare operator does. `single` is\n/// for tokens that have no compound form at all.\nfn read_two_char(input: &mut Input, second: char, bare: Tok, compound: Tok) -> Tok {\n    input.next_token();\n    if input.peek_token() == Some(second) {\n        input.next_token();\n        compound\n    } else {\n        bare\n    }\n}\n\n/// Returns the unescaped contents of a string literal, having consumed through the closing\n/// quote. `input` is positioned on the opening `\"` on entry.\nfn read_string(input: &mut Input) -> Result<String, Error> {\n    let open = input.current_token_start();\n    input.next_token();\n    let mut text = String::new();\n    loop {\n        let pos = input.current_token_start();\n        match input.peek_token() {\n            None => return Err(Error::new(Span::new(open, pos), \"unterminated string\")),\n            Some('\"') => {\n                input.next_token();\n                return Ok(text);\n            }\n            // Escapes are JSON's set minus \\u, which waits for a real value model.\n            Some('\\\\') => {\n                let backslash = pos;\n                input.next_token();\n                let Some(esc) = input.peek_token() else {\n                    return Err(Error::new(\n                        Span::new(backslash, backslash + 1),\n                        \"unterminated escape sequence\",\n                    ));\n                };\n                text.push(match esc {\n                    '\"' => '\"',\n                    '\\\\' => '\\\\',\n                    '/' => '/',\n                    'n' => '\\n',\n                    't' => '\\t',\n                    'r' => '\\r',\n                    other => {\n                        return Err(Error::new(\n                            Span::new(backslash, backslash + 2),\n                            format!(\"unknown escape sequence `\\\\{other}`\"),\n                        ));\n                    }\n                });\n                input.next_token();\n            }\n            Some(c) => {\n                text.push(c);\n                input.next_token();\n            }\n        }\n    }\n}\n\n/// Which node an infix token builds. `and` and `or` are `ast::LogicOp`, not `BinOp`, so the\n/// table has to name the kind as well as the binding power.\nenum Infix {\n    Bin(BinOp),\n    Logic(LogicOp),\n}\n\n/// Left and right binding power. Left below right makes the operator left-associative.\n///\n/// `|` sits below comparison so that `a | select(. >= 2)` splits at the pipe, which is the\n/// ordering jq uses and the reason this table exists rather than a nest of functions.\nfn infix_power(tok: &Tok) -> Option<(Infix, u8, u8)> {\n    let (op, left, right) = match tok {\n        Tok::Or => (Infix::Logic(LogicOp::Or), OR_LEFT, OR_RIGHT),\n        Tok::And => (Infix::Logic(LogicOp::And), 6, 7),\n        Tok::EqEq => (Infix::Bin(BinOp::Eq), 8, 9),\n        Tok::Ne => (Infix::Bin(BinOp::Ne), 8, 9),\n        Tok::Lt => (Infix::Bin(BinOp::Lt), 8, 9),\n        Tok::Le => (Infix::Bin(BinOp::Le), 8, 9),\n        Tok::Gt => (Infix::Bin(BinOp::Gt), 8, 9),\n        Tok::Ge => (Infix::Bin(BinOp::Ge), 8, 9),\n        Tok::Plus => (Infix::Bin(BinOp::Add), 10, 11),\n        Tok::Minus => (Infix::Bin(BinOp::Sub), 10, 11),\n        Tok::Star => (Infix::Bin(BinOp::Mul), 12, 13),\n        Tok::Slash => (Infix::Bin(BinOp::Div), 12, 13),\n        Tok::Percent => (Infix::Bin(BinOp::Rem), 12, 13),\n        _ => return None,\n    };\n    Some((op, left, right))\n}\n\nconst PIPE_LEFT: u8 = 1;\nconst PIPE_RIGHT: u8 = 2;\n\n/// Where a match arm's body and its guard operand are read and printed: between `|` (1/2) and\n/// the Bool connectives (`or` at 4/5). An arm body read here stops at the separator `or` and\n/// `->`, which is what lets a chain be one pipe stage; a guard operand read here still gets the\n/// Bool `or` above it, so `a == 1 or b == 2 -> x` is one two-clause guard.\nconst COND_POWER: u8 = 3;\n\n/// Bool `or`, the loosest operator a Bool expression is built from: `a == 1 or b == 2` is one\n/// disjunction of two comparisons. Its *other* reading, the match-arm separator, has no power\n/// at all -- it is not an operator there but the chain's own punctuation, and it binds looser\n/// than everything, which is exactly why it cannot be one table entry with this (draft.md, the\n/// match-arms decision).\nconst OR_LEFT: u8 = 4;\nconst OR_RIGHT: u8 = 5;\n\n/// `not` sits directly below comparison, so `not a == b` negates the comparison rather than\n/// `a`, and above `and`, so `not a and b` negates only `a`. Python's ordering; the alternative,\n/// binding it as tight as unary `-`, makes every use of it against a comparison need parens.\nconst NOT_POWER: u8 = 8;\n\npub fn parse(src: &str) -> Result<File, Error> {\n    let mut p = Cursor {\n        input: LocatingSlice::new(src),\n        src,\n        declined_cross_line: None,\n        or_separates: false,\n    };\n\n    // Declarations in any order and any mix, since no kind can refer to another's position:\n    // aliases and enums are resolved before any signature is read.\n    let mut defs = Vec::new();\n    let mut aliases = Vec::new();\n    let mut enums = Vec::new();\n    loop {\n        let (tok, _) = p.peek()?;\n        match tok {\n            Tok::Pub => {\n                p.advance()?;\n                match p.peek()?.0 {\n                    Tok::Enum => enums.push(p.enum_decl(true)?),\n                    _ => defs.push(p.def(true)?),\n                }\n            }\n            Tok::Fn => defs.push(p.def(false)?),\n            Tok::Type => aliases.push(p.alias()?),\n            Tok::Enum => enums.push(p.enum_decl(false)?),\n            _ => break,\n        }\n    }\n\n    // `input <type>` declares what stdin holds before the body reads it. It is the one\n    // declaration that sits after the defs rather than among them, so it is read here, and it is\n    // recognized by the same-line rule a call argument follows: only when the type opens on\n    // `input`'s own line does the keyword start an annotation, so a body that merely uses\n    // `input` is never mistaken for one.\n    let input = match p.peek()? {\n        (Tok::Input, input_span) => {\n            let (next, next_span) = p.peek2()?;\n            if (next == Tok::LBrace || matches!(next, Tok::Ident(_)))\n                && p.same_line(input_span.end, next_span.start)\n            {\n                p.advance()?;\n                Some(p.type_expr()?)\n            } else {\n                None\n            }\n        }\n        _ => None,\n    };\n\n    let body = p.tail_pipe()?;\n    let (rest, rest_span) = p.peek()?;\n    if rest != Tok::Eof {\n        return Err(p.unexpected(rest_span, format!(\"expected end of program, found {rest}\")));\n    }\n    Ok(File {\n        aliases,\n        enums,\n        defs,\n        input,\n        body,\n    })\n}\n\n/// A module is declarations only, with no trailing expression -- there is nothing here to run,\n/// only names for a program to import. `pub` marks which ones a program actually receives.\npub fn parse_module(src: &str) -> Result<Module, Error> {\n    let mut p = Cursor {\n        input: LocatingSlice::new(src),\n        src,\n        declined_cross_line: None,\n        or_separates: false,\n    };\n    let mut defs = Vec::new();\n    let mut enums = Vec::new();\n    loop {\n        let (tok, span) = p.peek()?;\n        match tok {\n            Tok::Pub => {\n                p.advance()?;\n                match p.peek()?.0 {\n                    Tok::Enum => enums.push(p.enum_decl(true)?),\n                    _ => defs.push(p.def(true)?),\n                }\n            }\n            Tok::Fn => defs.push(p.def(false)?),\n            Tok::Enum => enums.push(p.enum_decl(false)?),\n            Tok::Eof => break,\n            other => {\n                return Err(Error::new(\n                    span,\n                    format!(\"expected `fn` or end of module, found {other}\"),\n                ));\n            }\n        }\n    }\n    Ok(Module { defs, enums })\n}\n\nstruct Cursor<'i> {\n    input: Input<'i>,\n    /// The full source, kept alongside the advancing `input` so the same-line rule can look at\n    /// the trivia between two tokens it already has spans for.\n    src: &'i str,\n    /// Where a call was declined because its argument started on a later line: the argument\n    /// token's start, and the callee's name. Declining is usually right -- a definition's body\n    /// and the program's body sit adjacent with nothing between them, and the line break is what\n    /// keeps one from swallowing the other -- but when the parse then fails at exactly the\n    /// declined token, the intended reading was probably the call, and the error can name the\n    /// parens spelling that works across lines.\n    declined_cross_line: Option<(usize, String)>,\n    /// Which of `or`'s two readings is in force here: the match-arm separator (true), or Bool\n    /// disjunction (false). True only inside an arm's body, where the separator has to win so\n    /// that `a -> b or c` is two arms; every fresh expression position below that -- a\n    /// parenthesized group, a call argument, an arm's own guard -- puts it back to false, since\n    /// nothing there is a chain's top level. This is the split kantord/toylang#96 set out to\n    /// prove clean, and the one place a token's meaning depends on where it is read.\n    or_separates: bool,\n}\n\nimpl<'i> Cursor<'i> {\n    /// Reads the next token without consuming it. `Input` is `Copy` (a source `&str` plus an\n    /// offset), so looking ahead is just tokenizing a throwaway copy of the cursor.\n    fn peek(&self) -> Result<(Tok, Span), Error> {\n        let mut probe = self.input;\n        read_tok(&mut probe)\n    }\n\n    /// Reads the token after the next one without consuming either. One probe over `input`,\n    /// then a second over the probe, so the cursor never moves.\n    fn peek2(&self) -> Result<(Tok, Span), Error> {\n        let mut probe = self.input;\n        read_tok(&mut probe)?;\n        read_tok(&mut probe)\n    }\n\n    fn advance(&mut self) -> Result<(Tok, Span), Error> {\n        read_tok(&mut self.input)\n    }\n\n    fn eat(&mut self, want: Tok) -> Result<Span, Error> {\n        let (tok, span) = self.peek()?;\n        if tok != want {\n            return Err(self.unexpected(span, format!(\"expected {want}, found {tok}\")));\n        }\n        self.advance()?;\n        Ok(span)\n    }\n\n    /// An \"unexpected token\" error, extended with the parens spelling when the failing token is\n    /// one a call declined to take as a cross-line argument (see `declined_cross_line`): the\n    /// token had somewhere to go, and only the line break kept it from going there.\n    fn unexpected(&self, span: Span, msg: String) -> Error {\n        if let Some((at, callee)) = &self.declined_cross_line\n            && *at == span.start\n        {\n            return Error::new(\n                span,\n                format!(\n                    \"{msg}; an argument must start on the same line as its function -- \\\n                     write `{callee}(...)` to call across lines\"\n                ),\n            );\n        }\n        Error::new(span, msg)\n    }\n\n    /// Whether nothing but spaces and tabs sits between two byte offsets. The same-line rule for\n    /// call arguments: an argument, bare or parenthesized, must start on the same line as its\n    /// function, which is what lets a definition's body end next to the program's body without\n    /// either reaching across the line break and swallowing the other.\n    fn same_line(&self, from: usize, to: usize) -> bool {\n        !self.src[from..to].contains('\\n')\n    }\n\n    /// The same-line rule applied at one call site: true when the argument starting at\n    /// `arg_span` is on `callee_span`'s line. A cross-line decline is recorded (see\n    /// `declined_cross_line`) so that if the parse then fails at that token, the error can say\n    /// why the call was not taken.\n    fn takes_argument(&mut self, callee: &str, callee_span: Span, arg_span: Span) -> bool {\n        if self.same_line(callee_span.end, arg_span.start) {\n            return true;\n        }\n        self.declined_cross_line = Some((arg_span.start, callee.to_string()));\n        false\n    }\n\n    /// Runs `f` with `or` reading as `separates` says, restoring the caller's reading after.\n    fn with_or<T>(\n        &mut self,\n        separates: bool,\n        f: impl FnOnce(&mut Self) -> Result<T, Error>,\n    ) -> Result<T, Error> {\n        let outer = std::mem::replace(&mut self.or_separates, separates);\n        let out = f(self);\n        self.or_separates = outer;\n        out\n    }\n\n    fn eat_ident(&mut self, what: &str) -> Result<(String, Span), Error> {\n        match self.advance()? {\n            (Tok::Ident(n), span) => Ok((n, span)),\n            (other, span) => Err(Error::new(span, format!(\"expected {what}, found {other}\"))),\n        }\n    }\n\n    /// `fn name(param: Type) -> Type = body` or `fn name() -> Type = body`.\n    ///\n    /// Both annotations are required by the grammar rather than by the checker, which is what\n    /// makes the message point at the missing annotation instead of at an inference failure.\n    fn def(&mut self, is_pub: bool) -> Result<Def, Error> {\n        let start = self.eat(Tok::Fn)?;\n        let (name, _) = self.eat_ident(\"a name\")?;\n        self.eat(Tok::LParen)?;\n\n        let (next, _) = self.peek()?;\n        let param = if next == Tok::RParen {\n            None\n        } else {\n            let (param_name, param_span) = self.eat_ident(\"a name\")?;\n            let (colon, _) = self.peek()?;\n            if colon != Tok::Colon {\n                return Err(Error::new(\n                    param_span,\n                    format!(\"parameter `{param_name}` needs a type annotation\"),\n                ));\n            }\n            self.advance()?;\n            let param_ty = self.type_expr()?;\n            Some(Param {\n                span: param_span.to(param_ty.span()),\n                name: param_name,\n                ty: param_ty,\n            })\n        };\n\n        let close = self.eat(Tok::RParen)?;\n        let (arrow, _) = self.peek()?;\n        if arrow != Tok::Arrow {\n            return Err(Error::new(\n                close,\n                format!(\"function `{name}` needs a return type\"),\n            ));\n        }\n        self.advance()?;\n        let ret = self.type_expr()?;\n\n        self.eat(Tok::Eq)?;\n        let body = self.def_body()?;\n        Ok(Def {\n            span: start.to(body.span()),\n            name,\n            param,\n            ret,\n            body,\n            is_pub,\n            origin: crate::ast::Origin::Program,\n        })\n    }\n\n    /// A function's body. An ordinary expression, or -- when the `let` keyword opens it -- the\n    /// local-binding block the ruling on #87 settled on: `let <name> = <expr>` one per line,\n    /// then the expression that ends the block, with no `in` keyword. The line that is not a\n    /// `let` is the value, so each binding's value has to fit on its own line or the next line\n    /// cannot be told apart from the block's result.\n    fn def_body(&mut self) -> Result<Expr, Error> {\n        let (first, _) = self.peek()?;\n        if first != Tok::Let {\n            return self.tail_pipe();\n        }\n        let first_let = self.advance()?.1;\n        let mut bindings = Vec::new();\n        let mut binding_start = first_let.start;\n\n        loop {\n            let (name, _) = self.eat_ident(\"a binding name\")?;\n            self.eat(Tok::Eq)?;\n            let value = self.expr(0)?;\n            if !self.same_line(binding_start, value.span().end) {\n                return Err(Error::new(\n                    value.span(),\n                    \"a `let` binding must fit on its line; write the whole `let <name> = <expr>` \\\n                     on one line and let the next line be another `let` or the block's value\"\n                        .to_string(),\n                ));\n            }\n            bindings.push((name, value));\n            if self.peek()?.0 == Tok::Let {\n                binding_start = self.advance()?.1.start;\n\n                continue;\n            }\n            break;\n        }\n        let body = self.expr(0)?;\n        let span = first_let.to(body.span());\n        Ok(Expr::Let {\n            bindings,\n            body: Box::new(body),\n            span,\n        })\n    }\n\n    /// `Str`, `Int`, `Bool`, `Vec<T>`, `Stream<T>`, or any declared name -- with\n    /// `<...>` arguments when the name is a generic enum's. The parser accepts arguments on\n    /// every name and lets resolution hold the arity, so `Pair` and `Str<Int>` fail with an\n    /// error that knows what `Pair` and `Str` are rather than a parse error that does not.\n    fn type_expr(&mut self) -> Result<TypeExpr, Error> {\n        let (tok, span) = self.advance()?;\n        if tok == Tok::LBrace {\n            return self.record_type(span);\n        }\n        let name = match tok {\n            Tok::Ident(n) => n,\n            other => return Err(Error::new(span, format!(\"expected a type, found {other}\"))),\n        };\n        if self.peek()?.0 != Tok::Lt {\n            return Ok(TypeExpr::Named {\n                name,\n                args: Vec::new(),\n                span,\n            });\n        }\n        self.advance()?;\n        let mut args = Vec::new();\n        loop {\n            args.push(self.type_expr()?);\n            let (sep, _) = self.peek()?;\n            if sep != Tok::Comma {\n                break;\n            }\n            self.advance()?;\n        }\n        let close = self.eat(Tok::Gt)?;\n        let span = span.to(close);\n        // The two built-in constructors keep their own nodes; their arity is the grammar's.\n        if ty::takes_type_arg(&name) {\n            if args.len() != 1 {\n                return Err(Error::new(\n                    span,\n                    format!(\"`{name}` takes one type argument, found {}\", args.len()),\n                ));\n            }\n            let elem = Box::new(args.remove(0));\n            return Ok(match name.as_str() {\n                \"Vec\" => TypeExpr::Vec { elem, span },\n                _ => TypeExpr::Stream { elem, span },\n            });\n        }\n        Ok(TypeExpr::Named { name, args, span })\n    }\n\n    /// A call's argument when it opens with `(` or `{`: a parenthesized expression, or a record\n    /// literal standing bare because `{` cannot start any other expression. The closing token\n    /// marks the argument's end unambiguously, which is what makes the parens form the\n    /// disambiguator wherever the bare form's own stopping rules would read a program\n    /// differently.\n    fn argument(&mut self) -> Result<(Expr, Span), Error> {\n        let (tok, span) = self.peek()?;\n        if tok == Tok::LBrace {\n            self.advance()?;\n            let lit = self.record_lit(span)?;\n            let lit_span = lit.span();\n            return Ok((lit, lit_span));\n        }\n        self.eat(Tok::LParen)?;\n        let inner = self.expr(0)?;\n        let close = self.eat(Tok::RParen)?;\n        Ok((inner, close))\n    }\n\n    /// `{name: expr, age: expr}`, the value form of the brace that `record_type` reads in type\n    /// position.\n    fn record_lit(&mut self, open: Span) -> Result<Expr, Error> {\n        let mut fields = Vec::new();\n        let (first, _) = self.peek()?;\n        if first != Tok::RBrace {\n            loop {\n                let (name, name_span) = self.eat_ident(\"a field name\")?;\n                self.eat(Tok::Colon)?;\n                fields.push((name, name_span, self.expr(0)?));\n                let (sep, _) = self.peek()?;\n                if sep != Tok::Comma {\n                    break;\n                }\n                self.advance()?;\n            }\n        }\n        let close = self.eat(Tok::RBrace)?;\n        Ok(Expr::RecordLit {\n            fields,\n            span: open.to(close),\n        })\n    }\n\n    /// `enum Shape { point, circle{r: Int}, celsius(Int) }`, optionally with type\n    /// parameters: `enum Opt<T> { some(T), none }`.\n    ///\n    /// A variant is a name, optionally followed by its payload type. The payload rule is any\n    /// single type, spelled the way a call spells its argument: a record type directly in\n    /// braces, or any type in parens.\n    fn enum_decl(&mut self, is_pub: bool) -> Result<EnumDecl, Error> {\n        let start = self.eat(Tok::Enum)?;\n        let (name, _) = self.eat_ident(\"an enum name\")?;\n        let mut params = Vec::new();\n        if self.peek()?.0 == Tok::Lt {\n            self.advance()?;\n            loop {\n                params.push(self.eat_ident(\"a type parameter\")?);\n                let (sep, _) = self.peek()?;\n                if sep != Tok::Comma {\n                    break;\n                }\n                self.advance()?;\n            }\n            self.eat(Tok::Gt)?;\n        }\n        self.eat(Tok::LBrace)?;\n        let mut variants = Vec::new();\n        let (first, _) = self.peek()?;\n        if first != Tok::RBrace {\n            loop {\n                let (vname, vspan) = self.eat_ident(\"a variant name\")?;\n                let payload = match self.peek()? {\n                    (Tok::LBrace, open) => {\n                        self.advance()?;\n                        Some(self.record_type(open)?)\n                    }\n                    (Tok::LParen, _) => {\n                        self.advance()?;\n                        let ty = self.type_expr()?;\n                        self.eat(Tok::RParen)?;\n                        Some(ty)\n                    }\n                    _ => None,\n                };\n                variants.push(Variant {\n                    name: vname,\n                    span: vspan,\n                    payload,\n                });\n                let (sep, _) = self.peek()?;\n                if sep != Tok::Comma {\n                    break;\n                }\n                self.advance()?;\n            }\n        }\n        let close = self.eat(Tok::RBrace)?;\n        Ok(EnumDecl {\n            name,\n            params,\n            variants,\n            span: start.to(close),\n            is_pub,\n        })\n    }\n\n    /// `type Db = {users: Vec<User>}`\n    fn alias(&mut self) -> Result<Alias, Error> {\n        let start = self.eat(Tok::Type)?;\n        let (name, _) = self.eat_ident(\"a type name\")?;\n        self.eat(Tok::Eq)?;\n        let ty = self.type_expr()?;\n        let span = start.to(ty.span());\n        Ok(Alias { name, ty, span })\n    }\n\n    fn record_type(&mut self, open: Span) -> Result<TypeExpr, Error> {\n        let mut fields = Vec::new();\n        let (first, _) = self.peek()?;\n        if first != Tok::RBrace {\n            loop {\n                let (fname, _) = self.eat_ident(\"a field name\")?;\n                self.eat(Tok::Colon)?;\n                fields.push((fname, self.type_expr()?));\n                let (sep, _) = self.peek()?;\n                if sep != Tok::Comma {\n                    break;\n                }\n                self.advance()?;\n            }\n        }\n        let close = self.eat(Tok::RBrace)?;\n        Ok(TypeExpr::Record {\n            fields,\n            span: open.to(close),\n        })\n    }\n\n    /// Whether the tokens ahead begin a match arm: `name ->`, `name{a, b} ->`, or `any() ->`.\n    /// The one place this has to look carefully is a brace: a record *pattern* holds bare names\n    /// (and `..`), so the first `:` proves the braces are a constructor's record literal\n    /// argument instead. A lexical error while probing is not an arm; the ordinary path will\n    /// surface it.\n    fn arm_starts_here(&self) -> bool {\n        let mut probe = self.input;\n        let mut next = || read_tok(&mut probe).map(|(t, _)| t);\n        let Ok(Tok::Ident(name)) = next() else {\n            return false;\n        };\n        match next() {\n            Ok(Tok::Arrow) => true,\n            Ok(Tok::LParen) if name == \"any\" => {\n                matches!(next(), Ok(Tok::RParen)) && matches!(next(), Ok(Tok::Arrow))\n            }\n            Ok(Tok::LBrace) => {\n                loop {\n                    match next() {\n                        Ok(Tok::Ident(_) | Tok::Comma | Tok::Dot) => continue,\n                        Ok(Tok::RBrace) => break,\n                        _ => return false,\n                    }\n                }\n                matches!(next(), Ok(Tok::Arrow))\n            }\n            _ => false,\n        }\n    }\n\n    /// `left -> body or left -> body or ...`, first match wins; `or` is the one arm composer.\n    /// A left side is a variant pattern (`circle{r}`), `any()`, or a Bool guard expression; the\n    /// chain's final element may instead be a bare expression, the default. The chain reads `.`\n    /// as its subject, so it usually sits to the right of a `|`; each body stops at `|` and\n    /// `or`, which is what lets the chain be one pipe stage.\n    ///\n    /// The two `or`s meet here and nowhere else. A body is read with the separator reading, so\n    /// it ends at the next `or`; an element's own left side is read with the disjunction one, so\n    /// `a -> 1 or b == 2 or c == 3 -> 4` is two arms whose second has a two-clause guard. What\n    /// makes that split decidable is that an element ending at a bare `or` could only ever have\n    /// been a bare default in a non-final position, which was already an error.\n    ///\n    /// `lead` is an expression `expr` had already read when the `->` after it revealed a chain;\n    /// the first element continues from it instead of parsing fresh.\n    fn match_expr(&mut self, lead: Option<Expr>) -> Result<Expr, Error> {\n        let mut arms = Vec::new();\n        let mut lead = lead;\n        loop {\n            let arm = match lead.take() {\n                Some(e) => self.guard_or_default_arm(e)?,\n                None if self.arm_starts_here() => {\n                    let pattern = self.pattern()?;\n                    self.eat(Tok::Arrow)?;\n                    let body = self.arm_body()?;\n                    let span = pattern.span().to(body.span());\n                    MatchArm {\n                        pattern,\n                        body,\n                        span,\n                    }\n                }\n                None => {\n                    let e = self.with_or(false, |p| p.operand(COND_POWER))?;\n                    self.guard_or_default_arm(e)?\n                }\n            };\n            arms.push(arm);\n            let (sep, _) = self.peek()?;\n            if sep != Tok::Or {\n                break;\n            }\n            self.advance()?;\n        }\n        let span = arms[0].span.to(arms[arms.len() - 1].span);\n        Ok(Expr::Match { arms, span })\n    }\n\n    /// An arm's right side: the one position where a bare `or` is the chain's separator rather\n    /// than disjunction, so a Bool `or` written here needs parens (draft.md, the match-arms\n    /// decision).\n    fn arm_body(&mut self) -> Result<Expr, Error> {\n        self.with_or(true, |p| p.expr(COND_POWER))\n    }\n\n    /// The element `left` opens: `left -> body` makes `left` a guard, and a bare `left` is the\n    /// default, desugared to a `Default` arm whose body is `left` itself.\n    fn guard_or_default_arm(&mut self, left: Expr) -> Result<MatchArm, Error> {\n        if self.peek()?.0 == Tok::Arrow {\n            self.advance()?;\n            let body = self.arm_body()?;\n            let span = left.span().to(body.span());\n            return Ok(MatchArm {\n                pattern: Pattern::Guard(left),\n                body,\n                span,\n            });\n        }\n        let span = left.span();\n        Ok(MatchArm {\n            pattern: Pattern::Default { span },\n            body: left,\n            span,\n        })\n    }\n\n    fn pattern(&mut self) -> Result<Pattern, Error> {\n        let (name, span) = self.eat_ident(\"a pattern\")?;\n        let (next, brace_span) = self.peek()?;\n        if name == \"any\" && next == Tok::LParen {\n            self.advance()?;\n            let close = self.eat(Tok::RParen)?;\n            return Ok(Pattern::Default {\n                span: span.to(close),\n            });\n        }\n        if next != Tok::LBrace {\n            return Ok(Pattern::Variant {\n                name,\n                span,\n                fields: None,\n            });\n        }\n        self.advance()?;\n        let mut names = Vec::new();\n        let mut rest = false;\n        let (first, _) = self.peek()?;\n        if first != Tok::RBrace {\n            loop {\n                // `..` is two Dot tokens, and it ends the list: naming a field after \"and the\n                // rest\" would make the marker meaningless.\n                if self.peek()?.0 == Tok::Dot {\n                    self.advance()?;\n                    self.eat(Tok::Dot)?;\n                    rest = true;\n                    break;\n                }\n                names.push(self.eat_ident(\"a field name\")?);\n                let (sep, _) = self.peek()?;\n                if sep != Tok::Comma {\n                    break;\n                }\n                self.advance()?;\n            }\n        }\n        let close = self.eat(Tok::RBrace)?;\n        let fields = FieldsPattern {\n            names,\n            rest,\n            span: brace_span.to(close),\n        };\n        Ok(Pattern::Variant {\n            name,\n            span: span.to(close),\n            fields: Some(fields),\n        })\n    }\n\n    /// Arm chains begin only where an expression begins fresh (a pipe stage, a delimited\n    /// position), and a fresh position is also where `or` goes back to reading as disjunction:\n    /// whatever chain the enclosing arm body belonged to, this expression is not part of it. An\n    /// arm body enters at COND_POWER instead and leaves any `->` or separator `or` it meets for\n    /// the chain that owns it, rather than opening a nested chain that would swallow the rest of\n    /// the outer one.\n    fn expr(&mut self, min_power: u8) -> Result<Expr, Error> {\n        if min_power <= PIPE_RIGHT {\n            return self.with_or(false, |p| p.expr_at(min_power, true));\n        }\n        self.expr_at(min_power, false)\n    }\n\n    fn expr_at(&mut self, min_power: u8, fresh: bool) -> Result<Expr, Error> {\n        let mut lhs = if fresh && self.arm_starts_here() {\n            self.match_expr(None)?\n        } else {\n            let e = self.operand(min_power)?;\n            let (tok, _) = self.peek()?;\n            // No `Tok::Or` here: a fresh position reads `or` as disjunction, so `operand` has\n            // already taken any that were there, and an arm chain is revealed by the `->` that\n            // follows the whole disjunction (`a == 1 or b == 2 -> ...` is one guard).\n            if fresh && tok == Tok::Arrow {\n                self.match_expr(Some(e))?\n            } else {\n                e\n            }\n        };\n\n        loop {\n            let (tok, _) = self.peek()?;\n            if tok != Tok::Pipe || PIPE_LEFT < min_power {\n                break;\n            }\n            self.advance()?;\n            let rhs = self.expr(PIPE_RIGHT)?;\n            let span = lhs.span().to(rhs.span());\n            lhs = Expr::Pipe {\n                lhs: Box::new(lhs),\n                rhs: Box::new(rhs),\n                span,\n            };\n        }\n\n        Ok(lhs)\n    }\n\n    /// The program's body (or a function's, when it is not a `let` block): an ordinary\n    /// expression, or the tail-pipeline `lhs |> callee` that is the one way a sink is written.\n    /// Parsed only here, at the outermost position, so a nested `|>` is a parse error rather\n    /// than a value -- the checker's sink position rule is this production's, not a search for\n    /// a stray token somewhere inside a larger expression.\n    fn tail_pipe(&mut self) -> Result<Expr, Error> {\n        let lhs = self.expr(0)?;\n        let (tok, _) = self.peek()?;\n        if tok != Tok::PipeGt {\n            return Ok(lhs);\n        }\n        self.advance()?;\n        let (callee, callee_span) = self.eat_ident(\"a sink call\")?;\n        let span = lhs.span().to(callee_span);\n        Ok(Expr::TailPipe {\n            lhs: Box::new(lhs),\n            callee,\n            callee_span,\n            span,\n        })\n    }\n\n    fn operand(&mut self, min_power: u8) -> Result<Expr, Error> {\n        let mut lhs = self.complement(min_power)?;\n\n        loop {\n            let (tok, _) = self.peek()?;\n            // Where `or` is the arm separator it is not an operator at all, so the table is not\n            // even consulted: the chain the arm belongs to takes the token.\n            if tok == Tok::Or && self.or_separates {\n                break;\n            }\n            let Some((op, left, right)) = infix_power(&tok) else {\n                break;\n            };\n            if left < min_power {\n                break;\n            }\n            self.advance()?;\n            let rhs = self.operand(right)?;\n            let span = lhs.span().to(rhs.span());\n            lhs = match op {\n                Infix::Bin(op) => Expr::Binary {\n                    op,\n                    lhs: Box::new(lhs),\n                    rhs: Box::new(rhs),\n                    span,\n                },\n                Infix::Logic(op) => Expr::Logic {\n                    op,\n                    lhs: Box::new(lhs),\n                    rhs: Box::new(rhs),\n                    span,\n                },\n            };\n        }\n\n        Ok(lhs)\n    }\n\n    /// `not`, which is prefix but not unary in `-`'s sense: it binds looser than every operator\n    /// in the infix table above comparison, so it reads its own operand at its own power rather\n    /// than taking whatever `unary` returns. A position that binds tighter than `not` (a\n    /// comparison's right side, say) declines it, and parens are what reach in there.\n    fn complement(&mut self, min_power: u8) -> Result<Expr, Error> {\n        let (tok, span) = self.peek()?;\n        if tok == Tok::Not && min_power <= NOT_POWER {\n            self.advance()?;\n            let base = self.operand(NOT_POWER)?;\n            let full = span.to(base.span());\n            return Ok(Expr::Not {\n                base: Box::new(base),\n                span: full,\n            });\n        }\n        self.unary()\n    }\n\n    /// Negation binds tighter than any infix operator and looser than any postfix one, so\n    /// `-a.b` negates the field and `-a * b` negates only `a`.\n    fn unary(&mut self) -> Result<Expr, Error> {\n        let (tok, span) = self.peek()?;\n        if tok == Tok::Minus {\n            self.advance()?;\n            let base = self.unary()?;\n            let full = span.to(base.span());\n            return Ok(Expr::Neg {\n                base: Box::new(base),\n                span: full,\n            });\n        }\n        self.postfix()\n    }\n\n    /// `[]` and `.name` bind tighter than any infix operator, so `a.b[] | c` projects `a.b`.\n    fn postfix(&mut self) -> Result<Expr, Error> {\n        let mut e = self.atom()?;\n        loop {\n            let (tok, _) = self.peek()?;\n            match tok {\n                Tok::LBracket => {\n                    let (_, bspan) = self.peek()?;\n                    // Indexing owns `[` on the same line only, the same rule call arguments\n                    // follow: a definition's body and the program's body sit adjacent, and the\n                    // line break keeps one from swallowing the other.\n                    if !self.same_line(e.span().end, bspan.start) {\n                        return Ok(e);\n                    }\n                    let (_, lspan) = self.advance()?;\n                    let (next, _) = self.peek()?;\n                    if next == Tok::RBracket {\n                        let close = self.advance()?.1;\n                        let span = e.span().to(close);\n                        e = Expr::Project {\n                            base: Box::new(e),\n                            span,\n                        };\n                    } else {\n                        // `[a]` collapses; `[a:b]` narrows, with either bound optional. A `:`\n                        // is never an expression token, so peeking past the first operand (or\n                        // past the `[`, for `[:b]`) tells the two apart unambiguously.\n                        let start = if next == Tok::Colon {\n                            None\n                        } else {\n                            Some(Box::new(self.expr(0)?))\n                        };\n                        if self.peek()?.0 == Tok::Colon {\n                            self.advance()?;\n                            let (next, _) = self.peek()?;\n                            let end = if next == Tok::RBracket {\n                                None\n                            } else {\n                                Some(Box::new(self.expr(0)?))\n                            };\n                            let close = self.eat(Tok::RBracket)?;\n                            // Both edges at the dimension's own boundaries is the identity\n                            // `[]` already is, and jq itself rejects the both-omitted form,\n                            // so there is no reason to carry a spelling for it.\n                            if start.is_none() && end.is_none() {\n                                return Err(Error::new(\n                                    lspan.to(close),\n                                    \"a slice needs at least one bound\",\n                                ));\n                            }\n                            let span = e.span().to(close);\n                            e = Expr::Slice {\n                                base: Box::new(e),\n                                start,\n                                end,\n                                span,\n                            };\n                        } else {\n                            // No colon after the first operand: a plain collapsing index,\n                            // whose `start` is the index.\n                            let close = self.eat(Tok::RBracket)?;\n                            let span = e.span().to(close);\n                            e = Expr::Index {\n                                base: Box::new(e),\n                                index: start.expect(\"no colon means start was parsed\"),\n                                span,\n                            };\n                        }\n                    }\n                }\n                Tok::Bang => {\n                    let bang = self.advance()?.1;\n                    let span = e.span().to(bang);\n                    e = Expr::Unwrap {\n                        base: Box::new(e),\n                        span,\n                    };\n                }\n                Tok::Dot => {\n                    self.advance()?;\n                    let (ft, fspan) = self.advance()?;\n                    let Tok::Ident(name) = ft else {\n                        return Err(Error::new(\n                            fspan,\n                            format!(\"expected a field name, found {ft}\"),\n                        ));\n                    };\n                    let span = e.span().to(fspan);\n                    e = Expr::Field {\n                        base: Box::new(e),\n                        name,\n                        span,\n                    };\n                }\n                _ => return Ok(e),\n            }\n        }\n    }\n\n    /// What a name means once read: a qualified variant (`Shape.circle`), a call when an\n    /// argument starts after it on the same line, or a plain variable reference.\n    ///\n    /// A name followed by an argument is a call; bare application is the default spelling and\n    /// `f(x)` is `f` applied to the grouped atom `(x)`. The bare form asks two things of the\n    /// call that the delimited forms do not: the callee must be lowercase (a capitalised bare\n    /// call could never typecheck), and the argument's first token excludes `-` (already\n    /// subtraction: `f -1` stays `f - 1`), `.` (projection binds tighter than bare application\n    /// everywhere, so `p.b` is a field access even though `.b` alone could be an argument --\n    /// issue #19), and `[` (indexing owns it for the same reason: `v[0]` indexes, so a Vec\n    /// literal argument needs parens).\n    fn ident_expr(&mut self, name: String, span: Span) -> Result<Expr, Error> {\n        let (next, next_span) = self.peek()?;","lineStart":1,"lineEnd":1332,"totalLines":1333,"truncated":true}},"title":"src/parse.rs","time":{"start":1788379852610,"end":1788379852624}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me read the parser and the check module. The parser is 1506 lines and the check module is 3239 lines. Let me read the parser first to understand its structure.","format":"unknown","index":0}]}},"id":"prt_063beed4d001tfYzIoRbw64BBg","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","messageID":"msg_063bee336001AeBN4wn3byDl5l"}}
