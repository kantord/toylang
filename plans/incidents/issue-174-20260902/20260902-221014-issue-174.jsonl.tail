{"type":"tool_use","timestamp":1788379858760,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-8342fab90690e3fb","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-174/src/check/mod.rs","limit":400},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-174/src/check/mod.rs</path>\n<type>file</type>\n<content>\n1: use std::cell::{Cell, RefCell};\n2: use std::collections::{HashMap, HashSet};\n3: \n4: use crate::ast::{BinOp, Expr, FieldsPattern, File, MatchArm, Origin, Param, Pattern, Span};\n5: use crate::error::Error;\n6: use crate::tir::{self, Kind, LocalId, Tir};\n7: use crate::ty::{self, Sig, Type};\n8: \n9: mod linearity;\n10: mod types;\n11: \n12: use linearity::{StreamBinding, check_linear, field_used, param_used, prune_unreachable};\n13: use types::{\n14:     TypeEnv, alias_map, constructor_of, enum_map, is_constructor_of, matcher_of, resolve,\n15:     resolve_enum, signatures,\n16: };\n17: \n18: struct Ctx<'a> {\n19:     sigs: &'a HashMap<String, Sig>,\n20:     /// Every declared enum, resolved. Keyed by name, which is the identity.\n21:     enums: &'a HashMap<String, Type>,\n22:     /// Which enums declare each variant name, in declaration order. A bare variant use resolves\n23:     /// through this while exactly one enum claims the name; two claimants are a loud error\n24:     /// naming both, with `Shape.circle` as the qualified way out.\n25:     variant_owners: &'a HashMap<String, Vec<String>>,\n26:     /// Named bindings, innermost last. A function parameter carries `None` for its local (the\n27:     /// backends render a param by name); a `let` binding carries the `LocalId` it was bound to,\n28:     /// so reading the name is reading that local. `let` can stack many of these, and a later one\n29:     /// shadows an earlier, which is what the reverse search in `synth` is for.\n30:     scope: Vec<(String, Type, Option<LocalId>)>,\n31:     /// Names a match arm's record pattern bound, innermost last: reading one reads that field\n32:     /// off the arm's payload local, so nothing beyond ordinary `Field` nodes reaches the\n33:     /// backends. Each entry is the bound name, the payload's record type, and its local.\n34:     arm_fields: Vec<(String, Type, LocalId)>,\n35:     /// What `.` refers to here, if anything: its type and the local holding it.\n36:     subject: Option<(Type, LocalId)>,\n37:     /// The type `input` was checked against, filled in the first time it is used.\n38:     input: &'a RefCell<Option<Type>>,\n39:     /// The element type `inputs` was checked against, filled in the first time it is used. A\n40:     /// separate cell from `input`'s: one records a whole value's type, the other one line's.\n41:     inputs: &'a RefCell<Option<Type>>,\n42:     /// Whether `lines` has already been read. There is only ever one real stdin, so a second\n43:     /// read is refused rather than silently handed nothing, the way a second pass over an\n44:     /// already-consumed iterator would be in a language that let it compile.\n45:     lines_used: &'a Cell<bool>,\n46:     /// The delimiter `dsv` was read with, filled in the first time it is used. `csv`/`tsv`\n47:     /// arrive here with the delimiter already fixed by the parser. A second read of any kind\n48:     /// is refused the same way a second `lines` is.\n49:     dsv: &'a RefCell<Option<String>>,\n50:     /// Whether checking is inside a mapper's body (`map`'s, or `select`'s predicate), which\n51:     /// runs once per element: a source read there would drain stdin on the first element and\n52:     /// hand every later one nothing, so `lines` and `inputs` are refused in that position.\n53:     in_mapper: bool,\n54:     /// The name of the `fn` whose body is being checked; `None` in the program's own body. A\n55:     /// source is legal only in the program body (see `source_in_fn`), so `lines` and `inputs`\n56:     /// are refused whenever this is set.\n57:     in_fn: Option<&'a str>,\n58:     /// Every user function, keyed by name, with the file it was defined in and whether it is\n59:     /// `pub`. A call to a non-`pub` one from a different file than `file` is refused, which is\n60:     /// the visibility rule (gh:166).\n61:     visibility: &'a HashMap<String, (Origin, bool)>,\n62:     /// Which file the code being checked was written in. The program's body and definitions are\n63:     /// `Program`; the prelude's definitions (checked at build time) are `Prelude`.\n64:     file: Origin,\n65:     next_local: &'a Cell<LocalId>,\n66: }\n67: \n68: impl Ctx<'_> {\n69:     fn with(&self, subject: Option<(Type, LocalId)>) -> Ctx<'_> {\n70:         self.rebuild(self.scope.clone(), subject)\n71:     }\n72: \n73:     fn rebuild(\n74:         &self,\n75:         scope: Vec<(String, Type, Option<LocalId>)>,\n76:         subject: Option<(Type, LocalId)>,\n77:     ) -> Ctx<'_> {\n78:         Ctx {\n79:             sigs: self.sigs,\n80:             enums: self.enums,\n81:             variant_owners: self.variant_owners,\n82:             scope,\n83:             arm_fields: self.arm_fields.clone(),\n84:             subject,\n85:             input: self.input,\n86:             inputs: self.inputs,\n87:             lines_used: self.lines_used,\n88:             dsv: self.dsv,\n89:             in_mapper: self.in_mapper,\n90:             in_fn: self.in_fn,\n91:             visibility: self.visibility,\n92:             file: self.file,\n93:             next_local: self.next_local,\n94:         }\n95:     }\n96: \n97:     fn fresh(&self) -> LocalId {\n98:         let id = self.next_local.get();\n99:         self.next_local.set(id + 1);\n100:         id\n101:     }\n102: }\n103: \n104: pub fn check(file: &File) -> Result<tir::Program, Error> {\n105:     let lines_used = Cell::new(false);\n106:     let aliases = alias_map(&file.aliases)?;\n107:     let env = TypeEnv {\n108:         aliases,\n109:         enums: enum_map(&file.enums)?,\n110:     };\n111:     for e in &file.enums {\n112:         if env.aliases.contains_key(&e.name) {\n113:             return Err(Error::new(\n114:                 e.span,\n115:                 format!(\"type `{}` is defined twice\", e.name),\n116:             ));\n117:         }\n118:     }\n119:     // Resolved eagerly so a broken declaration is an error even when nothing uses it, and so a\n120:     // cycle is found here rather than wherever it happened to be reached from.\n121:     for a in &file.aliases {\n122:         resolve(&a.ty, &env, &mut vec![(a.name.clone(), Vec::new())])?;\n123:     }\n124:     let mut enums: HashMap<String, Type> = HashMap::new();\n125:     for e in &file.enums {\n126:         enums.insert(\n127:             e.name.clone(),\n128:             resolve_enum(e, &env, &mut Vec::new(), None)?,\n129:         );\n130:     }\n131:     let mut variant_owners: HashMap<String, Vec<String>> = HashMap::new();\n132:     for e in &file.enums {\n133:         for v in &e.variants {\n134:             variant_owners\n135:                 .entry(v.name.clone())\n136:                 .or_default()\n137:                 .push(e.name.clone());\n138:             // The lowercase spelling is the constructor, the value built right away (gh:156):\n139:             // a bare lowercase variant name resolves to the same owner so it reaches `construct`,\n140:             // which maps it to the declared variant. A declared name already lowercase (the\n141:             // prelude's `Opt`/`Result`) has the same constructor spelling, so pushing again would\n142:             // make one owner look like two.\n143:             let constructor = constructor_of(&v.name);\n144:             if constructor != v.name {\n145:                 variant_owners\n146:                     .entry(constructor)\n147:                     .or_default()\n148:                     .push(e.name.clone());\n149:             }\n150:         }\n151:     }\n152:     let sigs = signatures(&file.defs, &env)?;\n153:     let input = RefCell::new(None);\n154:     // A program's `input <type>` declaration types stdin up front, before the body is read,\n155:     // instead of borrowing the type from the first use of `input`. Resolving it into the same\n156:     // cell the uses read is what lets the annotation and the uses agree on one type, and the\n157:     // wire rules `input_read` applies to a use are applied to a declared type here too: a\n158:     // stream has nothing to decode, absence and Char and Int64 have no ratified wire form.\n159:     if let Some(declared) = &file.input {\n160:         let ty = resolve(declared, &env, &mut Vec::new())?;\n161:         if ty.contains_stream()\n162:             || ty.contains_opt()\n163:             || ty.contains_char()\n164:             || ty.contains_int64()\n165:         {\n166:             return Err(Error::new(\n167:                 declared.span(),\n168:                 format!(\"`input` cannot be declared as {ty}; it has no wire form to read\"),\n169:             ));\n170:         }\n171:         *input.borrow_mut() = Some(ty);\n172:     }\n173:     let inputs = RefCell::new(None);\n174:     let dsv = RefCell::new(None);\n175:     let next_local = Cell::new(0);\n176:     let visibility: HashMap<String, (Origin, bool)> = file\n177:         .defs\n178:         .iter()\n179:         .map(|d| (d.name.clone(), (d.origin, d.is_pub)))\n180:         .collect();\n181:     let ctx = Ctx {\n182:         sigs: &sigs,\n183:         enums: &enums,\n184:         variant_owners: &variant_owners,\n185:         scope: Vec::new(),\n186:         arm_fields: Vec::new(),\n187:         subject: None,\n188:         input: &input,\n189:         inputs: &inputs,\n190:         lines_used: &lines_used,\n191:         dsv: &dsv,\n192:         in_mapper: false,\n193:         in_fn: None,\n194:         visibility: &visibility,\n195:         file: Origin::Program,\n196:         next_local: &next_local,\n197:     };\n198: \n199:     // `prelude::inject` prepended prelude.toy's own defs to `file.defs`, which is what let\n200:     // `sigs` above resolve calls into them and is what catches a program that redefines one --\n201:     // but their bodies were already checked once, at build time (`build.rs`, via\n202:     // `prelude::checked`), and prelude.toy cannot have changed since. Rechecking them here would\n203:     // only repeat that work on every single compile.\n204:     let mut funcs = crate::prelude::checked();\n205:     let precompiled_names: HashSet<String> = funcs.iter().map(|f| f.name.clone()).collect();\n206:     let own_defs = file\n207:         .defs\n208:         .iter()\n209:         .filter(|d| !precompiled_names.contains(&d.name));\n210:     funcs.extend(check_defs(own_defs, &ctx)?);\n211: \n212:     let body = check_program_body(&ctx, &file.body)?;\n213:     // A stream cannot be printed, having nothing to show: it is not a value, and collect() is\n214:     // what turns it into one. A function body catches this for free, since its return\n215:     // annotation can never spell Stream and so can never match a body that contains one; the\n216:     // program's own result has no annotation to check against, so it needs asking directly.\n217:     if body.ty.contains_stream() {\n218:         return Err(Error::new(\n219:             file.body.span(),\n220:             \"the program's result contains a stream, which has nothing to print; pass it to \\\n221:              `collect` first\"\n222:                 .to_string(),\n223:         ));\n224:     }\n225:     // A Char has no wire form (the reverse of `input`'s refusal above), so a program cannot\n226:     // hand one to the printer either -- it has to build a Str first.\n227:     if body.ty.contains_char() {\n228:         return Err(Error::new(\n229:             file.body.span(),\n230:             \"the program's result contains a Char, which has no wire form to print\".to_string(),\n231:         ));\n232:     }\n233:     let input = input.into_inner();\n234:     let inputs = inputs.into_inner();\n235:     // Forced by the backends, not chosen: Python's `input` reads all of stdin to EOF before\n236:     // parsing, leaving nothing for anything else to read afterward, and jq needs a different\n237:     // invocation flag for raw lines (`-R -n`) than for parsed JSON values (`-n` alone) -- one\n238:     // process cannot run with both. So all three ways of reading the same real stdin are\n239:     // mutually exclusive, not just `input` and `lines` as before.\n240:     if input.is_some() && lines_used.get() {\n241:         return Err(Error::new(\n242:             file.body.span(),\n243:             \"a program cannot use both `input` and `lines`; they read the same real stdin two \\\n244:              different ways\"\n245:                 .to_string(),\n246:         ));\n247:     }\n248:     if input.is_some() && inputs.is_some() {\n249:         return Err(Error::new(\n250:             file.body.span(),\n251:             \"a program cannot use both `input` and `inputs`; they read the same real stdin two \\\n252:              different ways\"\n253:                 .to_string(),\n254:         ));\n255:     }\n256:     if lines_used.get() && inputs.is_some() {\n257:         return Err(Error::new(\n258:             file.body.span(),\n259:             \"a program cannot use both `lines` and `inputs`; they read the same real stdin two \\\n260:              different ways\"\n261:                 .to_string(),\n262:         ));\n263:     }\n264:     // `dsv` reads the same raw lines `lines` does, so it joins the same exclusivity: one real\n265:     // stdin, read one way.\n266:     let dsv = dsv.into_inner();\n267:     for (other, name) in [\n268:         (input.is_some(), \"`input`\"),\n269:         (inputs.is_some(), \"`inputs`\"),\n270:         (lines_used.get(), \"`lines`\"),\n271:     ] {\n272:         if dsv.is_some() && other {\n273:             return Err(Error::new(\n274:                 file.body.span(),\n275:                 format!(\n276:                     \"a program cannot use both `dsv` and {name}; they read the same real stdin \\\n277:                      two different ways\"\n278:                 ),\n279:             ));\n280:         }\n281:     }\n282:     Ok(tir::Program {\n283:         funcs: prune_unreachable(funcs, &body),\n284:         body,\n285:         input,\n286:         inputs,\n287:         uses_lines: lines_used.get(),\n288:         dsv,\n289:         enums,\n290:     })\n291: }\n292: \n293: /// Signatures are collected before any body is checked, so a definition may call one that\n294: /// appears later in `defs`. This is also what recursion needs. No reachability pruning happens\n295: /// here: that needs the whole program's body, which `check_module` never has and `check` only\n296: /// gets once this returns, so both call this and prune afterward, over the combined result.\n297: /// `ctx`'s own per-def fields (`scope`, `subject`, `in_fn`, ...) are ignored -- each def gets its\n298: /// own, built from its signature exactly as `check` always has.\n299: fn check_defs<'a>(\n300:     defs: impl IntoIterator<Item = &'a crate::ast::Def>,\n301:     ctx: &Ctx<'a>,\n302: ) -> Result<Vec<tir::Func>, Error> {\n303:     let mut funcs = Vec::new();\n304:     for def in defs {\n305:         let sig = &ctx.sigs[&def.name];\n306:         let scope = match (&def.param, &sig.param) {\n307:             (Some(param), Some(param_ty)) => vec![(param.name.clone(), param_ty.clone(), None)],\n308:             (None, None) => Vec::new(),\n309:             _ => unreachable!(\"a signature's param mirrors its definition's\"),\n310:         };\n311:         let def_ctx = Ctx {\n312:             sigs: ctx.sigs,\n313:             enums: ctx.enums,\n314:             variant_owners: ctx.variant_owners,\n315:             scope,\n316:             arm_fields: Vec::new(),\n317:             subject: None,\n318:             input: ctx.input,\n319:             inputs: ctx.inputs,\n320:             lines_used: ctx.lines_used,\n321:             dsv: ctx.dsv,\n322:             in_mapper: false,\n323:             in_fn: Some(&def.name),\n324:             visibility: ctx.visibility,\n325:             file: ctx.file,\n326:             next_local: ctx.next_local,\n327:         };\n328:         // The declared return type flows into the body, so a form whose type comes from its\n329:         // position (`[]`, `input`, a variant-naming string) resolves against the annotation. A\n330:         // body that synthesises instead is compared below, where the error can name the\n331:         // function rather than just the two types.\n332:         //\n333:         // A function declared `-> Sink` is the other sink position, so its body must be a sink\n334:         // call -- the tail-pipeline `|>` form or a direct call to a sink; nothing else is a\n335:         // sink, and a body that is not one fails here with the declared-vs-found mismatch below\n336:         // naming the function.\n337:         let body = if sig.ret == Type::Sink {\n338:             if matches!(def.body, Expr::TailPipe { .. }) {\n339:                 tail_pipe(&def_ctx, &def.body)?\n340:             } else if let Some(tir) = sink_call(&def_ctx, &def.body)? {\n341:                 tir\n342:             } else {\n343:                 return Err(Error::new(\n344:                     def.body.span(),\n345:                     format!(\n346:                         \"`{}` declares it returns Sink, so its body must be a sink call \\\n347:                          such as `jsonlines(...)` or `x |> jsonlines`\",\n348:                         def.name\n349:                     ),\n350:                 ));\n351:             }\n352:         } else {\n353:             match expect_inner(&def_ctx, &def.body, &sig.ret)? {\n354:                 Expected::Checked(body) => body,\n355:                 Expected::Synthesised(body) => conform(&def_ctx, body, &sig.ret),\n356:             }\n357:         };\n358:         if let Some(param) = &def.param {\n359:             check_param(&body, param, &sig.param, &def.name, def.body.span())?;\n360:         }\n361:         if body.ty != sig.ret {\n362:             return Err(Error::new(\n363:                 def.body.span(),\n364:                 format!(\n365:                     \"`{}` declares it returns {}, but its body is {}\",\n366:                     def.name, sig.ret, body.ty\n367:                 ),\n368:             ));\n369:         }\n370:         funcs.push(tir::Func {\n371:             name: def.name.clone(),\n372:             param: def.param.as_ref().map(|p| p.name.clone()),\n373:             param_ty: sig.param.clone(),\n374:             body,\n375:         });\n376:     }\n377:     Ok(funcs)\n378: }\n379: \n380: /// Checks a module's own `pub` declarations in isolation -- `prelude.toy`'s, at build time\n381: /// (`build.rs`), before there is any file for them to be merged into and nothing yet calling any\n382: /// of it. Every declaration is kept: reachability is the calling file's question, decided once\n383: /// program and prelude are merged (`check` above, via `prune_unreachable`).\n384: pub fn check_module(module: &crate::ast::Module) -> Result<Vec<tir::Func>, Error> {\n385:     let env = TypeEnv {\n386:         aliases: HashMap::new(),\n387:         enums: enum_map(&module.enums)?,\n388:     };\n389:     let mut enums: HashMap<String, Type> = HashMap::new();\n390:     for e in &module.enums {\n391:         enums.insert(\n392:             e.name.clone(),\n393:             resolve_enum(e, &env, &mut Vec::new(), None)?,\n394:         );\n395:     }\n396:     let mut variant_owners: HashMap<String, Vec<String>> = HashMap::new();\n397:     for e in &module.enums {\n398:         for v in &e.variants {\n399:             variant_owners\n400:                 .entry(v.name.clone())\n\n(Showing lines 1-400 of 3239. Use offset=401 to continue.)\n</content>","metadata":{"preview":"use std::cell::{Cell, RefCell};\nuse std::collections::{HashMap, HashSet};\n\nuse crate::ast::{BinOp, Expr, FieldsPattern, File, MatchArm, Origin, Param, Pattern, Span};\nuse crate::error::Error;\nuse crate::tir::{self, Kind, LocalId, Tir};\nuse crate::ty::{self, Sig, Type};\n\nmod linearity;\nmod types;\n\nuse linearity::{StreamBinding, check_linear, field_used, param_used, prune_unreachable};\nuse types::{\n    TypeEnv, alias_map, constructor_of, enum_map, is_constructor_of, matcher_of, resolve,\n    resolve_enum, signatures,\n};\n\nstruct Ctx<'a> {\n    sigs: &'a HashMap<String, Sig>,\n    /// Every declared enum, resolved. Keyed by name, which is the identity.","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-174/src/check/mod.rs","text":"use std::cell::{Cell, RefCell};\nuse std::collections::{HashMap, HashSet};\n\nuse crate::ast::{BinOp, Expr, FieldsPattern, File, MatchArm, Origin, Param, Pattern, Span};\nuse crate::error::Error;\nuse crate::tir::{self, Kind, LocalId, Tir};\nuse crate::ty::{self, Sig, Type};\n\nmod linearity;\nmod types;\n\nuse linearity::{StreamBinding, check_linear, field_used, param_used, prune_unreachable};\nuse types::{\n    TypeEnv, alias_map, constructor_of, enum_map, is_constructor_of, matcher_of, resolve,\n    resolve_enum, signatures,\n};\n\nstruct Ctx<'a> {\n    sigs: &'a HashMap<String, Sig>,\n    /// Every declared enum, resolved. Keyed by name, which is the identity.\n    enums: &'a HashMap<String, Type>,\n    /// Which enums declare each variant name, in declaration order. A bare variant use resolves\n    /// through this while exactly one enum claims the name; two claimants are a loud error\n    /// naming both, with `Shape.circle` as the qualified way out.\n    variant_owners: &'a HashMap<String, Vec<String>>,\n    /// Named bindings, innermost last. A function parameter carries `None` for its local (the\n    /// backends render a param by name); a `let` binding carries the `LocalId` it was bound to,\n    /// so reading the name is reading that local. `let` can stack many of these, and a later one\n    /// shadows an earlier, which is what the reverse search in `synth` is for.\n    scope: Vec<(String, Type, Option<LocalId>)>,\n    /// Names a match arm's record pattern bound, innermost last: reading one reads that field\n    /// off the arm's payload local, so nothing beyond ordinary `Field` nodes reaches the\n    /// backends. Each entry is the bound name, the payload's record type, and its local.\n    arm_fields: Vec<(String, Type, LocalId)>,\n    /// What `.` refers to here, if anything: its type and the local holding it.\n    subject: Option<(Type, LocalId)>,\n    /// The type `input` was checked against, filled in the first time it is used.\n    input: &'a RefCell<Option<Type>>,\n    /// The element type `inputs` was checked against, filled in the first time it is used. A\n    /// separate cell from `input`'s: one records a whole value's type, the other one line's.\n    inputs: &'a RefCell<Option<Type>>,\n    /// Whether `lines` has already been read. There is only ever one real stdin, so a second\n    /// read is refused rather than silently handed nothing, the way a second pass over an\n    /// already-consumed iterator would be in a language that let it compile.\n    lines_used: &'a Cell<bool>,\n    /// The delimiter `dsv` was read with, filled in the first time it is used. `csv`/`tsv`\n    /// arrive here with the delimiter already fixed by the parser. A second read of any kind\n    /// is refused the same way a second `lines` is.\n    dsv: &'a RefCell<Option<String>>,\n    /// Whether checking is inside a mapper's body (`map`'s, or `select`'s predicate), which\n    /// runs once per element: a source read there would drain stdin on the first element and\n    /// hand every later one nothing, so `lines` and `inputs` are refused in that position.\n    in_mapper: bool,\n    /// The name of the `fn` whose body is being checked; `None` in the program's own body. A\n    /// source is legal only in the program body (see `source_in_fn`), so `lines` and `inputs`\n    /// are refused whenever this is set.\n    in_fn: Option<&'a str>,\n    /// Every user function, keyed by name, with the file it was defined in and whether it is\n    /// `pub`. A call to a non-`pub` one from a different file than `file` is refused, which is\n    /// the visibility rule (gh:166).\n    visibility: &'a HashMap<String, (Origin, bool)>,\n    /// Which file the code being checked was written in. The program's body and definitions are\n    /// `Program`; the prelude's definitions (checked at build time) are `Prelude`.\n    file: Origin,\n    next_local: &'a Cell<LocalId>,\n}\n\nimpl Ctx<'_> {\n    fn with(&self, subject: Option<(Type, LocalId)>) -> Ctx<'_> {\n        self.rebuild(self.scope.clone(), subject)\n    }\n\n    fn rebuild(\n        &self,\n        scope: Vec<(String, Type, Option<LocalId>)>,\n        subject: Option<(Type, LocalId)>,\n    ) -> Ctx<'_> {\n        Ctx {\n            sigs: self.sigs,\n            enums: self.enums,\n            variant_owners: self.variant_owners,\n            scope,\n            arm_fields: self.arm_fields.clone(),\n            subject,\n            input: self.input,\n            inputs: self.inputs,\n            lines_used: self.lines_used,\n            dsv: self.dsv,\n            in_mapper: self.in_mapper,\n            in_fn: self.in_fn,\n            visibility: self.visibility,\n            file: self.file,\n            next_local: self.next_local,\n        }\n    }\n\n    fn fresh(&self) -> LocalId {\n        let id = self.next_local.get();\n        self.next_local.set(id + 1);\n        id\n    }\n}\n\npub fn check(file: &File) -> Result<tir::Program, Error> {\n    let lines_used = Cell::new(false);\n    let aliases = alias_map(&file.aliases)?;\n    let env = TypeEnv {\n        aliases,\n        enums: enum_map(&file.enums)?,\n    };\n    for e in &file.enums {\n        if env.aliases.contains_key(&e.name) {\n            return Err(Error::new(\n                e.span,\n                format!(\"type `{}` is defined twice\", e.name),\n            ));\n        }\n    }\n    // Resolved eagerly so a broken declaration is an error even when nothing uses it, and so a\n    // cycle is found here rather than wherever it happened to be reached from.\n    for a in &file.aliases {\n        resolve(&a.ty, &env, &mut vec![(a.name.clone(), Vec::new())])?;\n    }\n    let mut enums: HashMap<String, Type> = HashMap::new();\n    for e in &file.enums {\n        enums.insert(\n            e.name.clone(),\n            resolve_enum(e, &env, &mut Vec::new(), None)?,\n        );\n    }\n    let mut variant_owners: HashMap<String, Vec<String>> = HashMap::new();\n    for e in &file.enums {\n        for v in &e.variants {\n            variant_owners\n                .entry(v.name.clone())\n                .or_default()\n                .push(e.name.clone());\n            // The lowercase spelling is the constructor, the value built right away (gh:156):\n            // a bare lowercase variant name resolves to the same owner so it reaches `construct`,\n            // which maps it to the declared variant. A declared name already lowercase (the\n            // prelude's `Opt`/`Result`) has the same constructor spelling, so pushing again would\n            // make one owner look like two.\n            let constructor = constructor_of(&v.name);\n            if constructor != v.name {\n                variant_owners\n                    .entry(constructor)\n                    .or_default()\n                    .push(e.name.clone());\n            }\n        }\n    }\n    let sigs = signatures(&file.defs, &env)?;\n    let input = RefCell::new(None);\n    // A program's `input <type>` declaration types stdin up front, before the body is read,\n    // instead of borrowing the type from the first use of `input`. Resolving it into the same\n    // cell the uses read is what lets the annotation and the uses agree on one type, and the\n    // wire rules `input_read` applies to a use are applied to a declared type here too: a\n    // stream has nothing to decode, absence and Char and Int64 have no ratified wire form.\n    if let Some(declared) = &file.input {\n        let ty = resolve(declared, &env, &mut Vec::new())?;\n        if ty.contains_stream()\n            || ty.contains_opt()\n            || ty.contains_char()\n            || ty.contains_int64()\n        {\n            return Err(Error::new(\n                declared.span(),\n                format!(\"`input` cannot be declared as {ty}; it has no wire form to read\"),\n            ));\n        }\n        *input.borrow_mut() = Some(ty);\n    }\n    let inputs = RefCell::new(None);\n    let dsv = RefCell::new(None);\n    let next_local = Cell::new(0);\n    let visibility: HashMap<String, (Origin, bool)> = file\n        .defs\n        .iter()\n        .map(|d| (d.name.clone(), (d.origin, d.is_pub)))\n        .collect();\n    let ctx = Ctx {\n        sigs: &sigs,\n        enums: &enums,\n        variant_owners: &variant_owners,\n        scope: Vec::new(),\n        arm_fields: Vec::new(),\n        subject: None,\n        input: &input,\n        inputs: &inputs,\n        lines_used: &lines_used,\n        dsv: &dsv,\n        in_mapper: false,\n        in_fn: None,\n        visibility: &visibility,\n        file: Origin::Program,\n        next_local: &next_local,\n    };\n\n    // `prelude::inject` prepended prelude.toy's own defs to `file.defs`, which is what let\n    // `sigs` above resolve calls into them and is what catches a program that redefines one --\n    // but their bodies were already checked once, at build time (`build.rs`, via\n    // `prelude::checked`), and prelude.toy cannot have changed since. Rechecking them here would\n    // only repeat that work on every single compile.\n    let mut funcs = crate::prelude::checked();\n    let precompiled_names: HashSet<String> = funcs.iter().map(|f| f.name.clone()).collect();\n    let own_defs = file\n        .defs\n        .iter()\n        .filter(|d| !precompiled_names.contains(&d.name));\n    funcs.extend(check_defs(own_defs, &ctx)?);\n\n    let body = check_program_body(&ctx, &file.body)?;\n    // A stream cannot be printed, having nothing to show: it is not a value, and collect() is\n    // what turns it into one. A function body catches this for free, since its return\n    // annotation can never spell Stream and so can never match a body that contains one; the\n    // program's own result has no annotation to check against, so it needs asking directly.\n    if body.ty.contains_stream() {\n        return Err(Error::new(\n            file.body.span(),\n            \"the program's result contains a stream, which has nothing to print; pass it to \\\n             `collect` first\"\n                .to_string(),\n        ));\n    }\n    // A Char has no wire form (the reverse of `input`'s refusal above), so a program cannot\n    // hand one to the printer either -- it has to build a Str first.\n    if body.ty.contains_char() {\n        return Err(Error::new(\n            file.body.span(),\n            \"the program's result contains a Char, which has no wire form to print\".to_string(),\n        ));\n    }\n    let input = input.into_inner();\n    let inputs = inputs.into_inner();\n    // Forced by the backends, not chosen: Python's `input` reads all of stdin to EOF before\n    // parsing, leaving nothing for anything else to read afterward, and jq needs a different\n    // invocation flag for raw lines (`-R -n`) than for parsed JSON values (`-n` alone) -- one\n    // process cannot run with both. So all three ways of reading the same real stdin are\n    // mutually exclusive, not just `input` and `lines` as before.\n    if input.is_some() && lines_used.get() {\n        return Err(Error::new(\n            file.body.span(),\n            \"a program cannot use both `input` and `lines`; they read the same real stdin two \\\n             different ways\"\n                .to_string(),\n        ));\n    }\n    if input.is_some() && inputs.is_some() {\n        return Err(Error::new(\n            file.body.span(),\n            \"a program cannot use both `input` and `inputs`; they read the same real stdin two \\\n             different ways\"\n                .to_string(),\n        ));\n    }\n    if lines_used.get() && inputs.is_some() {\n        return Err(Error::new(\n            file.body.span(),\n            \"a program cannot use both `lines` and `inputs`; they read the same real stdin two \\\n             different ways\"\n                .to_string(),\n        ));\n    }\n    // `dsv` reads the same raw lines `lines` does, so it joins the same exclusivity: one real\n    // stdin, read one way.\n    let dsv = dsv.into_inner();\n    for (other, name) in [\n        (input.is_some(), \"`input`\"),\n        (inputs.is_some(), \"`inputs`\"),\n        (lines_used.get(), \"`lines`\"),\n    ] {\n        if dsv.is_some() && other {\n            return Err(Error::new(\n                file.body.span(),\n                format!(\n                    \"a program cannot use both `dsv` and {name}; they read the same real stdin \\\n                     two different ways\"\n                ),\n            ));\n        }\n    }\n    Ok(tir::Program {\n        funcs: prune_unreachable(funcs, &body),\n        body,\n        input,\n        inputs,\n        uses_lines: lines_used.get(),\n        dsv,\n        enums,\n    })\n}\n\n/// Signatures are collected before any body is checked, so a definition may call one that\n/// appears later in `defs`. This is also what recursion needs. No reachability pruning happens\n/// here: that needs the whole program's body, which `check_module` never has and `check` only\n/// gets once this returns, so both call this and prune afterward, over the combined result.\n/// `ctx`'s own per-def fields (`scope`, `subject`, `in_fn`, ...) are ignored -- each def gets its\n/// own, built from its signature exactly as `check` always has.\nfn check_defs<'a>(\n    defs: impl IntoIterator<Item = &'a crate::ast::Def>,\n    ctx: &Ctx<'a>,\n) -> Result<Vec<tir::Func>, Error> {\n    let mut funcs = Vec::new();\n    for def in defs {\n        let sig = &ctx.sigs[&def.name];\n        let scope = match (&def.param, &sig.param) {\n            (Some(param), Some(param_ty)) => vec![(param.name.clone(), param_ty.clone(), None)],\n            (None, None) => Vec::new(),\n            _ => unreachable!(\"a signature's param mirrors its definition's\"),\n        };\n        let def_ctx = Ctx {\n            sigs: ctx.sigs,\n            enums: ctx.enums,\n            variant_owners: ctx.variant_owners,\n            scope,\n            arm_fields: Vec::new(),\n            subject: None,\n            input: ctx.input,\n            inputs: ctx.inputs,\n            lines_used: ctx.lines_used,\n            dsv: ctx.dsv,\n            in_mapper: false,\n            in_fn: Some(&def.name),\n            visibility: ctx.visibility,\n            file: ctx.file,\n            next_local: ctx.next_local,\n        };\n        // The declared return type flows into the body, so a form whose type comes from its\n        // position (`[]`, `input`, a variant-naming string) resolves against the annotation. A\n        // body that synthesises instead is compared below, where the error can name the\n        // function rather than just the two types.\n        //\n        // A function declared `-> Sink` is the other sink position, so its body must be a sink\n        // call -- the tail-pipeline `|>` form or a direct call to a sink; nothing else is a\n        // sink, and a body that is not one fails here with the declared-vs-found mismatch below\n        // naming the function.\n        let body = if sig.ret == Type::Sink {\n            if matches!(def.body, Expr::TailPipe { .. }) {\n                tail_pipe(&def_ctx, &def.body)?\n            } else if let Some(tir) = sink_call(&def_ctx, &def.body)? {\n                tir\n            } else {\n                return Err(Error::new(\n                    def.body.span(),\n                    format!(\n                        \"`{}` declares it returns Sink, so its body must be a sink call \\\n                         such as `jsonlines(...)` or `x |> jsonlines`\",\n                        def.name\n                    ),\n                ));\n            }\n        } else {\n            match expect_inner(&def_ctx, &def.body, &sig.ret)? {\n                Expected::Checked(body) => body,\n                Expected::Synthesised(body) => conform(&def_ctx, body, &sig.ret),\n            }\n        };\n        if let Some(param) = &def.param {\n            check_param(&body, param, &sig.param, &def.name, def.body.span())?;\n        }\n        if body.ty != sig.ret {\n            return Err(Error::new(\n                def.body.span(),\n                format!(\n                    \"`{}` declares it returns {}, but its body is {}\",\n                    def.name, sig.ret, body.ty\n                ),\n            ));\n        }\n        funcs.push(tir::Func {\n            name: def.name.clone(),\n            param: def.param.as_ref().map(|p| p.name.clone()),\n            param_ty: sig.param.clone(),\n            body,\n        });\n    }\n    Ok(funcs)\n}\n\n/// Checks a module's own `pub` declarations in isolation -- `prelude.toy`'s, at build time\n/// (`build.rs`), before there is any file for them to be merged into and nothing yet calling any\n/// of it. Every declaration is kept: reachability is the calling file's question, decided once\n/// program and prelude are merged (`check` above, via `prune_unreachable`).\npub fn check_module(module: &crate::ast::Module) -> Result<Vec<tir::Func>, Error> {\n    let env = TypeEnv {\n        aliases: HashMap::new(),\n        enums: enum_map(&module.enums)?,\n    };\n    let mut enums: HashMap<String, Type> = HashMap::new();\n    for e in &module.enums {\n        enums.insert(\n            e.name.clone(),\n            resolve_enum(e, &env, &mut Vec::new(), None)?,\n        );\n    }\n    let mut variant_owners: HashMap<String, Vec<String>> = HashMap::new();\n    for e in &module.enums {\n        for v in &e.variants {\n            variant_owners\n                .entry(v.name.clone())","lineStart":1,"lineEnd":400,"totalLines":3239,"truncated":true}},"title":"src/check/mod.rs","time":{"start":1788379858741,"end":1788379858758}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me read the checker module. It's 3239 lines, so I'll read it in chunks. Let me read the beginning to understand the structure.","format":"unknown","index":0}]}},"id":"prt_063bf05b9001BN7RH1qLqz0soO","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","messageID":"msg_063befb3c001LMqgJ0XosGexZu"}}
