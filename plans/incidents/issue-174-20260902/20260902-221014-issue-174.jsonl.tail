  3665 Sep  2 22:10 opt.rs\n-rw-r--r-- 1 kantord kantord  1653 Sep  2 22:10 reductions.rs\ndrwxr-xr-x 1 kantord kantord 22152 Sep  2 22:10 snapshots\n-rw-r--r-- 1 kantord kantord  1149 Sep  2 22:10 step_1.rs\n-rw-r--r-- 1 kantord kantord  1023 Sep  2 22:10 step_2.rs\n-rw-r--r-- 1 kantord kantord  3147 Sep  2 22:10 step_3.rs\n-rw-r--r-- 1 kantord kantord  3450 Sep  2 22:10 step_4.rs\n-rw-r--r-- 1 kantord kantord  4494 Sep  2 22:10 step_5.rs\n-rw-r--r-- 1 kantord kantord  1788 Sep  2 22:10 step_dsv.rs\n-rw-r--r-- 1 kantord kantord 13482 Sep  2 22:10 streaming.rs\n-rw-r--r-- 1 kantord kantord 12289 Sep  2 22:10 streams.rs\ndrwxr-xr-x 1 kantord kantord    12 Sep  2 22:10 support\n-rw-r--r-- 1 kantord kantord  1527 Sep  2 22:10 tag_corpus.rs\n-rw-r--r-- 1 kantord kantord 11359 Sep  2 22:10 type_flow.rs\n-rw-r--r-- 1 kantord kantord  2353 Sep  2 22:10 unused.rs\n-rw-r--r-- 1 kantord kantord  5800 Sep  2 22:10 unwrap.rs\n-rw-r--r-- 1 kantord kantord  1789 Sep  2 22:10 variant_casing.rs\n---\n[package]\nname = \"toylang\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\nanyhow = \"1.0.104\"\ninkwell = { version = \"0.10.0\", features = [\"llvm22-1\"] }\nmlua = { version = \"0.12.0\", features = [\"lua54\", \"vendored\", \"anyhow\"] }\nserde_json = \"1.0.151\"\ntempfile = \"3.27.0\"\nwinnow = \"1.0.4\"\n\n[dev-dependencies]\ninsta = \"1.48.0\"\nserde = { version = \"1.0.229\", features = [\"derive\"] }\nserde_norway = \"0.9.42\"\n\n# build.rs reuses the parser (winnow) to check prelude.toy at build time; see build.rs itself.\n[build-dependencies]\nwinnow = \"1.0.4\"\n\n# The three lints the quality hooks forward; thresholds live in clippy.toml.\n# On in the manifest so plain `cargo clippy` sees them: the Stop hook adds\n# nothing of its own. See plans/quality-practices.md.\n[lints.clippy]\ncognitive_complexity = \"warn\"\ntoo_many_lines = \"warn\"\nfn_params_excessive_bools = \"warn\"\n","exit":0,"truncated":false},"title":"ls -la src/ && echo \"---\" && ls -la te