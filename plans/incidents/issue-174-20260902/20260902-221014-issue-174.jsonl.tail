{"type":"tool_use","timestamp":1788379870579,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"type":"tool","tool":"bash","callID":"chatcmpl-tool-8d31efa5d141a3f4","state":{"status":"completed","input":{"command":"grep -n \"fn binary\\|fn plus\\|fn call\\|fn builtin\\|fn synth\\|fn expect\\|fn conform\\|fn check_program_body\\|fn tail_pipe\\|fn sink_call\\|fn unify\\|fn substitute\\|fn resolve\\b\" src/check/mod.rs src/ty.rs src/check/types.rs"},"output":"src/check/mod.rs:480:fn check_program_body(ctx: &Ctx, body: &Expr) -> Result<Tir, Error> {\nsrc/check/mod.rs:495:fn sink_call(ctx: &Ctx, body: &Expr) -> Result<Option<Tir>, Error> {\nsrc/check/mod.rs:522:fn tail_pipe(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\nsrc/check/mod.rs:603:fn builtin(name: &str) -> Option<(tir::Builtin, Sig)> {\nsrc/check/mod.rs:787:fn call_named<'a>(expr: &'a Expr, name: &str) -> Option<&'a Expr> {\nsrc/check/mod.rs:826:fn unify(template: &Type, concrete: &Type, map: &mut HashMap<String, Type>) -> bool {\nsrc/check/mod.rs:1537:fn synth(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\nsrc/check/mod.rs:1554:fn synth_inner(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\nsrc/check/mod.rs:1918:fn call(\nsrc/check/mod.rs:2038:fn call_arg(\nsrc/check/mod.rs:2539:fn expect_int_width(ctx: &Ctx, rhs: &Expr, width: &Type, op: BinOp) -> Result<Tir, Error> {\nsrc/check/mod.rs:2558:fn binary(ctx: &Ctx, op: BinOp, lhs: &Expr, rhs: &Expr) -> Result<Tir, Error> {\nsrc/check/mod.rs:2663:fn plus(ctx: &Ctx, lhs: &Expr, left: Tir, rhs: &Expr) -> Result<Tir, Error> {\nsrc/check/mod.rs:2709:fn expect(ctx: &Ctx, expr: &Expr, want: &Type) -> Result<Tir, Error> {\nsrc/check/mod.rs:2727:fn conform(ctx: &Ctx, found: Tir, want: &Type) -> Tir {\nsrc/check/mod.rs:3104:fn expect_inner(ctx: &Ctx, expr: &Expr, want: &Type) -> Result<Expected, Error> {\nsrc/ty.rs:391:pub fn substitute(t: &Type, map: &HashMap<String, Type>) -> Type {\nsrc/check/types.rs:322:pub(super) fn resolve(\n","metadata":{"output":"src/check/mod.rs:480:fn check_program_body(ctx: &Ctx, body: &Expr) -> Result<Tir, Error> {\nsrc/check/mod.rs:495:fn sink_call(ctx: &Ctx, body: &Expr) -> Result<Option<Tir>, Error> {\nsrc/check/mod.rs:522:fn tail_pipe(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\nsrc/check/mod.rs:603:fn builtin(name: &str) -> Option<(tir::Builtin, Sig)> {\nsrc/check/mod.rs:787:fn call_named<'a>(expr: &'a Expr, name: &str) -> Option<&'a Expr> {\nsrc/check/mod.rs:826:fn unify(template: &Type, concrete: &Type, map: &mut HashMap<String, Type>) -> bool {\nsrc/check/mod.rs:1537:fn synth(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\nsrc/check/mod.rs:1554:fn synth_inner(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\nsrc/check/mod.rs:1918:fn call(\nsrc/check/mod.rs:2038:fn call_arg(\nsrc/check/mod.rs:2539:fn expect_int_width(ctx: &Ctx, rhs: &Expr, width: &Type, op: BinOp) -> Result<Tir, Error> {\nsrc/check/mod.rs:2558:fn binary(ctx: &Ctx, op: BinOp, lhs: &Expr, rhs: &Expr) -> Result<Tir, Error> {\nsrc/check/mod.rs:2663:fn plus(ctx: &Ctx, lhs: &Expr, left: Tir, rhs: &Expr) -> Result<Tir, Error> {\nsrc/check/mod.rs:2709:fn expect(ctx: &Ctx, expr: &Expr, want: &Type) -> Result<Tir, Error> {\nsrc/check/mod.rs:2727:fn conform(ctx: &Ctx, found: Tir, want: &Type) -> Tir {\nsrc/check/mod.rs:3104:fn expect_inner(ctx: &Ctx, expr: &Expr, want: &Type) -> Result<Expected, Error> {\nsrc/ty.rs:391:pub fn substitute(t: &Type, map: &HashMap<String, Type>) -> Type {\nsrc/check/types.rs:322:pub(super) fn resolve(\n","exit":0,"truncated":false},"title":"grep -n \"fn binary\\|fn plus\\|fn call\\|fn builtin\\|fn synth\\|fn expect\\|fn conform\\|fn check_program_body\\|fn tail_pipe\\|fn sink_call\\|fn unify\\|fn substitute\\|fn resolve\\b\" src/check/mod.rs src/ty.rs src/check/types.rs","time":{"start":1788379870577,"end":1788379870579}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"This is a big task. Let me look at the key areas of the checker: `binary`, `plus`, `call`, and the types module. Let me search for the relevant functions.","format":"unknown","index":0}]}},"id":"prt_063bf23b3001QrB5jpc9zaTccH","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","messageID":"msg_063bf0772001fcFgMemrRCu3UK"}}
{"type":"tool_use","timestamp":1788379871547,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-9fd058e43b4ed3a0","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-174/src/ty.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-174/src/ty.rs</path>\n<type>file</type>\n<content>\n1: use std::collections::HashMap;\n2: \n3: /// Every enum a program declares, resolved once and keyed by name, which is an enum's identity.\n4: ///\n5: /// A `Type::Enum` in hand is not always enough to work from. Where an enum's payload reaches\n6: /// back to itself through a `Vec`, that occurrence carries a placeholder in place of the real\n7: /// variant list (`check::types::resolve_named`, kantord/toylang#76), since expanding it is what\n8: /// has no end. So nothing reads `variants` off a type directly: everything that needs the list\n9: /// asks `variants` below, which re-derives it here, one layer at a time and exactly as deep as\n10: /// the program itself navigates (kantord/toylang#94).\n11: pub type Enums = HashMap<String, Type>;\n12: \n13: #[derive(Debug, Clone)]\n14: pub enum Type {\n15:     Str,\n16:     Int,\n17:     /// A signed 64-bit integer that wraps, `Int`'s rules at twice the width (kantord/toylang#83,\n18:     /// extending ADR 0006). Deliberately a separate type rather than a widening of `Int`:\n19:     /// nothing converts implicitly, so mixing the two demands an explicit `i64(x)`. Literals\n20:     /// carry no suffix -- one that fits `Int` is `Int`, and any literal resolves as `Int64`\n21:     /// wherever one is expected, the `[]` rule applied to numbers. Barred from `input`, like\n22:     /// `Opt`: not because a 64-bit integer has no JSON spelling but because two backends\n23:     /// cannot yet read one faithfully (JS parses numbers into doubles), and that codec design\n24:     /// has not been done.\n25:     Int64,\n26:     /// A double-precision IEEE 754 binary64 float, exactly JavaScript's number (ADR 0007):\n27:     /// no alternative width, no decimal type. Deliberately a separate type from `Int`, and\n28:     /// nothing converts implicitly: a decimal point is the spelling that makes a literal a\n29:     /// Float, and mixing the two in one operator is an error rather than a silent promotion.\n30:     /// Unlike the integer widths, arithmetic on a Float is total -- division by zero returns\n31:     /// Infinity, the IEEE answer, where `Int` stops the program (the Q37 ruling in\n32:     /// plans/questions.md, kantord/toylang#149).\n33:     Float,\n34:     Bool,\n35:     /// A single Unicode scalar value (kantord/toylang#75): never a surrogate half, so a\n36:     /// codepoint outside the Basic Multilingual Plane is one `Char`, on every backend, even\n37:     /// where a backend's own strings need a surrogate pair to spell it. Produced only by\n38:     /// `chars`, which is also the only way one is compared against a boundary -- there is no\n39:     /// literal syntax, so a program spells `'a'` as `chars(\"a\")[0]!`. Barred from `input` (no\n40:     /// wire form to read one from) and from the program's own printed result (no wire form to\n41:     /// write one either); everywhere else -- function signatures, records, a `Vec<Char>` --\n42:     /// it is an ordinary type.\n43:     Char,\n44:     Vec(Box<Type>),\n45:     /// Fields in declaration order. Order is not part of the type's identity (kantord/toylang#60:\n46:     /// `{a: Int, b: Int}` and `{b: Int, a: Int}` are one type, so `PartialEq` below compares the\n47:     /// field set, not the spelling), but it survives as metadata on every concrete value: a\n48:     /// literal's own written order is what it prints in on every backend and what the\n49:     /// native/Go column layouts key on. Whichever type a value is checked against is the order\n50:     /// it ends up carrying (`check::reorder_record` rebuilds a value that arrives shuffled), so\n51:     /// two differently-ordered values only coexist when nothing ever placed them in the same\n52:     /// checked position.\n53:     Record(Vec<(String, Type)>),\n54:     /// Effect-layer multiplicity: the entries arrive one at a time as evaluation proceeds, and\n55:     /// no stream object ever exists as a value (ADR 0001). Spellable in function signatures,\n56:     /// and only there -- the type grammar refuses it inside a Vec, a record, or another Stream\n57:     /// -- born at a source (`lines` is `Stream<Str>`), consumed exactly once per binding, and\n58:     /// exiting only through `collect`.\n59:     Stream(Box<Type>),\n60:     /// A sink: an expression that writes rather than producing a value, of which the only\n61:     /// instance today is the `jsonlines` builtin (gh:138 ruling). Second-class by construction,\n62:     /// the same way a `Stream` is -- a sink is not a value, so it never sits inside a Vec, a\n63:     /// record, a Stream, or an enum payload, and it is never a parameter -- with the position\n64:     /// rules stated once generally in the checker rather than hand-checked per builtin: a\n65:     /// `Sink` is legal only as the program's outermost expression or as a `Sink`-returning\n66:     /// function's body. A function may declare it as its return type and nothing else.\n67:     Sink,\n68:     /// A declared enum: nominal, so the name is the identity. A name (and, for a generic enum,\n69:     /// its arguments) determines the variants within a program, so `PartialEq` below compares\n70:     /// only those and not `variants` itself -- which matters because a self-referential enum's\n71:     /// own payload carries a placeholder here in place of the real list\n72:     /// (`check::types::resolve_named`, kantord/toylang#76) rather than the list every other\n73:     /// occurrence of the same name carries. A variant's payload is `None` for a unit variant,\n74:     /// in declaration order.\n75:     ///\n76:     /// The list riding along is a convenience, not the source of truth: read it and a\n77:     /// placeholder reads as an enum with no variants at all, which is how a nested recursive\n78:     /// value used to reach every backend's printer as something it could not render\n79:     /// (kantord/toylang#94). Ask `variants` instead.\n80:     Enum {\n81:         name: String,\n82:         /// The type arguments this instantiation was built with, in declaration order; empty\n83:         /// for an enum declared without parameters. Part of the identity: `Pair<Int>` and\n84:         /// `Pair<Str>` are different types even though both are `Pair`.\n85:         args: Vec<Type>,\n86:         variants: Vec<(String, Option<Type>)>,\n87:     },\n88:     /// A type parameter inside a generic enum's registry template, standing for whatever a\n89:     /// use site will supply. Never the type of any checked expression: instantiation\n90:     /// substitutes every one away before a type leaves resolution.\n91:     Param(String),\n92: }\n93: \n94: /// Names reserved for the built-in type constructors, on top of `Str`/`Int`/`Bool`\n95: /// (`Type::from_name`): a program cannot declare an alias or enum under any of these.\n96: const RESERVED_TYPE_NAMES: [&str; 2] = [\"Vec\", \"Stream\"];\n97: \n98: /// Whether `name` is a built-in type and so cannot be redefined as an alias or an enum.\n99: pub fn is_builtin_type_name(name: &str) -> bool {\n100:     Type::from_name(name).is_some() || RESERVED_TYPE_NAMES.contains(&name)\n101: }\n102: \n103: /// Whether `name` is one of the built-in type constructors with its own `TypeExpr` node.\n104: /// `Opt` is no longer here: it is the prelude's enum, reached through the ordinary generic\n105: /// path like any declared name.\n106: pub fn takes_type_arg(name: &str) -> bool {\n107:     matches!(name, \"Vec\" | \"Stream\")\n108: }\n109: \n110: impl Type {\n111:     pub fn from_name(name: &str) -> Option<Type> {\n112:         match name {\n113:             \"Str\" => Some(Type::Str),\n114:             \"Int\" => Some(Type::Int),\n115:             \"Int64\" => Some(Type::Int64),\n116:             \"Float\" => Some(Type::Float),\n117:             \"Bool\" => Some(Type::Bool),\n118:             \"Char\" => Some(Type::Char),\n119:             \"Sink\" => Some(Type::Sink),\n120:             _ => None,\n121:         }\n122:     }\n123: \n124:     /// Whether `ty` could hold a stream anywhere inside it -- through a Vec or a record\n125:     /// field. A stream cannot be printed, so this is what the checker asks before letting a\n126:     /// type become the program's final result.\n127:     pub fn contains_stream(&self) -> bool {\n128:         match self {\n129:             Type::Stream(_) => true,\n130:             Type::Vec(t) => t.contains_stream(),\n131:             Type::Record(fields) => fields.iter().any(|(_, t)| t.contains_stream()),\n132:             // An enum payload cannot hold a stream: resolve_enum refuses the declaration,\n133:             // and instantiation refuses a stream as a type argument.\n134:             _ => false,\n135:         }\n136:     }\n137: \n138:     /// Whether `ty` is a sink or holds one anywhere inside it. A sink is not a value, so no\n139:     /// constructed type may contain one; the type grammar refuses every spelling of `Vec<Sink>`,\n140:     /// a record field, a Stream of one, and an enum payload, and the checker's one general\n141:     /// position rule refuses a bare `Sink` anywhere but a sink position.\n142:     pub fn contains_sink(&self) -> bool {\n143:         match self {\n144:             Type::Sink => true,\n145:             Type::Vec(t) | Type::Stream(t) => t.contains_sink(),\n146:             Type::Record(fields) => fields.iter().any(|(_, t)| t.contains_sink()),\n147:             Type::Enum { args, variants, .. } => {\n148:                 args.iter().any(Type::contains_sink)\n149:                     || variants\n150:                         .iter()\n151:                         .any(|(_, p)| p.as_ref().is_some_and(Type::contains_sink))\n152:             }\n153:             _ => false,\n154:         }\n155:     }\n156: \n157:     pub fn elem(&self) -> Option<&Type> {\n158:         match self {\n159:             Type::Vec(t) => Some(t),\n160:             _ => None,\n161:         }\n162:     }\n163: \n164:     pub fn field(&self, name: &str) -> Option<&Type> {\n165:         match self {\n166:             Type::Record(fields) => fields.iter().find(|(n, _)| n == name).map(|(_, t)| t),\n167:             _ => None,\n168:         }\n169:     }\n170: \n171:     /// The prelude's `Opt<T>`, and what its `T` is. The name test is sound because `Opt` is\n172:     /// the prelude's declaration and a program redeclaring it is a duplicate-type error, so\n173:     /// no other enum can carry the name. This is what every place that used to match the\n174:     /// built-in `Type::Opt` keys on now: the unwrap operator, the producers' wrapping, and\n175:     /// the printers' bare-value-or-null serialization rule.\n176:     pub fn as_opt(&self) -> Option<&Type> {\n177:         match self {\n178:             Type::Enum { name, args, .. } if name == \"Opt\" && args.len() == 1 => Some(&args[0]),\n179:             _ => None,\n180:         }\n181:     }\n182: \n183:     /// Whether `Opt` appears anywhere in this type. What the checker asks of an input type:\n184:     /// absence has no ratified wire form (`null` reading as `none` is codec design nobody has\n185:     /// done), so an input cannot be Opt-typed anywhere in its shape.\n186:     pub fn contains_opt(&self) -> bool {\n187:         if self.as_opt().is_some() {\n188:             return true;\n189:         }\n190:         match self {\n191:             Type::Vec(t) | Type::Stream(t) => t.contains_opt(),\n192:             Type::Record(fields) => fields.iter().any(|(_, t)| t.contains_opt()),\n193:             Type::Enum { args, variants, .. } => {\n194:                 args.iter().any(Type::contains_opt)\n195:                     || variants\n196:                         .iter()\n197:                         .any(|(_, p)| p.as_ref().is_some_and(Type::contains_opt))\n198:             }\n199:             _ => false,\n200:         }\n201:     }\n202: \n203:     /// Whether `Int64` appears anywhere in this type. What the checker asks of an input type:\n204:     /// unlike `Char` this is one-directional -- an `Int64` result prints fine on every backend\n205:     /// -- but reading one back is codec design nobody has done (JS parses JSON numbers into\n206:     /// doubles and loses exactness past 2^53), so `input` refuses it, the same reversible\n207:     /// direction `contains_opt` takes for absence.\n208:     pub fn contains_int64(&self) -> bool {\n209:         match self {\n210:             Type::Int64 => true,\n211:             Type::Vec(t) | Type::Stream(t) => t.contains_int64(),\n212:             Type::Record(fields) => fields.iter().any(|(_, t)| t.contains_int64()),\n213:             Type::Enum { args, variants, .. } => {\n214:                 args.iter().any(Type::contains_int64)\n215:                     || variants\n216:                         .iter()\n217:                         .any(|(_, p)| p.as_ref().is_some_and(Type::contains_int64))\n218:             }\n219:             _ => false,\n220:         }\n221:     }\n222: \n223:     /// Whether `Char` appears anywhere in this type. What the checker asks of both `input`'s\n224:     /// type and the program's own printed result: neither has a wire form for a bare Unicode\n225:     /// scalar value, so both refuse it, the same reasoning `contains_opt` states for absence.\n226:     pub fn contains_char(&self) -> bool {\n227:         match self {\n228:             Type::Char => true,\n229:             Type::Vec(t) | Type::Stream(t) => t.contains_char(),\n230:             Type::Record(fields) => fields.iter().any(|(_, t)| t.contains_char()),\n231:             Type::Enum { args, variants, .. } => {\n232:                 args.iter().any(Type::contains_char)\n233:                     || variants\n234:                         .iter()\n235:                         .any(|(_, p)| p.as_ref().is_some_and(Type::contains_char))\n236:             }\n237:             _ => false,\n238:         }\n239:     }\n240: \n241:     /// Whether a `Vec` appears anywhere in this type. What the checker asks of a comparison's\n242:     /// operands: an operator applied to a Vec is Q2 -- broadcast, zip, or whole-value -- and Q2\n243:     /// is open, so a Vec reached through a record field or an enum payload is refused for the\n244:     /// same reason a bare one is, rather than being handed whole-value equality by the back\n245:     /// door (kantord/toylang#95).\n246:     pub fn contains_vec(&self) -> bool {\n247:         match self {\n248:             Type::Vec(_) | Type::Stream(_) => true,\n249:             Type::Record(fields) => fields.iter().any(|(_, t)| t.contains_vec()),\n250:             Type::Enum { args, variants, .. } => {\n251:                 args.iter().any(Type::contains_vec)\n252:                     || variants\n253:                         .iter()\n254:                         .any(|(_, p)| p.as_ref().is_some_and(Type::contains_vec))\n255:             }\n256:             _ => false,\n257:         }\n258:     }\n259: \n260:     /// Whether a value of this type has an interior to walk. Equality on one is structural on\n261:     /// every backend (kantord/toylang#68), which four of them need spelled out because their\n262:     /// native `==` on the runtime shape means identity or compares a payload pointer.\n263:     pub fn is_composite(&self) -> bool {\n264:         matches!(self, Type::Record(_) | Type::Enum { .. })\n265:     }\n266: \n267:     /// A deterministic identifier fragment for this type, for backends whose targets are\n268:     /// nominally typed: `Pair<Int>` and `Pair<Str>` must become distinct emitted types, so\n269:     /// their names embed the arguments (`Pair_Int`). Record fields sort by name, because\n270:     /// field order is not part of a record type's identity (kantord/toylang#60). An enum\n271:     /// declared without parameters keeps its bare name, which is what every existing\n272:     /// snapshot pins.\n273:     pub fn ident(&self) -> String {\n274:         match self {\n275:             Type::Str => \"Str\".to_string(),\n276:             Type::Int => \"Int\".to_string(),\n277:             Type::Int64 => \"Int64\".to_string(),\n278:             Type::Float => \"Float\".to_string(),\n279:             Type::Bool => \"Bool\".to_string(),\n280:             Type::Char => \"Char\".to_string(),\n281:             Type::Vec(t) => format!(\"Vec_{}\", t.ident()),\n282:             Type::Stream(t) => format!(\"Stream_{}\", t.ident()),\n283:             Type::Sink => \"Sink\".to_string(),\n284:             Type::Record(fields) => {\n285:                 let mut parts: Vec<String> = fields\n286:                     .iter()\n287:                     .map(|(n, t)| format!(\"{n}_{}\", t.ident()))\n288:                     .collect();\n289:                 parts.sort();\n290:                 format!(\"R_{}\", parts.join(\"_\"))\n291:             }\n292:             Type::Enum { name, args, .. } => {\n293:                 if args.is_empty() {\n294:                     name.clone()\n295:                 } else {\n296:                     let parts: Vec<String> = args.iter().map(Type::ident).collect();\n297:                     format!(\"{name}_{}\", parts.join(\"_\"))\n298:                 }\n299:             }\n300:             Type::Param(_) => unreachable!(\"params are substituted before any backend runs\"),\n301:         }\n302:     }\n303: \n304:     /// The name of `self`'s own printer function, shared by every backend that emits one\n305:     /// (kantord/toylang#94). Go camel-cases its own variant at the call site.\n306:     pub fn show_fn(&self) -> String {\n307:         format!(\"tl_show_{}\", self.ident())\n308:     }\n309: }\n310: \n311: impl std::fmt::Display for Type {\n312:     fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n313:         match self {\n314:             Type::Stream(t) => write!(f, \"Stream<{t}>\"),\n315:             Type::Sink => write!(f, \"Sink\"),\n316:             Type::Str => write!(f, \"Str\"),\n317:             Type::Int => write!(f, \"Int\"),\n318:             Type::Int64 => write!(f, \"Int64\"),\n319:             Type::Float => write!(f, \"Float\"),\n320:             Type::Bool => write!(f, \"Bool\"),\n321:             Type::Char => write!(f, \"Char\"),\n322:             Type::Vec(t) => write!(f, \"Vec<{t}>\"),\n323:             Type::Record(fields) => {\n324:                 let parts: Vec<String> = fields.iter().map(|(n, t)| format!(\"{n}: {t}\")).collect();\n325:                 write!(f, \"{{{}}}\", parts.join(\", \"))\n326:             }\n327:             // The name is the identity, so the name is the display: spelling the variants out\n328:             // would print the definition where the reader wants the reference.\n329:             Type::Enum { name, args, .. } => {\n330:                 write!(f, \"{name}\")?;\n331:                 if !args.is_empty() {\n332:                     let parts: Vec<String> = args.iter().map(|a| a.to_string()).collect();\n333:                     write!(f, \"<{}>\", parts.join(\", \"))?;\n334:                 }\n335:                 Ok(())\n336:             }\n337:             Type::Param(name) => write!(f, \"{name}\"),\n338:         }\n339:     }\n340: }\n341: \n342: impl PartialEq for Type {\n343:     /// Structural equality, except `Record`: its fields compare as a set, keyed by name and\n344:     /// type, ignoring position (kantord/toylang#60). A record's own field order is real data --\n345:     /// it drives printing and backend column layout -- but it is not part of what makes two\n346:     /// types the same type.\n347:     ///\n348:     /// `Enum` compares `name` and `args` only, not `variants`: those two already determine the\n349:     /// variant list within one program (a redeclaration is refused, and an instantiation's\n350:     /// payloads are `args` substituted into the one declaration), so comparing `variants` too\n351:     /// would be redundant on every ordinary type and actively wrong on a self-referential one,\n352:     /// whose nested occurrence of itself carries a placeholder rather than the list every other\n353:     /// occurrence of the same name carries (kantord/toylang#76).\n354:     fn eq(&self, other: &Self) -> bool {\n355:         match (self, other) {\n356:             (Type::Str, Type::Str)\n357:             | (Type::Int, Type::Int)\n358:             | (Type::Int64, Type::Int64)\n359:             | (Type::Float, Type::Float)\n360:             | (Type::Bool, Type::Bool)\n361:             | (Type::Char, Type::Char) => true,\n362:             (Type::Vec(a), Type::Vec(b)) => a == b,\n363:             (Type::Stream(a), Type::Stream(b)) => a == b,\n364:             (Type::Sink, Type::Sink) => true,\n365:             (Type::Record(a), Type::Record(b)) => {\n366:                 a.len() == b.len() && a.iter().all(|field| b.contains(field))\n367:             }\n368:             (\n369:                 Type::Enum {\n370:                     name: n1, args: a1, ..\n371:                 },\n372:                 Type::Enum {\n373:                     name: n2, args: a2, ..\n374:                 },\n375:             ) => n1 == n2 && a1 == a2,\n376:             (Type::Param(a), Type::Param(b)) => a == b,\n377:             _ => false,\n378:         }\n379:     }\n380: }\n381: \n382: /// A function takes at most one parameter; `None` is a nullary function.\n383: #[derive(Debug, Clone)]\n384: pub struct Sig {\n385:     pub param: Option<Type>,\n386:     pub ret: Type,\n387: }\n388: \n389: /// Replace every `Type::Param` in `t` with its binding. Together with the checker's `unify`,\n390: /// this is the whole of generic instantiation: nothing else ever sees a parameter.\n391: pub fn substitute(t: &Type, map: &HashMap<String, Type>) -> Type {\n392:     match t {\n393:         Type::Param(p) => map\n394:             .get(p)\n395:             .cloned()\n396:             .unwrap_or_else(|| unreachable!(\"substitute runs only once every param is bound\")),\n397:         Type::Vec(e) => Type::Vec(Box::new(substitute(e, map))),\n398:         Type::Stream(e) => Type::Stream(Box::new(substitute(e, map))),\n399:         Type::Record(fields) => Type::Record(\n400:             fields\n401:                 .iter()\n402:                 .map(|(n, t)| (n.clone(), substitute(t, map)))\n403:                 .collect(),\n404:         ),\n405:         Type::Enum {\n406:             name,\n407:             args,\n408:             variants,\n409:         } => Type::Enum {\n410:             name: name.clone(),\n411:             args: args.iter().map(|a| substitute(a, map)).collect(),\n412:             variants: variants\n413:                 .iter()\n414:                 .map(|(n, p)| (n.clone(), p.as_ref().map(|p| substitute(p, map))))\n415:                 .collect(),\n416:         },\n417:         Type::Str | Type::Int | Type::Int64 | Type::Float | Type::Bool | Type::Char | Type::Sink => {\n418:             t.clone()\n419:         }\n420:     }\n421: }\n422: \n423: /// `name`'s variant list at `args`, re-derived from the registry rather than trusted from\n424: /// whichever `Type::Enum` a caller happened to be holding. One layer deep: a payload that is\n425: /// itself the same enum comes back carrying the placeholder in turn, so asking again is what\n426: /// descends, and nothing tries to build a list that has no bottom.\n427: pub fn variants_of(enums: &Enums, name: &str, args: &[Type]) -> Vec<(String, Option<Type>)> {\n428:     let Type::Enum {\n429:         args: template_args,\n430:         variants,\n431:         ..\n432:     } = &enums[name]\n433:     else {\n434:         unreachable!(\"the registry holds enum types\")\n435:     };\n436:     if template_args.is_empty() {\n437:         return variants.clone();\n438:     }\n439:     let bindings: HashMap<String, Type> = template_args\n440:         .iter()\n441:         .zip(args)\n442:         .filter_map(|(p, a)| match p {\n443:             Type::Param(p) => Some((p.clone(), a.clone())),\n444:             _ => None,\n445:         })\n446:         .collect();\n447:     variants\n448:         .iter()\n449:         .map(|(n, p)| (n.clone(), p.as_ref().map(|t| substitute(t, &bindings))))\n450:         .collect()\n451: }\n452: \n453: /// `variants_of` for an enum type in hand.\n454: pub fn variants(enums: &Enums, ty: &Type) -> Vec<(String, Option<Type>)> {\n455:     let Type::Enum { name, args, .. } = ty else {\n456:         unreachable!(\"only an enum has variants\")\n457:     };\n458:     variants_of(enums, name, args)\n459: }\n460: \n461: /// Whether a value of this enum type can hold another of the same type, however deep.\n462: ///\n463: /// Always through a `Vec`, since that is the only self-reference the checker allows, but not\n464: /// always directly: the path can run through a record field or a second enum. What it decides\n465: /// is whether a backend may expand this type inline -- a printer, a parser, a declaration\n466: /// written by walking the payloads -- or has to emit a named function it can call back into.\n467: /// Expanding a recursive one inline does not terminate.\n468: pub fn is_recursive(enums: &Enums, ty: &Type) -> bool {\n469:     fn reaches(enums: &Enums, from: &Type, target: &Type, seen: &mut Vec<Type>) -> bool {\n470:         match from {\n471:             Type::Vec(e) | Type::Stream(e) => reaches(enums, e, target, seen),\n472:             Type::Record(fields) => fields.iter().any(|(_, t)| reaches(enums, t, target, seen)),\n473:             Type::Enum { name, args, .. } => {\n474:                 if from == target {\n475:                     return true;\n476:                 }\n477:                 if seen.contains(from) {\n478:                     return false;\n479:                 }\n480:                 seen.push(from.clone());\n481:                 args.iter().any(|a| reaches(enums, a, target, seen))\n482:                     || variants_of(enums, name, args)\n483:                         .iter()\n484:                         .any(|(_, p)| p.as_ref().is_some_and(|p| reaches(enums, p, target, seen)))\n485:             }\n486:             _ => false,\n487:         }\n488:     }\n489:     if !matches!(ty, Type::Enum { .. }) {\n490:         return false;\n491:     }\n492:     let mut seen = vec![ty.clone()];\n493:     variants(enums, ty)\n494:         .iter()\n495:         .any(|(_, p)| p.as_ref().is_some_and(|p| reaches(enums, p, ty, &mut seen)))\n496: }\n\n(End of file - total 496 lines)\n</content>","metadata":{"preview":"use std::collections::HashMap;\n\n/// Every enum a program declares, resolved once and keyed by name, which is an enum's identity.\n///\n/// A `Type::Enum` in hand is not always enough to work from. Where an enum's payload reaches\n/// back to itself through a `Vec`, that occurrence carries a placeholder in place of the real\n/// variant list (`check::types::resolve_named`, kantord/toylang#76), since expanding it is what\n/// has no end. So nothing reads `variants` off a type directly: everything that needs the list\n/// asks `variants` below, which re-derives it here, one layer at a time and exactly as deep as\n/// the program itself navigates (kantord/toylang#94).\npub type Enums = HashMap<String, Type>;\n\n#[derive(Debug, Clone)]\npub enum Type {\n    Str,\n    Int,\n    /// A signed 64-bit integer that wraps, `Int`'s rules at twice the width (kantord/toylang#83,\n    /// extending ADR 0006). Deliberately a separate type rather than a widening of `Int`:\n    /// nothing converts implicitly, so mixing the two demands an explicit `i64(x)`. Literals\n    /// carry no suffix -- one that fits `Int` is `Int`, and any literal resolves as `Int64`","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-174/src/ty.rs","text":"use std::collections::HashMap;\n\n/// Every enum a program declares, resolved once and keyed by name, which is an enum's identity.\n///\n/// A `Type::Enum` in hand is not always enough to work from. Where an enum's payload reaches\n/// back to itself through a `Vec`, that occurrence carries a placeholder in place of the real\n/// variant list (`check::types::resolve_named`, kantord/toylang#76), since expanding it is what\n/// has no end. So nothing reads `variants` off a type directly: everything that needs the list\n/// asks `variants` below, which re-derives it here, one layer at a time and exactly as deep as\n/// the program itself navigates (kantord/toylang#94).\npub type Enums = HashMap<String, Type>;\n\n#[derive(Debug, Clone)]\npub enum Type {\n    Str,\n    Int,\n    /// A signed 64-bit integer that wraps, `Int`'s rules at twice the width (kantord/toylang#83,\n    /// extending ADR 0006). Deliberately a separate type rather than a widening of `Int`:\n    /// nothing converts implicitly, so mixing the two demands an explicit `i64(x)`. Literals\n    /// carry no suffix -- one that fits `Int` is `Int`, and any literal resolves as `Int64`\n    /// wherever one is expected, the `[]` rule applied to numbers. Barred from `input`, like\n    /// `Opt`: not because a 64-bit integer has no JSON spelling but because two backends\n    /// cannot yet read one faithfully (JS parses numbers into doubles), and that codec design\n    /// has not been done.\n    Int64,\n    /// A double-precision IEEE 754 binary64 float, exactly JavaScript's number (ADR 0007):\n    /// no alternative width, no decimal type. Deliberately a separate type from `Int`, and\n    /// nothing converts implicitly: a decimal point is the spelling that makes a literal a\n    /// Float, and mixing the two in one operator is an error rather than a silent promotion.\n    /// Unlike the integer widths, arithmetic on a Float is total -- division by zero returns\n    /// Infinity, the IEEE answer, where `Int` stops the program (the Q37 ruling in\n    /// plans/questions.md, kantord/toylang#149).\n    Float,\n    Bool,\n    /// A single Unicode scalar value (kantord/toylang#75): never a surrogate half, so a\n    /// codepoint outside the Basic Multilingual Plane is one `Char`, on every backend, even\n    /// where a backend's own strings need a surrogate pair to spell it. Produced only by\n    /// `chars`, which is also the only way one is compared against a boundary -- there is no\n    /// literal syntax, so a program spells `'a'` as `chars(\"a\")[0]!`. Barred from `input` (no\n    /// wire form to read one from) and from the program's own printed result (no wire form to\n    /// write one either); everywhere else -- function signatures, records, a `Vec<Char>` --\n    /// it is an ordinary type.\n    Char,\n    Vec(Box<Type>),\n    /// Fields in declaration order. Order is not part of the type's identity (kantord/toylang#60:\n    /// `{a: Int, b: Int}` and `{b: Int, a: Int}` are one type, so `PartialEq` below compares the\n    /// field set, not the spelling), but it survives as metadata on every concrete value: a\n    /// literal's own written order is what it prints in on every backend and what the\n    /// native/Go column layouts key on. Whichever type a value is checked against is the order\n    /// it ends up carrying (`check::reorder_record` rebuilds a value that arrives shuffled), so\n    /// two differently-ordered values only coexist when nothing ever placed them in the same\n    /// checked position.\n    Record(Vec<(String, Type)>),\n    /// Effect-layer multiplicity: the entries arrive one at a time as evaluation proceeds, and\n    /// no stream object ever exists as a value (ADR 0001). Spellable in function signatures,\n    /// and only there -- the type grammar refuses it inside a Vec, a record, or another Stream\n    /// -- born at a source (`lines` is `Stream<Str>`), consumed exactly once per binding, and\n    /// exiting only through `collect`.\n    Stream(Box<Type>),\n    /// A sink: an expression that writes rather than producing a value, of which the only\n    /// instance today is the `jsonlines` builtin (gh:138 ruling). Second-class by construction,\n    /// the same way a `Stream` is -- a sink is not a value, so it never sits inside a Vec, a\n    /// record, a Stream, or an enum payload, and it is never a parameter -- with the position\n    /// rules stated once generally in the checker rather than hand-checked per builtin: a\n    /// `Sink` is legal only as the program's outermost expression or as a `Sink`-returning\n    /// function's body. A function may declare it as its return type and nothing else.\n    Sink,\n    /// A declared enum: nominal, so the name is the identity. A name (and, for a generic enum,\n    /// its arguments) determines the variants within a program, so `PartialEq` below compares\n    /// only those and not `variants` itself -- which matters because a self-referential enum's\n    /// own payload carries a placeholder here in place of the real list\n    /// (`check::types::resolve_named`, kantord/toylang#76) rather than the list every other\n    /// occurrence of the same name carries. A variant's payload is `None` for a unit variant,\n    /// in declaration order.\n    ///\n    /// The list riding along is a convenience, not the source of truth: read it and a\n    /// placeholder reads as an enum with no variants at all, which is how a nested recursive\n    /// value used to reach every backend's printer as something it could not render\n    /// (kantord/toylang#94). Ask `variants` instead.\n    Enum {\n        name: String,\n        /// The type arguments this instantiation was built with, in declaration order; empty\n        /// for an enum declared without parameters. Part of the identity: `Pair<Int>` and\n        /// `Pair<Str>` are different types even though both are `Pair`.\n        args: Vec<Type>,\n        variants: Vec<(String, Option<Type>)>,\n    },\n    /// A type parameter inside a generic enum's registry template, standing for whatever a\n    /// use site will supply. Never the type of any checked expression: instantiation\n    /// substitutes every one away before a type leaves resolution.\n    Param(String),\n}\n\n/// Names reserved for the built-in type constructors, on top of `Str`/`Int`/`Bool`\n/// (`Type::from_name`): a program cannot declare an alias or enum under any of these.\nconst RESERVED_TYPE_NAMES: [&str; 2] = [\"Vec\", \"Stream\"];\n\n/// Whether `name` is a built-in type and so cannot be redefined as an alias or an enum.\npub fn is_builtin_type_name(name: &str) -> bool {\n    Type::from_name(name).is_some() || RESERVED_TYPE_NAMES.contains(&name)\n}\n\n/// Whether `name` is one of the built-in type constructors with its own `TypeExpr` node.\n/// `Opt` is no longer here: it is the prelude's enum, reached through the ordinary generic\n/// path like any declared name.\npub fn takes_type_arg(name: &str) -> bool {\n    matches!(name, \"Vec\" | \"Stream\")\n}\n\nimpl Type {\n    pub fn from_name(name: &str) -> Option<Type> {\n        match name {\n            \"Str\" => Some(Type::Str),\n            \"Int\" => Some(Type::Int),\n            \"Int64\" => Some(Type::Int64),\n            \"Float\" => Some(Type::Float),\n            \"Bool\" => Some(Type::Bool),\n            \"Char\" => Some(Type::Char),\n            \"Sink\" => Some(Type::Sink),\n            _ => None,\n        }\n    }\n\n    /// Whether `ty` could hold a stream anywhere inside it -- through a Vec or a record\n    /// field. A stream cannot be printed, so this is what the checker asks before letting a\n    /// type become the program's final result.\n    pub fn contains_stream(&self) -> bool {\n        match self {\n            Type::Stream(_) => true,\n            Type::Vec(t) => t.contains_stream(),\n            Type::Record(fields) => fields.iter().any(|(_, t)| t.contains_stream()),\n            // An enum payload cannot hold a stream: resolve_enum refuses the declaration,\n            // and instantiation refuses a stream as a type argument.\n            _ => false,\n        }\n    }\n\n    /// Whether `ty` is a sink or holds one anywhere inside it. A sink is not a value, so no\n    /// constructed type may contain one; the type grammar refuses every spelling of `Vec<Sink>`,\n    /// a record field, a Stream of one, and an enum payload, and the checker's one general\n    /// position rule refuses a bare `Sink` anywhere but a sink position.\n    pub fn contains_sink(&self) -> bool {\n        match self {\n            Type::Sink => true,\n            Type::Vec(t) | Type::Stream(t) => t.contains_sink(),\n            Type::Record(fields) => fields.iter().any(|(_, t)| t.contains_sink()),\n            Type::Enum { args, variants, .. } => {\n                args.iter().any(Type::contains_sink)\n                    || variants\n                        .iter()\n                        .any(|(_, p)| p.as_ref().is_some_and(Type::contains_sink))\n            }\n            _ => false,\n        }\n    }\n\n    pub fn elem(&self) -> Option<&Type> {\n        match self {\n            Type::Vec(t) => Some(t),\n            _ => None,\n        }\n    }\n\n    pub fn field(&self, name: &str) -> Option<&Type> {\n        match self {\n            Type::Record(fields) => fields.iter().find(|(n, _)| n == name).map(|(_, t)| t),\n            _ => None,\n        }\n    }\n\n    /// The prelude's `Opt<T>`, and what its `T` is. The name test is sound because `Opt` is\n    /// the prelude's declaration and a program redeclaring it is a duplicate-type error, so\n    /// no other enum can carry the name. This is what every place that used to match the\n    /// built-in `Type::Opt` keys on now: the unwrap operator, the producers' wrapping, and\n    /// the printers' bare-value-or-null serialization rule.\n    pub fn as_opt(&self) -> Option<&Type> {\n        match self {\n            Type::Enum { name, args, .. } if name == \"Opt\" && args.len() == 1 => Some(&args[0]),\n            _ => None,\n        }\n    }\n\n    /// Whether `Opt` appears anywhere in this type. What the checker asks of an input type:\n    /// absence has no ratified wire form (`null` reading as `none` is codec design nobody has\n    /// done), so an input cannot be Opt-typed anywhere in its shape.\n    pub fn contains_opt(&self) -> bool {\n        if self.as_opt().is_some() {\n            return true;\n        }\n        match self {\n            Type::Vec(t) | Type::Stream(t) => t.contains_opt(),\n            Type::Record(fields) => fields.iter().any(|(_, t)| t.contains_opt()),\n            Type::Enum { args, variants, .. } => {\n                args.iter().any(Type::contains_opt)\n                    || variants\n                        .iter()\n                        .any(|(_, p)| p.as_ref().is_some_and(Type::contains_opt))\n            }\n            _ => false,\n        }\n    }\n\n    /// Whether `Int64` appears anywhere in this type. What the checker asks of an input type:\n    /// unlike `Char` this is one-directional -- an `Int64` result prints fine on every backend\n    /// -- but reading one back is codec design nobody has done (JS parses JSON numbers into\n    /// doubles and loses exactness past 2^53), so `input` refuses it, the same reversible\n    /// direction `contains_opt` takes for absence.\n    pub fn contains_int64(&self) -> bool {\n        match self {\n            Type::Int64 => true,\n            Type::Vec(t) | Type::Stream(t) => t.contains_int64(),\n            Type::Record(fields) => fields.iter().any(|(_, t)| t.contains_int64()),\n            Type::Enum { args, variants, .. } => {\n                args.iter().any(Type::contains_int64)\n                    || variants\n                        .iter()\n                        .any(|(_, p)| p.as_ref().is_some_and(Type::contains_int64))\n            }\n            _ => false,\n        }\n    }\n\n    /// Whether `Char` appears anywhere in this type. What the checker asks of both `input`'s\n    /// type and the program's own printed result: neither has a wire form for a bare Unicode\n    /// scalar value, so both refuse it, the same reasoning `contains_opt` states for absence.\n    pub fn contains_char(&self) -> bool {\n        match self {\n            Type::Char => true,\n            Type::Vec(t) | Type::Stream(t) => t.contains_char(),\n            Type::Record(fields) => fields.iter().any(|(_, t)| t.contains_char()),\n            Type::Enum { args, variants, .. } => {\n                args.iter().any(Type::contains_char)\n                    || variants\n                        .iter()\n                        .any(|(_, p)| p.as_ref().is_some_and(Type::contains_char))\n            }\n            _ => false,\n        }\n    }\n\n    /// Whether a `Vec` appears anywhere in this type. What the checker asks of a comparison's\n    /// operands: an operator applied to a Vec is Q2 -- broadcast, zip, or whole-value -- and Q2\n    /// is open, so a Vec reached through a record field or an enum payload is refused for the\n    /// same reason a bare one is, rather than being handed whole-value equality by the back\n    /// door (kantord/toylang#95).\n    pub fn contains_vec(&self) -> bool {\n        match self {\n            Type::Vec(_) | Type::Stream(_) => true,\n            Type::Record(fields) => fields.iter().any(|(_, t)| t.contains_vec()),\n            Type::Enum { args, variants, .. } => {\n                args.iter().any(Type::contains_vec)\n                    || variants\n                        .iter()\n                        .any(|(_, p)| p.as_ref().is_some_and(Type::contains_vec))\n            }\n            _ => false,\n        }\n    }\n\n    /// Whether a value of this type has an interior to walk. Equality on one is structural on\n    /// every backend (kantord/toylang#68), which four of them need spelled out because their\n    /// native `==` on the runtime shape means identity or compares a payload pointer.\n    pub fn is_composite(&self) -> bool {\n        matches!(self, Type::Record(_) | Type::Enum { .. })\n    }\n\n    /// A deterministic identifier fragment for this type, for backends whose targets are\n    /// nominally typed: `Pair<Int>` and `Pair<Str>` must become distinct emitted types, so\n    /// their names embed the arguments (`Pair_Int`). Record fields sort by name, because\n    /// field order is not part of a record type's identity (kantord/toylang#60). An enum\n    /// declared without parameters keeps its bare name, which is what every existing\n    /// snapshot pins.\n    pub fn ident(&self) -> String {\n        match self {\n            Type::Str => \"Str\".to_string(),\n            Type::Int => \"Int\".to_string(),\n            Type::Int64 => \"Int64\".to_string(),\n            Type::Float => \"Float\".to_string(),\n            Type::Bool => \"Bool\".to_string(),\n            Type::Char => \"Char\".to_string(),\n            Type::Vec(t) => format!(\"Vec_{}\", t.ident()),\n            Type::Stream(t) => format!(\"Stream_{}\", t.ident()),\n            Type::Sink => \"Sink\".to_string(),\n            Type::Record(fields) => {\n                let mut parts: Vec<String> = fields\n                    .iter()\n                    .map(|(n, t)| format!(\"{n}_{}\", t.ident()))\n                    .collect();\n                parts.sort();\n                format!(\"R_{}\", parts.join(\"_\"))\n            }\n            Type::Enum { name, args, .. } => {\n                if args.is_empty() {\n                    name.clone()\n                } else {\n                    let parts: Vec<String> = args.iter().map(Type::ident).collect();\n                    format!(\"{name}_{}\", parts.join(\"_\"))\n                }\n            }\n            Type::Param(_) => unreachable!(\"params are substituted before any backend runs\"),\n        }\n    }\n\n    /// The name of `self`'s own printer function, shared by every backend that emits one\n    /// (kantord/toylang#94). Go camel-cases its own variant at the call site.\n    pub fn show_fn(&self) -> String {\n        format!(\"tl_show_{}\", self.ident())\n    }\n}\n\nimpl std::fmt::Display for Type {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        match self {\n            Type::Stream(t) => write!(f, \"Stream<{t}>\"),\n            Type::Sink => write!(f, \"Sink\"),\n            Type::Str => write!(f, \"Str\"),\n            Type::Int => write!(f, \"Int\"),\n            Type::Int64 => write!(f, \"Int64\"),\n            Type::Float => write!(f, \"Float\"),\n            Type::Bool => write!(f, \"Bool\"),\n            Type::Char => write!(f, \"Char\"),\n            Type::Vec(t) => write!(f, \"Vec<{t}>\"),\n            Type::Record(fields) => {\n                let parts: Vec<String> = fields.iter().map(|(n, t)| format!(\"{n}: {t}\")).collect();\n                write!(f, \"{{{}}}\", parts.join(\", \"))\n            }\n            // The name is the identity, so the name is the display: spelling the variants out\n            // would print the definition where the reader wants the reference.\n            Type::Enum { name, args, .. } => {\n                write!(f, \"{name}\")?;\n                if !args.is_empty() {\n                    let parts: Vec<String> = args.iter().map(|a| a.to_string()).collect();\n                    write!(f, \"<{}>\", parts.join(\", \"))?;\n                }\n                Ok(())\n            }\n            Type::Param(name) => write!(f, \"{name}\"),\n        }\n    }\n}\n\nimpl PartialEq for Type {\n    /// Structural equality, except `Record`: its fields compare as a set, keyed by name and\n    /// type, ignoring position (kantord/toylang#60). A record's own field order is real data --\n    /// it drives printing and backend column layout -- but it is not part of what makes two\n    /// types the same type.\n    ///\n    /// `Enum` compares `name` and `args` only, not `variants`: those two already determine the\n    /// variant list within one program (a redeclaration is refused, and an instantiation's\n    /// payloads are `args` substituted into the one declaration), so comparing `variants` too\n    /// would be redundant on every ordinary type and actively wrong on a self-referential one,\n    /// whose nested occurrence of itself carries a placeholder rather than the list every other\n    /// occurrence of the same name carries (kantord/toylang#76).\n    fn eq(&self, other: &Self) -> bool {\n        match (self, other) {\n            (Type::Str, Type::Str)\n            | (Type::Int, Type::Int)\n            | (Type::Int64, Type::Int64)\n            | (Type::Float, Type::Float)\n            | (Type::Bool, Type::Bool)\n            | (Type::Char, Type::Char) => true,\n            (Type::Vec(a), Type::Vec(b)) => a == b,\n            (Type::Stream(a), Type::Stream(b)) => a == b,\n            (Type::Sink, Type::Sink) => true,\n            (Type::Record(a), Type::Record(b)) => {\n                a.len() == b.len() && a.iter().all(|field| b.contains(field))\n            }\n            (\n                Type::Enum {\n                    name: n1, args: a1, ..\n                },\n                Type::Enum {\n                    name: n2, args: a2, ..\n                },\n            ) => n1 == n2 && a1 == a2,\n            (Type::Param(a), Type::Param(b)) => a == b,\n            _ => false,\n        }\n    }\n}\n\n/// A function takes at most one parameter; `None` is a nullary function.\n#[derive(Debug, Clone)]\npub struct Sig {\n    pub param: Option<Type>,\n    pub ret: Type,\n}\n\n/// Replace every `Type::Param` in `t` with its binding. Together with the checker's `unify`,\n/// this is the whole of generic instantiation: nothing else ever sees a parameter.\npub fn substitute(t: &Type, map: &HashMap<String, Type>) -> Type {\n    match t {\n        Type::Param(p) => map\n            .get(p)\n            .cloned()\n            .unwrap_or_else(|| unreachable!(\"substitute runs only once every param is bound\")),\n        Type::Vec(e) => Type::Vec(Box::new(substitute(e, map))),\n        Type::Stream(e) => Type::Stream(Box::new(substitute(e, map))),\n        Type::Record(fields) => Type::Record(\n            fields\n                .iter()\n                .map(|(n, t)| (n.clone(), substitute(t, map)))\n                .collect(),\n        ),\n        Type::Enum {\n            name,\n            args,\n            variants,\n        } => Type::Enum {\n            name: name.clone(),\n            args: args.iter().map(|a| substitute(a, map)).collect(),\n            variants: variants\n                .iter()\n                .map(|(n, p)| (n.clone(), p.as_ref().map(|p| substitute(p, map))))\n                .collect(),\n        },\n        Type::Str | Type::Int | Type::Int64 | Type::Float | Type::Bool | Type::Char | Type::Sink => {\n            t.clone()\n        }\n    }\n}\n\n/// `name`'s variant list at `args`, re-derived from the registry rather than trusted from\n/// whichever `Type::Enum` a caller happened to be holding. One layer deep: a payload that is\n/// itself the same enum comes back carrying the placeholder in turn, so asking again is what\n/// descends, and nothing tries to build a list that has no bottom.\npub fn variants_of(enums: &Enums, name: &str, args: &[Type]) -> Vec<(String, Option<Type>)> {\n    let Type::Enum {\n        args: template_args,\n        variants,\n        ..\n    } = &enums[name]\n    else {\n        unreachable!(\"the registry holds enum types\")\n    };\n    if template_args.is_empty() {\n        return variants.clone();\n    }\n    let bindings: HashMap<String, Type> = template_args\n        .iter()\n        .zip(args)\n        .filter_map(|(p, a)| match p {\n            Type::Param(p) => Some((p.clone(), a.clone())),\n            _ => None,\n        })\n        .collect();\n    variants\n        .iter()\n        .map(|(n, p)| (n.clone(), p.as_ref().map(|t| substitute(t, &bindings))))\n        .collect()\n}\n\n/// `variants_of` for an enum type in hand.\npub fn variants(enums: &Enums, ty: &Type) -> Vec<(String, Option<Type>)> {\n    let Type::Enum { name, args, .. } = ty else {\n        unreachable!(\"only an enum has variants\")\n    };\n    variants_of(enums, name, args)\n}\n\n/// Whether a value of this enum type can hold another of the same type, however deep.\n///\n/// Always through a `Vec`, since that is the only self-reference the checker allows, but not\n/// always directly: the path can run through a record field or a second enum. What it decides\n/// is whether a backend may expand this type inline -- a printer, a parser, a declaration\n/// written by walking the payloads -- or has to emit a named function it can call back into.\n/// Expanding a recursive one inline does not terminate.\npub fn is_recursive(enums: &Enums, ty: &Type) -> bool {\n    fn reaches(enums: &Enums, from: &Type, target: &Type, seen: &mut Vec<Type>) -> bool {\n        match from {\n            Type::Vec(e) | Type::Stream(e) => reaches(enums, e, target, seen),\n            Type::Record(fields) => fields.iter().any(|(_, t)| reaches(enums, t, target, seen)),\n            Type::Enum { name, args, .. } => {\n                if from == target {\n                    return true;\n                }\n                if seen.contains(from) {\n                    return false;\n                }\n                seen.push(from.clone());\n                args.iter().any(|a| reaches(enums, a, target, seen))\n                    || variants_of(enums, name, args)\n                        .iter()\n                        .any(|(_, p)| p.as_ref().is_some_and(|p| reaches(enums, p, target, seen)))\n            }\n            _ => false,\n        }\n    }\n    if !matches!(ty, Type::Enum { .. }) {\n        return false;\n    }\n    let mut seen = vec![ty.clone()];\n    variants(enums, ty)\n        .iter()\n        .any(|(_, p)| p.as_ref().is_some_and(|p| reaches(enums, p, ty, &mut seen)))\n}","lineStart":1,"lineEnd":496,"totalLines":496,"truncated":false}},"title":"src/ty.rs","time":{"start":1788379871534,"end":1788379871544}},"id":"prt_063bf3593001m3VC6mFiW1nFZO","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","messageID":"msg_063bf0772001fcFgMemrRCu3UK"}}
