{"type":"tool_use","timestamp":1788379880708,"sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","part":{"type":"tool","tool":"read","callID":"call_b7269a4bd6b04fdbb40e8d86","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-174/src/check/mod.rs","offset":480,"limit":450},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-174/src/check/mod.rs</path>\n<type>file</type>\n<content>\n480: fn check_program_body(ctx: &Ctx, body: &Expr) -> Result<Tir, Error> {\n481:     if matches!(body, Expr::TailPipe { .. }) {\n482:         return tail_pipe(ctx, body);\n483:     }\n484:     if let Some(tir) = sink_call(ctx, body)? {\n485:         return Ok(tir);\n486:     }\n487:     synth(ctx, body)\n488: }\n489: \n490: /// Whether `body` is a direct sink call -- `jsonlines(...)` or a call to a function declared\n491: /// `-> Sink` -- and, if so, the `Sink`-typed Tir it checks to. The `|>` tail-pipeline is the\n492: /// other way a sink is written (see `tail_pipe`); both are legal in the program's body and a\n493: /// `Sink`-returning function's body, and everywhere else `synth` runs the general position\n494: /// rule and a `Sink` that slips past here is a shape `synth` should have refused.\n495: fn sink_call(ctx: &Ctx, body: &Expr) -> Result<Option<Tir>, Error> {\n496:     let Expr::Call {\n497:         func,\n498:         func_span,\n499:         arg,\n500:         span,\n501:     } = body\n502:     else {\n503:         return Ok(None);\n504:     };\n505:     if func == \"jsonlines\" {\n506:         return Ok(Some(jsonlines_call(ctx, arg, *span)?));\n507:     }\n508:     if ctx.sigs.get(func).is_some_and(|sig| sig.ret == Type::Sink) {\n509:         return Ok(Some(call(ctx, func, *func_span, arg, *span)?));\n510:     }\n511:     Ok(None)\n512: }\n513: \n514: /// `lhs |> callee`, the tail-pipeline marker: `callee` -- a sink -- applied to `lhs`. This is\n515: /// one of the two legal places a `Sink` may be born (the program's body and a `Sink`-returning\n516: /// function's body; the other is a direct sink call, see `sink_call`); everywhere else `synth`\n517: /// runs the general position rule and a `Sink` that slips past here is a shape `synth` should\n518: /// have refused. Only a `Sink`-typed callee is legal, which is the general rule the old\n519: /// hand-checked `jsonlines` position (kantord/toylang#151, #154) folded into: `jsonlines` is\n520: /// the one sink builtin, and every other callee must be a function whose declared return type\n521: /// is `Sink`.\n522: fn tail_pipe(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\n523:     let Expr::TailPipe {\n524:         lhs,\n525:         callee,\n526:         callee_span,\n527:         ..\n528:     } = expr\n529:     else {\n530:         unreachable!(\"tail_pipe is only called on a `|>` node\");\n531:     };\n532:     let value = synth(ctx, lhs)?;\n533:     if callee == \"jsonlines\" {\n534:         return jsonlines_arg(value, lhs.span());\n535:     }\n536:     let Some(sig) = ctx.sigs.get(callee.as_str()) else {\n537:         return Err(Error::new(\n538:             *callee_span,\n539:             format!(\n540:                 \"the callee of `|>` must be a sink, such as `jsonlines` or a function that \\\n541:                  returns Sink; `{callee}` is not one\"\n542:             ),\n543:         ));\n544:     };\n545:     if sig.ret != Type::Sink {\n546:         return Err(Error::new(\n547:             *callee_span,\n548:             format!(\n549:                 \"the callee of `|>` must be a sink, but `{callee}` returns {}\",\n550:                 sig.ret\n551:             ),\n552:         ));\n553:     }\n554:     let Some(param_ty) = &sig.param else {\n555:         return Err(Error::new(\n556:             *callee_span,\n557:             format!(\"`{callee}` takes no argument, so there is nothing for `|>` to pass it\"),\n558:         ));\n559:     };\n560:     if value.ty != *param_ty {\n561:         return Err(Error::new(\n562:             lhs.span(),\n563:             format!(\"`{callee}` needs {param_ty}, found {}\", value.ty),\n564:         ));\n565:     }\n566:     let value = conform(ctx, value, param_ty);\n567:     Ok(Tir::new(\n568:         Type::Sink,\n569:         Kind::Call {\n570:             func: callee.clone(),\n571:             arg: Some(Box::new(value)),\n572:         },\n573:     ))\n574: }\n575: \n576: /// Every function name the language itself provides, and therefore reserves. `str`, `range`,\n577: /// `chars`, and `i64` live in `builtin()`'s fixed table; `jsonlines`, `length`, `flatten`,\n578: /// `tail`, `collect`, `fields`, `sort`, `reverse`, `sum`, and `max` are polymorphic and checked\n579: /// from `synth`'s own arms; `select` and `map` rebind `.`. All sixteen are reserved the same\n580: /// way, and the docs harness (tests/docs.rs) reads this list to insist each one has a\n581: /// reference page.\n582: pub const BUILTIN_NAMES: [&str; 16] = [\n583:     \"chars\",\n584:     \"collect\",\n585:     \"length\",\n586:     \"fields\",\n587:     \"flatten\",\n588:     \"i64\",\n589:     \"jsonlines\",\n590:     \"map\",\n591:     \"max\",\n592:     \"range\",\n593:     \"reverse\",\n594:     \"select\",\n595:     \"sort\",\n596:     \"str\",\n597:     \"sum\",\n598:     \"tail\",\n599: ];\n600: \n601: /// Functions the language provides. Unary like every other function, so they need no special\n602: /// call syntax and are looked up before user definitions.\n603: fn builtin(name: &str) -> Option<(tir::Builtin, Sig)> {\n604:     let vec_of = |t: Type| Type::Vec(Box::new(t));\n605:     Some(match name {\n606:         \"str\" => (\n607:             tir::Builtin::IntToStr,\n608:             Sig {\n609:                 param: Some(Type::Int),\n610:                 ret: Type::Str,\n611:             },\n612:         ),\n613:         \"range\" => (\n614:             tir::Builtin::Range,\n615:             Sig {\n616:                 param: Some(Type::Int),\n617:                 ret: Type::Stream(Box::new(Type::Int)),\n618:             },\n619:         ),\n620:         \"chars\" => (\n621:             tir::Builtin::Chars,\n622:             Sig {\n623:                 param: Some(Type::Str),\n624:                 ret: vec_of(Type::Char),\n625:             },\n626:         ),\n627:         // The one bridge between the integer types (kantord/toylang#83). Its argument is an\n628:         // Int, so `i64(9000000000)` is refused like any other too-big Int literal: a wide\n629:         // value enters as a literal only where an Int64 is already expected.\n630:         \"i64\" => (\n631:             tir::Builtin::IntToI64,\n632:             Sig {\n633:                 param: Some(Type::Int),\n634:                 ret: Type::Int64,\n635:             },\n636:         ),\n637:         _ => return None,\n638:     })\n639: }\n640: \n641: /// A chain split by `rebase`: the rebased body, and the stream source it was split from.\n642: struct Rebased {\n643:     body: Tir,\n644:     source: Tir,\n645: }\n646: \n647: /// Split an access chain whose outermost dimension is a stream from its source, rebasing the\n648: /// chain on `param` as a map body: every node's type loses its Stream wrapper, and an Index's\n649: /// stored depth drops by one, since the layer it counted is now the loop.\n650: ///\n651: /// Only Field, Unwrap, and Index appear in a chain, and the source is never one of them: a\n652: /// stream-typed access chain is normalized to a Map right here, so one can never be the base of\n653: /// another.\n654: fn rebase(t: Tir, param: LocalId) -> Rebased {\n655:     fn peel(ty: Type) -> Type {\n656:         match ty {\n657:             Type::Stream(t) => *t,\n658:             other => unreachable!(\n659:                 \"every node inside the stream dimension is stream-typed, found {other}\"\n660:             ),\n661:         }\n662:     }\n663:     fn is_chain(t: &Tir) -> bool {\n664:         matches!(\n665:             t.kind,\n666:             Kind::Field { .. } | Kind::Unwrap { .. } | Kind::Index { .. }\n667:         )\n668:     }\n669:     /// The base of one link in the chain: another link to recurse into, or the stream source\n670:     /// itself, in which case `param` stands in for the per-element value the map body reads.\n671:     fn split_base(base: Tir, param: LocalId) -> Rebased {\n672:         if is_chain(&base) {\n673:             rebase(base, param)\n674:         } else {\n675:             let elem = peel(base.ty.clone());\n676:             Rebased {\n677:                 body: Tir::new(elem, Kind::Local(param)),\n678:                 source: base,\n679:             }\n680:         }\n681:     }\n682:     match t.kind {\n683:         Kind::Field { base, name } => {\n684:             let Rebased { body: base, source } = split_base(*base, param);\n685:             Rebased {\n686:                 body: Tir::new(\n687:                     peel(t.ty),\n688:                     Kind::Field {\n689:                         base: Box::new(base),\n690:                         name,\n691:                     },\n692:                 ),\n693:                 source,\n694:             }\n695:         }\n696:         Kind::Unwrap { base } => {\n697:             let Rebased { body: base, source } = split_base(*base, param);\n698:             Rebased {\n699:                 body: Tir::new(\n700:                     peel(t.ty),\n701:                     Kind::Unwrap {\n702:                         base: Box::new(base),\n703:                     },\n704:                 ),\n705:                 source,\n706:             }\n707:         }\n708:         Kind::Index {\n709:             base,\n710:             index,\n711:             depth,\n712:             elem_is_record,\n713:         } => {\n714:             let Rebased { body: base, source } = split_base(*base, param);\n715:             let kind = Kind::Index {\n716:                 base: Box::new(base),\n717:                 index,\n718:                 depth: depth - 1,\n719:                 elem_is_record,\n720:             };\n721:             Rebased {\n722:                 body: Tir::new(peel(t.ty), kind),\n723:                 source,\n724:             }\n725:         }\n726:         other => unreachable!(\n727:             \"only an access chain is rebased, found {:?}\",\n728:             std::mem::discriminant(&other)\n729:         ),\n730:     }\n731: }\n732: \n733: /// The element `select` and `map` rebind `.` to: a Vec's, or a Stream's. Deliberately not\n734: /// `Type::elem`, which stays Vec-only so the reducers (`length`, `jsonlines` today) keep\n735: /// refusing a stream.\n736: fn mapper_elem(subject: &Type) -> Option<Type> {\n737:     match subject {\n738:         Type::Vec(t) | Type::Stream(t) => Some((**t).clone()),\n739:         _ => None,\n740:     }\n741: }\n742: \n743: /// The context a mapper body (`select`'s predicate, `map`'s body) checks in: `.` rebound to the\n744: /// element a fresh `param` will hold at runtime, with a source read refused since the body runs\n745: /// once per element rather than once.\n746: fn mapper_ctx<'a>(ctx: &'a Ctx, elem: Type, param: LocalId) -> Ctx<'a> {\n747:     let mut inner = ctx.with(Some((elem, param)));\n748:     inner.in_mapper = true;\n749:     inner\n750: }\n751: \n752: /// The one enum a bare variant name refers to, or the error naming every candidate: guessing\n753: /// between two claimants would silently pick a type the program never wrote down.\n754: fn sole_owner<'a>(\n755:     ctx: &'a Ctx,\n756:     variant: &str,\n757:     owners: &[String],\n758:     span: Span,\n759: ) -> Result<&'a Type, Error> {\n760:     if owners.len() > 1 {\n761:         let named: Vec<String> = owners.iter().map(|e| format!(\"`{e}`\")).collect();\n762:         let qualified: Vec<String> = owners.iter().map(|e| format!(\"`{e}.{variant}`\")).collect();\n763:         return Err(Error::new(\n764:             span,\n765:             format!(\n766:                 \"`{variant}` is a variant of {}; qualify it as {}\",\n767:                 named.join(\" and \"),\n768:                 qualified.join(\" or \")\n769:             ),\n770:         ));\n771:     }\n772:     Ok(&ctx.enums[&owners[0]])\n773: }\n774: \n775: /// Every builtin and special-cased call form (`select`, `map`, `length`, ...) is unary; only a\n776: /// user-defined function can be nullary. This unwraps a call's optional argument for those\n777: /// forms, turning a bare `name()` at one of these names into the same \"not a function\" shape as\n778: /// any other arity mismatch would need, rather than a panic.\n779: fn need_arg<'a>(arg: &'a Option<Box<Expr>>, func: &str, span: Span) -> Result<&'a Expr, Error> {\n780:     arg.as_deref()\n781:         .ok_or_else(|| Error::new(span, format!(\"`{func}` needs an argument\")))\n782: }\n783: \n784: /// `expr` is a call to `name` carrying an argument, for `expect_inner`'s `collect`/`map`\n785: /// special cases: a bare `name()` (no argument) is not one of these, and falls through to\n786: /// `synth`, which owns the arity error for a name that is not actually nullary.\n787: fn call_named<'a>(expr: &'a Expr, name: &str) -> Option<&'a Expr> {\n788:     let Expr::Call { func, arg, .. } = expr else {\n789:         return None;\n790:     };\n791:     if func != name {\n792:         return None;\n793:     }\n794:     arg.as_deref()\n795: }\n796: \n797: /// `name`'s variant list at `args`. A thin wrapper over the shared re-derivation\n798: /// (`ty::variants_of`), which the backends reach for too: the checker's own `Type::Enum` in\n799: /// hand carries a placeholder wherever a self-reference sits behind a `Vec`\n800: /// (`types::resolve_named`, kantord/toylang#76), so every consumer that actually needs the\n801: /// variants comes through here instead, one layer at a time, exactly as deep as the program\n802: /// itself ever navigates into the value.\n803: fn enum_variants(ctx: &Ctx, name: &str, args: &[Type]) -> Vec<(String, Option<Type>)> {\n804:     ty::variants_of(ctx.enums, name, args)\n805: }\n806: \n807: /// The prelude's `Opt<T>` at a concrete `T`: what every Opt-producing site -- the collapsing\n808: /// index, `tail`, a partial guard chain -- wraps its result in. Instantiated from the\n809: /// registry template rather than spelled out, so the checker never re-states the prelude's\n810: /// declaration.\n811: fn opt_of(ctx: &Ctx, inner: Type) -> Type {\n812:     let template = ctx.enums.get(\"Opt\").expect(\"the prelude declares Opt\");\n813:     let Type::Enum { args, .. } = template else {\n814:         unreachable!(\"the registry holds enum types\")\n815:     };\n816:     let Type::Param(p) = &args[0] else {\n817:         unreachable!(\"Opt's template argument is its own parameter\")\n818:     };\n819:     ty::substitute(template, &HashMap::from([(p.clone(), inner)]))\n820: }\n821: \n822: /// Match a template type (parameters possibly inside) against a concrete one, binding each\n823: /// parameter to what it faces. Records match fields by name, not position, the same way type\n824: /// equality does (kantord/toylang#60); enums match on name and arguments, since the variants\n825: /// follow from those.\n826: fn unify(template: &Type, concrete: &Type, map: &mut HashMap<String, Type>) -> bool {\n827:     match (template, concrete) {\n828:         (Type::Param(p), c) => match map.get(p) {\n829:             Some(bound) => bound == c,\n830:             None => {\n831:                 map.insert(p.clone(), c.clone());\n832:                 true\n833:             }\n834:         },\n835:         (Type::Vec(a), Type::Vec(b)) | (Type::Stream(a), Type::Stream(b)) => unify(a, b, map),\n836:         (Type::Record(a), Type::Record(b)) => {\n837:             a.len() == b.len()\n838:                 && a.iter().all(|(n, t)| {\n839:                     b.iter()\n840:                         .find(|(bn, _)| bn == n)\n841:                         .is_some_and(|(_, bt)| unify(t, bt, map))\n842:                 })\n843:         }\n844:         (\n845:             Type::Enum {\n846:                 name: n1, args: a1, ..\n847:             },\n848:             Type::Enum {\n849:                 name: n2, args: a2, ..\n850:             },\n851:         ) => n1 == n2 && a1.len() == a2.len() && a1.iter().zip(a2).all(|(x, y)| unify(x, y, map)),\n852:         _ => template == concrete,\n853:     }\n854: }\n855: \n856: /// Build one variant of `enum_ty`, checking that the payload written matches the payload\n857: /// declared: a unit variant takes none, a payload variant requires one.\n858: ///\n859: /// `enum_ty` is a registry template for a generic enum reached by name, or a concrete type\n860: /// when the position already knows one (an expectation, or a written annotation). A template\n861: /// instantiates from the expectation when `expected` names the same enum; otherwise the\n862: /// payload's synthesised type binds the parameters, and a variant that leaves any parameter\n863: /// open -- every unit variant of a generic enum does -- is refused, the `[]` answer.\n864: fn construct(\n865:     ctx: &Ctx,\n866:     enum_ty: &Type,\n867:     variant: &str,\n868:     variant_span: Span,\n869:     payload: Option<&Expr>,\n870:     expected: Option<&Type>,\n871:     from_string: bool,\n872: ) -> Result<Tir, Error> {\n873:     let Type::Enum { name, args, .. } = enum_ty else {\n874:         unreachable!(\"construct is only called with an enum type\")\n875:     };\n876:     let is_template = args.iter().any(|a| matches!(a, Type::Param(_)));\n877:     let instantiated;\n878:     let enum_ty = if !is_template {\n879:         enum_ty\n880:     } else if let Some(want @ Type::Enum { name: wanted, .. }) = expected\n881:         && wanted == name\n882:     {\n883:         want\n884:     } else {\n885:         instantiated = infer_instantiation(ctx, enum_ty, variant, variant_span, payload)?;\n886:         return Ok(instantiated);\n887:     };\n888:     let Type::Enum { name, args, .. } = enum_ty else {\n889:         unreachable!(\"construct is only called with an enum type\")\n890:     };\n891:     let variants = enum_variants(ctx, name, args);\n892:     // A capitalized name is the matcher, legal only in a pattern; a value is built with the\n893:     // lowercase constructor, which resolves to the declared (capitalized) variant. A string\n894:     // literal naming a variant is the wire's spelling, so it is exempt -- see the caller.\n895:     if !from_string && variant.chars().next().is_some_and(char::is_uppercase) {\n896:         return Err(Error::new(\n897:             variant_span,\n898:             format!(\n899:                 \"a constructor starts with a lowercase letter; `{variant}` is the matcher and \\\n900:                  matches only in a pattern, so write `{}` to build the value\",\n901:                 constructor_of(variant)\n902:             ),\n903:         ));\n904:     }\n905:     let Some((variant_name, declared)) = variants\n906:         .iter()\n907:         .find(|(n, _)| n == variant || is_constructor_of(n, variant))\n908:     else {\n909:         return Err(Error::new(\n910:             variant_span,\n911:             format!(\"`{name}` has no variant `{variant}`\"),\n912:         ));\n913:     };\n914:     let payload = match (declared, payload) {\n915:         (None, None) => None,\n916:         (Some(want), Some(expr)) => Some(Box::new(expect(ctx, expr, want)?)),\n917:         (None, Some(expr)) => {\n918:             return Err(Error::new(\n919:                 expr.span(),\n920:                 format!(\"`{variant}` is a unit variant of `{name}` and takes no payload\"),\n921:             ));\n922:         }\n923:         (Some(want), None) => {\n924:             // The hint mirrors the declaration's two spellings: braces for a record payload,\n925:             // parens for any other type.\n926:             let spelled = match want {\n927:                 Type::Record(_) => format!(\"{variant}{{...}}\"),\n928:                 _ => format!(\"{variant}(...)\"),\n929:             };\n\n(Showing lines 480-929 of 3239. Use offset=930 to continue.)\n</content>","metadata":{"preview":"fn check_program_body(ctx: &Ctx, body: &Expr) -> Result<Tir, Error> {\n    if matches!(body, Expr::TailPipe { .. }) {\n        return tail_pipe(ctx, body);\n    }\n    if let Some(tir) = sink_call(ctx, body)? {\n        return Ok(tir);\n    }\n    synth(ctx, body)\n}\n\n/// Whether `body` is a direct sink call -- `jsonlines(...)` or a call to a function declared\n/// `-> Sink` -- and, if so, the `Sink`-typed Tir it checks to. The `|>` tail-pipeline is the\n/// other way a sink is written (see `tail_pipe`); both are legal in the program's body and a\n/// `Sink`-returning function's body, and everywhere else `synth` runs the general position\n/// rule and a `Sink` that slips past here is a shape `synth` should have refused.\nfn sink_call(ctx: &Ctx, body: &Expr) -> Result<Option<Tir>, Error> {\n    let Expr::Call {\n        func,\n        func_span,\n        arg,","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-174/src/check/mod.rs","text":"fn check_program_body(ctx: &Ctx, body: &Expr) -> Result<Tir, Error> {\n    if matches!(body, Expr::TailPipe { .. }) {\n        return tail_pipe(ctx, body);\n    }\n    if let Some(tir) = sink_call(ctx, body)? {\n        return Ok(tir);\n    }\n    synth(ctx, body)\n}\n\n/// Whether `body` is a direct sink call -- `jsonlines(...)` or a call to a function declared\n/// `-> Sink` -- and, if so, the `Sink`-typed Tir it checks to. The `|>` tail-pipeline is the\n/// other way a sink is written (see `tail_pipe`); both are legal in the program's body and a\n/// `Sink`-returning function's body, and everywhere else `synth` runs the general position\n/// rule and a `Sink` that slips past here is a shape `synth` should have refused.\nfn sink_call(ctx: &Ctx, body: &Expr) -> Result<Option<Tir>, Error> {\n    let Expr::Call {\n        func,\n        func_span,\n        arg,\n        span,\n    } = body\n    else {\n        return Ok(None);\n    };\n    if func == \"jsonlines\" {\n        return Ok(Some(jsonlines_call(ctx, arg, *span)?));\n    }\n    if ctx.sigs.get(func).is_some_and(|sig| sig.ret == Type::Sink) {\n        return Ok(Some(call(ctx, func, *func_span, arg, *span)?));\n    }\n    Ok(None)\n}\n\n/// `lhs |> callee`, the tail-pipeline marker: `callee` -- a sink -- applied to `lhs`. This is\n/// one of the two legal places a `Sink` may be born (the program's body and a `Sink`-returning\n/// function's body; the other is a direct sink call, see `sink_call`); everywhere else `synth`\n/// runs the general position rule and a `Sink` that slips past here is a shape `synth` should\n/// have refused. Only a `Sink`-typed callee is legal, which is the general rule the old\n/// hand-checked `jsonlines` position (kantord/toylang#151, #154) folded into: `jsonlines` is\n/// the one sink builtin, and every other callee must be a function whose declared return type\n/// is `Sink`.\nfn tail_pipe(ctx: &Ctx, expr: &Expr) -> Result<Tir, Error> {\n    let Expr::TailPipe {\n        lhs,\n        callee,\n        callee_span,\n        ..\n    } = expr\n    else {\n        unreachable!(\"tail_pipe is only called on a `|>` node\");\n    };\n    let value = synth(ctx, lhs)?;\n    if callee == \"jsonlines\" {\n        return jsonlines_arg(value, lhs.span());\n    }\n    let Some(sig) = ctx.sigs.get(callee.as_str()) else {\n        return Err(Error::new(\n            *callee_span,\n            format!(\n                \"the callee of `|>` must be a sink, such as `jsonlines` or a function that \\\n                 returns Sink; `{callee}` is not one\"\n            ),\n        ));\n    };\n    if sig.ret != Type::Sink {\n        return Err(Error::new(\n            *callee_span,\n            format!(\n                \"the callee of `|>` must be a sink, but `{callee}` returns {}\",\n                sig.ret\n            ),\n        ));\n    }\n    let Some(param_ty) = &sig.param else {\n        return Err(Error::new(\n            *callee_span,\n            format!(\"`{callee}` takes no argument, so there is nothing for `|>` to pass it\"),\n        ));\n    };\n    if value.ty != *param_ty {\n        return Err(Error::new(\n            lhs.span(),\n            format!(\"`{callee}` needs {param_ty}, found {}\", value.ty),\n        ));\n    }\n    let value = conform(ctx, value, param_ty);\n    Ok(Tir::new(\n        Type::Sink,\n        Kind::Call {\n            func: callee.clone(),\n            arg: Some(Box::new(value)),\n        },\n    ))\n}\n\n/// Every function name the language itself provides, and therefore reserves. `str`, `range`,\n/// `chars`, and `i64` live in `builtin()`'s fixed table; `jsonlines`, `length`, `flatten`,\n/// `tail`, `collect`, `fields`, `sort`, `reverse`, `sum`, and `max` are polymorphic and checked\n/// from `synth`'s own arms; `select` and `map` rebind `.`. All sixteen are reserved the same\n/// way, and the docs harness (tests/docs.rs) reads this list to insist each one has a\n/// reference page.\npub const BUILTIN_NAMES: [&str; 16] = [\n    \"chars\",\n    \"collect\",\n    \"length\",\n    \"fields\",\n    \"flatten\",\n    \"i64\",\n    \"jsonlines\",\n    \"map\",\n    \"max\",\n    \"range\",\n    \"reverse\",\n    \"select\",\n    \"sort\",\n    \"str\",\n    \"sum\",\n    \"tail\",\n];\n\n/// Functions the language provides. Unary like every other function, so they need no special\n/// call syntax and are looked up before user definitions.\nfn builtin(name: &str) -> Option<(tir::Builtin, Sig)> {\n    let vec_of = |t: Type| Type::Vec(Box::new(t));\n    Some(match name {\n        \"str\" => (\n            tir::Builtin::IntToStr,\n            Sig {\n                param: Some(Type::Int),\n                ret: Type::Str,\n            },\n        ),\n        \"range\" => (\n            tir::Builtin::Range,\n            Sig {\n                param: Some(Type::Int),\n                ret: Type::Stream(Box::new(Type::Int)),\n            },\n        ),\n        \"chars\" => (\n            tir::Builtin::Chars,\n            Sig {\n                param: Some(Type::Str),\n                ret: vec_of(Type::Char),\n            },\n        ),\n        // The one bridge between the integer types (kantord/toylang#83). Its argument is an\n        // Int, so `i64(9000000000)` is refused like any other too-big Int literal: a wide\n        // value enters as a literal only where an Int64 is already expected.\n        \"i64\" => (\n            tir::Builtin::IntToI64,\n            Sig {\n                param: Some(Type::Int),\n                ret: Type::Int64,\n            },\n        ),\n        _ => return None,\n    })\n}\n\n/// A chain split by `rebase`: the rebased body, and the stream source it was split from.\nstruct Rebased {\n    body: Tir,\n    source: Tir,\n}\n\n/// Split an access chain whose outermost dimension is a stream from its source, rebasing the\n/// chain on `param` as a map body: every node's type loses its Stream wrapper, and an Index's\n/// stored depth drops by one, since the layer it counted is now the loop.\n///\n/// Only Field, Unwrap, and Index appear in a chain, and the source is never one of them: a\n/// stream-typed access chain is normalized to a Map right here, so one can never be the base of\n/// another.\nfn rebase(t: Tir, param: LocalId) -> Rebased {\n    fn peel(ty: Type) -> Type {\n        match ty {\n            Type::Stream(t) => *t,\n            other => unreachable!(\n                \"every node inside the stream dimension is stream-typed, found {other}\"\n            ),\n        }\n    }\n    fn is_chain(t: &Tir) -> bool {\n        matches!(\n            t.kind,\n            Kind::Field { .. } | Kind::Unwrap { .. } | Kind::Index { .. }\n        )\n    }\n    /// The base of one link in the chain: another link to recurse into, or the stream source\n    /// itself, in which case `param` stands in for the per-element value the map body reads.\n    fn split_base(base: Tir, param: LocalId) -> Rebased {\n        if is_chain(&base) {\n            rebase(base, param)\n        } else {\n            let elem = peel(base.ty.clone());\n            Rebased {\n                body: Tir::new(elem, Kind::Local(param)),\n                source: base,\n            }\n        }\n    }\n    match t.kind {\n        Kind::Field { base, name } => {\n            let Rebased { body: base, source } = split_base(*base, param);\n            Rebased {\n                body: Tir::new(\n                    peel(t.ty),\n                    Kind::Field {\n                        base: Box::new(base),\n                        name,\n                    },\n                ),\n                source,\n            }\n        }\n        Kind::Unwrap { base } => {\n            let Rebased { body: base, source } = split_base(*base, param);\n            Rebased {\n                body: Tir::new(\n                    peel(t.ty),\n                    Kind::Unwrap {\n                        base: Box::new(base),\n                    },\n                ),\n                source,\n            }\n        }\n        Kind::Index {\n            base,\n            index,\n            depth,\n            elem_is_record,\n        } => {\n            let Rebased { body: base, source } = split_base(*base, param);\n            let kind = Kind::Index {\n                base: Box::new(base),\n                index,\n                depth: depth - 1,\n                elem_is_record,\n            };\n            Rebased {\n                body: Tir::new(peel(t.ty), kind),\n                source,\n            }\n        }\n        other => unreachable!(\n            \"only an access chain is rebased, found {:?}\",\n            std::mem::discriminant(&other)\n        ),\n    }\n}\n\n/// The element `select` and `map` rebind `.` to: a Vec's, or a Stream's. Deliberately not\n/// `Type::elem`, which stays Vec-only so the reducers (`length`, `jsonlines` today) keep\n/// refusing a stream.\nfn mapper_elem(subject: &Type) -> Option<Type> {\n    match subject {\n        Type::Vec(t) | Type::Stream(t) => Some((**t).clone()),\n        _ => None,\n    }\n}\n\n/// The context a mapper body (`select`'s predicate, `map`'s body) checks in: `.` rebound to the\n/// element a fresh `param` will hold at runtime, with a source read refused since the body runs\n/// once per element rather than once.\nfn mapper_ctx<'a>(ctx: &'a Ctx, elem: Type, param: LocalId) -> Ctx<'a> {\n    let mut inner = ctx.with(Some((elem, param)));\n    inner.in_mapper = true;\n    inner\n}\n\n/// The one enum a bare variant name refers to, or the error naming every candidate: guessing\n/// between two claimants would silently pick a type the program never wrote down.\nfn sole_owner<'a>(\n    ctx: &'a Ctx,\n    variant: &str,\n    owners: &[String],\n    span: Span,\n) -> Result<&'a Type, Error> {\n    if owners.len() > 1 {\n        let named: Vec<String> = owners.iter().map(|e| format!(\"`{e}`\")).collect();\n        let qualified: Vec<String> = owners.iter().map(|e| format!(\"`{e}.{variant}`\")).collect();\n        return Err(Error::new(\n            span,\n            format!(\n                \"`{variant}` is a variant of {}; qualify it as {}\",\n                named.join(\" and \"),\n                qualified.join(\" or \")\n            ),\n        ));\n    }\n    Ok(&ctx.enums[&owners[0]])\n}\n\n/// Every builtin and special-cased call form (`select`, `map`, `length`, ...) is unary; only a\n/// user-defined function can be nullary. This unwraps a call's optional argument for those\n/// forms, turning a bare `name()` at one of these names into the same \"not a function\" shape as\n/// any other arity mismatch would need, rather than a panic.\nfn need_arg<'a>(arg: &'a Option<Box<Expr>>, func: &str, span: Span) -> Result<&'a Expr, Error> {\n    arg.as_deref()\n        .ok_or_else(|| Error::new(span, format!(\"`{func}` needs an argument\")))\n}\n\n/// `expr` is a call to `name` carrying an argument, for `expect_inner`'s `collect`/`map`\n/// special cases: a bare `name()` (no argument) is not one of these, and falls through to\n/// `synth`, which owns the arity error for a name that is not actually nullary.\nfn call_named<'a>(expr: &'a Expr, name: &str) -> Option<&'a Expr> {\n    let Expr::Call { func, arg, .. } = expr else {\n        return None;\n    };\n    if func != name {\n        return None;\n    }\n    arg.as_deref()\n}\n\n/// `name`'s variant list at `args`. A thin wrapper over the shared re-derivation\n/// (`ty::variants_of`), which the backends reach for too: the checker's own `Type::Enum` in\n/// hand carries a placeholder wherever a self-reference sits behind a `Vec`\n/// (`types::resolve_named`, kantord/toylang#76), so every consumer that actually needs the\n/// variants comes through here instead, one layer at a time, exactly as deep as the program\n/// itself ever navigates into the value.\nfn enum_variants(ctx: &Ctx, name: &str, args: &[Type]) -> Vec<(String, Option<Type>)> {\n    ty::variants_of(ctx.enums, name, args)\n}\n\n/// The prelude's `Opt<T>` at a concrete `T`: what every Opt-producing site -- the collapsing\n/// index, `tail`, a partial guard chain -- wraps its result in. Instantiated from the\n/// registry template rather than spelled out, so the checker never re-states the prelude's\n/// declaration.\nfn opt_of(ctx: &Ctx, inner: Type) -> Type {\n    let template = ctx.enums.get(\"Opt\").expect(\"the prelude declares Opt\");\n    let Type::Enum { args, .. } = template else {\n        unreachable!(\"the registry holds enum types\")\n    };\n    let Type::Param(p) = &args[0] else {\n        unreachable!(\"Opt's template argument is its own parameter\")\n    };\n    ty::substitute(template, &HashMap::from([(p.clone(), inner)]))\n}\n\n/// Match a template type (parameters possibly inside) against a concrete one, binding each\n/// parameter to what it faces. Records match fields by name, not position, the same way type\n/// equality does (kantord/toylang#60); enums match on name and arguments, since the variants\n/// follow from those.\nfn unify(template: &Type, concrete: &Type, map: &mut HashMap<String, Type>) -> bool {\n    match (template, concrete) {\n        (Type::Param(p), c) => match map.get(p) {\n            Some(bound) => bound == c,\n            None => {\n                map.insert(p.clone(), c.clone());\n                true\n            }\n        },\n        (Type::Vec(a), Type::Vec(b)) | (Type::Stream(a), Type::Stream(b)) => unify(a, b, map),\n        (Type::Record(a), Type::Record(b)) => {\n            a.len() == b.len()\n                && a.iter().all(|(n, t)| {\n                    b.iter()\n                        .find(|(bn, _)| bn == n)\n                        .is_some_and(|(_, bt)| unify(t, bt, map))\n                })\n        }\n        (\n            Type::Enum {\n                name: n1, args: a1, ..\n            },\n            Type::Enum {\n                name: n2, args: a2, ..\n            },\n        ) => n1 == n2 && a1.len() == a2.len() && a1.iter().zip(a2).all(|(x, y)| unify(x, y, map)),\n        _ => template == concrete,\n    }\n}\n\n/// Build one variant of `enum_ty`, checking that the payload written matches the payload\n/// declared: a unit variant takes none, a payload variant requires one.\n///\n/// `enum_ty` is a registry template for a generic enum reached by name, or a concrete type\n/// when the position already knows one (an expectation, or a written annotation). A template\n/// instantiates from the expectation when `expected` names the same enum; otherwise the\n/// payload's synthesised type binds the parameters, and a variant that leaves any parameter\n/// open -- every unit variant of a generic enum does -- is refused, the `[]` answer.\nfn construct(\n    ctx: &Ctx,\n    enum_ty: &Type,\n    variant: &str,\n    variant_span: Span,\n    payload: Option<&Expr>,\n    expected: Option<&Type>,\n    from_string: bool,\n) -> Result<Tir, Error> {\n    let Type::Enum { name, args, .. } = enum_ty else {\n        unreachable!(\"construct is only called with an enum type\")\n    };\n    let is_template = args.iter().any(|a| matches!(a, Type::Param(_)));\n    let instantiated;\n    let enum_ty = if !is_template {\n        enum_ty\n    } else if let Some(want @ Type::Enum { name: wanted, .. }) = expected\n        && wanted == name\n    {\n        want\n    } else {\n        instantiated = infer_instantiation(ctx, enum_ty, variant, variant_span, payload)?;\n        return Ok(instantiated);\n    };\n    let Type::Enum { name, args, .. } = enum_ty else {\n        unreachable!(\"construct is only called with an enum type\")\n    };\n    let variants = enum_variants(ctx, name, args);\n    // A capitalized name is the matcher, legal only in a pattern; a value is built with the\n    // lowercase constructor, which resolves to the declared (capitalized) variant. A string\n    // literal naming a variant is the wire's spelling, so it is exempt -- see the caller.\n    if !from_string && variant.chars().next().is_some_and(char::is_uppercase) {\n        return Err(Error::new(\n            variant_span,\n            format!(\n                \"a constructor starts with a lowercase letter; `{variant}` is the matcher and \\\n                 matches only in a pattern, so write `{}` to build the value\",\n                constructor_of(variant)\n            ),\n        ));\n    }\n    let Some((variant_name, declared)) = variants\n        .iter()\n        .find(|(n, _)| n == variant || is_constructor_of(n, variant))\n    else {\n        return Err(Error::new(\n            variant_span,\n            format!(\"`{name}` has no variant `{variant}`\"),\n        ));\n    };\n    let payload = match (declared, payload) {\n        (None, None) => None,\n        (Some(want), Some(expr)) => Some(Box::new(expect(ctx, expr, want)?)),\n        (None, Some(expr)) => {\n            return Err(Error::new(\n                expr.span(),\n                format!(\"`{variant}` is a unit variant of `{name}` and takes no payload\"),\n            ));\n        }\n        (Some(want), None) => {\n            // The hint mirrors the declaration's two spellings: braces for a record payload,\n            // parens for any other type.\n            let spelled = match want {\n                Type::Record(_) => format!(\"{variant}{{...}}\"),\n                _ => format!(\"{variant}(...)\"),\n            };","lineStart":480,"lineEnd":929,"totalLines":3239,"truncated":true}},"title":"src/check/mod.rs","time":{"start":1788379880694,"end":1788379880706}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me read the checker's `binary`, `plus`, `call`, and `builtin` functions, and the relevant parts of the checker. Let me read lines 480-900.","format":"unknown","index":0}]}},"id":"prt_063bf5cee001T6r2YCdhG7qlpl","sessionID":"ses_f9c41a182ffeXV0U7B2A3hfjyw","messageID":"msg_063bf3956001y62mBEmJa7c9GJ"}}
