        (Type::Float, Value::Number(_)) => {\n34:             // A Float is the double a JSON number already is (ADR 0007), so every JSON number\n35:             // -- integer or not -- reads as one, with no exactness to lose the way Int64 does.\n36:             return Ok(());\n37:         }\n38: \n39:         (Type::Vec(elem), Value::Array(items)) => {\n40:             for (i, item) in items.iter().enumerate() {\n41:                 validate(enums, item, elem, &format!(\"{path}[{i}]\"))?;\n42:             }\n43:             return Ok(());\n44:         }\n45: \n46:         (Type::Record(fields), Value::Object(map)) => {\n47:             for (name, field_ty) in fields {\n48:                 let Some(v) = map.get(name) else {\n49:                     return Err(format!(\"{path}: missing field `{name}`\"));\n50:                 };\n51:                 validate(enums, v, field_ty, &format!(\"{path}.{name}\"))?;\n52:             }\n53:             // Undeclared fields are ignored rather than rejected, so a program can read two\n54:             // fields out of a log line without describing the whole line. Open: whether that\n55:             // is the right call once the type is also used to lay the value out.\n56:             return Ok(());\n57:         }\n58: \n59:         // One enum value spans two JSON shapes (ADR 0009): a bare string naming a unit\n60:         // variant, or a single-key object whose key names a payload variant. Everything else\n61:         // is refused with the enum's name, since \"found a string\" alone would not say which\n62:         // closed set the string missed.\n63:         (Type::Enum { name, .. }, v) => {\n64:             // Read from the registry, not off `ty`: a recursive enum's nested occurrence of\n65:             // itself carries a placeholder in place of its variants (kantord/toylang#94).\n66:             let variants = ty::variants(enums, ty);\n67:             return match v {\n68:                 Value::String(s) => match variants.iter().find(|(n, _)| n == s) {\n69:                     Some((_, None)) => Ok(()),\n70:                     Some((_, Some(_))) => Err(format!(\n71:                         \"{path}: `{s}` is a payload variant of {name}, written {{\\\"{s}\\\": ...}}\"\n72:                     )),\n73:                     None => Err(format!(\"{path}: `{s}` is not a variant of {name}\")),\n74:                 },\n75:                 Value::Object(map) if map.len() == 1 => {\n76:                     let (key, inner) = map.iter().next().expect(\"exactly one entry\");\n77:                     match variants.iter().find(|(n, _)| n == key) {\n78:                         Some((_, Some(payload))) => {\n79:                             validate(enums, inner, payload, &format!(\"{path}.{key}\"))\n80:                         }\n81:                         Some((_, None)) => Err(format!(\n82:                             \"{path}: `{key}` is a unit variant of {name}, written \\\"{key}\\\"\"\n83:                         )),\n84:                         None => Err(format!(\"{path}: `{key}` is not a variant of {name}\")),\n85:                     }\n86:                 }\n87:                 v => Err(format!(\"{path}: expected {name}, found {}\", describe(v))),\n88:             };\n89:         }\n90: \n91:         (_, v) => describe(v),\n92:     };\n93:     Err(format!(\"{path}: expected {ty}, found {found}\"))\n94: }\n95: \n96: fn describe(v: &Value) -> &'static str {\n97:     match v {\n98:         Value::Null => \"null\",\n99:         Value::Bool(_) => \"a boolean\",\n100:         Value::Number(_) => \"a number\",\n101:         Value::String(_) => \"a string\",\n102:         Value::Array(_) => \"an array\",\n103:         Value::Object(_) => \"an object\",\n104:     }\n105: }\n106: \n107: pub fn to_lua(lua: &Lua, value: &Value) -> mlua::Result<mlua::Value> {\n108:     Ok(match value {\n109:         Value::Null => mlua::Value::Nil,\n110:         Value::Bool(b) => mlua::Value::Boolean(*b),\n111:         Value::Number(n) => match n.as_i64() {\n112:             Some(i) => mlua::Value::Integer(i),\n113:             None => mlua::Value::Number(n.as_f64().expect(\"a number is i64 or f64\")),\n114:         },\n115:         Value::String(s) => mlua::Value::String(lua.create_string(s)?),\n116:         Value::Array(items) => {\n117:             let t = lua.create_table()?;\n118:             for (i, item) in items.iter().enumerate() {\n119:                 t.set(i + 1, to_lua(lua, item)?)?;\n120:             }\n121:             mlua::Value::Table(t)\n122:         }\n123:         Value::Object(map) => {\n124:             let t = lua.create_table()?;\n125:             for (k, v) in map {\n126:                 t.set(k.as_str(), to_lua(lua, v)?)?;\n127:             }\n128:             mlua::Value::Table(t)\n129:         }\n130:     })\n131: }\n\n(End of file - total 131 lines)\n</content>","metadata":{"preview":"use mlua::Lua;\nuse serde_json::Value;\n\nuse crate::ty::{self, Enums, Type};\n\n/// Check the input against the type the program declared, before anything runs.\n///\n/// This is a parse, not a coercion. `{\"age\": \"36\"}` where `Int` was declared is an error, not a\n/// conversion: the moment input is coerced, the type stops describing the value and the runtime\n/// and the type system have stopped making the same guarantee.\npub fn validate(enums: &Enums, value: &Value, ty: &Type, path: &str) -> Result<(), String> {\n    let found = match (ty, value) {\n        (Type::Str, Value::String(_)) | (Type::Bool, Value::Bool(_)) => return Ok(()),\n\n        (Type::Int, Value::Number(n)) => {\n            // Input is the other place an Int enters, and the 32-bit rule has to hold at both.\n            // Accepting an i64 here left five backends carrying a value the type cannot hold\n            // while Go refused to decode it, which is a disagreement rather than a wrong answer.\n            let Some(n) = n.as_i64() else {\n                return Err(format!(","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/input.rs","text":"use mlua::Lua;\nuse serde_json::Value;\n\nuse crate::ty::{self, Enums, Type};\n\n/// Check the input against the type the program declared, before anything runs.\n///\n/// This is a parse, not a coercion. `{\"age\": \"36\"}` where `Int` was declared is an error, not a\n/// conversion: the moment input is coerced, the type stops describing the value and the runtime\n/// and the type system have stopped making the same guarantee.\npub fn validate(enums: &Enums, value: &Value, ty: &Type, path: &str) -> Result<(), String> {\n    let found = match (ty, value) {\n        (Type::Str, Value::String(_)) | (Type::Bool, Value::Bool(_)) => return Ok(()),\n\n        (Type::Int, Value::Number(n)) => {\n            // Input is the other place an Int enters, and the 32-bit rule has to hold at both.\n            // Accepting an i64 here left five backends carrying a value the type cannot hold\n            // while Go refused to decode it, which is a disagreement rather than a wrong answer.\n            let Some(n) = n.as_i64() else {\n                return Err(format!(\n                    \"{path}: expected Int, found the non-integer number {n}\"\n                ));\n            };\n            return if i32::try_from(n).is_ok() {\n                Ok(())\n            } else {\n                Err(format!(\n                    \"{path}: expected Int, found {n}, which does not fit in 32 bits\"\n                ))\n            };\n        }\n\n        (Type::Float, Value::Number(_)) => {\n            // A Float is the double a JSON number already is (ADR 0007), so every JSON number\n            // -- integer or not -- reads as one, with no exactness to lose the way Int64 does.\n            return Ok(());\n        }\n\n        (Type::Vec(elem), Value::Array(items)) => {\n            for (i, item) in items.iter().enumerate() {\n                validate(enums, item, elem, &format!(\"{path}[{i}]\"))?;\n            }\n            return Ok(());\n        }\n\n        (Type::Record(fields), Value::Object(map)) => {\n            for (name, field_ty) in fields {\n                let Some(v) = map.get(name) else {\n                    return Err(format!(\"{path}: missing field `{name}`\"));\n                };\n                validate(enums, v, field_ty, &format!(\"{path}.{name}\"))?;\n            }\n            // Undeclared fields are ignored rather than rejected, so a program can read two\n            // fields out of a log line without describing the whole line. Open: whether that\n            // is the right call once the type is also used to lay the value out.\n            return Ok(());\n        }\n\n        // One enum value spans two JSON shapes (ADR 0009): a bare string naming a unit\n        // variant, or a single-key object whose key names a payload variant. Everything else\n        // is refused with the enum's name, since \"found a string\" alone would not say which\n        // closed set the string missed.\n        (Type::Enum { name, .. }, v) => {\n            // Read from the registry, not off `ty`: a recursive enum's nested occurrence of\n            // itself carries a placeholder in place of its variants (kantord/toylang#94).\n            let variants = ty::variants(enums, ty);\n            return match v {\n                Value::String(s) => match variants.iter().find(|(n, _)| n == s) {\n                    Some((_, None)) => Ok(()),\n                    Some((_, Some(_))) => Err(format!(\n                        \"{path}: `{s}` is a payload variant of {name}, written {{\\\"{s}\\\": ...}}\"\n                    )),\n                    None => Err(format!(\"{path}: `{s}` is not a variant of {name}\")),\n                },\n                Value::Object(map) if map.len() == 1 => {\n                    let (key, inner) = map.iter().next().expect(\"exactly one entry\");\n                    match variants.iter().find(|(n, _)| n == key) {\n                        Some((_, Some(payload))) => {\n                            validate(enums, inner, payload, &format!(\"{path}.{key}\"))\n                        }\n                        Some((_, None)) => Err(format!(\n                            \"{path}: `{key}` is a unit variant of {name}, written \\\"{key}\\\"\"\n                        )),\n                        None => Err(format!(\"{path}: `{key}` is not a variant of {name}\")),\n                    }\n                }\n                v => Err(format!(\"{path}: expected {name}, found {}\", describe(v))),\n            };\n        }\n\n        (_, v) => describe(v),\n    };\n    Err(format!(\"{path}: expected {ty}, found {found}\"))\n}\n\nfn describe(v: &Value) -> &'static str {\n    match v {\n        Value::Null => \"null\",\n        Value::Bool(_) => \"a boolean\",\n        Value::Number(_) => \"a number\",\n        Value::String(_) => \"a string\",\n        Value::Array(_) => \"an array\",\n        Value::Object(_) => \"an object\",\n    }\n}\n\npub fn to_lua(lua: &Lua, value: &Value) -> mlua::Result<mlua::Value> {\n    Ok(match value {\n        Value::Null => mlua::Value::Nil,\n        Value::Bool(b) => mlua::Value::Boolean(*b),\n        Value::Number(n) => match n.as_i64() {\n            Some(i) => mlua::Value::Integer(i),\n            None => mlua::Value::Number(n.as_f64().expect(\"a number is i64 or f64\")),\n        },\n        Value::String(s) => mlua::Value::String(lua.create_string(s)?),\n        Value::Array(items) => {\n            let t = lua.create_table()?;\n            for (i, item) in items.iter().enumerate() {\n                t.set(i + 1, to_lua(lua, item)?)?;\n            }\n            mlua::Value::Table(t)\n        }\n        Value::Object(map) => {\n            let t = lua.create_table()?;\n            for (k, v) in map {\n                t.set(k.as_str(), to_lua(lua, v)?)?;\n            }\n            mlua::Value::Table(t)\n        }\n    })\n}","lineStart":1,"lineEnd":131,"totalLines":131,"truncated":false}},"title":"src/input.rs","time":{"start":1788384522349,"end":1788384522362}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Key insight: The Lua backend doesn't run a subprocess — it embeds mlua in-process. `src/lib.rs:487` has `run_lua` which uses mlua. So the Lua version is whatever mlua vendors. Let me check Cargo.toml for mlua version. And how input numbers are converted (input.rs:112-113): `Value::Number(n.as_f64())`. For Float input, need to check how Value::Number converts.\n\nLet me read src/lib.rs around run_lua and the input.rs full file. Also check the Cargo.toml.","format":"unknown","index":0}]}},"id":"prt_06406306a00136lLd3Jb2WHkw4","sessionID":"ses_f9bfb8556ffen7Iyy24hTmtXJA","messageID":"msg_0640625b3001hJshsAMpFVxrK2"}}
{"type":"tool_use","timestamp":1788384522366,"sessionID":"ses_f9bfb8556ffen7Iyy24hTmtXJA","part":{"type":"tool","tool":"read","callID":"call_78d9792308494b0a9e024740","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/lib.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/lib.rs</path>\n<type>file</type>\n<content>\n1: pub mod ast;\n2: pub mod check;\n3: pub mod emit_go;\n4: pub mod emit_jq;\n5: pub mod emit_js;\n6: pub mod emit_llvm;\n7: pub mod emit_lua;\n8: pub mod emit_py;\n9: pub mod emit_rs;\n10: pub mod emit_toylang;\n11: pub mod error;\n12: pub mod float;\n13: pub mod fmt_tree;\n14: pub mod input;\n15: pub mod parse;\n16: pub mod prelude;\n17: pub mod tags;\n18: pub mod tir;\n19: pub mod ty;\n20: \n21: use std::cell::RefCell;\n22: use std::io::{BufRead, Write};\n23: use std::rc::Rc;\n24: \n25: use anyhow::{Context, Result};\n26: use error::Error;\n27: use tir::Program;\n28: \n29: #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n30: pub enum Backend {\n31:     Lua,\n32:     Js,\n33:     Native,\n34:     Jq,\n35:     Go,\n36:     Py,\n37:     Rust,\n38: }\n39: \n40: impl Backend {\n41:     /// The backends that must agree on every corpus program. Native and Rust each joined once\n42:     /// they could compile the whole language; until then they were kept out rather than allowed\n43:     /// to turn the harness permanently red, tracked by tests/backend_llvm.rs and\n44:     /// tests/backend_rust.rs respectively.\n45:     pub const ALL: [Backend; 7] = [\n46:         Backend::Lua,\n47:         Backend::Js,\n48:         Backend::Native,\n49:         Backend::Jq,\n50:         Backend::Go,\n51:         Backend::Py,\n52:         Backend::Rust,\n53:     ];\n54: \n55:     /// The spelling used on the command line and in a corpus case's `snapshot` list.\n56:     pub fn from_name(name: &str) -> Option<Backend> {\n57:         Backend::ALL.into_iter().find(|b| b.name() == name)\n58:     }\n59: \n60:     pub fn name(self) -> &'static str {\n61:         match self {\n62:             Backend::Lua => \"lua\",\n63:             Backend::Js => \"js\",\n64:             Backend::Native => \"native\",\n65:             Backend::Jq => \"jq\",\n66:             Backend::Go => \"go\",\n67:             Backend::Py => \"py\",\n68:             Backend::Rust => \"rust\",\n69:         }\n70:     }\n71: \n72:     pub fn emit(self, program: &Program) -> Result<String, String> {\n73:         match self {\n74:             Backend::Lua => Ok(emit_lua::emit(program)),\n75:             Backend::Js => Ok(emit_js::emit(program)),\n76:             Backend::Native => emit_llvm::to_ir(program),\n77:             Backend::Jq => emit_jq::emit(program),\n78:             Backend::Go => Ok(emit_go::emit(program)),\n79:             Backend::Py => Ok(emit_py::emit(program)),\n80:             Backend::Rust => Ok(emit_rs::emit(program)),\n81:         }\n82:     }\n83: }\n84: \n85: pub fn compile(src: &str) -> Result<Program, Error> {\n86:     let mut file = parse::parse(src)?;\n87:     prelude::inject(&mut file);\n88:     check::check(&file)\n89: }\n90: \n91: /// Parses `src` and re-renders it in the canonical toylang style, without checking or injecting\n92: /// the prelude -- a formatter has to work on a program that does not type-check, and it must\n93: /// never print the prelude definitions `compile` splices in for its own purposes.\n94: pub fn fmt(src: &str) -> Result<String, Error> {\n95:     emit_toylang::format_source(src)\n96: }\n97: \n98: pub fn run(src: &str) -> Result<String> {\n99:     run_on(src, None, Backend::Lua)\n100: }\n101: \n102: pub fn run_with_input(src: &str, stdin: Option<&str>) -> Result<String> {\n103:     run_on(src, stdin, Backend::Lua)\n104: }\n105: \n106: /// Whether the generated code for `program` reads `inputs` for itself, one record at a time,\n107: /// rather than needing the whole thing parsed and handed over up front. A type question now,\n108: /// not a shape guess: exactly the programs `tir::fusion` reads from `inputs` -- every backend\n109: /// has a fused loop to emit. An aggregate like `length(collect(inputs))` still has no way to\n110: /// stream no matter which backend runs it. Public so `main.rs` can decide, before it has read\n111: /// anything, whether to drain real stdin itself or hand it to `run_on` untouched.\n112: pub fn streams_inputs(program: &tir::Program) -> bool {\n113:     matches!(\n114:         tir::fusion(program),\n115:         Some(f) if matches!(f.source, tir::Source::Inputs)\n116:     )\n117: }\n118: \n119: /// Compile and run, capturing what the program printed -- except when `stdin` is `None` and\n120: /// `streams_inputs` says the backend reads `inputs` for itself, in which case the real stdin and\n121: /// stdout are connected straight through (`Feed::Live`) and there is nothing left to capture.\n122: /// Capturing otherwise keeps the tests to one call: it also means output is held in memory, which\n123: /// is fine for every program whose result has statically known length, and is exactly the case\n124: /// `Feed::Live` exists for on the ones that no longer do.\n125: pub fn run_on(src: &str, stdin: Option<&str>, backend: Backend) -> Result<String> {\n126:     let program = compile(src)?;\n127: \n128:     // `stdin.is_none()` is the same convention `uses_lines` already uses below: nothing was\n129:     // supplied, which only happens on the real command line, never from a test fixture. Only\n130:     // then is there real live stdin worth handing straight to a subprocess backend rather than\n131:     // something already sitting in memory to validate up front.\n132:     let live_inputs = stdin.is_none() && streams_inputs(&program);\n133:     // Lua is the one backend with no subprocess of its own: `run_lua` itself decides how\n134:     // `inputs` reaches the running chunk, by injecting either a pre-populated global or a\n135:     // per-call function, and the emitted source commits to one of those two shapes purely from\n136:     // `tir::fusion`, independent of whether a fixture or the real command line supplied the\n137:     // bytes. So unlike `live_inputs` above, this also has to hold for a fixture-fed test, or\n138:     // the host would inject the global while the fused source calls the function.\n139:     let lua_fused = matches!(backend, Backend::Lua) && streams_inputs(&program);\n140: \n141:     // The input is checked against the declared type once, here, rather than by each backend.\n142:     // What a backend receives has already been parsed, so no backend re-decides what is valid.\n143:     let value = match (&program.input, stdin) {\n144:         (Some(ty), Some(text)) => {\n145:             let value: serde_json::Value = serde_json::from_str(text)?;\n146:             input::validate(&program.enums, &value, ty, \"input\").map_err(anyhow::Error::msg)?;\n147:             Some(value)\n148:         }\n149:         (Some(ty), None) => anyhow::bail!(\"this program reads input, of type {ty}\"),\n150:         (None, _) => None,\n151:     };\n152: \n153:     // `inputs` is eager like `input`, not incremental like `lines`, so it normally goes through\n154:     // the same validate-then-re-serialize step: every backend receives canonical bytes, one\n155:     // compact JSON value per line, rather than whatever formatting the original text happened to\n156:     // use. `live_inputs` and `lua_fused` are the exceptions -- nothing is precomputed for them,\n157:     // because the whole point of a fused loop is not reading the whole stream before the first\n158:     // record is handled. Validation still happens record-by-record on the host: `run_lua`'s\n159:     // `next_input` function does it for the Lua backend it is embedded in, and `Feed::LiveInputs`\n160:     // below does it for every other, subprocess-based backend, since generated code cannot be\n161:     // trusted to reimplement `input::validate` correctly in six different target languages.\n162:     let inputs_values = if live_inputs || lua_fused {\n163:         None\n164:     } else {\n165:         match (&program.inputs, stdin) {\n166:             (Some(elem_ty), Some(text)) => {\n167:                 let mut values = Vec::new();\n168:                 for line in text.lines().filter(|l| !l.trim().is_empty()) {\n169:                     let value: serde_json::Value = serde_json::from_str(line)?;\n170:                     input::validate(&program.enums, &value, elem_ty, \"inputs\")\n171:                         .map_err(anyhow::Error::msg)?;\n172:                     values.push(value);\n173:                 }\n174:                 Some(values)\n175:             }\n176:             (Some(elem_ty), None) => {\n177:                 anyhow::bail!(\"this program reads inputs, of type Vec<{elem_ty}>\");\n178:             }\n179:             (None, _) => None,\n180:         }\n181:     };\n182: \n183:     // What a backend's stdin should be connected to. `input` always has known bytes: the\n184:     // re-serialized, already-validated value. `lines` has known bytes only when a caller (a\n185:     // corpus fixture, most often) supplied them directly -- and when it does, they are piped in\n186:     // verbatim rather than pre-split, so a backend's own splitting genuinely runs against them\n187:     // rather than being bypassed by the test that is supposed to exercise it. Only when nothing\n188:     // was supplied, which is the real command-line case, does `lines` connect the real stdin\n189:     // straight through, with no Rust-side buffering in between -- the one thing that would make\n190:     // its streaming indistinguishable from having read everything first. A live, fused `inputs`\n191:     // program has no type to lean on the way `lines` does (raw text is always valid `Str`), so it\n192:     // cannot connect the real stdin straight through: `Feed::LiveInputs` reads and validates one\n193:     // record at a time itself and forwards only what passes, real streaming with no read-it-all-\n194:     // first buffering, but through Rust rather than direct fd inheritance. The Lua backend is the\n195:     // one exception -- it validates through its own `next_input` function instead, direct from\n196:     // `Feed::Live`, since it runs embedded rather than as a subprocess with a pipe to mediate.\n197:     // A fused Lua program run against a fixture is not live, but still needs the raw bytes\n198:     // verbatim rather than the eager re-serialized form, since `run_lua`'s injected function does\n199:     // its own splitting the same way `lines` always has.\n200:     let feed = if program.uses_lines || program.dsv.is_some() {\n201:         match stdin {\n202:             Some(text) => Feed::Text(text.to_string()),\n203:             None => Feed::Live,\n204:         }\n205:     } else if live_inputs {\n206:         live_inputs_feed(&program, backend)\n207:     } else if lua_fused {\n208:         Feed::Text(stdin.map(str::to_string).unwrap_or_default())\n209:     } else if let Some(values) = &inputs_values {\n210:         Feed::Text(\n211:             values\n212:                 .iter()\n213:                 .map(|v| v.to_string())\n214:                 .collect::<Vec<_>>()\n215:                 .join(\"\\n\"),\n216:         )\n217:     } else {\n218:         Feed::Text(value.as_ref().map(|v| v.to_string()).unwrap_or_default())\n219:     };\n220: \n221:     match backend {\n222:         Backend::Lua => run_lua(\n223:             &emit_lua::emit(&program),\n224:             &program.enums,\n225:             value.as_ref(),\n226:             inputs_values.as_ref(),\n227:             program.inputs.as_ref(),\n228:             &feed,\n229:         ),\n230:         Backend::Js => run_node(&emit_js::emit(&program), &feed),\n231:         Backend::Jq => run_jq(\n232:             &emit_jq::emit(&program).map_err(anyhow::Error::msg)?,\n233:             JqInvocation {\n234:                 has_value: value.is_some(),\n235:                 raw: matches!(program.body.ty, ty::Type::Str | ty::Type::Sink),\n236:                 uses_lines: program.uses_lines || program.dsv.is_some(),\n237:             },\n238:             &feed,\n239:         ),\n240:         Backend::Go => run_go(&emit_go::emit(&program), &feed),\n241:         Backend::Py => run_py(&emit_py::emit(&program), &feed),\n242:         Backend::Native => {\n243:             let dir = tempfile::tempdir()?;\n244:             let exe = dir.path().join(\"program\");\n245:             link(&program, &exe)?;\n246:             run_binary(&exe, &feed)\n247:         }\n248:         Backend::Rust => {\n249:             let dir = tempfile::tempdir()?;\n250:             let exe = dir.path().join(\"program\");\n251:             link_rust(&emit_rs::emit(&program), &exe)?;\n252:             run_binary(&exe, &feed)\n253:         }\n254:     }\n255: }\n256: \n257: /// The feed for a live, fused `inputs` program: real stdin, but validated. Lua is the exception,\n258: /// since `run_lua`'s own `next_input` function validates directly off `Feed::Live` rather than\n259: /// needing `Feed::LiveInputs` to mediate a pipe it has no subprocess to write into.\n260: fn live_inputs_feed(program: &Program, backend: Backend) -> Feed {\n261:     if matches!(backend, Backend::Lua) {\n262:         Feed::Live\n263:     } else {\n264:         Feed::LiveInputs(\n265:             program\n266:                 .inputs\n267:                 .clone()\n268:                 .expect(\"live_inputs implies an inputs type\"),\n269:             program.enums.clone(),\n270:         )\n271:     }\n272: }\n273: \n274: /// What a subprocess backend's stdin is connected to.\n275: enum Feed {\n276:     /// Known bytes, written through a pipe: `input`'s re-serialized value, a `lines` program's\n277:     /// fixture text verbatim, or nothing for a program that reads no stdin at all.\n278:     Text(String),\n279:     /// The real process stdin, inherited rather than piped. Reachable only for a `lines`\n280:     /// program run with no fixture supplied.\n281:     Live,\n282:     /// The real process stdin, read and validated one record at a time against the element type,\n283:     /// then forwarded through a pipe -- real streaming, but mediated by the host rather than\n284:     /// inherited directly, which is what lets `input::validate` see every record before a\n285:     /// subprocess backend's own, untrusted parse of it does. Reachable only for a live, fused\n286:     /// `inputs` program on a backend other than Lua (see `write_to`).\n287:     LiveInputs(ty::Type, ty::Enums),\n288: }\n289: \n290: impl Feed {\n291:     fn stdio(&self) -> std::process::Stdio {\n292:         match self {\n293:             Feed::Text(_) | Feed::LiveInputs(..) => std::process::Stdio::piped(),\n294:             Feed::Live => std::process::Stdio::inherit(),\n295:         }\n296:     }\n297: \n298:     fn write_to(&self, child: &mut std::process::Child) -> Result<()> {\n299:         match self {\n300:             Feed::Text(text) => {\n301:                 child\n302:                     .stdin\n303:                     .take()\n304:                     .expect(\"piped\")\n305:                     .write_all(text.as_bytes())?;\n306:             }\n307:             Feed::Live => {}\n308:             Feed::LiveInputs(elem_ty, enums) => {\n309:                 let mut stdin = child.stdin.take().expect(\"piped\");\n310:                 for line in std::io::stdin().lock().lines() {\n311:                     let line = line?;\n312:                     if line.trim().is_empty() {\n313:                         continue;\n314:                     }\n315:                     let value: serde_json::Value = serde_json::from_str(&line)?;\n316:                     if let Err(msg) = input::validate(enums, &value, elem_ty, \"inputs\") {\n317:                         // Close the pipe so the child sees EOF and can finish printing whatever\n318:                         // it already validly received, then wait for it before reporting the\n319:                         // refusal -- otherwise this leaves an unreaped child behind.\n320:                         drop(stdin);\n321:                         child.wait()?;\n322:                         return Err(anyhow::Error::msg(msg));\n323:                     }\n324:                     writeln!(stdin, \"{line}\")?;\n325:                 }\n326:             }\n327:         }\n328:         Ok(())\n329:     }\n330: }\n331: \n332: /// Compile to a native executable at `out`.\n333: ///\n334: /// LLVM produces an object file, which is not a program, so this shells out to `cc` for the\n335: /// link. That is a toolchain requirement the Lua backend does not have, since mlua vendors its\n336: /// interpreter.\n337: pub fn link(program: &Program, out: &std::path::Path) -> Result<()> {\n338:     let dir = tempfile::tempdir()?;\n339:     let object = dir.path().join(\"program.o\");\n340:     emit_llvm::compile_to_object(program, &object).map_err(anyhow::Error::msg)?;\n341: \n342:     // The runtime is compiled alongside rather than shipped as a library, which keeps the build\n343:     // to one `cc` call and means there is nothing to install.\n344:     let runtime = dir.path().join(\"toylang.c\");\n345:     std::fs::write(&runtime, emit_llvm::RUNTIME_C)?;\n346: \n347:     let status = std::process::Command::new(\"cc\")\n348:         .arg(&object)\n349:         .arg(&runtime)\n350:         .arg(\"-o\")\n351:         .arg(out)\n352:         .status()\n353:         .context(\"could not run `cc`\")?;\n354:     if !status.success() {\n355:         anyhow::bail!(\"cc failed to link: {status}\");\n356:     }\n357:     Ok(())\n358: }\n359: \n360: /// Compile Rust source to an executable at `out`. One `rustc` call on one self-contained file,\n361: /// no external crate and no Cargo project, the same reason `link` above is one `cc` call: the\n362: /// generated source depends on nothing this compiler did not already assume was installed.\n363: /// Public for the same reason as `link`: `tests/backend_rust.rs` calls it directly, separately\n364: /// from running the result, so a genuine codegen gap (`rustc` rejects the source) is told apart\n365: /// from a legitimate runtime refusal (`rustc` succeeds, the binary exits non-zero).\n366: pub fn link_rust(source: &str, out: &std::path::Path) -> Result<()> {\n367:     let dir = tempfile::tempdir()?;\n368:     let src = dir.path().join(\"program.rs\");\n369:     std::fs::write(&src, source)?;\n370: \n371:     let result = std::process::Command::new(\"rustc\")\n372:         .arg(\"--edition\")\n373:         .arg(\"2021\")\n374:         .arg(&src)\n375:         .arg(\"-o\")\n376:         .arg(out)\n377:         .output()\n378:         .context(\"could not run `rustc`\")?;\n379:     if !result.status.success() {\n380:         anyhow::bail!(\n381:             \"rustc failed to compile: {}\",\n382:             String::from_utf8_lossy(&result.stderr)\n383:         );\n384:     }\n385:     Ok(())\n386: }\n387: \n388: /// Runs `cmd` (already given whatever args the caller needs) connected to `feed`, and returns\n389: /// what it printed.\n390: ///\n391: /// When `feed` is `Feed::Live` or `Feed::LiveInputs` there is no test harness reading the result\n392: /// back: stdout and stderr are inherited straight through to the real terminal or pipe instead of\n393: /// being captured, which is what lets a program that streams actually show output as it produces\n394: /// it rather than all at once when it exits. `Ok(String::new())` reflects that nothing is left to\n395: /// hand back -- it already went to the real stdout directly. `feed.write_to` reports a validation\n396: /// refusal for `Feed::LiveInputs` as an `Err` before this function's own `child.wait()` runs, so\n397: /// that path never reaches here at all.\n398: fn run_subprocess(mut cmd: std::process::Command, label: &str, feed: &Feed) -> Result<String> {\n399:     let live = matches!(feed, Feed::Live | Feed::LiveInputs(..));\n400:     let mut child = cmd\n401:         .stdin(feed.stdio())\n402:         .stdout(if live {\n403:             std::process::Stdio::inherit()\n404:         } else {\n405:             std::process::Stdio::piped()\n406:         })\n407:         .stderr(if live {\n408:             std::process::Stdio::inherit()\n409:         } else {\n410:             std::process::Stdio::piped()\n411:         })\n412:         .spawn()\n413:         .with_context(|| format!(\"could not run `{label}`\"))?;\n414: \n415:     feed.write_to(&mut child)?;\n416: \n417:     if live {\n418:         let status = child.wait()?;\n419:         if !status.success() {\n420:             anyhow::bail!(\"{label} failed\");\n421:         }\n422:         return Ok(String::new());\n423:     }\n424: \n425:     let out = child.wait_with_output()?;\n426:     if !out.status.success() {\n427:         anyhow::bail!(\"{label} failed: {}\", String::from_utf8_lossy(&out.stderr));\n428:     }\n429:     Ok(String::from_utf8(out.stdout)?)\n430: }\n431: \n432: fn run_binary(exe: &std::path::Path, feed: &Feed) -> Result<String> {\n433:     run_subprocess(\n434:         std::process::Command::new(exe),\n435:         \"the compiled program\",\n436:         feed,\n437:     )\n438: }\n439: \n440: /// jq puts stdin in `.`, so a program that reads no input runs with `-n` rather than waiting on\n441: /// a terminal. `has_value` rather than the `Feed` itself, since a `lines` program run live\n442: /// (`Feed::Live`) still has real stdin coming and must not get `-n` on that account.\n443: /// The three facts about a program that shape a jq invocation's flags. Each is derived from\n444: /// the compiled program, not a caller identity -- the fn-params-excessive-bools finding on the\n445: /// old three-bool signature was escalated, and the settled answer was this struct: the facts\n446: /// travel under their names.\n447: struct JqInvocation {\n448:     has_value: bool,\n449:     raw: bool,\n450:     uses_lines: bool,\n451: }\n452: \n453: fn run_jq(source: &str, inv: JqInvocation, feed: &Feed) -> Result<String> {\n454:     let JqInvocation {\n455:         has_value,\n456:         raw,\n457:         uses_lines,\n458:     } = inv;\n459:     let mut cmd = std::process::Command::new(\"jq\");\n460:     // jq's stdout is fully buffered rather than line-buffered whenever it is not a terminal, the\n461:     // same as any other libc stdio program, so a filter over `inputs` piped into another process\n462:     // would otherwise sit on every result until the run ends. `run_subprocess` only inherits\n463:     // stdout instead of capturing it for a live run, so this is still what makes that case show a\n464:     // result as soon as jq produces one rather than at exit.\n465:     cmd.arg(\"--unbuffered\");\n466:     cmd.arg(\"-c\");\n467:     // `-r` decides from the runtime value, so it would print a present Opt<Str> raw and an\n468:     // absent one as the word null. The rule here is the type's, as on every other backend.\n469:     if raw {\n470:         cmd.arg(\"-r\");\n471:     }\n472:     if !has_value && !uses_lines {\n473:         cmd.arg(\"-n\");\n474:     }\n475:     // Raw-input mode, needed for `[ inputs ]` to read lines rather than JSON, and forced by the\n476:     // checker to be the only way `lines` is used in this invocation: mixing it with `input` was\n477:     // rejected there, because `-R` changes what the whole invocation means, not just one call.\n478:     // `-n` here is not \"no input coming\"; it is what raw-input mode needs regardless, since\n479:     // `[ inputs ]` reads for itself rather than through the implicit `.` a normal run would use.\n480:     if uses_lines {\n481:         cmd.arg(\"-R\").arg(\"-n\");\n482:     }\n483:     cmd.arg(source);\n484:     run_subprocess(cmd, \"jq\", feed)\n485: }\n486: \n487: fn run_lua(\n488:     source: &str,\n489:     enums: &ty::Enums,\n490:     value: Option<&serde_json::Value>,\n491:     inputs_values: Option<&Vec<serde_json::Value>>,\n492:     inputs_elem_ty: Option<&ty::Type>,\n493:     feed: &Feed,\n494: ) -> Result<String> {\n495:     let lua = mlua::Lua::new();\n496:     if let Some(value) = value {\n497:         lua.globals()\n498:             .set(emit_lua::INPUT, input::to_lua(&lua, value)?)?;\n499:     }\n500:     if let Some(values) = inputs_values {\n501:         let array = serde_json::Value::Array(values.clone());\n502:         lua.globals()\n503:             .set(emit_lua::INPUTS, input::to_lua(&lua, &array)?)?;\n504:     } else if let Some(elem_ty) = inputs_elem_ty {\n505:         // `inputs_values` is `None` here for one of two reasons: the program does not read\n506:         // `inputs` at all (then `inputs_elem_ty` is also `None`, and neither branch runs), or\n507:         // `run_on` recognized this as a fused program and skipped precomputing the whole Vec on\n508:         // purpose (`live_inputs` or `lua_fused` there). mlua is embedded in this same process, so\n509:         // there is no separate JSON parser to write in Lua source the way Rust's own is -- the\n510:         // generated source just calls this function for the next already-validated, already-\n511:         // converted record. Reading from `feed` rather than always the real stdin is what keeps\n512:         // this correct for a fixture-tested fused program too: `feed` is `Feed::Text` there, the\n513:         // same raw bytes a subprocess backend would have been piped.\n514:         let elem_ty = elem_ty.clone();\n515:         let enums = enums.clone();\n516:         let reader: RefCell<Box<dyn std::io::BufRead>> = RefCell::new(match feed {\n517:             Feed::Live => Box::new(std::io::BufReader::new(std::io::stdin())),\n518:             Feed::Text(text) => Box::new(std::io::Cursor::new(text.clone().into_bytes())),\n519:             // `run_on` never builds this feed for the Lua backend: `live_inputs` there stays\n520:             // `Feed::Live`, since this function's own reader validates each record itself.\n521:             Feed::LiveInputs(..) => unreachable!(\"run_on keeps the Lua backend on Feed::Live\"),\n522:         });\n523:         let next_input = lua.create_function(move |lua, ()| {\n524:             use std::io::BufRead;\n525:             loop {\n526:                 let mut line = String::new();\n527:                 let n = reader\n528:                     .borrow_mut()\n529:                     .read_line(&mut line)\n530:                     .map_err(mlua::Error::external)?;\n531:                 if n == 0 {\n532:                     return Ok(mlua::Value::Nil);\n533:                 }\n534:                 let line = line.strip_suffix('\\n').unwrap_or(&line);\n535:                 if line.trim().is_empty() {\n536:                     continue;\n537:                 }\n538:                 let value: serde_json::Value =\n539:                     serde_json::from_str(line).map_err(mlua::Error::external)?;\n540:                 input::validate(&enums, &value, &elem_ty, \"inputs\")\n541:                     .map_err(mlua::Error::RuntimeError)?;\n542:                 return input::to_lua(lua, &value);\n543:             }\n544:         })?;\n545:         lua.globals().set(emit_lua::NEXT_INPUT, next_input)?;\n546:     }\n547:     // mlua is embedded in this same process, so `io.lines()` in the emitted source reads the\n548:     // real stdin directly -- verified against a live pipe, and exactly what a `lines` program\n549:     // run for real should do. A fixture is different: cargo test runs many tests concurrently\n550:     // in one process, so redirecting the process's own fd 0 would race with all of them, and is\n551:     // not done. Instead the fixture is written to a file of its own and `io.lines` is pointed at\n552:     // it, which keeps Lua's own real line-splitting in the loop rather than reimplementing it in\n553:     // Rust and only testing that reimplementation.\n554:     let _fixture_dir;\n555:     if let Feed::Text(text) = feed {\n556:         let dir = tempfile::tempdir()?;\n557:         let path = dir.path().join(\"stdin.txt\");\n558:         std::fs::write(&path, text)?;\n559:         let path = path\n560:             .to_str()\n561:             .expect(\"a temp path is valid UTF-8\")\n562:             .to_string();\n563:         let io: mlua::Table = lua.globals().get(\"io\")?;\n564:         let real_lines: mlua::Function = io.get(\"lines\")?;\n565:         let fixture =\n566:             lua.create_function(move |_, ()| real_lines.call::<mlua::Value>(path.clone()))?;\n567:         io.set(\"lines\", fixture)?;\n568:         _fixture_dir = Some(dir);\n569:     }\n570: \n571:     // A live run has no test harness reading the result back, the same distinction\n572:     // `run_subprocess` makes for the OS-process backends: `print` writes straight to the real\n573:     // stdout and flushes per call instead of buffering into a string only handed back once the\n574:     // whole chunk finishes.\n575:     let live = matches!(feed, Feed::Live);\n576:     let captured = Rc::new(RefCell::new(String::new()));\n577:     let sink = Rc::clone(&captured);\n578:     let print = lua.create_function(move |_, s: String| {\n579:         if live {\n580:             let mut stdout = std::io::stdout();\n581:             writeln!(stdout, \"{s}\").map_err(mlua::Error::external)?;\n582:             stdout.flush().map_err(mlua::Error::external)?;\n583:         } else {\n584:             sink.borrow_mut().push_str(&s);\n585:             sink.borrow_mut().push('\\n');\n586:         }\n587:         Ok(())\n588:     })?;\n589:     lua.globals().set(\"print\", print)?;\n590: \n591:     lua.load(source).exec()?;\n592: \n593:     if live {\n594:         return Ok(String::new());\n595:     }\n596:     let out = captured.borrow().clone();\n597:     Ok(out)\n598: }\n599: \n600: /// Runs through `python3`. Like `node`, this is an interpreter that has to be on the machine\n601: /// rather than one vendored into the build.\n602: fn run_py(source: &str, feed: &Feed) -> Result<String> {\n603:     let dir = tempfile::tempdir()?;\n604:     let path = dir.path().join(\"program.py\");\n605:     std::fs::write(&path, source)?;\n606: \n607:     let mut cmd = std::process::Command::new(\"python3\");\n608:     cmd.arg(&path);\n609:     run_subprocess(cmd, \"python3\", feed)\n610: }\n611: \n612: /// Runs through `go run`, which compiles and executes in one step. Go has no interpreter, so\n613: /// this is the second backend that needs a real toolchain; like `node` and `cc`, a missing one\n614: /// is an error rather than a skipped backend.\n615: fn run_go(source: &str, feed: &Feed) -> Result<String> {\n616:     let dir = tempfile::tempdir()?;\n617:     let path = dir.path().join(\"main.go\");\n618:     std::fs::write(&path, source)?;\n619: \n620:     let mut cmd = std::process::Command::new(\"go\");\n621:     cmd.arg(\"run\").arg(&path);\n622:     run_subprocess(cmd, \"go\", feed)\n623: }\n624: \n625: /// Runs through `node`, which must be present. A missing toolchain is an error rather than a\n626: /// quietly skipped backend: a report that says two backends agreed when only one ran is worse\n627: /// than no report.\n628: fn run_node(source: &str, feed: &Feed) -> Result<String> {\n629:     let dir = tempfile::tempdir()?;\n630:     let path = dir.path().join(\"program.js\");\n631:     std::fs::write(&path, source)?;\n632: \n633:     let mut cmd = std::process::Command::new(\"node\");\n634:     cmd.arg(&path);\n635:     run_subprocess(cmd, \"node\", feed)\n636: }\n637: \n638: impl std::error::Error for Error {}\n\n(End of file - total 638 lines)\n</content>","metadata":{"preview":"pub mod ast;\npub mod check;\npub mod emit_go;\npub mod emit_jq;\npub mod emit_js;\npub mod emit_llvm;\npub mod emit_lua;\npub mod emit_py;\npub mod emit_rs;\npub mod emit_toylang;\npub mod error;\npub mod float;\npub mod fmt_tree;\npub mod input;\npub mod parse;\npub mod prelude;\npub mod tags;\npub mod tir;\npub mod ty;\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/lib.rs","text":"pub mod ast;\npub mod check;\npub mod emit_go;\npub mod emit_jq;\npub mod emit_js;\npub mod emit_llvm;\npub mod emit_lua;\npub mod emit_py;\npub mod emit_rs;\npub mod emit_toylang;\npub mod error;\npub mod float;\npub mod fmt_tree;\npub mod input;\npub mod parse;\npub mod prelude;\npub mod tags;\npub mod tir;\npub mod ty;\n\nuse std::cell::RefCell;\nuse std::io::{BufRead, Write};\nuse std::rc::Rc;\n\nuse anyhow::{Context, Result};\nuse error::Error;\nuse tir::Program;\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum Backend {\n    Lua,\n    Js,\n    Native,\n    Jq,\n    Go,\n    Py,\n    Rust,\n}\n\nimpl Backend {\n    /// The backends that must agree on every corpus program. Native and Rust each joined once\n    /// they could compile the whole language; until then they were kept out rather than allowed\n    /// to turn the harness permanently red, tracked by tests/backend_llvm.rs and\n    /// tests/backend_rust.rs respectively.\n    pub const ALL: [Backend; 7] = [\n        Backend::Lua,\n        Backend::Js,\n        Backend::Native,\n        Backend::Jq,\n        Backend::Go,\n        Backend::Py,\n        Backend::Rust,\n    ];\n\n    /// The spelling used on the command line and in a corpus case's `snapshot` list.\n    pub fn from_name(name: &str) -> Option<Backend> {\n        Backend::ALL.into_iter().find(|b| b.name() == name)\n    }\n\n    pub fn name(self) -> &'static str {\n        match self {\n            Backend::Lua => \"lua\",\n            Backend::Js => \"js\",\n            Backend::Native => \"native\",\n            Backend::Jq => \"jq\",\n            Backend::Go => \"go\",\n            Backend::Py => \"py\",\n            Backend::Rust => \"rust\",\n        }\n    }\n\n    pub fn emit(self, program: &Program) -> Result<String, String> {\n        match self {\n            Backend::Lua => Ok(emit_lua::emit(program)),\n            Backend::Js => Ok(emit_js::emit(program)),\n            Backend::Native => emit_llvm::to_ir(program),\n            Backend::Jq => emit_jq::emit(program),\n            Backend::Go => Ok(emit_go::emit(program)),\n            Backend::Py => Ok(emit_py::emit(program)),\n            Backend::Rust => Ok(emit_rs::emit(program)),\n        }\n    }\n}\n\npub fn compile(src: &str) -> Result<Program, Error> {\n    let mut file = parse::parse(src)?;\n    prelude::inject(&mut file);\n    check::check(&file)\n}\n\n/// Parses `src` and re-renders it in the canonical toylang style, without checking or injecting\n/// the prelude -- a formatter has to work on a program that does not type-check, and it must\n/// never print the prelude definitions `compile` splices in for its own purposes.\npub fn fmt(src: &str) -> Result<String, Error> {\n    emit_toylang::format_source(src)\n}\n\npub fn run(src: &str) -> Result<String> {\n    run_on(src, None, Backend::Lua)\n}\n\npub fn run_with_input(src: &str, stdin: Option<&str>) -> Result<String> {\n    run_on(src, stdin, Backend::Lua)\n}\n\n/// Whether the generated code for `program` reads `inputs` for itself, one record at a time,\n/// rather than needing the whole thing parsed and handed over up front. A type question now,\n/// not a shape guess: exactly the programs `tir::fusion` reads from `inputs` -- every backend\n/// has a fused loop to emit. An aggregate like `length(collect(inputs))` still has no way to\n/// stream no matter which backend runs it. Public so `main.rs` can decide, before it has read\n/// anything, whether to drain real stdin itself or hand it to `run_on` untouched.\npub fn streams_inputs(program: &tir::Program) -> bool {\n    matches!(\n        tir::fusion(program),\n        Some(f) if matches!(f.source, tir::Source::Inputs)\n    )\n}\n\n/// Compile and run, capturing what the program printed -- except when `stdin` is `None` and\n/// `streams_inputs` says the backend reads `inputs` for itself, in which case the real stdin and\n/// stdout are connected straight through (`Feed::Live`) and there is nothing left to capture.\n/// Capturing otherwise keeps the tests to one call: it also means output is held in memory, which\n/// is fine for every program whose result has statically known length, and is exactly the case\n/// `Feed::Live` exists for on the ones that no longer do.\npub fn run_on(src: &str, stdin: Option<&str>, backend: Backend) -> Result<String> {\n    let program = compile(src)?;\n\n    // `stdin.is_none()` is the same convention `uses_lines` already uses below: nothing was\n    // supplied, which only happens on the real command line, never from a test fixture. Only\n    // then is there real live stdin worth handing straight to a subprocess backend rather than\n    // something already sitting in memory to validate up front.\n    let live_inputs = stdin.is_none() && streams_inputs(&program);\n    // Lua is the one backend with no subprocess of its own: `run_lua` itself decides how\n    // `inputs` reaches the running chunk, by injecting either a pre-populated global or a\n    // per-call function, and the emitted source commits to one of those two shapes purely from\n    // `tir::fusion`, independent of whether a fixture or the real command line supplied the\n    // bytes. So unlike `live_inputs` above, this also has to hold for a fixture-fed test, or\n    // the host would inject the global while the fused source calls the function.\n    let lua_fused = matches!(backend, Backend::Lua) && streams_inputs(&program);\n\n    // The input is checked against the declared type once, here, rather than by each backend.\n    // What a backend receives has already been parsed, so no backend re-decides what is valid.\n    let value = match (&program.input, stdin) {\n        (Some(ty), Some(text)) => {\n            let value: serde_json::Value = serde_json::from_str(text)?;\n            input::validate(&program.enums, &value, ty, \"input\").map_err(anyhow::Error::msg)?;\n            Some(value)\n        }\n        (Some(ty), None) => anyhow::bail!(\"this program reads input, of type {ty}\"),\n        (None, _) => None,\n    };\n\n    // `inputs` is eager like `input`, not incremental like `lines`, so it normally goes through\n    // the same validate-then-re-serialize step: every backend receives canonical bytes, one\n    // compact JSON value per line, rather than whatever formatting the original text happened to\n    // use. `live_inputs` and `lua_fused` are the exceptions -- nothing is precomputed for them,\n    // because the whole point of a fused loop is not reading the whole stream before the first\n    // record is handled. Validation still happens record-by-record on the host: `run_lua`'s\n    // `next_input` function does it for the Lua backend it is embedded in, and `Feed::LiveInputs`\n    // below does it for every other, subprocess-based backend, since generated code cannot be\n    // trusted to reimplement `input::validate` correctly in six different target languages.\n    let inputs_values = if live_inputs || lua_fused {\n        None\n    } else {\n        match (&program.inputs, stdin) {\n            (Some(elem_ty), Some(text)) => {\n                let mut values = Vec::new();\n                for line in text.lines().filter(|l| !l.trim().is_empty()) {\n                    let value: serde_json::Value = serde_json::from_str(line)?;\n                    input::validate(&program.enums, &value, elem_ty, \"inputs\")\n                        .map_err(anyhow::Error::msg)?;\n                    values.push(value);\n                }\n                Some(values)\n            }\n            (Some(elem_ty), None) => {\n                anyhow::bail!(\"this program reads inputs, of type Vec<{elem_ty}>\");\n            }\n            (None, _) => None,\n        }\n    };\n\n    // What a backend's stdin should be connected to. `input` always has known bytes: the\n    // re-serialized, already-validated value. `lines` has known bytes only when a caller (a\n    // corpus fixture, most often) supplied them directly -- and when it does, they are piped in\n    // verbatim rather than pre-split, so a backend's own splitting genuinely runs against them\n    // rather than being bypassed by the test that is supposed to exercise it. Only when nothing\n    // was supplied, which is the real command-line case, does `lines` connect the real stdin\n    // straight through, with no Rust-side buffering in between -- the one thing that would make\n    // its streaming indistinguishable from having read everything first. A live, fused `inputs`\n    // program has no type to lean on the way `lines` does (raw text is always valid `Str`), so it\n    // cannot connect the real stdin straight through: `Feed::LiveInputs` reads and validates one\n    // record at a time itself and forwards only what passes, real streaming with no read-it-all-\n    // first buffering, but through Rust rather than direct fd inheritance. The Lua backend is the\n    // one exception -- it validates through its own `next_input` function instead, direct from\n    // `Feed::Live`, since it runs embedded rather than as a subprocess with a pipe to mediate.\n    // A fused Lua program run against a fixture is not live, but still needs the raw bytes\n    // verbatim rather than the eager re-serialized form, since `run_lua`'s injected function does\n    // its own splitting the same way `lines` always has.\n    let feed = if program.uses_lines || program.dsv.is_some() {\n        match stdin {\n            Some(text) => Feed::Text(text.to_string()),\n            None => Feed::Live,\n        }\n    } else if live_inputs {\n        live_inputs_feed(&program, backend)\n    } else if lua_fused {\n        Feed::Text(stdin.map(str::to_string).unwrap_or_default())\n    } else if let Some(values) = &inputs_values {\n        Feed::Text(\n            values\n                .iter()\n                .map(|v| v.to_string())\n                .collect::<Vec<_>>()\n                .join(\"\\n\"),\n        )\n    } else {\n        Feed::Text(value.as_ref().map(|v| v.to_string()).unwrap_or_default())\n    };\n\n    match backend {\n        Backend::Lua => run_lua(\n            &emit_lua::emit(&program),\n            &program.enums,\n            value.as_ref(),\n            inputs_values.as_ref(),\n            program.inputs.as_ref(),\n            &feed,\n        ),\n        Backend::Js => run_node(&emit_js::emit(&program), &feed),\n        Backend::Jq => run_jq(\n            &emit_jq::emit(&program).map_err(anyhow::Error::msg)?,\n            JqInvocation {\n                has_value: value.is_some(),\n                raw: matches!(program.body.ty, ty::Type::Str | ty::Type::Sink),\n                uses_lines: program.uses_lines || program.dsv.is_some(),\n            },\n            &feed,\n        ),\n        Backend::Go => run_go(&emit_go::emit(&program), &feed),\n        Backend::Py => run_py(&emit_py::emit(&program), &feed),\n        Backend::Native => {\n            let dir = tempfile::tempdir()?;\n            let exe = dir.path().join(\"program\");\n            link(&program, &exe)?;\n            run_binary(&exe, &feed)\n        }\n        Backend::Rust => {\n            let dir = tempfile::tempdir()?;\n            let exe = dir.path().join(\"program\");\n            link_rust(&emit_rs::emit(&program), &exe)?;\n            run_binary(&exe, &feed)\n        }\n    }\n}\n\n/// The feed for a live, fused `inputs` program: real stdin, but validated. Lua is the exception,\n/// since `run_lua`'s own `next_input` function validates directly off `Feed::Live` rather than\n/// needing `Feed::LiveInputs` to mediate a pipe it has no subprocess to write into.\nfn live_inputs_feed(program: &Program, backend: Backend) -> Feed {\n    if matches!(backend, Backend::Lua) {\n        Feed::Live\n    } else {\n        Feed::LiveInputs(\n            program\n                .inputs\n                .clone()\n                .expect(\"live_inputs implies an inputs type\"),\n            program.enums.clone(),\n        )\n    }\n}\n\n/// What a subprocess backend's stdin is connected to.\nenum Feed {\n    /// Known bytes, written through a pipe: `input`'s re-serialized value, a `lines` program's\n    /// fixture text verbatim, or nothing for a program that reads no stdin at all.\n    Text(String),\n    /// The real process stdin, inherited rather than piped. Reachable only for a `lines`\n    /// program run with no fixture supplied.\n    Live,\n    /// The real process stdin, read and validated one record at a time against the element type,\n    /// then forwarded through a pipe -- real streaming, but mediated by the host rather than\n    /// inherited directly, which is what lets `input::validate` see every record before a\n    /// subprocess backend's own, untrusted parse of it does. Reachable only for a live, fused\n    /// `inputs` program on a backend other than Lua (see `write_to`).\n    LiveInputs(ty::Type, ty::Enums),\n}\n\nimpl Feed {\n    fn stdio(&self) -> std::process::Stdio {\n        match self {\n            Feed::Text(_) | Feed::LiveInputs(..) => std::process::Stdio::piped(),\n            Feed::Live => std::process::Stdio::inherit(),\n        }\n    }\n\n    fn write_to(&self, child: &mut std::process::Child) -> Result<()> {\n        match self {\n            Feed::Text(text) => {\n                child\n                    .stdin\n                    .take()\n                    .expect(\"piped\")\n                    .write_all(text.as_bytes())?;\n            }\n            Feed::Live => {}\n            Feed::LiveInputs(elem_ty, enums) => {\n                let mut stdin = child.stdin.take().expect(\"piped\");\n                for line in std::io::stdin().lock().lines() {\n                    let line = line?;\n                    if line.trim().is_empty() {\n                        continue;\n                    }\n                    let value: serde_json::Value = serde_json::from_str(&line)?;\n                    if let Err(msg) = input::validate(enums, &value, elem_ty, \"inputs\") {\n                        // Close the pipe so the child sees EOF and can finish printing whatever\n                        // it already validly received, then wait for it before reporting the\n                        // refusal -- otherwise this leaves an unreaped child behind.\n                        drop(stdin);\n                        child.wait()?;\n                        return Err(anyhow::Error::msg(msg));\n                    }\n                    writeln!(stdin, \"{line}\")?;\n                }\n            }\n        }\n        Ok(())\n    }\n}\n\n/// Compile to a native executable at `out`.\n///\n/// LLVM produces an object file, which is not a program, so this shells out to `cc` for the\n/// link. That is a toolchain requirement the Lua backend does not have, since mlua vendors its\n/// interpreter.\npub fn link(program: &Program, out: &std::path::Path) -> Result<()> {\n    let dir = tempfile::tempdir()?;\n    let object = dir.path().join(\"program.o\");\n    emit_llvm::compile_to_object(program, &object).map_err(anyhow::Error::msg)?;\n\n    // The runtime is compiled alongside rather than shipped as a library, which keeps the build\n    // to one `cc` call and means there is nothing to install.\n    let runtime = dir.path().join(\"toylang.c\");\n    std::fs::write(&runtime, emit_llvm::RUNTIME_C)?;\n\n    let status = std::process::Command::new(\"cc\")\n        .arg(&object)\n        .arg(&runtime)\n        .arg(\"-o\")\n        .arg(out)\n        .status()\n        .context(\"could not run `cc`\")?;\n    if !status.success() {\n        anyhow::bail!(\"cc failed to link: {status}\");\n    }\n    Ok(())\n}\n\n/// Compile Rust source to an executable at `out`. One `rustc` call on one self-contained file,\n/// no external crate and no Cargo project, the same reason `link` above is one `cc` call: the\n/// generated source depends on nothing this compiler did not already assume was installed.\n/// Public for the same reason as `link`: `tests/backend_rust.rs` calls it directly, separately\n/// from running the result, so a genuine codegen gap (`rustc` rejects the source) is told apart\n/// from a legitimate runtime refusal (`rustc` succeeds, the binary exits non-zero).\npub fn link_rust(source: &str, out: &std::path::Path) -> Result<()> {\n    let dir = tempfile::tempdir()?;\n    let src = dir.path().join(\"program.rs\");\n    std::fs::write(&src, source)?;\n\n    let result = std::process::Command::new(\"rustc\")\n        .arg(\"--edition\")\n        .arg(\"2021\")\n        .arg(&src)\n        .arg(\"-o\")\n        .arg(out)\n        .output()\n        .context(\"could not run `rustc`\")?;\n    if !result.status.success() {\n        anyhow::bail!(\n            \"rustc failed to compile: {}\",\n            String::from_utf8_lossy(&result.stderr)\n        );\n    }\n    Ok(())\n}\n\n/// Runs `cmd` (already given whatever args the caller needs) connected to `feed`, and returns\n/// what it printed.\n///\n/// When `feed` is `Feed::Live` or `Feed::LiveInputs` there is no test harness reading the result\n/// back: stdout and stderr are inherited straight through to the real terminal or pipe instead of\n/// being captured, which is what lets a program that streams actually show output as it produces\n/// it rather than all at once when it exits. `Ok(String::new())` reflects that nothing is left to\n/// hand back -- it already went to the real stdout directly. `feed.write_to` reports a validation\n/// refusal for `Feed::LiveInputs` as an `Err` before this function's own `child.wait()` runs, so\n/// that path never reaches here at all.\nfn run_subprocess(mut cmd: std::process::Command, label: &str, feed: &Feed) -> Result<String> {\n    let live = matches!(feed, Feed::Live | Feed::LiveInputs(..));\n    let mut child = cmd\n        .stdin(feed.stdio())\n        .stdout(if live {\n            std::process::Stdio::inherit()\n        } else {\n            std::process::Stdio::piped()\n        })\n        .stderr(if live {\n            std::process::Stdio::inherit()\n        } else {\n            std::process::Stdio::piped()\n        })\n        .spawn()\n        .with_context(|| format!(\"could not run `{label}`\"))?;\n\n    feed.write_to(&mut child)?;\n\n    if live {\n        let status = child.wait()?;\n        if !status.success() {\n            anyhow::bail!(\"{label} failed\");\n        }\n        return Ok(String::new());\n    }\n\n    let out = child.wait_with_output()?;\n    if !out.status.success() {\n        anyhow::bail!(\"{label} failed: {}\", String::from_utf8_lossy(&out.stderr));\n    }\n    Ok(String::from_utf8(out.stdout)?)\n}\n\nfn run_binary(exe: &std::path::Path, feed: &Feed) -> Result<String> {\n    run_subprocess(\n        std::process::Command::new(exe),\n        \"the compiled program\",\n        feed,\n    )\n}\n\n/// jq puts stdin in `.`, so a program that reads no input runs with `-n` rather than waiting on\n/// a terminal. `has_value` rather than the `Feed` itself, since a `lines` program run live\n/// (`Feed::Live`) still has real stdin coming and must not get `-n` on that account.\n/// The three facts about a program that shape a jq invocation's flags. Each is derived from\n/// the compiled program, not a caller identity -- the fn-params-excessive-bools finding on the\n/// old three-bool signature was escalated, and the settled answer was this struct: the facts\n/// travel under their names.\nstruct JqInvocation {\n    has_value: bool,\n    raw: bool,\n    uses_lines: bool,\n}\n\nfn run_jq(source: &str, inv: JqInvocation, feed: &Feed) -> Result<String> {\n    let JqInvocation {\n        has_value,\n        raw,\n        uses_lines,\n    } = inv;\n    let mut cmd = std::process::Command::new(\"jq\");\n    // jq's stdout is fully buffered rather than line-buffered whenever it is not a terminal, the\n    // same as any other libc stdio program, so a filter over `inputs` piped into another process\n    // would otherwise sit on every result until the run ends. `run_subprocess` only inherits\n    // stdout instead of capturing it for a live run, so this is still what makes that case show a\n    // result as soon as jq produces one rather than at exit.\n    cmd.arg(\"--unbuffered\");\n    cmd.arg(\"-c\");\n    // `-r` decides from the runtime value, so it would print a present Opt<Str> raw and an\n    // absent one as the word null. The rule here is the type's, as on every other backend.\n    if raw {\n        cmd.arg(\"-r\");\n    }\n    if !has_value && !uses_lines {\n        cmd.arg(\"-n\");\n    }\n    // Raw-input mode, needed for `[ inputs ]` to read lines rather than JSON, and forced by the\n    // checker to be the only way `lines` is used in this invocation: mixing it with `input` was\n    // rejected there, because `-R` changes what the whole invocation means, not just one call.\n    // `-n` here is not \"no input coming\"; it is what raw-input mode needs regardless, since\n    // `[ inputs ]` reads for itself rather than through the implicit `.` a normal run would use.\n    if uses_lines {\n        cmd.arg(\"-R\").arg(\"-n\");\n    }\n    cmd.arg(source);\n    run_subprocess(cmd, \"jq\", feed)\n}\n\nfn run_lua(\n    source: &str,\n    enums: &ty::Enums,\n    value: Option<&serde_json::Value>,\n    inputs_values: Option<&Vec<serde_json::Value>>,\n    inputs_elem_ty: Option<&ty::Type>,\n    feed: &Feed,\n) -> Result<String> {\n    let lua = mlua::Lua::new();\n    if let Some(value) = value {\n        lua.globals()\n            .set(emit_lua::INPUT, input::to_lua(&lua, value)?)?;\n    }\n    if let Some(values) = inputs_values {\n        let array = serde_json::Value::Array(values.clone());\n        lua.globals()\n            .set(emit_lua::INPUTS, input::to_lua(&lua, &array)?)?;\n    } else if let Some(elem_ty) = inputs_elem_ty {\n        // `inputs_values` is `None` here for one of two reasons: the program does not read\n        // `inputs` at all (then `inputs_elem_ty` is also `None`, and neither branch runs), or\n        // `run_on` recognized this as a fused program and skipped precomputing the whole Vec on\n        // purpose (`live_inputs` or `lua_fused` there). mlua is embedded in this same process, so\n        // there is no separate JSON parser to write in Lua source the way Rust's own is -- the\n        // generated source just calls this function for the next already-validated, already-\n        // converted record. Reading from `feed` rather than always the real stdin is what keeps\n        // this correct for a fixture-tested fused program too: `feed` is `Feed::Text` there, the\n        // same raw bytes a subprocess backend would have been piped.\n        let elem_ty = elem_ty.clone();\n        let enums = enums.clone();\n        let reader: RefCell<Box<dyn std::io::BufRead>> = RefCell::new(match feed {\n            Feed::Live => Box::new(std::io::BufReader::new(std::io::stdin())),\n            Feed::Text(text) => Box::new(std::io::Cursor::new(text.clone().into_bytes())),\n            // `run_on` never builds this feed for the Lua backend: `live_inputs` there stays\n            // `Feed::Live`, since this function's own reader validates each record itself.\n            Feed::LiveInputs(..) => unreachable!(\"run_on keeps the Lua backend on Feed::Live\"),\n        });\n        let next_input = lua.create_function(move |lua, ()| {\n            use std::io::BufRead;\n            loop {\n                let mut line = String::new();\n                let n = reader\n                    .borrow_mut()\n                    .read_line(&mut line)\n                    .map_err(mlua::Error::external)?;\n                if n == 0 {\n                    return Ok(mlua::Value::Nil);\n                }\n                let line = line.strip_suffix('\\n').unwrap_or(&line);\n                if line.trim().is_empty() {\n                    continue;\n                }\n                let value: serde_json::Value =\n                    serde_json::from_str(line).map_err(mlua::Error::external)?;\n                input::validate(&enums, &value, &elem_ty, \"inputs\")\n                    .map_err(mlua::Error::RuntimeError)?;\n                return input::to_lua(lua, &value);\n            }\n        })?;\n        lua.globals().set(emit_lua::NEXT_INPUT, next_input)?;\n    }\n    // mlua is embedded in this same process, so `io.lines()` in the emitted source reads the\n    // real stdin directly -- verified against a live pipe, and exactly what a `lines` program\n    // run for real should do. A fixture is different: cargo test runs many tests concurrently\n    // in one process, so redirecting the process's own fd 0 would race with all of them, and is\n    // not done. Instead the fixture is written to a file of its own and `io.lines` is pointed at\n    // it, which keeps Lua's own real line-splitting in the loop rather than reimplementing it in\n    // Rust and only testing that reimplementation.\n    let _fixture_dir;\n    if let Feed::Text(text) = feed {\n        let dir = tempfile::tempdir()?;\n        let path = dir.path().join(\"stdin.txt\");\n        std::fs::write(&path, text)?;\n        let path = path\n            .to_str()\n            .expect(\"a temp path is valid UTF-8\")\n            .to_string();\n        let io: mlua::Table = lua.globals().get(\"io\")?;\n        let real_lines: mlua::Function = io.get(\"lines\")?;\n        let fixture =\n            lua.create_function(move |_, ()| real_lines.call::<mlua::Value>(path.clone()))?;\n        io.set(\"lines\", fixture)?;\n        _fixture_dir = Some(dir);\n    }\n\n    // A live run has no test harness reading the result back, the same distinction\n    // `run_subprocess` makes for the OS-process backends: `print` writes straight to the real\n    // stdout and flushes per call instead of buffering into a string only handed back once the\n    // whole chunk finishes.\n    let live = matches!(feed, Feed::Live);\n    let captured = Rc::new(RefCell::new(String::new()));\n    let sink = Rc::clone(&captured);\n    let print = lua.create_function(move |_, s: String| {\n        if live {\n            let mut stdout = std::io::stdout();\n            writeln!(stdout, \"{s}\").map_err(mlua::Error::external)?;\n            stdout.flush().map_err(mlua::Error::external)?;\n        } else {\n            sink.borrow_mut().push_str(&s);\n            sink.borrow_mut().push('\\n');\n        }\n        Ok(())\n    })?;\n    lua.globals().set(\"print\", print)?;\n\n    lua.load(source).exec()?;\n\n    if live {\n        return Ok(String::new());\n    }\n    let out = captured.borrow().clone();\n    Ok(out)\n}\n\n/// Runs through `python3`. Like `node`, this is an interpreter that has to be on the machine\n/// rather than one vendored into the build.\nfn run_py(source: &str, feed: &Feed) -> Result<String> {\n    let dir = tempfile::tempdir()?;\n    let path = dir.path().join(\"program.py\");\n    std::fs::write(&path, source)?;\n\n    let mut cmd = std::process::Command::new(\"python3\");\n    cmd.arg(&path);\n    run_subprocess(cmd, \"python3\", feed)\n}\n\n/// Runs through `go run`, which compiles and executes in one step. Go has no interpreter, so\n/// this is the second backend that needs a real toolchain; like `node` and `cc`, a missing one\n/// is an error rather than a skipped backend.\nfn run_go(source: &str, feed: &Feed) -> Result<String> {\n    let dir = tempfile::tempdir()?;\n    let path = dir.path().join(\"main.go\");\n    std::fs::write(&path, source)?;\n\n    let mut cmd = std::process::Command::new(\"go\");\n    cmd.arg(\"run\").arg(&path);\n    run_subprocess(cmd, \"go\", feed)\n}\n\n/// Runs through `node`, which must be present. A missing toolchain is an error rather than a\n/// quietly skipped backend: a report that says two backends agreed when only one ran is worse\n/// than no report.\nfn run_node(source: &str, feed: &Feed) -> Result<String> {\n    let dir = tempfile::tempdir()?;\n    let path = dir.path().join(\"program.js\");\n    std::fs::write(&path, source)?;\n\n    let mut cmd = std::process::Command::new(\"node\");\n    cmd.arg(&path);\n    run_subprocess(cmd, \"node\", feed)\n}\n\nimpl std::error::Error for Error {}","lineStart":1,"lineEnd":638,"totalLines":638,"truncated":false}},"title":"src/lib.rs","time":{"start":1788384522352,"end":1788384522363}},"id":"prt_06406306e001t9kInlvqRPvwUB","sessionID":"ses_f9bfb8556ffen7Iyy24hTmtXJA","messageID":"msg_0640625b3001hJshsAMpFVxrK2"}}
