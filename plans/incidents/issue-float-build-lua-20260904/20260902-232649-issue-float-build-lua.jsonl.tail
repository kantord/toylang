nction(move |_, s: String| {\n\n  Line 581:             writeln!(stdout, \"{s}\").map_err(mlua::Error::external)?;\n\n  Line 582:             stdout.flush().map_err(mlua::Error::external)?;\n\n  Line 589:     lua.globals().set(\"print\", print)?;\n\n  Line 591:     lua.load(source).exec()?;\n\n\n/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/input.rs:\n  Line 1: use mlua::Lua;\n\n  Line 107: pub fn to_lua(lua: &Lua, value: &Value) -> mlua::Result<mlua::Value> {\n\n  Line 109:         Value::Null => mlua::Value::Nil,\n\n  Line 110:         Value::Bool(b) => mlua::Value::Boolean(*b),\n\n  Line 112:             Some(i) => mlua::Value::Integer(i),\n\n  Line 113:             None => mlua::Value::Number(n.as_f64().expect(\"a number is i64 or f64\")),\n\n  Line 115:         Value::String(s) => mlua::Value::String(lua.create_string(s)?),\n\n  Line 117:             let t = lua.create_table()?;\n\n  Line 119:                 t.set(i + 1, to_lua(lua, item)?)?;\n\n  Line 121:             mlua::Value::Table(t)\n\n  Line 124:             let t = lua.create_table()?;\n\n  Line 126:                 t.set(k.as_str(), to_lua(lua, v)?)?;\n\n  Line 128:             mlua::Value::Table(t)\n\n\n/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/emit_rs.rs:\n  Line 1097:             // The bound is evaluated once; the loop counter is the element. A negative bound\n\n  Line 1250:                 // evaluated only for whatever else it does (a division inside it must still\n\n\n/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/emit_py.rs:\n  Line 329:         // The bound is evaluated once; the loop counter is the element. A negative bound makes\n\n\n/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/emit_lua.rs:\n  Line 10: /// The function `run_lua` injects in place of `INPUTS` for a fused, live-streamable program:\n\n  Line 409:         // The bound is evaluated once; the loop counter is the element. A negative bound makes\n\n  Line 490:                     let read = format!(\"{value}[{}]\", lua_string(name));\n\n  Line 491:                     let key = lua_string(&format!(\"\\\"{name}\\\":\"));\n\n  Line 520:         let read = format!(\"{n}[{}]\", lua_string(vname));\n\n  Line 523:             lua_string(&format!(\"{{\\\"{vname}\\\":\")),\n\n  Line 615:         return format!(\"({} {} {})\", expr(enums, lhs), lua_op(op), expr(enums, rhs));\n\n  Line 788:         Kind::Str(s) => lua_string(s),\n\n  Line 800:             lua_string(delim)\n\n  Line 806:                 .map(|(name, value)| format!(\"[{}] = {}\", lua_string(name), expr(enums, value)))\n\n  Line 816:             None => lua_string(variant),\n\n  Line 817:             Some(p) => format!(\"({{[{}] = {}}})\", lua_string(variant), expr(enums, p)),\n\n  Line 870:                 let names: Vec<String> = fields.iter().map(|(n, _)| lua_string(n)).collect();\n\n  Line 967:                 format!(\"{}[{}]\", expr(enums, base), lua_string(name))\n\n  Line 972:                     lua_string(name),\n\n  Line 999:                         lua_string(variant)\n\n  Line 1005:                         Some(format!(\"{subj}[{}] ~= nil\", lua_string(v)))\n\n  Line 1007:                     (Some(v), _) => Some(format!(\"{subj} == {}\", lua_string(v))),\n\n  Line 1051: fn lua_op(op: BinOp) -> &'static str {\n\n  Line 1063: fn lua_string(s: &str) -> String {\n\n\n/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/emit_llvm.rs:\n  Line 993:             // may itself emit a loop, and a select would evaluate both sides.\n\n  Line 1611:             // of a rendering: compare the box's tag against a variant arm's index, evaluate a\n\n  Line 2202:     /// take both operands already evaluated: the right side of `x != 0 and 10 / x > 1` must not\n\n\n/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/emit_js.rs:\n  Line 88: const COLLECT_HELPER: &str = r#\"// Synchronous, because a toylang expression evaluates to