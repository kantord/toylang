tly -- verified against a live pipe, and exactly what a `lines` program\n549:     // run for real should do. A fixture is different: cargo test runs many tests concurrently\n550:     // in one process, so redirecting the process's own fd 0 would race with all of them, and is\n551:     // not done. Instead the fixture is written to a file of its own and `io.lines` is pointed at\n552:     // it, which keeps Lua's own real line-splitting in the loop rather than reimplementing it in\n553:     // Rust and only testing that reimplementation.\n554:     let _fixture_dir;\n555:     if let Feed::Text(text) = feed {\n556:         let dir = tempfile::tempdir()?;\n557:         let path = dir.path().join(\"stdin.txt\");\n558:         std::fs::write(&path, text)?;\n559:         let path = path\n560:             .to_str()\n561:             .expect(\"a temp path is valid UTF-8\")\n562:             .to_string();\n563:         let io: mlua::Table = lua.globals().get(\"io\")?;\n564:         let real_lines: mlua::Function = io.get(\"lines\")?;\n565:         let fixture =\n566:             lua.create_function(move |_, ()| real_lines.call::<mlua::Value>(path.clone()))?;\n567:         io.set(\"lines\", fixture)?;\n568:         _fixture_dir = Some(dir);\n569:     }\n570: \n571:     // A live run has no test harness reading the result back, the same distinction\n572:     // `run_subprocess` makes for the OS-process backends: `print` writes straight to the real\n573:     // stdout and flushes per call instead of buffering into a string only handed back once the\n574:     // whole chunk finishes.\n575:     let live = matches!(feed, Feed::Live);\n576:     let captured = Rc::new(RefCell::new(String::new()));\n577:     let sink = Rc::clone(&captured);\n578:     let print = lua.create_function(move |_, s: String| {\n579:         if live {\n580:             let mut stdout = std::io::stdout();\n581:             writeln!(stdout, \"{s}\").map_err(mlua::Error::external)?;\n582:             stdout.flush