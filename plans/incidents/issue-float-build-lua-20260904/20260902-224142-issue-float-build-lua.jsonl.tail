ec<String> = fields\n790:                 .iter()\n791:                 .map(|(name, value)| format!(\"{}: {}\", js_string(name), expr(enums, value)))\n792:                 .collect();\n793:             // Parenthesised because a brace opening an arrow function's body is a block, so\n794:             // `(e) => {a: 1}` is a labelled statement rather than an object.\n795:             format!(\"({{{}}})\", parts.join(\", \"))\n796:         }\n797: \n798:         // The value is its JSON shape: a unit variant is the variant-name string, a payload\n799:         // variant the single-key object a record already is.\n\n(Showing lines 755-799 of 1122. Use offset=800 to continue.)\n</content>","metadata":{"preview":"        _ => format!(\"return {};\\n\", expr(enums, t)),\n    }\n}\n\n/// Prepend two spaces to every line. `tail_stmts` returns its lines unindented, and each\n/// nesting level (`while` body, an `if` branch) shifts by one indent.\nfn indent(s: &str) -> String {\n    let mut out = String::new();\n    for line in s.trim_end_matches('\\n').split('\\n') {\n        out.push_str(\"  \");\n        out.push_str(line);\n        out.push('\\n');\n    }\n    out\n}\n\nfn expr(enums: &Enums, t: &Tir) -> String {\n    match &t.kind {\n        Kind::Str(s) => js_string(s),\n        Kind::Int(n) => int_lit(&t.ty, *n),","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/emit_js.rs","text":"        _ => format!(\"return {};\\n\", expr(enums, t)),\n    }\n}\n\n/// Prepend two spaces to every line. `tail_stmts` returns its lines unindented, and each\n/// nesting level (`while` body, an `if` branch) shifts by one indent.\nfn indent(s: &str) -> String {\n    let mut out = String::new();\n    for line in s.trim_end_matches('\\n').split('\\n') {\n        out.push_str(\"  \");\n        out.push_str(line);\n        out.push('\\n');\n    }\n    out\n}\n\nfn expr(enums: &Enums, t: &Tir) -> String {\n    match &t.kind {\n        Kind::Str(s) => js_string(s),\n        Kind::Int(n) => int_lit(&t.ty, *n),\n        Kind::Float(n) => crate::float::lit(*n),\n        Kind::Var(name) => user(name),\n        Kind::Local(id) => local(*id),\n        Kind::Input => INPUT.to_string(),\n        Kind::Inputs => INPUTS.to_string(),\n        // The stream, materialized eagerly: whatever consumes it -- `collect`, a mapper --\n        // works on the array of its entries. Fusion is what will remove this materialization.\n        Kind::Lines => \"tl_collect_lines()\".to_string(),\n        // Same raw lines as `lines`, each split on the delimiter into one row.\n        Kind::Dsv { delim } => format!(\n            \"tl_collect_lines().map((l) => l.split({}))\",\n            js_string(delim)\n        ),\n        Kind::RecordLit { fields } => {\n            let parts: Vec<String> = fields\n                .iter()\n                .map(|(name, value)| format!(\"{}: {}\", js_string(name), expr(enums, value)))\n                .collect();\n            // Parenthesised because a brace opening an arrow function's body is a block, so\n            // `(e) => {a: 1}` is a labelled statement rather than an object.\n            format!(\"({{{}}})\", parts.join(\", \"))\n        }\n\n        // The value is its JSON shape: a unit variant is the variant-name string, a payload\n        // variant the single-key object a record already is.","lineStart":755,"lineEnd":799,"totalLines":1122,"truncated":true}},"title":"src/emit_js.rs","time":{"start":1788381724938,"end":1788381725000}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Let me see the Float literal rendering in emit_js.rs around line 775, and the div_by_zero handling around 1056.","format":"unknown","index":0}]}},"id":"prt_063db80fd00183AuplrQTLT9GX","sessionID":"ses_f9c24d349ffeKHnaVF2lrb6ncE","messageID":"msg_063db7220001fZ9T7lojQa9iIE"}}
{"type":"tool_use","timestamp":1788381725010,"sessionID":"ses_f9c24d349ffeKHnaVF2lrb6ncE","part":{"type":"tool","tool":"read","callID":"call_853fff8ff3fb41fbae9a2b35","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/emit_js.rs","limit":30,"offset":1045},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/emit_js.rs</path>\n<type>file</type>\n<content>\n1045:     if *ty == Type::Int64 {\n1046:         format!(\"{n}n\")\n1047:     } else {\n1048:         n.to_string()\n1049:     }\n1050: }\n1051: \n1052: /// One arithmetic expression at the width the node's type names. BigInt operators are exact\n1053: /// at any width, so on the 64-bit side only the wrap needs spelling -- Math.imul has no\n1054: /// 64-bit sibling and none is needed.\n1055: fn arith(ty: &Type, op: BinOp, l: String, r: String) -> String {\n1056:     if *ty == Type::Float {\n1057:         // IEEE binary64 is the type itself (ADR 0007), so plain JS operators are the exact\n1058:         // arithmetic, with no wrap to spell. Division by zero is the IEEE answer, Infinity,\n1059:         // which is why there is no `tl_div` guard here unlike the integer widths.\n1060:         match op {\n1061:             BinOp::Add => format!(\"({l} + {r})\"),\n1062:             BinOp::Sub => format!(\"({l} - {r})\"),\n1063:             BinOp::Mul => format!(\"({l} * {r})\"),\n1064:             BinOp::Div => format!(\"({l} / {r})\"),\n1065:             other => unreachable!(\"{other} is not arithmetic\"),\n1066:         }\n1067:     } else if *ty == Type::Int64 {\n1068:         match op {\n1069:             BinOp::Div => format!(\"tl_div64({l}, {r})\"),\n1070:             BinOp::Rem => format!(\"tl_rem64({l}, {r})\"),\n1071:             BinOp::Mul => format!(\"BigInt.asIntN(64, {l} * {r})\"),\n1072:             BinOp::Add => format!(\"BigInt.asIntN(64, {l} + {r})\"),\n1073:             BinOp::Sub => format!(\"BigInt.asIntN(64, {l} - {r})\"),\n1074:             other => unreachable!(\"{other} is not arithmetic\"),\n\n(Showing lines 1045-1074 of 1122. Use offset=1075 to continue.)\n</content>","metadata":{"preview":"    if *ty == Type::Int64 {\n        format!(\"{n}n\")\n    } else {\n        n.to_string()\n    }\n}\n\n/// One arithmetic expression at the width the node's type names. BigInt operators are exact\n/// at any width, so on the 64-bit side only the wrap needs spelling -- Math.imul has no\n/// 64-bit sibling and none is needed.\nfn arith(ty: &Type, op: BinOp, l: String, r: String) -> String {\n    if *ty == Type::Float {\n        // IEEE binary64 is the type itself (ADR 0007), so plain JS operators are the exact\n        // arithmetic, with no wrap to spell. Division by zero is the IEEE answer, Infinity,\n        // which is why there is no `tl_div` guard here unlike the integer widths.\n        match op {\n            BinOp::Add => format!(\"({l} + {r})\"),\n            BinOp::Sub => format!(\"({l} - {r})\"),\n            BinOp::Mul => format!(\"({l} * {r})\"),\n            BinOp::Div => format!(\"({l} / {r})\"),","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/emit_js.rs","text":"    if *ty == Type::Int64 {\n        format!(\"{n}n\")\n    } else {\n        n.to_string()\n    }\n}\n\n/// One arithmetic expression at the width the node's type names. BigInt operators are exact\n/// at any width, so on the 64-bit side only the wrap needs spelling -- Math.imul has no\n/// 64-bit sibling and none is needed.\nfn arith(ty: &Type, op: BinOp, l: String, r: String) -> String {\n    if *ty == Type::Float {\n        // IEEE binary64 is the type itself (ADR 0007), so plain JS operators are the exact\n        // arithmetic, with no wrap to spell. Division by zero is the IEEE answer, Infinity,\n        // which is why there is no `tl_div` guard here unlike the integer widths.\n        match op {\n            BinOp::Add => format!(\"({l} + {r})\"),\n            BinOp::Sub => format!(\"({l} - {r})\"),\n            BinOp::Mul => format!(\"({l} * {r})\"),\n            BinOp::Div => format!(\"({l} / {r})\"),\n            other => unreachable!(\"{other} is not arithmetic\"),\n        }\n    } else if *ty == Type::Int64 {\n        match op {\n            BinOp::Div => format!(\"tl_div64({l}, {r})\"),\n            BinOp::Rem => format!(\"tl_rem64({l}, {r})\"),\n            BinOp::Mul => format!(\"BigInt.asIntN(64, {l} * {r})\"),\n            BinOp::Add => format!(\"BigInt.asIntN(64, {l} + {r})\"),\n            BinOp::Sub => format!(\"BigInt.asIntN(64, {l} - {r})\"),\n            other => unreachable!(\"{other} is not arithmetic\"),","lineStart":1045,"lineEnd":1074,"totalLines":1122,"truncated":true}},"title":"src/emit_js.rs","time":{"start":1788381724953,"end":1788381725008}},"id":"prt_063db8110001ZkCzKjGFoXfjWB","sessionID":"ses_f9c24d349ffeKHnaVF2lrb6ncE","messageID":"msg_063db7220001fZ9T7lojQa9iIE"}}
{"type":"step_finish","timestamp":1788381725029,"sessionID":"ses_f9c24d349ffeKHnaVF2lrb6ncE","part":{"id":"prt_063db815e001vHT7R25HchQ6pB","reason":"tool-calls","snapshot":"af4fa15ed4996d0bb919f8e70bd0271c9d7c1cdd","messageID":"msg_063db7220001fZ9T7lojQa9iIE","sessionID":"ses_f9c24d349ffeKHnaVF2lrb6ncE","type":"step-finish","tokens":{"total":28593,"input":26583,"output":190,"reasoning":28,"cache":{"write":0,"read":1792}},"cost":0.001795807}}
{"type":"step_start","timestamp":1788381725763,"sessionID":"ses_f9c24d349ffeKHnaVF2lrb6ncE","part":{"id":"prt_063db843e001y10ndFw776gKoD","messageID":"msg_063db8180001ObqV1cTA5IOLbP","sessionID":"ses_f9c24d349ffeKHnaVF2lrb6ncE","snapshot":"af4fa15ed4996d0bb919f8e70bd0271c9d7c1cdd","type":"step-start"}}
{"type":"tool_use","timestamp":1788381726772,"sessionID":"ses_f9c24d349ffeKHnaVF2lrb6ncE","part":{"type":"tool","tool":"read","callID":"call_f4758510b70d479487697a24","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/float.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/float.rs</path>\n<type>file</type>\n<content>\n1: //! How a Float is spelled as a number literal (ADR 0007).\n2: //!\n3: //! Every backend emits a literal through here rather than its own target's float formatting,\n4: //! which is what lets the corpus's agreement harness compare their output byte for byte once\n5: //! a second backend carries Float (kantord/toylang#149). Rust's `Display` for `f64` is the\n6: //! shortest decimal that round-trips to the same double -- exactly what a literal needs to be\n7: //! exact on every target, and what JS's own `String(number)` produces for the same value.\n8: \n9: /// A finite binary64 as a number literal. Non-finite values have no literal spelling (they are\n10: /// produced by arithmetic, not written), so one arriving here is a bug upstream.\n11: pub fn lit(n: f64) -> String {\n12:     if !n.is_finite() {\n13:         panic!(\"cannot write a non-finite value as a float literal\");\n14:     }\n15:     n.to_string()\n16: }\n\n(End of file - total 16 lines)\n</content>","metadata":{"preview":"//! How a Float is spelled as a number literal (ADR 0007).\n//!\n//! Every backend emits a literal through here rather than its own target's float formatting,\n//! which is what lets the corpus's agreement harness compare their output byte for byte once\n//! a second backend carries Float (kantord/toylang#149). Rust's `Display` for `f64` is the\n//! shortest decimal that round-trips to the same double -- exactly what a literal needs to be\n//! exact on every target, and what JS's own `String(number)` produces for the same value.\n\n/// A finite binary64 as a number literal. Non-finite values have no literal spelling (they are\n/// produced by arithmetic, not written), so one arriving here is a bug upstream.\npub fn lit(n: f64) -> String {\n    if !n.is_finite() {\n        panic!(\"cannot write a non-finite value as a float literal\");\n    }\n    n.to_string()\n}","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/float.rs","text":"//! How a Float is spelled as a number literal (ADR 0007).\n//!\n//! Every backend emits a literal through here rather than its own target's float formatting,\n//! which is what lets the corpus's agreement harness compare their output byte for byte once\n//! a second backend carries Float (kantord/toylang#149). Rust's `Display` for `f64` is the\n//! shortest decimal that round-trips to the same double -- exactly what a literal needs to be\n//! exact on every target, and what JS's own `String(number)` produces for the same value.\n\n/// A finite binary64 as a number literal. Non-finite values have no literal spelling (they are\n/// produced by arithmetic, not written), so one arriving here is a bug upstream.\npub fn lit(n: f64) -> String {\n    if !n.is_finite() {\n        panic!(\"cannot write a non-finite value as a float literal\");\n    }\n    n.to_string()\n}","lineStart":1,"lineEnd":16,"totalLines":16,"truncated":false}},"title":"src/float.rs","time":{"start":1788381726763,"end":1788381726771}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me look at how `expr` is invoked, and how the Float type is handled in the JS backend's `show` (the printer), and what `float::lit` does. Also, how does the emit_js.rs handle the comparison of Floats? Let me look at float.rs.","format":"unknown","index":0}]}},"id":"prt_063db8824001mdOkZNrEOJvcUV","sessionID":"ses_f9c24d349ffeKHnaVF2lrb6ncE","messageID":"msg_063db8180001ObqV1cTA5IOLbP"}}
{"type":"tool_use","timestamp":1788381726774,"sessionID":"ses_f9c24d349ffeKHnaVF2lrb6ncE","part":{"type":"tool","tool":"read","callID":"call_63b41398d8dd4681bf896d01","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/emit_lua.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/emit_lua.rs</path>\n<type>file</type>\n<content>\n1: use crate::ast::BinOp;\n2: use crate::tir::{self, Builtin, Kind, LocalId, Program, Tir};\n3: use crate::ty::{self, Enums, Type};\n4: \n5: /// The global the input value is bound to before the chunk runs. Unspellable in source, since\n6: /// every source name is prefixed.\n7: pub const INPUT: &str = \"t_input\";\n8: /// The global every remaining stdin line, already parsed, is bound to before the chunk runs.\n9: pub const INPUTS: &str = \"t_inputs\";\n10: /// The function `run_lua` injects in place of `INPUTS` for a fused, live-streamable program:\n11: /// called with no arguments, it returns the next `inputs` record already parsed and converted,\n12: /// or `nil` at EOF. See `tir::fusion` and this file's `fused_main`.\n13: pub const NEXT_INPUT: &str = \"tl_next_input\";\n14: \n15: const SELECT_HELPER: &str = \"\\\n16: local function tl_select(src, pred)\n17:   local out = {}\n18:   for i = 1, #src do\n19:     if pred(src[i]) then out[#out + 1] = src[i] end\n20:   end\n21:   return out\n22: end\n23: \";\n24: \n25: const FIELD_HELPER: &str = \"\\\n26: local function tl_field(v, k, depth)\n27:   if depth == 0 then return v[k] end\n28:   local out = {}\n29:   for i = 1, #v do out[i] = tl_field(v[i], k, depth - 1) end\n30:   return out\n31: end\n32: \";\n33: \n34: const RANGE_HELPER: &str = \"\\\n35: local function tl_range(n)\n36:   local out = {}\n37:   for i = 1, n do out[i] = i - 1 end\n38:   return out\n39: end\n40: \";\n41: \n42: const COLLECT_HELPER: &str = \"\\\n43: local function tl_collect_lines()\n44:   local out = {}\n45:   for line in io.lines() do out[#out + 1] = line end\n46:   return out\n47: end\n48: \";\n49: \n50: // `dsv` splits each collected line on the delimiter. `string.find` with `plain = true` is the\n51: // literal-search form, so the delimiter is not read as a Lua pattern.\n52: const SPLIT_HELPER: &str = \"\\\n53: local function tl_split(s, sep)\n54:   local out = {}\n55:   local pos = 1\n56:   while true do\n57:     local start, stop = string.find(s, sep, pos, true)\n58:     if not start then\n59:       out[#out + 1] = string.sub(s, pos)\n60:       break\n61:     end\n62:     out[#out + 1] = string.sub(s, pos, start - 1)\n63:     pos = stop + 1\n64:   end\n65:   return out\n66: end\n67: \n68: local function tl_split_lines(lines, sep)\n69:   local out = {}\n70:   for i = 1, #lines do out[i] = tl_split(lines[i], sep) end\n71:   return out\n72: end\n73: \";\n74: \n75: const MAP_HELPER: &str = \"\\\n76: local function tl_map(src, f)\n77:   local out = {}\n78:   for i = 1, #src do out[i] = f(src[i]) end\n79:   return out\n80: end\n81: \";\n82: \n83: const OPT_HELPER: &str = \"\\\n84: -- An Opt is its enum's own runtime shape (ADR 0009): `{some = v}` present, \\\"none\\\" absent.\n85: -- Tagged, so two levels of absence stay two values; only the printer flattens to null. A\n86: -- table rather than nil also keeps `#` honest for a Vec of Opt.\n87: local function tl_at(v, i, depth)\n88:   if depth > 0 then\n89:     local out = {}\n90:     for k = 1, #v do out[k] = tl_at(v[k], i, depth - 1) end\n91:     return out\n92:   end\n93:   local n = #v\n94:   if i < 0 then i = n + i end\n95:   if i < 0 or i >= n then return \\\"none\\\" end\n96:   return { some = v[i + 1] }\n97: end\n98: \";\n99: \n100: // Lua has no slice operator, so the clamping is spelled out: negatives count from the end,\n101: // then both bounds clamp to [0, n], and a crossed window is empty. A `nil` bound is one left\n102: // out (0 for the start, n for the end).\n103: const SLICE_HELPER: &str = \"\\\n104: local function tl_slice(v, lo, hi, depth)\n105:   if depth > 0 then\n106:     local out = {}\n107:     for k = 1, #v do out[k] = tl_slice(v[k], lo, hi, depth - 1) end\n108:     return out\n109:   end\n110:   local n = #v\n111:   local function norm(i)\n112:     if i == nil then return nil end\n113:     if i < 0 then i = n + i end\n114:     if i < 0 then i = 0 end\n115:     if i > n then i = n end\n116:     return i\n117:   end\n118:   lo = norm(lo) or 0\n119:   hi = norm(hi) or n\n120:   local out = {}\n121:   if lo < hi then\n122:     local j = 0\n123:     for i = lo + 1, hi do j = j + 1 out[j] = v[i] end\n124:   end\n125:   return out\n126: end\n127: \";\n128: \n129: const TAIL_HELPER: &str = \"\\\n130: local function tl_tail(v)\n131:   if #v == 0 then return \\\"none\\\" end\n132:   local out = {}\n133:   for i = 2, #v do out[i - 1] = v[i] end\n134:   return { some = out }\n135: end\n136: \";\n137: \n138: const FLATTEN_HELPER: &str = \"\\\n139: local function tl_flatten(vv)\n140:   local out = {}\n141:   for i = 1, #vv do\n142:     local inner = vv[i]\n143:     for j = 1, #inner do out[#out + 1] = inner[j] end\n144:   end\n145:   return out\n146: end\n147: \";\n148: \n149: // `table.sort`'s default comparator is Lua's own `<`, which already agrees with every other\n150: // backend's ordering on both numbers and (byte-wise, so codepoint-wise for valid UTF-8) strings,\n151: // so nothing here has to branch on the element type.\n152: const SORT_HELPER: &str = \"\\\n153: local function tl_sort(v)\n154:   local out = {}\n155:   for i = 1, #v do out[i] = v[i] end\n156:   table.sort(out)\n157:   return out\n158: end\n159: \";\n160: \n161: const REVERSE_HELPER: &str = \"\\\n162: local function tl_reverse(v)\n163:   local out = {}\n164:   local n = #v\n165:   for i = 1, n do out[i] = v[n - i + 1] end\n166:   return out\n167: end\n168: \";\n169: \n170: // `narrow` is true exactly when the element type is Int: both widths live in the same 64-bit\n171: // integer here, so the only difference is whether each addition is brought back to 32 bits the\n172: // way `+` does.\n173: const SUM_HELPER: &str = \"\\\n174: local function tl_sum(v, narrow)\n175:   local acc = 0\n176:   for i = 1, #v do\n177:     acc = acc + v[i]\n178:     if narrow then acc = tl_i32(acc) end\n179:   end\n180:   return acc\n181: end\n182: \";\n183: \n184: const MAX_HELPER: &str = \"\\\n185: local function tl_max(v)\n186:   if #v == 0 then return \\\"none\\\" end\n187:   local m = v[1]\n188:   for i = 2, #v do\n189:     if v[i] > m then m = v[i] end\n190:   end\n191:   return { some = m }\n192: end\n193: \";\n194: \n195: const UNWRAP_HELPER: &str = r#\"local function tl_unwrap(v, depth)\n196:   if depth > 0 then\n197:     local out = {}\n198:     for k = 1, #v do out[k] = tl_unwrap(v[k], depth - 1) end\n199:     return out\n200:   end\n201:   if v == \"none\" then error(\"toylang: unwrapped a value that is not there\", 0) end\n202:   return v.some\n203: end\n204: \"#;\n205: \n206: // A record and a payload-carrying variant are both tables, and Lua's `==` on two tables is\n207: // identity, so `{a = 1} == {a = 1}` was false here and true on Python (kantord/toylang#68).\n208: // Structural equality is the ratified answer, so composites walk. Keyed rather than ordered:\n209: // two spellings of one record type may reach here in different field orders.\n210: const EQ_HELPER: &str = \"\\\n211: local function tl_eq(a, b)\n212:   if a == b then return true end\n213:   if type(a) ~= \\\"table\\\" or type(b) ~= \\\"table\\\" then return false end\n214:   local extra = 0\n215:   for k, v in pairs(a) do\n216:     extra = extra + 1\n217:     if not tl_eq(v, b[k]) then return false end\n218:   end\n219:   for _ in pairs(b) do extra = extra - 1 end\n220:   return extra == 0\n221: end\n222: \";\n223: \n224: const ARITH_HELPER: &str = r#\"local TL_2_31 <const> = 2147483648\n225: local TL_2_32 <const> = 4294967296\n226: -- Lua integers are 64-bit, so an Int has to be brought back into 32 bits after every operation.\n227: -- `%` is floored here and the modulus is positive, so this is exact for negatives too.\n228: local function tl_i32(x)\n229:   return (x + TL_2_31) % TL_2_32 - TL_2_31\n230: end\n231: -- Lua's `//` floors and `%` is floored; toylang truncates, which math.fmod already does.\n232: local function tl_div(a, b)\n233:   if b == 0 then error(\"toylang: divided by zero\", 0) end\n234:   return tl_i32((a - math.fmod(a, b)) // b)\n235: end\n236: local function tl_rem(a, b)\n237:   if b == 0 then error(\"toylang: divided by zero\", 0) end\n238:   return tl_i32(math.fmod(a, b))\n239: end\n240: \"#;\n241: \n242: // Lua's integers already are 64-bit and wrap (kantord/toylang#83), so an Int64's `+`, `-` and\n243: // `*` need nothing at all -- the one backend where the wider type is cheaper than the narrow\n244: // one. Only division needs spelling: `//` floors where toylang truncates, and `math.fmod` is\n245: // already truncated, so the same fmod-then-divide `tl_div` uses works with the `tl_i32` taken\n246: // off. `MIN // -1` wraps back to `MIN` on its own, Lua's documented overflow rule.\n247: const ARITH64_HELPER: &str = r#\"local function tl_div64(a, b)\n248:   if b == 0 then error(\"toylang: divided by zero\", 0) end\n249:   return (a - math.fmod(a, b)) // b\n250: end\n251: local function tl_rem64(a, b)\n252:   if b == 0 then error(\"toylang: divided by zero\", 0) end\n253:   return math.fmod(a, b)\n254: end\n255: \"#;\n256: \n257: const QUOTE_HELPER: &str = r#\"local function tl_quote(s)\n258:   return '\"' .. s:gsub('[%c\"\\\\]', function(c)\n259:     if c == '\"' then return '\\\\\"' end\n260:     if c == '\\\\' then return '\\\\\\\\' end\n261:     if c == '\\n' then return '\\\\n' end\n262:     if c == '\\r' then return '\\\\r' end\n263:     if c == '\\t' then return '\\\\t' end\n264:     return string.format('\\\\u%04x', c:byte())\n265:   end) .. '\"'\n266: end\n267: \"#;\n268: \n269: const JOIN_HELPER: &str = \"\\\n270: local function tl_join(v, f)\n271:   local parts = {}\n272:   for i = 1, #v do parts[i] = f(v[i]) end\n273:   return \\\"[\\\" .. table.concat(parts, \\\",\\\") .. \\\"]\\\"\n274: end\n275: \";\n276: \n277: const JSONLINES_HELPER: &str = \"\\\n278: local function tl_jsonlines(v, f)\n279:   local parts = {}\n280:   for i = 1, #v do parts[i] = f(v[i]) end\n281:   return table.concat(parts, \\\"\\\\n\\\")\n282: end\n283: \";\n284: \n285: // Lua strings are byte arrays with no Unicode awareness, so decoding by codepoint (rather than\n286: // by byte) has to be hand-rolled, the same as the native runtime's tl_chars does in C.\n287: const CHARS_HELPER: &str = r#\"local function tl_chars(s)\n288:   local out = {}\n289:   local i = 1\n290:   local n = #s\n291:   while i <= n do\n292:     local b0 = s:byte(i)\n293:     local cp, extra\n294:     if b0 < 0x80 then cp, extra = b0, 0\n295:     elseif b0 & 0xE0 == 0xC0 then cp, extra = b0 & 0x1F, 1\n296:     elseif b0 & 0xF0 == 0xE0 then cp, extra = b0 & 0x0F, 2\n297:     else cp, extra = b0 & 0x07, 3\n298:     end\n299:     i = i + 1\n300:     for _ = 1, extra do\n301:       cp = (cp << 6) | (s:byte(i) & 0x3F)\n302:       i = i + 1\n303:     end\n304:     out[#out + 1] = cp\n305:   end\n306:   return out\n307: end\n308: \"#;\n309: \n310: pub fn emit(program: &Program) -> String {\n311:     let enums = &program.enums;\n312:     let mut out = String::new();\n313: \n314:     let used = used_helpers(program);\n315:     // A top-level Str prints raw, the way jq's -r does; anything else prints as JSON. So a\n316:     // string inside a Vec is quoted while a bare string is not.\n317:     let structured = !matches!(program.body.ty, Type::Str | Type::Sink);\n318:     let quote = (structured && needs_quote(&program.body.ty)) || used.jsonlines;\n319:     let join = (structured && contains_vec(enums, &program.body.ty)) || used.jsonlines;\n320:     for (on, text) in [\n321:         (used.select, SELECT_HELPER),\n322:         (used.field, FIELD_HELPER),\n323:         (quote, QUOTE_HELPER),\n324:         (join, JOIN_HELPER),\n325:         (used.index, OPT_HELPER),\n326:         (used.slice, SLICE_HELPER),\n327:         (used.unwrap, UNWRAP_HELPER),\n328:         (used.tail, TAIL_HELPER),\n329:         (used.flatten, FLATTEN_HELPER),\n330:         (used.sort, SORT_HELPER),\n331:         (used.reverse, REVERSE_HELPER),\n332:         (used.arith, ARITH_HELPER),\n333:         (used.arith64, ARITH64_HELPER),\n334:         // After ARITH_HELPER: `tl_sum` narrows through `tl_i32`, and a local declared later in\n335:         // the same chunk is invisible to an earlier function body, which would fall back to the\n336:         // nil global at runtime.\n337:         (used.sum, SUM_HELPER),\n338:         (used.max, MAX_HELPER),\n339:         (used.map, MAP_HELPER),\n340:         (used.range, RANGE_HELPER),\n341:         (used.collect, COLLECT_HELPER),\n342:         (used.split, SPLIT_HELPER),\n343:         (used.jsonlines, JSONLINES_HELPER),\n344:         (used.chars, CHARS_HELPER),\n345:         (used.eq, EQ_HELPER),\n346:     ] {\n347:         if on {\n348:             out.push_str(text);\n349:         }\n350:     }\n351: \n352:     out.push_str(&printers(program));\n353: \n354:     // All names are declared before any body, because the checker collects signatures before\n355:     // checking bodies and so accepts a call to a function defined further down. Emitting\n356:     // `local function` in source order would leave that call resolving to a nil global.\n357:     if !program.funcs.is_empty() {\n358:         let names: Vec<String> = program.funcs.iter().map(|f| user(&f.name)).collect();\n359:         out.push_str(&format!(\"local {}\\n\", names.join(\", \")));\n360:     }\n361: \n362:     for f in &program.funcs {\n363:         out.push_str(&format!(\n364:             \"function {}({})\\n  return {}\\nend\\n\",\n365:             user(&f.name),\n366:             f.param.as_deref().map_or_else(String::new, user),\n367:             expr(enums, &f.body)\n368:         ));\n369:     }\n370: \n371:     if let Some(fusion) = tir::fusion(program) {\n372:         out.push_str(&fused_main(program, &fusion));\n373:     } else {\n374:         let body = expr(enums, &program.body);\n375:         if structured {\n376:             out.push_str(&format!(\n377:                 \"print({})\\n\",\n378:                 show(enums, &program.body.ty, &body, 0)\n379:             ));\n380:         } else {\n381:             out.push_str(&format!(\"print({body})\\n\"));\n382:         }\n383:     }\n384:     out\n385: }\n386: \n387: /// A stream-typed `jsonlines` program, compiled as a loop over one entry at a time: for an\n388: /// `inputs` source, a call to `NEXT_INPUT` for one already-parsed record (see that constant's\n389: /// doc comment for why the parsing itself is not written here); for `lines`, `io.lines()`\n390: /// itself, exactly as the eager collect helper reads it.\n391: fn fused_main(program: &Program, fusion: &tir::Fusion) -> String {\n392:     let enums = &program.enums;\n393:     let mut out = String::new();\n394:     let (mut current, mut current_ty) = match fusion.source {\n395:         tir::Source::Inputs => {\n396:             out.push_str(\"while true do\\n\");\n397:             out.push_str(&format!(\"  local t_line = {NEXT_INPUT}()\\n\"));\n398:             out.push_str(\"  if t_line == nil then break end\\n\");\n399:             let elem = program\n400:                 .inputs\n401:                 .as_ref()\n402:                 .expect(\"an inputs source recorded its element\");\n403:             (\"t_line\".to_string(), elem.clone())\n404:         }\n405:         tir::Source::Lines => {\n406:             out.push_str(\"for t_line in io.lines() do\\n\");\n407:             (\"t_line\".to_string(), Type::Str)\n408:         }\n409:         // The bound is evaluated once; the loop counter is the element. A negative bound makes\n410:         // Lua's numeric for run zero times (start > limit), the same answer `tl_range` gives\n411:         // eagerly.\n412:         tir::Source::Range(bound) => {\n413:             out.push_str(&format!(\"local n = {}\\n\", expr(enums, bound)));\n414:             out.push_str(\"for t_i = 0, n - 1 do\\n\");\n415:             (\"t_i\".to_string(), Type::Int)\n416:         }\n417:     };\n418:     for stage in &fusion.stages {\n419:         match stage {\n420:             tir::Stage::Map { param, body } => {\n421:                 out.push_str(&format!(\"  local {} = {}\\n\", local(*param), current));\n422:                 current = expr(enums, body);\n423:                 current_ty = body.ty.clone();\n424:             }\n425:             tir::Stage::Select { param, pred } => {\n426:                 out.push_str(&format!(\"  local {} = {}\\n\", local(*param), current));\n427:                 out.push_str(&format!(\n428:                     \"  if not ({}) then goto tl_continue end\\n\",\n429:                     expr(enums, pred)\n430:                 ));\n431:                 current = local(*param);\n432:             }\n433:         }\n434:     }\n435:     // Always the JSON rendering, never the top-level raw-Str rule: each line is one JSON value\n436:     // (that is what jsonlines promises), so a Str element prints quoted here exactly as the\n437:     // eager path's per-element `show` prints it. Only whole-program results print raw.\n438:     let printed = show(enums, &current_ty, &current, 0);\n439:     out.push_str(&format!(\"  print({printed})\\n\"));\n440:     out.push_str(\"  ::tl_continue::\\n\");\n441:     out.push_str(\"end\\n\");\n442:     out\n443: }\n444: \n445: /// The printer is built from the type rather than by inspecting the value. A Lua table cannot\n446: /// say whether it is an array or a record -- an empty one is indistinguishable either way -- so\n447: /// asking it was always going to disagree with a backend that knows. See emit_js for the same\n448: /// function, and step 4 onwards, where a native target has nothing to ask.\n449: fn show(enums: &Enums, ty: &Type, value: &str, depth: usize) -> String {\n450:     match ty {\n451:         Type::Param(_) => unreachable!(\"params are substituted before emit\"),\n452:         // The checker refuses a program whose result contains a stream, since there is nothing to\n453:         // print: a stream has no value, only a promise that collect can redeem.\n454:         Type::Stream(_) => unreachable!(\"a stream cannot reach the printer\"),\n455:         Type::Char => unreachable!(\"Char cannot reach the printer, refused by the checker\"),\n456:         Type::Str => format!(\"tl_quote({value})\"),\n457:         Type::Sink => unreachable!(\"a sink only ever prints raw, never through the printer\"),\n458:         Type::Int | Type::Int64 | Type::Bool => format!(\"tostring({value})\"),\n459:         Type::Float => unreachable!(\"Float is JS-only in this row\"),\n460:         Type::Vec(elem) => {\n461:             let e = format!(\"e{depth}\");\n462:             format!(\n463:                 \"tl_join({value}, function({e}) return {} end)\",\n464:                 show(enums, elem, &e, depth + 1)\n465:             )\n466:         }\n467:         Type::Enum { .. } if ty.as_opt().is_some() => {\n468:             let inner = ty.as_opt().expect(\"guarded\");\n469:             let v = format!(\"o{depth}\");\n470:             format!(\n471:                 \"(function({v}) if {v} == \\\"none\\\" then return \\\"null\\\" else return {} end end)({value})\",\n472:                 show(enums, inner, &format!(\"{v}.some\"), depth + 1)\n473:             )\n474:         }\n475:         // A recursive enum prints through a function of its own (`printers`), because expanding\n476:         // one here has no bottom: its payload leads back to the same type.\n477:         Type::Enum { .. } if ty::is_recursive(enums, ty) => format!(\"{}({value})\", ty.show_fn()),\n478:         Type::Enum { .. } => show_enum(enums, ty, value, depth),\n479:         Type::Record(fields) => {\n480:             // `..` needs an operand on each side, so a record with no fields cannot be\n481:             // built by joining nothing. The other backends survive this by construction.\n482:             if fields.is_empty() {\n483:                 return \"\\\"{}\\\"\".to_string();\n484:             }\n485:             // The type's field list is declaration order, so this prints as declared. Field\n486:             // names are identifiers, so the JSON key needs no escaping and is one literal.\n487:             let parts: Vec<String> = fields\n488:                 .iter()\n489:                 .map(|(name, fty)| {\n490:                     let read = format!(\"{value}[{}]\", lua_string(name));\n491:                     let key = lua_string(&format!(\"\\\"{name}\\\":\"));\n492:                     format!(\"{key} .. {}\", show(enums, fty, &read, depth + 1))\n493:                 })\n494:                 .collect();\n495:             format!(\"(\\\"{{\\\" .. {} .. \\\"}}\\\")\", parts.join(\" .. \\\",\\\" .. \"))\n496:         }\n497:     }\n498: }\n499: \n500: /// The printer for one enum, inline. One type, two runtime shapes (ADR 0009): a unit variant is\n501: /// a bare string, a payload variant a single-key table, so this is the one printer that has to\n502: /// look before it renders. Only the shape is inspected; which payload follows which key is the\n503: /// type's.\n504: fn show_enum(enums: &Enums, ty: &Type, value: &str, depth: usize) -> String {\n505:     let variants = ty::variants(enums, ty);\n506:     let n = format!(\"n{depth}\");\n507:     let payloads: Vec<&(String, Option<Type>)> =\n508:         variants.iter().filter(|(_, p)| p.is_some()).collect();\n509:     if payloads.is_empty() {\n510:         return format!(\"tl_quote({value})\");\n511:     }\n512:     let mut body = String::new();\n513:     if payloads.len() < variants.len() {\n514:         body.push_str(&format!(\n515:             \"if type({n}) == \\\"string\\\" then return tl_quote({n}) end \"\n516:         ));\n517:     }\n518:     for (i, (vname, pty)) in payloads.iter().enumerate() {\n519:         let pty = pty.as_ref().expect(\"filtered to payload variants\");\n520:         let read = format!(\"{n}[{}]\", lua_string(vname));\n521:         let wrapped = format!(\n522:             \"({} .. {} .. \\\"}}\\\")\",\n523:             lua_string(&format!(\"{{\\\"{vname}\\\":\")),\n524:             show(enums, pty, &read, depth + 1)\n525:         );\n526:         if i + 1 < payloads.len() {\n527:             body.push_str(&format!(\"if {read} ~= nil then return {wrapped} end \"));\n528:         } else {\n529:             // The last payload variant needs no test: the type says nothing else is left.\n530:             body.push_str(&format!(\"return {wrapped} \"));\n531:         }\n532:     }\n533:     format!(\"(function({n}) {body}end)({value})\")\n534: }\n535: \n536: /// A named printer for every recursive enum the program prints. The call in `show` above is\n537: /// what a nested occurrence renders as, so the recursion in the type becomes recursion in the\n538: /// emitted function rather than in this compiler (kantord/toylang#94).\n539: fn printers(program: &Program) -> String {\n540:     let mut out = String::new();\n541:     for ty in tir::printed_recursive_enums(program) {\n542:         out.push_str(&format!(\n543:             \"function {}(v)\\n  return {}\\nend\\n\",\n544:             ty.show_fn(),\n545:             show_enum(&program.enums, &ty, \"v\", 0)\n546:         ));\n547:     }\n548:     out\n549: }\n550: \n551: fn needs_quote(ty: &Type) -> bool {\n552:     match ty {\n553:         Type::Str => true,\n554:         Type::Vec(elem) => needs_quote(elem),\n555:         Type::Record(_) => true,\n556:         // A unit variant prints as a quoted string, and a payload wrapper is a record.\n557:         Type::Enum { .. } => true,\n558:         _ => false,\n559:     }\n560: }\n561: \n562: fn contains_vec(enums: &Enums, ty: &Type) -> bool {\n563:     match ty {\n564:         Type::Vec(_) => true,\n565:         Type::Record(fields) => fields.iter().any(|(_, t)| contains_vec(enums, t)),\n566:         // The Vec arm answers before this one can loop: a self-reference is legal only behind\n567:         // a Vec, so a recursive enum's first payload hop is one.\n568:         Type::Enum { .. } => ty::variants(enums, ty)\n569:             .iter()\n570:             .any(|(_, p)| p.as_ref().is_some_and(|p| contains_vec(enums, p))),\n571:         _ => false,\n572:     }\n573: }\n574: \n575: /// Which identifiers are reserved is the target's business, not toylang's. A program with a\n576: /// function called `print` or `end` would otherwise emit Lua that shadows the output function or\n577: /// does not parse.\n578: fn user(name: &str) -> String {\n579:     format!(\"v_{name}\")\n580: }\n581: \n582: fn local(id: LocalId) -> String {\n583:     format!(\"t_{id}\")\n584: }\n585: \n586: #[derive(Default)]\n587: struct Helpers {\n588:     select: bool,\n589:     field: bool,\n590:     index: bool,\n591:     slice: bool,\n592:     unwrap: bool,\n593:     arith: bool,\n594:     arith64: bool,\n595:     map: bool,\n596:     range: bool,\n597:     collect: bool,\n598:     jsonlines: bool,\n599:     tail: bool,\n600:     flatten: bool,\n601:     chars: bool,\n602:     sort: bool,\n603:     reverse: bool,\n604:     sum: bool,\n605:     max: bool,\n606:     eq: bool,\n607:     split: bool,\n608: }\n609: \n610: /// Equality on a composite is structural, which Lua's `==` on two tables is not -- it compares\n611: /// references (kantord/toylang#68). Ordering on a composite is a separate open question and\n612: /// keeps whatever Lua does with it.\n613: fn compare(enums: &Enums, op: BinOp, lhs: &Tir, rhs: &Tir) -> String {\n614:     if !lhs.ty.is_composite() || !matches!(op, BinOp::Eq | BinOp::Ne) {\n615:         return format!(\"({} {} {})\", expr(enums, lhs), lua_op(op), expr(enums, rhs));\n616:     }\n617:     let call = format!(\"tl_eq({}, {})\", expr(enums, lhs), expr(enums, rhs));\n618:     match op {\n619:         BinOp::Ne => format!(\"(not {call})\"),\n620:         _ => call,\n621:     }\n622: }\n623: \n624: /// Parenthesised because there is more than one operator, and Lua's precedence is not toylang's\n625: /// to rely on. `..` is string-only, so a Vec reaches for the same helper `flatten` uses,\n626: /// wrapped around a two-entry outer table rather than through a second helper.\n627: fn concat(enums: &Enums, ty: &Type, l: &Tir, r: &Tir) -> String {\n628:     match ty {\n629:         Type::Vec(_) => format!(\"tl_flatten({{{}, {}}})\", expr(enums, l), expr(enums, r)),\n630:         _ => format!(\"({} .. {})\", expr(enums, l), expr(enums, r)),\n631:     }\n632: }\n633: \n634: /// Which helper a comparison reaches for, which is a question about the operator and the\n635: /// operand type rather than about the tree below it: Lua's `==` on two tables compares\n636: /// references, so equality on a composite walks the structure instead (kantord/toylang#68).\n637: fn compare_helpers(op: BinOp, operand: &Type, used: &mut Helpers) {\n638:     used.eq |= operand.is_composite() && matches!(op, BinOp::Eq | BinOp::Ne);\n639: }\n640: \n641: /// One helper per builtin whose Lua spelling is a function rather than an operator. `arg.ty` is\n642: /// needed for `sum` alone: `tl_sum` narrows through `tl_i32` when the element is an Int, so the\n643: /// helper that defines it has to be present alongside.\n644: fn builtin_helpers(which: Builtin, arg_ty: &Type, used: &mut Helpers) {\n645:     used.range |= which == Builtin::Range;\n646:     used.jsonlines |= which == Builtin::JsonLines;\n647:     used.tail |= which == Builtin::Tail;\n648:     used.flatten |= which == Builtin::Flatten;\n649:     used.chars |= which == Builtin::Chars;\n650:     used.sort |= which == Builtin::Sort;\n651:     used.reverse |= which == Builtin::Reverse;\n652:     used.sum |= which == Builtin::Sum;\n653:     used.max |= which == Builtin::Max;\n654:     used.arith |= which == Builtin::Sum && tir::runtime_elem(arg_ty) == Some(&Type::Int);\n655: }\n656: \n657: fn used_helpers(program: &Program) -> Helpers {\n658:     fn walk(t: &Tir, used: &mut Helpers) {\n659:         match &t.kind {\n660:             Kind::Str(_)\n661:             | Kind::Int(_)\n662:             | Kind::Float(_)\n663:             | Kind::Var(_)\n664:             | Kind::Local(_)\n665:             | Kind::Input\n666:             | Kind::Inputs => {}\n667:             // The source is what reads stdin now, so it is what needs the helper.\n668:             Kind::Lines => used.collect = true,\n669:             Kind::Dsv { .. } => {\n670:                 used.collect = true;\n671:                 used.split = true;\n672:             }\n673:             Kind::VecLit(items) => items.iter().for_each(|i| walk(i, used)),\n674:             Kind::RecordLit { fields } => {\n675:                 fields.iter().for_each(|(_, v)| walk(v, used));\n676:             }\n677:             Kind::EnumLit { payload, .. } => {\n678:                 if let Some(p) = payload {\n679:                     walk(p, used);\n680:                 }\n681:             }\n682:             Kind::Call { arg, .. } => {\n683:                 if let Some(a) = arg {\n684:                     walk(a, used);\n685:                 }\n686:             }\n687:             // Lua's `..` is string-only, so a Vec reaches for the same helper `flatten` uses,\n688:             // wrapped around a two-entry outer table rather than through a second helper.\n689:             Kind::Concat(l, r) => {\n690:                 used.flatten |= matches!(t.ty, Type::Vec(_));\n691:                 walk(l, used);\n692:                 walk(r, used);\n693:             }\n694:             Kind::Logic { lhs: l, rhs: r, .. } => {\n695:                 walk(l, used);\n696:                 walk(r, used);\n697:             }\n698:             Kind::Compare { op, lhs, rhs } => {\n699:                 compare_helpers(*op, &lhs.ty, used);\n700:                 walk(lhs, used);\n701:                 walk(rhs, used);\n702:             }\n703:             Kind::Bind { value, body, .. } => {\n704:                 walk(value, used);\n705:                 walk(body, used);\n706:             }\n707:             Kind::Map { source, body, .. } => {\n708:                 used.map = true;\n709:                 walk(source, used);\n710:                 walk(body, used);\n711:             }\n712:             Kind::OptMap { source, body, .. } => {\n713:                 walk(source, used);\n714:                 walk(body, used);\n715:             }\n716:             Kind::Select { source, pred, .. } => {\n717:                 used.select = true;\n718:                 walk(source, used);\n719:                 walk(pred, used);\n720:             }\n721:             Kind::Field { base, .. } => {\n722:                 // Depth zero is a plain index and needs no helper.\n723:                 used.field |= tir::vec_depth(&base.ty) > 0;\n724:                 walk(base, used);\n725:             }\n726:             Kind::Builtin { which, arg } => {\n727:                 builtin_helpers(*which, &arg.ty, used);\n728:                 walk(arg, used);\n729:             }\n730:             Kind::Arith { op, lhs, rhs } => {\n731:                 if t.ty == Type::Int64 {\n732:                     used.arith64 |= matches!(op, BinOp::Div | BinOp::Rem);\n733:                 } else {\n734:                     used.arith = true;\n735:                 }\n736:                 walk(lhs, used);\n737:                 walk(rhs, used);\n738:             }\n739:             Kind::Not(base) => walk(base, used),\n740:             Kind::Unwrap { base } => {\n741:                 used.unwrap = true;\n742:                 walk(base, used);\n743:             }\n744:             Kind::Index { base, index, .. } => {\n745:                 used.index = true;\n746:                 walk(base, used);\n747:                 walk(index, used);\n748:             }\n749:             Kind::Slice { base, start, end, .. } => {\n750:                 used.slice = true;\n751:                 walk(base, used);\n752:                 if let Some(s) = start {\n753:                     walk(s, used);\n754:                 }\n755:                 if let Some(e) = end {\n756:                     walk(e, used);\n757:                 }\n758:             }\n759:             Kind::Match { subject, arms, .. } => {\n760:                 walk(subject, used);\n761:                 for a in arms {\n762:                     if let Some(g) = &a.guard {\n763:                         walk(g, used);\n764:                     }\n765:                     walk(&a.body, used);\n766:                 }\n767:             }\n768:         }\n769:     }\n770:     let mut used = Helpers::default();\n771:     program.funcs.iter().for_each(|f| walk(&f.body, &mut used));\n772:     walk(&program.body, &mut used);\n773:     used\n774: }\n775: \n776: /// A partial chain's yield is an Opt, so a present arm is tagged; total chains return the\n777: /// body bare. Split out of `expr`'s match arm (kantord/toylang#62).\n778: fn arm_return(body: String, partial: bool) -> String {\n779:     if partial {\n780:         format!(\"return {{some = {body}}} \")\n781:     } else {\n782:         format!(\"return {body} \")\n783:     }\n784: }\n785: \n786: fn expr(enums: &Enums, t: &Tir) -> String {\n787:     match &t.kind {\n788:         Kind::Str(s) => lua_string(s),\n789:         Kind::Int(n) => n.to_string(),\n790:         Kind::Float(_) => unreachable!(\"Float is JS-only in this row\"),\n791:         Kind::Var(name) => user(name),\n792:         Kind::Local(id) => local(*id),\n793:         Kind::Input => INPUT.to_string(),\n794:         Kind::Inputs => INPUTS.to_string(),\n795:         // The stream, materialized eagerly: whatever consumes it -- `collect`, a mapper --\n796:         // works on the table of its entries. Fusion is what will remove this materialization.\n797:         Kind::Lines => \"tl_collect_lines()\".to_string(),\n798:         Kind::Dsv { delim } => format!(\n799:             \"tl_split_lines(tl_collect_lines(), {})\",\n800:             lua_string(delim)\n801:         ),\n802:         // A record is a table keyed by field name, which is what field access reads.\n803:         Kind::RecordLit { fields } => {\n804:             let parts: Vec<String> = fields\n805:                 .iter()\n806:                 .map(|(name, value)| format!(\"[{}] = {}\", lua_string(name), expr(enums, value)))\n807:                 .collect();\n808:             // Parenthesised because Lua will not index a table constructor: `{...}[\"a\"]` does\n809:             // not parse, and the printer reads every field straight off the value.\n810:             format!(\"({{{}}})\", parts.join(\", \"))\n811:         }\n812: \n813:         // The value is its JSON shape: a unit variant is the variant-name string, a payload\n814:         // variant the single-key table a record already is.\n815:         Kind::EnumLit { variant, payload } => match payload {\n816:             None => lua_string(variant),\n817:             Some(p) => format!(\"({{[{}] = {}}})\", lua_string(variant), expr(enums, p)),\n818:         },\n819: \n820:         Kind::VecLit(items) => {\n821:             let parts: Vec<String> = items.iter().map(|i| expr(enums, i)).collect();\n822:             format!(\"{{{}}}\", parts.join(\", \"))\n823:         }\n824:         Kind::Call { func, arg } => format!(\n825:             \"{}({})\",\n826:             user(func),\n827:             arg.as_deref().map_or_else(String::new, |a| expr(enums, a))\n828:         ),\n829:         Kind::Concat(l, r) => concat(enums, &t.ty, l, r),\n830:         Kind::Arith { op, lhs, rhs } => arith(&t.ty, *op, expr(enums, lhs), expr(enums, rhs)),\n831:         // Lua's `and`/`or` yield an operand rather than a boolean, which is the same thing here:\n832:         // both operands are already booleans, so whichever one comes back is one.\n833:         Kind::Logic { op, lhs, rhs } => format!(\"({} {op} {})\", expr(enums, lhs), expr(enums, rhs)),\n834:         Kind::Not(base) => format!(\"(not {})\", expr(enums, base)),\n835:         Kind::Builtin { which, arg } => match which {\n836:             Builtin::IntToStr => format!(\"tostring({})\", expr(enums, arg)),\n837:             // Lua's integers are 64-bit already; an Int just lives in the low half.\n838:             Builtin::IntToI64 => expr(enums, arg),\n839:             Builtin::Chars => format!(\"tl_chars({})\", expr(enums, arg)),\n840:             Builtin::Range => format!(\"tl_range({})\", expr(enums, arg)),\n841:             Builtin::JsonLines => {\n842:                 let elem = tir::runtime_elem(&arg.ty).expect(\"checked to be a Vec or a stream\");\n843:                 let e = \"e0\".to_string();\n844:                 format!(\n845:                     \"tl_jsonlines({}, function({e}) return {} end)\",\n846:                     expr(enums, arg),\n847:                     show(enums, elem, &e, 1)\n848:                 )\n849:             }\n850:             // The source already materialized, so the exit has nothing left to do.\n851:             Builtin::Collect => expr(enums, arg),\n852:             Builtin::Length => format!(\"#{}\", expr(enums, arg)),\n853:             Builtin::Tail => format!(\"tl_tail({})\", expr(enums, arg)),\n854:             Builtin::Flatten => format!(\"tl_flatten({})\", expr(enums, arg)),\n855:             Builtin::Sort => format!(\"tl_sort({})\", expr(enums, arg)),\n856:             Builtin::Reverse => format!(\"tl_reverse({})\", expr(enums, arg)),\n857:             Builtin::Sum => format!(\n858:                 \"tl_sum({}, {})\",\n859:                 expr(enums, arg),\n860:                 tir::runtime_elem(&arg.ty) == Some(&Type::Int)\n861:             ),\n862:             Builtin::Max => format!(\"tl_max({})\", expr(enums, arg)),\n863:             // The names come from the checked type, not the table value, so `arg` runs as the\n864:             // function literal's ignored parameter -- the same IIFE shape `Bind` uses -- purely\n865:             // for whatever else it does.\n866:             Builtin::Fields => {\n867:                 let Type::Record(fields) = &arg.ty else {\n868:                     unreachable!(\"checked to be a record\")\n869:                 };\n870:                 let names: Vec<String> = fields.iter().map(|(n, _)| lua_string(n)).collect();\n871:                 format!(\n872:                     \"(function(_) return {{{}}} end)({})\",\n873:                     names.join(\", \"),\n874:                     expr(enums, arg)\n875:                 )\n876:             }\n877:         },\n878:         Kind::Compare { op, lhs, rhs } => compare(enums, *op, lhs, rhs),\n879:         // Lua has no expression-level `let`, so the binding becomes a call.\n880:         Kind::Bind {\n881:             local: id,\n882:             value,\n883:             body,\n884:         } => {\n885:             format!(\n886:                 \"(function({}) return {} end)({})\",\n887:                 local(*id),\n888:                 expr(enums, body),\n889:                 expr(enums, value)\n890:             )\n891:         }\n892:         Kind::Map {\n893:             source,\n894:             param,\n895:             body,\n896:         } => format!(\n897:             \"tl_map({}, function({}) return {} end)\",\n898:             expr(enums, source),\n899:             local(*param),\n900:             expr(enums, body)\n901:         ),\n902:         Kind::Select {\n903:             source,\n904:             param,\n905:             pred,\n906:         } => format!(\n907:             \"tl_select({}, function({}) return {} end)\",\n908:             expr(enums, source),\n909:             local(*param),\n910:             expr(enums, pred)\n911:         ),\n912:         // The depth comes from the type on the node below, so it cannot disagree with it, and\n913:         // the emitted helper is told the answer rather than inspecting the value for it.\n914:         Kind::Unwrap { base } => {\n915:             format!(\n916:                 \"tl_unwrap({}, {})\",\n917:                 expr(enums, base),\n918:                 tir::vec_depth(&base.ty)\n919:             )\n920:         }\n921:         // Opt's reorder pass (kantord/toylang#66): the same `== \"none\"`/`.some` shape the\n922:         // printer and Match already read, generalised to rebuild the table instead.\n923:         Kind::OptMap {\n924:             source,\n925:             param,\n926:             body,\n927:         } => format!(\n928:             \"(function(__opt) if __opt == \\\"none\\\" then return \\\"none\\\" else local {} = __opt.some return {{some = {}}} end end)({})\",\n929:             local(*param),\n930:             expr(enums, body),\n931:             expr(enums, source)\n932:         ),\n933:         // A Lua table of records is a table of tables, so collapsing needs no gather here;\n934:         // `elem_is_record` matters only where the columns are stored apart.\n935:         Kind::Index {\n936:             base, index, depth, ..\n937:         } => {\n938:             format!(\n939:                 \"tl_at({}, {}, {})\",\n940:                 expr(enums, base),\n941:                 expr(enums, index),\n942:                 depth\n943:             )\n944:         }\n945:         Kind::Slice {\n946:             base, start, end, depth,\n947:         } => {\n948:             let lo = match start {\n949:                 Some(s) => expr(enums, s),\n950:                 None => \"nil\".to_string(),\n951:             };\n952:             let hi = match end {\n953:                 Some(e) => expr(enums, e),\n954:                 None => \"nil\".to_string(),\n955:             };\n956:             format!(\n957:                 \"tl_slice({}, {}, {}, {})\",\n958:                 expr(enums, base),\n959:                 lo,\n960:                 hi,\n961:                 depth\n962:             )\n963:         }\n964:         Kind::Field { base, name } => {\n965:             let depth = tir::vec_depth(&base.ty);\n966:             if depth == 0 {\n967:                 format!(\"{}[{}]\", expr(enums, base), lua_string(name))\n968:             } else {\n969:                 format!(\n970:                     \"tl_field({}, {}, {})\",\n971:                     expr(enums, base),\n972:                     lua_string(name),\n973:                     depth\n974:                 )\n975:             }\n976:         }\n977:         // A chain of tests over the subject (a plain local, so re-reading it is free): string\n978:         // equality for a unit variant, key presence for a payload variant, the guard's own\n979:         // Bool for a guard arm. A total chain's last arm needs no test, the checker having\n980:         // proved nothing else can reach it; a partial chain tests every arm and falls through\n981:         // to `tl_none`, the absent Opt.\n982:         Kind::Match {\n983:             subject,\n984:             arms,\n985:             partial,\n986:         } => {\n987:             let subj = expr(enums, subject);\n988:             let mut body = String::new();\n989:             for (i, arm) in arms.iter().enumerate() {\n990:                 let mut run = String::new();\n991:                 if let Some(pid) = arm.payload {\n992:                     let variant = arm\n993:                         .variant\n994:                         .as_ref()\n995:                         .expect(\"only a variant arm has a payload\");\n996:                     run.push_str(&format!(\n997:                         \"local {} = {subj}[{}] \",\n998:                         local(pid),\n999:                         lua_string(variant)\n1000:                     ));\n1001:                 }\n1002:                 run.push_str(&arm_return(expr(enums, &arm.body), *partial));\n1003:                 let test = match (&arm.variant, &arm.guard) {\n1004:                     (Some(v), _) if arm.payload.is_some() => {\n1005:                         Some(format!(\"{subj}[{}] ~= nil\", lua_string(v)))\n1006:                     }\n1007:                     (Some(v), _) => Some(format!(\"{subj} == {}\", lua_string(v))),\n1008:                     (None, Some(g)) => Some(expr(enums, g)),\n1009:                     (None, None) => None,\n1010:                 };\n1011:                 match test {\n1012:                     Some(test) if *partial || i + 1 < arms.len() => {\n1013:                         body.push_str(&format!(\"if {test} then {run}end \"));\n1014:                     }\n1015:                     _ => body.push_str(&run),\n1016:                 }\n1017:             }\n1018:             if *partial {\n1019:                 body.push_str(\"return \\\"none\\\" \");\n1020:             }\n1021:             format!(\"(function() {body}end)()\")\n1022:         }\n1023:     }\n1024: }\n1025: \n1026: /// One arithmetic expression at the width the node's type names. At 64 bits Lua's own\n1027: /// integers are the semantics (kantord/toylang#83): `+`, `-` and `*` wrap natively, so only\n1028: /// division and remainder go through a helper.\n1029: fn arith(ty: &Type, op: BinOp, l: String, r: String) -> String {\n1030:     if *ty == Type::Int64 {\n1031:         match op {\n1032:             BinOp::Div => format!(\"tl_div64({l}, {r})\"),\n1033:             BinOp::Rem => format!(\"tl_rem64({l}, {r})\"),\n1034:             BinOp::Add => format!(\"({l} + {r})\"),\n1035:             BinOp::Sub => format!(\"({l} - {r})\"),\n1036:             BinOp::Mul => format!(\"({l} * {r})\"),\n1037:             other => unreachable!(\"{other} is not arithmetic\"),\n1038:         }\n1039:     } else {\n1040:         match op {\n1041:             BinOp::Div => format!(\"tl_div({l}, {r})\"),\n1042:             BinOp::Rem => format!(\"tl_rem({l}, {r})\"),\n1043:             BinOp::Add => format!(\"tl_i32({l} + {r})\"),\n1044:             BinOp::Sub => format!(\"tl_i32({l} - {r})\"),\n1045:             BinOp::Mul => format!(\"tl_i32({l} * {r})\"),\n1046:             other => unreachable!(\"{other} is not arithmetic\"),\n1047:         }\n1048:     }\n1049: }\n1050: \n1051: fn lua_op(op: BinOp) -> &'static str {\n1052:     match op {\n1053:         BinOp::Eq => \"==\",\n1054:         BinOp::Ne => \"~=\",\n1055:         BinOp::Lt => \"<\",\n1056:         BinOp::Le => \"<=\",\n1057:         BinOp::Gt => \">\",\n1058:         BinOp::Ge => \">=\",\n1059:         other => unreachable!(\"{other} is not a comparison\"),\n1060:     }\n1061: }\n1062: \n1063: fn lua_string(s: &str) -> String {\n1064:     let mut out = String::with_capacity(s.len() + 2);\n1065:     out.push('\"');\n1066:     for c in s.chars() {\n1067:         match c {\n1068:             '\"' => out.push_str(\"\\\\\\\"\"),\n1069:             '\\\\' => out.push_str(\"\\\\\\\\\"),\n1070:             '\\n' => out.push_str(\"\\\\n\"),\n1071:             '\\r' => out.push_str(\"\\\\r\"),\n1072:             '\\t' => out.push_str(\"\\\\t\"),\n1073:             // Lua reads \\ddd as a byte, so anything above ASCII has to go through as its\n1074:             // UTF-8 bytes rather than as a codepoint escape.\n1075:             c if (c as u32) < 0x20 || c == '\\u{7f}' => {\n1076:                 out.push_str(&format!(\"\\\\{:03}\", c as u32));\n1077:             }\n1078:             c => out.push(c),\n1079:         }\n1080:     }\n1081:     out.push('\"');\n1082:     out\n1083: }\n\n(End of file - total 1083 lines)\n</content>","metadata":{"preview":"use crate::ast::BinOp;\nuse crate::tir::{self, Builtin, Kind, LocalId, Program, Tir};\nuse crate::ty::{self, Enums, Type};\n\n/// The global the input value is bound to before the chunk runs. Unspellable in source, since\n/// every source name is prefixed.\npub const INPUT: &str = \"t_input\";\n/// The global every remaining stdin line, already parsed, is bound to before the chunk runs.\npub const INPUTS: &str = \"t_inputs\";\n/// The function `run_lua` injects in place of `INPUTS` for a fused, live-streamable program:\n/// called with no arguments, it returns the next `inputs` record already parsed and converted,\n/// or `nil` at EOF. See `tir::fusion` and this file's `fused_main`.\npub const NEXT_INPUT: &str = \"tl_next_input\";\n\nconst SELECT_HELPER: &str = \"\\\nlocal function tl_select(src, pred)\n  local out = {}\n  for i = 1, #src do\n    if pred(src[i]) then out[#out + 1] = src[i] end\n  end","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-float-build-lua/src/emit_lua.rs","text":"use crate::ast::BinOp;\nuse crate::tir::{self, Builtin, Kind, LocalId, Program, Tir};\nuse crate::ty::{self, Enums, Type};\n\n/// The global the input value is bound to before the chunk runs. Unspellable in source, since\n/// every source name is prefixed.\npub const INPUT: &str = \"t_input\";\n/// The global every remaining stdin line, already parsed, is bound to before the chunk runs.\npub const INPUTS: &str = \"t_inputs\";\n/// The function `run_lua` injects in place of `INPUTS` for a fused, live-streamable program:\n/// called with no arguments, it returns the next `inputs` record already parsed and converted,\n/// or `nil` at EOF. See `tir::fusion` and this file's `fused_main`.\npub const NEXT_INPUT: &str = \"tl_next_input\";\n\nconst SELECT_HELPER: &str = \"\\\nlocal function tl_select(src, pred)\n  local out = {}\n  for i = 1, #src do\n    if pred(src[i]) then out[#out + 1] = src[i] end\n  end\n  return out\nend\n\";\n\nconst FIELD_HELPER: &str = \"\\\nlocal function tl_field(v, k, depth)\n  if depth == 0 then return v[k] end\n  local out = {}\n  for i = 1, #v do out[i] = tl_field(v[i], k, depth - 1) end\n  return out\nend\n\";\n\nconst RANGE_HELPER: &str = \"\\\nlocal function tl_range(n)\n  local out = {}\n  for i = 1, n do out[i] = i - 1 end\n  return out\nend\n\";\n\nconst COLLECT_HELPER: &str = \"\\\nlocal function tl_collect_lines()\n  local out = {}\n  for line in io.lines() do out[#out + 1] = line end\n  return out\nend\n\";\n\n// `dsv` splits each collected line on the delimiter. `string.find` with `plain = true` is the\n// literal-search form, so the delimiter is not read as a Lua pattern.\nconst SPLIT_HELPER: &str = \"\\\nlocal function tl_split(s, sep)\n  local out = {}\n  local pos = 1\n  while true do\n    local start, stop = string.find(s, sep, pos, true)\n    if not start then\n      out[#out + 1] = string.sub(s, pos)\n      break\n    end\n    out[#out + 1] = string.sub(s, pos, start - 1)\n    pos = stop + 1\n  end\n  return out\nend\n\nlocal function tl_split_lines(lines, sep)\n  local out = {}\n  for i = 1, #lines do out[i] = tl_split(lines[i], sep) end\n  return out\nend\n\";\n\nconst MAP_HELPER: &str = \"\\\nlocal function tl_map(src, f)\n  local out = {}\n  for i = 1, #src do out[i] = f(src[i]) end\n  return out\nend\n\";\n\nconst OPT_HELPER: &str = \"\\\n-- An Opt is its enum's own runtime shape (ADR 0009): `{some = v}` present, \\\"none\\\" absent.\n-- Tagged, so two levels of absence stay two values; only the printer flattens to null. A\n-- table rather than nil also keeps `#` honest for a Vec of Opt.\nlocal function tl_at(v, i, depth)\n  if depth > 0 then\n    local out = {}\n    for k = 1, #v do out[k] = tl_at(v[k], i, depth - 1) end\n    return out\n  end\n  local n = #v\n  if i < 0 then i = n + i end\n  if i < 0 or i >= n then return \\\"none\\\" end\n  return { some = v[i + 1] }\nend\n\";\n\n// Lua has no slice operator, so the clamping is spelled out: negatives count from the end,\n// then both bounds clamp to [0, n], and a crossed window is empty. A `nil` bound is one left\n// out (0 for the start, n for the end).\nconst SLICE_HELPER: &str = \"\\\nlocal function tl_slice(v, lo, hi, depth)\n  if depth > 0 then\n    local out = {}\n    for k = 1, #v do out[k] = tl_slice(v[k], lo, hi, depth - 1) end\n    return out\n  end\n  local n = #v\n  local function norm(i)\n    if i == nil then return nil end\n    if i < 0 then i = n + i end\n    if i < 0 then i = 0 end\n    if i > n then i = n end\n    return i\n  end\n  lo = norm(lo) or 0\n  hi = norm(hi) or n\n  local out = {}\n  if lo < hi then\n    local j = 0\n    for i = lo + 1, hi do j = j + 1 out[j] = v[i] end\n  end\n  return out\nend\n\";\n\nconst TAIL_HELPER: &str = \"\\\nlocal function tl_tail(v)\n  if #v == 0 then return \\\"none\\\" end\n  local out = {}\n  for i = 2, #v do out[i - 1] = v[i] end\n  return { some = out }\nend\n\";\n\nconst FLATTEN_HELPER: &str = \"\\\nlocal function tl_flatten(vv)\n  local out = {}\n  for i = 1, #vv do\n    local inner = vv[i]\n    for j = 1, #inner do out[#out + 1] = inner[j] end\n  end\n  return out\nend\n\";\n\n// `table.sort`'s default comparator is Lua's own `<`, which already agrees with every other\n// backend's ordering on both numbers and (byte-wise, so codepoint-wise for valid UTF-8) strings,\n// so nothing here has to branch on the element type.\nconst SORT_HELPER: &str = \"\\\nlocal function tl_sort(v)\n  local out = {}\n  for i = 1, #v do out[i] = v[i] end\n  table.sort(out)\n  return out\nend\n\";\n\nconst REVERSE_HELPER: &str = \"\\\nlocal function tl_reverse(v)\n  local out = {}\n  local n = #v\n  for i = 1, n do out[i] = v[n - i + 1] end\n  return out\nend\n\";\n\n// `narrow` is true exactly when the element type is Int: both widths live in the same 64-bit\n// integer here, so the only difference is whether each addition is brought back to 32 bits the\n// way `+` does.\nconst SUM_HELPER: &str = \"\\\nlocal function tl_sum(v, narrow)\n  local acc = 0\n  for i = 1, #v do\n    acc = acc + v[i]\n    if narrow then acc = tl_i32(acc) end\n  end\n  return acc\nend\n\";\n\nconst MAX_HELPER: &str = \"\\\nlocal function tl_max(v)\n  if #v == 0 then return \\\"none\\\" end\n  local m = v[1]\n  for i = 2, #v do\n    if v[i] > m then m = v[i] end\n  end\n  return { some = m }\nend\n\";\n\nconst UNWRAP_HELPER: &str = r#\"local function tl_unwrap(v, depth)\n  if depth > 0 then\n    local out = {}\n    for k = 1, #v do out[k] = tl_unwrap(v[k], depth - 1) end\n    return out\n  end\n  if v == \"none\" then error(\"toylang: unwrapped a value that is not there\", 0) end\n  return v.some\nend\n\"#;\n\n// A record and a payload-carrying variant are both tables, and Lua's `==` on two tables is\n// identity, so `{a = 1} == {a = 1}` was false here and true on Python (kantord/toylang#68).\n// Structural equality is the ratified answer, so composites walk. Keyed rather than ordered:\n// two spellings of one record type may reach here in different field orders.\nconst EQ_HELPER: &str = \"\\\nlocal function tl_eq(a, b)\n  if a == b then return true end\n  if type(a) ~= \\\"table\\\" or type(b) ~= \\\"table\\\" then return false end\n  local extra = 0\n  for k, v in pairs(a) do\n    extra = extra + 1\n    if not tl_eq(v, b[k]) then return false end\n  end\n  for _ in pairs(b) do extra = extra - 1 end\n  return extra == 0\nend\n\";\n\nconst ARITH_HELPER: &str = r#\"local TL_2_31 <const> = 2147483648\nlocal TL_2_32 <const> = 4294967296\n-- Lua integers are 64-bit, so an Int has to be brought back into 32 bits after every operation.\n-- `%` is floored here and the modulus is positive, so this is exact for negatives too.\nlocal function tl_i32(x)\n  return (x + TL_2_31) % TL_2_32 - TL_2_31\nend\n-- Lua's `//` floors and `%` is floored; toylang truncates, which math.fmod already does.\nlocal function tl_div(a, b)\n  if b == 0 then error(\"toylang: divided by zero\", 0) end\n  return tl_i32((a - math.fmod(a, b)) // b)\nend\nlocal function tl_rem(a, b)\n  if b == 0 then error(\"toylang: divided by zero\", 0) end\n  return tl_i32(math.fmod(a, b))\nend\n\"#;\n\n// Lua's integers already are 64-bit and wrap (kantord/toylang#83), so an Int64's `+`, `-` and\n// `*` need nothing at all -- the one backend where the wider type is cheaper than the narrow\n// one. Only division needs spelling: `//` floors where toylang truncates, and `math.fmod` is\n// already truncated, so the same fmod-then-divide `tl_div` uses works with the `tl_i32` taken\n// off. `MIN // -1` wraps back to `MIN` on its own, Lua's documented overflow rule.\nconst ARITH64_HELPER: &str = r#\"local function tl_div64(a, b)\n  if b == 0 then error(\"toylang: divided by zero\", 0) end\n  return (a - math.fmod(a, b)) // b\nend\nlocal function tl_rem64(a, b)\n  if b == 0 then error(\"toylang: divided by zero\", 0) end\n  return math.fmod(a, b)\nend\n\"#;\n\nconst QUOTE_HELPER: &str = r#\"local function tl_quote(s)\n  return '\"' .. s:gsub('[%c\"\\\\]', function(c)\n    if c == '\"' then return '\\\\\"' end\n    if c == '\\\\' then return '\\\\\\\\' end\n    if c == '\\n' then return '\\\\n' end\n    if c == '\\r' then return '\\\\r' end\n    if c == '\\t' then return '\\\\t' end\n    return string.format('\\\\u%04x', c:byte())\n  end) .. '\"'\nend\n\"#;\n\nconst JOIN_HELPER: &str = \"\\\nlocal function tl_join(v, f)\n  local parts = {}\n  for i = 1, #v do parts[i] = f(v[i]) end\n  return \\\"[\\\" .. table.concat(parts, \\\",\\\") .. \\\"]\\\"\nend\n\";\n\nconst JSONLINES_HELPER: &str = \"\\\nlocal function tl_jsonlines(v, f)\n  local parts = {}\n  for i = 1, #v do parts[i] = f(v[i]) end\n  return table.concat(parts, \\\"\\\\n\\\")\nend\n\";\n\n// Lua strings are byte arrays with no Unicode awareness, so decoding by codepoint (rather than\n// by byte) has to be hand-rolled, the same as the native runtime's tl_chars does in C.\nconst CHARS_HELPER: &str = r#\"local function tl_chars(s)\n  local out = {}\n  local i = 1\n  local n = #s\n  while i <= n do\n    local b0 = s:byte(i)\n    local cp, extra\n    if b0 < 0x80 then cp, extra = b0, 0\n    elseif b0 & 0xE0 == 0xC0 then cp, extra = b0 & 0x1F, 1\n    elseif b0 & 0xF0 == 0xE0 then cp, extra = b0 & 0x0F, 2\n    else cp, extra = b0 & 0x07, 3\n    end\n    i = i + 1\n    for _ = 1, extra do\n      cp = (cp << 6) | (s:byte(i) & 0x3F)\n      i = i + 1\n    end\n    out[#out + 1] = cp\n  end\n  return out\nend\n\"#;\n\npub fn emit(program: &Program) -> String {\n    let enums = &program.enums;\n    let mut out = String::new();\n\n    let used = used_helpers(program);\n    // A top-level Str prints raw, the way jq's -r does; anything else prints as JSON. So a\n    // string inside a Vec is quoted while a bare string is not.\n    let structured = !matches!(program.body.ty, Type::Str | Type::Sink);\n    let quote = (structured && needs_quote(&program.body.ty)) || used.jsonlines;\n    let join = (structured && contains_vec(enums, &program.body.ty)) || used.jsonlines;\n    for (on, text) in [\n        (used.select, SELECT_HELPER),\n        (used.field, FIELD_HELPER),\n        (quote, QUOTE_HELPER),\n        (join, JOIN_HELPER),\n        (used.index, OPT_HELPER),\n        (used.slice, SLICE_HELPER),\n        (used.unwrap, UNWRAP_HELPER),\n        (used.tail, TAIL_HELPER),\n        (used.flatten, FLATTEN_HELPER),\n        (used.sort, SORT_HELPER),\n        (used.reverse, REVERSE_HELPER),\n        (used.arith, ARITH_HELPER),\n        (used.arith64, ARITH64_HELPER),\n        // After ARITH_HELPER: `tl_sum` narrows through `tl_i32`, and a local declared later in\n        // the same chunk is invisible to an earlier function body, which would fall back to the\n        // nil global at runtime.\n        (used.sum, SUM_HELPER),\n        (used.max, MAX_HELPER),\n        (used.map, MAP_HELPER),\n        (used.range, RANGE_HELPER),\n        (used.collect, COLLECT_HELPER),\n        (used.split, SPLIT_HELPER),\n        (used.jsonlines, JSONLINES_HELPER),\n        (used.chars, CHARS_HELPER),\n        (used.eq, EQ_HELPER),\n    ] {\n        if on {\n            out.push_str(text);\n        }\n    }\n\n    out.push_str(&printers(program));\n\n    // All names are declared before any body, because the checker collects signatures before\n    // checking bodies and so accepts a call to a function defined further down. Emitting\n    // `local function` in source order would leave that call resolving to a nil global.\n    if !program.funcs.is_empty() {\n        let names: Vec<String> = program.funcs.iter().map(|f| user(&f.name)).collect();\n        out.push_str(&format!(\"local {}\\n\", names.join(\", \")));\n    }\n\n    for f in &program.funcs {\n        out.push_str(&format!(\n            \"function {}({})\\n  return {}\\nend\\n\",\n            user(&f.name),\n            f.param.as_deref().map_or_else(String::new, user),\n            expr(enums, &f.body)\n        ));\n    }\n\n    if let Some(fusion) = tir::fusion(program) {\n        out.push_str(&fused_main(program, &fusion));\n    } else {\n        let body = expr(enums, &program.body);\n        if structured {\n            out.push_str(&format!(\n                \"print({})\\n\",\n                show(enums, &program.body.ty, &body, 0)\n            ));\n        } else {\n            out.push_str(&format!(\"print({body})\\n\"));\n        }\n    }\n    out\n}\n\n/// A stream-typed `jsonlines` program, compiled as a loop over one entry at a time: for an\n/// `inputs` source, a call to `NEXT_INPUT` for one already-parsed record (see that constant's\n/// doc comment for why the parsing itself is not written here); for `lines`, `io.lines()`\n/// itself, exactly as the eager collect helper reads it.\nfn fused_main(program: &Program, fusion: &tir::Fusion) -> String {\n    let enums = &program.enums;\n    let mut out = String::new();\n    let (mut current, mut current_ty) = match fusion.source {\n        tir::Source::Inputs => {\n            out.push_str(\"while true do\\n\");\n            out.push_str(&format!(\"  local t_line = {NEXT_INPUT}()\\n\"));\n            out.push_str(\"  if t_line == nil then break end\\n\");\n            let elem = program\n                .inputs\n                .as_ref()\n                .expect(\"an inputs source recorded its element\");\n            (\"t_line\".to_string(), elem.clone())\n        }\n        tir::Source::Lines => {\n            out.push_str(\"for t_line in io.lines() do\\n\");\n            (\"t_line\".to_string(), Type::Str)\n        }\n        // The bound is evaluated once; the loop counter is the element. A negative bound makes\n        // Lua's numeric for run zero times (start > limit), the same answer `tl_range` gives\n        // eagerly.\n        tir::Source::Range(bound) => {\n            out.push_str(&format!(\"local n = {}\\n\", expr(enums, bound)));\n            out.push_str(\"for t_i = 0, n - 1 do\\n\");\n            (\"t_i\".to_string(), Type::Int)\n        }\n    };\n    for stage in &fusion.stages {\n        match stage {\n            tir::Stage::Map { param, body } => {\n                out.push_str(&format!(\"  local {} = {}\\n\", local(*param), current));\n                current = expr(enums, body);\n                current_ty = body.ty.clone();\n            }\n            tir::Stage::Select { param, pred } => {\n                out.push_str(&format!(\"  local {} = {}\\n\", local(*param), current));\n                out.push_str(&format!(\n                    \"  if not ({}) then goto tl_continue end\\n\",\n                    expr(enums, pred)\n                ));\n                current = local(*param);\n            }\n        }\n    }\n    // Always the JSON rendering, never the top-level raw-Str rule: each line is one JSON value\n    // (that is what jsonlines promises), so a Str element prints quoted here exactly as the\n    // eager path's per-element `show` prints it. Only whole-program results print raw.\n    let printed = show(enums, &current_ty, &current, 0);\n    out.push_str(&format!(\"  print({printed})\\n\"));\n    out.push_str(\"  ::tl_continue::\\n\");\n    out.push_str(\"end\\n\");\n    out\n}\n\n/// The printer is built from the type rather than by inspecting the value. A Lua table cannot\n/// say whether it is an array or a record -- an empty one is indistinguishable either way -- so\n/// asking it was always going to disagree with a backend that knows. See emit_js for the same\n/// function, and step 4 onwards, where a native target has nothing to ask.\nfn show(enums: &Enums, ty: &Type, value: &str, depth: usize) -> String {\n    match ty {\n        Type::Param(_) => unreachable!(\"params are substituted before emit\"),\n        // The checker refuses a program whose result contains a stream, since there is nothing to\n        // print: a stream has no value, only a promise that collect can redeem.\n        Type::Stream(_) => unreachable!(\"a stream cannot reach the printer\"),\n        Type::Char => unreachable!(\"Char cannot reach the printer, refused by the checker\"),\n        Type::Str => format!(\"tl_quote({value})\"),\n        Type::Sink => unreachable!(\"a sink only ever prints raw, never through the printer\"),\n        Type::Int | Type::Int64 | Type::Bool => format!(\"tostring({value})\"),\n        Type::Float => unreachable!(\"Float is JS-only in this row\"),\n        Type::Vec(elem) => {\n            let e = format!(\"e{depth}\");\n            format!(\n                \"tl_join({value}, function({e}) return {} end)\",\n                show(enums, elem, &e, depth + 1)\n            )\n        }\n        Type::Enum { .. } if ty.as_opt().is_some() => {\n            let inner = ty.as_opt().expect(\"guarded\");\n            let v = format!(\"o{depth}\");\n            format!(\n                \"(function({v}) if {v} == \\\"none\\\" then return \\\"null\\\" else return {} end end)({value})\",\n                show(enums, inner, &format!(\"{v}.some\"), depth + 1)\n            )\n        }\n        // A recursive enum prints through a function of its own (`printers`), because expanding\n        // one here has no bottom: its payload leads back to the same type.\n        Type::Enum { .. } if ty::is_recursive(enums, ty) => format!(\"{}({value})\", ty.show_fn()),\n        Type::Enum { .. } => show_enum(enums, ty, value, depth),\n        Type::Record(fields) => {\n            // `..` needs an operand on each side, so a record with no fields cannot be\n            // built by joining nothing. The other backends survive this by construction.\n            if fields.is_empty() {\n                return \"\\\"{}\\\"\".to_string();\n            }\n            // The type's field list is declaration order, so this prints as declared. Field\n            // names are identifiers, so the JSON key needs no escaping and is one literal.\n            let parts: Vec<String> = fields\n                .iter()\n                .map(|(name, fty)| {\n                    let read = format!(\"{value}[{}]\", lua_string(name));\n                    let key = lua_string(&format!(\"\\\"{name}\\\":\"));\n                    format!(\"{key} .. {}\", show(enums, fty, &read, depth + 1))\n                })\n                .collect();\n            format!(\"(\\\"{{\\\" .. {} .. \\\"}}\\\")\", parts.join(\" .. \\\",\\\" .. \"))\n        }\n    }\n}\n\n/// The printer for one enum, inline. One type, two runtime shapes (ADR 0009): a unit variant is\n/// a bare string, a payload variant a single-key table, so this is the one printer that has to\n/// look before it renders. Only the shape is inspected; which payload follows which key is the\n/// type's.\nfn show_enum(enums: &Enums, ty: &Type, value: &str, depth: usize) -> String {\n    let variants = ty::variants(enums, ty);\n    let n = format!(\"n{depth}\");\n    let payloads: Vec<&(String, Option<Type>)> =\n        variants.iter().filter(|(_, p)| p.is_some()).collect();\n    if payloads.is_empty() {\n        return format!(\"tl_quote({value})\");\n    }\n    let mut body = String::new();\n    if payloads.len() < variants.len() {\n        body.push_str(&format!(\n            \"if type({n}) == \\\"string\\\" then return tl_quote({n}) end \"\n        ));\n    }\n    for (i, (vname, pty)) in payloads.iter().enumerate() {\n        let pty = pty.as_ref().expect(\"filtered to payload variants\");\n        let read = format!(\"{n}[{}]\", lua_string(vname));\n        let wrapped = format!(\n            \"({} .. {} .. \\\"}}\\\")\",\n            lua_string(&format!(\"{{\\\"{vname}\\\":\")),\n            show(enums, pty, &read, depth + 1)\n        );\n        if i + 1 < payloads.len() {\n            body.push_str(&format!(\"if {read} ~= nil then return {wrapped} end \"));\n        } else {\n            // The last payload variant needs no test: the type says nothing else is left.\n            body.push_str(&format!(\"return {wrapped} \"));\n        }\n    }\n    format!(\"(function({n}) {body}end)({value})\")\n}\n\n/// A named printer for every recursive enum the program prints. The call in `show` above is\n/// what a nested occurrence renders as, so the recursion in the type becomes recursion in the\n/// emitted function rather than in this compiler (kantord/toylang#94).\nfn printers(program: &Program) -> String {\n    let mut out = String::new();\n    for ty in tir::printed_recursive_enums(program) {\n        out.push_str(&format!(\n            \"function {}(v)\\n  return {}\\nend\\n\",\n            ty.show_fn(),\n            show_enum(&program.enums, &ty, \"v\", 0)\n        ));\n    }\n    out\n}\n\nfn needs_quote(ty: &Type) -> bool {\n    match ty {\n        Type::Str => true,\n        Type::Vec(elem) => needs_quote(elem),\n        Type::Record(_) => true,\n        // A unit variant prints as a quoted string, and a payload wrapper is a record.\n        Type::Enum { .. } => true,\n        _ => false,\n    }\n}\n\nfn contains_vec(enums: &Enums, ty: &Type) -> bool {\n    match ty {\n        Type::Vec(_) => true,\n        Type::Record(fields) => fields.iter().any(|(_, t)| contains_vec(enums, t)),\n        // The Vec arm answers before this one can loop: a self-reference is legal only behind\n        // a Vec, so a recursive enum's first payload hop is one.\n        Type::Enum { .. } => ty::variants(enums, ty)\n            .iter()\n            .any(|(_, p)| p.as_ref().is_some_and(|p| contains_vec(enums, p))),\n        _ => false,\n    }\n}\n\n/// Which identifiers are reserved is the target's business, not toylang's. A program with a\n/// function called `print` or `end` would otherwise emit Lua that shadows the output function or\n/// does not parse.\nfn user(name: &str) -> String {\n    format!(\"v_{name}\")\n}\n\nfn local(id: LocalId) -> String {\n    format!(\"t_{id}\")\n}\n\n#[derive(Default)]\nstruct Helpers {\n    select: bool,\n    field: bool,\n    index: bool,\n    slice: bool,\n    unwrap: bool,\n    arith: bool,\n    arith64: bool,\n    map: bool,\n    range: bool,\n    collect: bool,\n    jsonlines: bool,\n    tail: bool,\n    flatten: bool,\n    chars: bool,\n    sort: bool,\n    reverse: bool,\n    sum: bool,\n    max: bool,\n    eq: bool,\n    split: bool,\n}\n\n/// Equality on a composite is structural, which Lua's `==` on two tables is not -- it compares\n/// references (kantord/toylang#68). Ordering on a composite is a separate open question and\n/// keeps whatever Lua does with it.\nfn compare(enums: &Enums, op: BinOp, lhs: &Tir, rhs: &Tir) -> String {\n    if !lhs.ty.is_composite() || !matches!(op, BinOp::Eq | BinOp::Ne) {\n        return format!(\"({} {} {})\", expr(enums, lhs), lua_op(op), expr(enums, rhs));\n    }\n    let call = format!(\"tl_eq({}, {})\", expr(enums, lhs), expr(enums, rhs));\n    match op {\n        BinOp::Ne => format!(\"(not {call})\"),\n        _ => call,\n    }\n}\n\n/// Parenthesised because there is more than one operator, and Lua's precedence is not toylang's\n/// to rely on. `..` is string-only, so a Vec reaches for the same helper `flatten` uses,\n/// wrapped around a two-entry outer table rather than through a second helper.\nfn concat(enums: &Enums, ty: &Type, l: &Tir, r: &Tir) -> String {\n    match ty {\n        Type::Vec(_) => format!(\"tl_flatten({{{}, {}}})\", expr(enums, l), expr(enums, r)),\n        _ => format!(\"({} .. {})\", expr(enums, l), expr(enums, r)),\n    }\n}\n\n/// Which helper a comparison reaches for, which is a question about the operator and the\n/// operand type rather than about the tree below it: Lua's `==` on two tables compares\n/// references, so equality on a composite walks the structure instead (kantord/toylang#68).\nfn compare_helpers(op: BinOp, operand: &Type, used: &mut Helpers) {\n    used.eq |= operand.is_composite() && matches!(op, BinOp::Eq | BinOp::Ne);\n}\n\n/// One helper per builtin whose Lua spelling is a function rather than an operator. `arg.ty` is\n/// needed for `sum` alone: `tl_sum` narrows through `tl_i32` when the element is an Int, so the\n/// helper that defines it has to be present alongside.\nfn builtin_helpers(which: Builtin, arg_ty: &Type, used: &mut Helpers) {\n    used.range |= which == Builtin::Range;\n    used.jsonlines |= which == Builtin::JsonLines;\n    used.tail |= which == Builtin::Tail;\n    used.flatten |= which == Builtin::Flatten;\n    used.chars |= which == Builtin::Chars;\n    used.sort |= which == Builtin::Sort;\n    used.reverse |= which == Builtin::Reverse;\n    used.sum |= which == Builtin::Sum;\n    used.max |= which == Builtin::Max;\n    used.arith |= which == Builtin::Sum && tir::runtime_elem(arg_ty) == Some(&Type::Int);\n}\n\nfn used_helpers(program: &Program) -> Helpers {\n    fn walk(t: &Tir, used: &mut Helpers) {\n        match &t.kind {\n            Kind::Str(_)\n            | Kind::Int(_)\n            | Kind::Float(_)\n            | Kind::Var(_)\n            | Kind::Local(_)\n            | Kind::Input\n            | Kind::Inputs => {}\n            // The source is what reads stdin now, so it is what needs the helper.\n            Kind::Lines => used.collect = true,\n            Kind::Dsv { .. } => {\n                used.collect = true;\n                used.split = true;\n            }\n            Kind::VecLit(items) => items.iter().for_each(|i| walk(i, used)),\n            Kind::RecordLit { fields } => {\n                fields.iter().for_each(|(_, v)| walk(v, used));\n            }\n            Kind::EnumLit { payload, .. } => {\n                if let Some(p) = payload {\n                    walk(p, used);\n                }\n            }\n            Kind::Call { arg, .. } => {\n                if let Some(a) = arg {\n                    walk(a, used);\n                }\n            }\n            // Lua's `..` is string-only, so a Vec reaches for the same helper `flatten` uses,\n            // wrapped around a two-entry outer table rather than through a second helper.\n            Kind::Concat(l, r) => {\n                used.flatten |= matches!(t.ty, Type::Vec(_));\n                walk(l, used);\n                walk(r, used);\n            }\n            Kind::Logic { lhs: l, rhs: r, .. } => {\n                walk(l, used);\n                walk(r, used);\n            }\n            Kind::Compare { op, lhs, rhs } => {\n                compare_helpers(*op, &lhs.ty, used);\n                walk(lhs, used);\n                walk(rhs, used);\n            }\n            Kind::Bind { value, body, .. } => {\n                walk(value, used);\n                walk(body, used);\n            }\n            Kind::Map { source, body, .. } => {\n                used.map = true;\n                walk(source, used);\n                walk(body, used);\n            }\n            Kind::OptMap { source, body, .. } => {\n                walk(source, used);\n                walk(body, used);\n            }\n            Kind::Select { source, pred, .. } => {\n                used.select = true;\n                walk(source, used);\n                walk(pred, used);\n            }\n            Kind::Field { base, .. } => {\n                // Depth zero is a plain index and needs no helper.\n                used.field |= tir::vec_depth(&base.ty) > 0;\n                walk(base, used);\n            }\n            Kind::Builtin { which, arg } => {\n                builtin_helpers(*which, &arg.ty, used);\n                walk(arg, used);\n            }\n            Kind::Arith { op, lhs, rhs } => {\n                if t.ty == Type::Int64 {\n                    used.arith64 |= matches!(op, BinOp::Div | BinOp::Rem);\n                } else {\n                    used.arith = true;\n                }\n                walk(lhs, used);\n                walk(rhs, used);\n            }\n            Kind::Not(base) => walk(base, used),\n            Kind::Unwrap { base } => {\n                used.unwrap = true;\n                walk(base, used);\n            }\n            Kind::Index { base, index, .. } => {\n                used.index = true;\n                walk(base, used);\n                walk(index, used);\n            }\n            Kind::Slice { base, start, end, .. } => {\n                used.slice = true;\n                walk(base, used);\n                if let Some(s) = start {\n                    walk(s, used);\n                }\n                if let Some(e) = end {\n                    walk(e, used);\n                }\n            }\n            Kind::Match { subject, arms, .. } => {\n                walk(subject, used);\n                for a in arms {\n                    if let Some(g) = &a.guard {\n                        walk(g, used);\n                    }\n                    walk(&a.body, used);\n                }\n            }\n        }\n    }\n    let mut used = Helpers::default();\n    program.funcs.iter().for_each(|f| walk(&f.body, &mut used));\n    walk(&program.body, &mut used);\n    used\n}\n\n/// A partial chain's yield is an Opt, so a present arm is tagged; total chains return the\n/// body bare. Split out of `expr`'s match arm (kantord/toylang#62).\nfn arm_return(body: String, partial: bool) -> String {\n    if partial {\n        format!(\"return {{some = {body}}} \")\n    } else {\n        format!(\"return {body} \")\n    }\n}\n\nfn expr(enums: &Enums, t: &Tir) -> String {\n    match &t.kind {\n        Kind::Str(s) => lua_string(s),\n        Kind::Int(n) => n.to_string(),\n        Kind::Float(_) => unreachable!(\"Float is JS-only in this row\"),\n        Kind::Var(name) => user(name),\n        Kind::Local(id) => local(*id),\n        Kind::Input => INPUT.to_string(),\n        Kind::Inputs => INPUTS.to_string(),\n        // The stream, materialized eagerly: whatever consumes it -- `collect`, a mapper --\n        // works on the table of its entries. Fusion is what will remove this materialization.\n        Kind::Lines => \"tl_collect_lines()\".to_string(),\n        Kind::Dsv { delim } => format!(\n            \"tl_split_lines(tl_collect_lines(), {})\",\n            lua_string(delim)\n        ),\n        // A record is a table keyed by field name, which is what field access reads.\n        Kind::RecordLit { fields } => {\n            let parts: Vec<String> = fields\n                .iter()\n                .map(|(name, value)| format!(\"[{}] = {}\", lua_string(name), expr(enums, value)))\n                .collect();\n            // Parenthesised because Lua will not index a table constructor: `{...}[\"a\"]` does\n            // not parse, and the printer reads every field straight off the value.\n            format!(\"({{{}}})\", parts.join(\", \"))\n        }\n\n        // The value is its JSON shape: a unit variant is the variant-name string, a payload\n        // variant the single-key table a record already is.\n        Kind::EnumLit { variant, payload } => match payload {\n            None => lua_string(variant),\n            Some(p) => format!(\"({{[{}] = {}}})\", lua_string(variant), expr(enums, p)),\n        },\n\n        Kind::VecLit(items) => {\n            let parts: Vec<String> = items.iter().map(|i| expr(enums, i)).collect();\n            format!(\"{{{}}}\", parts.join(\", \"))\n        }\n        Kind::Call { func, arg } => format!(\n            \"{}({})\",\n            user(func),\n            arg.as_deref().map_or_else(String::new, |a| expr(enums, a))\n        ),\n        Kind::Concat(l, r) => concat(enums, &t.ty, l, r),\n        Kind::Arith { op, lhs, rhs } => arith(&t.ty, *op, expr(enums, lhs), expr(enums, rhs)),\n        // Lua's `and`/`or` yield an operand rather than a boolean, which is the same thing here:\n        // both operands are already booleans, so whichever one comes back is one.\n        Kind::Logic { op, lhs, rhs } => format!(\"({} {op} {})\", expr(enums, lhs), expr(enums, rhs)),\n        Kind::Not(base) => format!(\"(not {})\", expr(enums, base)),\n        Kind::Builtin { which, arg } => match which {\n            Builtin::IntToStr => format!(\"tostring({})\", expr(enums, arg)),\n            // Lua's integers are 64-bit already; an Int just lives in the low half.\n            Builtin::IntToI64 => expr(enums, arg),\n            Builtin::Chars => format!(\"tl_chars({})\", expr(enums, arg)),\n            Builtin::Range => format!(\"tl_range({})\", expr(enums, arg)),\n            Builtin::JsonLines => {\n                let elem = tir::runtime_elem(&arg.ty).expect(\"checked to be a Vec or a stream\");\n                let e = \"e0\".to_string();\n                format!(\n                    \"tl_jsonlines({}, function({e}) return {} end)\",\n                    expr(enums, arg),\n                    show(enums, elem, &e, 1)\n                )\n            }\n            // The source already materialized, so the exit has nothing left to do.\n            Builtin::Collect => expr(enums, arg),\n            Builtin::Length => format!(\"#{}\", expr(enums, arg)),\n            Builtin::Tail => format!(\"tl_tail({})\", expr(enums, arg)),\n            Builtin::Flatten => format!(\"tl_flatten({})\", expr(enums, arg)),\n            Builtin::Sort => format!(\"tl_sort({})\", expr(enums, arg)),\n            Builtin::Reverse => format!(\"tl_reverse({})\", expr(enums, arg)),\n            Builtin::Sum => format!(\n                \"tl_sum({}, {})\",\n                expr(enums, arg),\n                tir::runtime_elem(&arg.ty) == Some(&Type::Int)\n            ),\n            Builtin::Max => format!(\"tl_max({})\", expr(enums, arg)),\n            // The names come from the checked type, not the table value, so `arg` runs as the\n            // function literal's ignored parameter -- the same IIFE shape `Bind` uses -- purely\n            // for whatever else it does.\n            Builtin::Fields => {\n                let Type::Record(fields) = &arg.ty else {\n                    unreachable!(\"checked to be a record\")\n                };\n                let names: Vec<String> = fields.iter().map(|(n, _)| lua_string(n)).collect();\n                format!(\n                    \"(function(_) return {{{}}} end)({})\",\n                    names.join(\", \"),\n                    expr(enums, arg)\n                )\n            }\n        },\n        Kind::Compare { op, lhs, rhs } => compare(enums, *op, lhs, rhs),\n        // Lua has no expression-level `let`, so the binding becomes a call.\n        Kind::Bind {\n            local: id,\n            value,\n            body,\n        } => {\n            format!(\n                \"(function({}) return {} end)({})\",\n                local(*id),\n                expr(enums, body),\n                expr(enums, value)\n            )\n        }\n        Kind::Map {\n            source,\n            param,\n            body,\n        } => format!(\n            \"tl_map({}, function({}) return {} end)\",\n            expr(enums, source),\n            local(*param),\n            expr(enums, body)\n        ),\n        Kind::Select {\n            source,\n            param,\n            pred,\n        } => format!(\n            \"tl_select({}, function({}) return {} end)\",\n            expr(enums, source),\n            local(*param),\n            expr(enums, pred)\n        ),\n        // The depth comes from the type on the node below, so it cannot disagree with it, and\n        // the emitted helper is told the answer rather than inspecting the value for it.\n        Kind::Unwrap { base } => {\n            format!(\n                \"tl_unwrap({}, {})\",\n                expr(enums, base),\n                tir::vec_depth(&base.ty)\n            )\n        }\n        // Opt's reorder pass (kantord/toylang#66): the same `== \"none\"`/`.some` shape the\n        // printer and Match already read, generalised to rebuild the table instead.\n        Kind::OptMap {\n            source,\n            param,\n            body,\n        } => format!(\n            \"(function(__opt) if __opt == \\\"none\\\" then return \\\"none\\\" else local {} = __opt.some return {{some = {}}} end end)({})\",\n            local(*param),\n            expr(enums, body),\n            expr(enums, source)\n        ),\n        // A Lua table of records is a table of tables, so collapsing needs no gather here;\n        // `elem_is_record` matters only where the columns are stored apart.\n        Kind::Index {\n            base, index, depth, ..\n        } => {\n            format!(\n                \"tl_at({}, {}, {})\",\n                expr(enums, base),\n                expr(enums, index),\n                depth\n            )\n        }\n        Kind::Slice {\n            base, start, end, depth,\n        } => {\n            let lo = match start {\n                Some(s) => expr(enums, s),\n                None => \"nil\".to_string(),\n            };\n            let hi = match end {\n                Some(e) => expr(enums, e),\n                None => \"nil\".to_string(),\n            };\n            format!(\n                \"tl_slice({}, {}, {}, {})\",\n                expr(enums, base),\n                lo,\n                hi,\n                depth\n            )\n        }\n        Kind::Field { base, name } => {\n            let depth = tir::vec_depth(&base.ty);\n            if depth == 0 {\n                format!(\"{}[{}]\", expr(enums, base), lua_string(name))\n            } else {\n                format!(\n                    \"tl_field({}, {}, {})\",\n                    expr(enums, base),\n                    lua_string(name),\n                    depth\n                )\n            }\n        }\n        // A chain of tests over the subject (a plain local, so re-reading it is free): string\n        // equality for a unit variant, key presence for a payload variant, the guard's own\n        // Bool for a guard arm. A total chain's last arm needs no test, the checker having\n        // proved nothing else can reach it; a partial chain tests every arm and falls through\n        // to `tl_none`, the absent Opt.\n        Kind::Match {\n            subject,\n            arms,\n            partial,\n        } => {\n            let subj = expr(enums, subject);\n            let mut body = String::new();\n            for (i, arm) in arms.iter().enumerate() {\n                let mut run = String::new();\n                if let Some(pid) = arm.payload {\n                    let variant = arm\n                        .variant\n                        .as_ref()\n                        .expect(\"only a variant arm has a payload\");\n                    run.push_str(&format!(\n                        \"local {} = {subj}[{}] \",\n                        local(pid),\n                        lua_string(variant)\n                    ));\n                }\n                run.push_str(&arm_return(expr(enums, &arm.body), *partial));\n                let test = match (&arm.variant, &arm.guard) {\n                    (Some(v), _) if arm.payload.is_some() => {\n                        Some(format!(\"{subj}[{}] ~= nil\", lua_string(v)))\n                    }\n                    (Some(v), _) => Some(format!(\"{subj} == {}\", lua_string(v))),\n                    (None, Some(g)) => Some(expr(enums, g)),\n                    (None, None) => None,\n                };\n                match test {\n                    Some(test) if *partial || i + 1 < arms.len() => {\n                        body.push_str(&format!(\"if {test} then {run}end \"));\n                    }\n                    _ => body.push_str(&run),\n                }\n            }\n            if *partial {\n                body.push_str(\"return \\\"none\\\" \");\n            }\n            format!(\"(function() {body}end)()\")\n        }\n    }\n}\n\n/// One arithmetic expression at the width the node's type names. At 64 bits Lua's own\n/// integers are the semantics (kantord/toylang#83): `+`, `-` and `*` wrap natively, so only\n/// division and remainder go through a helper.\nfn arith(ty: &Type, op: BinOp, l: String, r: String) -> String {\n    if *ty == Type::Int64 {\n        match op {\n            BinOp::Div => format!(\"tl_div64({l}, {r})\"),\n            BinOp::Rem => format!(\"tl_rem64({l}, {r})\"),\n            BinOp::Add => format!(\"({l} + {r})\"),\n            BinOp::Sub => format!(\"({l} - {r})\"),\n            BinOp::Mul => format!(\"({l} * {r})\"),\n            other => unreachable!(\"{other} is not arithmetic\"),\n        }\n    } else {\n        match op {\n            BinOp::Div => format!(\"tl_div({l}, {r})\"),\n            BinOp::Rem => format!(\"tl_rem({l}, {r})\"),\n            BinOp::Add => format!(\"tl_i32({l} + {r})\"),\n            BinOp::Sub => format!(\"tl_i32({l} - {r})\"),\n            BinOp::Mul => format!(\"tl_i32({l} * {r})\"),\n            other => unreachable!(\"{other} is not arithmetic\"),\n        }\n    }\n}\n\nfn lua_op(op: BinOp) -> &'static str {\n    match op {\n        BinOp::Eq => \"==\",\n        BinOp::Ne => \"~=\",\n        BinOp::Lt => \"<\",\n        BinOp::Le => \"<=\",\n        BinOp::Gt => \">\",\n        BinOp::Ge => \">=\",\n        other => unreachable!(\"{other} is not a comparison\"),\n    }\n}\n\nfn lua_string(s: &str) -> String {\n    let mut out = String::with_capacity(s.len() + 2);\n    out.push('\"');\n    for c in s.chars() {\n        match c {\n            '\"' => out.push_str(\"\\\\\\\"\"),\n            '\\\\' => out.push_str(\"\\\\\\\\\"),\n            '\\n' => out.push_str(\"\\\\n\"),\n            '\\r' => out.push_str(\"\\\\r\"),\n            '\\t' => out.push_str(\"\\\\t\"),\n            // Lua reads \\ddd as a byte, so anything above ASCII has to go through as its\n            // UTF-8 bytes rather than as a codepoint escape.\n            c if (c as u32) < 0x20 || c == '\\u{7f}' => {\n                out.push_str(&format!(\"\\\\{:03}\", c as u32));\n            }\n            c => out.push(c),\n        }\n    }\n    out.push('\"');\n    out\n}","lineStart":1,"lineEnd":1083,"totalLines":1083,"truncated":false}},"title":"src/emit_lua.rs","time":{"start":1788381726767,"end":1788381726773}},"id":"prt_063db882d001XLZ8pVMPstoNH6","sessionID":"ses_f9c24d349ffeKHnaVF2lrb6ncE","messageID":"msg_063db8180001ObqV1cTA5IOLbP"}}
