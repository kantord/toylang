Bool => format!(\"String({value})\"),\n392:         Type::Vec(elem) => {\n393:             let e = format!(\"e{depth}\");\n394:             format!(\n395:                 \"tl_join({value}, ({e}) => {})\",\n396:                 show(enums, elem, &e, depth + 1)\n397:             )\n398:         }\n399:         Type::Enum { .. } if ty.as_opt().is_some() => {\n400:             let inner = ty.as_opt().expect(\"guarded\");\n401:             let v = format!(\"o{depth}\");\n402:             format!(\n403:                 \"(({v}) => {v} === \\\"none\\\" ? \\\"null\\\" : {})({value})\",\n404:                 show(enums, inner, &format!(\"{v}.some\"), depth + 1)\n405:             )\n406:         }\n407:         // A recursive enum prints through a function of its own (`printers`), because expanding\n408:         // one here has no bottom: its payload leads back to the same type.\n409:         Type::Enum { .. } if ty::is_recursive(enums, ty) => format!(\"{}({value})\", ty.show_fn()),\n410:         Type::Enum { .. } => show_enum(enums, ty, value, depth),\n411:         Type::Record(fields) => {\n412:             // The type's field list is declaration order, so this prints as declared. Field\n413:             // names are identifiers, so the JSON key needs no escaping and is one literal.\n414:             let parts: Vec<String> = fields\n415:                 .iter()\n416:                 .map(|(name, fty)| {\n417:                     let read = format!(\"{value}[{}]\", js_string(name));\n418:                     let key = js_string(&format!(\"\\\"{name}\\\":\"));\n419:                     format!(\"{key} + {}\", show(enums, fty, &read, depth + 1))\n\n(Showing lines 370-419 of 1122. Use offset=420 to continue.)\n</content>","metadata":{"preview":"    out.push_str(\"}\\n\");\n    out\n}\n\n/// The printer is built from the type rather than by inspecting the value, so a record's keys\n/// are known and ordered at compile time, in declaration order. That removes the whole class\n//