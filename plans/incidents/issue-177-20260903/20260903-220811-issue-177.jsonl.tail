{"type":"tool_use","timestamp":1788466604135,"sessionID":"ses_f971d285effeq84jbpOgeGh3gS","part":{"type":"tool","tool":"read","callID":"call_8cc906921f16441baf4f0788","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-177/src/emit_lua.rs","limit":90,"offset":560},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-177/src/emit_lua.rs</path>\n<type>file</type>\n<content>\n560:     }\n561:     out\n562: }\n563: \n564: fn needs_quote(ty: &Type) -> bool {\n565:     match ty {\n566:         Type::Str => true,\n567:         Type::Vec(elem) => needs_quote(elem),\n568:         Type::Record(_) => true,\n569:         // A unit variant prints as a quoted string, and a payload wrapper is a record.\n570:         Type::Enum { .. } => true,\n571:         _ => false,\n572:     }\n573: }\n574: \n575: fn contains_vec(enums: &Enums, ty: &Type) -> bool {\n576:     match ty {\n577:         Type::Vec(_) => true,\n578:         Type::Record(fields) => fields.iter().any(|(_, t)| contains_vec(enums, t)),\n579:         // The Vec arm answers before this one can loop: a self-reference is legal only behind\n580:         // a Vec, so a recursive enum's first payload hop is one.\n581:         Type::Enum { .. } => ty::variants(enums, ty)\n582:             .iter()\n583:             .any(|(_, p)| p.as_ref().is_some_and(|p| contains_vec(enums, p))),\n584:         _ => false,\n585:     }\n586: }\n587: \n588: /// Which identifiers are reserved is the target's business, not toylang's. A program with a\n589: /// function called `print` or `end` would otherwise emit Lua that shadows the output function or\n590: /// does not parse.\n591: fn user(name: &str) -> String {\n592:     format!(\"v_{name}\")\n593: }\n594: \n595: fn local(id: LocalId) -> String {\n596:     format!(\"t_{id}\")\n597: }\n598: \n599: #[derive(Default)]\n600: struct Helpers {\n601:     select: bool,\n602:     field: bool,\n603:     index: bool,\n604:     slice: bool,\n605:     unwrap: bool,\n606:     arith: bool,\n607:     arith64: bool,\n608:     map: bool,\n609:     range: bool,\n610:     collect: bool,\n611:     jsonlines: bool,\n612:     tail: bool,\n613:     flatten: bool,\n614:     chars: bool,\n615:     sort: bool,\n616:     reverse: bool,\n617:     sum: bool,\n618:     max: bool,\n619:     eq: bool,\n620:     split: bool,\n621: }\n622: \n623: /// Equality on a composite is structural, which Lua's `==` on two tables is not -- it compares\n624: /// references (kantord/toylang#68). Ordering on a composite is a separate open question and\n625: /// keeps whatever Lua does with it.\n626: fn compare(enums: &Enums, op: BinOp, lhs: &Tir, rhs: &Tir) -> String {\n627:     if !lhs.ty.is_composite() || !matches!(op, BinOp::Eq | BinOp::Ne) {\n628:         return format!(\"({} {} {})\", expr(enums, lhs), lua_op(op), expr(enums, rhs));\n629:     }\n630:     let call = format!(\"tl_eq({}, {})\", expr(enums, lhs), expr(enums, rhs));\n631:     match op {\n632:         BinOp::Ne => format!(\"(not {call})\"),\n633:         _ => call,\n634:     }\n635: }\n636: \n637: /// Parenthesised because there is more than one operator, and Lua's precedence is not toylang's\n638: /// to rely on. `..` is string-only, so a Vec reaches for the same helper `flatten` uses,\n639: /// wrapped around a two-entry outer table rather than through a second helper.\n640: fn concat(enums: &Enums, ty: &Type, l: &Tir, r: &Tir) -> String {\n641:     match ty {\n642:         Type::Vec(_) => format!(\"tl_flatten({{{}, {}}})\", expr(enums, l), expr(enums, r)),\n643:         _ => format!(\"({} .. {})\", expr(enums, l), expr(enums, r)),\n644:     }\n645: }\n646: \n647: /// Which helper a comparison reaches for, which is a question about the operator and the\n648: /// operand type rather than about the tree below it: Lua's `==` on two tables compares\n649: /// references, so equality on a composite walks the structure instead (kantord/toylang#68).\n\n(Showing lines 560-649 of 1096. Use offset=650 to continue.)\n</content>","metadata":{"preview":"    }\n    out\n}\n\nfn needs_quote(ty: &Type) -> bool {\n    match ty {\n        Type::Str => true,\n        Type::Vec(elem) => needs_quote(elem),\n        Type::Record(_) => true,\n        // A unit variant prints as a quoted string, and a payload wrapper is a record.\n        Type::Enum { .. } => true,\n        _ => false,\n    }\n}\n\nfn contains_vec(enums: &Enums, ty: &Type) -> bool {\n    match ty {\n        Type::Vec(_) => true,\n        Type::Record(fields) => fields.iter().any(|(_, t)| contains_vec(enums, t)),\n        // The Vec arm answers before this one can loop: a self-reference is legal only behind","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-177/src/emit_lua.rs","text":"    }\n    out\n}\n\nfn needs_quote(ty: &Type) -> bool {\n    match ty {\n        Type::Str => true,\n        Type::Vec(elem) => needs_quote(elem),\n        Type::Record(_) => true,\n        // A unit variant prints as a quoted string, and a payload wrapper is a record.\n        Type::Enum { .. } => true,\n        _ => false,\n    }\n}\n\nfn contains_vec(enums: &Enums, ty: &Type) -> bool {\n    match ty {\n        Type::Vec(_) => true,\n        Type::Record(fields) => fields.iter().any(|(_, t)| contains_vec(enums, t)),\n        // The Vec arm answers before this one can loop: a self-reference is legal only behind\n        // a Vec, so a recursive enum's first payload hop is one.\n        Type::Enum { .. } => ty::variants(enums, ty)\n            .iter()\n            .any(|(_, p)| p.as_ref().is_some_and(|p| contains_vec(enums, p))),\n        _ => false,\n    }\n}\n\n/// Which identifiers are reserved is the target's business, not toylang's. A program with a\n/// function called `print` or `end` would otherwise emit Lua that shadows the output function or\n/// does not parse.\nfn user(name: &str) -> String {\n    format!(\"v_{name}\")\n}\n\nfn local(id: LocalId) -> String {\n    format!(\"t_{id}\")\n}\n\n#[derive(Default)]\nstruct Helpers {\n    select: bool,\n    field: bool,\n    index: bool,\n    slice: bool,\n    unwrap: bool,\n    arith: bool,\n    arith64: bool,\n    map: bool,\n    range: bool,\n    collect: bool,\n    jsonlines: bool,\n    tail: bool,\n    flatten: bool,\n    chars: bool,\n    sort: bool,\n    reverse: bool,\n    sum: bool,\n    max: bool,\n    eq: bool,\n    split: bool,\n}\n\n/// Equality on a composite is structural, which Lua's `==` on two tables is not -- it compares\n/// references (kantord/toylang#68). Ordering on a composite is a separate open question and\n/// keeps whatever Lua does with it.\nfn compare(enums: &Enums, op: BinOp, lhs: &Tir, rhs: &Tir) -> String {\n    if !lhs.ty.is_composite() || !matches!(op, BinOp::Eq | BinOp::Ne) {\n        return format!(\"({} {} {})\", expr(enums, lhs), lua_op(op), expr(enums, rhs));\n    }\n    let call = format!(\"tl_eq({}, {})\", expr(enums, lhs), expr(enums, rhs));\n    match op {\n        BinOp::Ne => format!(\"(not {call})\"),\n        _ => call,\n    }\n}\n\n/// Parenthesised because there is more than one operator, and Lua's precedence is not toylang's\n/// to rely on. `..` is string-only, so a Vec reaches for the same helper `flatten` uses,\n/// wrapped around a two-entry outer table rather than through a second helper.\nfn concat(enums: &Enums, ty: &Type, l: &Tir, r: &Tir) -> String {\n    match ty {\n        Type::Vec(_) => format!(\"tl_flatten({{{}, {}}})\", expr(enums, l), expr(enums, r)),\n        _ => format!(\"({} .. {})\", expr(enums, l), expr(enums, r)),\n    }\n}\n\n/// Which helper a comparison reaches for, which is a question about the operator and the\n/// operand type rather than about the tree below it: Lua's `==` on two tables compares\n/// references, so equality on a composite walks the structure instead (kantord/toylang#68).","lineStart":560,"lineEnd":649,"totalLines":1096,"truncated":true}},"title":"src/emit_lua.rs","time":{"s