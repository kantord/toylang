e ARITH64_HELPER uses.\nconst SUM_HELPER: &str = \"\\\nfunction tl_sum(v) {\n  let acc = 0;\n  for (let i = 0; i < v.length; i++) acc = (acc + v[i]) | 0;\n  return acc;\n}\nfunction tl_sum64(v) {\n  let acc = 0n;\n  for (let i = 0; i < v.length; i++) acc = BigInt.asIntN(64, acc + v[i]);\n  return acc;\n}","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-177/src/emit_js.rs","text":"const CHARS_HELPER: &str = \"\\\nfunction tl_chars(s) {\n  return Array.from(s, (c) => c.codePointAt(0));\n}\n\";\n\n// Int and Int64 are different runtime types here -- Number and BigInt -- so `+` cannot mix\n// them and each width needs its own fold. `|0` is the 32-bit wrap (the same ToInt32 ARITH_HELPER\n// relies on); `BigInt.asIntN(64, ...)` is the 64-bit one ARITH64_HELPER uses.\nconst SUM_HELPER: &str = \"\\\nfunction tl_sum(v) {\n  let acc = 0;\n  for (let i = 0; i < v.length; i++) acc = (acc + v[i]) | 0;\n  return acc;\n}\nfunction tl_sum64(v) {\n  let acc = 0n;\n  for (let i = 0; i < v.length; i++) acc = BigInt.asIntN(64, acc + v[i]);\n  return acc;\n}\n\";\n\n// `>` orders Number and BigInt alike, so one maximum serves both widths.\nconst MAX_HELPER: &str = \"\\\nfunction tl_max(v) {\n  if (v.length === 0) return \\\"none\\\";\n  let m = v[0];\n  for (let i = 1; i < v.length; i++) if (v[i] > m) m = v[i];\n  return { some: m };\n}","lineStart":175,"lineEnd":204,"totalLines":1139,"truncated":true}},"title":"src/emit_js.rs","time":{"start":1788466575844,"end":1788466575849}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"JS Char — how is a Char value represented at runtime? It comes from `tl_chars(s)` — returns an array of codepoints (numbers. Let me check tl_chars.","format":"unknown","index":0}]}},"id":"prt_068ea39e2001gG5NWd45gQ161C","sessionID":"ses_f971d285effeq84jbpOgeGh3gS","messageID":"msg_068ea3188001B7ACMmGXxLQJ3b"}}
