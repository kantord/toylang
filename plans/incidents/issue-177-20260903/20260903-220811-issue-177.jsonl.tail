e/kantord/.local/share/toylang-lanes/issue-177/src/emit_js.rs\n===================================================================\n--- /home/kantord/.local/share/toylang-lanes/issue-177/src/emit_js.rs\n+++ /home/kantord/.local/share/toylang-lanes/issue-177/src/emit_js.rs\n@@ -983,8 +983,42 @@\n         local(*param),\n         expr(enums, pred)\n     )\n }\n+Kind::SortBy {\n+    source,\n+    param,\n+    body,\n+} => {\n+    let cmp = if body.ty == Type::Str {\n+        \"tl_str_cmp\".to_string()\n+    } else {\n+        \"(a,b) => a < b ? -1 : a > b ? 1 : 0\".to_string()\n+    };\n+    format!(\n+        \"tl_sort_by({}, ({}) => {}, {cmp})\",\n+        expr(enums, source),\n+        local(*param),\n+        expr(enums, body)\n+    )\n+}\n+Kind::MaxBy {\n+    source,\n+    param,\n+    body,\n+} => {\n+    let cmp = if body.ty == Type::Str {\n+        \"tl_str_cmp\".to_string()\n+    } else {\n+        \"(a,b) => a < b ? -1 : a > b ? 1 : 0\".to_string()\n+    };\n+    format!(\n+        \"tl_max_by({}, ({}) => {}, {cmp})\",\n+        expr(enums, source),\n+        local(*param),\n+        expr(enums, body)\n+    )\n+}\n // Opt's reorder pass (kantord/toylang#66): the tagged shape (`\"none\"` or `{some: v}`)\n // is generic enough that this is the ordinary key-presence test every Match arm over\n // an Opt subject would already use, just rebuilding the payload instead of a body.\n Kind::OptMap {\n","filediff":{"file":"/home/kantord/.local/share/toylang-lanes/issue-177/src/emit_js.rs","patch":"Index: /home/kantord/.local/share/toylang-lanes/issue-177/src/emit_js.rs\n===================================================================\n--- /home/kantord/.local/share/toylang-lanes/issue-177/src/emit_js.rs\n+++ /home/kantord/.local/share/toylang-lanes/issue-177/src/emit_js.rs\n@@ -983,8 +983,42 @@\n         local(*param),\n         expr(enums, pred)\n     )\n }\n+Kind::SortBy {\n+    source,\n+    param,\n+    body,\n+} => {\n+    let cmp = if body.ty == Type::Str {\n+        \"tl_str_cmp\".to_string()\n+    } else {\n+        \"(a,b) => a < b ? -1 : a > b ? 1 : 0\".to_string()\n+    };\n+    format!(\n+        \"tl_sort_by({}, ({}) => {}, {cmp})\",\n+        expr(enums, source),\n+        local(*param),\n+        expr(enums, body)\n+    )\n+}\n+Kind::MaxBy {\n+    source,\n+    param,\n+    body,\n+} => {\n+    let cmp = if body.ty == Type::Str {\n+        \"tl_str_cmp\".to_string()\n+    } else {\n+        \"(a,b) => a < b ? -1 : a > b ? 1 : 0\".to_string()\n+    };\n+    format!(\n+        \"tl_max_by({}, ({}) => {}, {cmp})\",\n+        expr(enums, source),\n+        local(*param),\n+        expr(enums, body)\n+    )\n+}\n // Opt's reorder pass (kantord/toylang#66): the tagged shape (`\"none\"` or `{some: v}`)\n // is generic enough that this is the ordinary key-presence test every Match arm over\n // an Opt subject would already use, just rebuilding the payload instead of a body.\n Kind::OptMap {\n","additions":34,"deletions":0},"truncated":false},"title":"src/emit_js.rs","time":{"start":1788466601620,"end":1788466601623}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now JS expr arms. Add after the Select expr arm (at 933-944).","format":"unknown","index":0}]}},"id":"prt_068ea9e87001N60hHEvrGhUMrG","sessionID":"ses_f971d285effeq84jbpOgeGh3gS","messageID":"msg_068ea94b2001V5VtYVJt1G3KJl"}}
