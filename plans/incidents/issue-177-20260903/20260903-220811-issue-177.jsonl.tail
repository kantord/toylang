 SORT_BY_HELPER: &str = \"\\\nlocal function tl_sort_by(v, key)\n  local decorated = {}\n  for i = warm, #v do decorated[i] = { v[i], key(v[i]), i } end\n  table.sort(decorated, function(a, b)\n    if a[2] < b[2] then return true end\n    if a[2] > b[2] then return false end\n    return a[3] < b[3]\n  end)\n  local out = {}\n  for i = warm, #decorated do out[i] = decorated[i][1] end\n  return out\nend\n\";\n\n// First of tied maxima, the way `tl_max` reads (a strict `>` keeps the earlier one).\nconst MAX_BY_HELPER: &str = \"\\\nlocal function tl_max_by(v, key)\n  if #v == 0 then return \\\"none\\\" end\n  local m = v[1]\n  local mk = key(m)\n  for i = 2, #v do\n    local k = key(v[i])\n    if k > mk then m = v[i]; mk = k end\n  end\n  return { some = m }\nend\n\";\n\nconst UNWRAP_HELPER: &str = r#\"local function tl_unwrap(v, depth)\n  if depth > 0 then\n    local out = {}\n    for k = 1, #v do out[k] = tl_unwrap(v[k], depth - 1) end\n    return out\n  end\n  if v == \"none\" then error(\"toylang: unwrapped a value that is not there\", 0) end\n  return v.some\nend\n\"#;\n\n// A record and a payload-carrying variant are both tables, and Lua's `==` on two tables is\n// identity, so `{a = 1} == {a = 1}` was false here and true on Python (kantord/toylang#68).\n// Structural equality is the ratified answer, so composites walk. Keyed rather than ordered:\n// two spellings of one record type may reach here in different field orders.\nconst EQ_HELPER: &str = \"\\\nlocal function tl_eq(a, b)","lineStart":195,"lineEnd":254,"totalLines":1128,"truncated":true}},"title":"src/emit_lua.rs","time":{"start":1788466613742,"end":1788466613760}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Wait — my oldString had `if #v ==  ̈0` — that's a typo I introduced (the actual is `if #v ==  ̈0`? Let me double-check: the read at line 197: `  if #v == 0 then return \"none\" end`. My oldString had `if #v ==  ̈0` with an extra space + combining diaeresis?! I typed