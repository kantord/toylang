*param),\n     expr(enums, pred)\n ),\n+// jq's own `sort_by`/`max_by` already are the projection-shaped pair this row lands:the\n+// filter binds `.` to each entry as the same fresh `$t_N` the checker's body reads.\n+Kind::SortBy {\n+    source,\n+    param,\n+    body,\n+} => format!(\n+    \"({} | sort_by(. as {} | {}))\",\n+    expr(enums, source),\n+    local(*param),\n+    expr(enums, body)\n+),\n+Kind::MaxBy {\n+    source,\n+    param,\n+    body,\n+} => format!(\n+    \"({} | if length == 0 then \\\"none\\\" else {{some: max_by(. as {} | {})}} end)\",\n+    expr(enums, source),\n+    local(*param),\n+    expr(enums, body)\n+),\n Kind::Field { base, name } => {\n     let depth = tir::vec_depth(&base.ty);\n     format!(\n         \"({} | {})\",\n","filediff":{"file":"/home/kantord/.local/share/toylang-lanes/issue-177/src/emit_jq.rs","patch":"Index: /home/kantord/.local/share/toylang-lanes/issue-177/src/emit_jq.rs\n===================================================================\n--- /home/kantord/.local/share/toylang-lanes/issue-177/src/emit_jq.rs\n+++ /home/kantord/.local/share/toylang-lanes/issue-177/src/emit_jq.rs\n@@ -640,8 +640,30 @@\n     expr(enums, source),\n     local(*param),\n     expr(enums, pred)\n ),\n+// jq's own `sort_by`/`max_by` already are the projection-shaped pair this row lands:the\n+// filter binds `.` to each entry as the same fresh `$t_N` the checker's body reads.\n+Kind::SortBy {\n+    source,\n+    param,\n+    body,\n+} => format!(\n+    \"({} | sort_by(. as {} | {}))\",\n+    expr(enums, source),\n+    local(*param),\n+    expr(enums, body)\n+),\n+Kind::MaxBy {\n+    source,\n+    param,\n+    body,\n+} => format!(\n+    \"({} | if length == 0 then \\\"none\\\" else {{some: max_by(. as {} | {})}} end)\",\n+    expr(enums, source),\n+    local(*param),\n+    expr(enums, body)\n+),\n Kind::Field { base, name } => {\n     let depth = tir::vec_depth(&base.ty);\n     format!(\n         \"({} | {})\",\n","additions":22,"deletions":0}