9:         Kind::Map {\n1130:             source: Box::new(source),\n1131:             param,\n1132:             body: Box::new(body),\n1133:         },\n1134:     ))\n1135: }\n1136: \n1137: /// `|` binds `.` in the right side to the value of the left. It is composition, not a map:\n1138: /// the operators that distribute over a Vec do so themselves. The pipe's value is the right\n1139: /// side's, so an expectation flows into the right side whole -- which is how one reaches the\n1140: /// subject-fed forms (`map`, `select`, a match chain), since they only exist after `|`.\n1141: fn pipe(ctx: &Ctx, lhs: &Expr, rhs: &Expr, want: Option<&Type>) -> Result<Expected, Error> {\n1142:     let value = synth(ctx, lhs)?;\n1143:     let local = ctx.fresh();\n1144:     let inner = ctx.with(Some((value.ty.clone(), local)));\n1145:     let body = match want {\n1146:         Some(want) => expect_inner(&inner, rhs, want)?,\n1147:         None => Expected::Synthesised(synth(&inner, rhs)?),\n1148:     };\n1149:     let (checked, body) = match body {\n1150:         Expected::Checked(tir) => (true, tir),\n1151:         Expected::Synthesised(tir) => (false, tir),\n1152:     };\n1153:     // A stream on the right of `|` must have flowed in from the left: a source read beside an\n1154:     // unrelated piped value is not one chain, and one chain from source to sink is the shape\n1155:     // the whole effect layer keeps.\n1156:     if matches!(body.ty, Type::Stream(_)) && !matches!(value.ty, Type::Stream(_)) {\n1157:         return Err(Error::new(\n1158:             rhs.span(),\n1159:             \"this stream does not flow in from the left of `|`; write the pipeline as \\\n1160:              one chain from its source\"\n1161:                 .to_string(),\n1162:         ));\n1163:     }\n1164:     // The same linearity a stream-typed parameter gets: `|` is the one construct that can\n1165:     // silently drop its left side, so a stream piped in must be consumed here.\n1166:     if matches!(value.ty, Type::Stream(_)) {\n1167:         check_linear(\n1168:             &body,\n1169:             &StreamBinding::Local(local),\n1170:             \"the stream piped in here\",\n1171:             rhs.span(),\n1172:         )?;\n1173:     }\n1174:     let tir = Tir::new(\n1175:         body.ty.clone(),\n1176:         Kind::Bind {\n1177:             local,\n1178:             value: Box::new(value),\n1179:             body: Box::new(body),\n1180:         },\n1181:     );\n1182:     Ok(if checked {\n1183:         Expected::Checked(tir)\n1184:     } else {\n1185:         Expected::Synthesised(tir)\n1186:     })\n1187: }\n1188: \n1189: /// `let <name> = <expr>` bindings stacked one per line, then the value expression that ends\n1190: /// the block (kantord/toylang#150): no `in` keyword to pair, just the sequence and the result.\n1191: /// The one place a `let` block appears is a function body, so this is reached only through\n1192: /// `check_defs`'s `expect_inner`, and the body's type is whatever the block's value expression is.\n1193: ///\n1194: /// Later bindings see earlier ones: each value is checked in the scope built so far, and the name\n1195: /// is bound after, so `let a = a` reads the older `a`, the way any shadowing works. Every\n1196: /// binding gets a fresh `LocalId` and lowers to the same `Kind::Bind` a pipe does, so all seven\n1197: /// backends already know how to run one.\n1198: fn let_bind(\n1199:     ctx: &Ctx,\n1200:     bindings: &[(String, Expr)],\n1201:     body: &Expr,\n1202:     want: Option<&Type>,\n1203: ) -> Result<Expected, Error> {\n1204:     let locals: Vec<LocalId> = bindings.iter().map(|_| ctx.fresh()).collect();\n1205:     let mut values: Vec<Tir> = Vec::new();\n1206:     let mut scope = ctx.scope.clone();\n1207:     for ((name, value), local) in bindings.iter().zip(&locals) {\n1208:         let inner = ctx.rebuild(scope.clone(), ctx.subject.clone());\n1209:         let value = synth(&inner, value)?;\n1210:         scope.push((name.clone(), value.ty.clone(), Some(*local)));\n1211:         values.push(value);\n1212:     }\n1213:     let body_ctx = ctx.rebuild(scope, ctx.subject.clone());\n1214:     let body = match want {\n1215:         Some(want) => expect_inner(&body_ctx, body, want)?,\n1216:         None => Expected::Synthesised(synth(&body_ctx, body)?),\n1217:     };\n1218:     let (checked, mut tir) = match body {\n1219:         Expected::Checked(tir) => (true, tir),\n1220:         Expected::Synthesised(tir) => (false, tir),\n1221:     };\n1222:     for (local, value) in locals.into_iter().zip(values).into_iter().rev() {\n1223:         let body_ty = tir.ty.clone();\n1224:         tir = Tir::new(body_ty, Kind::Bind {\n1225:             local,\n1226:             value: Box::new(value),\n1227:             body: Box::new(tir),\n1228:         });\n1229:     }\n1230:     Ok(if checked {\n1231:         Expected::Checked(tir)\n1232:     } else {\n1233:         Expected::Synthesised(tir)\n1234:     })\n1235: }\n1236: \n1237: /// The hybrid totality the match-arms decision fixed. A chain with variant patterns is\n1238: /// closed-world: the subject is a declared enum, and the arms are proved to cover every\n1239: /// variant (or end in a default); guards do not count toward that coverage. A pure guard\n1240: /// chain is open-world and may be honestly partial, yielding `Opt` -- except when the arm\n1241: /// bodies are themselves `Opt`-typed, refused below. `.` narrows per arm: to the payload in\n1242: /// a payload arm, to nothing in a unit arm, and it stays the subject in a guard or default\n1243: /// arm.\n1244: ///\n1245: /// `body_want` is what every arm's body must be -- for a partial chain, the expectation with\n1246: /// its Opt layer already peeled by the caller. With `None` the first arm's body decides, as\n1247: /// it always has.\n1248: /// The dead-arm rule, both ways a chain can already be finished: a default above matches\n1249: /// everything, and arms covering every variant leave nothing for a later arm to see. (The\n1250: /// second is also what lets every backend take a total chain's last arm without a test.)\n1251: fn check_reachable(\n1252:     ctx: &Ctx,\n1253:     subject_ty: &Type,\n1254:     covered: &[String],\n1255:     default_seen: bool,\n1256:     arm_span: Span,\n1257: ) -> Result<(), Error> {\n1258:     if default_seen {\n1259:         return Err(Error::new(\n1260:             arm_span,\n1261:             \"this arm can never match; the `any()` arm above it already matches everything\"\n1262:                 .to_string(),\n1263:         ));\n1264:     }\n1265:     if let Type::Enum { name, args, .. } = subject_ty\n1266:         && !covered.is_empty()\n1267:         && enum_variants(ctx, name, args)\n1268:             .iter()\n1269:             .all(|(n, _)| covered.contains(n))\n1270:     {\n1271:         return Err(Error::new(\n1272:             arm_span,\n1273:             format!(\n\n(Showing lines 1094-1273 of 3239. Use offset=1274 to continue.)\n</content>","metadata":{"preview":"fn map_call(ctx: &Ctx, arg: &Expr, span: Span, want_elem: Option<&Type>) -> Result<Tir, Error> {\n    let Some((subject, id)) = ctx.subject.clone() else {\n        return Err(Error::new(\n            span,\n            \"`map` needs a subject, so it must follow `|`\",\n        ));\n    };\n    let Some(elem) = mapper_elem(&subject) else {\n        return Err(Error::new(\n            span,\n            format!(\"`map` needs a Vec or a stream, found {subject}\"),\n        ));\n    };\n    let param = ctx.fresh();\n    let inner = mapper_ctx(ctx, elem, param);\n    let body = match want_elem {\n        Some(want) => expect(&inner, arg, want)?,\n        None => synth(&inner, arg)?,\n    };\n    // The elements of the result are stored, and a stream is not storable: this is the same","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-177/src/check/mod.rs","text":"fn map_call(ctx: &Ctx, arg: &Expr, span: Span, want_elem: Option<&Type>) -> Result<Tir, Error> {\n    let Some((subject, id)) = ctx.subject.clone() else {\n        return Err(Error::new(\n            span,\n            \"`map` needs a subject, so it must follow `|`\",\n        ));\n    };\n    let Some(elem) = mapper_elem(&subject) else {\n        return Err(Error::new(\n            span,\n            format!(\"`map` needs a Vec or a stream, found {subject}\"),\n        ));\n    };\n    let param = ctx.fresh();\n    let inner = mapper_ctx(ctx, elem, param);\n    let body = match want_elem {\n        Some(want) => expect(&inner, arg, want)?,\n        None => synth(&inner, arg)?,\n    };\n    // The elements of the result are stored, and a stream is not storable: this is the same\n    // containment ban a Vec literal enforces, met here before the Vec or Stream of them could\n    // exist.\n    if body.ty.contains_stream() {\n        return Err(Error::new(\n            arg.span(),\n            \"a `map` body cannot be a stream, which has nothing to store\".to_string(),\n        ));\n    }\n    let out = match &subject {\n        Type::Stream(_) => Type::Stream(Box::new(body.ty.clone())),\n        _ => Type::Vec(Box::new(body.ty.clone())),\n    };\n    let source = Tir::new(subject, Kind::Local(id));\n    Ok(Tir::new(\n        out,\n        Kind::Map {\n            source: Box::new(source),\n            param,\n            body: Box::new(body),\n        },\n    ))\n}\n\n/// `|` binds `.` in the right side to the value of the left. It is composition, not a map:\n/// the operators that distribute over a Vec do so themselves. The pipe's value is the right\n/// side's, so an expectation flows into the right side whole -- which is how one reaches the\n/// subject-fed forms (`map`, `select`, a match chain), since they only exist after `|`.\nfn pipe(ctx: &Ctx, lhs: &Expr, rhs: &Expr, want: Option<&Type>) -> Result<Expected, Error> {\n    let value = synth(ctx, lhs)?;\n    let local = ctx.fresh();\n    let inner = ctx.with(Some((value.ty.clone(), local)));\n    let body = match want {\n        Some(want) => expect_inner(&inner, rhs, want)?,\n        None => Expected::Synthesised(synth(&inner, rhs)?),\n    };\n    let (checked, body) = match body {\n        Expected::Checked(tir) => (true, tir),\n        Expected::Synthesised(tir) => (false, tir),\n    };\n    // A stream on the right of `|` must have flowed in from the left: a source read beside an\n    // unrelated piped value is not one chain, and one chain from source to sink is the shape\n    // the whole effect layer keeps.\n    if matches!(body.ty, Type::Stream(_)) && !matches!(value.ty, Type::Stream(_)) {\n        return Err(Error::new(\n            rhs.span(),\n            \"this stream does not flow in from the left of `|`; write the pipeline as \\\n             one chain from its source\"\n                .to_string(),\n        ));\n    }\n    // The same linearity a stream-typed parameter gets: `|` is the one construct that can\n    // silently drop its left side, so a stream piped in must be consumed here.\n    if matches!(value.ty, Type::Stream(_)) {\n        check_linear(\n            &body,\n            &StreamBinding::Local(local),\n            \"the stream piped in here\",\n            rhs.span(),\n        )?;\n    }\n    let tir = Tir::new(\n        body.ty.clone(),\n        Kind::Bind {\n            local,\n            value: Box::new(value),\n            body: Box::new(body),\n        },\n    );\n    Ok(if checked {\n        Expected::Checked(tir)\n    } else {\n        Expected::Synthesised(tir)\n    })\n}\n\n/// `let <name> = <expr>` bindings stacked one per line, then the value expression that ends\n/// the block (kantord/toylang#150): no `in` keyword to pair, just the sequence and the result.\n/// The one place a `let` block appears is a function body, so this is reached only through\n/// `check_defs`'s `expect_inner`, and the body's type is whatever the block's value expression is.\n///\n/// Later bindings see earlier ones: each value is checked in the scope built so far, and the name\n/// is bound after, so `let a = a` reads the older `a`, the way any shadowing works. Every\n/// binding gets a fresh `LocalId` and lowers to the same `Kind::Bind` a pipe does, so all seven\n/// backends already know how to run one.\nfn let_bind(\n    ctx: &Ctx,\n    bindings: &[(String, Expr)],\n    body: &Expr,\n    want: Option<&Type>,\n) -> Result<Expected, Error> {\n    let locals: Vec<LocalId> = bindings.iter().map(|_| ctx.fresh()).collect();\n    let mut values: Vec<Tir> = Vec::new();\n    let mut scope = ctx.scope.clone();\n    for ((name, value), local) in bindings.iter().zip(&locals) {\n        let inner = ctx.rebuild(scope.clone(), ctx.subject.clone());\n        let value = synth(&inner, value)?;\n        scope.push((name.clone(), value.ty.clone(), Some(*local)));\n        values.push(value);\n    }\n    let body_ctx = ctx.rebuild(scope, ctx.subject.clone());\n    let body = match want {\n        Some(want) => expect_inner(&body_ctx, body, want)?,\n        None => Expected::Synthesised(synth(&body_ctx, body)?),\n    };\n    let (checked, mut tir) = match body {\n        Expected::Checked(tir) => (true, tir),\n        Expected::Synthesised(tir) => (false, tir),\n    };\n    for (local, value) in locals.into_iter().zip(values).into_iter().rev() {\n        let body_ty = tir.ty.clone();\n        tir = Tir::new(body_ty, Kind::Bind {\n            local,\n            value: Box::new(value),\n            body: Box::new(tir),\n        });\n    }\n    Ok(if checked {\n        Expected::Checked(tir)\n    } else {\n        Expected::Synthesised(tir)\n    })\n}\n\n/// The hybrid totality the match-arms decision fixed. A chain with variant patterns is\n/// closed-world: the subject is a declared enum, and the arms are proved to cover every\n/// variant (or end in a default); guards do not count toward that coverage. A pure guard\n/// chain is open-world and may be honestly partial, yielding `Opt` -- except when the arm\n/// bodies are themselves `Opt`-typed, refused below. `.` narrows per arm: to the payload in\n/// a payload arm, to nothing in a unit arm, and it stays the subject in a guard or default\n/// arm.\n///\n/// `body_want` is what every arm's body must be -- for a partial chain, the expectation with\n/// its Opt layer already peeled by the caller. With `None` the first arm's body decides, as\n/// it always has.\n/// The dead-arm rule, both ways a chain can already be finished: a default above matches\n/// everything, and arms covering every variant leave nothing for a later arm to see. (The\n/// second is also what lets every backend take a total chain's last arm without a test.)\nfn check_reachable(\n    ctx: &Ctx,\n    subject_ty: &Type,\n    covered: &[String],\n    default_seen: bool,\n    arm_span: Span,\n) -> Result<(), Error> {\n    if default_seen {\n        return Err(Error::new(\n            arm_span,\n            \"this arm can never match; the `any()` arm above it already matches everything\"\n                .to_string(),\n        ));\n    }\n    if let Type::Enum { name, args, .. } = subject_ty\n        && !covered.is_empty()\n        && enum_variants(ctx, name, args)\n            .iter()\n            .all(|(n, _)| covered.contains(n))\n    {\n        return Err(Error::new(\n            arm_span,\n            format!(","lineStart":1094,"lineEnd":1273,"totalLines":3239,"truncated":true}},"title":"src/check/mod.rs","time":{"start":1788464476513,"end":1788464476527}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me look at the `map_call` function, and how map projections work, so I understand how sort_by's projection argument will be checked.","format":"unknown","index":0}]}},"id":"prt_068ca3159001PmizHWSMAWS7Tc","sessionID":"ses_f97363172ffe9X2xJ1KPM1b5DB","messageID":"msg_068ca1ad7001hBFHZL3vy647pl"}}
