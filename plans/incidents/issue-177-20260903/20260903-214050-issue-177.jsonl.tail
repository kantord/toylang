{"type":"tool_use","timestamp":1788464605812,"sessionID":"ses_f97363172ffe9X2xJ1KPM1b5DB","part":{"type":"tool","tool":"read","callID":"call_fbe629b1e0064c8781e1079b","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-177/tests/corpus/map_records.yaml"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-177/tests/corpus/map_records.yaml</path>\n<type>file</type>\n<content>\n1: program: |\n2:   fn shout(db: {users: Vec<{name: Str, age: Int}>}) -> Vec<Str> =\n3:       db.users | map(.name + \" is \" + str(.age))\n4: \n5:   shout input\n6: \n7: input: |\n8:   {\"users\": [{\"name\": \"ada\", \"age\": 36}, {\"name\": \"bo\", \"age\": 9}]}\n9: \n10: output: |\n11:   [\"ada is 36\",\"bo is 9\"]\n12: \n13: node_types: [application, builtin.str, concat, input, local, map-over, pipe, projection, str, var]\n\n(End of file - total 13 lines)\n</content>","metadata":{"preview":"program: |\n  fn shout(db: {users: Vec<{name: Str, age: Int}>}) -> Vec<Str> =\n      db.users | map(.name + \" is \" + str(.age))\n\n  shout input\n\ninput: |\n  {\"users\": [{\"name\": \"ada\", \"age\": 36}, {\"name\": \"bo\", \"age\": 9}]}\n\noutput: |\n  [\"ada is 36\",\"bo is 9\"]\n\nnode_types: [application, builtin.str, concat, input, local, map-over, pipe, projection, str, var]","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-177/tests/corpus/map_records.yaml","text":"program: |\n  fn shout(db: {users: Vec<{name: Str, age: Int}>}) -> Vec<Str> =\n      db.users | map(.name + \" is \" + str(.age))\n\n  shout input\n\ninput: |\n  {\"users\": [{\"name\": \"ada\", \"age\": 36}, {\"name\": \"bo\", \"age\": 9}]}\n\noutput: |\n  [\"ada is 36\",\"bo is 9\"]\n\nnode_types: [application, builtin.str, concat, input, local, map-over, pipe, projection, str, var]","lineStart":1,"lineEnd":13,"totalLines":13,"truncated":false}},"title":"tests/corpus/map_records.yaml","time":{"start":1788464605803