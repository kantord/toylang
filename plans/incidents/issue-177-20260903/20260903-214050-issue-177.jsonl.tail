 its own\n1430:                     // comparator, so those three collapse into the same int64 sort.\n1431:                     Builtin::Sort => {\n1432:                         let elem = elem_ty.expect(\"checked to be a Vec\");\n1433:                         let rt = Self::sort_runtime(&self.rt, &elem);\n1434:                         self.call_rt(rt, &[arg], \"sort\")?\n1435:                     }\n1436:                     Builtin::Reverse => {\n1437:                         let elem = elem_ty.expect(\"checked to be a Vec\");\n1438:                         let ncols = self.ctx.i64_type().const_int(Self::columns(&elem), false);\n1439:                         self.call_rt(self.rt.vec_reverse, &[arg, ncols.into()], \"reverse\")?\n1440:                     }\n1441:                     // Both widths live in the same i64 slot, so the C function's `narrow` flag\n1442:                     // is what tells Int (32-bit wrap per addition) from Int64. An `i32` like\n1443:                     // `tl_at`'s `is_record` flag, since C's `int` is 32 bits.\n1444:                     Builtin::Sum => {\n1445:                         let narrow = self.ctx.i32_type().const_int(\n1446:                             (elem_ty.as_ref() == Some(&Type::Int)) as u64,\n1447:                             false,\n1448:                         );\n1449:                         self.call_rt(self.rt.vec_sum, &[arg, narrow.into()], \"sum\")?\n1450:                     }\n1451:                     // NULL on an empty Vec is exactly the absent Opt a partial Index yields.\n1452:                     Builtin::Max => self.call_rt(self.rt.vec_max, &[arg], \"max\")?,\n1453:                     // `arg` above ran only for whatever else it does; its value is unused here.\n1454:                     Builtin::Fields => self.fields_lit(&record_ty)?,\n1455:                 }\n1456:             }\n1457: \n1458:             Kind::Unwrap { base } => {\n1459:                 let depth = crate::tir::vec_depth(&base.ty);\