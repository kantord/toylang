y { source, body, .. } | Kind::MaxBy { source, body, .. } => {\n+    each_node(source, f);\n+    each_node(body, f);\n+}\n Kind::Field { base, .. } | Kind::Unwrap { base } => each_node(base, f),\n Kind::Builtin { arg, .. } => each_node(arg, f),\n Kind::Index { base, index, .. } => {\n     each_node(base, f);\n","additions":4,"deletions":0},"truncated":false},"title":"src/tir.rs","time":{"start":1788464798944,"end":1788464798949}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_068cf1cd9001IcF9Y6Y9NEZHTd","sessionID":"ses_f97363172ffe9X2xJ1KPM1b5DB","messageID":"msg_068cf12bf001xafNUaKeJHoM5s"}}
