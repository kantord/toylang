n empty list errors, and on a non-empty one is exactly this,\n580:             // so only the empty case is spelled: the absent Opt, tagged the way `Tail` tags.\n581:             Builtin::Max => format!(\n582:                 \"({} | if length == 0 then \\\"none\\\" else {{some: max}} end)\",\n583:                 expr(enums, arg)\n584:             ),\n585:             // The names come from the checked type, not the object value, so `arg` runs only to\n586:             // become the `.` a literal array then ignores -- the same discard the pipe already\n587:             // gives every other builtin here.\n588:             Builtin::Fields => {\n589:                 let Type::Record(fields) = &arg.ty else {\n590:                     unreachable!(\"checked to be a record\")\n591:                 };\n592:                 let names: Vec<String> = fields.iter().map(|(n, _)| jq_string(n)).collect();\n593:                 format!(\"({} | [{}])\", expr(enums, arg), names.join(\", \"))\n594:             }\n595:         },\n596:         Kind::Compare { op, lhs, rhs } => {\n597:             format!(\"({} {} {})\", expr(enums, lhs), jq_op(*op), expr(enums, rhs))\n598:         }\n599:         // jq spells them the same way toylang does, and short-circuits them the same way too.\n600:         Kind::Logic { op, lhs, rhs } => format!(\"({} {op} {})\", expr(enums, lhs), expr(enums, rhs)),\n601:         Kind::Not(base) => format!(\"({} | not)\", expr(enums, base)),\n602:         Kind::Bind {\n603:             local: id,\n604:             value,\n605:             body,\n606:         } => {\n607:             format!(\n608:                 \"({} as {} | {})\",\n609:                 expr(enums, value),\n610:                 local(*id),\n611:                 expr(enums, body)\n612:             )\n613:         }\n614:         // The one operator that is derived in jq and primitive here: `map(f)` is `[ .[] | f ]`\n615:         // there, and neither half of that exists in a language with no effect layer.\n616:         Kind::Map {\n617:             source,\n618:             param,\n619:             body,\n620:         } => format!(\n621:             \"[ {}[] | . as {} | {} ]\",\n622:             expr(enums, source),\n623:             local(*param),\n624:             expr(enums, body)\n625:         ),\n626:         Kind::Select {\n627:             source,\n628:             param,\n629:             pred,\n630:         } => format!(\n631:             \"[ {}[] | . as {} | select({}) ]\",\n632:             expr(enums, source),\n633:             local(*param),\n634:             expr(enums, pred)\n635:         ),\n636:         Kind::Field { base, name } => {\n637:             let depth = tir::vec_depth(&base.ty);\n638:             format!(\n639:                 \"({} | {})\",\n640:                 expr(enums, base),\n641:                 distribute(&field_of(\".\", name), depth)\n642:             )\n643:         }\n644:         Kind::Unwrap { base } => {\n645:             let check = format!(\n646:                 \"if . == \\\"none\\\" then error({}) else .some end\",\n647:                 jq_string(\"toylang: unwrapped a value that is not there\")\n648:             );\n649:             format!(\n650:                 \"({} | {})\",\n651:                 expr(enums, base),\n652:                 distribute(&check, tir::vec_depth(&base.ty))\n653:             )\n654:         }\n655:         // Opt's reorder pass (kantord/toylang#66): the same `== \"none\"`/`.some` shape the\n656:         // printer and Match already read, generalised to rebuild the object instead.\n657:         Kind::OptMap {\n658:             source,\n659:             param,\n660:             body,\n661:         } => format!(\n662:             \"({} | if . == \\\"none\\\" then \\\"none\\\" else (.some as {} | {{some: {}}}) end)\",\n663:             expr(enums, source),\n664:             local(*param),\n\n(Showing lines 555-664 of 940. Use offset=665 to continue.)\n</content>","metadata":{"preview