nce the body runs\n/// once per element rather than once.\nfn mapper_ctx<'a>(ctx: &'a Ctx, elem: Type, param: LocalId) -> Ctx<'a> {\n    let mut inner = ctx.with(Some((elem, param)));\n    inner.in_mapper = true;\n    inner\n}\n\n/// The one enum a bare variant name refers to, or the error naming every candidate: guessing\n/// between two claimants would silently pick a type the program never wrote down.\nfn sole_owner<'a>(\n    ctx: &'a Ctx,\n    variant: &str,\n    owners: &[String],\n    span: Span,\n) -> Result<&'a Type, Error> {\n    if owners.len() > 1 {\n        let named: Vec<String> = owners.iter().map(|e| format!(\"`{e}`\")).collect();\n        let qualified: Vec<String> = owners.iter().map(|e| format!(\"`{e}.{variant}`\")).collect();\n        return Err(Error::new(\n            span,\n            format!(\n                \"`{variant}` is a variant of {}; qualify it as {}\",\n                named.join(\" and \"),\n                qualified.join(\" or \")\n            ),\n        ));\n    }\n    Ok(&ctx.enums[&owners[0]])\n}\n\n/// Every builtin and special-cased call form (`select`, `map`, `length`, ...) is unary; only a\n/// user-defined function can be nullary. This unwraps a call's optional argument for those\n/// forms, turning a bare `name()` at one of these names into the same \"not a function\" shape as\n/// any other arity mismatch would need, rather than a panic.\nfn need_arg<'a>(arg: &'a Option<Box<Expr>>, func: &str, span: Span) -> Result<&'a Expr, Error> {\n    arg.as_deref()\n        .ok_or_else(|| Error::new(span, format!(\"`{func}` needs an argument\")))\n}\n\n/// `expr` is a call to `name` carrying an argument, for `expect_inner`'s `collect`/`map`\n/// special cases: a bare `name()` (no argument) is not one of these, and falls through to\n/// `synth`, which owns the arity error for a name that is not actually nullary.\nfn call_named<'a>(expr: &'a Expr, name: &str) -> Option<&'a Expr> {\n    let Expr::Call { func, arg, .. } = expr else {\n        return None;\n    };\n    if func != name {\n        return None;\n    }\n    arg.as_deref()\n}\n\n/// `name`'s variant list at `args`. A thin wrapper over the shared re-derivation\n/// (`ty::variants_of`), which the backends reach for too: the checker's own `Type::Enum` in\n/// hand carries a placeholder wherever a self-reference sits behind a `Vec`\n/// (`types::resolve_named`, kantord/toylang#76), so every consumer that actually needs the\n/// variants comes through here instead, one layer at a time, exactly as deep as the program\n/// itself ever navigates into the value.\nfn enum_variants(ctx: &Ctx, name: &str, args: &[Type]) -> Vec<(String, Option<Type>)> {\n    ty::variants_of(ctx.enums, name, args)\n}\n\n/// The prelude's `Opt<T>` at a concrete `T`: what every Opt-producing site -- the collapsing\n/// index, `tail`, a partial guard chain -- wraps its result in. Instantiated from the\n/// registry template rather than spelled out, so the checker never re-states the prelude's\n/// declaration.\nfn opt_of(ctx: &Ctx, inner: Type) -> Type {\n    let template = ctx.enums.get(\"Opt\").expect(\"the prelude declares Opt\");\n    let Type::Enum { args, .. } = template else {\n        unreachable!(\"the registry holds enum types\")\n    };\n    let Type::Param(p) = &args[0] else {\n        unreachable!(\"Opt's template argument is its own parameter\")\n    };\n    ty::substitute(template, &HashMap::from([(p.clone(), inner)]))\n}\n\n/// Match a template type (parameters possibly inside) against a concrete one, binding each\n/// parameter to what it faces. Records match fields by name, not position, the same way type\n/// equality does (kantord/toylang#60); enums match on name and arguments, since the variants\n/// follow from those.\nfn unify(template: &Type, concrete: &Type, map: &mut HashMap<String, Type>) -> bool {\n    match (template, concrete) {\n        (Type::Param(p), c) => match map.get(p) {\n            Some(bound) => bound == c,\n            None => {\n                map.insert(p.clone(), c.clone());\n                true\n            }\n        },\n        (Type::Vec(a), Type::Vec(b)) | (Type::Stream(a), Type::Stream(b)) => unify(a, b, map),\n        (Type::Record(a), Type::Record(b)) => {\n            a.len() == b.len()\n                && a.iter().all(|(n, t)| {\n                    b.iter()","lineStart":720,"lineEnd":839,"totalLines":3239,"truncated":true}},"title":"src/check/mod.rs","time":{"start":1788464470706,"end":1788464470722}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_068ca1aae001UiLFHIbfLZl7gd","sessionID":"ses_f97363172ffe9X2xJ1KPM1b5DB","messageID":"msg_068ca094f001sxL1FPabTdGimZ"}}
{"type":"tool_use","timestamp":1788464470725,"sessionID":"ses_f97363172ffe9X2xJ1KPM1b5DB","part":{"type":"tool","tool":"read","callID":"call_ef604391c7554276accdcdb5","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-177/src/check/mod.rs","limit":180,"offset":2224},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-177/src/check/mod.rs</path>\n<type>file</type>\n<content>\n2224: fn sort_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n2225:     let arg_span = arg.span();\n2226:     let arg = synth(ctx, arg)?;\n2227:     let Some(elem) = arg.ty.elem() else {\n2228:         return Err(Error::new(\n2229:             arg_span,\n2230:             format!(\"`sort` needs a Vec, found {}\", arg.ty),\n2231:         ));\n2232:     };\n2233:     if !orderable(elem) {\n2234:         return Err(Error::new(\n2235:             arg_span,\n2236:             format!(\n2237:                 \"`sort` needs a Vec of Int, Int64, Str, or Char, found {}\",\n2238:                 arg.ty\n2239:             ),\n2240:         ));\n2241:     }\n2242:     let ty = arg.ty.clone();\n2243:     Ok(Tir::new(\n2244:         ty,\n2245:         Kind::Builtin {\n2246:             which: tir::Builtin::Sort,\n2247:             arg: Box::new(arg),\n2248:         },\n2249:     ))\n2250: }\n2251: \n2252: /// `reverse(v)`, `v`'s elements in the opposite order. Unlike `sort`, no comparison is needed,\n2253: /// so every element type is accepted.\n2254: fn reverse_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n2255:     let arg_span = arg.span();\n2256:     let arg = synth(ctx, arg)?;\n2257:     if arg.ty.elem().is_none() {\n2258:         return Err(Error::new(\n2259:             arg_span,\n2260:             format!(\"`reverse` needs a Vec, found {}\", arg.ty),\n2261:         ));\n2262:     }\n2263:     let ty = arg.ty.clone();\n2264:     Ok(Tir::new(\n2265:         ty,\n2266:         Kind::Builtin {\n2267:             which: tir::Builtin::Reverse,\n2268:             arg: Box::new(arg),\n2269:         },\n2270:     ))\n2271: }\n2272: \n2273: /// The element types a reduction is defined for: the two integer types. Neither Str nor Char\n2274: /// participates -- there is no caller for either -- so the restricted set is what a backend has\n2275: /// to spell (kantord/toylang#140, the ruling that cut min and product on the same grounds).\n2276: fn reducible(ty: &Type) -> bool {\n2277:     matches!(ty, Type::Int | Type::Int64)\n2278: }\n2279: \n2280: /// `sum(v)`, the reduction of `+` at the element type's width: `Vec<Int> -> Int`,\n2281: /// `Vec<Int64> -> Int64`. An empty Vec sums to 0, so unlike `max` the result is never `Opt`.\n2282: fn sum_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n2283:     let arg_span = arg.span();\n2284:     let arg = synth(ctx, arg)?;\n2285:     let Some(elem) = arg.ty.elem() else {\n2286:         return Err(Error::new(\n2287:             arg_span,\n2288:             format!(\"`sum` needs a Vec of Int or Int64, found {}\", arg.ty),\n2289:         ));\n2290:     };\n2291:     if !reducible(elem) {\n2292:         return Err(Error::new(\n2293:             arg_span,\n2294:             format!(\"`sum` needs a Vec of Int or Int64, found {}\", arg.ty),\n2295:         ));\n2296:     }\n2297:     Ok(Tir::new(\n2298:         elem.clone(),\n2299:         Kind::Builtin {\n2300:             which: tir::Builtin::Sum,\n2301:             arg: Box::new(arg),\n2302:         },\n2303:     ))\n2304: }\n2305: \n2306: /// `max(v)`, the greatest element, `Opt<T>` because an empty Vec has no maximum -- the same\n2307: /// answer indexing gives to absence (kantord/toylang#140).\n2308: fn max_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n2309:     let arg_span = arg.span();\n2310:     let arg = synth(ctx, arg)?;\n2311:     let Some(elem) = arg.ty.elem() else {\n2312:         return Err(Error::new(\n2313:             arg_span,\n2314:             format!(\"`max` needs a Vec of Int or Int64, found {}\", arg.ty),\n2315:         ));\n2316:     };\n2317:     if !reducible(elem) {\n2318:         return Err(Error::new(\n2319:             arg_span,\n2320:             format!(\"`max` needs a Vec of Int or Int64, found {}\", arg.ty),\n2321:         ));\n2322:     }\n2323:     Ok(Tir::new(\n2324:         opt_of(ctx, elem.clone()),\n2325:         Kind::Builtin {\n2326:             which: tir::Builtin::Max,\n2327:             arg: Box::new(arg),\n2328:         },\n2329:     ))\n2330: }\n2331: \n2332: /// Walk an access chain left to right, carrying what we are currently looking at and how many\n2333: /// dimensions we are inside.\n2334: ///\n2335: /// Every dimension needs a spec. `[]` enters one, so it strips a layer off what we are looking at\n2336: /// and adds one to the depth; a field access reads a field of it and leaves the depth alone.\n2337: /// The expression's type is what we are looking at, wrapped back up that many times.\n2338: ///\n2339: /// This is why `db.users.name` is an error and `db.users[].name` is not: the first never said\n2340: /// what happens to the dimension it reached through.\n2341: ///\n2342: /// A Stream is one more dimension `[]` can enter -- projection is a mapper -- and since the\n2343: /// grammar keeps a stream strictly outermost, the walk only has to remember one bit: whether\n2344: /// the first-stripped layer was a Stream (`stream_outer`), so wrapping back up restores a\n2345: /// Stream there and a Vec everywhere below.\n2346: struct Access {\n2347:     tir: Tir,\n2348:     /// What the chain currently evaluates to, one dimension down: a field access reads this, a\n2349:     /// further `[]` strips a layer off it.\n2350:     elem: Type,\n2351:     /// How many dimensions the chain is inside.\n2352:     depth: usize,\n2353:     /// Whether the first-stripped layer was a Stream rather than a Vec.\n2354:     stream: bool,\n2355: }\n2356: \n2357: impl Access {\n2358:     fn new(tir: Tir, elem: Type, depth: usize, stream: bool) -> Access {\n2359:         Access {\n2360:             tir,\n2361:             elem,\n2362:             depth,\n2363:             stream,\n2364:         }\n2365:     }\n2366: }\n2367: \n2368: fn access(ctx: &Ctx, expr: &Expr) -> Result<Access, Error> {\n2369:     /// `elem`, wrapped back up under every dimension the chain is inside.\n2370:     fn wrap(mut ty: Type, depth: usize, stream_outer: bool) -> Type {\n2371:         for i in 0..depth {\n2372:             ty = if stream_outer && i == depth - 1 {\n2373:                 Type::Stream(Box::new(ty))\n2374:             } else {\n2375:                 Type::Vec(Box::new(ty))\n2376:             };\n2377:         }\n2378:         ty\n2379:     }\n2380: \n2381:     match expr {\n2382:         Expr::Project { base, span } => {\n2383:             let b = access(ctx, base)?;\n2384:             if let Type::Stream(inner) = &b.elem {\n2385:                 return Ok(Access::new(b.tir, (**inner).clone(), b.depth + 1, true));\n2386:             }\n2387:             let Some(inner) = b.elem.elem().cloned() else {\n2388:                 return Err(Error::new(\n2389:                     *span,\n2390:                     format!(\"`[]` needs a dimension, found {}\", b.elem),\n2391:                 ));\n2392:             };\n2393:             Ok(Access::new(b.tir, inner, b.depth + 1, b.stream))\n2394:         }\n2395: \n2396:         // The absence stops being carried and starts being asserted.\n2397:         Expr::Unwrap { base, span } => {\n2398:             let b = access(ctx, base)?;\n2399:             let Some(inner) = b.elem.as_opt() else {\n2400:                 return Err(Error::new(\n2401:                     *span,\n2402:                     format!(\"`!` needs an Opt, found {}\", b.elem),\n2403:                 ));\n\n(Showing lines 2224-2403 of 3239. Use offset=2404 to continue.)\n</content>","metadata":{"preview":"fn sort_call(ctx: &Ctx, arg: &Expr) -> Result<Tir, Error> {\n    let arg_span = arg.span();\n    let arg = s