{"type":"tool_use","timestamp":1788464717363,"sessionID":"ses_f97363172ffe9X2xJ1KPM1b5DB","part":{"type":"tool","tool":"read","callID":"call_65e8325adc0644ceac58e592","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-177/src/check/linearity.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-177/src/check/linearity.rs</path>\n<type>file</type>\n<content>\n1: //! Two passes that walk an already-built `Tir` and never touch `Expr` or type resolution: stream\n2: //! linearity (every stream-typed binding consumed exactly once) and dead-code pruning (which\n3: //! functions the program body can actually reach).\n4: \n5: use crate::ast::Span;\n6: use crate::error::Error;\n7: use crate::tir::{self, Kind, LocalId, Tir};\n8: \n9: /// What a linearity count is looking for: a stream-typed binding, named either by the source\n10: /// (a function parameter) or by the checker (the local a `|` binds `.` to).\n11: pub(super) enum StreamBinding<'a> {\n12:     Param(&'a str),\n13:     Local(LocalId),\n14: }\n15: \n16: /// What broke the exactly-once rule, when a plain count cannot say it.\n17: enum LinearViolation {\n18:     /// A conditional's or match's paths disagree on how often they consume the binding.\n19:     Branches { first: usize, second: usize },\n20:     /// The binding is consumed inside a mapper's body, which runs once per element -- one\n21:     /// spelled consumption, many runtime ones.\n22:     InMapper,\n23: }\n24: \n25: /// How many times `t` consumes `binding`, counted along one evaluation path: a conditional\n26: /// runs one branch, so its branches must agree with each other rather than being summed, and\n27: /// a match's arms likewise. A mapper's body runs once per element, so any consumption there\n28: /// is its own violation rather than a count.\n29: fn stream_uses(t: &Tir, binding: &StreamBinding) -> Result<usize, LinearViolation> {\n30:     let both = |a: &Tir, b: &Tir| Ok(stream_uses(a, binding)? + stream_uses(b, binding)?);\n31:     match &t.kind {\n32:         Kind::Var(name) => Ok(match binding {\n33:             StreamBinding::Param(p) => (p == name) as usize,\n34:             StreamBinding::Local(_) => 0,\n35:         }),\n36:         Kind::Local(id) => Ok(match binding {\n37:             StreamBinding::Local(l) => (l == id) as usize,\n38:             StreamBinding::Param(_) => 0,\n39:         }),\n40:         Kind::Str(_)\n41:         | Kind::Int(_)\n42:         | Kind::Float(_)\n43:         | Kind::Input\n44:         | Kind::Inputs\n45:         | Kind::Lines\n46:         | Kind::Dsv { .. } => Ok(0),\n47:         Kind::VecLit(items) => items\n48:             .iter()\n49:             .try_fold(0, |n, i| Ok(n + stream_uses(i, binding)?)),\n50:         Kind::RecordLit { fields } => fields\n51:             .iter()\n52:             .try_fold(0, |n, (_, v)| Ok(n + stream_uses(v, binding)?)),\n53:         Kind::EnumLit { payload, .. } => payload\n54:             .as_deref()\n55:             .map_or(Ok(0), |p| stream_uses(p, binding)),\n56:         Kind::Call { arg, .. } => arg.as_deref().map_or(Ok(0), |a| stream_uses(a, binding)),\n57:         Kind::Builtin { arg, .. } => stream_uses(arg, binding),\n58:         Kind::Concat(l, r) => both(l, r),\n59:         Kind::Arith { lhs, rhs, .. } | Kind::Compare { lhs, rhs, .. } => both(lhs, rhs),\n60:         // Summed rather than reconciled the way a conditional's branches are: `and`/`or` may\n61:         // skip their right side, so a binding consumed on both sides is consumed once or twice\n62:         // depending on the left operand's value, and \"sometimes twice\" is exactly what the\n63:         // exactly-once rule refuses.\n64:         Kind::Logic { lhs, rhs, .. } => both(lhs, rhs),\n65:         Kind::Not(base) => stream_uses(base, binding),\n66:         Kind::Bind { value, body, .. } => both(value, body),\n67:         Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n68:             if stream_uses(body, binding)? > 0 {\n69:                 return Err(LinearViolation::InMapper);\n70:             }\n71:             stream_uses(source, binding)\n72:         }\n73:         Kind::Select { source, pred, .. } => {\n74:             if stream_uses(pred, binding)? > 0 {\n75:                 return Err(LinearViolation::InMapper);\n76:             }\n77:             stream_uses(source, binding)\n78:         }\n79:         Kind::Field { base, .. } | Kind::Unwrap { base } => stream_uses(base, binding),\n80:         Kind::Index { base, index, .. } => both(base, index),\n81:         Kind::Slice { base, start, end, .. } => {\n82:             let mut acc = stream_uses(base, binding)?;\n83:             if let Some(s) = start {\n84:                 acc += stream_uses(s, binding)?;\n85:             }\n86:             if let Some(e) = end {\n87:                 acc += stream_uses(e, binding)?;\n88:             }\n89:             Ok(acc)\n90:         }\n91:         Kind::Match {\n92:             subject,\n93:             arms,\n94:             partial,\n95:         } => {\n96:             // A path through the chain evaluates every guard up to its arm, then that arm's\n97:             // body; a partial chain has one more path, the fall-through, which evaluates every\n98:             // guard and no body. All of them must agree.\n99:             let mut guards_so_far = 0;\n100:             let mut counts: Vec<usize> = Vec::new();\n101:             for a in arms {\n102:                 if let Some(g) = &a.guard {\n103:                     guards_so_far += stream_uses(g, binding)?;\n104:                 }\n105:                 counts.push(guards_so_far + stream_uses(&a.body, binding)?);\n106:             }\n107:             if *partial {\n108:                 counts.push(guards_so_far);\n109:             }\n110:             if let Some(w) = counts.windows(2).find(|w| w[0] != w[1]) {\n111:                 return Err(LinearViolation::Branches {\n112:                     first: w[0],\n113:                     second: w[1],\n114:                 });\n115:             }\n116:             Ok(stream_uses(subject, binding)? + counts.first().copied().unwrap_or(0))\n117:         }\n118:     }\n119: }\n120: \n121: /// The per-binding half of stream linearity: `binding`, already known to be stream-typed, must\n122: /// be consumed exactly once by `body`. Zero uses is an error too -- linear, not affine: a\n123: /// dropped stream is the Python silent-empty-generator mistake, and exactly-once can relax to\n124: /// at-most-once later without breaking a program, while the reverse tightening could not.\n125: pub(super) fn check_linear(\n126:     body: &Tir,\n127:     binding: &StreamBinding,\n128:     subject: &str,\n129:     span: Span,\n130: ) -> Result<(), Error> {\n131:     match stream_uses(body, binding) {\n132:         Err(LinearViolation::Branches { first, second }) => Err(Error::new(\n133:             span,\n134:             format!(\n135:                 \"{subject} must be consumed exactly once on every path, but one branch \\\n136:                  consumes it {first} times and another {second}\"\n137:             ),\n138:         )),\n139:         Err(LinearViolation::InMapper) => Err(Error::new(\n140:             span,\n141:             format!(\n142:                 \"{subject} must be consumed exactly once, but here it is consumed inside a \\\n143:                  mapper body, which runs once per element\"\n144:             ),\n145:         )),\n146:         Ok(1) => Ok(()),\n147:         Ok(0) => Err(Error::new(\n148:             span,\n149:             format!(\"{subject} must be consumed exactly once; it is never consumed\"),\n150:         )),\n151:         Ok(n) => Err(Error::new(\n152:             span,\n153:             format!(\"{subject} must be consumed exactly once, not {n} times\"),\n154:         )),\n155:     }\n156: }\n157: \n158: /// Whether any node in `t` satisfies `pred`, walking every child a Tir node can hold. The same\n159: /// shape as `stream_uses`, but a plain OR rather than a count: unused-binding checks only need\n160: /// to know whether a name was read at all, not how many times or along which path.\n161: fn any_node(t: &Tir, pred: &dyn Fn(&Tir) -> bool) -> bool {\n162:     if pred(t) {\n163:         return true;\n164:     }\n165:     match &t.kind {\n166:         Kind::Var(_)\n167:         | Kind::Local(_)\n168:         | Kind::Str(_)\n169:         | Kind::Int(_)\n170:         | Kind::Float(_)\n171:         | Kind::Input\n172:         | Kind::Inputs\n173:         | Kind::Lines\n174:         | Kind::Dsv { .. } => false,\n175:         Kind::VecLit(items) => items.iter().any(|i| any_node(i, pred)),\n176:         Kind::RecordLit { fields } => fields.iter().any(|(_, v)| any_node(v, pred)),\n177:         Kind::EnumLit { payload, .. } => payload.as_deref().is_some_and(|p| any_node(p, pred)),\n178:         Kind::Call { arg, .. } => arg.as_deref().is_some_and(|a| any_node(a, pred)),\n179:         Kind::Builtin { arg, .. } => any_node(arg, pred),\n180:         Kind::Concat(l, r) => any_node(l, pred) || any_node(r, pred),\n181:         Kind::Not(base) => any_node(base, pred),\n182:         Kind::Arith { lhs, rhs, .. }\n183:         | Kind::Compare { lhs, rhs, .. }\n184:         | Kind::Logic { lhs, rhs, .. } => any_node(lhs, pred) || any_node(rhs, pred),\n185:         Kind::Bind { value, body, .. } => any_node(value, pred) || any_node(body, pred),\n186:         Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n187:             any_node(source, pred) || any_node(body, pred)\n188:         }\n189:         Kind::Select {\n190:             source, pred: p, ..\n191:         } => any_node(source, pred) || any_node(p, pred),\n192:         Kind::Field { base, .. } | Kind::Unwrap { base } => any_node(base, pred),\n193:         Kind::Index { base, index, .. } => any_node(base, pred) || any_node(index, pred),\n194:         Kind::Slice { base, start, end, .. } => {\n195:             any_node(base, pred)\n196:                 || start.as_deref().is_some_and(|s| any_node(s, pred))\n197:                 || end.as_deref().is_some_and(|e| any_node(e, pred))\n198:         }\n199:         Kind::Match { subject, arms, .. } => {\n200:             any_node(subject, pred)\n201:                 || arms.iter().any(|a| {\n202:                     a.guard.as_ref().is_some_and(|g| any_node(g, pred)) || any_node(&a.body, pred)\n203:                 })\n204:         }\n205:     }\n206: }\n207: \n208: /// Whether the function parameter `name` is read anywhere in its body. Go exempts parameters\n209: /// from its unused-binding rule; toylang does not, since a function here has exactly one, and\n210: /// declaring an input the body ignores is the same dead-code smell the rule exists for.\n211: pub(super) fn param_used(body: &Tir, name: &str) -> bool {\n212:     any_node(body, &|t| matches!(&t.kind, Kind::Var(n) if n == name))\n213: }\n214: \n215: /// Whether a match arm's destructured field `name`, bound off payload local `pid`, is read\n216: /// anywhere in the arm's body.\n217: pub(super) fn field_used(body: &Tir, pid: LocalId, name: &str) -> bool {\n218:     any_node(\n219:         body,\n220:         &|t| matches!(&t.kind, Kind::Field { base, name: n } if n == name && matches!(base.kind, Kind::Local(id) if id == pid)),\n221:     )\n222: }\n223: \n224: /// Every function the program's body can actually reach, directly or through calls a reached\n225: /// function itself makes. `pub fn`s from the prelude are always merged into `file.defs` before\n226: /// this runs, so a `pub` one the program never calls needs pruning here to keep it out of a\n227: /// backend's output and out of `tags::node_types` -- and an unused function the program wrote\n228: /// itself is pruned by the same pass, for the same reason.\n229: pub(super) fn prune_unreachable(funcs: Vec<tir::Func>, body: &Tir) -> Vec<tir::Func> {\n230:     let mut reached: std::collections::HashSet<String> = std::collections::HashSet::new();\n231:     let mut worklist: Vec<String> = Vec::new();\n232:     calls_in(body, &mut worklist);\n233:     while let Some(name) = worklist.pop() {\n234:         if reached.insert(name.clone())\n235:             && let Some(f) = funcs.iter().find(|f| f.name == name)\n236:         {\n237:             calls_in(&f.body, &mut worklist);\n238:         }\n239:     }\n240:     funcs\n241:         .into_iter()\n242:         .filter(|f| reached.contains(&f.name))\n243:         .collect()\n244: }\n245: \n246: /// Every function name a `Kind::Call` inside `t` names, collected recursively through every\n247: /// other kind of node.\n248: fn calls_in(t: &Tir, out: &mut Vec<String>) {\n249:     if let Kind::Call { func, arg } = &t.kind {\n250:         out.push(func.clone());\n251:         if let Some(arg) = arg {\n252:             calls_in(arg, out);\n253:         }\n254:         return;\n255:     }\n256:     match &t.kind {\n257:         Kind::Str(_)\n258:         | Kind::Int(_)\n259:         | Kind::Float(_)\n260:         | Kind::Var(_)\n261:         | Kind::Local(_)\n262:         | Kind::Input\n263:         | Kind::Inputs\n264:         | Kind::Lines\n265:         | Kind::Dsv { .. } => {}\n266:         Kind::VecLit(items) => items.iter().for_each(|i| calls_in(i, out)),\n267:         Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| calls_in(v, out)),\n268:         Kind::EnumLit { payload, .. } => {\n269:             if let Some(p) = payload {\n270:                 calls_in(p, out);\n271:             }\n272:         }\n273:         Kind::Call { .. } => unreachable!(\"handled above\"),\n274:         Kind::Concat(l, r) => {\n275:             calls_in(l, out);\n276:             calls_in(r, out);\n277:         }\n278:         Kind::Not(base) => calls_in(base, out),\n279:         Kind::Arith { lhs, rhs, .. }\n280:         | Kind::Compare { lhs, rhs, .. }\n281:         | Kind::Logic { lhs, rhs, .. } => {\n282:             calls_in(lhs, out);\n283:             calls_in(rhs, out);\n284:         }\n285:         Kind::Bind { value, body, .. }\n286:         | Kind::Map {\n287:             source: value,\n288:             body,\n289:             ..\n290:         }\n291:         | Kind::OptMap {\n292:             source: value,\n293:             body,\n294:             ..\n295:         } => {\n296:             calls_in(value, out);\n297:             calls_in(body, out);\n298:         }\n299:         Kind::Select { source, pred, .. } => {\n300:             calls_in(source, out);\n301:             calls_in(pred, out);\n302:         }\n303:         Kind::Field { base, .. } | Kind::Unwrap { base } => calls_in(base, out),\n304:         Kind::Builtin { arg, .. } => calls_in(arg, out),\n305:         Kind::Index { base, index, .. } => {\n306:             calls_in(base, out);\n307:             calls_in(index, out);\n308:         }\n309:         Kind::Slice { base, start, end, .. } => {\n310:             calls_in(base, out);\n311:             if let Some(s) = start {\n312:                 calls_in(s, out);\n313:             }\n314:             if let Some(e) = end {\n315:                 calls_in(e, out);\n316:             }\n317:         }\n318:         Kind::Match { subject, arms, .. } => {\n319:             calls_in(subject, out);\n320:             for a in arms {\n321:                 if let Some(g) = &a.guard {\n322:                     calls_in(g, out);\n323:                 }\n324:                 calls_in(&a.body, out);\n325:             }\n326:         }\n327:     }\n328: }\n\n(End of file - total 328 lines)\n</content>","metadata":{"preview":"//! Two passes that walk an already-built `Tir` and never touch `Expr` or type resolution: stream\n//! linearity (every stream-typed binding consumed exactly once) and dead-code pruning (which\n//! functions the program body can actually reach).\n\nuse crate::ast::Span;\nuse crate::error::Error;\nuse crate::tir::{self, Kind, LocalId, Tir};\n\n/// What a linearity count is looking for: a stream-typed binding, named either by the source\n/// (a function parameter) or by the checker (the local a `|` binds `.` to).\npub(super) enum StreamBinding<'a> {\n    Param(&'a str),\n    Local(LocalId),\n}\n\n/// What broke the exactly-once rule, when a plain count cannot say it.\nenum LinearViolation {\n    /// A conditional's or match's paths disagree on how often they consume the binding.\n    Branches { first: usize, second: usize },\n    /// The binding is consumed inside a mapper's body, which runs once per element -- one","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-177/src/check/linearity.rs","text":"//! Two passes that walk an already-built `Tir` and never touch `Expr` or type resolution: stream\n//! linearity (every stream-typed binding consumed exactly once) and dead-code pruning (which\n//! functions the program body can actually reach).\n\nuse crate::ast::Span;\nuse crate::error::Error;\nuse crate::tir::{self, Kind, LocalId, Tir};\n\n/// What a linearity count is looking for: a stream-typed binding, named either by the source\n/// (a function parameter) or by the checker (the local a `|` binds `.` to).\npub(super) enum StreamBinding<'a> {\n    Param(&'a str),\n    Local(LocalId),\n}\n\n/// What broke the exactly-once rule, when a plain count cannot say it.\nenum LinearViolation {\n    /// A conditional's or match's paths disagree on how often they consume the binding.\n    Branches { first: usize, second: usize },\n    /// The binding is consumed inside a mapper's body, which runs once per element -- one\n    /// spelled consumption, many runtime ones.\n    InMapper,\n}\n\n/// How many times `t` consumes `binding`, counted along one evaluation path: a conditional\n/// runs one branch, so its branches must agree with each other rather than being summed, and\n/// a match's arms likewise. A mapper's body runs once per element, so any consumption there\n/// is its own violation rather than a count.\nfn stream_uses(t: &Tir, binding: &StreamBinding) -> Result<usize, LinearViolation> {\n    let both = |a: &Tir, b: &Tir| Ok(stream_uses(a, binding)? + stream_uses(b, binding)?);\n    match &t.kind {\n        Kind::Var(name) => Ok(match binding {\n            StreamBinding::Param(p) => (p == name) as usize,\n            StreamBinding::Local(_) => 0,\n        }),\n        Kind::Local(id) => Ok(match binding {\n            StreamBinding::Local(l) => (l == id) as usize,\n            StreamBinding::Param(_) => 0,\n        }),\n        Kind::Str(_)\n        | Kind::Int(_)\n        | Kind::Float(_)\n        | Kind::Input\n        | Kind::Inputs\n        | Kind::Lines\n        | Kind::Dsv { .. } => Ok(0),\n        Kind::VecLit(items) => items\n            .iter()\n            .try_fold(0, |n, i| Ok(n + stream_uses(i, binding)?)),\n        Kind::RecordLit { fields } => fields\n            .iter()\n            .try_fold(0, |n, (_, v)| Ok(n + stream_uses(v, binding)?)),\n        Kind::EnumLit { payload, .. } => payload\n            .as_deref()\n            .map_or(Ok(0), |p| stream_uses(p, binding)),\n        Kind::Call { arg, .. } => arg.as_deref().map_or(Ok(0), |a| stream_uses(a, binding)),\n        Kind::Builtin { arg, .. } => stream_uses(arg, binding),\n        Kind::Concat(l, r) => both(l, r),\n        Kind::Arith { lhs, rhs, .. } | Kind::Compare { lhs, rhs, .. } => both(lhs, rhs),\n        // Summed rather than reconciled the way a conditional's branches are: `and`/`or` may\n        // skip their right side, so a binding consumed on both sides is consumed once or twice\n        // depending on the left operand's value, and \"sometimes twice\" is exactly what the\n        // exactly-once rule refuses.\n        Kind::Logic { lhs, rhs, .. } => both(lhs, rhs),\n        Kind::Not(base) => stream_uses(base, binding),\n        Kind::Bind { value, body, .. } => both(value, body),\n        Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n            if stream_uses(body, binding)? > 0 {\n                return Err(LinearViolation::InMapper);\n            }\n            stream_uses(source, binding)\n        }\n        Kind::Select { source, pred, .. } => {\n            if stream_uses(pred, binding)? > 0 {\n                return Err(LinearViolation::InMapper);\n            }\n            stream_uses(source, binding)\n        }\n        Kind::Field { base, .. } | Kind::Unwrap { base } => stream_uses(base, binding),\n        Kind::Index { base, index, .. } => both(base, index),\n        Kind::Slice { base, start, end, .. } => {\n            let mut acc = stream_uses(base, binding)?;\n            if let Some(s) = start {\n                acc += stream_uses(s, binding)?;\n            }\n            if let Some(e) = end {\n                acc += stream_uses(e, binding)?;\n            }\n            Ok(acc)\n        }\n        Kind::Match {\n            subject,\n            arms,\n            partial,\n        } => {\n            // A path through the chain evaluates every guard up to its arm, then that arm's\n            // body; a partial chain has one more path, the fall-through, which evaluates every\n            // guard and no body. All of them must agree.\n            let mut guards_so_far = 0;\n            let mut counts: Vec<usize> = Vec::new();\n            for a in arms {\n                if let Some(g) = &a.guard {\n                    guards_so_far += stream_uses(g, binding)?;\n                }\n                counts.push(guards_so_far + stream_uses(&a.body, binding)?);\n            }\n            if *partial {\n                counts.push(guards_so_far);\n            }\n            if let Some(w) = counts.windows(2).find(|w| w[0] != w[1]) {\n                return Err(LinearViolation::Branches {\n                    first: w[0],\n                    second: w[1],\n                });\n            }\n            Ok(stream_uses(subject, binding)? + counts.first().copied().unwrap_or(0))\n        }\n    }\n}\n\n/// The per-binding half of stream linearity: `binding`, already known to be stream-typed, must\n/// be consumed exactly once by `body`. Zero uses is an error too -- linear, not affine: a\n/// dropped stream is the Python silent-empty-generator mistake, and exactly-once can relax to\n/// at-most-once later without breaking a program, while the reverse tightening could not.\npub(super) fn check_linear(\n    body: &Tir,\n    binding: &StreamBinding,\n    subject: &str,\n    span: Span,\n) -> Result<(), Error> {\n    match stream_uses(body, binding) {\n        Err(LinearViolation::Branches { first, second }) => Err(Error::new(\n            span,\n            format!(\n                \"{subject} must be consumed exactly once on every path, but one branch \\\n                 consumes it {first} times and another {second}\"\n            ),\n        )),\n        Err(LinearViolation::InMapper) => Err(Error::new(\n            span,\n            format!(\n                \"{subject} must be consumed exactly once, but here it is consumed inside a \\\n                 mapper body, which runs once per element\"\n            ),\n        )),\n        Ok(1) => Ok(()),\n        Ok(0) => Err(Error::new(\n            span,\n            format!(\"{subject} must be consumed exactly once; it is never consumed\"),\n        )),\n        Ok(n) => Err(Error::new(\n            span,\n            format!(\"{subject} must be consumed exactly once, not {n} times\"),\n        )),\n    }\n}\n\n/// Whether any node in `t` satisfies `pred`, walking every child a Tir node can hold. The same\n/// shape as `stream_uses`, but a plain OR rather than a count: unused-binding checks only need\n/// to know whether a name was read at all, not how many times or along which path.\nfn any_node(t: &Tir, pred: &dyn Fn(&Tir) -> bool) -> bool {\n    if pred(t) {\n        return true;\n    }\n    match &t.kind {\n        Kind::Var(_)\n        | Kind::Local(_)\n        | Kind::Str(_)\n        | Kind::Int(_)\n        | Kind::Float(_)\n        | Kind::Input\n        | Kind::Inputs\n        | Kind::Lines\n        | Kind::Dsv { .. } => false,\n        Kind::VecLit(items) => items.iter().any(|i| any_node(i, pred)),\n        Kind::RecordLit { fields } => fields.iter().any(|(_, v)| any_node(v, pred)),\n        Kind::EnumLit { payload, .. } => payload.as_deref().is_some_and(|p| any_node(p, pred)),\n        Kind::Call { arg, .. } => arg.as_deref().is_some_and(|a| any_node(a, pred)),\n        Kind::Builtin { arg, .. } => any_node(arg, pred),\n        Kind::Concat(l, r) => any_node(l, pred) || any_node(r, pred),\n        Kind::Not(base) => any_node(base, pred),\n        Kind::Arith { lhs, rhs, .. }\n        | Kind::Compare { lhs, rhs, .. }\n        | Kind::Logic { lhs, rhs, .. } => any_node(lhs, pred) || any_node(rhs, pred),\n        Kind::Bind { value, body, .. } => any_node(value, pred) || any_node(body, pred),\n        Kind::Map { source, body, .. } | Kind::OptMap { source, body, .. } => {\n            any_node(source, pred) || any_node(body, pred)\n        }\n        Kind::Select {\n            source, pred: p, ..\n        } => any_node(source, pred) || any_node(p, pred),\n        Kind::Field { base, .. } | Kind::Unwrap { base } => any_node(base, pred),\n        Kind::Index { base, index, .. } => any_node(base, pred) || any_node(index, pred),\n        Kind::Slice { base, start, end, .. } => {\n            any_node(base, pred)\n                || start.as_deref().is_some_and(|s| any_node(s, pred))\n                || end.as_deref().is_some_and(|e| any_node(e, pred))\n        }\n        Kind::Match { subject, arms, .. } => {\n            any_node(subject, pred)\n                || arms.iter().any(|a| {\n                    a.guard.as_ref().is_some_and(|g| any_node(g, pred)) || any_node(&a.body, pred)\n                })\n        }\n    }\n}\n\n/// Whether the function parameter `name` is read anywhere in its body. Go exempts parameters\n/// from its unused-binding rule; toylang does not, since a function here has exactly one, and\n/// declaring an input the body ignores is the same dead-code smell the rule exists for.\npub(super) fn param_used(body: &Tir, name: &str) -> bool {\n    any_node(body, &|t| matches!(&t.kind, Kind::Var(n) if n == name))\n}\n\n/// Whether a match arm's destructured field `name`, bound off payload local `pid`, is read\n/// anywhere in the arm's body.\npub(super) fn field_used(body: &Tir, pid: LocalId, name: &str) -> bool {\n    any_node(\n        body,\n        &|t| matches!(&t.kind, Kind::Field { base, name: n } if n == name && matches!(base.kind, Kind::Local(id) if id == pid)),\n    )\n}\n\n/// Every function the program's body can actually reach, directly or through calls a reached\n/// function itself makes. `pub fn`s from the prelude are always merged into `file.defs` before\n/// this runs, so a `pub` one the program never calls needs pruning here to keep it out of a\n/// backend's output and out of `tags::node_types` -- and an unused function the program wrote\n/// itself is pruned by the same pass, for the same reason.\npub(super) fn prune_unreachable(funcs: Vec<tir::Func>, body: &Tir) -> Vec<tir::Func> {\n    let mut reached: std::collections::HashSet<String> = std::collections::HashSet::new();\n    let mut worklist: Vec<String> = Vec::new();\n    calls_in(body, &mut worklist);\n    while let Some(name) = worklist.pop() {\n        if reached.insert(name.clone())\n            && let Some(f) = funcs.iter().find(|f| f.name == name)\n        {\n            calls_in(&f.body, &mut worklist);\n        }\n    }\n    funcs\n        .into_iter()\n        .filter(|f| reached.contains(&f.name))\n        .collect()\n}\n\n/// Every function name a `Kind::Call` inside `t` names, collected recursively through every\n/// other kind of node.\nfn calls_in(t: &Tir, out: &mut Vec<String>) {\n    if let Kind::Call { func, arg } = &t.kind {\n        out.push(func.clone());\n        if let Some(arg) = arg {\n            calls_in(arg, out);\n        }\n        return;\n    }\n    match &t.kind {\n        Kind::Str(_)\n        | Kind::Int(_)\n        | Kind::Float(_)\n        | Kind::Var(_)\n        | Kind::Local(_)\n        | Kind::Input\n        | Kind::Inputs\n        | Kind::Lines\n        | Kind::Dsv { .. } => {}\n        Kind::VecLit(items) => items.iter().for_each(|i| calls_in(i, out)),\n        Kind::RecordLit { fields } => fields.iter().for_each(|(_, v)| calls_in(v, out)),\n        Kind::EnumLit { payload, .. } => {\n            if let Some(p) = payload {\n                calls_in(p, out);\n            }\n        }\n        Kind::Call { .. } => unreachable!(\"handled above\"),\n        Kind::Concat(l, r) => {\n            calls_in(l, out);\n            calls_in(r, out);\n        }\n        Kind::Not(base) => calls_in(base, out),\n        Kind::Arith { lhs, rhs, .. }\n        | Kind::Compare { lhs, rhs, .. }\n        | Kind::Logic { lhs, rhs, .. } => {\n            calls_in(lhs, out);\n            calls_in(rhs, out);\n        }\n        Kind::Bind { value, body, .. }\n        | Kind::Map {\n            source: value,\n            body,\n            ..\n        }\n        | Kind::OptMap {\n            source: value,\n            body,\n            ..\n        } => {\n            calls_in(value, out);\n            calls_in(body, out);\n        }\n        Kind::Select { source, pred, .. } => {\n            calls_in(source, out);\n            calls_in(pred, out);\n        }\n        Kind::Field { base, .. } | Kind::Unwrap { base } => calls_in(base, out),\n        Kind::Builtin { arg, .. } => calls_in(arg, out),\n        Kind::Index { base, index, .. } => {\n            calls_in(base, out);\n            calls_in(index, out);\n        }\n        Kind::Slice { base, start, end, .. } => {\n            calls_in(base, out);\n            if let Some(s) = start {\n                calls_in(s, out);\n            }\n            if let Some(e) = end {\n                calls_in(e, out);\n            }\n        }\n        Kind::Match { subject, arms, .. } => {\n            calls_in(subject, out);\n            for a in arms {\n                if let Some(g) = &a.guard {\n                    calls_in(g, out);\n                }\n                calls_in(&a.body, out);\n            }\n        }\n    }\n}","lineStart":1,"lineEnd":328,"totalLines":328,"truncated":false}},"title":"src/check/linearity.rs","time":{"start":1788464717358,"end":1788464717362}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Good. flatten is fine with a catch-all unreachable. SortBy can't be stream-typed so it never reaches flatten. \n\nNow let me look at the `each_node` and `stream_uses`/`any_node` in linearity.rs to see if they're exhaustive over Kind (they might need new arms for SortBy/MaxBy. Let me check.","format":"unknown","index":0}]}},"id":"prt_068cdde2c001x38QzDzBDxhw2I","sessionID":"ses_f97363172ffe9X2xJ1KPM1b5DB","messageID":"msg_068cdd753001xSvzrFmvcZAS4d"}}
