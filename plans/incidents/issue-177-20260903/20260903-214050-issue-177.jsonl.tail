{"type":"tool_use","timestamp":1788464479021,"sessionID":"ses_f97363172ffe9X2xJ1KPM1b5DB","part":{"type":"tool","tool":"read","callID":"call_d9ac9c9323e946a89dccc23c","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-177/src/ast.rs"},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-177/src/ast.rs</path>\n<type>file</type>\n<content>\n1: #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n2: pub struct Span {\n3:     pub start: usize,\n4:     pub end: usize,\n5: }\n6: \n7: impl Span {\n8:     pub fn new(start: usize, end: usize) -> Self {\n9:         Span { start, end }\n10:     }\n11: \n12:     pub fn to(self, other: Span) -> Span {\n13:         Span::new(self.start, other.end)\n14:     }\n15: }\n16: \n17: #[derive(Debug, Clone, Copy, PartialEq)]\n18: pub enum BinOp {\n19:     Add,\n20:     Sub,\n21:     Mul,\n22:     Div,\n23:     Rem,\n24:     Eq,\n25:     Ne,\n26:     Lt,\n27:     Le,\n28:     Gt,\n29:     Ge,\n30: }\n31: \n32: impl BinOp {\n33:     pub fn is_comparison(self) -> bool {\n34:         matches!(\n35:             self,\n36:             BinOp::Eq | BinOp::Ne | BinOp::Lt | BinOp::Le | BinOp::Gt | BinOp::Ge\n37:         )\n38:     }\n39: \n40:     /// True for the operators that only ever mean arithmetic. `+` is missing because it also\n41:     /// concatenates, which is the one place an operator's meaning depends on its operands.\n42:     pub fn is_arithmetic(self) -> bool {\n43:         matches!(self, BinOp::Sub | BinOp::Mul | BinOp::Div | BinOp::Rem)\n44:     }\n45: }\n46: \n47: impl std::fmt::Display for BinOp {\n48:     fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n49:         let s = match self {\n50:             BinOp::Add => \"+\",\n51:             BinOp::Sub => \"-\",\n52:             BinOp::Mul => \"*\",\n53:             BinOp::Div => \"/\",\n54:             BinOp::Rem => \"%\",\n55:             BinOp::Eq => \"==\",\n56:             BinOp::Ne => \"!=\",\n57:             BinOp::Lt => \"<\",\n58:             BinOp::Le => \"<=\",\n59:             BinOp::Gt => \">\",\n60:             BinOp::Ge => \">=\",\n61:         };\n62:         write!(f, \"{s}\")\n63:     }\n64: }\n65: \n66: /// The two Bool connectives. Kept out of `BinOp` because they share none of its rules: their\n67: /// operands are Bool rather than a matched pair of anything, and they are the only operators\n68: /// that may leave their right side unevaluated.\n69: #[derive(Debug, Clone, Copy, PartialEq)]\n70: pub enum LogicOp {\n71:     And,\n72:     Or,\n73: }\n74: \n75: impl std::fmt::Display for LogicOp {\n76:     fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n77:         let s = match self {\n78:             LogicOp::And => \"and\",\n79:             LogicOp::Or => \"or\",\n80:         };\n81:         write!(f, \"{s}\")\n82:     }\n83: }\n84: \n85: /// A type as written in source, before it is resolved to a `Type`.\n86: #[derive(Debug)]\n87: pub enum TypeExpr {\n88:     Named {\n89:         name: String,\n90:         /// `Pair<Int>`: the arguments a declared generic enum is applied to. Empty for a\n91:         /// plain name. `Vec`/`Stream` keep their own variants below.\n92:         args: Vec<TypeExpr>,\n93:         span: Span,\n94:     },\n95:     Vec {\n96:         elem: Box<TypeExpr>,\n97:         span: Span,\n98:     },\n99:     /// `Stream<T>`, legal only as the whole of a parameter or return annotation: a stream is\n100:     /// not a value, so the checker refuses it anywhere a type would describe something stored.\n101:     Stream {\n102:         elem: Box<TypeExpr>,\n103:         span: Span,\n104:     },\n105:     Record {\n106:         fields: Vec<(String, TypeExpr)>,\n107:         span: Span,\n108:     },\n109: }\n110: \n111: impl TypeExpr {\n112:     pub fn span(&self) -> Span {\n113:         match self {\n114:             TypeExpr::Named { span, .. }\n115:             | TypeExpr::Vec { span, .. }\n116:             | TypeExpr::Stream { span, .. }\n117:             | TypeExpr::Record { span, .. } => *span,\n118:         }\n119:     }\n120: }\n121: \n122: #[derive(Debug)]\n123: pub struct Param {\n124:     pub name: String,\n125:     pub ty: TypeExpr,\n126:     pub span: Span,\n127: }\n128: \n129: /// Which source file a definition came from. Only two exist today: the program's own file and\n130: /// the single prelude module. A non-`pub` definition is callable only from its own file, so\n131: /// this is what the checker keys visibility on at each call site (gh:166).\n132: #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n133: pub enum Origin {\n134:     /// The program's own file.\n135:     Program,\n136:     /// The prelude module, `prelude.toy`.\n137:     Prelude,\n138: }\n139: \n140: #[derive(Debug)]\n141: pub struct Def {\n142:     pub name: String,\n143:     /// `None` for a nullary function (`fn name() -> T = body`).\n144:     pub param: Option<Param>,\n145:     pub ret: TypeExpr,\n146:     pub body: Expr,\n147:     pub span: Span,\n148:     /// Whether a module's prelude includes this definition when compiling a program. Meaningless\n149:     /// outside a module today, since nothing yet imports from a program file.\n150:     pub is_pub: bool,\n151:     /// The file this definition was written in. A program's own definitions get `Program` from\n152:     /// the parser; the prelude's get `Prelude` from `prelude::module`.\n153:     pub origin: Origin,\n154: }\n155: \n156: /// `enum Shape { point, circle{r: Int} }`. The first declaration that creates a type identity\n157: /// rather than abbreviating one: the name is what exhaustiveness will be proved against.\n158: #[derive(Debug)]\n159: pub struct EnumDecl {\n160:     pub name: String,\n161:     /// Type parameters, in declaration order: `enum Opt<T> { ... }`. Capitalized names,\n162:     /// bound only inside this declaration's payloads.\n163:     pub params: Vec<(String, Span)>,\n164:     pub variants: Vec<Variant>,\n165:     pub span: Span,\n166:     /// Same meaning as `Def::is_pub`: whether a module exports this declaration.\n167:     pub is_pub: bool,\n168: }\n169: \n170: /// One alternative of an enum. Variant names are data (they appear as JSON keys and strings),\n171: /// so they are exempt from the capital-means-type casing rule, like record fields.\n172: #[derive(Debug)]\n173: pub struct Variant {\n174:     pub name: String,\n175:     pub span: Span,\n176:     /// `None` for a unit variant. Any single type, spelled the way a call spells its argument:\n177:     /// a record type directly in braces (`circle{r: Int}`), any type in parens (`celsius(Int)`).\n178:     pub payload: Option<TypeExpr>,\n179: }\n180: \n181: /// `trait Name { fn sig(param: Type) -> Type }`:a named collection of method signatures,\n182: /// with no bodies. The receiver type is spelled `Self` in a signature, and binds to whatever\n183: /// concrete type an `impl` block targets. Parsed only for now: checking and dispatch are later\n184: /// slices.\n185: #[derive(Debug)]\n186: pub struct TraitDecl {\n187:     pub name: String,\n188:     /// The method signatures, in declaration order.\n189:     pub methods: Vec<TraitMethodSig>,\n190:     pub span: Span,\n191:     /// Same meaning as `Def::is_pub`: whether a module exports this declaration.\n192:     pub is_pub: bool,\n193: }\n194: \n195: /// One method signature of a trait declaration:the same `fn name(param: Type) -> Type`\n196: /// spine a function uses, minus the body an `impl` provides.\n197: #[derive(Debug)]\n198: pub struct TraitMethodSig {\n199:     pub name: String,\n200:     /// `None` for a nullary method (`fn name() -> T`).\n201:     pub param: Option<Param>,\n202:     pub ret: TypeExpr,\n203:     pub span: Span,\n204: }\n205: \n206: /// `impl Trait for Type { fn sig(param: Type) -> Type = body }`: concrete bodies for one\n207: /// trait's methods, one block per (trait, type) pair. Parsed only for now:the checker does\n208: /// not use this yet.\n209: #[derive(Debug)]\n210: pub struct ImplDecl {\n211:     pub trait_name: String,\n212:     /// The concrete type the trait's `Self` substitutes to.\n213:     pub ty: TypeExpr,\n214:     /// The method bodies, each against the trait's signature of the same name.\n215:     pub methods: Vec<ImplMethod>,\n216:     pub span: Span,\n217: }\n218: /// One method of an impl block:the same spine a trait signature has, plus the body that makes\n219: /// it a definition.\n220: \n221: #[derive(Debug)]\n222: pub struct ImplMethod {\n223:     pub name: String,\n224:     pub param: Option<Param>,\n225:     pub ret: TypeExpr,\n226:     pub body: Expr,\n227:     pub span: Span,\n228: }\n229: \n230: /// Zero or more definitions followed by the expression that is the program.\n231: #[derive(Debug)]\n232: pub struct File {\n233:     /// `type Db = {users: Vec<User>}`. An abbreviation and nothing more: the name and what it\n234:     /// stands for are one type, so nothing distinguishes them once resolved.\n235:     pub aliases: Vec<Alias>,\n236:     pub enums: Vec<EnumDecl>,\n237:     /// `trait Name { ... }`:a named collection of method signatures. Parsed only for now.\n238:     pub traits: Vec<TraitDecl>,\n239:     /// `impl Trait for Type { ... }`: concrete bodies for one trait's methods. Parsed only for now.\n240:     pub impls: Vec<ImplDecl>,\n241:     pub defs: Vec<Def>,\n242:     /// `input <type>`: a declaration of what stdin holds, written after the definitions and\n243:     /// before the body, the way a signature types a parameter. `None` when the program leaves\n244:     /// the input untyped, in which case the first use of `input` in the body types it.\n245:     pub input: Option<TypeExpr>,\n246:     pub body: Expr,\n247: }\n248: \n249: /// What a module file holds: declarations only, no trailing expression.\n250: #[derive(Debug)]\n251: pub struct Module {\n252:     pub defs: Vec<Def>,\n253:     pub enums: Vec<EnumDecl>,\n254: }\n255: \n256: #[derive(Debug)]\n257: pub struct Alias {\n258:     pub name: String,\n259:     pub ty: TypeExpr,\n260:     pub span: Span,\n261: }\n262: \n263: #[derive(Debug)]\n264: pub enum Expr {\n265:     Str {\n266:         text: String,\n267:         span: Span,\n268:     },\n269:     Int {\n270:         value: i64,\n271:         span: Span,\n272:     },\n273:     /// A decimal-point literal (ADR 0007): an IEEE 754 binary64 double, the same\n274:     /// representation every JavaScript engine carries. The dot is what makes a number a Float,\n275:     /// and there is no alternative width or decimal type to guess at.\n276:     Float {\n277:         value: f64,\n278:         span: Span,\n279:     },\n280:     VecLit {\n281:         items: Vec<Expr>,\n282:         span: Span,\n283:     },\n284:     /// `{name: expr, age: expr}`. A record literal, the inverse of a projection. Each field\n285:     /// keeps its own span so a repeated one can be pointed at rather than described.\n286:     RecordLit {\n287:         fields: Vec<(String, Span, Expr)>,\n288:         span: Span,\n289:     },\n290:     /// `.`, the value the enclosing pipeline or filter is currently working on.\n291:     Subject {\n292:         span: Span,\n293:     },\n294:     Var {\n295:         name: String,\n296:         span: Span,\n297:     },\n298:     Call {\n299:         func: String,\n300:         func_span: Span,\n301:         /// `None` for a nullary call (`name()`).\n302:         arg: Option<Box<Expr>>,\n303:         span: Span,\n304:     },\n305:     /// `base[]`. A spec that keeps a dimension.\n306:     Project {\n307:         base: Box<Expr>,\n308:         span: Span,\n309:     },\n310:     /// `base[i]`. A spec that collapses a dimension, so the entry may not be there.\n311:     Index {\n312:         base: Box<Expr>,\n313:         index: Box<Expr>,\n314:         span: Span,\n315:     },\n316:     /// `base[lo:hi]`, bounds optional. A spec that narrows a dimension by position, jq's\n317:     /// `.[2:5]`; out-of-range bounds clamp to the valid range rather than answering `Opt` the\n318:     /// way a collapsing index does (kantord/toylang#143).\n319:     Slice {\n320:         base: Box<Expr>,\n321:         start: Option<Box<Expr>>,\n322:         end: Option<Box<Expr>>,\n323:         span: Span,\n324:     },\n325:     /// `base!`. Insist the value is there, and stop the program if it is not.\n326:     Unwrap {\n327:         base: Box<Expr>,\n328:         span: Span,\n329:     },\n330:     /// `-base`.\n331:     Neg {\n332:         base: Box<Expr>,\n333:         span: Span,\n334:     },\n335:     /// `not base`. Looser than every comparison, so `not a == b` negates the comparison, and\n336:     /// tighter than `and`/`or`, so `not a and b` negates only `a`.\n337:     Not {\n338:         base: Box<Expr>,\n339:         span: Span,\n340:     },\n341:     /// `base.name`. Distributes over a Vec rather than needing a map.\n342:     Field {\n343:         base: Box<Expr>,\n344:         name: String,\n345:         span: Span,\n346:     },\n347:     /// The value read from stdin. It has no type of its own and can only be checked against an\n348:     /// expected one, which is the same rule the draft gives for lambdas.\n349:     Input {\n350:         span: Span,\n351:     },\n352:     /// Every remaining JSON value on stdin, one per line, collected eagerly into a `Vec<T>`.\n353:     /// Like `input`, its element type comes only from where it is used.\n354:     Inputs {\n355:         span: Span,\n356:     },\n357:     /// The stream of lines read from stdin, born `Stream<Str>`. The checker rejects a second\n358:     /// use rather than accepting a second stream, since there is only ever one real stdin.\n359:     Lines {\n360:         span: Span,\n361:     },\n362:     /// Stdin read as raw lines, each split on a delimiter, born `Vec<Vec<Str>>`: the\n363:     /// parameterized DSV source. `csv` and `tsv` are the same node with the delimiter fixed.\n364:     Dsv {\n365:         delim: String,\n366:         span: Span,\n367:     },\n368:     /// An `or` chain of match arms over the subject `.`: `point -> 0 or circle{r} -> r * r`.\n369:     /// The subject is not part of the node; a match reads `.` the way `select` does, so it\n370:     /// appears as a pipe stage.\n371:     Match {\n372:         arms: Vec<MatchArm>,\n373:         span: Span,\n374:     },\n375:     /// `Shape.circle` or `Shape.circle{r: 1}`: a variant constructor spelled through its enum.\n376:     /// Only the qualified form needs its own node; a bare `circle{r: 1}` is an ordinary `Call`\n377:     /// and a bare `active` an ordinary `Var`, resolved through the enum registry by the checker.\n378:     Variant {\n379:         enum_name: String,\n380:         enum_span: Span,\n381:         variant: String,\n382:         variant_span: Span,\n383:         payload: Option<Box<Expr>>,\n384:         span: Span,\n385:     },\n386:     /// `lhs | rhs`, which binds `.` in `rhs` to the value of `lhs`.\n387:     Pipe {\n388:         lhs: Box<Expr>,\n389:         rhs: Box<Expr>,\n390:         span: Span,\n391:     },\n392:     /// `lhs |> callee`, the tail-pipeline marker: the one way a sink call is written, `callee`\n393:     /// applied to `lhs`. Only a Sink-typed callee is legal here, and the production is parsed\n394:     /// only at a program's outermost position, so this node never appears nested.\n395:     TailPipe {\n396:         lhs: Box<Expr>,\n397:         callee: String,\n398:         callee_span: Span,\n399:         span: Span,\n400:     },\n401:     Binary {\n402:         op: BinOp,\n403:         lhs: Box<Expr>,\n404:         rhs: Box<Expr>,\n405:         span: Span,\n406:     },\n407:     /// `lhs and rhs`, `lhs or rhs`. A separate node from `Binary` for the same reason `LogicOp`\n408:     /// is a separate enum: nothing about how these are typed or evaluated follows `Binary`'s\n409:     /// rules.\n410:     Logic {\n411:         op: LogicOp,\n412:         lhs: Box<Expr>,\n413:         rhs: Box<Expr>,\n414:         span: Span,\n415:     },\n416:     /// `let <name> = <expr>` on its own line, repeated, then the expression that ends the block\n417:     /// -- the local-binding form the ruling on #87 picked over `let ... in`: no keyword to pair,\n418:     /// just a sequence of bindings followed by a result. Only reachable as a function body.\n419:     Let {\n420:         bindings: Vec<(String, Expr)>,\n421:         body: Box<Expr>,\n422:         span: Span,\n423:     },\n424: }\n425: \n426: #[derive(Debug)]\n427: pub struct MatchArm {\n428:     pub pattern: Pattern,\n429:     pub body: Expr,\n430:     pub span: Span,\n431: }\n432: \n433: #[derive(Debug)]\n434: pub enum Pattern {\n435:     /// A variant name, optionally destructuring its payload's fields. Bare names inside the\n436:     /// braces bind fresh, and `rest` is the `..` marker that permits naming only some of them.\n437:     Variant {\n438:         name: String,\n439:         span: Span,\n440:         fields: Option<FieldsPattern>,\n441:     },\n442:     /// A Bool guard: the arm matches when the expression is true. `.` inside it (and inside\n443:     /// the arm's body) is still the chain's subject, unlike a variant arm, which rebinds it.\n444:     Guard(Expr),\n445:     /// The default arm: `any()`, or the bare trailing expression the parser desugars into one\n446:     /// (its body doubles as its span). Matches whatever is left.\n447:     Default { span: Span },\n448: }\n449: \n450: impl Pattern {\n451:     pub fn span(&self) -> Span {\n452:         match self {\n453:             Pattern::Variant { span, .. } | Pattern::Default { span } => *span,\n454:             Pattern::Guard(e) => e.span(),\n455:         }\n456:     }\n457: }\n458: \n459: #[derive(Debug)]\n460: pub struct FieldsPattern {\n461:     pub names: Vec<(String, Span)>,\n462:     pub rest: bool,\n463:     pub span: Span,\n464: }\n465: \n466: impl Expr {\n467:     pub fn span(&self) -> Span {\n468:         match self {\n469:             Expr::Str { span, .. }\n470:             | Expr::Int { span, .. }\n471:             | Expr::Float { span, .. }\n472:             | Expr::VecLit { span, .. }\n473:             | Expr::Subject { span }\n474:             | Expr::Var { span, .. }\n475:             | Expr::Call { span, .. }\n476:             | Expr::Project { span, .. }\n477:             | Expr::Index { span, .. }\n478:             | Expr::Slice { span, .. }\n479:             | Expr::Unwrap { span, .. }\n480:             | Expr::RecordLit { span, .. }\n481:             | Expr::Neg { span, .. }\n482:             | Expr::Not { span, .. }\n483:             | Expr::Field { span, .. }\n484:             | Expr::Input { span }\n485:             | Expr::Inputs { span }\n486:             | Expr::Lines { span }\n487:             | Expr::Dsv { span, .. }\n488:             | Expr::Variant { span, .. }\n489:             | Expr::Match { span, .. }\n490:             | Expr::Pipe { span, .. }\n491:             | Expr::TailPipe { span, .. }\n492:             | Expr::Binary { span, .. }\n493:             | Expr::Logic { span, .. }\n494:             | Expr::Let { span, .. } => *span,\n495:         }\n496:     }\n497: }\n\n(End of file - total 497 lines)\n</content>","metadata":{"preview":"#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\npub struct Span {\n    pub start: usize,\n    pub end: usize,\n}\n\nimpl Span {\n    pub fn new(start: usize, end: usize) -> Self {\n        Span { start, end }\n    }\n\n    pub fn to(self, other: Span) -> Span {\n        Span::new(self.start, other.end)\n    }\n}\n\n#[derive(Debug, Clone, Copy, PartialEq)]\npub enum BinOp {\n    Add,\n    Sub,","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-177/src/ast.rs","text":"#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\npub struct Span {\n    pub start: usize,\n    pub end: usize,\n}\n\nimpl Span {\n    pub fn new(start: usize, end: usize) -> Self {\n        Span { start, end }\n    }\n\n    pub fn to(self, other: Span) -> Span {\n        Span::new(self.start, other.end)\n    }\n}\n\n#[derive(Debug, Clone, Copy, PartialEq)]\npub enum BinOp {\n    Add,\n    Sub,\n    Mul,\n    Div,\n    Rem,\n    Eq,\n    Ne,\n    Lt,\n    Le,\n    Gt,\n    Ge,\n}\n\nimpl BinOp {\n    pub fn is_comparison(self) -> bool {\n        matches!(\n            self,\n            BinOp::Eq | BinOp::Ne | BinOp::Lt | BinOp::Le | BinOp::Gt | BinOp::Ge\n        )\n    }\n\n    /// True for the operators that only ever mean arithmetic. `+` is missing because it also\n    /// concatenates, which is the one place an operator's meaning depends on its operands.\n    pub fn is_arithmetic(self) -> bool {\n        matches!(self, BinOp::Sub | BinOp::Mul | BinOp::Div | BinOp::Rem)\n    }\n}\n\nimpl std::fmt::Display for BinOp {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        let s = match self {\n            BinOp::Add => \"+\",\n            BinOp::Sub => \"-\",\n            BinOp::Mul => \"*\",\n            BinOp::Div => \"/\",\n            BinOp::Rem => \"%\",\n            BinOp::Eq => \"==\",\n            BinOp::Ne => \"!=\",\n            BinOp::Lt => \"<\",\n            BinOp::Le => \"<=\",\n            BinOp::Gt => \">\",\n            BinOp::Ge => \">=\",\n        };\n        write!(f, \"{s}\")\n    }\n}\n\n/// The two Bool connectives. Kept out of `BinOp` because they share none of its rules: their\n/// operands are Bool rather than a matched pair of anything, and they are the only operators\n/// that may leave their right side unevaluated.\n#[derive(Debug, Clone, Copy, PartialEq)]\npub enum LogicOp {\n    And,\n    Or,\n}\n\nimpl std::fmt::Display for LogicOp {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        let s = match self {\n            LogicOp::And => \"and\",\n            LogicOp::Or => \"or\",\n        };\n        write!(f, \"{s}\")\n    }\n}\n\n/// A type as written in source, before it is resolved to a `Type`.\n#[derive(Debug)]\npub enum TypeExpr {\n    Named {\n        name: String,\n        /// `Pair<Int>`: the arguments a declared generic enum is applied to. Empty for a\n        /// plain name. `Vec`/`Stream` keep their own variants below.\n        args: Vec<TypeExpr>,\n        span: Span,\n    },\n    Vec {\n        elem: Box<TypeExpr>,\n        span: Span,\n    },\n    /// `Stream<T>`, legal only as the whole of a parameter or return annotation: a stream is\n    /// not a value, so the checker refuses it anywhere a type would describe something stored.\n    Stream {\n        elem: Box<TypeExpr>,\n        span: Span,\n    },\n    Record {\n        fields: Vec<(String, TypeExpr)>,\n        span: Span,\n    },\n}\n\nimpl TypeExpr {\n    pub fn span(&self) -> Span {\n        match self {\n            TypeExpr::Named { span, .. }\n            | TypeExpr::Vec { span, .. }\n            | TypeExpr::Stream { span, .. }\n            | TypeExpr::Record { span, .. } => *span,\n        }\n    }\n}\n\n#[derive(Debug)]\npub struct Param {\n    pub name: String,\n    pub ty: TypeExpr,\n    pub span: Span,\n}\n\n/// Which source file a definition came from. Only two exist today: the program's own file and\n/// the single prelude module. A non-`pub` definition is callable only from its own file, so\n/// this is what the checker keys visibility on at each call site (gh:166).\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\npub enum Origin {\n    /// The program's own file.\n    Program,\n    /// The prelude module, `prelude.toy`.\n    Prelude,\n}\n\n#[derive(Debug)]\npub struct Def {\n    pub name: String,\n    /// `None` for a nullary function (`fn name() -> T = body`).\n    pub param: Option<Param>,\n    pub ret: TypeExpr,\n    pub body: Expr,\n    pub span: Span,\n    /// Whether a module's prelude includes this definition when compiling a program. Meaningless\n    /// outside a module today, since nothing yet imports from a program file.\n    pub is_pub: bool,\n    /// The file this definition was written in. A program's own definitions get `Program` from\n    /// the parser; the prelude's get `Prelude` from `prelude::module`.\n    pub origin: Origin,\n}\n\n/// `enum Shape { point, circle{r: Int} }`. The first declaration that creates a type identity\n/// rather than abbreviating one: the name is what exhaustiveness will be proved against.\n#[derive(Debug)]\npub struct EnumDecl {\n    pub name: String,\n    /// Type parameters, in declaration order: `enum Opt<T> { ... }`. Capitalized names,\n    /// bound only inside this declaration's payloads.\n    pub params: Vec<(String, Span)>,\n    pub variants: Vec<Variant>,\n    pub span: Span,\n    /// Same meaning as `Def::is_pub`: whether a module exports this declaration.\n    pub is_pub: bool,\n}\n\n/// One alternative of an enum. Variant names are data (they appear as JSON keys and strings),\n/// so they are exempt from the capital-means-type casing rule, like record fields.\n#[derive(Debug)]\npub struct Variant {\n    pub name: String,\n    pub span: Span,\n    /// `None` for a unit variant. Any single type, spelled the way a call spells its argument:\n    /// a record type directly in braces (`circle{r: Int}`), any type in parens (`celsius(Int)`).\n    pub payload: Option<TypeExpr>,\n}\n\n/// `trait Name { fn sig(param: Type) -> Type }`:a named collection of method signatures,\n/// with no bodies. The receiver type is spelled `Self` in a signature, and binds to whatever\n/// concrete type an `impl` block targets. Parsed only for now: checking and dispatch are later\n/// slices.\n#[derive(Debug)]\npub struct TraitDecl {\n    pub name: String,\n    /// The method signatures, in declaration order.\n    pub methods: Vec<TraitMethodSig>,\n    pub span: Span,\n    /// Same meaning as `Def::is_pub`: whether a module exports this declaration.\n    pub is_pub: bool,\n}\n\n/// One method signature of a trait declaration:the same `fn name(param: Type) -> Type`\n/// spine a function uses, minus the body an `impl` provides.\n#[derive(Debug)]\npub struct TraitMethodSig {\n    pub name: String,\n    /// `None` for a nullary method (`fn name() -> T`).\n    pub param: Option<Param>,\n    pub ret: TypeExpr,\n    pub span: Span,\n}\n\n/// `impl Trait for Type { fn sig(param: Type) -> Type = body }`: concrete bodies for one\n/// trait's methods, one block per (trait, type) pair. Parsed only for now:the checker does\n/// not use this yet.\n#[derive(Debug)]\npub struct ImplDecl {\n    pub trait_name: String,\n    /// The concrete type the trait's `Self` substitutes to.\n    pub ty: TypeExpr,\n    /// The method bodies, each against the trait's signature of the same name.\n    pub methods: Vec<ImplMethod>,\n    pub span: Span,\n}\n/// One method of an impl block:the same spine a trait signature has, plus the body that makes\n/// it a definition.\n\n#[derive(Debug)]\npub struct ImplMethod {\n    pub name: String,\n    pub param: Option<Param>,\n    pub ret: TypeExpr,\n    pub body: Expr,\n    pub span: Span,\n}\n\n/// Zero or more definitions followed by the expression that is the program.\n#[derive(Debug)]\npub struct File {\n    /// `type Db = {users: Vec<User>}`. An abbreviation and nothing more: the name and what it\n    /// stands for are one type, so nothing distinguishes them once resolved.\n    pub aliases: Vec<Alias>,\n    pub enums: Vec<EnumDecl>,\n    /// `trait Name { ... }`:a named collection of method signatures. Parsed only for now.\n    pub traits: Vec<TraitDecl>,\n    /// `impl Trait for Type { ... }`: concrete bodies for one trait's methods. Parsed only for now.\n    pub impls: Vec<ImplDecl>,\n    pub defs: Vec<Def>,\n    /// `input <type>`: a declaration of what stdin holds, written after the definitions and\n    /// before the body, the way a signature types a parameter. `None` when the program leaves\n    /// the input untyped, in which case the first use of `input` in the body types it.\n    pub input: Option<TypeExpr>,\n    pub body: Expr,\n}\n\n/// What a module file holds: declarations only, no trailing expression.\n#[derive(Debug)]\npub struct Module {\n    pub defs: Vec<Def>,\n    pub enums: Vec<EnumDecl>,\n}\n\n#[derive(Debug)]\npub struct Alias {\n    pub name: String,\n    pub ty: TypeExpr,\n    pub span: Span,\n}\n\n#[derive(Debug)]\npub enum Expr {\n    Str {\n        text: String,\n        span: Span,\n    },\n    Int {\n        value: i64,\n        span: Span,\n    },\n    /// A decimal-point literal (ADR 0007): an IEEE 754 binary64 double, the same\n    /// representation every JavaScript engine carries. The dot is what makes a number a Float,\n    /// and there is no alternative width or decimal type to guess at.\n    Float {\n        value: f64,\n        span: Span,\n    },\n    VecLit {\n        items: Vec<Expr>,\n        span: Span,\n    },\n    /// `{name: expr, age: expr}`. A record literal, the inverse of a projection. Each field\n    /// keeps its own span so a repeated one can be pointed at rather than described.\n    RecordLit {\n        fields: Vec<(String, Span, Expr)>,\n        span: Span,\n    },\n    /// `.`, the value the enclosing pipeline or filter is currently working on.\n    Subject {\n        span: Span,\n    },\n    Var {\n        name: String,\n        span: Span,\n    },\n    Call {\n        func: String,\n        func_span: Span,\n        /// `None` for a nullary call (`name()`).\n        arg: Option<Box<Expr>>,\n        span: Span,\n    },\n    /// `base[]`. A spec that keeps a dimension.\n    Project {\n        base: Box<Expr>,\n        span: Span,\n    },\n    /// `base[i]`. A spec that collapses a dimension, so the entry may not be there.\n    Index {\n        base: Box<Expr>,\n        index: Box<Expr>,\n        span: Span,\n    },\n    /// `base[lo:hi]`, bounds optional. A spec that narrows a dimension by position, jq's\n    /// `.[2:5]`; out-of-range bounds clamp to the valid range rather than answering `Opt` the\n    /// way a collapsing index does (kantord/toylang#143).\n    Slice {\n        base: Box<Expr>,\n        start: Option<Box<Expr>>,\n        end: Option<Box<Expr>>,\n        span: Span,\n    },\n    /// `base!`. Insist the value is there, and stop the program if it is not.\n    Unwrap {\n        base: Box<Expr>,\n        span: Span,\n    },\n    /// `-base`.\n    Neg {\n        base: Box<Expr>,\n        span: Span,\n    },\n    /// `not base`. Looser than every comparison, so `not a == b` negates the comparison, and\n    /// tighter than `and`/`or`, so `not a and b` negates only `a`.\n    Not {\n        base: Box<Expr>,\n        span: Span,\n    },\n    /// `base.name`. Distributes over a Vec rather than needing a map.\n    Field {\n        base: Box<Expr>,\n        name: String,\n        span: Span,\n    },\n    /// The value read from stdin. It has no type of its own and can only be checked against an\n    /// expected one, which is the same rule the draft gives for lambdas.\n    Input {\n        span: Span,\n    },\n    /// Every remaining JSON value on stdin, one per line, collected eagerly into a `Vec<T>`.\n    /// Like `input`, its element type comes only from where it is used.\n    Inputs {\n        span: Span,\n    },\n    /// The stream of lines read from stdin, born `Stream<Str>`. The checker rejects a second\n    /// use rather than accepting a second stream, since there is only ever one real stdin.\n    Lines {\n        span: Span,\n    },\n    /// Stdin read as raw lines, each split on a delimiter, born `Vec<Vec<Str>>`: the\n    /// parameterized DSV source. `csv` and `tsv` are the same node with the delimiter fixed.\n    Dsv {\n        delim: String,\n        span: Span,\n    },\n    /// An `or` chain of match arms over the subject `.`: `point -> 0 or circle{r} -> r * r`.\n    /// The subject is not part of the node; a match reads `.` the way `select` does, so it\n    /// appears as a pipe stage.\n    Match {\n        arms: Vec<MatchArm>,\n        span: Span,\n    },\n    /// `Shape.circle` or `Shape.circle{r: 1}`: a variant constructor spelled through its enum.\n    /// Only the qualified form needs its own node; a bare `circle{r: 1}` is an ordinary `Call`\n    /// and a bare `active` an ordinary `Var`, resolved through the enum registry by the checker.\n    Variant {\n        enum_name: String,\n        enum_span: Span,\n        variant: String,\n        variant_span: Span,\n        payload: Option<Box<Expr>>,\n        span: Span,\n    },\n    /// `lhs | rhs`, which binds `.` in `rhs` to the value of `lhs`.\n    Pipe {\n        lhs: Box<Expr>,\n        rhs: Box<Expr>,\n        span: Span,\n    },\n    /// `lhs |> callee`, the tail-pipeline marker: the one way a sink call is written, `callee`\n    /// applied to `lhs`. Only a Sink-typed callee is legal here, and the production is parsed\n    /// only at a program's outermost position, so this node never appears nested.\n    TailPipe {\n        lhs: Box<Expr>,\n        callee: String,\n        callee_span: Span,\n        span: Span,\n    },\n    Binary {\n        op: BinOp,\n        lhs: Box<Expr>,\n        rhs: Box<Expr>,\n        span: Span,\n    },\n    /// `lhs and rhs`, `lhs or rhs`. A separate node from `Binary` for the same reason `LogicOp`\n    /// is a separate enum: nothing about how these are typed or evaluated follows `Binary`'s\n    /// rules.\n    Logic {\n        op: LogicOp,\n        lhs: Box<Expr>,\n        rhs: Box<Expr>,\n        span: Span,\n    },\n    /// `let <name> = <expr>` on its own line, repeated, then the expression that ends the block\n    /// -- the local-binding form the ruling on #87 picked over `let ... in`: no keyword to pair,\n    /// just a sequence of bindings followed by a result. Only reachable as a function body.\n    Let {\n        bindings: Vec<(String, Expr)>,\n        body: Box<Expr>,\n        span: Span,\n    },\n}\n\n#[derive(Debug)]\npub struct MatchArm {\n    pub pattern: Pattern,\n    pub body: Expr,\n    pub span: Span,\n}\n\n#[derive(Debug)]\npub enum Pattern {\n    /// A variant name, optionally destructuring its payload's fields. Bare names inside the\n    /// braces bind fresh, and `rest` is the `..` marker that permits naming only some of them.\n    Variant {\n        name: String,\n        span: Span,\n        fields: Option<FieldsPattern>,\n    },\n    /// A Bool guard: the arm matches when the expression is true. `.` inside it (and inside\n    /// the arm's body) is still the chain's subject, unlike a variant arm, which rebinds it.\n    Guard(Expr),\n    /// The default arm: `any()`, or the bare trailing expression the parser desugars into one\n    /// (its body doubles as its span). Matches whatever is left.\n    Default { span: Span },\n}\n\nimpl Pattern {\n    pub fn span(&self) -> Span {\n        match self {\n            Pattern::Variant { span, .. } | Pattern::Default { span } => *span,\n            Pattern::Guard(e) => e.span(),\n        }\n    }\n}\n\n#[derive(Debug)]\npub struct FieldsPattern {\n    pub names: Vec<(String, Span)>,\n    pub rest: bool,\n    pub span: Span,\n}\n\nimpl Expr {\n    pub fn span(&self) -> Span {\n        match self {\n            Expr::Str { span, .. }\n            | Expr::Int { span, .. }\n            | Expr::Float { span, .. }\n            | Expr::VecLit { span, .. }\n            | Expr::Subject { span }\n            | Expr::Var { span, .. }\n            | Expr::Call { span, .. }\n            | Expr::Project { span, .. }\n            | Expr::Index { span, .. }\n            | Expr::Slice { span, .. }\n            | Expr::Unwrap { span, .. }\n            | Expr::RecordLit { span, .. }\n            | Expr::Neg { span, .. }\n            | Expr::Not { span, .. }\n            | Expr::Field { span, .. }\n            | Expr::Input { span }\n            | Expr::Inputs { span }\n            | Expr::Lines { span }\n            | Expr::Dsv { span, .. }\n            | Expr::Variant { span, .. }\n            | Expr::Match { span, .. }\n            | Expr::Pipe { span, .. }\n            | Expr::TailPipe { span, .. }\n            | Expr::Binary { span, .. }\n            | Expr::Logic { span, .. }\n            | Expr::Let { span, .. } => *span,\n        }\n    }\n}","lineStart":1,"lineEnd":497,"totalLines":497,"truncated":false}},"title":"src/ast.rs","time":{"start":1788464479016,"end":1788464479019}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now I understand the map machinery. The key question for `sort_by`/`max_by`: the second argument is a projection function like `.key`. The `map(.name)` machinery rebinds `.` to the element. So `sort_by(.key)` takes two arguments: the Vec and a projection expression. The projection is checked in a mapper context where `.` is the element.\n\nLet me look at how the arguments are parsed. `sort_by(.key)` has two arguments in parens separated by comma? Let me look at the Expr AST and parsing.","format":"unknown","index":0}]}},"id":"prt_068ca3b260019z2QuuWZiHRi0o","sessionID":"ses_f97363172ffe9X2xJ1KPM1b5DB","messageID":"msg_068ca31810014Khlw02Q7F7ojQ"}}
