e.map is exactly this, so no helper is needed.\n        Kind::Map {\n            source,\n            param,\n            body,\n        } => {\n            format!(\n                \"{}.map(({}) => {})\",\n                expr(enums, source),\n                local(*param),\n                expr(enums, body)\n            )\n        }\n        Kind::Select {\n            source,\n            param,\n            pred,\n        } => {\n            format!(\n                \"tl_select({}, ({}) => {})\",\n                expr(enums, source),\n                local(*param),\n                expr(enums, pred)\n            )\n        }\n        // Opt's reorder pass (kantord/toylang#66): the tagged shape (`\"none\"` or `{some: v}`)\n        // is generic enough that this is the ordinary key-presence test every Match arm over\n        // an Opt subject would already use, just rebuilding the payload instead of a body.\n        Kind::OptMap {\n            source,\n            param,\n            body,\n        } => {\n            format!(\n                \"(__opt => __opt === \\\"none\\\" ? \\\"none\\\" : (({}) => ({{some: {}}}))(__opt.some))({})\",\n                local(*param),\n                expr(enums, body),\n                expr(enums, source)\n            )\n        }","lineStart":840,"lineEnd":959,"totalLines":1139,"truncated":true}},"title":"src/emit_js.rs","time":{"start":1788464559951,"end":1788464559963}},"id":"prt_068cb774d001TMZfwGLFWOTXZQ","sessionID":"ses_f97363172ffe9X2xJ1KPM1b5DB","messageID":"msg_068cb68aa0015F2br0J6iKR1iu"}}
