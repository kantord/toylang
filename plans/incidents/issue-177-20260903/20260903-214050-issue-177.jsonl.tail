{"type":"tool_use","timestamp":1788464715582,"sessionID":"ses_f97363172ffe9X2xJ1KPM1b5DB","part":{"type":"tool","tool":"read","callID":"call_703035fed5534080989d28bb","state":{"status":"completed","input":{"filePath":"/home/kantord/.local/share/toylang-lanes/issue-177/src/tir.rs","limit":100,"offset":419},"output":"<path>/home/kantord/.local/share/toylang-lanes/issue-177/src/tir.rs</path>\n<type>file</type>\n<content>\n419:                 Base::Var(name) if name == param => base,\n420:                 _ => unreachable!(\"a stream-returning function's chain bottoms at its parameter\"),\n421:             }\n422:         }\n423:         _ => unreachable!(\"the checker leaves no other kind stream-typed\"),\n424:     }\n425: }\n426: \n427: /// The type question `streams_inputs` used to answer by pattern match: a `jsonlines` program\n428: /// whose argument is stream-typed fuses, and one whose argument is a Vec (already collected)\n429: /// stays an ordinary value and runs eagerly, exactly as its types say.\n430: pub fn fusion(program: &Program) -> Option<Fusion<'_>> {\n431:     let Kind::Builtin {\n432:         which: Builtin::JsonLines,\n433:         arg,\n434:     } = &program.body.kind\n435:     else {\n436:         return None;\n437:     };\n438:     if !matches!(arg.ty, Type::Stream(_)) {\n439:         return None;\n440:     }\n441:     let mut stages = Vec::new();\n442:     let source = match flatten(arg, program, &mut stages) {\n443:         Base::Inputs => Source::Inputs,\n444:         Base::Lines => Source::Lines,\n445:         Base::Range(bound) => Source::Range(bound),\n446:         Base::Var(_) | Base::Local(_) => {\n447:             unreachable!(\"a program-level stream chain bottoms at its source\")\n448:         }\n449:     };\n450:     Some(Fusion { source, stages })\n451: }\n452: \n453: /// Every enum type the program prints that can hold another of its own type, deduplicated and\n454: /// in the order the walk meets them.\n455: ///\n456: /// A backend writes its printer by expanding a type inline, which is exactly what does not\n457: /// terminate on one of these. So each gets a named function the expansion can call back into\n458: /// instead, and this is the list of functions to write (kantord/toylang#94). Only what is\n459: /// printed: a program can hold a recursive value, match on it and print an Int, and a printer\n460: /// nobody calls is dead code that Go, at least, would then demand an import for.\n461: pub fn printed_recursive_enums(program: &Program) -> Vec<Type> {\n462:     let mut printed = vec![program.body.ty.clone()];\n463:     let mut collect_printed = |t: &Tir| {\n464:         if let Kind::Builtin {\n465:             which: Builtin::JsonLines,\n466:             arg,\n467:         } = &t.kind\n468:         {\n469:             printed.push(\n470:                 runtime_elem(&arg.ty)\n471:                     .expect(\"jsonlines takes a Vec or a stream\")\n472:                     .clone(),\n473:             );\n474:         }\n475:     };\n476:     for f in &program.funcs {\n477:         each_node(&f.body, &mut collect_printed);\n478:     }\n479:     each_node(&program.body, &mut collect_printed);\n480: \n481:     let mut found = Vec::new();\n482:     let mut seen = Vec::new();\n483:     for ty in &printed {\n484:         reachable_enums(&program.enums, ty, &mut seen, &mut found);\n485:     }\n486:     found.retain(|ty| crate::ty::is_recursive(&program.enums, ty));\n487:     found\n488: }\n489: \n490: /// Append every enum type nested anywhere in `ty` to `found`, descending through payloads read\n491: /// from the registry rather than off the type. `seen` is what stops a recursive one: its own\n492: /// payload leads back to a type already visited.\n493: fn reachable_enums(enums: &Enums, ty: &Type, seen: &mut Vec<Type>, found: &mut Vec<Type>) {\n494:     match ty {\n495:         Type::Vec(e) | Type::Stream(e) => reachable_enums(enums, e, seen, found),\n496:         Type::Record(fields) => {\n497:             for (_, f) in fields {\n498:                 reachable_enums(enums, f, seen, found);\n499:             }\n500:         }\n501:         Type::Enum { name, args, .. } => {\n502:             if seen.contains(ty) {\n503:                 return;\n504:             }\n505:             seen.push(ty.clone());\n506:             found.push(ty.clone());\n507:             for arg in args {\n508:                 reachable_enums(enums, arg, seen, found);\n509:             }\n510:             for (_, payload) in crate::ty::variants_of(enums, name, args) {\n511:                 if let Some(p) = payload {\n512:                     reachable_enums(enums, &p, seen, found);\n513:                 }\n514:             }\n515:         }\n516:         _ => {}\n517:     }\n518: }\n\n(Showing lines 419-518 of 612. Use offset=519 to continue.)\n</content>","metadata":{"preview":"                Base::Var(name) if name == param => base,\n                _ => unreachable!(\"a stream-returning function's chain bottoms at its parameter\"),\n            }\n        }\n        _ => unreachable!(\"the checker leaves no other kind stream-typed\"),\n    }\n}\n\n/// The type question `streams_inputs` used to answer by pattern match: a `jsonlines` program\n/// whose argument is stream-typed fuses, and one whose argument is a Vec (already collected)\n/// stays an ordinary value and runs eagerly, exactly as its types say.\npub fn fusion(program: &Program) -> Option<Fusion<'_>> {\n    let Kind::Builtin {\n        which: Builtin::JsonLines,\n        arg,\n    } = &program.body.kind\n    else {\n        return None;\n    };\n    if !matches!(arg.ty, Type::Stream(_)) {","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-177/src/tir.rs","text":"                Base::Var(name) if name == param => base,\n                _ => unreachable!(\"a stream-returning function's chain bottoms at its parameter\"),\n            }\n        }\n        _ => unreachable!(\"the checker leaves no other kind stream-typed\"),\n    }\n}\n\n/// The type question `streams_inputs` used to answer by pattern match: a `jsonlines` program\n/// whose argument is stream-typed fuses, and one whose argument is a Vec (already collected)\n/// stays an ordinary value and runs eagerly, exactly as its types say.\npub fn fusion(program: &Program) -> Option<Fusion<'_>> {\n    let Kind::Builtin {\n        which: Builtin::JsonLines,\n        arg,\n    } = &program.body.kind\n    else {\n        return None;\n    };\n    if !matches!(arg.ty, Type::Stream(_)) {\n        return None;\n    }\n    let mut stages = Vec::new();\n    let source = match flatten(arg, program, &mut stages) {\n        Base::Inputs => Source::Inputs,\n        Base::Lines => Source::Lines,\n        Base::Range(bound) => Source::Range(bound),\n        Base::Var(_) | Base::Local(_) => {\n            unreachable!(\"a program-level stream chain bottoms at its source\")\n        }\n    };\n    Some(Fusion { source, stages })\n}\n\n/// Every enum type the program prints that can hold another of its own type, deduplicated and\n/// in the order the walk meets them.\n///\n/// A backend writes its printer by expanding a type inline, which is exactly what does not\n/// terminate on one of these. So each gets a named function the expansion can call back into\n/// instead, and this is the list of functions to write (kantord/toylang#94). Only what is\n/// printed: a program can hold a recursive value, match on it and print an Int, and a printer\n/// nobody calls is dead code that Go, at least, would then demand an import for.\npub fn printed_recursive_enums(program: &Program) -> Vec<Type> {\n    let mut printed = vec![program.body.ty.clone()];\n    let mut collect_printed = |t: &Tir| {\n        if let Kind::Builtin {\n            which: Builtin::JsonLines,\n            arg,\n        } = &t.kind\n        {\n            printed.push(\n                runtime_elem(&arg.ty)\n                    .expect(\"jsonlines takes a Vec or a stream\")\n                    .clone(),\n            );\n        }\n    };\n    for f in &program.funcs {\n        each_node(&f.body, &mut collect_printed);\n    }\n    each_node(&program.body, &mut collect_printed);\n\n    let mut found = Vec::new();\n    let mut seen = Vec::new();\n    for ty in &printed {\n        reachable_enums(&program.enums, ty, &mut seen, &mut found);\n    }\n    found.retain(|ty| crate::ty::is_recursive(&program.enums, ty));\n    found\n}\n\n/// Append every enum type nested anywhere in `ty` to `found`, descending through payloads read\n/// from the registry rather than off the type. `seen` is what stops a recursive one: its own\n/// payload leads back to a type already visited.\nfn reachable_enums(enums: &Enums, ty: &Type, seen: &mut Vec<Type>, found: &mut Vec<Type>) {\n    match ty {\n        Type::Vec(e) | Type::Stream(e) => reachable_enums(enums, e, seen, found),\n        Type::Record(fields) => {\n            for (_, f) in fields {\n                reachable_enums(enums, f, seen, found);\n            }\n        }\n        Type::Enum { name, args, .. } => {\n            if seen.contains(ty) {\n                return;\n            }\n            seen.push(ty.clone());\n            found.push(ty.clone());\n            for arg in args {\n                reachable_enums(enums, arg, seen, found);\n            }\n            for (_, payload) in crate::ty::variants_of(enums, name, args) {\n                if let Some(p) = payload {\n                    reachable_enums(enums, &p, seen, found);\n                }\n            }\n        }\n        _ => {}\n    }\n}","lineStart":419,"lineEnd":518,"totalLines":612,"truncated":true}},"title":"src/tir.rs","time":{"start":1788464715577,"end":1788464715581}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"The fusion flatten is total over stream-carrying kinds. SortBy/MaxBy are Vec-only (not stream-carrying), so no new unreachable arms needed there — but the match in `flatten` is over t.kind with `unreachable!` for non-stream kinds? Let me check the rest of flatten to see if it has a catch-all. Let me read 419-460.","format":"unknown","index":0}]}},"id":"prt_068cdd7360013wcFg2rcTjcOEC","sessionID":"ses_f97363172ffe9X2xJ1KPM1b5DB","messageID":"msg_068cdcd8f001wGQlMGqZN0q3vv"}}
