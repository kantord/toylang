t(\"i is within the line\");\n193:                     field.push(c);\n194:                     i += c.len_utf8();\n195:                 }\n196:             } else if line[i..].starts_with(delim) {\n197:                 row.push(std::mem::take(&mut field));\n198:                 i += delim.len();\n199:             } else if line[i..].starts_with('\"') && field.is_empty() {\n200:                 in_quotes = true;\n201:                 i += 1;\n202:             } else {\n203:                 let c = line[i..].chars().next().expect(\"i is within the line\");\n204:                 field.push(c);\n205:                 i += c.len_utf8();\n206:             }\n207:         }\n208:         if in_quotes {\n209:             field.push('\\n');\n210:         } else {\n211:             row.push(std::mem::take(&mut field));\n212:             rows.push(std::mem::take(&mut row));\n213:         }\n214:     }\n215:     if in_quotes {\n216:         field.pop();\n217:         row.push(field);\n218:         rows.push(row);\n219:     }\n\n(Showing lines 100-219 of 1587. Use offset=220 to continue.)\n</content>","metadata":{"preview":"    match o {\n        Some(v) => v,\n        None => tl_fail(\"unwrapped a value that is not there\"),\n    }\n}\n\"#;\n\nconst TAIL_HELPER: &str = r#\"fn tl_tail<T: Clone>(v: &[T]) -> Option<Vec<T>> {\n    if v.is_empty() {\n        None\n    } else {\n        Some(v[1..].to_vec())\n    }\n}\n\"#;\n\nconst FLATTEN_HELPER: &str = r#\"fn tl_flatten<T: Clone>(vv: &[Vec<T>]) -> Vec<T> {\n    let mut out = Vec::new();\n    for v in vv {\n        out.extend(v.iter().cloned());","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/kantord/.local/share/toylang-lanes/issue-177/src/emit_rs.rs","text":"    match o {\n        Some(v) => v,\n        None => tl_fail(\"unwrapped a value that is not there\"),\n    }\n}\n\"#;\n\nconst TAIL_HELPER: &str = r#\"fn tl_tail<T: Clone>(v: &[T]) -> Option<Vec<T>> {\n    if v.is_empty() {\n        None\n    } else {\n        Some(v[1..].to_vec())\n    }\n}\n\"#;\n\nconst FLATTEN_HELPER: &str = r#\"fn tl_flatten<T: Clone>(vv: &[Vec<T>]) -> Vec<T> {\n    let mut out = Vec::new();\n    for v in vv {\n        out.extend(v.iter().cloned());\n    }\n    out\n}\n\"#;\n\n// `Ord` is exactly the constraint the checker's own `orderable` restricts `sort`'s element\n// type to (Int, Int64, Str, Char all implement it natively), so nothing here has to name them.\nconst SORT_HELPER: &str = r#\"fn tl_sort<T: Clone + Ord>(v: &[T]) -> Vec<T> {\n    let mut out = v.to_vec();\n    out.sort();\n    out\n}\n\"#;\n\nconst REVERSE_HELPER: &str = r#\"fn tl_reverse<T: Clone>(v: &[T]) -> Vec<T> {\n    let mut out = v.to_vec();\n    out.reverse();\n    out\n}\n\"#;\n\n// `wrapping_add` is the same wrap `+` gets through INT_HELPER/ARITH_HELPER, so a fold is the\n// repeated addition with nothing else to spell.\nconst SUM_HELPER: &str = r#\"fn tl_sum(v: &[i32]) -> i32 {\n    v.iter().fold(0i32, |acc, x| acc.wrapping_add(*x))\n}\n\nfn tl_sum64(v: &[i64]) -> i64 {\n    v.iter().fold(0i64, |acc, x| acc.wrapping_add(*x))\n}\n\"#;\n\n// `Option::max` is exactly the empty-is-absent answer, and `Ord` covers both integer widths.\nconst MAX_HELPER: &str = r#\"fn tl_max<T: Clone + Ord>(v: &[T]) -> Option<T> {\n    v.iter().cloned().max()\n}\n\"#;\n\nconst RANGE_HELPER: &str = r#\"fn tl_range(n: i32) -> Vec<i32> {\n    (0..n.max(0)).collect()\n}\n\"#;\n\n/// Rust's own `char` already is a Unicode scalar value, and `str::chars` already decodes by\n/// codepoint rather than by byte or UTF-16 unit, so there is no decoding to get right here --\n/// only the cast down to the `i32` every other backend represents a `Char` as.\nconst CHARS_HELPER: &str = r#\"fn tl_chars(s: &str) -> Vec<i32> {\n    s.chars().map(|c| c as i32).collect()\n}\n\"#;\n\n/// RFC 4180 field splitting over the raw lines `tl_read_lines` keeps: a field wrapped in double\n/// quotes may contain the delimiter, a doubled `\"\"` is a literal quote, and a quoted field may\n/// span lines. The delimiter is matched literally, never as a pattern.\nconst DSV_HELPER: &str = r#\"fn tl_dsv(lines: &[String], delim: &str) -> Vec<Vec<String>> {\n    let mut rows: Vec<Vec<String>> = Vec::new();\n    let mut row: Vec<String> = Vec::new();\n    let mut field = String::new();\n    let mut in_quotes = false;\n    for line in lines {\n        let mut i = 0;\n        while i < line.len() {\n            if in_quotes {\n                if line[i..].starts_with('\"') {\n                    if line[i + 1..].starts_with('\"') {\n                        field.push('\"');\n                        i += 2;\n                    } else {\n                        in_quotes = false;\n                        i += 1;\n                    }\n                } else {\n                    let c = line[i..].chars().next().expect(\"i is within the line\");\n                    field.push(c);\n                    i += c.len_utf8();\n                }\n            } else if line[i..].starts_with(delim) {\n                row.push(std::mem::take(&mut field));\n                i += delim.len();\n            } else if line[i..].starts_with('\"') && field.is_empty() {\n                in_quotes = true;\n                i += 1;\n            } else {\n                let c = line[i..].chars().next().expect(\"i is within the line\");\n                field.push(c);\n                i += c.len_utf8();\n            }\n        }\n        if in_quotes {\n            field.push('\\n');\n        } else {\n            row.push(std::mem::take(&mut field));\n            rows.push(std::mem::take(&mut row));\n        }\n    }\n    if in_quotes {\n        field.pop();\n        row.push(field);\n        rows.push(row);\n    }","lineStart":100,"lineEnd":219,"totalLines":1587,"truncated":true}},"title":"src/emit_rs.rs","time":{"start":1788464550528,"end":1788464550533}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me look at the backends'