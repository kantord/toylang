-> Result<&'a Type, Error> {\n760:     if owners.len() > 1 {\n761:         let named: Vec<String> = owners.iter().map(|e| format!(\"`{e}`\")).collect();\n762:         let qualified: Vec<String> = owners.iter().map(|e| format!(\"`{e}.{variant}`\")).collect();\n763:         return Err(Error::new(\n764:             span,\n765:             format!(\n766:                 \"`{variant}` is a variant of {}; qualify it as {}\",\n767:                 named.join(\" and \"),\n768:                 qualified.join(\" or \")\n769:             ),\n770:         ));\n771:     }\n772:     Ok(&ctx.enums[&owners[0]])\n773: }\n774: \n775: /// Every builtin and special-cased call form (`select`, `map`, `length`, ...) is unary; only a\n776: /// user-defined function can be nullary. This unwraps a call's optional argument for those\n777: /// forms, turning a bare `name()` at one of these names into the same \"not a function\" shape as\n778: /// any other arity mismatch would need, rather than a panic.\n779: fn need_arg<'a>(arg: &'a Option<Box<Expr>>, func: &str, span: Span) -> Result<&'a Expr, Error> {\n780:     arg.as_deref()\n781:         .ok_or_else(|| Error::new(span, format!(\"`{func}` needs an argument\")))\n782: }\n783: \n784: /// `expr` is a call to `name` carrying an argument, for `expect_inner`'s `collect`/`map`\n785: /// special cases: a bare `name()` (no argument) is not one of these, and falls through to\n786: /// `synth`, which owns the arity error for a name that is not actually nullary.\n787: fn call_named<'a>(expr: &'a Expr, name: &str) -> Option<&'a Expr> {\n788:     let Expr::Call { func, arg, .. } = expr else {\n789:         return None;\n790:     };\n791:     if func != name {\n792:         return None;\n793:     }\n794:     arg.as_deref()\n795: }\n796: \n797: /// `name`'s variant list at `args`. A thin wrapper over the shared re-derivation\n798: /// (`ty::variants_of`), which the backends reach for too: the checker's own `Type::Enum` in\n799: /// hand carries a placehol