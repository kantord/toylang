diff --git a/src/parse.rs b/src/parse.rs
index 8142af47..e0c533eb 100644
--- a/src/parse.rs
+++ b/src/parse.rs
@@ -658,13 +658,15 @@ impl<'i> Cursor<'i> {
         Ok(span)
     }
 
-    /// Consume one `;` after an fn or type declaration if one is present (gh:153, slice 2a).
-    /// The `;` is ACCEPTED and recorded by the formatter but not required yet; a later slice
-    /// makes it required.
-    fn opt_semicolon(&mut self) -> Result<(), Error> {
-        if self.peek()?.0 == Tok::Semicolon {
-            self.advance()?;
+    /// Require the `;` after an fn or type declaration (gh:153, slice 3a). `end` is the span
+    /// of the declaration's body, used as the error span when the offending token is Eof.
+    fn require_semicolon(&mut self, end: Span) -> Result<(), Error> {
+        let (tok, span) = self.peek()?;
+        if tok != Tok::Semicolon {
+            let span = if tok == Tok::Eof { Span::new(end.end, end.end) } else { span };
+            return Err(Error::new(span, "expected `;` after this declaration"));
         }
+        self.advance()?;
         Ok(())
     }
 
@@ -779,7 +781,7 @@ impl<'i> Cursor<'i> {
         if next == Tok::Eq {
             self.advance()?;
             let body = self.def_body()?;
-            self.opt_semicolon()?;
+            self.require_semicolon(body.span())?;
             return Ok(Def {
                 span: start.to(body.span()),
                 name,
@@ -808,7 +810,7 @@ impl<'i> Cursor<'i> {
 
         self.eat(Tok::Eq)?;
         let body = self.def_body()?;
-        self.opt_semicolon()?;
+        self.require_semicolon(body.span())?;
         Ok(Def {
             span: start.to(body.span()),
             name,
@@ -1158,7 +1160,7 @@ impl<'i> Cursor<'i> {
         let (name, _) = self.eat_ident("a type name")?;
         self.eat(Tok::Eq)?;
         let ty = self.type_expr()?;
-        self.opt_semicolon()?;
+        self.require_semicolon(ty.span())?;
         let span = start.to(ty.span());
         Ok(Alias { name, ty, span })
     }
@@ -1898,16 +1900,30 @@ mod tests {
         );
     }
 
-    /// gh:153 slice 2a: the `;` declaration terminator is accepted but not yet required, and
-    /// leaves no trace on the tree -- both spellings of an fn or type declaration parse to the
-    /// same module.
+    /// gh:153 slice 3a: the `;` declaration terminator is required and leaves no trace on the
+    /// tree -- every terminated spelling parses, and every un-terminated one errors.
     #[test]
     fn semicolon_terminator_does_not_change_the_tree() {
-        same("fn f(x: Int) -> Int = x * 10", "fn f(x: Int) -> Int = x * 10;");
-        same("fn f(x: Int) -> Int = x", "fn f(x: Int) -> Int = x;");
-        same("type U = {name: Str}", "type U = {name: Str};");
-        same("type Db = Vec<Int>", "type Db = Vec<Int>;");
-        // The hoisted form accepts the terminator too.
-        same("fn answer = 42", "fn answer = 42;");
+        same("fn f(x: Int) -> Int = x * 10;", "fn f(x: Int) -> Int = x * 10;");
+        same("fn f(x: Int) -> Int = x;", "fn f(x: Int) -> Int = x;");
+        same("type U = {name: Str};", "type U = {name: Str};");
+        same("type Db = Vec<Int>;", "type Db = Vec<Int>;");
+        // The hoisted form requires the terminator too.
+        same("fn answer = 42;", "fn answer = 42;");
+
+        for src in [
+            "fn f(x: Int) -> Int = x * 10",
+            "fn f(x: Int) -> Int = x",
+            "type U = {name: Str}",
+            "type Db = Vec<Int>",
+            "fn answer = 42",
+        ] {
+            let err = parse_module(src).unwrap_err();
+            assert!(
+                err.msg.contains("expected `;`"),
+                "`{src}` should complain about the missing `;`, got: {}",
+                err.msg,
+            );
+        }
     }
 }
